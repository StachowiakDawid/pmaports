# Maintainer: beyond2lte port <noreply@example.org>
pkgname=shannon-modem
pkgver=0.25
pkgrel=0
pkgdesc="Shannon S5000AP modem bring-up for Exynos 9820 (CP boot, RFS server, IPC client)"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
depends="python3 e2fsprogs-extra systemd util-linux-misc iproute2 alsa-utils"
# VoLTE (off unless VOLTE= in modem.conf or "ims ..." on the ctl FIFO): AMR codecs, pw-cat
depends="$depends opencore-amr vo-amrwbenc pipewire-tools py3-gobject3 speexdsp"
# optional: modemmanager + networkmanager for the normal UI (MBIM on /dev/wwan0mbim0)
install_if="linux-postmarketos-exynos9820"
options="!check"
backup="etc/shannon/modem.conf"
source="
	shannon-modem
	shannon-modem.service
	modem.conf
	README
	shannon-modemd.py
	shannon-efs-scratch.sh
	s5000ap-load.py
	ipcmon.py
	mbim_function.py
	call-audio
	shannon_ims.py
	shannon_media.py
	shannon_volte.py
	00_shannon-ims.nft
	shannon-callaudio-bridge
	shannon-callaudio-bridge.desktop
	shannon-soak.py
	"

package() {
	install -Dm755 "$srcdir"/shannon-modem -t "$pkgdir"/usr/libexec/shannon/
	install -Dm755 "$srcdir"/shannon-modemd.py "$srcdir"/shannon-efs-scratch.sh \
		"$srcdir"/s5000ap-load.py "$srcdir"/ipcmon.py -t "$pkgdir"/usr/libexec/shannon/
	install -Dm644 "$srcdir"/shannon-modem.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/modem.conf -t "$pkgdir"/etc/shannon/
	install -Dm644 "$srcdir"/README -t "$pkgdir"/usr/share/doc/shannon-modem/
	install -Dm644 "$srcdir"/mbim_function.py -t "$pkgdir"/usr/libexec/shannon/
	install -Dm755 "$srcdir"/call-audio -t "$pkgdir"/usr/libexec/shannon/
	install -Dm644 "$srcdir"/shannon_ims.py "$srcdir"/shannon_media.py \
		"$srcdir"/shannon_volte.py -t "$pkgdir"/usr/libexec/shannon/
	# VoLTE: accept IPsec-protected SIP and RTP on the IMS PDN before 01_wwan.nft drops wwan*
	install -Dm644 "$srcdir"/00_shannon-ims.nft -t "$pkgdir"/etc/nftables.d/
	# GNOME Calls speaker/mute buttons -> daemon: XDG autostart (Phosh reaches no
	# systemd graphical-session.target); FIFO and missed-calls file are group netdev
	install -Dm755 "$srcdir"/shannon-callaudio-bridge "$srcdir"/shannon-soak.py \
		-t "$pkgdir"/usr/libexec/shannon/
	install -Dm644 "$srcdir"/shannon-callaudio-bridge.desktop -t "$pkgdir"/etc/xdg/autostart/
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../shannon-modem.service "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/shannon-modem.service
}
