# Small register/I2C poking tools used by the Galaxy S10+ (beyond2lte) port.
# i2crw: raw I2C read/write (usb-gadget-reconnect.sh uses it for the MAX77705
# MUIC opcode interface while the max77705-usbc driver is not loaded).
# devmem: 32-bit /dev/mem peek/poke (needs CONFIG_DEVMEM, debugging only).
maintainer="StachowiakDawid <dawidos234@gmail.com>"
pkgname=beyond2lte-tools
pkgver=1
pkgrel=0
pkgdesc="i2crw and devmem debugging tools for the Samsung Galaxy S10+ port"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
makedepends="linux-headers"
options="!check"
source="
	i2crw.c
	devmem.c
"

build() {
	local t
	for t in i2crw devmem; do
		${CC:-gcc} $CFLAGS $LDFLAGS -Wall -o $t "$srcdir"/$t.c
	done
}

package() {
	install -Dm755 i2crw "$pkgdir"/usr/bin/i2crw
	install -Dm755 devmem "$pkgdir"/usr/bin/b2l-devmem
}
sha512sums="
