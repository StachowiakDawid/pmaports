+/* Samsung EL3 monitor: D-TZPC save/restore for runtime power gated blocks */
+#define EXYNOS_SMC_CMD_PREPARE_PD_ONOFF		0x82000410
+#define EXYNOS_GET_IN_PD_DOWN			0
+#define EXYNOS_WAKEUP_PD_DOWN			1
+#define EXYNOS_RUNTIME_PM_TZPC_GROUP		2
+
+static int exynos_pd_dtzpc(struct exynos_pm_domain *pd, bool wakeup)
+{
+	struct arm_smccc_res res;
+
+	if (!pd->dtzpc_addr)
+		return 0;
+
+	arm_smccc_smc(EXYNOS_SMC_CMD_PREPARE_PD_ONOFF,
+		      wakeup ? EXYNOS_WAKEUP_PD_DOWN : EXYNOS_GET_IN_PD_DOWN,
+		      pd->dtzpc_addr, EXYNOS_RUNTIME_PM_TZPC_GROUP,
+		      0, 0, 0, 0, &res);
+	if (res.a0) {
+		pr_err("Power domain %s: D_TZPC %s SMC failed: 0x%lx\n",
+		       pd->pd.name, wakeup ? "restore" : "save", res.a0);
+		return -EIO;
+	}
+
+	return 0;
