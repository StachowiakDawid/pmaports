+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_D_TZPC_G3D_PCLK, "gout_g3d_d_tzpc_g3d_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_D_TZPC_G3D_IPCLKPORT_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_GRAY2BIN_G3D_CLK, "gout_g3d_gray2bin_g3d_clk",
+	     "mout_g3d_embedded_user",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_GRAY2BIN_G3D_IPCLKPORT_CLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_LHM_AXI_G3DSFR_I_CLK, "gout_g3d_lhm_axi_g3dsfr_i_clk",
+	     "mout_g3d_embedded_user",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_LHM_AXI_G3DSFR_IPCLKPORT_I_CLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
