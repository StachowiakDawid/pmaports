+
+static int exynos9820_g3d_power_off(struct exynos_pm_domain *pd)
+{
+	struct exynos9820_g3d *g3d = pd->g3d;
+	int ret;
+
+	exynos_pd_rmw(g3d->cmu + EXYNOS9820_G3D_QCH_BUSIF_HPMG3D, BIT(2), 0);
+
+	ret = exynos_pd_power(&pd->pd, false);
+	if (ret)
+		return ret;
+	udelay(138);
+
+	/* Park the GPU clock on the oscillator and release PLL_G3D */
+	exynos_pd_rmw(g3d->cmu + EXYNOS9820_G3D_MUX_EMBEDDED_USER, BIT(4), 0);
+	exynos_pd_rmw(g3d->pll + EXYNOS9820_PLL_CON0, EXYNOS9820_PLL_MUX_SEL, 0);
+	writel(EXYNOS9820_PLL_G3D_CON2_OFF, g3d->pll + EXYNOS9820_PLL_CON2);
+
+	return 0;
+}
