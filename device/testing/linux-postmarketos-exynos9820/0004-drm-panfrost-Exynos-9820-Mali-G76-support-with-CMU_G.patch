+/* CMU_G3D registers saved by the downstream embedded_g3d_save sequence */
+static const u16 exynos9820_g3d_cmu_regs[] = {
+	0x1804,	/* CLK_CON_DIV_DIV_CLK_G3D_BUSP */
+	0x1800,	/* CLK_CON_DIV_DIV_CLK_G3D_BUSD */
+	0x1000,	/* CLK_CON_MUX_MUX_CLK_G3D_BUSD */
+	0x0100,	/* PLL_CON0_MUX_CLKCMU_EMBEDDED_G3D_USER */
+	0x0120,	/* PLL_CON0_MUX_CLKCMU_G3D_BUS_USER */
+	0x0140,	/* PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER */
+	0x0820,	/* G3D_SHORTSTOP */
+	0x0824,	/* G3D_CLKDIV2PH */
+	0x303c,	/* QCH_CON_BUSIF_HPMG3D_QCH */
+	0x0804,	/* G3D_EMBEDDED_CMU_G3D_CONTROLLER_OPTION */
+	0x0800,	/* G3D_CMU_G3D_CONTROLLER_OPTION */
+};
+
+#define EXYNOS9820_G3D_CMU_SIZE			0x4000
+#define EXYNOS9820_G3D_MUX_EMBEDDED_USER	0x0100
+#define EXYNOS9820_G3D_QCH_BUSIF_HPMG3D		0x303c
+#define EXYNOS9820_PLL_CON0			0x0
+#define EXYNOS9820_PLL_CON2			0x8
+#define EXYNOS9820_PLL_MUX_SEL			BIT(4)
+#define EXYNOS9820_PLL_G3D_CON2_ON		0x30000003
+#define EXYNOS9820_PLL_G3D_CON2_OFF		0x10000001
+#define EXYNOS9820_EMBEDDED_G3D_OUT_BIT		2
+
+static void exynos9820_g3d_save(struct exynos9820_g3d *g3d)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(exynos9820_g3d_cmu_regs); i++)
+		g3d->cmu_save[i] = readl(g3d->cmu + exynos9820_g3d_cmu_regs[i]);
+	g3d->sysreg_save = readl(g3d->sysreg);
+}
+
+static void exynos9820_g3d_restore(struct exynos9820_g3d *g3d)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(exynos9820_g3d_cmu_regs); i++)
+		writel(g3d->cmu_save[i], g3d->cmu + exynos9820_g3d_cmu_regs[i]);
+	writel(g3d->sysreg_save, g3d->sysreg);
+}
+
+static void exynos_pd_rmw(void __iomem *reg, u32 mask, u32 val)
+{
+	writel((readl(reg) & ~mask) | (val & mask), reg);
+}
+
+static int exynos9820_g3d_outer(struct exynos_pm_domain *pd, bool on)
+{
+	void __iomem *cfg = pd->g3d->g3d_cfg;
+	u32 want = on ? 0x1 : 0x0;
+	u32 val;
+	int ret;
+
+	exynos_pd_rmw(cfg, 0x1, want);
+	ret = readl_poll_timeout(cfg + 0x4, val, (val & 0x1) == want, 1, 2000);
+	if (ret)
+		pr_err("Power domain %s: G3D_STATUS stuck (0x%x, want %u)\n",
+		       pd->pd.name, val, want);
+
+	return ret;
+}
+
+static int exynos9820_g3d_power_on(struct exynos_pm_domain *pd)
+{
+	struct exynos9820_g3d *g3d = pd->g3d;
+	int ret;
+
+	/* Route PLL_G3D to the G3D block */
+	writel(EXYNOS9820_PLL_G3D_CON2_ON, g3d->pll + EXYNOS9820_PLL_CON2);
+	exynos_pd_rmw(g3d->pll + EXYNOS9820_PLL_CON0, EXYNOS9820_PLL_MUX_SEL,
+		      EXYNOS9820_PLL_MUX_SEL);
+
+	/* Cycle the outer G3D block with EMBEDDED_G3D_OUT asserted */
+	ret = exynos9820_g3d_outer(pd, false);
+	if (ret)
+		return ret;
+	writel(EXYNOS9820_EMBEDDED_G3D_OUT_BIT, g3d->out_set);
+	udelay(280);
+	ret = exynos9820_g3d_outer(pd, true);
+	if (ret)
+		return ret;
+	udelay(280);
+
+	/* Finally the GPU itself */
+	return exynos_pd_power(&pd->pd, true);
