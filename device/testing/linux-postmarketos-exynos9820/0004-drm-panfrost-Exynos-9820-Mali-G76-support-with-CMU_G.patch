+static void panfrost_gpu_capture_reset_cfg(struct panfrost_device *pfdev)
+{
+	if (pfdev->reset_cfg.valid)
+		return;
+
+	pfdev->reset_cfg.shader_config = gpu_read(pfdev, GPU_SHADER_CONFIG);
+	pfdev->reset_cfg.tiler_config = gpu_read(pfdev, GPU_TILER_CONFIG);
+	pfdev->reset_cfg.jm_config = gpu_read(pfdev, GPU_JM_CONFIG);
+	pfdev->reset_cfg.l2_mmu_config = gpu_read(pfdev, GPU_L2_MMU_CONFIG);
+	if (panfrost_has_hw_feature(pfdev, HW_FEATURE_COHERENCY_REG))
+		pfdev->reset_cfg.coherency_enable = gpu_read(pfdev, GPU_COHERENCY_ENABLE);
+	pfdev->reset_cfg.valid = true;
+
+	dev_info(pfdev->base.dev,
+		 "reset cfg: SHADER_CONFIG=0x%08x TILER_CONFIG=0x%08x JM_CONFIG=0x%08x L2_MMU_CONFIG=0x%08x COHERENCY_FEATURES=0x%x COHERENCY_ENABLE=0x%x STACK_PRESENT=0x%x\n",
+		 pfdev->reset_cfg.shader_config, pfdev->reset_cfg.tiler_config,
+		 pfdev->reset_cfg.jm_config, pfdev->reset_cfg.l2_mmu_config,
+		 pfdev->features.coherency_features,
+		 pfdev->reset_cfg.coherency_enable,
+		 gpu_read(pfdev, GPU_STACK_PRESENT_LO));
+	dev_info(pfdev->base.dev,
+		 "coherency enable=%d dma-coherent=%d\n",
+		 panfrost_coherency_mode_get(pfdev), pfdev->coherent);
+}
+
+static void panfrost_gpu_init_bus_quirks(struct panfrost_device *pfdev, bool log)
+{
+	int coherency_mode = panfrost_coherency_mode_get(pfdev);
