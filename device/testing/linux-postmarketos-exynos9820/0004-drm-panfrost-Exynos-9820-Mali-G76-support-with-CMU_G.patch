+static void __iomem *exynos_pd_ioremap_byname(struct platform_device *pdev,
+					      const char *name,
+					      resource_size_t min_size)
+{
+	struct resource *res;
+
+	/*
+	 * These registers belong to blocks that have their own drivers
+	 * (PMU, CMU_TOP, CMU_G3D, SYSREG_G3D), so map them without claiming
+	 * the memory region.
+	 */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	if (!res || resource_size(res) < min_size) {
+		dev_err(&pdev->dev, "missing or too small \"%s\" reg\n", name);
+		return IOMEM_ERR_PTR(-EINVAL);
+	}
+
+	return devm_ioremap(&pdev->dev, res->start, resource_size(res)) ?:
+	       IOMEM_ERR_PTR(-ENOMEM);
+}
+
+static int exynos9820_g3d_init(struct platform_device *pdev,
+			       struct exynos_pm_domain *pd)
+{
+	struct exynos9820_g3d *g3d;
+
+	g3d = devm_kzalloc(&pdev->dev, sizeof(*g3d), GFP_KERNEL);
+	if (!g3d)
+		return -ENOMEM;
+
+	g3d->g3d_cfg = exynos_pd_ioremap_byname(pdev, "g3d", 0x8);
+	if (IS_ERR(g3d->g3d_cfg))
+		return PTR_ERR(g3d->g3d_cfg);
+	g3d->out_set = exynos_pd_ioremap_byname(pdev, "out-set", 0x4);
+	if (IS_ERR(g3d->out_set))
+		return PTR_ERR(g3d->out_set);
+	g3d->pll = exynos_pd_ioremap_byname(pdev, "pll", 0xc);
+	if (IS_ERR(g3d->pll))
+		return PTR_ERR(g3d->pll);
+	g3d->cmu = exynos_pd_ioremap_byname(pdev, "cmu", EXYNOS9820_G3D_CMU_SIZE);
+	if (IS_ERR(g3d->cmu))
+		return PTR_ERR(g3d->cmu);
+	g3d->sysreg = exynos_pd_ioremap_byname(pdev, "sysreg", 0x4);
+	if (IS_ERR(g3d->sysreg))
+		return PTR_ERR(g3d->sysreg);
+
+	/*
+	 * CMU_G3D sits in the outer G3D block, which is up whenever the
+	 * kernel runs (the clock driver programs it at boot). Take a first
+	 * snapshot now so that the reset done by the first power-on gets
+	 * undone even if the domain was off at boot.
+	 */
+	exynos9820_g3d_save(g3d);
+	pd->g3d = g3d;
+
+	dev_info(&pdev->dev, "G3D sequencing enabled, MUX_EMBEDDED_G3D_USER=0x%08x MUX_G3D_BUSD=0x%08x PLL_CON0_PLL_G3D=0x%08x\n",
+		 g3d->cmu_save[3], g3d->cmu_save[2],
+		 readl(g3d->pll + EXYNOS9820_PLL_CON0));
+
+	return 0;
+}
