 drivers/gpu/drm/panfrost/panfrost_gpu.c       | 106 +++++++
 drivers/gpu/drm/panfrost/panfrost_gpu.h       |   1 +
 drivers/gpu/drm/panfrost/panfrost_job.c       |  11 +-
 drivers/gpu/drm/panfrost/panfrost_mmu.c       |  67 ++++-
 drivers/pmdomain/samsung/exynos-pm-domains.c  | 282 +++++++++++++++++-
