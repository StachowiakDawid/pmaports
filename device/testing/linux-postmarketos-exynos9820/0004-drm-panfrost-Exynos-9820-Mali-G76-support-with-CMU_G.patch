diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
index ece2b637cd..b695a097dd 100644
--- a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
@@ -35,6 +35,7 @@ properties:
               - rockchip,rk3568-mali
               - rockchip,rk3576-mali
               - samsung,exynos850-mali
+              - samsung,exynos9820-mali
           - const: arm,mali-bifrost # Mali Bifrost GPU model/revision is fully discoverable
       - items:
           - enum:
diff --git a/Documentation/devicetree/bindings/power/pd-samsung.yaml b/Documentation/devicetree/bindings/power/pd-samsung.yaml
index 9c2c511334..04a69529f3 100644
--- a/Documentation/devicetree/bindings/power/pd-samsung.yaml
+++ b/Documentation/devicetree/bindings/power/pd-samsung.yaml
@@ -21,9 +21,34 @@ properties:
     enum:
       - samsung,exynos4210-pd
       - samsung,exynos5433-pd
+      - samsung,exynos9820-pd
+      - samsung,exynos9820-pd-g3d
 
   reg:
-    maxItems: 1
+    minItems: 1
+    items:
+      - description: domain CONFIGURATION/STATUS registers
+      - description: PMU G3D_CONFIGURATION/STATUS registers
+      - description: PMU EMBEDDED_G3D_OUT atomic set alias
+      - description: CMU_TOP PLL_CON0_PLL_G3D..PLL_CON2_PLL_G3D
+      - description: CMU_G3D
+      - description: SYSREG_G3D BUS_COMPONENT_DRCG_EN
+
+  reg-names:
+    items:
+      - const: pd
+      - const: g3d
+      - const: out-set
+      - const: pll
+      - const: cmu
+      - const: sysreg
+
+  samsung,dtzpc-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Physical address of the D_TZPC protection register of the blocks in
+      this domain. The secure monitor is asked to save it before the domain
+      is powered off and to restore it after power on (Exynos 9820).
 
   clocks:
     deprecated: true
@@ -49,6 +74,23 @@ required:
   - "#power-domain-cells"
   - reg
 
+if:
+  properties:
+    compatible:
+      contains:
+        const: samsung,exynos9820-pd-g3d
+then:
+  properties:
+    reg:
+      minItems: 6
+  required:
+    - reg-names
+else:
+  properties:
+    reg:
+      maxItems: 1
+    reg-names: false
+
 unevaluatedProperties: false
 
 examples:
diff --git a/drivers/clk/samsung/clk-exynos9820.c b/drivers/clk/samsung/clk-exynos9820.c
index fca06c4ef2..c531cb52d6 100644
--- a/drivers/clk/samsung/clk-exynos9820.c
+++ b/drivers/clk/samsung/clk-exynos9820.c
@@ -1903,14 +1903,238 @@ static const struct samsung_cmu_info cmgp_cmu_info __initconst = {
 
 /*
  * Register offsets for CMU_G3D (0x18400000)
+ *
+ * Taken from the downstream cmucal tables (cal-if/exynos9820/cmucal-sfr.c).
+ *
+ * The GPU core clock is fout_pll_g3d (CMU_TOP) -> mout_g3d_bus_user ->
+ * mout_g3d_busd -> dout_g3d_busd -> mout_g3d_embedded_user -> gout_g3d_gpu.
+ * PLL_G3D itself (and the G3D voltage) is owned by the ACPM firmware: Linux
+ * requests a GPU frequency through the ACPM DVFS clock
+ * (EXYNOS9820_CLK_ACPM_DVFS_G3D) and must not reprogram the PLL directly,
+ * which is why nothing here sets CLK_SET_RATE_PARENT towards fout_pll_g3d.
+ * mout_g3d_switch_user is the glitch-free fallback that ACPM switches
+ * mout_g3d_busd to while it relocks PLL_G3D.
  */
-#define G3D_CMU_G3D_CONTROLLER_OPTION		0x0800
+#define PLL_CON0_MUX_CLKCMU_EMBEDDED_G3D_USER				0x0100
+#define PLL_CON2_MUX_CLKCMU_EMBEDDED_G3D_USER				0x0108
+#define PLL_CON0_MUX_CLKCMU_G3D_BUS_USER				0x0120
+#define PLL_CON2_MUX_CLKCMU_G3D_BUS_USER				0x0128
+#define PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER				0x0140
+#define PLL_CON2_MUX_CLKCMU_G3D_SWITCH_USER				0x0148
+#define G3D_CMU_G3D_CONTROLLER_OPTION					0x0800
+#define G3D_EMBEDDED_CMU_G3D_CONTROLLER_OPTION				0x0804
+#define G3D_SHORTSTOP							0x0820
+#define G3D_CLKDIV2PH							0x0824
+#define CLK_CON_MUX_MUX_CLK_G3D_BUSD					0x1000
+#define CLK_CON_DIV_DIV_CLK_G3D_BUSD					0x1800
+#define CLK_CON_DIV_DIV_CLK_G3D_BUSP					0x1804
+#define CLK_CON_GAT_CLK_BLK_G3D_UID_G3D_CMU_G3D_IPCLKPORT_PCLK		0x2000
+#define CLK_CON_GAT_CLK_BLK_G3D_UID_GPU_IPCLKPORT_CLK			0x2004
+#define CLK_CON_GAT_CLK_BLK_G3D_UID_HPM_G3D0_IPCLKPORT_HPM_TARGETCLK_C	0x2008
+#define CLK_CON_GAT_CLK_BLK_G3D_UID_RSTNSYNC_CLK_G3D_OSCCLK_IPCLKPORT_CLK	0x200c
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D0_PCLK	0x2014
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D1_PCLK	0x2018
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D2_PCLK	0x201c
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D3_PCLK	0x2020
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D0_PCLK	0x2024
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D1_PCLK	0x2028
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D2_PCLK	0x202c
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D3_PCLK	0x2030
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_AXI2APB_G3D_IPCLKPORT_ACLK		0x2034
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_BUSIF_HPMG3D_IPCLKPORT_PCLK		0x2038
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_D_TZPC_G3D_IPCLKPORT_PCLK		0x203c
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_GRAY2BIN_G3D_IPCLKPORT_CLK		0x2040
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_LHM_AXI_G3DSFR_IPCLKPORT_I_CLK	0x2044
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_LHM_AXI_P_G3D_IPCLKPORT_I_CLK	0x2048
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_LHS_AXI_G3DSFR_IPCLKPORT_I_CLK	0x204c
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_RSTNSYNC_CLK_G3D_BUSP_IPCLKPORT_CLK	0x2050
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_SYSREG_G3D_IPCLKPORT_PCLK		0x2054
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_VGEN_LITE_G3D_IPCLKPORT_CLK		0x2058
+#define CLK_CON_GAT_GOUT_BLK_G3D_UID_XIU_P_G3D_IPCLKPORT_ACLK		0x205c
 
 static const unsigned long g3d_clk_regs[] __initconst = {
+	PLL_CON0_MUX_CLKCMU_EMBEDDED_G3D_USER,
+	PLL_CON2_MUX_CLKCMU_EMBEDDED_G3D_USER,
+	PLL_CON0_MUX_CLKCMU_G3D_BUS_USER,
+	PLL_CON2_MUX_CLKCMU_G3D_BUS_USER,
+	PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER,
+	PLL_CON2_MUX_CLKCMU_G3D_SWITCH_USER,
 	G3D_CMU_G3D_CONTROLLER_OPTION,
+	G3D_EMBEDDED_CMU_G3D_CONTROLLER_OPTION,
+	G3D_SHORTSTOP,
+	G3D_CLKDIV2PH,
+	CLK_CON_MUX_MUX_CLK_G3D_BUSD,
+	CLK_CON_DIV_DIV_CLK_G3D_BUSD,
+	CLK_CON_DIV_DIV_CLK_G3D_BUSP,
+	CLK_CON_GAT_CLK_BLK_G3D_UID_G3D_CMU_G3D_IPCLKPORT_PCLK,
+	CLK_CON_GAT_CLK_BLK_G3D_UID_GPU_IPCLKPORT_CLK,
+	CLK_CON_GAT_CLK_BLK_G3D_UID_HPM_G3D0_IPCLKPORT_HPM_TARGETCLK_C,
+	CLK_CON_GAT_CLK_BLK_G3D_UID_RSTNSYNC_CLK_G3D_OSCCLK_IPCLKPORT_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D0_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D1_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D2_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D3_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D0_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D1_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D2_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D3_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_AXI2APB_G3D_IPCLKPORT_ACLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_BUSIF_HPMG3D_IPCLKPORT_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_D_TZPC_G3D_IPCLKPORT_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_GRAY2BIN_G3D_IPCLKPORT_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_LHM_AXI_G3DSFR_IPCLKPORT_I_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_LHM_AXI_P_G3D_IPCLKPORT_I_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_LHS_AXI_G3DSFR_IPCLKPORT_I_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_RSTNSYNC_CLK_G3D_BUSP_IPCLKPORT_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_SYSREG_G3D_IPCLKPORT_PCLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_VGEN_LITE_G3D_IPCLKPORT_CLK,
+	CLK_CON_GAT_GOUT_BLK_G3D_UID_XIU_P_G3D_IPCLKPORT_ACLK,
+};
+
+static const struct samsung_fixed_rate_clock g3d_fixed_clks[] __initconst = {
+	/* Free-running oscillator inside the embedded G3D power domain */
+	FRATE(0, "oscclk_embedded_g3d", NULL, 0, 100000000),
+};
+
+PNAME(mout_g3d_switch_user_p)	= { "oscclk", "dout_cmu_g3d_switch" };
+PNAME(mout_g3d_bus_user_p)	= { "oscclk", "fout_pll_g3d" };
+PNAME(mout_g3d_busd_p)		= { "mout_g3d_bus_user",
+				    "mout_g3d_switch_user" };
+PNAME(mout_g3d_embedded_user_p)	= { "oscclk_embedded_g3d", "dout_g3d_busd" };
+
+/*
+ * The muxes are only read back by Linux: ACPM (DVFS) and the G3D power
+ * sequence in the PMU own them, so mark them CLK_GET_RATE_NOCACHE to always
+ * report what the hardware is actually doing.
+ */
+static const struct samsung_mux_clock g3d_mux_clks[] __initconst = {
+	MUX_F(CLK_MOUT_G3D_SWITCH_USER, "mout_g3d_switch_user",
+	      mout_g3d_switch_user_p, PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER, 4, 1,
+	      CLK_GET_RATE_NOCACHE, 0),
+	MUX_F(CLK_MOUT_G3D_BUS_USER, "mout_g3d_bus_user", mout_g3d_bus_user_p,
+	      PLL_CON0_MUX_CLKCMU_G3D_BUS_USER, 4, 1, CLK_GET_RATE_NOCACHE, 0),
+	MUX_F(CLK_MOUT_G3D_BUSD, "mout_g3d_busd", mout_g3d_busd_p,
+	      CLK_CON_MUX_MUX_CLK_G3D_BUSD, 0, 1, CLK_GET_RATE_NOCACHE, 0),
+	MUX_F(CLK_MOUT_G3D_EMBEDDED_USER, "mout_g3d_embedded_user",
+	      mout_g3d_embedded_user_p, PLL_CON0_MUX_CLKCMU_EMBEDDED_G3D_USER,
+	      4, 1, CLK_GET_RATE_NOCACHE, 0),
+};
+
+static const struct samsung_div_clock g3d_div_clks[] __initconst = {
+	DIV(CLK_DOUT_G3D_BUSP, "dout_g3d_busp", "mout_g3d_busd",
+	    CLK_CON_DIV_DIV_CLK_G3D_BUSP, 0, 3),
+};
+
+static const struct samsung_fixed_factor_clock g3d_fixed_factor_clks[] __initconst = {
+	/* DIV_CLK_G3D_BUSD has no DIVRATIO field, it is a fixed 1:1 divider */
+	FFACTOR(CLK_DOUT_G3D_BUSD, "dout_g3d_busd", "mout_g3d_busd", 1, 1,
+		CLK_GET_RATE_NOCACHE),
+};
+
+static const struct samsung_gate_clock g3d_gate_clks[] __initconst = {
+	GATE(CLK_GOUT_G3D_CMU_G3D_PCLK, "gout_g3d_cmu_g3d_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_CLK_BLK_G3D_UID_G3D_CMU_G3D_IPCLKPORT_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_GPU_CLK, "gout_g3d_gpu_clk", "mout_g3d_embedded_user",
+	     CLK_CON_GAT_CLK_BLK_G3D_UID_GPU_IPCLKPORT_CLK, 21,
+	     CLK_IGNORE_UNUSED | CLK_GET_RATE_NOCACHE, 0),
+	GATE(CLK_GOUT_G3D_HPM_G3D0_TARGETCLK, "gout_g3d_hpm_g3d0_targetclk",
+	     "dout_cmu_hpm",
+	     CLK_CON_GAT_CLK_BLK_G3D_UID_HPM_G3D0_IPCLKPORT_HPM_TARGETCLK_C, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_OSCCLK_CLK, "gout_g3d_oscclk_clk", "oscclk",
+	     CLK_CON_GAT_CLK_BLK_G3D_UID_RSTNSYNC_CLK_G3D_OSCCLK_IPCLKPORT_CLK,
+	     21, CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_PPMU_G3D0_PCLK, "gout_g3d_ppmu_g3d0_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D0_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_PPMU_G3D1_PCLK, "gout_g3d_ppmu_g3d1_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D1_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_PPMU_G3D2_PCLK, "gout_g3d_ppmu_g3d2_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D2_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_PPMU_G3D3_PCLK, "gout_g3d_ppmu_g3d3_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_PPMU_G3D3_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_QE_G3D0_PCLK, "gout_g3d_qe_g3d0_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D0_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_QE_G3D1_PCLK, "gout_g3d_qe_g3d1_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D1_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_QE_G3D2_PCLK, "gout_g3d_qe_g3d2_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D2_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_QE_G3D3_PCLK, "gout_g3d_qe_g3d3_pclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_ASB_G3D_IPCLKPORT_QE_G3D3_PCLK, 21,
+	     CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_G3D_AXI2APB_G3D_ACLK, "gout_g3d_axi2apb_g3d_aclk",
+	     "dout_g3d_busp",
+	     CLK_CON_GAT_GOUT_BLK_G3D_UID_AXI2APB_G3D_IPCLKPORT_ACLK, 21,
