+			 "applied cfg: SHADER_CONFIG=0x%08x TILER_CONFIG=0x%08x JM_CONFIG=0x%08x L2_MMU_CONFIG=0x%08x COHERENCY_ENABLE=0x%x\n",
+			 gpu_read(pfdev, GPU_SHADER_CONFIG),
+			 gpu_read(pfdev, GPU_TILER_CONFIG),
+			 gpu_read(pfdev, GPU_JM_CONFIG),
+			 gpu_read(pfdev, GPU_L2_MMU_CONFIG),
+			 panfrost_has_hw_feature(pfdev, HW_FEATURE_COHERENCY_REG) ?
+			 gpu_read(pfdev, GPU_COHERENCY_ENABLE) : 0);
+}
