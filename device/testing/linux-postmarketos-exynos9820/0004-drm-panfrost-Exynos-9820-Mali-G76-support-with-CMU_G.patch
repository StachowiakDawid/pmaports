+/*
+ * Exynos 9820: the downstream kbase platform code has a gpu_core_mask_set()
+ * that derives a core mask from a "dead core" fuse at 0x1000a024. It is only
+ * built with CONFIG_MALI_GPU_CORE_MASK_SELECTION, which the beyond2lte
+ * defconfig does not set, and the r32p1 Exynos platform code actually
+ * shipped on the G975F has no such logic: the vendor driver powers every
+ * core in SHADER_PRESENT. The logic also assumes a 20-core layout
+ * (0x17771777) while the MP12 part reports SHADER_PRESENT = 0x770077, and
+ * on the production lot the fuse word (e.g. 0xe0251fdc) has bits set all
+ * over that layout; applying it left only 4 of the 12 cores (0x20023).
+ *
+ * Only log the fuse for reference.
+ */
+#define EXYNOS9820_LOTID_REG		0x10000004
+#define EXYNOS9820_GPU_DEAD_CORE_REG	0x1000a024
+
+void panfrost_gpu_exynos9820_quirk(struct panfrost_device *pfdev)
+{
+	static bool done;
+	void __iomem *reg;
+	u32 lotid, dead;
+
+	if (done)
+		return;
+	done = true;
+
+	reg = ioremap(EXYNOS9820_LOTID_REG, 4);
+	if (!reg)
+		return;
+	lotid = readl(reg) & 0xfffff;
+	iounmap(reg);
+
+	reg = ioremap(EXYNOS9820_GPU_DEAD_CORE_REG, 4);
+	if (!reg)
+		return;
+	dead = readl(reg);
+	iounmap(reg);
+
+	dev_info(pfdev->base.dev,
+		 "exynos9820: lotid=0x%05x core fuse=0x%08x (not applied) shader_present=0x%llx\n",
+		 lotid, dead, pfdev->features.shader_present);
+}
