From 1dd3468085ce39f2bc479f9ad10591b92c19a1a4 Mon Sep 17 00:00:00 2001
From: chiffathefox <chiffathefoxx@gmail.com>
Date: Thu, 11 Jun 2026 06:27:50 +0300
Subject: [PATCH 06/46] dirty: acpm: wip

(cherry picked from commit 2262cf248a2938828135c853fe226d108daf00af)
---
 drivers/firmware/samsung/exynos-acpm.c | 10 ++++++++++
 drivers/mailbox/exynos-mailbox.c       |  7 ++++---
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/drivers/firmware/samsung/exynos-acpm.c b/drivers/firmware/samsung/exynos-acpm.c
index a575caf871..09012b9946 100644
--- a/drivers/firmware/samsung/exynos-acpm.c
+++ b/drivers/firmware/samsung/exynos-acpm.c
@@ -40,6 +40,7 @@
 #define ACPM_TX_TIMEOUT_US		500000
 
 #define ACPM_GS101_INITDATA_BASE	0xa000
+#define ACPM_EXYNOS9820_INITDATA_BASE	0x7000
 
 /**
  * struct acpm_shmem - shared memory configuration information.
@@ -880,11 +881,20 @@ static const struct acpm_match_data acpm_gs101 = {
 	.acpm_clk_dev_name = "gs101-acpm-clk",
 };
 
+static const struct acpm_match_data acpm_exynos9820 = {
+	.initdata_base = ACPM_EXYNOS9820_INITDATA_BASE,
+	.acpm_clk_dev_name = "exynos9820-acpm-clk",
+};
+
 static const struct of_device_id acpm_match[] = {
 	{
 		.compatible = "google,gs101-acpm-ipc",
 		.data = &acpm_gs101,
 	},
+	{
+		.compatible = "samsung,exynos9820-acpm-ipc",
+		.data = &acpm_exynos9820,
+	},
 	{},
 };
 MODULE_DEVICE_TABLE(of, acpm_match);
diff --git a/drivers/mailbox/exynos-mailbox.c b/drivers/mailbox/exynos-mailbox.c
index bad1182431..b0c057eae2 100644
--- a/drivers/mailbox/exynos-mailbox.c
+++ b/drivers/mailbox/exynos-mailbox.c
@@ -16,8 +16,8 @@
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 
-#define EXYNOS_MBOX_INTMR0		0x28	/* Interrupt Mask Register 0 */
-#define EXYNOS_MBOX_INTGR1		0x40	/* Interrupt Generation Register 1 */
+#define EXYNOS_MBOX_INTMR0		0x24	/* Interrupt Mask Register 0 */
+#define EXYNOS_MBOX_INTGR1		0x08	/* Interrupt Generation Register 1 */
 
 #define EXYNOS_MBOX_INTMR0_MASK		GENMASK(15, 0)
 #define EXYNOS_MBOX_INTGR1_MASK		GENMASK(15, 0)
@@ -74,7 +74,8 @@ static const struct exynos_mbox_driver_data exynos850_mbox_data = {
 
 static const struct exynos_mbox_driver_data exynos_gs101_mbox_data = {
 	.intgr = EXYNOS_MBOX_INTGR1,
-	.intgr_shift = 0,
+	/* Exynos 9820 (DT says google,gs101-mbox): doorbell bits at 31:16 */
+	.intgr_shift = 16,
 	.intmr = EXYNOS_MBOX_INTMR0,
 	.intmr_mask = EXYNOS_MBOX_INTMR0_MASK,
 	.num_chans = EXYNOS_MBOX_CHAN_COUNT,
