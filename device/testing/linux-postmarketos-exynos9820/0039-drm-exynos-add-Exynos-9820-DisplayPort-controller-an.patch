@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/samsung/samsung,exynos9820-decon2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos 9820 DECON2 display controller (DisplayPort)
+
+maintainers:
+  - StachowiakDawid <dawidos234@gmail.com>
+
+description: |
+  DECON2 is the display controller of the external DisplayPort output of the
+  Exynos 9820. It runs in video mode and is fed by one DPU DMA channel (IDMA
+  GF1) through its DPP; the DisplayPort link controller generates the video
+  timing and pulls the pixels. The blender window registers and the DP
+  connection select live in DECON0's register block, which is shared with
+  the DECON0 node and therefore only mapped, not claimed. Port 0 links to the
+  DisplayPort controller.
+
+properties:
+  compatible:
+    const: samsung,exynos9820-decon2
+
+  reg:
+    items:
+      - description: DECON2 registers
+      - description: DECON0 registers (shared window and DP connection registers)
+      - description: DPU DMA channel GF1 (IDMA)
+      - description: DPP GF1
+
+  reg-names:
+    items:
+      - const: decon
+      - const: decon0
+      - const: dma
+      - const: dpp
+
+  interrupts:
+    minItems: 1
+    items:
+      - description: frame start
+      - description: frame done
+      - description: extra (errors)
+
+  interrupt-names:
+    minItems: 1
+    items:
+      - const: frame_start
+      - const: frame_done
+      - const: extra
+
+  clocks:
+    minItems: 1
+    maxItems: 16
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: Output to the DisplayPort link controller.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    display-controller@19050000 {
+        compatible = "samsung,exynos9820-decon2";
+        reg = <0x19050000 0x10000>, <0x19030000 0x2000>,
+              <0x19072000 0x1000>, <0x19022000 0x1000>;
+        reg-names = "decon", "decon0", "dma", "dpp";
+        interrupts = <GIC_SPI 195 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 196 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 197 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "frame_start", "frame_done", "extra";
+
+        port {
+            endpoint {
+                remote-endpoint = <&dp_in>;
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/display/samsung/samsung,exynos9820-dp.yaml b/Documentation/devicetree/bindings/display/samsung/samsung,exynos9820-dp.yaml
