+/* ------------------------------------------------------------------ */
+/* DRM bridge (needs a DECON2 CRTC upstream of it, see TODO)           */
+
+static int exynos_dp_bridge_attach(struct drm_bridge *bridge,
+				   struct drm_encoder *encoder,
+				   enum drm_bridge_attach_flags flags)
+{
+	struct exynos_dp *dp = bridge_to_dp(bridge);
+
+	if (!(flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR))
+		return -EINVAL;
+
+	dp->aux.drm_dev = bridge->dev;
+	return drm_dp_aux_register(&dp->aux);
+}
+
+static void exynos_dp_bridge_detach(struct drm_bridge *bridge)
+{
+	drm_dp_aux_unregister(&bridge_to_dp(bridge)->aux);
+}
+
+static enum drm_connector_status
+exynos_dp_bridge_detect(struct drm_bridge *bridge,
+			struct drm_connector *connector)
+{
+	struct exynos_dp *dp = bridge_to_dp(bridge);
+
+	return dp->hpd && dp->max_lanes ? connector_status_connected :
+					  connector_status_disconnected;
+}
+
+static const struct drm_edid *
+exynos_dp_bridge_edid_read(struct drm_bridge *bridge,
+			   struct drm_connector *connector)
+{
+	struct exynos_dp *dp = bridge_to_dp(bridge);
+
+	exynos_dp_sync(dp);
+	return drm_edid_read_ddc(connector, &dp->aux.ddc);
+}
+
+static void exynos_dp_bridge_hpd_notify(struct drm_bridge *bridge,
+					struct drm_connector *connector,
+					enum drm_connector_status status)
+{
+	/*
+	 * Called back from drm_bridge_hpd_notify() / oob hotplug events: the
+	 * TypeC mux callback already carries the HPD state, nothing to do.
+	 */
+}
+
+static unsigned int exynos_dp_max_rate(struct exynos_dp *dp)
+{
+	unsigned int rate = dp->dpcd[DP_DPCD_REV] ?
+			    drm_dp_max_link_rate(dp->dpcd) / 100 : 5400;
+
+	return min(rate, 5400u);	/* HBR2: the PHY has no HBR3 table */
+}
+
+static unsigned int exynos_dp_max_lanes(struct exynos_dp *dp)
+{
+	unsigned int lanes = dp->max_lanes ?: 4;
+
+	if (dp->dpcd[DP_DPCD_REV])
+		lanes = min_t(unsigned int, lanes, drm_dp_max_lane_count(dp->dpcd));
+	return lanes == 3 ? 2 : lanes;
+}
+
+static enum drm_mode_status
+exynos_dp_bridge_mode_valid(struct drm_bridge *bridge,
+			    const struct drm_display_info *info,
+			    const struct drm_display_mode *mode)
+{
+	struct exynos_dp *dp = bridge_to_dp(bridge);
+	u64 need = (u64)mode->clock * 24;		/* kbit/s, RGB 8 bpc */
+	u64 have = (u64)exynos_dp_max_rate(dp) * 1000 *
+		   exynos_dp_max_lanes(dp) * 8 / 10;	/* 8b/10b */
+
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+	if (need > have)
+		return MODE_CLOCK_HIGH;
+	return MODE_OK;
+}
+
+/*
+ * Before DECON2 starts (it starts in its encoder enable, which runs after
+ * the bridge pre_enable): downstream displayport_enable() (via s_stream at
+ * _decon_enable) + the DP half of decon_reg_start(): train the link if
+ * needed, timing/MVID/active symbols, VIDEO_EN, then the LH P-channel.
+ */
+static void exynos_dp_bridge_atomic_pre_enable(struct drm_bridge *bridge,
+					       struct drm_atomic_commit *state)
+{
+	struct exynos_dp *dp = bridge_to_dp(bridge);
+	struct drm_connector *connector;
+	struct drm_crtc_state *cs;
+	struct drm_crtc *crtc;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state,
+							     bridge->encoder);
+	if (!connector)
+		return;
+	crtc = drm_atomic_get_new_connector_state(state, connector)->crtc;
+	cs = drm_atomic_get_new_crtc_state(state, crtc);
+
+	exynos_dp_sync(dp);
+	if (!dp->powered) {
+		dev_err(dp->dev, "enable without a powered link (HPD %d, lanes %u)\n",
+			dp->hpd, dp->max_lanes);
+		return;
+	}
+
+	if (!dp->trained && exynos_dp_link_train(dp)) {
+		dev_err(dp->dev, "link training failed, no picture\n");
+		return;
+	}
+
+	mutex_lock(&dp->lock);
+	exynos_dp_set_video(dp, &cs->adjusted_mode);
+	dp_write_field(dp, SST1_VIDEO_ENABLE, VIDEO_EN, 1);
+	dp->streaming = true;
+	exynos_dp_lh_power(dp, true);
+	dev_info(dp->dev, "stream " DRM_MODE_FMT " on %u Mb/s x%u, LH %d, FSM %08x\n",
+		 DRM_MODE_ARG(&cs->adjusted_mode), dp->rate, dp->lanes, dp->lh_on,
+		 dp_read(dp, SST1_VIDEO_DEBUG_FSM_STATE));
+	mutex_unlock(&dp->lock);
+}
+
+/* After DECON2 stopped (encoder disable): the DP half of decon_reg_stop() */
+static void exynos_dp_bridge_atomic_post_disable(struct drm_bridge *bridge,
+						 struct drm_atomic_commit *state)
+{
+	struct exynos_dp *dp = bridge_to_dp(bridge);
+
+	mutex_lock(&dp->lock);
+	if (dp->powered) {
+		if (dp->lh_on)
+			exynos_dp_lh_power(dp, false);
+		exynos_dp_video_stop(dp);
+	}
+	mutex_unlock(&dp->lock);
+}
+
+static const struct drm_bridge_funcs exynos_dp_bridge_funcs = {
+	.attach = exynos_dp_bridge_attach,
+	.detach = exynos_dp_bridge_detach,
+	.detect = exynos_dp_bridge_detect,
+	.edid_read = exynos_dp_bridge_edid_read,
+	.hpd_notify = exynos_dp_bridge_hpd_notify,
+	.mode_valid = exynos_dp_bridge_mode_valid,
+	.atomic_pre_enable = exynos_dp_bridge_atomic_pre_enable,
+	.atomic_post_disable = exynos_dp_bridge_atomic_post_disable,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_create_state = drm_atomic_helper_bridge_create_state,
+};
