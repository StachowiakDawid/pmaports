+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/samsung/samsung,exynos9820-dp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9820 DisplayPort link controller
+
+maintainers:
+  - Dawid Stachowiak <dawidos234@gmail.com>
+
+description:
+  DisplayPort 1.4 SST link controller of the Exynos9820, used for DisplayPort
+  alternate mode over USB-C. The main link goes through the USB/DP combo PHY,
+  the AUX channel through an analog switch onto the connector's SBU pins. The
+  controller acts as the TypeC mode and orientation switch of that SBU path.
+  Video comes from DECON2 (samsung,exynos9820-decon2) over the OF graph.
+
+allOf:
+  - $ref: /schemas/usb/usb-switch.yaml#
+
+properties:
+  compatible:
+    const: samsung,exynos9820-dp
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks: true
+
+  phys:
+    maxItems: 1
+
+  phy-names:
+    const: dp
+
+  aux-enable-gpios:
+    maxItems: 1
+    description: Output enable of the AUX/SBU analog switch.
+
+  sbu-select-gpios:
+    maxItems: 1
+    description: Selects which SBU line pair carries AUX (cable orientation).
+
+  usb-dir-gpios:
+    maxItems: 1
+    description:
+      Input telling the cable orientation (CC1/CC2), the same line the USB/DP
+      combo PHY uses to pick its lane pairs (downstream dp,usb_con_sel). Used
+      for the AUX switch and the PCS lane map; without it the TypeC
+      orientation switch state is used.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Video input from DECON2.
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: USB-C connector SBU port (TypeC mode/orientation switch).
+
+required:
+  - compatible
+  - reg
+  - phys
+  - phy-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    displayport@130b0000 {
+        compatible = "samsung,exynos9820-dp";
+        reg = <0x130b0000 0x10000>;
+        interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
+        phys = <&usbdrd_phy 2>;
+        phy-names = "dp";
+        aux-enable-gpios = <&gpg1 6 GPIO_ACTIVE_LOW>;
+        sbu-select-gpios = <&gpg4 0 GPIO_ACTIVE_HIGH>;
+        usb-dir-gpios = <&gpg0 4 GPIO_ACTIVE_HIGH>;
+        mode-switch;
+        orientation-switch;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+                endpoint {
+                    remote-endpoint = <&decon2_out>;
+                };
+            };
+
+            port@1 {
+                reg = <1>;
+                endpoint {
+                    remote-endpoint = <&usbc_sbu_ep>;
+                };
+            };
+        };
+    };
