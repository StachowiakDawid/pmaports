+
+static void exynos_dp_typec_unregister(void *data)
+{
+	struct exynos_dp *dp = data;
+
+	typec_mux_unregister(dp->mux);
+	typec_switch_unregister(dp->sw);
+}
+
+static int exynos_dp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct typec_switch_desc sw_desc = { };
+	struct typec_mux_desc mux_desc = { };
+	struct exynos_dp *dp;
+	int ret;
+
+	dp = devm_drm_bridge_alloc(dev, struct exynos_dp, bridge,
+				   &exynos_dp_bridge_funcs);
+	if (IS_ERR(dp))
+		return PTR_ERR(dp);
+	dp->dev = dev;
+	platform_set_drvdata(pdev, dp);
+	mutex_init(&dp->lock);
+	INIT_WORK(&dp->hpd_work, exynos_dp_hpd_work);
+	INIT_WORK(&dp->report_work, exynos_dp_report_work);
+
+	dp->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dp->regs))
+		return PTR_ERR(dp->regs);
+
+	dp->nclks = devm_clk_bulk_get_all(dev, &dp->clks);
+	if (dp->nclks < 0)
+		return dev_err_probe(dev, dp->nclks, "failed to get clocks\n");
+
+	dp->phy = devm_phy_get(dev, "dp");
+	if (IS_ERR(dp->phy))
+		return dev_err_probe(dev, PTR_ERR(dp->phy), "failed to get DP PHY\n");
+
+	dp->aux_en = devm_gpiod_get_optional(dev, "aux-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(dp->aux_en))
+		return dev_err_probe(dev, PTR_ERR(dp->aux_en), "aux-enable gpio\n");
+	dp->sbu_sel = devm_gpiod_get_optional(dev, "sbu-select", GPIOD_OUT_LOW);
+	if (IS_ERR(dp->sbu_sel))
+		return dev_err_probe(dev, PTR_ERR(dp->sbu_sel), "sbu-select gpio\n");
+	/* the combo PHY owns this input too (samsung,usbdp-port-gpios) */
+	dp->usb_dir = devm_gpiod_get_optional(dev, "usb-dir",
+					      GPIOD_IN | GPIOD_FLAGS_BIT_NONEXCLUSIVE);
+	if (IS_ERR(dp->usb_dir))
+		return dev_err_probe(dev, PTR_ERR(dp->usb_dir), "usb-dir gpio\n");
+	dp->reported = connector_status_disconnected;
+	dp->report_st = connector_status_disconnected;
+
+	dp->aux.name = "Exynos9820 DP AUX";
+	dp->aux.dev = dev;
+	dp->aux.transfer = exynos_dp_aux_transfer;
+	drm_dp_aux_init(&dp->aux);
+
+	sw_desc.drvdata = dp;
+	sw_desc.fwnode = dev_fwnode(dev);
+	sw_desc.set = exynos_dp_switch_set;
+	dp->sw = typec_switch_register(dev, &sw_desc);
+	if (IS_ERR(dp->sw))
+		return dev_err_probe(dev, PTR_ERR(dp->sw), "typec switch\n");
+
+	mux_desc.drvdata = dp;
+	mux_desc.fwnode = dev_fwnode(dev);
+	mux_desc.set = exynos_dp_mux_set;
+	dp->mux = typec_mux_register(dev, &mux_desc);
+	if (IS_ERR(dp->mux)) {
+		typec_switch_unregister(dp->sw);
+		return dev_err_probe(dev, PTR_ERR(dp->mux), "typec mux\n");
+	}
+	ret = devm_add_action_or_reset(dev, exynos_dp_typec_unregister, dp);
+	if (ret)
+		return ret;
+
+	dp->bridge.of_node = dev->of_node;
+	dp->bridge.type = DRM_MODE_CONNECTOR_DisplayPort;
+	dp->bridge.ops = DRM_BRIDGE_OP_DETECT | DRM_BRIDGE_OP_EDID |
+			 DRM_BRIDGE_OP_HPD;
+	ret = devm_drm_bridge_add(dev, &dp->bridge);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "DP controller registered (untested driver; flip from %s)\n",
+		 dp->usb_dir ? "usb-dir gpio" : "TypeC orientation");
+	return 0;
+}
+
+static void exynos_dp_remove(struct platform_device *pdev)
+{
+	struct exynos_dp *dp = platform_get_drvdata(pdev);
+
+	cancel_work_sync(&dp->hpd_work);
+	cancel_work_sync(&dp->report_work);
+	mutex_lock(&dp->lock);
+	exynos_dp_power_off(dp);
+	exynos_dp_aux_switch(dp, false);
+	mutex_unlock(&dp->lock);
+}
+
+static const struct of_device_id exynos_dp_of_match[] = {
+	{ .compatible = "samsung,exynos9820-dp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos_dp_of_match);
+
+static struct platform_driver exynos_dp_driver = {
+	.probe = exynos_dp_probe,
+	.remove = exynos_dp_remove,
+	.driver = {
+		.name = "exynos9820-dp",
+		.of_match_table = exynos_dp_of_match,
+	},
+};
+module_platform_driver(exynos_dp_driver);
+
+MODULE_DESCRIPTION("Exynos 9820 DisplayPort link controller (DP alt mode)");
+MODULE_LICENSE("GPL");
