+
+	PHY_TRSV_REG_CFG_EXYNOS9820(0x152, 0x2D, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9820(0x153, 0xB7, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9820(0x154, 0x00, PWR_MODE_ANY),
