From bd5248d881df2a21526c3e933524d5bf6c9ba512 Mon Sep 17 00:00:00 2001
From: chiffathefox <chiffathefoxx@gmail.com>
Date: Sat, 29 Aug 2026 19:40:34 +0300
Subject: [PATCH 43/46] clk: exynos9820: add an empty G3D block

(cherry picked from commit cf662a05d9bcb2f4d91af66a58835e07aea424bb)
---
 drivers/clk/samsung/clk-exynos9820.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/clk/samsung/clk-exynos9820.c b/drivers/clk/samsung/clk-exynos9820.c
index 25a5169ba4..e64523c18c 100644
--- a/drivers/clk/samsung/clk-exynos9820.c
+++ b/drivers/clk/samsung/clk-exynos9820.c
@@ -1569,6 +1569,24 @@ static const struct samsung_cmu_info apm_cmu_info __initconst = {
 	.memclk_offset		= EXYNOS9820_MEMCLK_OFFSET,
 };
 
+/*
+ * Register offsets for CMU_G3D (0x18400000)
+ */
+#define G3D_CMU_G3D_CONTROLLER_OPTION		0x0800
+
+static const unsigned long g3d_clk_regs[] __initconst = {
+	G3D_CMU_G3D_CONTROLLER_OPTION,
+};
+
+static const struct samsung_cmu_info g3d_cmu_info __initconst = {
+	.clk_regs		= g3d_clk_regs,
+	.nr_clk_regs		= ARRAY_SIZE(g3d_clk_regs),
+	.auto_clock_gate	= true,
+	.gate_dbg_offset	= EXYNOS9820_GATE_DBG_OFFSET,
+	.option_offset		= G3D_CMU_G3D_CONTROLLER_OPTION,
+	.drcg_offset		= EXYNOS9820_DRCG_EN_OFFSET,
+};
+
 /*
  * Register offsets for CMU_CORE (0x1a030000)
  */
@@ -3047,6 +3065,9 @@ static const struct of_device_id exynos9820_cmu_of_match[] = {
 	}, {
 		.compatible = "samsung,exynos9820-cmu-apm",
 		.data = &apm_cmu_info,
+	}, {
+		.compatible = "samsung,exynos9820-cmu-g3d",
+		.data = &g3d_cmu_info,
 	}, {
 		.compatible = "samsung,exynos9820-cmu-core",
 		.data = &core_cmu_info,
