+static void exynos9820_pd_get_feed(struct exynos_pm_domain *pd,
+				  struct device_node *np, u16 id)
+{
+	struct of_phandle_args args = {
+		.np = np,
+		.args_count = 1,
+		.args = { id },
+	};
+	struct clk *clk;
+
+	if (!np || !id)
+		return;
+
+	clk = of_clk_get_from_provider(&args);
+	if (IS_ERR(clk)) {
+		pr_warn("Power domain %s: no feed clock %pOFn:%u (%pe)\n",
+			pd->pd.name, np, id, clk);
+		return;
+	}
+	/* prepared only: clk_disable_unused still gates it while unused */
+	if (clk_prepare(clk)) {
+		clk_put(clk);
+		return;
+	}
+	pd->feeds[pd->nfeeds_init++] = clk;
+}
+
+/*
+ * The CMU_TOP and CMU_BUSC providers register after the power domains
+ * (core_initcall order), and clk_prepare() must not run under the genpd
+ * lock. Look the feed clocks up once, before late_initcall_sync, where
+ * clk_disable_unused() and then genpd_power_off_unused() run.
+ */
+static int __init exynos9820_pd_feeds_init(void)
+{
+	struct device_node *top, *busc;
+	struct exynos_pm_domain *pd;
+	int i;
+
+	if (list_empty(&exynos9820_pds))
+		return 0;
+
+	top = of_find_compatible_node(NULL, NULL, "samsung,exynos9820-cmu-top");
+	busc = of_find_compatible_node(NULL, NULL, "samsung,exynos9820-cmu-busc");
+
+	list_for_each_entry(pd, &exynos9820_pds, node) {
+		if (!pd->info)
+			continue;
+		for (i = 0; i < EXYNOS9820_PD_MAX_FEEDS; i++) {
+			exynos9820_pd_get_feed(pd, top, pd->info->top[i]);
+			exynos9820_pd_get_feed(pd, busc, pd->info->busc[i]);
+		}
+		smp_store_release(&pd->nfeeds, pd->nfeeds_init);
+		if (pd->nfeeds)
+			pr_debug("Power domain %s: %u feed clocks\n",
+				 pd->pd.name, pd->nfeeds);
+	}
+
+	of_node_put(top);
+	of_node_put(busc);
+
+	return 0;
