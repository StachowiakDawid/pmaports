+	for (i = 0; i < ARRAY_SIZE(exynos9820_pd_info); i++)
+		if (!strcmp(pd->pd.name, exynos9820_pd_info[i].name))
+			pd->info = &exynos9820_pd_info[i];
+
+	if (strcmp(pd->pd.name, "AUD")) {
+		if (!strcmp(pd->pd.name, "ISPPRE") && pd->dtzpc_addr) {
+			struct exynos9820_isppre *ip;
+
+			ip = devm_kzalloc(dev, sizeof(*ip), GFP_KERNEL);
+			if (!ip)
+				return -ENOMEM;
+			/* owned by the camera driver: map without claiming */
+			ip->cmu = devm_ioremap(dev, EXYNOS9820_ISPPRE_CMU,
+					       EXYNOS9820_ISPPRE_CMU_SIZE);
+			ip->sysreg = devm_ioremap(dev, EXYNOS9820_ISPPRE_SYSREG,
