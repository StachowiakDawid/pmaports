+	/*
+	 * Older DTs do not describe D_TZPC_AUD: without the EL3 restore every
+	 * AUD SFR is secure-only after a power cycle (SError on first access).
+	 */
+	if (!pd->dtzpc_addr)
+		pd->dtzpc_addr = EXYNOS9820_AUD_DTZPC;
+
+	aud = devm_kzalloc(dev, sizeof(*aud), GFP_KERNEL);
+	if (!aud)
+		return -ENOMEM;
+
+	/* owned by the CMU and ABOX drivers: map without claiming */
+	aud->cmu = devm_ioremap(dev, EXYNOS9820_AUD_CMU, EXYNOS9820_AUD_CMU_SIZE);
+	aud->sysreg = devm_ioremap(dev, EXYNOS9820_AUD_SYSREG,
+				   EXYNOS9820_AUD_SYSREG_SIZE);
+	if (!aud->cmu || !aud->sysreg)
+		return -ENOMEM;
+
+	pd->aud = aud;
+	dev_info(dev, "AUD state save/restore enabled, D_TZPC %#x\n",
+		 pd->dtzpc_addr);
+
+	return 0;
+}
