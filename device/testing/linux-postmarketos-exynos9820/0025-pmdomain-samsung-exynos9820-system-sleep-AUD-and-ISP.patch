+	for (i = 0; i < 9; i++)
+		writel(aud->cmu_save[i], aud->cmu + exynos9820_aud_cmu_regs[i]);
+
+	/*
+	 * PLLs: start with the PLL mux on OSCCLK, wait for the lock, then
+	 * switch the mux (downstream writes PLL_CON0 and polls LOCKED).
+	 */
+	for (i = 0; i < ARRAY_SIZE(exynos9820_aud_pll_regs); i++) {
+		void __iomem *reg = aud->cmu + exynos9820_aud_pll_regs[i];
+		u32 con0 = aud->pll_save[i];
+
+		writel(con0 & ~EXYNOS9820_PLL_MUX_SEL, reg);
+		if (!(con0 & EXYNOS9820_PLL_ENABLE))
+			continue;
+		{
+			ktime_t t0 = ktime_get();
+
+			/*
+			 * 1 ms was too short after a SoC SLEEP (PLL_CON0 0x120 not
+			 * locked, audio fine afterwards): wait up to 10 ms and say
+			 * how long it took when it was slow.
+			 */
+			if (readl_poll_timeout_atomic(reg, val,
+						      val & EXYNOS9820_PLL_LOCKED, 1,
+						      10000))
+				pr_err("Power domain AUD: PLL_CON0 %#x did not lock in 10 ms (%#x)\n",
+				       exynos9820_aud_pll_regs[i], val);
+			else if (ktime_us_delta(ktime_get(), t0) > 1000)
+				pr_info("Power domain AUD: PLL_CON0 %#x locked after %lld us\n",
+					exynos9820_aud_pll_regs[i],
+					ktime_us_delta(ktime_get(), t0));
+		}
+		writel(con0, reg);
+	}
+
+	for (i = 9; i < ARRAY_SIZE(exynos9820_aud_cmu_regs); i++)
+		writel(aud->cmu_save[i], aud->cmu + exynos9820_aud_cmu_regs[i]);
+	for (i = 0; i < ARRAY_SIZE(exynos9820_aud_sysreg_regs); i++)
+		writel(aud->sysreg_save[i],
+		       aud->sysreg + exynos9820_aud_sysreg_regs[i]);
+}
