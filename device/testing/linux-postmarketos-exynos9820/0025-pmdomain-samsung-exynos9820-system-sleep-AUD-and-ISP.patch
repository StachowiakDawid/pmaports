+static const u16 exynos9820_aud_cmu_regs[] = {
+	0x0000,			/* PLL_LOCKTIME_PLL_AUD0 */
+	0x0124, 0x0128, 0x012c, 0x0130,	/* PLL_CON1..4_PLL_AUD0 */
+	0x0144, 0x0148, 0x014c, 0x0150,	/* PLL_CON1..4_PLL_AUD1 */
