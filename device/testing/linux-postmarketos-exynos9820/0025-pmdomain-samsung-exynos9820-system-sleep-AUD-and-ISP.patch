+	for (i = 0; i < ARRAY_SIZE(exynos9820_aud_pll_regs); i++)
+		aud->pll_save[i] = readl(aud->cmu + exynos9820_aud_pll_regs[i]);
+	for (i = 0; i < ARRAY_SIZE(exynos9820_aud_sysreg_regs); i++)
+		aud->sysreg_save[i] =
+			readl(aud->sysreg + exynos9820_aud_sysreg_regs[i]);
+	aud->saved = true;
