diff --git a/Documentation/devicetree/bindings/pci/samsung,exynos9820-pcie.yaml b/Documentation/devicetree/bindings/pci/samsung,exynos9820-pcie.yaml
new file mode 100644
index 0000000000..8ff679609a
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/samsung,exynos9820-pcie.yaml
@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/samsung,exynos9820-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos 9820 GEN2 PCIe Host Controller
+
+maintainers:
+  - StachowiakDawid <dawidos234@gmail.com>
+
+description:
+  The Exynos 9820 GEN2 (Wi-Fi) PCIe root complex is based on the Synopsys
+  DesignWare PCIe IP with Samsung glue logic (ELBI), a Samsung PHY (PMA and
+  PCS blocks) and an I/A sequencer. It inherits the common properties
+  defined in snps,dw-pcie.yaml.
+
+allOf:
+  - $ref: /schemas/pci/snps,dw-pcie.yaml#
+
+properties:
+  compatible:
+    const: samsung,exynos9820-pcie
+
+  reg:
+    minItems: 5
+    items:
+      - description: External Local Bus interface (ELBI) registers.
+      - description: Data Bus Interface (DBI) registers.
+      - description: PHY PMA registers.
+      - description: PHY PCS registers.
+      - description: PCIe configuration space region.
+      - description: I/A sequencer registers.
+
+  reg-names:
+    minItems: 5
+    items:
+      - const: elbi
+      - const: dbi
+      - const: phy
+      - const: pcs
+      - const: config
+      - const: ia
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 1
+    maxItems: 8
+
+  reset-gpios:
+    maxItems: 1
+    description: PERST# line.
+
+  vpcie3v3-supply:
+    description: Endpoint power (e.g. a fixed regulator on WLAN_REG_ON).
+
+  samsung,sysreg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the SYSREG_FSYS1 syscon.
+
+  samsung,pmu-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the PMU syscon (PHY isolation control).
+
+  dma-coherent: true
+
+  num-lanes:
+    const: 1
+
+required:
+  - reg
+  - reg-names
+  - interrupts
+  - "#address-cells"
+  - "#size-cells"
+  - "#interrupt-cells"
+  - interrupt-map
+  - interrupt-map-mask
+  - ranges
+  - device_type
+  - clocks
+  - reset-gpios
+  - samsung,sysreg
+  - samsung,pmu-syscon
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/exynos9820.h>
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    pcie@13ed0000 {
+        compatible = "samsung,exynos9820-pcie";
+        reg = <0x13ed0000 0x1000>, <0x13f00000 0x1000>,
+              <0x13ef0000 0x1000>, <0x13ee0000 0x1fc>,
+              <0x14ffe000 0x2000>, <0x13ec0000 0x1000>;
+        reg-names = "elbi", "dbi", "phy", "pcs", "config", "ia";
+        #address-cells = <3>;
+        #size-cells = <2>;
+        #interrupt-cells = <1>;
+        device_type = "pci";
+        interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-map-mask = <0 0 0 0>;
+        interrupt-map = <0 0 0 0 &gic GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_GEN2_DBI_ACLK>,
+                 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_GEN2_MSTR_ACLK>,
+                 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_GEN2_SLV_ACLK>;
+        ranges = <0x82000000 0 0x14000000 0x14000000 0 0xff0000>;
+        bus-range = <0x00 0xff>;
+        num-lanes = <1>;
+        max-link-speed = <1>;
+        reset-gpios = <&gpf2 2 GPIO_ACTIVE_LOW>;
+        samsung,sysreg = <&sysreg_fsys1>;
+        samsung,pmu-syscon = <&pmu_system_controller>;
+        dma-coherent;
+    };
+...
