+++ b/drivers/pci/controller/dwc/Makefile
@@ -9,6 +9,7 @@ obj-$(CONFIG_PCIE_ANDES_QILAI) += pcie-andes-qilai.o
 obj-$(CONFIG_PCIE_ESWIN) += pcie-eswin.o
