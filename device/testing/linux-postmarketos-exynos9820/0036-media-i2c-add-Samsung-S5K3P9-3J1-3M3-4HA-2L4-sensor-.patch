+static int s5k3j1_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3j1 *s5k3j1 = container_of(ctrl->handler, struct s5k3j1,
+					     ctrl_handler);
+	const struct s5k3j1_mode *mode = s5k3j1->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		/* The orientation settings are applied along with streaming */
+		return 0;
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - S5K3J1_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k3j1->exposure,
+					 s5k3j1->exposure->minimum,
+					 exposure_max,
+					 s5k3j1->exposure->step,
+					 s5k3j1->exposure->default_value);
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k3j1->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k3j1->regmap, S5K3J1_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k3j1->regmap, S5K3J1_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k3j1->regmap, S5K3J1_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k3j1->regmap, S5K3J1_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k3j1->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3j1_ctrl_ops = {
+	.s_ctrl = s5k3j1_set_ctrl,
+};
+
+static int s5k3j1_init_controls(struct s5k3j1 *s5k3j1)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k3j1->ctrl_handler;
+	const struct s5k3j1_mode *mode = s5k3j1->mode;
+	s64 pixel_rate, hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	s5k3j1->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5k3j1_link_freq_menu) - 1,
+					0, s5k3j1_link_freq_menu);
+	if (s5k3j1->link_freq)
+		s5k3j1->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = S5K3J1_PIXEL_RATE;
+	s5k3j1->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       0, pixel_rate, 1, pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5k3j1->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5k3j1->hblank)
+		s5k3j1->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k3j1->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K3J1_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K3J1_AGAIN_MIN, S5K3J1_AGAIN_MAX,
+			  S5K3J1_AGAIN_STEP, S5K3J1_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - S5K3J1_EXPOSURE_MARGIN;
+	s5k3j1->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3J1_EXPOSURE_MIN,
+					     exposure_max,
+					     S5K3J1_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5k3j1_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3j1_test_pattern_menu) - 1,
+				     0, 0, s5k3j1_test_pattern_menu);
+
+	s5k3j1->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k3j1->hflip)
+		s5k3j1->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k3j1->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k3j1->vflip)
+		s5k3j1->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ret = v4l2_fwnode_device_parse(s5k3j1->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5k3j1_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	s5k3j1->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5k3j1_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+	const struct s5k3j1_reg_list *reg_list = &s5k3j1->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3j1->dev);
+	if (ret)
+		return ret;
+
+	ret = 0;
+	cci_multi_reg_write(s5k3j1->regmap, s5k3j1_global_reset,
+			    ARRAY_SIZE(s5k3j1_global_reset), &ret);
+	if (ret)
+		goto error;
+
+	usleep_range(3 * USEC_PER_MSEC, 4 * USEC_PER_MSEC);
+
+	cci_multi_reg_write(s5k3j1->regmap, s5k3j1_global_setting,
+			    ARRAY_SIZE(s5k3j1_global_setting), &ret);
+	cci_multi_reg_write(s5k3j1->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k3j1->sd.ctrl_handler);
+
+	cci_write(s5k3j1->regmap, S5K3J1_REG_CTRL_MODE,
+		  S5K3J1_MODE_STREAMING |
+		  (s5k3j1->vflip->val ? S5K3J1_VFLIP : 0) |
+		  (s5k3j1->hflip->val ? S5K3J1_HFLIP : 0), &ret);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(s5k3j1->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k3j1->dev);
+
+	return ret;
+}
+
+static int s5k3j1_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+	int ret;
+
+	ret = cci_write(s5k3j1->regmap, S5K3J1_REG_CTRL_MODE, 0, NULL);
+	if (ret)
+		dev_err(s5k3j1->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5k3j1->dev);
+
+	return ret;
+}
+
+static u32 s5k3j1_get_format_code(struct s5k3j1 *s5k3j1)
+{
+	unsigned int i;
+
+	i = (s5k3j1->vflip->val ? 2 : 0) | (s5k3j1->hflip->val ? 1 : 0);
+
+	return s5k3j1_mbus_formats[i];
+}
+
+static void s5k3j1_update_pad_format(struct s5k3j1 *s5k3j1,
+				     const struct s5k3j1_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k3j1_get_format_code(s5k3j1);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3j1_set_pad_format(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5k3j1_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5k3j1_supported_modes,
+				      ARRAY_SIZE(s5k3j1_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5k3j1_update_pad_format(s5k3j1, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k3j1->mode == mode)
+		goto set_format;
+
+	/* Update limits and set FPS and exposure to default values */
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5k3j1->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5k3j1->vblank, vblank,
+				 S5K3J1_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5k3j1->vblank, vblank);
+
+	exposure_max = mode->vts - S5K3J1_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5k3j1->exposure, S5K3J1_EXPOSURE_MIN,
+				 exposure_max, S5K3J1_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5k3j1->exposure, mode->exposure);
+
+	if (s5k3j1->sd.ctrl_handler->error)
+		return s5k3j1->sd.ctrl_handler->error;
+
+	s5k3j1->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k3j1_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k3j1_get_format_code(s5k3j1);
+
+	return 0;
+}
+
+static int s5k3j1_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k3j1_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k3j1_get_format_code(s5k3j1))
+		return -EINVAL;
+
+	fse->min_width = s5k3j1_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k3j1_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+/*
+ * The pixel array is the size of the largest (first) mode. The 2x2 binned
+ * modes read the whole array; any other mode is a centred window.
+ */
+static int s5k3j1_get_selection(struct v4l2_subdev *sd,
+				const struct v4l2_subdev_client_info *ci,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+	const struct s5k3j1_mode *full = &s5k3j1_supported_modes[0];
+	const struct s5k3j1_mode *mode = s5k3j1->mode;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+			const struct v4l2_mbus_framefmt *fmt =
+				v4l2_subdev_state_get_format(sd_state, 0);
+
+			mode = v4l2_find_nearest_size(s5k3j1_supported_modes,
+					ARRAY_SIZE(s5k3j1_supported_modes),
+					width, height, fmt->width, fmt->height);
+		}
+		if (mode->width * 2 == full->width &&
+		    mode->height * 2 == full->height)
+			mode = full;
+		sel->r.left = (full->width - mode->width) / 2;
+		sel->r.top = (full->height - mode->height) / 2;
+		sel->r.width = mode->width;
+		sel->r.height = mode->height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = full->width;
+		sel->r.height = full->height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k3j1_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5k3j1->mode->width,
+			.height = s5k3j1->mode->height,
+		},
+	};
+
+	s5k3j1_set_pad_format(sd, NULL, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k3j1_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3j1_pad_ops = {
+	.set_fmt = s5k3j1_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k3j1_get_selection,
+	.enum_mbus_code = s5k3j1_enum_mbus_code,
+	.enum_frame_size = s5k3j1_enum_frame_size,
+	.enable_streams = s5k3j1_enable_streams,
+	.disable_streams = s5k3j1_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3j1_subdev_ops = {
+	.video = &s5k3j1_video_ops,
+	.pad = &s5k3j1_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3j1_internal_ops = {
+	.init_state = s5k3j1_init_state,
+};
+
+static const struct media_entity_operations s5k3j1_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k3j1_identify_sensor(struct s5k3j1 *s5k3j1)
+{
+	u64 val, rev = 0;
+	int ret;
+
+	ret = cci_read(s5k3j1->regmap, S5K3J1_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5k3j1->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	cci_read(s5k3j1->regmap, S5K3J1_REG_REVISION, &rev, NULL);
+	dev_info(s5k3j1->dev, "chip id 0x%04llx, revision 0x%04llx\n", val, rev);
+
+	if (val == 0 || val == 0xffff) {
+		dev_err(s5k3j1->dev, "implausible chip id\n");
+		return -ENODEV;
+	}
+	if (S5K3J1_CHIP_ID && val != S5K3J1_CHIP_ID)
+		dev_warn(s5k3j1->dev, "expected chip id 0x%04x\n",
+			 S5K3J1_CHIP_ID);
+
+	return 0;
+}
+
+static int s5k3j1_check_hwcfg(struct s5k3j1 *s5k3j1)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3j1->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K3J1_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3J1_DATA_LANES) {
+		dev_err(s5k3j1->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3j1->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k3j1_link_freq_menu,
+				       ARRAY_SIZE(s5k3j1_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * The MCLK pin is switched between its clock function and a parked state
+ * (input, pulled down) with the pin controller. Two sensors can share one
+ * MCLK pin (front and depth camera, rear wide and tele), and a pin belongs
+ * to one device at a time, so it is claimed at power-on and given back at
+ * power-off; the sensor that comes second gets -EBUSY. For this the DT
+ * states are called "mclk" and "mclk-off": a state named "default" is
+ * claimed by the driver core when the device is bound and never given back
+ * (older DTs have that, and then only one sensor of a pair can be bound).
+ */
+static struct pinctrl_state *s5k3j1_mclk_off_state(struct pinctrl *p)
+{
+	struct pinctrl_state *st = pinctrl_lookup_state(p, "mclk-off");
+
+	return IS_ERR(st) ? pinctrl_lookup_state(p, "default") : st;
+}
+
+/*
+ * Claim the pin, parked. Done first in the power sequence: if the sensor
+ * that shares the clock still has the pin (it keeps it for a second after
+ * its probe or last stream, runtime PM autosuspend), the wait must not sit
+ * between the reset release and the clock. A sensor that was let out of
+ * reset and only got its clock seconds later did not answer on I2C.
+ */
+static int s5k3j1_mclk_claim(struct s5k3j1 *s5k3j1)
+{
+	struct pinctrl_state *st;
+	unsigned int i;
+	int ret;
+
+	if (s5k3j1->pinctrl)
+		return 0;
+
+	s5k3j1->pinctrl = pinctrl_get(s5k3j1->dev);
+	if (IS_ERR(s5k3j1->pinctrl)) {
+		ret = PTR_ERR(s5k3j1->pinctrl);
+		s5k3j1->pinctrl = NULL;
+		return ret;
+	}
+	st = s5k3j1_mclk_off_state(s5k3j1->pinctrl);
+	ret = IS_ERR(st) ? PTR_ERR(st) :
+	      pinctrl_select_state(s5k3j1->pinctrl, st);
+	for (i = 0; ret && !IS_ERR(st) && i < 10; i++) {
+		msleep(250);
+		ret = pinctrl_select_state(s5k3j1->pinctrl, st);
+	}
+	if (ret) {
+		dev_err(s5k3j1->dev, "MCLK pin not available (%d): is the camera that shares this clock in use?\n",
+			ret);
+		pinctrl_put(s5k3j1->pinctrl);
+		s5k3j1->pinctrl = NULL;
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int s5k3j1_mclk_pin(struct s5k3j1 *s5k3j1, bool on)
+{
+	struct pinctrl_state *st;
+	int ret;
+
+	if (on) {
+		ret = s5k3j1_mclk_claim(s5k3j1);
+		if (ret)
+			return ret;
+		st = pinctrl_lookup_state(s5k3j1->pinctrl, "mclk");
+		return IS_ERR(st) ? PTR_ERR(st) :
+		       pinctrl_select_state(s5k3j1->pinctrl, st);
+	}
+
+	if (!s5k3j1->pinctrl)
+		return 0;
+	st = s5k3j1_mclk_off_state(s5k3j1->pinctrl);
+	if (!IS_ERR(st))
+		pinctrl_select_state(s5k3j1->pinctrl, st);
+	pinctrl_put(s5k3j1->pinctrl);
+	s5k3j1->pinctrl = NULL;
+
+	return 0;
+}
+
+/*
+ * Vendor sequence (fimc-is-device-module-3j1.c): buck 2, MIPI switch to this
+ * sensor (2 ms), actuator, analog, I/O and core supplies (1 ms), reset high,
+ * MCLK pin to its clock function, clock on, 9 ms. The clock gate itself is
+ * automatic, so MCLK is switched with the pin function.
+ */
+static int s5k3j1_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+	int ret;
+
+	ret = s5k3j1_mclk_claim(s5k3j1);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(s5k3j1->reset_gpio, 1);
+	gpiod_set_value_cansleep(s5k3j1->camsel_gpio, 1);
+
+	ret = regulator_bulk_enable(S5K3J1_NUM_SUPPLIES, s5k3j1->supplies);
+	if (ret) {
+		s5k3j1_mclk_pin(s5k3j1, false);
+		return ret;
+	}
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	gpiod_set_value_cansleep(s5k3j1->reset_gpio, 0);
+
+	ret = clk_prepare_enable(s5k3j1->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	ret = s5k3j1_mclk_pin(s5k3j1, true);
+	if (ret)
+		goto disable_clk;
+
+	usleep_range(10 * USEC_PER_MSEC, 11 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_clk:
+	clk_disable_unprepare(s5k3j1->mclk);
+disable_regulators:
+	gpiod_set_value_cansleep(s5k3j1->reset_gpio, 1);
+	regulator_bulk_disable(S5K3J1_NUM_SUPPLIES, s5k3j1->supplies);
+	s5k3j1_mclk_pin(s5k3j1, false);
+
+	return ret;
+}
+
+static int s5k3j1_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+
+	gpiod_set_value_cansleep(s5k3j1->reset_gpio, 1);
+
+	s5k3j1_mclk_pin(s5k3j1, false);
+	clk_disable_unprepare(s5k3j1->mclk);
+
+	regulator_bulk_disable(S5K3J1_NUM_SUPPLIES, s5k3j1->supplies);
+
+	return 0;
+}
+
+static int s5k3j1_probe(struct i2c_client *client)
+{
+	struct s5k3j1 *s5k3j1;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k3j1 = devm_kzalloc(&client->dev, sizeof(*s5k3j1), GFP_KERNEL);
+	if (!s5k3j1)
+		return -ENOMEM;
+
+	s5k3j1->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k3j1->sd, client, &s5k3j1_subdev_ops);
+
+	s5k3j1->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3j1->regmap))
+		return dev_err_probe(s5k3j1->dev, PTR_ERR(s5k3j1->regmap),
+				     "failed to init CCI\n");
+
+	s5k3j1->mclk = devm_v4l2_sensor_clk_get(s5k3j1->dev, NULL);
+	if (IS_ERR(s5k3j1->mclk))
+		return dev_err_probe(s5k3j1->dev, PTR_ERR(s5k3j1->mclk),
+				     "failed to get MCLK clock\n");
+
+	ret = clk_set_rate(s5k3j1->mclk, S5K3J1_MCLK_FREQ_26MHZ);
+	if (ret)
+		return dev_err_probe(s5k3j1->dev, ret, "failed to set MCLK\n");
+
+	freq = clk_get_rate(s5k3j1->mclk);
+	if (freq != S5K3J1_MCLK_FREQ_26MHZ)
+		return dev_err_probe(s5k3j1->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5k3j1_check_hwcfg(s5k3j1);
+	if (ret)
+		return dev_err_probe(s5k3j1->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k3j1->reset_gpio = devm_gpiod_get_optional(s5k3j1->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3j1->reset_gpio))
+		return dev_err_probe(s5k3j1->dev, PTR_ERR(s5k3j1->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	/* asserted = this sensor on the shared receiver */
+	s5k3j1->camsel_gpio = devm_gpiod_get_optional(s5k3j1->dev, "camsel",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3j1->camsel_gpio))
+		return dev_err_probe(s5k3j1->dev, PTR_ERR(s5k3j1->camsel_gpio),
+				     "cannot get camsel GPIO\n");
+
+	/* the MCLK pin is claimed at power-on and parked at power-off */
+
+	for (i = 0; i < S5K3J1_NUM_SUPPLIES; i++)
+		s5k3j1->supplies[i].supply = s5k3j1_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3j1->dev, S5K3J1_NUM_SUPPLIES,
+				      s5k3j1->supplies);
+	if (ret)
+		return dev_err_probe(s5k3j1->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5k3j1_power_on(s5k3j1->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k3j1_identify_sensor(s5k3j1);
+	if (ret) {
+		dev_err_probe(s5k3j1->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5k3j1->mode = &s5k3j1_supported_modes[0];
+	ret = s5k3j1_init_controls(s5k3j1);
+	if (ret) {
+		dev_err_probe(s5k3j1->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k3j1->sd.state_lock = s5k3j1->ctrl_handler.lock;
+	s5k3j1->sd.internal_ops = &s5k3j1_internal_ops;
+	s5k3j1->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3j1->sd.entity.ops = &s5k3j1_subdev_entity_ops;
+	s5k3j1->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3j1->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3j1->sd.entity, 1, &s5k3j1->pad);
+	if (ret) {
+		dev_err_probe(s5k3j1->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k3j1->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3j1->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5k3j1->dev);
+	pm_runtime_enable(s5k3j1->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3j1->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3j1->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k3j1->dev, 1000);
+	pm_runtime_use_autosuspend(s5k3j1->dev);
+	pm_runtime_idle(s5k3j1->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3j1->sd);
+	pm_runtime_disable(s5k3j1->dev);
+	pm_runtime_set_suspended(s5k3j1->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5k3j1->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5k3j1->sd.ctrl_handler);
+
+power_off:
+	s5k3j1_power_off(s5k3j1->dev);
+
+	return ret;
+}
+
+static void s5k3j1_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3j1 *s5k3j1 = to_s5k3j1(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k3j1->dev);
+
+	if (!pm_runtime_status_suspended(s5k3j1->dev)) {
+		s5k3j1_power_off(s5k3j1->dev);
+		pm_runtime_set_suspended(s5k3j1->dev);
+	}
+}
