+static int s5k3m3_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3m3 *s5k3m3 = container_of(ctrl->handler, struct s5k3m3,
+					     ctrl_handler);
+	const struct s5k3m3_mode *mode = s5k3m3->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		/* The orientation settings are applied along with streaming */
+		return 0;
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - S5K3M3_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k3m3->exposure,
+					 s5k3m3->exposure->minimum,
+					 exposure_max,
+					 s5k3m3->exposure->step,
+					 s5k3m3->exposure->default_value);
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k3m3->dev)) {
+		s5k3m3->ctrl_skipped++;
+		return 0;
+	}
+
+	/*
+	 * Grouped parameter hold around the write, so that it is taken over
+	 * at a frame boundary. On hardware the picture did not follow the
+	 * exposure and gain controls while streaming; whether the hold is
+	 * what was missing is not known yet.
+	 */
+	cci_write(s5k3m3->regmap, CCI_REG8(0x0104), 1, NULL);
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k3m3->regmap, S5K3M3_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k3m3->regmap, S5K3M3_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k3m3->regmap, S5K3M3_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k3m3->regmap, S5K3M3_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(s5k3m3->regmap, CCI_REG8(0x0104), 0, NULL);
+
+	s5k3m3->ctrl_sent++;
+	if (ret) {
+		s5k3m3->ctrl_failed++;
+		dev_warn_ratelimited(s5k3m3->dev, "control 0x%x = %d: write failed %d\n",
+				     ctrl->id, ctrl->val, ret);
+	}
+
+	pm_runtime_put(s5k3m3->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3m3_ctrl_ops = {
+	.s_ctrl = s5k3m3_set_ctrl,
+};
+
+static int s5k3m3_init_controls(struct s5k3m3 *s5k3m3)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k3m3->ctrl_handler;
+	const struct s5k3m3_mode *mode = s5k3m3->mode;
+	s64 pixel_rate, hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	s5k3m3->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5k3m3_link_freq_menu) - 1,
+					0, s5k3m3_link_freq_menu);
+	if (s5k3m3->link_freq)
+		s5k3m3->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = S5K3M3_PIXEL_RATE;
+	s5k3m3->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       0, pixel_rate, 1, pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5k3m3->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5k3m3->hblank)
+		s5k3m3->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k3m3->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K3M3_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K3M3_AGAIN_MIN, S5K3M3_AGAIN_MAX,
+			  S5K3M3_AGAIN_STEP, S5K3M3_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - S5K3M3_EXPOSURE_MARGIN;
+	s5k3m3->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3M3_EXPOSURE_MIN,
+					     exposure_max,
+					     S5K3M3_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5k3m3_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3m3_test_pattern_menu) - 1,
+				     0, 0, s5k3m3_test_pattern_menu);
+
+	s5k3m3->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k3m3->hflip)
+		s5k3m3->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k3m3->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k3m3->vflip)
+		s5k3m3->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ret = v4l2_fwnode_device_parse(s5k3m3->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5k3m3_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	s5k3m3->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5k3m3_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+	const struct s5k3m3_reg_list *reg_list = &s5k3m3->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3m3->dev);
+	if (ret)
+		return ret;
+
+	ret = 0;
+	cci_multi_reg_write(s5k3m3->regmap, s5k3m3_global_reset,
+			    ARRAY_SIZE(s5k3m3_global_reset), &ret);
+	if (ret)
+		goto error;
+
+	usleep_range(3 * USEC_PER_MSEC, 4 * USEC_PER_MSEC);
+
+	cci_multi_reg_write(s5k3m3->regmap, s5k3m3_global_setting,
+			    ARRAY_SIZE(s5k3m3_global_setting), &ret);
+	cci_multi_reg_write(s5k3m3->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k3m3->sd.ctrl_handler);
+
+	cci_write(s5k3m3->regmap, S5K3M3_REG_CTRL_MODE,
+		  S5K3M3_MODE_STREAMING |
+		  (s5k3m3->vflip->val ? S5K3M3_VFLIP : 0) |
+		  (s5k3m3->hflip->val ? S5K3M3_HFLIP : 0), &ret);
+	if (ret)
+		goto error;
+
+	s5k3m3->ctrl_sent = s5k3m3->ctrl_failed = s5k3m3->ctrl_skipped = 0;
+
+	{
+		u64 f0 = 0, f1 = 0;
+
+		/*
+		 * Frame counter (0xff while idle): if it runs, the sensor
+		 * streams and a silent receiver is a PHY/lane problem.
+		 */
+		msleep(70);
+		cci_read(s5k3m3->regmap, CCI_REG8(0x0005), &f0, NULL);
+		msleep(70);
+		cci_read(s5k3m3->regmap, CCI_REG8(0x0005), &f1, NULL);
+		dev_info(s5k3m3->dev, "stream on: frame counter 0x%02llx -> 0x%02llx (%s)\n",
+			 f0, f1, f0 != f1 ? "sensor is streaming" :
+			 "NOT counting");
+		f0 = f1 = 0;
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0202), &f0, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0204), &f1, NULL);
+		dev_info(s5k3m3->dev, "stream on: exposure %llu lines, analogue gain code %llu (32 = 1x)\n",
+			 f0, f1);
+		f0 = f1 = 0;
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0340), &f0, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG16(0x020e), &f1, NULL);
+		dev_info(s5k3m3->dev, "stream on: frame length %llu lines, digital gain 0x%04llx (0x100 = 1x)\n",
+			 f0, f1);
+		f0 = f1 = 0;
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0084), &f0, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0086), &f1, NULL);
+		dev_info(s5k3m3->dev, "stream on: analogue gain range of the sensor %llu..%llu\n",
+			 f0, f1);
+	}
+
+	return 0;
+
+error:
+	dev_err(s5k3m3->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k3m3->dev);
+
+	return ret;
+}
+
+static int s5k3m3_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+	int ret;
+
+	{
+		u64 e = 0, g = 0, fll = 0, hold = 0, fc = 0;
+
+		/* what the sensor ended up with, before it is stopped */
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0202), &e, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0204), &g, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG16(0x0340), &fll, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG8(0x0104), &hold, NULL);
+		cci_read(s5k3m3->regmap, CCI_REG8(0x0005), &fc, NULL);
+		dev_info(s5k3m3->dev, "stream off: exposure %llu lines, analogue gain code %llu, frame length %llu, hold %llu, frame counter 0x%02llx\n",
+			 e, g, fll, hold, fc);
+		dev_info(s5k3m3->dev, "stream off: control writes while streaming: %u sent, %u failed, %u skipped\n",
+			 s5k3m3->ctrl_sent, s5k3m3->ctrl_failed,
+			 s5k3m3->ctrl_skipped);
+	}
+
+	ret = cci_write(s5k3m3->regmap, S5K3M3_REG_CTRL_MODE, 0, NULL);
+	if (ret)
+		dev_err(s5k3m3->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5k3m3->dev);
+
+	return ret;
+}
+
+static u32 s5k3m3_get_format_code(struct s5k3m3 *s5k3m3)
+{
+	unsigned int i;
+
+	i = (s5k3m3->vflip->val ? 2 : 0) | (s5k3m3->hflip->val ? 1 : 0);
+
+	return s5k3m3_mbus_formats[i];
+}
+
+static void s5k3m3_update_pad_format(struct s5k3m3 *s5k3m3,
+				     const struct s5k3m3_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k3m3_get_format_code(s5k3m3);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3m3_set_pad_format(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5k3m3_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5k3m3_supported_modes,
+				      ARRAY_SIZE(s5k3m3_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5k3m3_update_pad_format(s5k3m3, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k3m3->mode == mode)
+		goto set_format;
+
+	/* Update limits and set FPS and exposure to default values */
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5k3m3->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5k3m3->vblank, vblank,
+				 S5K3M3_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5k3m3->vblank, vblank);
+
+	exposure_max = mode->vts - S5K3M3_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5k3m3->exposure, S5K3M3_EXPOSURE_MIN,
+				 exposure_max, S5K3M3_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5k3m3->exposure, mode->exposure);
+
+	if (s5k3m3->sd.ctrl_handler->error)
+		return s5k3m3->sd.ctrl_handler->error;
+
+	s5k3m3->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k3m3_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k3m3_get_format_code(s5k3m3);
+
+	return 0;
+}
+
+static int s5k3m3_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k3m3_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k3m3_get_format_code(s5k3m3))
+		return -EINVAL;
+
+	fse->min_width = s5k3m3_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k3m3_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+/*
+ * The pixel array is the size of the largest (first) mode. The 2x2 binned
+ * modes read the whole array; any other mode is a centred window.
+ */
+static int s5k3m3_get_selection(struct v4l2_subdev *sd,
+				const struct v4l2_subdev_client_info *ci,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+	const struct s5k3m3_mode *full = &s5k3m3_supported_modes[0];
+	const struct s5k3m3_mode *mode = s5k3m3->mode;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+			const struct v4l2_mbus_framefmt *fmt =
+				v4l2_subdev_state_get_format(sd_state, 0);
+
+			mode = v4l2_find_nearest_size(s5k3m3_supported_modes,
+					ARRAY_SIZE(s5k3m3_supported_modes),
+					width, height, fmt->width, fmt->height);
+		}
+		if (mode->width * 2 == full->width &&
+		    mode->height * 2 == full->height)
+			mode = full;
+		sel->r.left = (full->width - mode->width) / 2;
+		sel->r.top = (full->height - mode->height) / 2;
+		sel->r.width = mode->width;
+		sel->r.height = mode->height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = full->width;
+		sel->r.height = full->height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k3m3_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5k3m3->mode->width,
+			.height = s5k3m3->mode->height,
+		},
+	};
+
+	s5k3m3_set_pad_format(sd, NULL, state, &fmt);
+
+	return 0;
+}
+
+/*
+ * Besides the image on virtual channel 0 the sensor sends its phase
+ * detection ("tail PDAF") data as RAW10 lines on virtual channel 1 in
+ * every mode. The receiver has to know, or it reports an unknown packet
+ * for each of those lines. Convention with exynos9820-csis: length =
+ * width | height << 16.
+ */
+static int s5k3m3_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+	fd->num_entries = 2;
+	fd->entry[0].pixelcode = s5k3m3_get_format_code(s5k3m3);
+	fd->entry[0].bus.csi2.vc = 0;
+	fd->entry[0].bus.csi2.dt = 0x2b;	/* RAW10 */
+	fd->entry[1].pixelcode = MEDIA_BUS_FMT_Y10_1X10;
+	fd->entry[1].length = 128 | 736 << 16;
+	fd->entry[1].bus.csi2.vc = 1;
+	fd->entry[1].bus.csi2.dt = 0x2b;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k3m3_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3m3_pad_ops = {
+	.set_fmt = s5k3m3_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k3m3_get_selection,
+	.enum_mbus_code = s5k3m3_enum_mbus_code,
+	.enum_frame_size = s5k3m3_enum_frame_size,
+	.get_frame_desc = s5k3m3_get_frame_desc,
+	.enable_streams = s5k3m3_enable_streams,
+	.disable_streams = s5k3m3_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3m3_subdev_ops = {
+	.video = &s5k3m3_video_ops,
+	.pad = &s5k3m3_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3m3_internal_ops = {
+	.init_state = s5k3m3_init_state,
+};
+
+static const struct media_entity_operations s5k3m3_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k3m3_identify_sensor(struct s5k3m3 *s5k3m3)
+{
+	u64 val, rev = 0;
+	int ret;
+
+	ret = cci_read(s5k3m3->regmap, S5K3M3_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5k3m3->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	cci_read(s5k3m3->regmap, S5K3M3_REG_REVISION, &rev, NULL);
+	dev_info(s5k3m3->dev, "chip id 0x%04llx, revision 0x%04llx\n", val, rev);
+
+	if (val == 0 || val == 0xffff) {
+		dev_err(s5k3m3->dev, "implausible chip id\n");
+		return -ENODEV;
+	}
+	if (S5K3M3_CHIP_ID && val != S5K3M3_CHIP_ID)
+		dev_warn(s5k3m3->dev, "expected chip id 0x%04x\n",
+			 S5K3M3_CHIP_ID);
+
+	return 0;
+}
+
+static int s5k3m3_check_hwcfg(struct s5k3m3 *s5k3m3)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3m3->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K3M3_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3M3_DATA_LANES) {
+		dev_err(s5k3m3->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3m3->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k3m3_link_freq_menu,
+				       ARRAY_SIZE(s5k3m3_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * The MCLK pin is switched between its clock function and a parked state
+ * (input, pulled down) with the pin controller. Two sensors can share one
+ * MCLK pin (front and depth camera, rear wide and tele), and a pin belongs
+ * to one device at a time, so it is claimed at power-on and given back at
+ * power-off; the sensor that comes second gets -EBUSY. For this the DT
+ * states are called "mclk" and "mclk-off": a state named "default" is
+ * claimed by the driver core when the device is bound and never given back
+ * (older DTs have that, and then only one sensor of a pair can be bound).
+ */
+static struct pinctrl_state *s5k3m3_mclk_off_state(struct pinctrl *p)
+{
+	struct pinctrl_state *st = pinctrl_lookup_state(p, "mclk-off");
+
+	return IS_ERR(st) ? pinctrl_lookup_state(p, "default") : st;
+}
+
+/*
+ * Claim the pin, parked. Done first in the power sequence: if the sensor
+ * that shares the clock still has the pin (it keeps it for a second after
+ * its probe or last stream, runtime PM autosuspend), the wait must not sit
+ * between the reset release and the clock. A sensor that was let out of
+ * reset and only got its clock seconds later did not answer on I2C.
+ */
+static int s5k3m3_mclk_claim(struct s5k3m3 *s5k3m3)
+{
+	struct pinctrl_state *st;
+	unsigned int i;
+	int ret;
+
+	if (s5k3m3->pinctrl)
+		return 0;
+
+	s5k3m3->pinctrl = pinctrl_get(s5k3m3->dev);
+	if (IS_ERR(s5k3m3->pinctrl)) {
+		ret = PTR_ERR(s5k3m3->pinctrl);
+		s5k3m3->pinctrl = NULL;
+		return ret;
+	}
+	st = s5k3m3_mclk_off_state(s5k3m3->pinctrl);
+	ret = IS_ERR(st) ? PTR_ERR(st) :
+	      pinctrl_select_state(s5k3m3->pinctrl, st);
+	for (i = 0; ret && !IS_ERR(st) && i < 10; i++) {
+		msleep(250);
+		ret = pinctrl_select_state(s5k3m3->pinctrl, st);
+	}
+	if (ret) {
+		dev_err(s5k3m3->dev, "MCLK pin not available (%d): is the camera that shares this clock in use?\n",
+			ret);
+		pinctrl_put(s5k3m3->pinctrl);
+		s5k3m3->pinctrl = NULL;
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int s5k3m3_mclk_pin(struct s5k3m3 *s5k3m3, bool on)
+{
+	struct pinctrl_state *st;
+	int ret;
+
+	if (on) {
+		ret = s5k3m3_mclk_claim(s5k3m3);
+		if (ret)
+			return ret;
+		st = pinctrl_lookup_state(s5k3m3->pinctrl, "mclk");
+		return IS_ERR(st) ? PTR_ERR(st) :
+		       pinctrl_select_state(s5k3m3->pinctrl, st);
+	}
+
+	if (!s5k3m3->pinctrl)
+		return 0;
+	st = s5k3m3_mclk_off_state(s5k3m3->pinctrl);
+	if (!IS_ERR(st))
+		pinctrl_select_state(s5k3m3->pinctrl, st);
+	pinctrl_put(s5k3m3->pinctrl);
+	s5k3m3->pinctrl = NULL;
+
+	return 0;
+}
+
+/*
+ * Vendor sequence (fimc-is-device-module-3m3.c): buck 2, analog, core and
+ * actuator supplies (2 ms), rear camera I/O rail, I/O rail of the shared
+ * I2C bus, sensor I/O rail, MCLK pin to its clock function, clock on, reset
+ * high, 8 ms. The clock gate itself is automatic, so MCLK is switched with
+ * the pin function.
+ */
+static int s5k3m3_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+	unsigned int i;
+	int ret;
+
+	ret = s5k3m3_mclk_claim(s5k3m3);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(s5k3m3->reset_gpio, 1);
+
+	/*
+	 * One supply after the other, in the order of the list: the supplies
+	 * sit on three different PMIC buses and regulator_bulk_enable() would
+	 * switch them concurrently. The very first power-on (parallel)
+	 * froze the SoC without a trace; the step-by-step bring-up, which
+	 * is sequential, has always worked. Cause not established.
+	 */
+	for (i = 0; i < S5K3M3_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(s5k3m3->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "supply %s: %d\n", s5k3m3_supply_names[i], ret);
+			while (i--)
+				regulator_disable(s5k3m3->supplies[i].consumer);
+			s5k3m3_mclk_pin(s5k3m3, false);
+			return ret;
+		}
+		usleep_range(500, 1000);
+	}
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(s5k3m3->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	ret = s5k3m3_mclk_pin(s5k3m3, true);
+	if (ret)
+		goto disable_clk;
+
+	gpiod_set_value_cansleep(s5k3m3->reset_gpio, 0);
+
+	usleep_range(9 * USEC_PER_MSEC, 10 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_clk:
+	clk_disable_unprepare(s5k3m3->mclk);
+disable_regulators:
+	gpiod_set_value_cansleep(s5k3m3->reset_gpio, 1);
+	regulator_bulk_disable(S5K3M3_NUM_SUPPLIES, s5k3m3->supplies);
+	s5k3m3_mclk_pin(s5k3m3, false);
+
+	return ret;
+}
+
+static int s5k3m3_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+
+	gpiod_set_value_cansleep(s5k3m3->reset_gpio, 1);
+
+	s5k3m3_mclk_pin(s5k3m3, false);
+	clk_disable_unprepare(s5k3m3->mclk);
+
+	regulator_bulk_disable(S5K3M3_NUM_SUPPLIES, s5k3m3->supplies);
+
+	return 0;
+}
+
+static int s5k3m3_probe(struct i2c_client *client)
+{
+	struct s5k3m3 *s5k3m3;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k3m3 = devm_kzalloc(&client->dev, sizeof(*s5k3m3), GFP_KERNEL);
+	if (!s5k3m3)
+		return -ENOMEM;
+
+	s5k3m3->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k3m3->sd, client, &s5k3m3_subdev_ops);
+
+	s5k3m3->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3m3->regmap))
+		return dev_err_probe(s5k3m3->dev, PTR_ERR(s5k3m3->regmap),
+				     "failed to init CCI\n");
+
+	s5k3m3->mclk = devm_v4l2_sensor_clk_get(s5k3m3->dev, NULL);
+	if (IS_ERR(s5k3m3->mclk))
+		return dev_err_probe(s5k3m3->dev, PTR_ERR(s5k3m3->mclk),
+				     "failed to get MCLK clock\n");
+
+	ret = clk_set_rate(s5k3m3->mclk, S5K3M3_MCLK_FREQ_26MHZ);
+	if (ret)
+		return dev_err_probe(s5k3m3->dev, ret, "failed to set MCLK\n");
+
+	freq = clk_get_rate(s5k3m3->mclk);
+	if (freq != S5K3M3_MCLK_FREQ_26MHZ)
+		return dev_err_probe(s5k3m3->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5k3m3_check_hwcfg(s5k3m3);
+	if (ret)
+		return dev_err_probe(s5k3m3->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k3m3->reset_gpio = devm_gpiod_get_optional(s5k3m3->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3m3->reset_gpio))
+		return dev_err_probe(s5k3m3->dev, PTR_ERR(s5k3m3->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	/* the MCLK pin is claimed at power-on and parked at power-off */
+
+	for (i = 0; i < S5K3M3_NUM_SUPPLIES; i++)
+		s5k3m3->supplies[i].supply = s5k3m3_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3m3->dev, S5K3M3_NUM_SUPPLIES,
+				      s5k3m3->supplies);
+	if (ret)
+		return dev_err_probe(s5k3m3->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5k3m3_power_on(s5k3m3->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k3m3_identify_sensor(s5k3m3);
+	if (ret) {
+		dev_err_probe(s5k3m3->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5k3m3->mode = &s5k3m3_supported_modes[0];
+	ret = s5k3m3_init_controls(s5k3m3);
+	if (ret) {
+		dev_err_probe(s5k3m3->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k3m3->sd.state_lock = s5k3m3->ctrl_handler.lock;
+	s5k3m3->sd.internal_ops = &s5k3m3_internal_ops;
+	s5k3m3->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3m3->sd.entity.ops = &s5k3m3_subdev_entity_ops;
+	s5k3m3->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3m3->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3m3->sd.entity, 1, &s5k3m3->pad);
+	if (ret) {
+		dev_err_probe(s5k3m3->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k3m3->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3m3->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5k3m3->dev);
+	pm_runtime_enable(s5k3m3->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3m3->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3m3->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k3m3->dev, 1000);
+	pm_runtime_use_autosuspend(s5k3m3->dev);
+	pm_runtime_idle(s5k3m3->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3m3->sd);
+	pm_runtime_disable(s5k3m3->dev);
+	pm_runtime_set_suspended(s5k3m3->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5k3m3->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5k3m3->sd.ctrl_handler);
+
+power_off:
+	s5k3m3_power_off(s5k3m3->dev);
+
+	return ret;
+}
+
+static void s5k3m3_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3m3 *s5k3m3 = to_s5k3m3(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k3m3->dev);
+
+	if (!pm_runtime_status_suspended(s5k3m3->dev)) {
+		s5k3m3_power_off(s5k3m3->dev);
+		pm_runtime_set_suspended(s5k3m3->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k3m3_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k3m3_power_off, s5k3m3_power_on, NULL)
+};
+
+static const struct of_device_id s5k3m3_of_match[] = {
+	{ .compatible = "samsung,s5k3m3" },
+	{ /* sentinel */ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct i2c_driver s5k3m3_i2c_driver = {
+	.driver = {
+		.name = "s5k3m3",
+		.pm = &s5k3m3_pm_ops,
+		.of_match_table = s5k3m3_of_match,
+	},
+	.probe = s5k3m3_probe,
+	.remove = s5k3m3_remove,
+};
+
+module_i2c_driver(s5k3m3_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K3M3 image sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/s5k3p9.c b/drivers/media/i2c/s5k3p9.c
new file mode 100644
index 0000000000..e75c4f1cf6
--- /dev/null
+++ b/drivers/media/i2c/s5k3p9.c
@@ -0,0 +1,1396 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K3P9 16 MP image sensor (rear ultra-wide camera of the Galaxy
+ * S10 family). Fixed focus, 4-lane CSI-2 D-PHY at 2054 Mbit/s per lane,
+ * RAW10, 26 MHz external clock.
+ *
+ * Based on the S5K3M5 driver, Copyright (c) 2025 Linaro Ltd, with register
+ * tables and the power sequence from the Samsung SM-G975F kernel.
+ */
+
+#include <linux/pinctrl/consumer.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K3P9_LINK_FREQ_1027MHZ		(1027ULL * HZ_PER_MHZ)
+#define S5K3P9_MCLK_FREQ_26MHZ		(26 * HZ_PER_MHZ)
+/* VCO 26 MHz / 6 * 226, x4 / 7 (0x0300..0x0306 in the mode tables) */
+#define S5K3P9_PIXEL_RATE		559619047
+#define S5K3P9_DATA_LANES		4
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5K3P9_REG_CHIP_ID		CCI_REG16(0x0000)
+/* Not confirmed on hardware yet; the vendor driver does not check it */
+#define S5K3P9_CHIP_ID			0x3109
+#define S5K3P9_REG_REVISION		CCI_REG16(0x0002)
+
+/* Both streaming and flipping settings are controlled at the same time */
+#define S5K3P9_REG_CTRL_MODE		CCI_REG16(0x0100)
+#define S5K3P9_MODE_STREAMING		BIT(8)
+#define S5K3P9_VFLIP			BIT(1)
+#define S5K3P9_HFLIP			BIT(0)
+
+#define S5K3P9_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K3P9_EXPOSURE_MIN		7
+#define S5K3P9_EXPOSURE_STEP		1
+#define S5K3P9_EXPOSURE_MARGIN		8
+
+/* Analogue gain code = gain * 32, 1x..16x (vendor driver: 0x20..0x200) */
+#define S5K3P9_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K3P9_AGAIN_MIN		0x20
+#define S5K3P9_AGAIN_MAX		0x200
+#define S5K3P9_AGAIN_STEP		1
+#define S5K3P9_AGAIN_DEFAULT		0x20
+
+#define S5K3P9_REG_VTS			CCI_REG16(0x0340)
+#define S5K3P9_VTS_MAX			0xffff
+
+#define S5K3P9_REG_HTS			CCI_REG16(0x0342)
+#define S5K3P9_REG_X_ADDR_START		CCI_REG16(0x0344)
+#define S5K3P9_REG_Y_ADDR_START		CCI_REG16(0x0346)
+#define S5K3P9_REG_X_ADDR_END		CCI_REG16(0x0348)
+#define S5K3P9_REG_Y_ADDR_END		CCI_REG16(0x034a)
+#define S5K3P9_REG_X_OUTPUT_SIZE	CCI_REG16(0x034c)
+#define S5K3P9_REG_Y_OUTPUT_SIZE	CCI_REG16(0x034e)
+
+#define S5K3P9_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5k3p9(_sd)			container_of(_sd, struct s5k3p9, sd)
+
+static const s64 s5k3p9_link_freq_menu[] = {
+	S5K3P9_LINK_FREQ_1027MHZ,
+};
+
+/* List of supported formats to cover horizontal and vertical flip controls */
+static const u32 s5k3p9_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5k3p9_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct s5k3p9_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+
+	const struct s5k3p9_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const s5k3p9_test_pattern_menu[] = {
+	"Disabled",
+	"Solid colour",
+	"Colour bars",
+	"Fade to grey colour bars",
+	"PN9",
+};
+
+static const char * const s5k3p9_supply_names[] = {
+	/* Order of the vendor power sequence */
+	"vddbuck1",	/* PMIC buck 1 (always on in the vendor kernel) */
+	"vddbb",	/* PMIC buck-boost (always on in the vendor kernel) */
+	"vddext",	/* VDD_EXT_1P3_PB02 */
+	"vdda",		/* VDDA_2.8V_WIDESUB */
+	"vddd",		/* VDDD_1.05V_WIDESUB */
+	"vddio",	/* VDDIO_1.8V_WIDESUB */
+};
+
+#define S5K3P9_NUM_SUPPLIES	ARRAY_SIZE(s5k3p9_supply_names)
+
+struct s5k3p9 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct pinctrl *pinctrl;
+	struct regulator_bulk_data supplies[S5K3P9_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5k3p9_mode *mode;
+};
+
+/*
+ * Register tables from the Samsung SM-G975F kernel
+ * (fimc-is-cis-3p9-setA.h, "S5K3P9SN_REV0.1_Ver0.H_20191230").
+ * A 3 ms delay is needed between the two parts of the global table.
+ */
+static const struct cci_reg_sequence s5k3p9_global_reset[] = {
+	{ CCI_REG16(0xfcfc), 0x4000 },
+	{ CCI_REG16(0x6000), 0x0085 },
+	{ CCI_REG16(0x6018), 0x0001 },
+	{ CCI_REG16(0x7004), 0x1964 },
+	{ CCI_REG16(0x70d8), 0x18e2 },
+	{ CCI_REG16(0x6014), 0x0001 },
+};
+
+static const struct cci_reg_sequence s5k3p9_global_setting[] = {
+	{ CCI_REG16(0x6214), 0x7970 },
+	{ CCI_REG16(0x6218), 0x7150 },
+	{ CCI_REG16(0x0136), 0x1a00 },
+	{ CCI_REG16(0x6004), 0x0001 },
+	{ CCI_REG16(0x6028), 0x2000 },
