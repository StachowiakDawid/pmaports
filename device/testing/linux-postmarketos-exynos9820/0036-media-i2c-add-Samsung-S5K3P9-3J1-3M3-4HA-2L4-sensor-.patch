+	help
+	  This is a V4L2 sensor driver for the Samsung S5K3M3 12MP raw
+	  camera sensor (telephoto camera of the Galaxy S10 family).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k3m3.
+
+config VIDEO_S5K4HA
+	tristate "Samsung S5K4HA sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for the Samsung S5K4HA 8MP raw
+	  camera sensor (second front camera of the Galaxy S10+).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k4ha.
+
+config VIDEO_S5K2L4
+	tristate "Samsung S5K2L4 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for the Samsung S5K2L4 12MP raw
+	  camera sensor (main rear wide camera of the Galaxy S10 family).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k2l4.
+
+config VIDEO_S5K3P9
+	tristate "Samsung S5K3P9 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for the Samsung S5K3P9 16MP raw
+	  camera sensor (ultra-wide camera of the Galaxy S10 family).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k3p9.
+
 config VIDEO_S5K5BAF
 	tristate "Samsung S5K5BAF sensor support"
 	help
