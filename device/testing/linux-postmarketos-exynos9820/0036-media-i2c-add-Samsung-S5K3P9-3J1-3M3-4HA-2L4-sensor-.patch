diff --git a/drivers/media/i2c/ak7375.c b/drivers/media/i2c/ak7375.c
index 1ece5708b4..82a402439e 100644
--- a/drivers/media/i2c/ak7375.c
+++ b/drivers/media/i2c/ak7375.c
@@ -36,6 +36,8 @@ struct ak73xx_chipdef {
 	 * I2C messages.
 	 */
 	u16 power_delay_us;
+	/* Product ID register, logged at power-on if not 0 */
+	u8 reg_product_id;
 };
 
 static const struct ak73xx_chipdef ak7345_cdef = {
@@ -51,6 +53,26 @@ static const struct ak73xx_chipdef ak7345_cdef = {
 	.power_delay_us	= 20000,
 };
 
+/*
+ * AK7374 (lens actuators of the Samsung Galaxy S10 cameras): the 9 bit
+ * position format of the AK7345 with the standby mode of the AK7375.
+ * Product ID 0x0e in register 0xf3.
+ */
+static const struct ak73xx_chipdef ak7374_cdef = {
+	.reg_position	= 0x0,
+	.reg_cont	= 0x2,
+	.shift_pos	= 7,	/* 9 bits position values, need to << 7 */
+	.mode_active	= 0x0,
+	.mode_standby	= 0x40,
+	.has_standby	= true,
+	.focus_pos_max	= 511,
+	.focus_steps	= 1,
+	.ctrl_steps	= 16,
+	.ctrl_delay_us	= 1000,
+	.power_delay_us	= 10000,
+	.reg_product_id	= 0xf3,
+};
+
 static const struct ak73xx_chipdef ak7375_cdef = {
 	.reg_position	= 0x0,
 	.reg_cont	= 0x2,
@@ -80,6 +102,7 @@ struct ak7375_device {
 
 	/* active or standby mode */
 	bool active;
+	bool id_logged;
 };
 
 static inline struct ak7375_device *to_ak7375_vcm(struct v4l2_ctrl *ctrl)
@@ -308,9 +331,19 @@ static int __maybe_unused ak7375_vcm_resume(struct device *dev)
 			       cdef->mode_active, 1);
 	if (ret) {
 		dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
+		regulator_bulk_disable(ARRAY_SIZE(ak7375_supply_names),
+				       ak7375_dev->supplies);
 		return ret;
 	}
 
+	if (cdef->reg_product_id && !ak7375_dev->id_logged) {
+		struct i2c_client *client = v4l2_get_subdevdata(sd);
+
+		ret = i2c_smbus_read_byte_data(client, cdef->reg_product_id);
+		dev_info(dev, "product id 0x%02x\n", ret);
+		ak7375_dev->id_logged = true;
+	}
+
 	for (val = ak7375_dev->focus->val % cdef->ctrl_steps;
 	     val <= ak7375_dev->focus->val;
 	     val += cdef->ctrl_steps) {
@@ -329,6 +362,7 @@ static int __maybe_unused ak7375_vcm_resume(struct device *dev)
 
 static const struct of_device_id ak7375_of_table[] = {
 	{ .compatible = "asahi-kasei,ak7345", .data = &ak7345_cdef, },
+	{ .compatible = "asahi-kasei,ak7374", .data = &ak7374_cdef, },
 	{ .compatible = "asahi-kasei,ak7375", .data = &ak7375_cdef, },
 	{ /* sentinel */ }
 };
diff --git a/drivers/media/i2c/s5k2l4.c b/drivers/media/i2c/s5k2l4.c
new file mode 100644
index 0000000000..9d878122eb
--- /dev/null
+++ b/drivers/media/i2c/s5k2l4.c
@@ -0,0 +1,4144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K2L4 12 MP dual-pixel image sensor (main rear "wide" camera of
+ * the Galaxy S10 family). 4-lane CSI-2 D-PHY (RAW10, 26 MHz external clock)
+ * on the CSIS0 receiver, whose MIPI PHY (M4S4 "top") is physically shared
+ * with the display DSI PHY; the receiver driver keeps the shared isolation
+ * bit (PMU 0x70C) alone so bringing the camera up does not disturb the live
+ * screen. The lens has a voice-coil actuator (AK7374, a separate device) and
+ * a dual-aperture / OIS microcontroller that is not powered here.
+ *
+ * Besides the picture (virtual channel 0) the sensor emits "tail PDAF" phase
+ * detection data on VC1 in every mode; the receiver drops it.
+ *
+ * Based on the S5K3M5/S5K3P9 drivers, Copyright (c) 2025 Linaro Ltd, with the
+ * firmware patch (T&P), register tables and the power sequence from the
+ * Samsung SM-G975F kernel. Generated from s5k3j1.c by a script.
+ */
+
+#include <linux/pinctrl/consumer.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/bitops.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K2L4_LINK_FREQ_676MHZ	(676000ULL * HZ_PER_KHZ)	/* 1352 Mbit/s per lane */
+#define S5K2L4_LINK_FREQ_1027MHZ	(1027000ULL * HZ_PER_KHZ)	/* 2054 Mbit/s per lane */
+#define S5K2L4_MCLK_FREQ_26MHZ		(26 * HZ_PER_MHZ)
+/* vendor pllinfo */
+#define S5K2L4_PIXEL_RATE		1080444000
+#define S5K2L4_DATA_LANES		4
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5K2L4_REG_CHIP_ID		CCI_REG16(0x0000)
+/* Unknown until read on hardware; the vendor driver does not check it */
+#define S5K2L4_CHIP_ID			0
+#define S5K2L4_REG_REVISION		CCI_REG16(0x0002)
+
+/* Both streaming and flipping settings are controlled at the same time */
+#define S5K2L4_REG_CTRL_MODE		CCI_REG16(0x0100)
+#define S5K2L4_MODE_STREAMING		BIT(8)
+#define S5K2L4_VFLIP			BIT(1)
+#define S5K2L4_HFLIP			BIT(0)
+
+#define S5K2L4_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K2L4_EXPOSURE_MIN		16
+#define S5K2L4_EXPOSURE_STEP		1
+#define S5K2L4_EXPOSURE_MARGIN		48
+
+/* Analogue gain code = gain * 32, 1x..16x (vendor driver: 0x20..0x200) */
+#define S5K2L4_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K2L4_AGAIN_MIN		0x20
+#define S5K2L4_AGAIN_MAX		0x200
+#define S5K2L4_AGAIN_STEP		1
+#define S5K2L4_AGAIN_DEFAULT		0x20
+
+#define S5K2L4_REG_VTS			CCI_REG16(0x0340)
+#define S5K2L4_VTS_MAX			0xffff
+
+#define S5K2L4_REG_HTS			CCI_REG16(0x0342)
+#define S5K2L4_REG_X_ADDR_START		CCI_REG16(0x0344)
+#define S5K2L4_REG_Y_ADDR_START		CCI_REG16(0x0346)
+#define S5K2L4_REG_X_ADDR_END		CCI_REG16(0x0348)
+#define S5K2L4_REG_Y_ADDR_END		CCI_REG16(0x034a)
+#define S5K2L4_REG_X_OUTPUT_SIZE	CCI_REG16(0x034c)
+#define S5K2L4_REG_Y_OUTPUT_SIZE	CCI_REG16(0x034e)
+
+#define S5K2L4_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5k2l4(_sd)			container_of(_sd, struct s5k2l4, sd)
+
+static const s64 s5k2l4_link_freq_menu[] = {
+	S5K2L4_LINK_FREQ_676MHZ,
+	S5K2L4_LINK_FREQ_1027MHZ,
+};
+
+/* List of supported formats to cover horizontal and vertical flip controls */
+static const u32 s5k2l4_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGBRG10_1X10,	MEDIA_BUS_FMT_SBGGR10_1X10,
+	MEDIA_BUS_FMT_SRGGB10_1X10,	MEDIA_BUS_FMT_SGRBG10_1X10,
+};
+
+struct s5k2l4_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct s5k2l4_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+	unsigned int link_freq_index;	/* Entry of the link frequency menu */
+
+	const struct s5k2l4_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const s5k2l4_test_pattern_menu[] = {
+	"Disabled",
+	"Solid colour",
+	"Colour bars",
+	"Fade to grey colour bars",
+	"PN9",
+};
+
+static const char * const s5k2l4_supply_names[] = {
+	/* Order of the vendor power sequence */
+	"vddret",	/* VDDD_RET_1.0V_CAM (S2MPB03 LDO4, 1.025 V) */
+	"vdda28",	/* VDDA_2.8V_CAM (S2MPB03 LDO6) */
+	"vdda24",	/* VDDA_2.4V_CAM (S2MPB03 LDO5) */
+	"vddd",	/* VDDD_1.0V_CAM (S2MPB03 LDO1) */
+	"vddaf",	/* VDDAF_COMMON_CAM (S2MPB02 LDO14, lens actuator 3.3 V) */
+	"vddio",	/* VDDIO_1.8V_CAM (S2MPB03 LDO3, also the I2C pull-up rail) */
+	"vddq",	/* VDDQ_1.1V_CAM (S2MPB03 LDO2) */
+};
+
+#define S5K2L4_NUM_SUPPLIES	ARRAY_SIZE(s5k2l4_supply_names)
+
+struct s5k2l4 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct pinctrl *pinctrl;
+	struct regulator_bulk_data supplies[S5K2L4_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5k2l4_mode *mode;
+	/* modes whose lane rate the DT endpoint lists */
+	const struct s5k2l4_mode *modes;
+	unsigned int num_modes;
+	unsigned long link_freq_bitmap;
+
+	/* control writes since stream-on: sent, failed, skipped (not powered) */
+	unsigned int ctrl_sent, ctrl_failed, ctrl_skipped;
+
+	/*
+	 * extra pause after every power-on step, in ms: 0, or 200 after a
+	 * probe that only got an answer with the slow power-on
+	 */
+	unsigned int slow_ms;
+};
+
+/*
+ * Register tables from the Samsung SM-G975F kernel (fimc-is-cis-2l4-setA.h).
+ */
