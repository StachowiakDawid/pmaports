+static int s5k2l4_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k2l4 *s5k2l4 = container_of(ctrl->handler, struct s5k2l4,
+					     ctrl_handler);
+	const struct s5k2l4_mode *mode = s5k2l4->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		/* The orientation settings are applied along with streaming */
+		return 0;
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - S5K2L4_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k2l4->exposure,
+					 s5k2l4->exposure->minimum,
+					 exposure_max,
+					 s5k2l4->exposure->step,
+					 s5k2l4->exposure->default_value);
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k2l4->dev)) {
+		s5k2l4->ctrl_skipped++;
+		return 0;
+	}
+
+	/*
+	 * Grouped parameter hold around the write, so that it is taken over
+	 * at a frame boundary. On hardware the picture did not follow the
+	 * exposure and gain controls while streaming; whether the hold is
+	 * what was missing is not known yet.
+	 */
+	cci_write(s5k2l4->regmap, CCI_REG8(0x0104), 1, NULL);
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k2l4->regmap, S5K2L4_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k2l4->regmap, S5K2L4_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k2l4->regmap, S5K2L4_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k2l4->regmap, S5K2L4_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(s5k2l4->regmap, CCI_REG8(0x0104), 0, NULL);
+
+	s5k2l4->ctrl_sent++;
+	if (ret) {
+		s5k2l4->ctrl_failed++;
+		dev_warn_ratelimited(s5k2l4->dev, "control 0x%x = %d: write failed %d\n",
+				     ctrl->id, ctrl->val, ret);
+	}
+
+	pm_runtime_put(s5k2l4->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k2l4_ctrl_ops = {
+	.s_ctrl = s5k2l4_set_ctrl,
+};
+
+static int s5k2l4_init_controls(struct s5k2l4 *s5k2l4)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k2l4->ctrl_handler;
+	const struct s5k2l4_mode *mode = s5k2l4->mode;
+	s64 pixel_rate, hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	s5k2l4->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5k2l4_link_freq_menu) - 1,
+					mode->link_freq_index,
+					s5k2l4_link_freq_menu);
+	if (s5k2l4->link_freq)
+		s5k2l4->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = S5K2L4_PIXEL_RATE;
+	s5k2l4->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       0, pixel_rate, 1, pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5k2l4->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5k2l4->hblank)
+		s5k2l4->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k2l4->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K2L4_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K2L4_AGAIN_MIN, S5K2L4_AGAIN_MAX,
+			  S5K2L4_AGAIN_STEP, S5K2L4_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - S5K2L4_EXPOSURE_MARGIN;
+	s5k2l4->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K2L4_EXPOSURE_MIN,
+					     exposure_max,
+					     S5K2L4_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5k2l4_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k2l4_test_pattern_menu) - 1,
+				     0, 0, s5k2l4_test_pattern_menu);
+
+	s5k2l4->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 1);
+	if (s5k2l4->hflip)
+		s5k2l4->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k2l4->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 1);
+	if (s5k2l4->vflip)
+		s5k2l4->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ret = v4l2_fwnode_device_parse(s5k2l4->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5k2l4_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	s5k2l4->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5k2l4_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+	const struct s5k2l4_reg_list *reg_list = &s5k2l4->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k2l4->dev);
+	if (ret)
+		return ret;
+
+	ret = 0;
+	cci_multi_reg_write(s5k2l4->regmap, s5k2l4_global_reset,
+			    ARRAY_SIZE(s5k2l4_global_reset), &ret);
+	if (ret)
+		goto error;
+
+	usleep_range(5 * USEC_PER_MSEC, 6 * USEC_PER_MSEC);
+
+	cci_multi_reg_write(s5k2l4->regmap, s5k2l4_global_setting,
+			    ARRAY_SIZE(s5k2l4_global_setting), &ret);
+	cci_multi_reg_write(s5k2l4->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k2l4->sd.ctrl_handler);
+
+	cci_write(s5k2l4->regmap, S5K2L4_REG_CTRL_MODE,
+		  S5K2L4_MODE_STREAMING |
+		  (s5k2l4->vflip->val ? S5K2L4_VFLIP : 0) |
+		  (s5k2l4->hflip->val ? S5K2L4_HFLIP : 0), &ret);
+	if (ret)
+		goto error;
+
+	s5k2l4->ctrl_sent = s5k2l4->ctrl_failed = s5k2l4->ctrl_skipped = 0;
+
+	{
+		u64 f0 = 0, f1 = 0;
+
+		/*
+		 * Frame counter (0xff while idle): if it runs, the sensor
+		 * streams and a silent receiver is a PHY/lane problem.
+		 */
+		msleep(70);
+		cci_read(s5k2l4->regmap, CCI_REG8(0x0005), &f0, NULL);
+		msleep(70);
+		cci_read(s5k2l4->regmap, CCI_REG8(0x0005), &f1, NULL);
+		dev_info(s5k2l4->dev, "stream on: frame counter 0x%02llx -> 0x%02llx (%s)\n",
+			 f0, f1, f0 != f1 ? "sensor is streaming" :
+			 "NOT counting");
+		f0 = f1 = 0;
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0202), &f0, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0204), &f1, NULL);
+		dev_info(s5k2l4->dev, "stream on: exposure %llu lines, analogue gain code %llu (32 = 1x)\n",
+			 f0, f1);
+		f0 = f1 = 0;
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0340), &f0, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG16(0x020e), &f1, NULL);
+		dev_info(s5k2l4->dev, "stream on: frame length %llu lines, digital gain 0x%04llx (0x100 = 1x)\n",
+			 f0, f1);
+		f0 = f1 = 0;
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0084), &f0, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0086), &f1, NULL);
+		dev_info(s5k2l4->dev, "stream on: analogue gain range of the sensor %llu..%llu\n",
+			 f0, f1);
+	}
+
+	return 0;
+
+error:
+	dev_err(s5k2l4->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k2l4->dev);
+
+	return ret;
+}
+
+static int s5k2l4_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+	int ret;
+
+	{
+		u64 e = 0, g = 0, fll = 0, hold = 0, fc = 0;
+
+		/* what the sensor ended up with, before it is stopped */
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0202), &e, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0204), &g, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG16(0x0340), &fll, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG8(0x0104), &hold, NULL);
+		cci_read(s5k2l4->regmap, CCI_REG8(0x0005), &fc, NULL);
+		dev_info(s5k2l4->dev, "stream off: exposure %llu lines, analogue gain code %llu, frame length %llu, hold %llu, frame counter 0x%02llx\n",
+			 e, g, fll, hold, fc);
+		dev_info(s5k2l4->dev, "stream off: control writes while streaming: %u sent, %u failed, %u skipped\n",
+			 s5k2l4->ctrl_sent, s5k2l4->ctrl_failed,
+			 s5k2l4->ctrl_skipped);
+	}
+
+	ret = cci_write(s5k2l4->regmap, S5K2L4_REG_CTRL_MODE, 0, NULL);
+	if (ret)
+		dev_err(s5k2l4->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5k2l4->dev);
+
+	return ret;
+}
+
+static u32 s5k2l4_get_format_code(struct s5k2l4 *s5k2l4)
+{
+	unsigned int i;
+
+	i = (s5k2l4->vflip->val ? 2 : 0) | (s5k2l4->hflip->val ? 1 : 0);
+
+	return s5k2l4_mbus_formats[i];
+}
+
+static void s5k2l4_update_pad_format(struct s5k2l4 *s5k2l4,
+				     const struct s5k2l4_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k2l4_get_format_code(s5k2l4);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k2l4_set_pad_format(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5k2l4_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5k2l4->modes,
+				      s5k2l4->num_modes,
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5k2l4_update_pad_format(s5k2l4, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k2l4->mode == mode)
+		goto set_format;
+
+	/* Update limits and set FPS and exposure to default values */
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5k2l4->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5k2l4->vblank, vblank,
+				 S5K2L4_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5k2l4->vblank, vblank);
+
+	exposure_max = mode->vts - S5K2L4_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5k2l4->exposure, S5K2L4_EXPOSURE_MIN,
+				 exposure_max, S5K2L4_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5k2l4->exposure, mode->exposure);
+
+	/* the receiver reads it at stream start for the PHY settle time */
+	__v4l2_ctrl_s_ctrl(s5k2l4->link_freq, mode->link_freq_index);
+
+	if (s5k2l4->sd.ctrl_handler->error)
+		return s5k2l4->sd.ctrl_handler->error;
+
+	s5k2l4->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k2l4_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k2l4_get_format_code(s5k2l4);
+
+	return 0;
+}
+
+static int s5k2l4_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+
+	if (fse->index >= s5k2l4->num_modes)
+		return -EINVAL;
+
+	if (fse->code != s5k2l4_get_format_code(s5k2l4))
+		return -EINVAL;
+
+	fse->min_width = s5k2l4->modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k2l4->modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+/*
+ * The pixel array is the size of the largest (first) mode. The 2x2 binned
+ * modes read the whole array; any other mode is a centred window.
+ */
+static int s5k2l4_get_selection(struct v4l2_subdev *sd,
+				const struct v4l2_subdev_client_info *ci,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+	const struct s5k2l4_mode *full = &s5k2l4_supported_modes[0];
+	const struct s5k2l4_mode *mode = s5k2l4->mode;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+			const struct v4l2_mbus_framefmt *fmt =
+				v4l2_subdev_state_get_format(sd_state, 0);
+
+			mode = v4l2_find_nearest_size(s5k2l4->modes,
+					s5k2l4->num_modes,
+					width, height, fmt->width, fmt->height);
+		}
+		if (mode->width * 2 == full->width &&
+		    mode->height * 2 == full->height)
+			mode = full;
+		sel->r.left = (full->width - mode->width) / 2;
+		sel->r.top = (full->height - mode->height) / 2;
+		sel->r.width = mode->width;
+		sel->r.height = mode->height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = full->width;
+		sel->r.height = full->height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k2l4_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5k2l4->mode->width,
+			.height = s5k2l4->mode->height,
+		},
+	};
+
+	s5k2l4_set_pad_format(sd, NULL, state, &fmt);
+
+	return 0;
+}
+
+/*
+ * Besides the image on virtual channel 0 the sensor sends its phase
+ * detection ("tail PDAF") data as RAW10 lines on virtual channel 1 in
+ * every mode. The receiver has to know, or it reports an unknown packet
+ * for each of those lines. Convention with exynos9820-csis: length =
+ * width | height << 16.
+ */
+static int s5k2l4_get_frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+				struct v4l2_mbus_frame_desc *fd)
+{
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+
+	fd->type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2;
+	fd->num_entries = 2;
+	fd->entry[0].pixelcode = s5k2l4_get_format_code(s5k2l4);
+	fd->entry[0].bus.csi2.vc = 0;
+	fd->entry[0].bus.csi2.dt = 0x2b;	/* RAW10 */
+	fd->entry[1].pixelcode = MEDIA_BUS_FMT_Y10_1X10;
+	fd->entry[1].length = s5k2l4->mode->width | (s5k2l4->mode->height / 4) << 16;
+	fd->entry[1].bus.csi2.vc = 1;
+	fd->entry[1].bus.csi2.dt = 0x2b;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k2l4_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k2l4_pad_ops = {
+	.set_fmt = s5k2l4_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k2l4_get_selection,
+	.enum_mbus_code = s5k2l4_enum_mbus_code,
+	.enum_frame_size = s5k2l4_enum_frame_size,
+	.get_frame_desc = s5k2l4_get_frame_desc,
+	.enable_streams = s5k2l4_enable_streams,
+	.disable_streams = s5k2l4_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k2l4_subdev_ops = {
+	.video = &s5k2l4_video_ops,
+	.pad = &s5k2l4_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k2l4_internal_ops = {
+	.init_state = s5k2l4_init_state,
+};
+
+static const struct media_entity_operations s5k2l4_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k2l4_identify_sensor(struct s5k2l4 *s5k2l4)
+{
+	u64 val, rev = 0;
+	unsigned int try;
+	int ret;
+
+	for (try = 0; try < 8; try++) {
+		ret = cci_read(s5k2l4->regmap, S5K2L4_REG_CHIP_ID, &val, NULL);
+		if (!ret)
+			break;
+		msleep(25);
+	}
+	if (ret) {
+		dev_err(s5k2l4->dev, "failed to read chip id after %u attempts over 200 ms: %d\n",
+			try, ret);
+		return ret;
+	}
+	if (try)
+		dev_info(s5k2l4->dev, "chip id answered at attempt %u (%u ms after the first)\n",
+			 try + 1, try * 25);
+
+	cci_read(s5k2l4->regmap, S5K2L4_REG_REVISION, &rev, NULL);
+	dev_info(s5k2l4->dev, "chip id 0x%04llx, revision 0x%04llx\n", val, rev);
+
+	if (val == 0 || val == 0xffff) {
+		dev_err(s5k2l4->dev, "implausible chip id\n");
+		return -ENODEV;
+	}
+	if (S5K2L4_CHIP_ID && val != S5K2L4_CHIP_ID)
+		dev_warn(s5k2l4->dev, "expected chip id 0x%04x\n",
+			 S5K2L4_CHIP_ID);
+
+	return 0;
+}
+
+static int s5k2l4_check_hwcfg(struct s5k2l4 *s5k2l4)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k2l4->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K2L4_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K2L4_DATA_LANES) {
+		dev_err(s5k2l4->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k2l4->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k2l4_link_freq_menu,
+				       ARRAY_SIZE(s5k2l4_link_freq_menu),
+				       &freq_bitmap);
+	s5k2l4->link_freq_bitmap = freq_bitmap;
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * The MCLK pin is switched between its clock function and a parked state
+ * (input, pulled down) with the pin controller. Two sensors can share one
+ * MCLK pin (front and depth camera, rear wide and tele), and a pin belongs
+ * to one device at a time, so it is claimed at power-on and given back at
+ * power-off; the sensor that comes second gets -EBUSY. For this the DT
+ * states are called "mclk" and "mclk-off": a state named "default" is
+ * claimed by the driver core when the device is bound and never given back
+ * (older DTs have that, and then only one sensor of a pair can be bound).
+ */
+static struct pinctrl_state *s5k2l4_mclk_off_state(struct pinctrl *p)
+{
+	struct pinctrl_state *st = pinctrl_lookup_state(p, "mclk-off");
+
+	return IS_ERR(st) ? pinctrl_lookup_state(p, "default") : st;
+}
+
+/*
+ * Claim the pin, parked. Done first in the power sequence: if the sensor
+ * that shares the clock still has the pin (it keeps it for a second after
+ * its probe or last stream, runtime PM autosuspend), the wait must not sit
+ * between the reset release and the clock. A sensor that was let out of
+ * reset and only got its clock seconds later did not answer on I2C.
+ */
+static int s5k2l4_mclk_claim(struct s5k2l4 *s5k2l4)
+{
+	struct pinctrl_state *st;
+	unsigned int i;
+	int ret;
+
+	if (s5k2l4->pinctrl)
+		return 0;
+
+	s5k2l4->pinctrl = pinctrl_get(s5k2l4->dev);
+	if (IS_ERR(s5k2l4->pinctrl)) {
+		ret = PTR_ERR(s5k2l4->pinctrl);
+		s5k2l4->pinctrl = NULL;
+		return ret;
+	}
+	st = s5k2l4_mclk_off_state(s5k2l4->pinctrl);
+	ret = IS_ERR(st) ? PTR_ERR(st) :
+	      pinctrl_select_state(s5k2l4->pinctrl, st);
+	for (i = 0; ret && !IS_ERR(st) && i < 10; i++) {
+		msleep(250);
+		ret = pinctrl_select_state(s5k2l4->pinctrl, st);
+	}
+	if (ret) {
+		dev_err(s5k2l4->dev, "MCLK pin not available (%d): is the camera that shares this clock in use?\n",
+			ret);
+		pinctrl_put(s5k2l4->pinctrl);
+		s5k2l4->pinctrl = NULL;
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int s5k2l4_mclk_pin(struct s5k2l4 *s5k2l4, bool on)
+{
+	struct pinctrl_state *st;
+	int ret;
+
+	if (on) {
+		ret = s5k2l4_mclk_claim(s5k2l4);
+		if (ret)
+			return ret;
+		st = pinctrl_lookup_state(s5k2l4->pinctrl, "mclk");
+		return IS_ERR(st) ? PTR_ERR(st) :
+		       pinctrl_select_state(s5k2l4->pinctrl, st);
+	}
+
+	if (!s5k2l4->pinctrl)
+		return 0;
+	st = s5k2l4_mclk_off_state(s5k2l4->pinctrl);
+	if (!IS_ERR(st))
+		pinctrl_select_state(s5k2l4->pinctrl, st);
+	pinctrl_put(s5k2l4->pinctrl);
+	s5k2l4->pinctrl = NULL;
+
+	return 0;
+}
+
+/*
+ * Vendor sequence (fimc-is-device-module-2l4.c): reset low, then the S2MPB03
+ * camera supplies (retention 1.025 V, analog 2.8/2.4 V, core 1.0 V), the
+ * actuator common rail (S2MPB02 3.3 V), the camera I/O rail 1.8 V and the
+ * 1.1 V rail, MCLK pin to its clock function, clock on, reset high, ~3 ms.
+ * The OIS/aperture rails are left off. The clock gate is automatic, so MCLK
+ * is switched with the pin function. MCLK0 is shared with the rear tele
+ * camera: only one of the two may be powered at a time.
+ */
+static int s5k2l4_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+	unsigned int i;
+	int ret;
+
+	ret = s5k2l4_mclk_claim(s5k2l4);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(s5k2l4->reset_gpio, 1);
+
+	/*
+	 * One supply after the other, in the order of the list: the supplies
+	 * sit on three different PMIC buses and regulator_bulk_enable() would
+	 * switch them concurrently. The very first power-on (parallel)
+	 * froze the SoC without a trace; the step-by-step bring-up, which
+	 * is sequential, has always worked. Cause not established.
+	 */
+	for (i = 0; i < S5K2L4_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(s5k2l4->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "supply %s: %d\n", s5k2l4_supply_names[i], ret);
+			while (i--)
+				regulator_disable(s5k2l4->supplies[i].consumer);
+			s5k2l4_mclk_pin(s5k2l4, false);
+			return ret;
+		}
+		/* let each rail settle (the quick sequence got no I2C answer) */
+		usleep_range(3 * USEC_PER_MSEC, 4 * USEC_PER_MSEC);
+		if (s5k2l4->slow_ms)
+			msleep(s5k2l4->slow_ms);
+	}
+	usleep_range(10 * USEC_PER_MSEC, 11 * USEC_PER_MSEC);
+	if (s5k2l4->slow_ms)
+		msleep(s5k2l4->slow_ms);
+
+	ret = clk_prepare_enable(s5k2l4->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	ret = s5k2l4_mclk_pin(s5k2l4, true);
+	if (ret)
+		goto disable_clk;
+	/* clock running for a while before the reset is released */
+	usleep_range(5 * USEC_PER_MSEC, 6 * USEC_PER_MSEC);
+	if (s5k2l4->slow_ms)
+		msleep(s5k2l4->slow_ms);
+
+	gpiod_set_value_cansleep(s5k2l4->reset_gpio, 0);
+
+	/* the stacked sensor boots its own logic first */
+	usleep_range(30 * USEC_PER_MSEC, 32 * USEC_PER_MSEC);
+	if (s5k2l4->slow_ms)
+		msleep(s5k2l4->slow_ms);
+
+	return 0;
+
+disable_clk:
+	clk_disable_unprepare(s5k2l4->mclk);
+disable_regulators:
+	gpiod_set_value_cansleep(s5k2l4->reset_gpio, 1);
+	regulator_bulk_disable(S5K2L4_NUM_SUPPLIES, s5k2l4->supplies);
+	s5k2l4_mclk_pin(s5k2l4, false);
+
+	return ret;
+}
+
+static int s5k2l4_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+
+	gpiod_set_value_cansleep(s5k2l4->reset_gpio, 1);
+
+	s5k2l4_mclk_pin(s5k2l4, false);
+	clk_disable_unprepare(s5k2l4->mclk);
+
+	regulator_bulk_disable(S5K2L4_NUM_SUPPLIES, s5k2l4->supplies);
+
+	return 0;
+}
+
+static int s5k2l4_probe(struct i2c_client *client)
+{
+	struct s5k2l4 *s5k2l4;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k2l4 = devm_kzalloc(&client->dev, sizeof(*s5k2l4), GFP_KERNEL);
+	if (!s5k2l4)
+		return -ENOMEM;
+
+	s5k2l4->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k2l4->sd, client, &s5k2l4_subdev_ops);
+
+	s5k2l4->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k2l4->regmap))
+		return dev_err_probe(s5k2l4->dev, PTR_ERR(s5k2l4->regmap),
+				     "failed to init CCI\n");
+
+	s5k2l4->mclk = devm_v4l2_sensor_clk_get(s5k2l4->dev, NULL);
+	if (IS_ERR(s5k2l4->mclk))
+		return dev_err_probe(s5k2l4->dev, PTR_ERR(s5k2l4->mclk),
+				     "failed to get MCLK clock\n");
+
+	ret = clk_set_rate(s5k2l4->mclk, S5K2L4_MCLK_FREQ_26MHZ);
+	if (ret)
+		return dev_err_probe(s5k2l4->dev, ret, "failed to set MCLK\n");
+
+	freq = clk_get_rate(s5k2l4->mclk);
+	if (freq != S5K2L4_MCLK_FREQ_26MHZ)
+		return dev_err_probe(s5k2l4->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5k2l4_check_hwcfg(s5k2l4);
+	if (ret)
+		return dev_err_probe(s5k2l4->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k2l4->reset_gpio = devm_gpiod_get_optional(s5k2l4->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k2l4->reset_gpio))
+		return dev_err_probe(s5k2l4->dev, PTR_ERR(s5k2l4->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	/* the MCLK pin is claimed at power-on and parked at power-off */
+
+	for (i = 0; i < S5K2L4_NUM_SUPPLIES; i++)
+		s5k2l4->supplies[i].supply = s5k2l4_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k2l4->dev, S5K2L4_NUM_SUPPLIES,
+				      s5k2l4->supplies);
+	if (ret)
+		return dev_err_probe(s5k2l4->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5k2l4_power_on(s5k2l4->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k2l4_identify_sensor(s5k2l4);
+	if (ret && !s5k2l4->slow_ms) {
+		/*
+		 * The only sequence that is known to reach this sensor is the
+		 * staged bring-up with seconds between the steps. Try once
+		 * more with long pauses and keep them if that is what works.
+		 */
+		dev_warn(s5k2l4->dev, "no answer after the normal power-on, retrying with 200 ms pauses\n");
+		s5k2l4_power_off(s5k2l4->dev);
+		msleep(300);
+		s5k2l4->slow_ms = 200;
+		ret = s5k2l4_power_on(s5k2l4->dev);
+		if (ret)
+			return ret;
+		ret = s5k2l4_identify_sensor(s5k2l4);
+		if (!ret)
+			dev_warn(s5k2l4->dev, "answers only with the slow power-on: every power-on takes about 2 s longer\n");
+	}
+	if (ret) {
+		dev_err_probe(s5k2l4->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5k2l4->modes = s5k2l4_supported_modes;
+	s5k2l4->num_modes = ARRAY_SIZE(s5k2l4_supported_modes);
+	while (s5k2l4->num_modes > 1 &&
+	       !(s5k2l4->link_freq_bitmap & BIT(s5k2l4->modes[0].link_freq_index))) {
+		dev_info(s5k2l4->dev, "%ux%u not offered: the DT lists no %lld Hz link frequency\n",
+			 s5k2l4->modes[0].width, s5k2l4->modes[0].height,
+			 s5k2l4_link_freq_menu[s5k2l4->modes[0].link_freq_index]);
+		s5k2l4->modes++;
+		s5k2l4->num_modes--;
+	}
+	s5k2l4->mode = &s5k2l4_supported_modes[1];
+	if (s5k2l4->mode < s5k2l4->modes)
+		s5k2l4->mode = s5k2l4->modes;
+	ret = s5k2l4_init_controls(s5k2l4);
+	if (ret) {
+		dev_err_probe(s5k2l4->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k2l4->sd.state_lock = s5k2l4->ctrl_handler.lock;
+	s5k2l4->sd.internal_ops = &s5k2l4_internal_ops;
+	s5k2l4->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k2l4->sd.entity.ops = &s5k2l4_subdev_entity_ops;
+	s5k2l4->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k2l4->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k2l4->sd.entity, 1, &s5k2l4->pad);
+	if (ret) {
+		dev_err_probe(s5k2l4->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k2l4->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k2l4->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5k2l4->dev);
+	pm_runtime_enable(s5k2l4->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k2l4->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k2l4->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k2l4->dev, 1000);
+	pm_runtime_use_autosuspend(s5k2l4->dev);
+	pm_runtime_idle(s5k2l4->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k2l4->sd);
+	pm_runtime_disable(s5k2l4->dev);
+	pm_runtime_set_suspended(s5k2l4->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5k2l4->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5k2l4->sd.ctrl_handler);
+
+power_off:
+	s5k2l4_power_off(s5k2l4->dev);
+
+	return ret;
+}
+
+static void s5k2l4_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k2l4 *s5k2l4 = to_s5k2l4(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k2l4->dev);
+
+	if (!pm_runtime_status_suspended(s5k2l4->dev)) {
+		s5k2l4_power_off(s5k2l4->dev);
+		pm_runtime_set_suspended(s5k2l4->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k2l4_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k2l4_power_off, s5k2l4_power_on, NULL)
+};
+
+static const struct of_device_id s5k2l4_of_match[] = {
+	{ .compatible = "samsung,s5k2l4" },
+	{ /* sentinel */ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct i2c_driver s5k2l4_i2c_driver = {
+	.driver = {
+		.name = "s5k2l4",
+		.pm = &s5k2l4_pm_ops,
+		.of_match_table = s5k2l4_of_match,
+	},
+	.probe = s5k2l4_probe,
+	.remove = s5k2l4_remove,
+};
+
+module_i2c_driver(s5k2l4_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K2L4 image sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/s5k3j1.c b/drivers/media/i2c/s5k3j1.c
new file mode 100644
index 0000000000..0497786c50
--- /dev/null
+++ b/drivers/media/i2c/s5k3j1.c
@@ -0,0 +1,1920 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K3J1 10 MP dual-pixel image sensor (front camera of the Galaxy
+ * S10 family). 4-lane CSI-2 D-PHY at 1807 Mbit/s per lane, RAW10, 26 MHz
+ * external clock. The lens has a voice coil (AK737x) that is powered here
+ * but not driven: focus stays at its rest position.
+ *
+ * On the Galaxy S10+ the sensor shares the CSIS2 receiver with the rear
+ * telephoto camera through a MIPI switch; "camsel" selects this sensor.
+ *
+ * Based on the S5K3M5/S5K3P9 drivers, Copyright (c) 2025 Linaro Ltd, with
+ * register tables and the power sequence from the Samsung SM-G975F kernel.
+ * Not tested on hardware yet.
+ */
+
+#include <linux/pinctrl/consumer.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K3J1_LINK_FREQ_903P5MHZ		(903500ULL * HZ_PER_KHZ)
+#define S5K3J1_MCLK_FREQ_26MHZ		(26 * HZ_PER_MHZ)
+/* vendor pllinfo: 201.93 MHz * 4 (9384 x 2885 at 29.8 fps) */
+#define S5K3J1_PIXEL_RATE		807720000
+#define S5K3J1_DATA_LANES		4
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5K3J1_REG_CHIP_ID		CCI_REG16(0x0000)
+/* Unknown until read on hardware; the vendor driver does not check it */
+#define S5K3J1_CHIP_ID			0
+#define S5K3J1_REG_REVISION		CCI_REG16(0x0002)
+
+/* Both streaming and flipping settings are controlled at the same time */
+#define S5K3J1_REG_CTRL_MODE		CCI_REG16(0x0100)
+#define S5K3J1_MODE_STREAMING		BIT(8)
+#define S5K3J1_VFLIP			BIT(1)
+#define S5K3J1_HFLIP			BIT(0)
+
+#define S5K3J1_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K3J1_EXPOSURE_MIN		2
+#define S5K3J1_EXPOSURE_STEP		1
+#define S5K3J1_EXPOSURE_MARGIN		4
+
+/* Analogue gain code = gain * 32, 1x..16x (vendor driver: 0x20..0x200) */
+#define S5K3J1_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K3J1_AGAIN_MIN		0x20
+#define S5K3J1_AGAIN_MAX		0x200
+#define S5K3J1_AGAIN_STEP		1
+#define S5K3J1_AGAIN_DEFAULT		0x20
+
+#define S5K3J1_REG_VTS			CCI_REG16(0x0340)
+#define S5K3J1_VTS_MAX			0xffff
+
+#define S5K3J1_REG_HTS			CCI_REG16(0x0342)
+#define S5K3J1_REG_X_ADDR_START		CCI_REG16(0x0344)
+#define S5K3J1_REG_Y_ADDR_START		CCI_REG16(0x0346)
+#define S5K3J1_REG_X_ADDR_END		CCI_REG16(0x0348)
+#define S5K3J1_REG_Y_ADDR_END		CCI_REG16(0x034a)
+#define S5K3J1_REG_X_OUTPUT_SIZE	CCI_REG16(0x034c)
+#define S5K3J1_REG_Y_OUTPUT_SIZE	CCI_REG16(0x034e)
+
+#define S5K3J1_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5k3j1(_sd)			container_of(_sd, struct s5k3j1, sd)
+
+static const s64 s5k3j1_link_freq_menu[] = {
+	S5K3J1_LINK_FREQ_903P5MHZ,
+};
+
+/* List of supported formats to cover horizontal and vertical flip controls */
+static const u32 s5k3j1_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5k3j1_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct s5k3j1_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+
+	const struct s5k3j1_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const s5k3j1_test_pattern_menu[] = {
+	"Disabled",
+	"Solid colour",
+	"Colour bars",
+	"Fade to grey colour bars",
+	"PN9",
+};
+
+static const char * const s5k3j1_supply_names[] = {
+	/* Order of the vendor power sequence */
+	"vddbuck1",	/* PMIC buck 1 (always on in the vendor kernel) */
+	"vddbb",	/* PMIC buck-boost (always on in the vendor kernel) */
+	"vddext",	/* VDD_EXT_1P3_PB02 */
+	"vddaf",	/* VDDAF_2.8V_VT (lens actuator) */
+	"vdda",		/* VDDA_2.95V_VT */
+	"vddio",	/* VDDIO_1.8V_VT */
+	"vddd",		/* VDDD_1.05V_VT */
+};
+
+#define S5K3J1_NUM_SUPPLIES	ARRAY_SIZE(s5k3j1_supply_names)
+
+struct s5k3j1 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *camsel_gpio;
+	struct pinctrl *pinctrl;
+	struct regulator_bulk_data supplies[S5K3J1_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5k3j1_mode *mode;
+};
+
+/*
+ * Register tables from the Samsung SM-G975F kernel (fimc-is-cis-3j1-setA.h).
+ * The "nonPD" modes are used: no phase detection data on a second virtual
+ * channel. A 3 ms delay is needed after the software reset.
+ */
+static const struct cci_reg_sequence s5k3j1_global_reset[] = {
+	{ CCI_REG16(0x0100), 0x0000 },
+	{ CCI_REG16(0x6010), 0x0001 },
