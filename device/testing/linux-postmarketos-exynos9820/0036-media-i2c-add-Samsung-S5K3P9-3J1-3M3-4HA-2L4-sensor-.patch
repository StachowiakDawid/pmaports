+static int s5k3p9_identify_sensor(struct s5k3p9 *s5k3p9)
+{
+	u64 val, rev = 0;
+	int ret;
+
+	ret = cci_read(s5k3p9->regmap, S5K3P9_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5k3p9->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	cci_read(s5k3p9->regmap, S5K3P9_REG_REVISION, &rev, NULL);
+	dev_info(s5k3p9->dev, "chip id 0x%04llx, revision 0x%04llx\n", val, rev);
+
+	if (val == 0 || val == 0xffff) {
+		dev_err(s5k3p9->dev, "implausible chip id\n");
+		return -ENODEV;
+	}
+	if (val != S5K3P9_CHIP_ID)
+		dev_warn(s5k3p9->dev, "expected chip id 0x%04x\n",
+			 S5K3P9_CHIP_ID);
+
+	return 0;
+}
+
+static int s5k3p9_check_hwcfg(struct s5k3p9 *s5k3p9)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3p9->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K3P9_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3P9_DATA_LANES) {
+		dev_err(s5k3p9->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3p9->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k3p9_link_freq_menu,
+				       ARRAY_SIZE(s5k3p9_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * The MCLK pin is switched between its clock function and a parked state
+ * (input, pulled down) with the pin controller. Two sensors can share one
+ * MCLK pin (front and depth camera, rear wide and tele), and a pin belongs
+ * to one device at a time, so it is claimed at power-on and given back at
+ * power-off; the sensor that comes second gets -EBUSY. For this the DT
+ * states are called "mclk" and "mclk-off": a state named "default" is
+ * claimed by the driver core when the device is bound and never given back
+ * (older DTs have that, and then only one sensor of a pair can be bound).
+ */
+static struct pinctrl_state *s5k3p9_mclk_off_state(struct pinctrl *p)
+{
+	struct pinctrl_state *st = pinctrl_lookup_state(p, "mclk-off");
+
+	return IS_ERR(st) ? pinctrl_lookup_state(p, "default") : st;
+}
+
+/*
+ * Claim the pin, parked. Done first in the power sequence: if the sensor
+ * that shares the clock still has the pin (it keeps it for a second after
+ * its probe or last stream, runtime PM autosuspend), the wait must not sit
+ * between the reset release and the clock. A sensor that was let out of
+ * reset and only got its clock seconds later did not answer on I2C.
+ */
+static int s5k3p9_mclk_claim(struct s5k3p9 *s5k3p9)
+{
+	struct pinctrl_state *st;
+	unsigned int i;
+	int ret;
+
+	if (s5k3p9->pinctrl)
+		return 0;
+
+	s5k3p9->pinctrl = pinctrl_get(s5k3p9->dev);
+	if (IS_ERR(s5k3p9->pinctrl)) {
+		ret = PTR_ERR(s5k3p9->pinctrl);
+		s5k3p9->pinctrl = NULL;
+		return ret;
+	}
+	st = s5k3p9_mclk_off_state(s5k3p9->pinctrl);
+	ret = IS_ERR(st) ? PTR_ERR(st) :
+	      pinctrl_select_state(s5k3p9->pinctrl, st);
+	for (i = 0; ret && !IS_ERR(st) && i < 10; i++) {
+		msleep(250);
+		ret = pinctrl_select_state(s5k3p9->pinctrl, st);
+	}
+	if (ret) {
+		dev_err(s5k3p9->dev, "MCLK pin not available (%d): is the camera that shares this clock in use?\n",
+			ret);
+		pinctrl_put(s5k3p9->pinctrl);
+		s5k3p9->pinctrl = NULL;
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int s5k3p9_mclk_pin(struct s5k3p9 *s5k3p9, bool on)
+{
+	struct pinctrl_state *st;
+	int ret;
+
+	if (on) {
+		ret = s5k3p9_mclk_claim(s5k3p9);
+		if (ret)
+			return ret;
+		st = pinctrl_lookup_state(s5k3p9->pinctrl, "mclk");
+		return IS_ERR(st) ? PTR_ERR(st) :
+		       pinctrl_select_state(s5k3p9->pinctrl, st);
+	}
+
+	if (!s5k3p9->pinctrl)
+		return 0;
+	st = s5k3p9_mclk_off_state(s5k3p9->pinctrl);
+	if (!IS_ERR(st))
+		pinctrl_select_state(s5k3p9->pinctrl, st);
+	pinctrl_put(s5k3p9->pinctrl);
+	s5k3p9->pinctrl = NULL;
+
+	return 0;
+}
+
+/*
+ * Vendor sequence (fimc-is-device-module-3p9.c): buck 2, reset low, analog,
+ * core and I/O supplies, reset high, MCLK pin to its clock function, clock
+ * on, 1.1 ms. The clock gate itself is automatic, so MCLK is switched with
+ * the pin function.
+ */
+static int s5k3p9_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+	int ret;
+
+	ret = s5k3p9_mclk_claim(s5k3p9);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(S5K3P9_NUM_SUPPLIES, s5k3p9->supplies);
+	if (ret) {
+		s5k3p9_mclk_pin(s5k3p9, false);
+		return ret;
+	}
+	usleep_range(1 * USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 0);
+
+	ret = clk_prepare_enable(s5k3p9->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	ret = s5k3p9_mclk_pin(s5k3p9, true);
+	if (ret)
+		goto disable_clk;
+
+	usleep_range(5 * USEC_PER_MSEC, 6 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_clk:
+	clk_disable_unprepare(s5k3p9->mclk);
+disable_regulators:
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 1);
+	regulator_bulk_disable(S5K3P9_NUM_SUPPLIES, s5k3p9->supplies);
+	s5k3p9_mclk_pin(s5k3p9, false);
+
+	return ret;
+}
+
+static int s5k3p9_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+
+	gpiod_set_value_cansleep(s5k3p9->reset_gpio, 1);
+
+	s5k3p9_mclk_pin(s5k3p9, false);
+	clk_disable_unprepare(s5k3p9->mclk);
+
+	regulator_bulk_disable(S5K3P9_NUM_SUPPLIES, s5k3p9->supplies);
+
+	return 0;
+}
+
+static int s5k3p9_probe(struct i2c_client *client)
+{
+	struct s5k3p9 *s5k3p9;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k3p9 = devm_kzalloc(&client->dev, sizeof(*s5k3p9), GFP_KERNEL);
+	if (!s5k3p9)
+		return -ENOMEM;
+
+	s5k3p9->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k3p9->sd, client, &s5k3p9_subdev_ops);
+
+	s5k3p9->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3p9->regmap))
+		return dev_err_probe(s5k3p9->dev, PTR_ERR(s5k3p9->regmap),
+				     "failed to init CCI\n");
+
+	s5k3p9->mclk = devm_v4l2_sensor_clk_get(s5k3p9->dev, NULL);
+	if (IS_ERR(s5k3p9->mclk))
+		return dev_err_probe(s5k3p9->dev, PTR_ERR(s5k3p9->mclk),
+				     "failed to get MCLK clock\n");
+
+	ret = clk_set_rate(s5k3p9->mclk, S5K3P9_MCLK_FREQ_26MHZ);
+	if (ret)
+		return dev_err_probe(s5k3p9->dev, ret, "failed to set MCLK\n");
+
+	freq = clk_get_rate(s5k3p9->mclk);
+	if (freq != S5K3P9_MCLK_FREQ_26MHZ)
+		return dev_err_probe(s5k3p9->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5k3p9_check_hwcfg(s5k3p9);
+	if (ret)
+		return dev_err_probe(s5k3p9->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k3p9->reset_gpio = devm_gpiod_get_optional(s5k3p9->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3p9->reset_gpio))
+		return dev_err_probe(s5k3p9->dev, PTR_ERR(s5k3p9->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	/* the MCLK pin is claimed at power-on and parked at power-off */
+
+	for (i = 0; i < S5K3P9_NUM_SUPPLIES; i++)
+		s5k3p9->supplies[i].supply = s5k3p9_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3p9->dev, S5K3P9_NUM_SUPPLIES,
+				      s5k3p9->supplies);
+	if (ret)
+		return dev_err_probe(s5k3p9->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5k3p9_power_on(s5k3p9->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k3p9_identify_sensor(s5k3p9);
+	if (ret) {
+		dev_err_probe(s5k3p9->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5k3p9->mode = &s5k3p9_supported_modes[0];
+	ret = s5k3p9_init_controls(s5k3p9);
+	if (ret) {
+		dev_err_probe(s5k3p9->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k3p9->sd.state_lock = s5k3p9->ctrl_handler.lock;
+	s5k3p9->sd.internal_ops = &s5k3p9_internal_ops;
+	s5k3p9->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3p9->sd.entity.ops = &s5k3p9_subdev_entity_ops;
+	s5k3p9->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3p9->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3p9->sd.entity, 1, &s5k3p9->pad);
+	if (ret) {
+		dev_err_probe(s5k3p9->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k3p9->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3p9->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5k3p9->dev);
+	pm_runtime_enable(s5k3p9->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3p9->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3p9->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k3p9->dev, 1000);
+	pm_runtime_use_autosuspend(s5k3p9->dev);
+	pm_runtime_idle(s5k3p9->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3p9->sd);
+	pm_runtime_disable(s5k3p9->dev);
+	pm_runtime_set_suspended(s5k3p9->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5k3p9->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5k3p9->sd.ctrl_handler);
+
+power_off:
+	s5k3p9_power_off(s5k3p9->dev);
+
+	return ret;
+}
+
+static void s5k3p9_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3p9 *s5k3p9 = to_s5k3p9(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k3p9->dev);
+
+	if (!pm_runtime_status_suspended(s5k3p9->dev)) {
+		s5k3p9_power_off(s5k3p9->dev);
+		pm_runtime_set_suspended(s5k3p9->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k3p9_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k3p9_power_off, s5k3p9_power_on, NULL)
+};
+
+static const struct of_device_id s5k3p9_of_match[] = {
+	{ .compatible = "samsung,s5k3p9" },
+	{ /* sentinel */ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct i2c_driver s5k3p9_i2c_driver = {
+	.driver = {
+		.name = "s5k3p9",
+		.pm = &s5k3p9_pm_ops,
+		.of_match_table = s5k3p9_of_match,
+	},
+	.probe = s5k3p9_probe,
+	.remove = s5k3p9_remove,
+};
+
+module_i2c_driver(s5k3p9_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K3P9 image sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/s5k4ha.c b/drivers/media/i2c/s5k4ha.c
