+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K3M3 12 MP image sensor (rear telephoto camera of the Galaxy
+ * S10 family). 4-lane CSI-2 D-PHY at 1196 Mbit/s per lane, RAW10, 26 MHz
+ * external clock. The lens has a voice coil (AK7374, a separate device) and
+ * optical image stabilisation driven by a microcontroller that is not
+ * powered here: the lens is not stabilised.
+ *
+ * On the Galaxy S10+ the sensor shares the CSIS2 receiver with the front
+ * camera through a MIPI switch that the receiver driver sets.
+ *
+ * Based on the S5K3M5/S5K3P9 drivers, Copyright (c) 2025 Linaro Ltd, with
+ * register tables and the power sequence from the Samsung SM-G975F kernel.
+ * Generated from s5k3j1.c by a script.
+ */
+
+#include <linux/pinctrl/consumer.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/bitops.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K3M3_LINK_FREQ		(598000ULL * HZ_PER_KHZ)
+#define S5K3M3_MCLK_FREQ_26MHZ		(26 * HZ_PER_MHZ)
+/* vendor pllinfo */
+#define S5K3M3_PIXEL_RATE		481000000
+#define S5K3M3_DATA_LANES		4
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5K3M3_REG_CHIP_ID		CCI_REG16(0x0000)
+/* Unknown until read on hardware; the vendor driver does not check it */
+#define S5K3M3_CHIP_ID			0
+#define S5K3M3_REG_REVISION		CCI_REG16(0x0002)
+
+/* Both streaming and flipping settings are controlled at the same time */
+#define S5K3M3_REG_CTRL_MODE		CCI_REG16(0x0100)
+#define S5K3M3_MODE_STREAMING		BIT(8)
+#define S5K3M3_VFLIP			BIT(1)
+#define S5K3M3_HFLIP			BIT(0)
+
+#define S5K3M3_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K3M3_EXPOSURE_MIN		7
+#define S5K3M3_EXPOSURE_STEP		1
+#define S5K3M3_EXPOSURE_MARGIN		28
+
+/* Analogue gain code = gain * 32, 1x..16x (vendor driver: 0x20..0x200) */
+#define S5K3M3_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K3M3_AGAIN_MIN		0x20
+#define S5K3M3_AGAIN_MAX		0x200
+#define S5K3M3_AGAIN_STEP		1
+#define S5K3M3_AGAIN_DEFAULT		0x20
+
+#define S5K3M3_REG_VTS			CCI_REG16(0x0340)
+#define S5K3M3_VTS_MAX			0xffff
+
+#define S5K3M3_REG_HTS			CCI_REG16(0x0342)
+#define S5K3M3_REG_X_ADDR_START		CCI_REG16(0x0344)
+#define S5K3M3_REG_Y_ADDR_START		CCI_REG16(0x0346)
+#define S5K3M3_REG_X_ADDR_END		CCI_REG16(0x0348)
+#define S5K3M3_REG_Y_ADDR_END		CCI_REG16(0x034a)
+#define S5K3M3_REG_X_OUTPUT_SIZE	CCI_REG16(0x034c)
+#define S5K3M3_REG_Y_OUTPUT_SIZE	CCI_REG16(0x034e)
+
+#define S5K3M3_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5k3m3(_sd)			container_of(_sd, struct s5k3m3, sd)
+
+static const s64 s5k3m3_link_freq_menu[] = {
+	S5K3M3_LINK_FREQ,
+};
+
+/* List of supported formats to cover horizontal and vertical flip controls */
+static const u32 s5k3m3_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5k3m3_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct s5k3m3_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
