+static int s5k4ha_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+	const struct s5k4ha_reg_list *reg_list = &s5k4ha->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k4ha->dev);
+	if (ret)
+		return ret;
+
+	ret = 0;
+	cci_multi_reg_write(s5k4ha->regmap, s5k4ha_global_setting,
+			    ARRAY_SIZE(s5k4ha_global_setting), &ret);
+	cci_multi_reg_write(s5k4ha->regmap, s5k4ha_sync_stop,
+			    ARRAY_SIZE(s5k4ha_sync_stop), &ret);
+	if (ret)
+		goto error;
+	msleep(50);	/* one frame */
+	cci_multi_reg_write(s5k4ha->regmap, s5k4ha_sync_master,
+			    ARRAY_SIZE(s5k4ha_sync_master), &ret);
+	cci_multi_reg_write(s5k4ha->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k4ha->sd.ctrl_handler);
+
+	cci_write(s5k4ha->regmap, S5K4HA_REG_CTRL_MODE,
+		  S5K4HA_MODE_STREAMING |
+		  (s5k4ha->vflip->val ? S5K4HA_VFLIP : 0) |
+		  (s5k4ha->hflip->val ? S5K4HA_HFLIP : 0), &ret);
+	if (ret)
+		goto error;
+
+	s5k4ha->ctrl_sent = s5k4ha->ctrl_failed = s5k4ha->ctrl_skipped = 0;
+
+	{
+		u64 f0 = 0, f1 = 0;
+
+		/*
+		 * Frame counter (0xff while idle): if it runs, the sensor
+		 * streams and a silent receiver is a PHY/lane problem.
+		 */
+		msleep(70);
+		cci_read(s5k4ha->regmap, CCI_REG8(0x0005), &f0, NULL);
+		msleep(70);
+		cci_read(s5k4ha->regmap, CCI_REG8(0x0005), &f1, NULL);
+		dev_info(s5k4ha->dev, "stream on: frame counter 0x%02llx -> 0x%02llx (%s)\n",
+			 f0, f1, f0 != f1 ? "sensor is streaming" :
+			 "NOT counting");
+		f0 = f1 = 0;
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0202), &f0, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0204), &f1, NULL);
+		dev_info(s5k4ha->dev, "stream on: exposure %llu lines, analogue gain code %llu (32 = 1x)\n",
+			 f0, f1);
+		f0 = f1 = 0;
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0340), &f0, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG16(0x020e), &f1, NULL);
+		dev_info(s5k4ha->dev, "stream on: frame length %llu lines, digital gain 0x%04llx (0x100 = 1x)\n",
+			 f0, f1);
+		f0 = f1 = 0;
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0084), &f0, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0086), &f1, NULL);
+		dev_info(s5k4ha->dev, "stream on: analogue gain range of the sensor %llu..%llu\n",
+			 f0, f1);
+	}
+
+	return 0;
+
+error:
+	dev_err(s5k4ha->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k4ha->dev);
+
+	return ret;
+}
+
+static int s5k4ha_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+	int ret;
+
+	{
+		u64 e = 0, g = 0, fll = 0, hold = 0, fc = 0;
+
+		/* what the sensor ended up with, before it is stopped */
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0202), &e, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0204), &g, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG16(0x0340), &fll, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG8(0x0104), &hold, NULL);
+		cci_read(s5k4ha->regmap, CCI_REG8(0x0005), &fc, NULL);
+		dev_info(s5k4ha->dev, "stream off: exposure %llu lines, analogue gain code %llu, frame length %llu, hold %llu, frame counter 0x%02llx\n",
+			 e, g, fll, hold, fc);
+		dev_info(s5k4ha->dev, "stream off: control writes while streaming: %u sent, %u failed, %u skipped\n",
+			 s5k4ha->ctrl_sent, s5k4ha->ctrl_failed,
+			 s5k4ha->ctrl_skipped);
+	}
+
+	ret = cci_write(s5k4ha->regmap, S5K4HA_REG_CTRL_MODE, 0, NULL);
+	if (ret)
+		dev_err(s5k4ha->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5k4ha->dev);
+
+	return ret;
+}
+
+static u32 s5k4ha_get_format_code(struct s5k4ha *s5k4ha)
+{
+	unsigned int i;
+
+	i = (s5k4ha->vflip->val ? 2 : 0) | (s5k4ha->hflip->val ? 1 : 0);
+
+	return s5k4ha_mbus_formats[i];
+}
+
+static void s5k4ha_update_pad_format(struct s5k4ha *s5k4ha,
+				     const struct s5k4ha_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k4ha_get_format_code(s5k4ha);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k4ha_set_pad_format(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5k4ha_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5k4ha_supported_modes,
+				      ARRAY_SIZE(s5k4ha_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5k4ha_update_pad_format(s5k4ha, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k4ha->mode == mode)
+		goto set_format;
+
+	/* Update limits and set FPS and exposure to default values */
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5k4ha->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5k4ha->vblank, vblank,
+				 S5K4HA_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5k4ha->vblank, vblank);
+
+	exposure_max = mode->vts - S5K4HA_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5k4ha->exposure, S5K4HA_EXPOSURE_MIN,
+				 exposure_max, S5K4HA_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5k4ha->exposure, mode->exposure);
+
+	if (s5k4ha->sd.ctrl_handler->error)
+		return s5k4ha->sd.ctrl_handler->error;
+
+	s5k4ha->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k4ha_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k4ha_get_format_code(s5k4ha);
+
+	return 0;
+}
+
+static int s5k4ha_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k4ha_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k4ha_get_format_code(s5k4ha))
+		return -EINVAL;
+
+	fse->min_width = s5k4ha_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k4ha_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+/*
+ * The pixel array is the size of the largest (first) mode. The 2x2 binned
+ * modes read the whole array; any other mode is a centred window.
+ */
+static int s5k4ha_get_selection(struct v4l2_subdev *sd,
+				const struct v4l2_subdev_client_info *ci,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+	const struct s5k4ha_mode *full = &s5k4ha_supported_modes[0];
+	const struct s5k4ha_mode *mode = s5k4ha->mode;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+			const struct v4l2_mbus_framefmt *fmt =
+				v4l2_subdev_state_get_format(sd_state, 0);
+
+			mode = v4l2_find_nearest_size(s5k4ha_supported_modes,
+					ARRAY_SIZE(s5k4ha_supported_modes),
+					width, height, fmt->width, fmt->height);
+		}
+		if (mode->width * 2 == full->width &&
+		    mode->height * 2 == full->height)
+			mode = full;
+		sel->r.left = (full->width - mode->width) / 2;
+		sel->r.top = (full->height - mode->height) / 2;
+		sel->r.width = mode->width;
+		sel->r.height = mode->height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = full->width;
+		sel->r.height = full->height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k4ha_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5k4ha->mode->width,
+			.height = s5k4ha->mode->height,
+		},
+	};
+
+	s5k4ha_set_pad_format(sd, NULL, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k4ha_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k4ha_pad_ops = {
+	.set_fmt = s5k4ha_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k4ha_get_selection,
+	.enum_mbus_code = s5k4ha_enum_mbus_code,
+	.enum_frame_size = s5k4ha_enum_frame_size,
+	.enable_streams = s5k4ha_enable_streams,
+	.disable_streams = s5k4ha_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k4ha_subdev_ops = {
+	.video = &s5k4ha_video_ops,
+	.pad = &s5k4ha_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k4ha_internal_ops = {
+	.init_state = s5k4ha_init_state,
+};
+
+static const struct media_entity_operations s5k4ha_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k4ha_identify_sensor(struct s5k4ha *s5k4ha)
+{
+	u64 val, rev = 0;
+	int ret;
+
+	ret = cci_read(s5k4ha->regmap, S5K4HA_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5k4ha->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	cci_read(s5k4ha->regmap, S5K4HA_REG_REVISION, &rev, NULL);
+	dev_info(s5k4ha->dev, "chip id 0x%04llx, revision 0x%04llx\n", val, rev);
+
+	if (val == 0 || val == 0xffff) {
+		dev_err(s5k4ha->dev, "implausible chip id\n");
+		return -ENODEV;
+	}
+	if (S5K4HA_CHIP_ID && val != S5K4HA_CHIP_ID)
+		dev_warn(s5k4ha->dev, "expected chip id 0x%04x\n",
+			 S5K4HA_CHIP_ID);
+
+	return 0;
+}
+
+static int s5k4ha_check_hwcfg(struct s5k4ha *s5k4ha)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k4ha->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K4HA_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K4HA_DATA_LANES) {
+		dev_err(s5k4ha->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k4ha->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k4ha_link_freq_menu,
+				       ARRAY_SIZE(s5k4ha_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * The MCLK pin is switched between its clock function and a parked state
+ * (input, pulled down) with the pin controller. Two sensors can share one
+ * MCLK pin (front and depth camera, rear wide and tele), and a pin belongs
+ * to one device at a time, so it is claimed at power-on and given back at
+ * power-off; the sensor that comes second gets -EBUSY. For this the DT
+ * states are called "mclk" and "mclk-off": a state named "default" is
+ * claimed by the driver core when the device is bound and never given back
+ * (older DTs have that, and then only one sensor of a pair can be bound).
+ */
+static struct pinctrl_state *s5k4ha_mclk_off_state(struct pinctrl *p)
+{
+	struct pinctrl_state *st = pinctrl_lookup_state(p, "mclk-off");
+
+	return IS_ERR(st) ? pinctrl_lookup_state(p, "default") : st;
+}
+
+/*
+ * Claim the pin, parked. Done first in the power sequence: if the sensor
+ * that shares the clock still has the pin (it keeps it for a second after
+ * its probe or last stream, runtime PM autosuspend), the wait must not sit
+ * between the reset release and the clock. A sensor that was let out of
+ * reset and only got its clock seconds later did not answer on I2C.
+ */
+static int s5k4ha_mclk_claim(struct s5k4ha *s5k4ha)
+{
+	struct pinctrl_state *st;
+	unsigned int i;
+	int ret;
+
+	if (s5k4ha->pinctrl)
+		return 0;
+
+	s5k4ha->pinctrl = pinctrl_get(s5k4ha->dev);
+	if (IS_ERR(s5k4ha->pinctrl)) {
+		ret = PTR_ERR(s5k4ha->pinctrl);
+		s5k4ha->pinctrl = NULL;
+		return ret;
+	}
+	st = s5k4ha_mclk_off_state(s5k4ha->pinctrl);
+	ret = IS_ERR(st) ? PTR_ERR(st) :
+	      pinctrl_select_state(s5k4ha->pinctrl, st);
+	for (i = 0; ret && !IS_ERR(st) && i < 10; i++) {
+		msleep(250);
+		ret = pinctrl_select_state(s5k4ha->pinctrl, st);
+	}
+	if (ret) {
+		dev_err(s5k4ha->dev, "MCLK pin not available (%d): is the camera that shares this clock in use?\n",
+			ret);
+		pinctrl_put(s5k4ha->pinctrl);
+		s5k4ha->pinctrl = NULL;
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int s5k4ha_mclk_pin(struct s5k4ha *s5k4ha, bool on)
+{
+	struct pinctrl_state *st;
+	int ret;
+
+	if (on) {
+		ret = s5k4ha_mclk_claim(s5k4ha);
+		if (ret)
+			return ret;
+		st = pinctrl_lookup_state(s5k4ha->pinctrl, "mclk");
+		return IS_ERR(st) ? PTR_ERR(st) :
+		       pinctrl_select_state(s5k4ha->pinctrl, st);
+	}
+
+	if (!s5k4ha->pinctrl)
+		return 0;
+	st = s5k4ha_mclk_off_state(s5k4ha->pinctrl);
+	if (!IS_ERR(st))
+		pinctrl_select_state(s5k4ha->pinctrl, st);
+	pinctrl_put(s5k4ha->pinctrl);
+	s5k4ha->pinctrl = NULL;
+
+	return 0;
+}
+
+/*
+ * Vendor sequence (fimc-is-device-module-4ha.c): reset low, analog, core
+ * and I/O supplies (2 ms), MCLK pin to its clock function, clock on (1 ms),
+ * reset high, 2 ms. The clock gate itself is automatic, so MCLK is switched
+ * with the pin function.
+ */
+static int s5k4ha_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+	int ret;
+
+	ret = s5k4ha_mclk_claim(s5k4ha);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(s5k4ha->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(S5K4HA_NUM_SUPPLIES, s5k4ha->supplies);
+	if (ret) {
+		s5k4ha_mclk_pin(s5k4ha, false);
+		return ret;
+	}
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(s5k4ha->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	ret = s5k4ha_mclk_pin(s5k4ha, true);
+	if (ret)
+		goto disable_clk;
+	usleep_range(1 * USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+
+	gpiod_set_value_cansleep(s5k4ha->reset_gpio, 0);
+
+	usleep_range(3 * USEC_PER_MSEC, 4 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_clk:
+	clk_disable_unprepare(s5k4ha->mclk);
+disable_regulators:
+	gpiod_set_value_cansleep(s5k4ha->reset_gpio, 1);
+	regulator_bulk_disable(S5K4HA_NUM_SUPPLIES, s5k4ha->supplies);
+	s5k4ha_mclk_pin(s5k4ha, false);
+
+	return ret;
+}
+
+static int s5k4ha_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+
+	gpiod_set_value_cansleep(s5k4ha->reset_gpio, 1);
+
+	s5k4ha_mclk_pin(s5k4ha, false);
+	clk_disable_unprepare(s5k4ha->mclk);
+
+	regulator_bulk_disable(S5K4HA_NUM_SUPPLIES, s5k4ha->supplies);
+
+	return 0;
+}
+
+static int s5k4ha_probe(struct i2c_client *client)
+{
+	struct s5k4ha *s5k4ha;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k4ha = devm_kzalloc(&client->dev, sizeof(*s5k4ha), GFP_KERNEL);
+	if (!s5k4ha)
+		return -ENOMEM;
+
+	s5k4ha->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k4ha->sd, client, &s5k4ha_subdev_ops);
+
+	s5k4ha->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k4ha->regmap))
+		return dev_err_probe(s5k4ha->dev, PTR_ERR(s5k4ha->regmap),
+				     "failed to init CCI\n");
+
+	s5k4ha->mclk = devm_v4l2_sensor_clk_get(s5k4ha->dev, NULL);
+	if (IS_ERR(s5k4ha->mclk))
+		return dev_err_probe(s5k4ha->dev, PTR_ERR(s5k4ha->mclk),
+				     "failed to get MCLK clock\n");
+
+	ret = clk_set_rate(s5k4ha->mclk, S5K4HA_MCLK_FREQ_26MHZ);
+	if (ret)
+		return dev_err_probe(s5k4ha->dev, ret, "failed to set MCLK\n");
+
+	freq = clk_get_rate(s5k4ha->mclk);
+	if (freq != S5K4HA_MCLK_FREQ_26MHZ)
+		return dev_err_probe(s5k4ha->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5k4ha_check_hwcfg(s5k4ha);
+	if (ret)
+		return dev_err_probe(s5k4ha->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k4ha->reset_gpio = devm_gpiod_get_optional(s5k4ha->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k4ha->reset_gpio))
+		return dev_err_probe(s5k4ha->dev, PTR_ERR(s5k4ha->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	/* the MCLK pin is claimed at power-on and parked at power-off */
+
+	for (i = 0; i < S5K4HA_NUM_SUPPLIES; i++)
+		s5k4ha->supplies[i].supply = s5k4ha_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k4ha->dev, S5K4HA_NUM_SUPPLIES,
+				      s5k4ha->supplies);
+	if (ret)
+		return dev_err_probe(s5k4ha->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5k4ha_power_on(s5k4ha->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k4ha_identify_sensor(s5k4ha);
+	if (ret) {
+		dev_err_probe(s5k4ha->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5k4ha->mode = &s5k4ha_supported_modes[0];
+	ret = s5k4ha_init_controls(s5k4ha);
+	if (ret) {
+		dev_err_probe(s5k4ha->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k4ha->sd.state_lock = s5k4ha->ctrl_handler.lock;
+	s5k4ha->sd.internal_ops = &s5k4ha_internal_ops;
+	s5k4ha->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k4ha->sd.entity.ops = &s5k4ha_subdev_entity_ops;
+	s5k4ha->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k4ha->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k4ha->sd.entity, 1, &s5k4ha->pad);
+	if (ret) {
+		dev_err_probe(s5k4ha->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k4ha->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k4ha->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5k4ha->dev);
+	pm_runtime_enable(s5k4ha->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k4ha->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k4ha->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k4ha->dev, 1000);
+	pm_runtime_use_autosuspend(s5k4ha->dev);
+	pm_runtime_idle(s5k4ha->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k4ha->sd);
+	pm_runtime_disable(s5k4ha->dev);
+	pm_runtime_set_suspended(s5k4ha->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5k4ha->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5k4ha->sd.ctrl_handler);
+
+power_off:
+	s5k4ha_power_off(s5k4ha->dev);
+
+	return ret;
+}
+
+static void s5k4ha_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4ha *s5k4ha = to_s5k4ha(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k4ha->dev);
+
+	if (!pm_runtime_status_suspended(s5k4ha->dev)) {
+		s5k4ha_power_off(s5k4ha->dev);
+		pm_runtime_set_suspended(s5k4ha->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k4ha_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k4ha_power_off, s5k4ha_power_on, NULL)
+};
+
+static const struct of_device_id s5k4ha_of_match[] = {
+	{ .compatible = "samsung,s5k4ha" },
+	{ /* sentinel */ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct i2c_driver s5k4ha_i2c_driver = {
+	.driver = {
+		.name = "s5k4ha",
+		.pm = &s5k4ha_pm_ops,
+		.of_match_table = s5k4ha_of_match,
+	},
+	.probe = s5k4ha_probe,
+	.remove = s5k4ha_remove,
+};
+
+module_i2c_driver(s5k4ha_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4HA image sensor driver");
+MODULE_LICENSE("GPL");
