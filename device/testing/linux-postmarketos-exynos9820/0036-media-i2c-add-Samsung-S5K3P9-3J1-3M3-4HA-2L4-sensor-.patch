+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+
+	const struct s5k3m3_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const s5k3m3_test_pattern_menu[] = {
+	"Disabled",
