+static int exynos9820_dp_mux_set(struct typec_mux_dev *mux,
+				 struct typec_mux_state *state)
+{
+	struct exynos5_usbdrd_phy *phy_drd = typec_mux_get_drvdata(mux);
+	unsigned int lanes = 0;
+
+	if (state->alt && state->alt->svid == USB_TYPEC_DP_SID) {
+		switch (state->mode) {
+		case TYPEC_DP_STATE_C:
+		case TYPEC_DP_STATE_E:
+			lanes = 4;
+			break;
+		case TYPEC_DP_STATE_D:
+			lanes = 2;
+			break;
+		default:
+			break;
+		}
+	}
+
+	guard(mutex)(&phy_drd->phy_mutex);
+	if (lanes != phy_drd->dp_max_lanes)
+		dev_info(phy_drd->dev, "DP alt mode: %u lanes\n", lanes);
+	phy_drd->dp_max_lanes = lanes;
+	phy_set_bus_width(phy_drd->dp_phy, lanes);
+	/*
+	 * A running USB3 pipe is stopped by the DP PHY power on, not here:
+	 * the mux is also set for USB/safe states without DP. The DWC3 speed
+	 * drop of downstream exynos_usbdrd_inform_dp_use() is not done (the SS
+	 * port just loses its link).
+	 */
+	return 0;
+}
+
+static void exynos9820_dp_mux_unregister(void *data)
+{
+	typec_mux_unregister(data);
+}
+
+static int exynos9820_dp_setup(struct exynos5_usbdrd_phy *phy_drd)
+{
+	struct device *dev = phy_drd->dev;
+	struct typec_mux_desc mux_desc = { };
+	int ret;
+
+	if (!phy_drd->reg_pma)
+		return 0;	/* DT without the combo PHY registers */
+
+	phy_drd->dp_phy = devm_phy_create(dev, NULL, &exynos9820_dp_phy_ops);
+	if (IS_ERR(phy_drd->dp_phy))
+		return dev_err_probe(dev, PTR_ERR(phy_drd->dp_phy),
+				     "failed to create DP phy\n");
+	phy_set_drvdata(phy_drd->dp_phy, phy_drd);
+
+	if (!IS_ENABLED(CONFIG_TYPEC) ||
+	    !device_property_present(dev, "mode-switch"))
+		return 0;
+
+	mux_desc.drvdata = phy_drd;
+	mux_desc.fwnode = dev_fwnode(dev);
+	mux_desc.set = exynos9820_dp_mux_set;
+	phy_drd->mux = typec_mux_register(dev, &mux_desc);
+	if (IS_ERR(phy_drd->mux))
+		return dev_err_probe(dev, PTR_ERR(phy_drd->mux),
+				     "failed to register TypeC mux\n");
+
+	ret = devm_add_action_or_reset(dev, exynos9820_dp_mux_unregister,
+				       phy_drd->mux);
+	return ret;
+}
