+/* PMU USBDP isolation is handled by pipe3 init/exit themselves */
+static void exynos9820_usbdrd_pipe3_isol(struct phy_usb_instance *inst,
+					 bool isolate)
+{
+}
+
+/*
+ * Which input picks the SS lane pair: the TypeC
+ * orientation (from the connector's orientation switch, i.e. max77705-usbc
+ * through the typec class, DT "orientation-switch") when one is registered
+ * and the cable is attached, else the port gpio (gpg0-4, set by the CC
+ * hardware), else the last orientation. Read at every combo PHY (re-)init
+ * and lane re-target.
+ */
+static int exynos9820_usbdrd_ss_port(struct exynos5_usbdrd_phy *phy_drd)
+{
+	if (phy_drd->sw && phy_drd->orientation != TYPEC_ORIENTATION_NONE) {
+		phy_drd->ss_src = "typec orientation";
+		return phy_drd->orientation == TYPEC_ORIENTATION_REVERSE;
+	}
+
+	if (phy_drd->port_gpio) {
+		int val = gpiod_get_value_cansleep(phy_drd->port_gpio);
+
+		if (val >= 0) {
+			phy_drd->ss_src = "port gpio";
+			return !!val;
+		}
+	}
+
+	phy_drd->ss_src = "typec orientation";
+	return phy_drd->orientation == TYPEC_ORIENTATION_REVERSE;
+}
+
+/* state of the PCS -> PMA controls and the LC PLL monitors, for bring-up */
+static void exynos9820_usbdrd_ss_dump(struct exynos5_usbdrd_phy *phy_drd,
+				      struct regmap *pmu, const char *what)
+{
+	void __iomem *pma = phy_drd->reg_pma;
+	unsigned int iso = 0;
+
+	regmap_read(pmu, EXYNOS9820_PHY_CTRL_USBDP, &iso);
+	dev_info(phy_drd->dev,
+		 "USB3 %s: PMU704=%#x CLKRST=%#x LINKCTRL=%#x SECPMACTL=%#x A0308=%#x A030C=%#x A0310=%#x A0314=%#x A0350=%#x A0354=%#x\n",
+		 what, iso, readl(phy_drd->reg_phy + EXYNOS850_DRD_CLKRST),
+		 readl(phy_drd->reg_phy + EXYNOS850_DRD_LINKCTRL),
+		 readl(phy_drd->reg_phy + EXYNOS850_DRD_SECPMACTL),
+		 readl(pma + EXYNOS9820_PMA_CMN_A0308),
+		 readl(pma + EXYNOS9820_PMA_CMN_A030C),
+		 readl(pma + EXYNOS9820_PMA_CMN_A0310),
+		 readl(pma + EXYNOS9820_PMA_CMN_A0314),
+		 readl(pma + EXYNOS9820_PMA_CMN_A0350),
+		 readl(pma + EXYNOS9820_PMA_CMN_A0354));
+}
