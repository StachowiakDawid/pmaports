+static void exynos9820_usbdrd_hs_hold_write(struct exynos5_usbdrd_phy *phy_drd,
+					    bool hold);
+
+/* back to the USB 2.0-only state left by utmi_init */
+static void exynos9820_usbdrd_pipe3_off(struct exynos5_usbdrd_phy *phy_drd)
+{
+	u32 reg;
+
+	if (phy_drd->ss_hs_hold)
+		exynos9820_usbdrd_hs_hold_write(phy_drd, false);
+
+	exynos5_usbdrd_usb_v3p1_pipe_override(phy_drd);
+
+	reg = readl(phy_drd->reg_phy + EXYNOS850_DRD_CLKRST);
+	reg &= ~CLKRST_LINK_PCLK_SEL;
+	writel(reg, phy_drd->reg_phy + EXYNOS850_DRD_CLKRST);
+
+	phy_drd->ss_port = -1;
+}
+
+static void exynos9820_usbdrd_pipe3_init(struct exynos5_usbdrd_phy *phy_drd)
+{
+	struct phy_usb_instance *inst = &phy_drd->phys[EXYNOS5_DRDPHY_PIPE3];
+	void __iomem *regs_phy = phy_drd->reg_phy;
+	void __iomem *regs_pma = phy_drd->reg_pma;
+	unsigned int pmu = 0;
+	ktime_t t0;
+	s64 cdr_us;
+	u32 reg;
+	int port, err;
+
+	phy_drd->ss_port = -1;
+	if (!exynos9820_ss || !phy_drd->reg_pma || !phy_drd->reg_pcs) {
+		dev_dbg(phy_drd->dev, "USB3 combo PHY not enabled, USB 2.0 only\n");
+		return;
+	}
+
+	if (phy_drd->dp_on) {
+		/* TODO: USB3 next to 2-lane DP (pin D) needs a shared PMA init */
+		dev_info(phy_drd->dev, "combo PHY in DP mode, USB 2.0 only\n");
+		return;
+	}
+
+	port = exynos9820_usbdrd_ss_port(phy_drd);
+
+	/* ungate the USBDP PHY in the PMU, PMA accesses fault without it */
+	regmap_update_bits(inst->reg_pmu, EXYNOS9820_PHY_CTRL_USBDP,
+			   EXYNOS4_PHY_ENABLE, EXYNOS4_PHY_ENABLE);
+	phy_drd->ss_pmu_on = true;
+	if (!regmap_read(inst->reg_pmu, EXYNOS9820_PHY_CTRL_USBDP, &pmu) &&
+	    !(pmu & EXYNOS4_PHY_ENABLE))
+		dev_warn(phy_drd->dev, "USB3: PMU USBDP enable did not stick (%#x)\n",
+			 pmu);
+
+	/* phy_exynos_usb_v3p1_g2_pma_ready() */
+	udelay(100);
+	reg = readl(regs_phy + EXYNOS850_DRD_SECPMACTL);
+	reg &= ~EXYNOS9820_SECPMACTL_REF_MASK;
+	reg |= EXYNOS9820_SECPMACTL_REF & EXYNOS9820_SECPMACTL_REF_MASK;
+	reg |= SECPMACTL_PMA_LOW_PWR | SECPMACTL_PMA_TRSV_SW_RST |
+	       SECPMACTL_PMA_CMN_SW_RST | SECPMACTL_PMA_INIT_SW_RST |
+	       SECPMACTL_PMA_APB_SW_RST;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(1);
+	reg &= ~SECPMACTL_PMA_LOW_PWR;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(1);
+
+	reg = readl(regs_phy + EXYNOS850_DRD_LINKCTRL);
+	reg &= ~LINKCTRL_FORCE_PIPE_EN;
+	writel(reg, regs_phy + EXYNOS850_DRD_LINKCTRL);
+	udelay(1);
+
+	reg = readl(regs_phy + EXYNOS850_DRD_SECPMACTL);
+	reg &= ~SECPMACTL_PMA_APB_SW_RST;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+
+	/* phy_exynos_usbdp_g2_enable() */
+	exynos5_usbdrd_apply_tune_table(phy_drd, exynos9820_tunes_pipe3_init);
+	exynos5_usbdrd_apply_tune_table(phy_drd, port ?
+					exynos9820_tunes_pipe3_port1 :
+					exynos9820_tunes_pipe3_port0);
+	/* phy_exynos_g2_usbdp_tune(): disjoint from the table registers */
+	exynos9820_usbdrd_ss_tune(phy_drd, "at init");
+	writel(A0310_OVRD_PCS_PLL_EN | A0310_PCS_PLL_EN,
+	       regs_pma + EXYNOS9820_PMA_CMN_A0310);
+
+	/* phy_exynos_usb_v3p1_g2_pma_sw_rst_release() */
+	reg = readl(regs_phy + EXYNOS850_DRD_SECPMACTL);
+	reg &= ~SECPMACTL_PMA_INIT_SW_RST;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(1);
+	reg &= ~(SECPMACTL_PMA_TRSV_SW_RST | SECPMACTL_PMA_CMN_SW_RST);
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	fsleep(1000);
+
+	err = readl_poll_timeout(regs_pma + EXYNOS9820_PMA_CMN_A0350, reg,
+				 reg & A0350_ANA_LCPLL_LOCK_DONE, 10, 100000);
+	if (err) {
+		dev_err(phy_drd->dev,
+			"USB3 combo PHY: LC PLL not locked (%#x), staying at USB 2.0\n",
+			reg);
+		exynos9820_usbdrd_ss_dump(phy_drd, inst->reg_pmu, "PLL fail");
+		exynos9820_usbdrd_pipe3_off(phy_drd);
+		return;
+	}
+	exynos9820_usbdrd_ss_dump(phy_drd, inst->reg_pmu, "PLL locked");
+
+	/* phy_exynos_usbdp_g2_run_lane() */
+	writel(0, regs_pma + EXYNOS9820_PMA_CMN_A031C);
+	writel(0, regs_pma + EXYNOS9820_PMA_CMN_A0328);
+	writel(0, regs_pma + EXYNOS9820_PMA_CMN_A032C);
+
+	/*
+	 * RX CDR lock: downstream waits up to ~100 ms and treats a timeout
+	 * as fatal; here it is only reported.
+	 */
+	t0 = ktime_get();
+	reg = readl(regs_pma + (port ? EXYNOS9820_PMA_TRSV_A1B84 :
+				EXYNOS9820_PMA_TRSV_A0B84));
+	err = (reg & TRSV_B84_MON_RX_CDR_LOCK_DONE) ? 0 : -ETIMEDOUT;
+	if (err)
+		err = readl_poll_timeout(regs_pma +
+					 (port ? EXYNOS9820_PMA_TRSV_A1B84 :
+					  EXYNOS9820_PMA_TRSV_A0B84),
+					 reg, reg & TRSV_B84_MON_RX_CDR_LOCK_DONE,
+					 10, EXYNOS9820_SS_CDR_MS *
+					 USEC_PER_MSEC);
+	cdr_us = ktime_us_delta(ktime_get(), t0);
+
+	/* phy_exynos_usb_v3p1_g2_link_pclk_sel(): link pipe clock from PMA */
+	reg = readl(regs_phy + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_LINK_PCLK_SEL;
+	writel(reg, regs_phy + EXYNOS850_DRD_CLKRST);
+	mdelay(3);
+
+	/* downstream phy_tune() after dwc3_phy_setup(): on the running PMA */
+	exynos9820_usbdrd_ss_tune(phy_drd, "after lane run");
+
+	phy_drd->ss_port = port;
+	dev_info(phy_drd->dev, "USB3 combo PHY up on lanes %s (%s), RX CDR %s after %lld us (B84 %#x)\n",
+		 port ? "2/3" : "0/1",
+		 phy_drd->ss_src ?: "?",
+		 err ? "not locked" : "locked", cdr_us,
+		 readl(regs_pma + (port ? EXYNOS9820_PMA_TRSV_A1B84 :
+				   EXYNOS9820_PMA_TRSV_A0B84)));
+}
+
+/* orientation changed while the SS PHY is in use: move it to the other lanes */
+static void exynos9820_usbdrd_ss_retarget(struct exynos5_usbdrd_phy *phy_drd)
+{
+	int port;
+
+	if (!phy_drd->ss_inited || !exynos9820_ss)
+		return;
+
+	port = exynos9820_usbdrd_ss_port(phy_drd);
+	if (port == phy_drd->ss_port) {
+		dev_dbg(phy_drd->dev, "USB3 lanes stay on port %d (%s)\n", port,
+			phy_drd->ss_src);
+		return;
+	}
+
+	dev_info(phy_drd->dev, "USB3 lanes: port %d -> %d (%s), re-initialising combo PHY\n",
+		 phy_drd->ss_port, port, phy_drd->ss_src);
+	if (phy_drd->ss_port >= 0)
+		exynos9820_usbdrd_pipe3_off(phy_drd);
+	exynos9820_usbdrd_pipe3_init(phy_drd);
+}
+
+static int exynos9820_usbdrd_phy_init(struct phy *phy)
+{
+	struct phy_usb_instance *inst = phy_get_drvdata(phy);
+	struct exynos5_usbdrd_phy *phy_drd = to_usbdrd_phy(inst);
+
+	if (inst->phy_cfg->id == EXYNOS5_DRDPHY_PIPE3)
+		phy_drd->ss_inited = true;
+
+	return exynos850_usbdrd_phy_init(phy);
+}
+
+static int exynos9820_usbdrd_phy_exit(struct phy *phy)
+{
+	struct phy_usb_instance *inst = phy_get_drvdata(phy);
+	struct exynos5_usbdrd_phy *phy_drd = to_usbdrd_phy(inst);
+	int ret;
+
+	if (inst->phy_cfg->id == EXYNOS5_DRDPHY_UTMI)
+		return exynos850_usbdrd_phy_exit(phy);
+
+	ret = clk_bulk_prepare_enable(phy_drd->drv_data->n_clks, phy_drd->clks);
+	if (ret)
+		return ret;
+
+	scoped_guard(mutex, &phy_drd->phy_mutex) {
+		if (phy_drd->ss_port >= 0)
+			exynos9820_usbdrd_pipe3_off(phy_drd);
+		if (phy_drd->ss_pmu_on) {
+			if (!phy_drd->dp_pmu_on)
+				regmap_update_bits(inst->reg_pmu,
+						   EXYNOS9820_PHY_CTRL_USBDP,
+						   EXYNOS4_PHY_ENABLE, 0);
+			phy_drd->ss_pmu_on = false;
+		}
+		phy_drd->ss_inited = false;
+	}
+
+	clk_bulk_disable_unprepare(phy_drd->drv_data->n_clks, phy_drd->clks);
+
+	return 0;
+}
+
+/*
+ * HS pull-up hold for SuperSpeed-first connects. The 9820 has no
+ * VBUS pad, so the HS PHY's VBUS valid (HSP VBUSVLDEXT, which gates the D+
+ * pull-up) is software controlled. Downstream (dwc3 gadget, is_not_vbus_pad)
+ * clears it at pullup(on), on Connect Done at HS/SS and on wakeup, and sets
+ * it again at USB reset and on the U0 / Rx.Detect / Resume link states
+ * (phy_set(SET_DPPULLUP_DISABLE/ENABLE) -> phy_exynos_usb_v3p1_*_dp_pullup()).
+ * Without that the host sees the device on USB 2.0 while the SuperSpeed link
+ * is coming up, resets the USB 2.0 port, and the link drops SS (LTSSM history
+ * Polling -> U0 -> Recovery -> U0 -> SS.Disabled). DWC3 requests it here with
+ * phy_set_mode_ext(usb2 phy, PHY_MODE_USB_DEVICE_SS = hold, _HS = release).
+ * A hold is ignored while the SS PHY is not up (exynos9820_ss=0, PLL fail),
+ * so USB 2.0-only operation never changes. PHY_MODE_USB_DEVICE/HOST and the
+ * SS PHY going down release it.
+ */
+static void exynos9820_usbdrd_hs_hold_write(struct exynos5_usbdrd_phy *phy_drd,
+					    bool hold)
+{
+	void __iomem *regs_base = phy_drd->reg_phy;
+	u32 hsp;
+
+	hsp = readl(regs_base + EXYNOS850_DRD_HSP);
+	if (hold)
+		hsp = (hsp | HSP_VBUSVLDEXTSEL) & ~HSP_VBUSVLDEXT;
+	else
+		hsp |= HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT;
+	writel(hsp, regs_base + EXYNOS850_DRD_HSP);
+	phy_drd->ss_hs_hold = hold;
+}
+
+static int exynos9820_usbdrd_hs_hold(struct exynos5_usbdrd_phy *phy_drd,
+				     bool hold)
+{
+	int ret;
+
+	ret = clk_bulk_prepare_enable(phy_drd->drv_data->n_clks, phy_drd->clks);
+	if (ret)
+		return ret;
+
+	scoped_guard(mutex, &phy_drd->phy_mutex) {
+		if (hold && phy_drd->ss_port < 0)
+			hold = false;
+		if (hold != phy_drd->ss_hs_hold)
+			exynos9820_usbdrd_hs_hold_write(phy_drd, hold);
+	}
+
+	clk_bulk_disable_unprepare(phy_drd->drv_data->n_clks, phy_drd->clks);
+
+	dev_dbg(phy_drd->dev, "HS pull-up %s\n", hold ? "held" : "released");
+
+	return 0;
+}
+
+/*
+ * No VBUS pad: in host mode the D+/D- pull-downs and the VBUSVALID/BVALID
+ * overrides must be set by software (downstream SET_DPDM_PULLDOWN ->
+ * phy_exynos_usb_v3p1_config_host_mode()). Device mode puts back what
+ * exynos850_usbdrd_utmi_init() programmed.
+ */
+static int exynos9820_usbdrd_phy_set_mode(struct phy *phy, enum phy_mode mode,
+					  int submode)
+{
+	struct phy_usb_instance *inst = phy_get_drvdata(phy);
+	struct exynos5_usbdrd_phy *phy_drd = to_usbdrd_phy(inst);
+	void __iomem *regs_base = phy_drd->reg_phy;
+	u32 utmi, hsp;
+	int ret;
+
+	/*
+	 * DWC3 sets the PIPE3 PHY's mode when a role starts (and
+	 * on a TypeC re-attach in device mode): re-target the SS lanes to the
+	 * cable orientation now, the port gpio / orientation are only read at
+	 * a combo PHY init otherwise.
+	 */
+	if (inst->phy_cfg->id == EXYNOS5_DRDPHY_PIPE3) {
+		if (mode != PHY_MODE_USB_HOST && mode != PHY_MODE_USB_DEVICE)
+			return 0;
+		ret = clk_bulk_prepare_enable(phy_drd->drv_data->n_clks,
+					      phy_drd->clks);
+		if (ret)
+			return ret;
+		scoped_guard(mutex, &phy_drd->phy_mutex)
+			exynos9820_usbdrd_ss_retarget(phy_drd);
+		clk_bulk_disable_unprepare(phy_drd->drv_data->n_clks,
+					   phy_drd->clks);
+		return 0;
+	}
+
+	if (inst->phy_cfg->id != EXYNOS5_DRDPHY_UTMI)
+		return 0;
+
+	if (mode == PHY_MODE_USB_DEVICE_SS || mode == PHY_MODE_USB_DEVICE_HS)
+		return exynos9820_usbdrd_hs_hold(phy_drd,
+						 mode == PHY_MODE_USB_DEVICE_SS);
+
+	if (mode != PHY_MODE_USB_HOST && mode != PHY_MODE_USB_DEVICE)
+		return 0;
+
+	ret = clk_bulk_prepare_enable(phy_drd->drv_data->n_clks, phy_drd->clks);
+	if (ret)
+		return ret;
+
+	scoped_guard(mutex, &phy_drd->phy_mutex) {
+		phy_drd->ss_hs_hold = false;
+		utmi = readl(regs_base + EXYNOS850_DRD_UTMI);
+		hsp = readl(regs_base + EXYNOS850_DRD_HSP);
+		if (mode == PHY_MODE_USB_HOST) {
+			utmi |= UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN;
+			utmi &= ~(UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID);
+			hsp &= ~(HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT);
+		} else {
+			utmi &= ~(UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN);
+			utmi |= UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID;
+			hsp |= HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT;
+		}
+		writel(utmi, regs_base + EXYNOS850_DRD_UTMI);
+		writel(hsp, regs_base + EXYNOS850_DRD_HSP);
+
+		/* downstream phy_tune(usb3, otg state) at the role's core init */
+		phy_drd->ss_host = mode == PHY_MODE_USB_HOST;
+		if (phy_drd->ss_port >= 0)
+			exynos9820_usbdrd_ss_tune(phy_drd, "on role change");
+	}
+
+	clk_bulk_disable_unprepare(phy_drd->drv_data->n_clks, phy_drd->clks);
+
+	dev_dbg(phy_drd->dev, "UTMI %s mode\n",
+		mode == PHY_MODE_USB_HOST ? "host" : "device");
+
+	return 0;
+}
+
+static const struct phy_ops exynos9820_usbdrd_phy_ops = {
+	.init		= exynos9820_usbdrd_phy_init,
+	.exit		= exynos9820_usbdrd_phy_exit,
+	.power_on	= exynos5_usbdrd_phy_power_on,
+	.power_off	= exynos5_usbdrd_phy_power_off,
+	.set_mode	= exynos9820_usbdrd_phy_set_mode,
+	.owner		= THIS_MODULE,
+};
+
+
+/*
+ * Exynos9820 DisplayPort over the USBDP combo PHY (third PHY, phandle arg 2).
+ *
+ * Downstream the DP link driver programs the combo PHY's DP registers
+ * itself (dpu20/cal_9820/displayport_reg.c, "phy_regs" = the PMA region at
+ * 0x10ae0000) after asking the USB driver to power the PHY
+ * (dwc3_exynos_phy_enable) and to give DP 4 or 2 lanes
+ * (exynos_usbdrd_inform_dp_use). Here that lives in the PHY driver:
+ *
+ *  - typec_mux (DT "mode-switch"): the DP alt mode pin assignment decides
+ *    how many lanes DP may use (C/E: 4, USB3 must be off; D: 2, USB3 keeps
+ *    the other pair). The limit is published as the DP PHY's bus width.
+ *  - phy_configure(opts.dp): set_rate/set_lanes re-run the downstream PHY
+ *    sequence (reset, default table, link BW, lane mux + TX clock
+ *    inversion, SSC off, reset release); set_voltages writes the per lane
+ *    amplitude/emphasis table. The PLL lock is polled by the DP controller
+ *    (SYSTEM_PLL_LOCK_CONTROL is a link register).
+ *
+ * Lane mapping (displayport_reg_set_phy_voltage_and_pre_emphasis /
+ * _set_lane_map_config, pin C/D/E): DP lane i is on physical lane
+ * map[flip][i]; "flip" is downstream dp_sw_sel (CC2 / TypeC reverse), the
+ * complement of the USB3 port select.
+ *
+ * UNTESTED on hardware.
+ */
+#define EXYNOS9820_DP_CMN_REG0009		0x0024
+#define DP_CMN_ANA_AUX_TX_LVL_CTRL		GENMASK(6, 3)
+#define EXYNOS9820_DP_CMN_REG00A2		0x0288
+#define DP_CMN_LANE_MUX_SEL_DP(ln)		BIT(4 + (ln))
+#define DP_CMN_LANE_EN(ln)			BIT(ln)
+#define EXYNOS9820_DP_CMN_REG00A3		0x028c
+#define DP_CMN_TX_LINK_BW			GENMASK(6, 5)
+#define EXYNOS9820_DP_CMN_REG00B4		0x02d0
+#define DP_CMN_ROPLL_SSC_EN			BIT(1)
+#define EXYNOS9820_DP_CMN_REG00E3		0x038c
+#define DP_CMN_DP_INIT_RSTN			BIT(3)
+#define DP_CMN_DP_CMN_RSTN			BIT(2)
+#define DP_CMN_CDR_WATCHDOG_EN			BIT(1)
+/* per physical lane: TRSV_REG0204/0404/0604/0804 (+4*n), TRSV_REGx215 */
+#define EXYNOS9820_DP_TRSV_TUNE(ln)		(0x0810 + 0x800 * (ln))
+#define EXYNOS9820_DP_TRSV_TXCLK(ln)		(0x0854 + 0x800 * (ln))
+#define DP_TRSV_ANA_TX_SER_TXCLK_INV		BIT(1)
+
+/*
+ * EVT1 phy_default_value[] (displayport_reg.c). DEFAULT_SFR_CNT is 32 for EVT1
+ * (regs-displayport.h), so the table has exactly these 32 entries; the
+ * {0, 0} entry of the first implementation (a write of 0 to CMN_REG0000)
+ * came from misreading the EVT0 count and is gone.
+ */
+static const u16 exynos9820_dp_phy_defaults[][2] = {
+	{ 0x0830, 0x07 }, { 0x085c, 0x80 }, { 0x1030, 0x07 }, { 0x105c, 0x80 },
+	{ 0x1830, 0x07 }, { 0x185c, 0x80 }, { 0x2030, 0x07 }, { 0x205c, 0x80 },
+	{ 0x0228, 0x38 }, { 0x0104, 0x44 }, { 0x0248, 0x44 }, { 0x038c, 0x02 },
+	{ 0x0878, 0x04 }, { 0x1878, 0x04 }, { 0x09a4, 0x07 }, { 0x09a8, 0x22 },
+	{ 0x19a4, 0x07 }, { 0x19a8, 0x22 }, { 0x0994, 0x12 }, { 0x1994, 0x12 },
+	{ 0x0998, 0x12 }, { 0x1998, 0x12 }, { 0x099c, 0x48 }, { 0x199c, 0x48 },
+	{ 0x0898, 0x77 }, { 0x1898, 0x77 }, { 0x0054, 0x01 }, { 0x00e0, 0x38 },
+	{ 0x0060, 0x24 }, { 0x0064, 0x77 }, { 0x0070, 0x76 }, { 0x0234, 0xe8 },
+};
+static_assert(ARRAY_SIZE(exynos9820_dp_phy_defaults) == 32);
+
+/* EVT1 phy_tune_param_default[swing][pre-emphasis] = {amp, post, pre, idrv, accdrv} */
+static const u8 exynos9820_dp_tune[4][4][5] = {
+	{
+		{ 0x21, 0x10, 0x42, 0xe5, 0x60 }, { 0x25, 0x14, 0x42, 0xe5, 0x60 },
+		{ 0x26, 0x17, 0x43, 0xe5, 0x60 }, { 0x2b, 0x1c, 0x43, 0xe7, 0x60 },
+	}, {
+		{ 0x26, 0x10, 0x42, 0xe7, 0x60 }, { 0x2b, 0x15, 0x42, 0xe7, 0x60 },
+		{ 0x2b, 0x18, 0x43, 0xe7, 0x60 }, { 0x2b, 0x18, 0x43, 0xe7, 0x60 },
+	}, {
+		{ 0x2a, 0x10, 0x42, 0xe7, 0x60 }, { 0x2b, 0x15, 0x43, 0xe7, 0x60 },
+		{ 0x2b, 0x15, 0x43, 0xe7, 0x60 }, { 0x2b, 0x15, 0x43, 0xe7, 0x60 },
+	}, {
+		{ 0x2b, 0x10, 0x43, 0xe7, 0x60 }, { 0x2b, 0x10, 0x43, 0xe7, 0x60 },
+		{ 0x2b, 0x10, 0x43, 0xe7, 0x60 }, { 0x2b, 0x10, 0x43, 0xe7, 0x60 },
+	},
+};
+
+static const u8 exynos9820_dp_lane_map[2][4] = {
+	{ 0, 1, 3, 2 },		/* CC1 */
+	{ 3, 2, 0, 1 },		/* CC2 (dp_sw_sel) */
+};
+
+static void exynos9820_dp_write_mask(struct exynos5_usbdrd_phy *phy_drd,
+				     u32 off, u32 mask, u32 val)
+{
+	u32 reg = readl(phy_drd->reg_pma + off);
+
+	writel((reg & ~mask) | (val & mask), phy_drd->reg_pma + off);
+}
+
+static bool exynos9820_dp_flip(struct exynos5_usbdrd_phy *phy_drd)
+{
+	/* DP takes the lane pair USB3 does not use */
+	return !exynos9820_usbdrd_ss_port(phy_drd);
+}
+
+/* PMU isolation off + PMA out of reset, without touching the USB link side */
+static void exynos9820_dp_pma_on(struct exynos5_usbdrd_phy *phy_drd)
+{
+	struct phy_usb_instance *inst = &phy_drd->phys[EXYNOS5_DRDPHY_PIPE3];
+	void __iomem *regs_phy = phy_drd->reg_phy;
+	u32 reg;
+
+	if (!phy_drd->ss_pmu_on && !phy_drd->dp_pmu_on)
+		regmap_update_bits(inst->reg_pmu, EXYNOS9820_PHY_CTRL_USBDP,
+				   EXYNOS4_PHY_ENABLE, EXYNOS4_PHY_ENABLE);
+	phy_drd->dp_pmu_on = true;
+
+	if (phy_drd->ss_port >= 0)
+		return;		/* the USB3 bring-up already released the PMA */
+
+	/* phy_exynos_usb_v3p1_g2_pma_ready() + _pma_sw_rst_release() */
+	udelay(100);
+	reg = readl(regs_phy + EXYNOS850_DRD_SECPMACTL);
+	reg &= ~(SECPMACTL_PMA_ROPLL_REF_CLK_SEL |
+		 SECPMACTL_PMA_LCPLL_REF_CLK_SEL | SECPMACTL_PMA_REF_FREQ_SEL);
+	reg |= FIELD_PREP(SECPMACTL_PMA_REF_FREQ_SEL, 1);
+	reg |= SECPMACTL_PMA_LOW_PWR | SECPMACTL_PMA_TRSV_SW_RST |
+	       SECPMACTL_PMA_CMN_SW_RST | SECPMACTL_PMA_INIT_SW_RST |
+	       SECPMACTL_PMA_APB_SW_RST;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(1);
+	reg &= ~SECPMACTL_PMA_LOW_PWR;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(1);
+	reg &= ~SECPMACTL_PMA_APB_SW_RST;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	reg &= ~SECPMACTL_PMA_INIT_SW_RST;
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(1);
+	reg &= ~(SECPMACTL_PMA_TRSV_SW_RST | SECPMACTL_PMA_CMN_SW_RST);
+	writel(reg, regs_phy + EXYNOS850_DRD_SECPMACTL);
+	udelay(10);
+}
+
+static void exynos9820_dp_pma_off(struct exynos5_usbdrd_phy *phy_drd)
+{
+	struct phy_usb_instance *inst = &phy_drd->phys[EXYNOS5_DRDPHY_PIPE3];
+	u32 reg;
+
+	if (!phy_drd->dp_pmu_on)
+		return;
+	phy_drd->dp_pmu_on = false;
+	if (phy_drd->ss_port >= 0 || phy_drd->ss_pmu_on)
+		return;		/* USB3 still uses it */
+
+	/* back to the low power state utmi_init leaves the PMA in */
+	reg = readl(phy_drd->reg_phy + EXYNOS850_DRD_SECPMACTL);
+	reg |= SECPMACTL_PMA_LOW_PWR;
+	writel(reg, phy_drd->reg_phy + EXYNOS850_DRD_SECPMACTL);
+	regmap_update_bits(inst->reg_pmu, EXYNOS9820_PHY_CTRL_USBDP,
+			   EXYNOS4_PHY_ENABLE, 0);
+}
+
+/* displayport_reg_phy_reset(1) ... phy_reset(0) of the link training */
+static void exynos9820_dp_phy_setup(struct exynos5_usbdrd_phy *phy_drd)
+{
+	unsigned int i, ln, n = phy_drd->dp_lanes;
+	bool flip = phy_drd->dp_flip;
+	u32 mux = 0, bw;
+
+	exynos9820_dp_write_mask(phy_drd, EXYNOS9820_DP_CMN_REG00E3,
+				 DP_CMN_DP_CMN_RSTN, 0);
+
+	for (i = 0; i < ARRAY_SIZE(exynos9820_dp_phy_defaults); i++)
+		writel(exynos9820_dp_phy_defaults[i][1],
+		       phy_drd->reg_pma + exynos9820_dp_phy_defaults[i][0]);
+	exynos9820_dp_write_mask(phy_drd, EXYNOS9820_DP_CMN_REG0009,
+				 DP_CMN_ANA_AUX_TX_LVL_CTRL,
+				 FIELD_PREP(DP_CMN_ANA_AUX_TX_LVL_CTRL, 0xd));
+
+	switch (phy_drd->dp_rate) {
+	case 1620:
+		bw = 0;
+		break;
+	case 2700:
+		bw = 1;
+		break;
+	default:
+		bw = 2;
+		break;
+	}
+	exynos9820_dp_write_mask(phy_drd, EXYNOS9820_DP_CMN_REG00A3,
+				 DP_CMN_TX_LINK_BW,
+				 FIELD_PREP(DP_CMN_TX_LINK_BW, bw));
+
+	/* lane mux: all 4 lanes, or the pair USB3 does not use */
+	for (ln = 0; ln < 4; ln++) {
+		bool dp = n > 2 || (flip ? ln >= 2 : ln < 2);
+
+		if (dp)
+			mux |= DP_CMN_LANE_MUX_SEL_DP(ln) | DP_CMN_LANE_EN(ln);
+		exynos9820_dp_write_mask(phy_drd, EXYNOS9820_DP_TRSV_TXCLK(ln),
+					 DP_TRSV_ANA_TX_SER_TXCLK_INV,
+					 dp && phy_drd->dp_rate < 5400 ?
+					 DP_TRSV_ANA_TX_SER_TXCLK_INV : 0);
+	}
+	writel(mux, phy_drd->reg_pma + EXYNOS9820_DP_CMN_REG00A2);
+
+	exynos9820_dp_write_mask(phy_drd, EXYNOS9820_DP_CMN_REG00B4,
+				 DP_CMN_ROPLL_SSC_EN, 0);
+
+	udelay(60);
+	writel(DP_CMN_DP_INIT_RSTN | DP_CMN_CDR_WATCHDOG_EN,
+	       phy_drd->reg_pma + EXYNOS9820_DP_CMN_REG00E3);
+	udelay(1);
+	writel(DP_CMN_DP_INIT_RSTN | DP_CMN_DP_CMN_RSTN | DP_CMN_CDR_WATCHDOG_EN,
+	       phy_drd->reg_pma + EXYNOS9820_DP_CMN_REG00E3);
+}
+
+static void exynos9820_dp_set_tune(struct exynos5_usbdrd_phy *phy_drd,
+				   const struct phy_configure_opts_dp *dp)
+{
+	const u8 *map = exynos9820_dp_lane_map[phy_drd->dp_flip];
+	unsigned int i, j;
+
+	for (i = 0; i < phy_drd->dp_lanes; i++) {
+		unsigned int v = min(dp->voltage[i], 3u);
+		unsigned int pre = min(dp->pre[i], 3u);
+
+		for (j = 0; j < 5; j++)
+			writel(exynos9820_dp_tune[v][pre][j], phy_drd->reg_pma +
+			       EXYNOS9820_DP_TRSV_TUNE(map[i]) + 4 * j);
+	}
+}
+
+static int exynos9820_dp_phy_power_on(struct phy *phy)
+{
+	struct exynos5_usbdrd_phy *phy_drd = phy_get_drvdata(phy);
+	int ret;
+
+	if (!phy_drd->reg_pma)
+		return -ENODEV;
+
+	ret = clk_bulk_prepare_enable(phy_drd->drv_data->n_clks, phy_drd->clks);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&phy_drd->phy_mutex);
+	/*
+	 * The DP sequence resets the PMA common block and rewrites its default
+	 * table, which a running USB3 pipe does not survive; USB3 next to a
+	 * 2-lane DP link (pin D) would need a shared PMA init (TODO). So DP
+	 * always takes the PHY from USB3, also for 2 lanes; USB 2.0 (UTMI)
+	 * is not touched. pipe3 init refuses while dp_on.
+	 */
+	if (phy_drd->ss_port >= 0) {
+		dev_warn(phy_drd->dev, "DP (%u lanes): stopping the USB3 pipe, USB 2.0 stays\n",
+			 phy_drd->dp_max_lanes ?: 4);
+		exynos9820_usbdrd_pipe3_off(phy_drd);
+	}
+	exynos9820_dp_pma_on(phy_drd);
+	phy_drd->dp_flip = exynos9820_dp_flip(phy_drd);
+	phy_drd->dp_lanes = phy_drd->dp_max_lanes ?: 4;
+	phy_drd->dp_rate = 1620;
+	exynos9820_dp_phy_setup(phy_drd);
+	phy_drd->dp_on = true;
+	dev_info(phy_drd->dev, "DP PHY on (max %u lanes, %s)\n",
+		 phy_drd->dp_max_lanes, phy_drd->dp_flip ? "CC2" : "CC1");
+
+	return 0;
+}
+
+static int exynos9820_dp_phy_power_off(struct phy *phy)
+{
+	struct exynos5_usbdrd_phy *phy_drd = phy_get_drvdata(phy);
+
+	scoped_guard(mutex, &phy_drd->phy_mutex) {
+		exynos9820_dp_write_mask(phy_drd, EXYNOS9820_DP_CMN_REG00E3,
+					 DP_CMN_DP_CMN_RSTN, 0);
+		writel(0, phy_drd->reg_pma + EXYNOS9820_DP_CMN_REG00A2);
+		exynos9820_dp_pma_off(phy_drd);
+		phy_drd->dp_on = false;
+	}
+
+	clk_bulk_disable_unprepare(phy_drd->drv_data->n_clks, phy_drd->clks);
+	return 0;
+}
+
+static int exynos9820_dp_phy_validate(struct phy *phy, enum phy_mode mode,
+				      int submode, union phy_configure_opts *opts)
+{
+	struct exynos5_usbdrd_phy *phy_drd = phy_get_drvdata(phy);
+	struct phy_configure_opts_dp *dp = &opts->dp;
+
+	if (mode != PHY_MODE_DP)
+		return -EINVAL;
+	if (dp->set_lanes && (dp->lanes == 3 || dp->lanes > 4 ||
+			      (phy_drd->dp_max_lanes &&
+			       dp->lanes > phy_drd->dp_max_lanes)))
+		return -EINVAL;
+	if (dp->set_rate && dp->link_rate != 1620 && dp->link_rate != 2700 &&
+	    dp->link_rate != 5400)
+		return -EINVAL;
+	return 0;
+}
+
+static int exynos9820_dp_phy_configure(struct phy *phy,
+				       union phy_configure_opts *opts)
+{
+	struct exynos5_usbdrd_phy *phy_drd = phy_get_drvdata(phy);
+	struct phy_configure_opts_dp *dp = &opts->dp;
+	int ret;
+
+	ret = exynos9820_dp_phy_validate(phy, PHY_MODE_DP, 0, opts);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&phy_drd->phy_mutex);
+	if (!phy_drd->dp_on)
+		return -EIO;
+
+	if (dp->set_lanes)
+		phy_drd->dp_lanes = dp->lanes;
+	if (dp->set_rate)
+		phy_drd->dp_rate = dp->link_rate;
+	if (dp->set_lanes || dp->set_rate) {
+		phy_drd->dp_flip = exynos9820_dp_flip(phy_drd);
+		exynos9820_dp_phy_setup(phy_drd);
+	}
+	if (dp->set_voltages)
+		exynos9820_dp_set_tune(phy_drd, dp);
+
+	return 0;
+}
