+/*
+ * Exynos9820 (USB 3.1 DRD link + "USBDP gen2" USB/DisplayPort combo PHY).
+ *
+ * The UTMI (HS) part is the Exynos990 one. Two additions:
+ *
+ * - host mode: there is no VBUS pad, so the D+/D- 15k pull-downs and the
+ *   VBUSVALID/BVALID overrides are software controlled (downstream
+ *   phy_exynos_usb_v3p1_config_host_mode(), "is_not_vbus_pad"). Done from
+ *   phy_set_mode(), device mode restores exactly what utmi_init set up.
+ *
+ * - SuperSpeed: the combo PHY (PMA at reg "pma", PCS at reg "pcs", PMU
+ *   isolation at 0x704) is brought up like the downstream
+ *   exynos_usbdrd_pipe3_init() / phy_exynos_usbdp_g2_enable(). This is OFF
+ *   unless the exynos9820_ss module parameter is set, so the USB 2.0 link
+ *   (forced pipe3 signals, PMA in low power, as set by utmi_init) is not
+ *   touched by default. Any lock failure falls back to that USB 2.0-only
+ *   state instead of failing phy_init().
+ *
+ * Which PMA lanes carry USB3 follows the "samsung,usbdp-port-gpios" input
+ * (downstream "phy,gpio_phy_port", 0 = lanes 0/1, 1 = lanes 2/3) and, without
+ * it, the TypeC orientation (reverse = port 1).
+ */
+static bool exynos9820_ss;
+module_param(exynos9820_ss, bool, 0644);
+MODULE_PARM_DESC(exynos9820_ss,
+		 "Exynos9820: bring up the USB3 SuperSpeed combo PHY (default off: USB 2.0 only; takes effect at the next phy_init)");
+
+/*
+ * The LC PLL bring-up follows the downstream EVT1 sequence, except that the
+ * PCS PLL enable is forced (CMN 0x310): on the device the LC PLL only locks
+ * with it (A0350 = 0xee); without it it never starts (0x38).
+ */
+
+/* SECPMACTL bits 16 (REF_SOC_PLL_SSC) and 13:8 (RO/LC PLL ref, ref freq) */
+#define EXYNOS9820_SECPMACTL_REF_MASK	(BIT(16) | GENMASK(13, 8))
+/* REF_FREQ_SEL 1, LC/RO PLL ref 0 */
+#define EXYNOS9820_SECPMACTL_REF	0x100
+
+#define EXYNOS9820_PHY_CTRL_USBDP		0x704
+
+#define EXYNOS9820_DRD_LINKPORT			0x08
+#define LINKPORT_HUB_PORT_SEL_OCD_U3		BIT(3)
+#define LINKPORT_HUB_PORT_SEL_OCD_U2		BIT(2)
+
+#define EXYNOS9820_PMA_CMN_A0308		0x0308
+#define EXYNOS9820_PMA_CMN_A030C		0x030c
+#define A030C_OVRD_PCS_CMN_RSTN			BIT(3)
+#define A030C_PCS_CMN_RSTN			BIT(2)
+#define EXYNOS9820_PMA_CMN_A0310		0x0310
+#define A0310_OVRD_PCS_PLL_EN			BIT(1)
+#define A0310_PCS_PLL_EN			BIT(0)
+#define EXYNOS9820_PMA_CMN_A0314		0x0314
+#define EXYNOS9820_PMA_CMN_A0350		0x0350
+#define A0350_ANA_LCPLL_LOCK_DONE		BIT(7)
+#define EXYNOS9820_PMA_CMN_A0354		0x0354
+#define EXYNOS9820_PMA_CMN_A031C		0x031c
+#define EXYNOS9820_PMA_CMN_A0328		0x0328
+#define EXYNOS9820_PMA_CMN_A032C		0x032c
+#define EXYNOS9820_PMA_TRSV_A0B84		0x0b84	/* lane 0 */
+#define EXYNOS9820_PMA_TRSV_A1B84		0x1b84	/* lane 2 */
+#define TRSV_B84_MON_RX_CDR_LOCK_DONE		BIT(0)
+
+/*
+ * phy_exynos_usbdp_g2_enable() (EVT1, !CONFIG_SOC_EXYNOS9820_EVT0) and
+ * phy_exynos_usbdp_g2_set_pcs(), as executed: generated by running the
+ * downstream function against a register shadow and keeping, for every
+ * write, the bits it sets/clears (mask ~0 = plain write).
+ */
+static const struct exynos5_usbdrd_phy_tuning exynos9820_tunes_pipe3_init[] = {
+	PHY_TUNING_ENTRY_PMA(0x0830, ~0, 0x00000007),
+	PHY_TUNING_ENTRY_PMA(0x1830, ~0, 0x00000007),
+	PHY_TUNING_ENTRY_PMA(0x085c, ~0, 0x00000080),
+	PHY_TUNING_ENTRY_PMA(0x185c, ~0, 0x00000080),
+	PHY_TUNING_ENTRY_PMA(0x1030, ~0, 0x00000007),
+	PHY_TUNING_ENTRY_PMA(0x2030, ~0, 0x00000007),
+	PHY_TUNING_ENTRY_PMA(0x105c, ~0, 0x00000080),
+	PHY_TUNING_ENTRY_PMA(0x205c, ~0, 0x00000080),
+	PHY_TUNING_ENTRY_PMA(0x0228, ~0, 0x00000038),
+	PHY_TUNING_ENTRY_PMA(0x0104, ~0, 0x00000044),
+	PHY_TUNING_ENTRY_PMA(0x0248, ~0, 0x00000044),
+	PHY_TUNING_ENTRY_PMA(0x038c, 0x0000000e, 0x00000002),
+	PHY_TUNING_ENTRY_PMA(0x0878, ~0, 0x00000004),
+	PHY_TUNING_ENTRY_PMA(0x1878, ~0, 0x00000004),
+	PHY_TUNING_ENTRY_PMA(0x09a4, ~0, 0x00000007),
+	PHY_TUNING_ENTRY_PMA(0x19a4, ~0, 0x00000007),
+	PHY_TUNING_ENTRY_PMA(0x09a8, ~0, 0x00000022),
+	PHY_TUNING_ENTRY_PMA(0x19a8, ~0, 0x00000022),
+	PHY_TUNING_ENTRY_PMA(0x0994, ~0, 0x00000012),
+	PHY_TUNING_ENTRY_PMA(0x1994, ~0, 0x00000012),
+	PHY_TUNING_ENTRY_PMA(0x0998, ~0, 0x00000012),
+	PHY_TUNING_ENTRY_PMA(0x1998, ~0, 0x00000012),
+	PHY_TUNING_ENTRY_PMA(0x099c, ~0, 0x00000048),
+	PHY_TUNING_ENTRY_PMA(0x199c, ~0, 0x00000048),
+	PHY_TUNING_ENTRY_PMA(0x0898, ~0, 0x00000077),
+	PHY_TUNING_ENTRY_PMA(0x1898, ~0, 0x00000077),
+	PHY_TUNING_ENTRY_PMA(0x0054, ~0, 0x00000001),
+	PHY_TUNING_ENTRY_PMA(0x00e0, ~0, 0x00000038),
+	PHY_TUNING_ENTRY_PMA(0x0060, ~0, 0x00000024),
+	PHY_TUNING_ENTRY_PMA(0x0064, ~0, 0x00000077),
+	PHY_TUNING_ENTRY_PMA(0x0070, ~0, 0x00000076),
+	PHY_TUNING_ENTRY_PMA(0x0310, ~0, 0x00000000),
+	PHY_TUNING_ENTRY_PMA(0x0308, ~0, 0x00000000),
+	PHY_TUNING_ENTRY_PCS(0x0304, 0x003f003f, 0x00000001),
+	PHY_TUNING_ENTRY_PCS(0x0318, 0x00020000, 0x00020000),
+	PHY_TUNING_ENTRY_PCS(0x030c, 0x00000001, 0x00000000),
+	PHY_TUNING_ENTRY_PCS(0x014c, 0x00000300, 0x00000100),
+	PHY_TUNING_ENTRY_PCS(0x0150, 0x0000c000, 0x00004000),
+	PHY_TUNING_ENTRY_PMA(0x0a98, 0x000000f0, 0x00000020),
+	PHY_TUNING_ENTRY_PMA(0x1a98, 0x000000f0, 0x00000020),
+	PHY_TUNING_ENTRY_PMA(0x0258, ~0, 0x00000000),
+	PHY_TUNING_ENTRY_LAST
+};
+
+/* lanes for used_phy_port 0 (USB on lanes 0/1) */
+static const struct exynos5_usbdrd_phy_tuning exynos9820_tunes_pipe3_port0[] = {
+	PHY_TUNING_ENTRY_PMA(0x0288, ~0, 0x000000c0),
+	PHY_TUNING_ENTRY_PMA(0x028c, ~0, 0x00000018),
+	PHY_TUNING_ENTRY_PMA(0x1000, ~0, 0x00000008),
+	PHY_TUNING_ENTRY_PMA(0x2000, ~0, 0x00000028),
+	PHY_TUNING_ENTRY_PMA(0x0af0, 0x0000001c, 0x00000000),
+	PHY_TUNING_ENTRY_LAST
+};
+
+static const struct exynos5_usbdrd_phy_tuning exynos9820_tunes_pipe3_port1[] = {
+	PHY_TUNING_ENTRY_PMA(0x0288, ~0, 0x00000030),
+	PHY_TUNING_ENTRY_PMA(0x028c, ~0, 0x00000018),
+	PHY_TUNING_ENTRY_PMA(0x1000, ~0, 0x00000028),
+	PHY_TUNING_ENTRY_PMA(0x2000, ~0, 0x00000008),
+	PHY_TUNING_ENTRY_PMA(0x1af0, 0x0000001c, 0x00000000),
+	PHY_TUNING_ENTRY_LAST
+};
+
+/*
+ * The downstream SuperSpeed tune set. The beyond2lte DT has
+ * "ss_tune_param = <&usb_ss_tune>" on the PHY node; the usb_ss_tune node is
+ * status = "disabled", but exynos_usbdrd_get_sub_phyinfo() parses it through
+ * of_parse_phandle() without an availability check, so the vendor kernel
+ * applies all 20 entries: in phy_exynos_usbdp_g2_enable() (via
+ * phy_exynos_g2_usbdp_tune()) and again from phy_tune() right after
+ * dwc3_phy_setup() at every DWC3 core init, i.e. on the running PMA. Values
+ * are <device host>. phy_exynos_usbdp_g2_tune_each() writes the RX entries to
+ * lane 0 and lane 2, the TX entries to lane 1 and lane 3, and after each
+ * MF/HF EQ and DFE1 entry restarts the RX adaptation (TRSV 0x0a34/0x1a34 =
+ * 0x08, 0x18, 0x1e). Groups:
+ *   1 RX squelch/LFPS detect thresholds (tunes 1-2)
+ *   2 RX EQ: CTLE MF enable, SSLMS MF/HF init rates, DFE taps 1-5, plus the
+ *     adaptation restart (tunes 3-12)
+ *   4 RX termination calibration (tune 13)
+ *   8 TX driver: amplitude, de-emphasis, pre-shoot, IDRV up/down, Rcal up/dn
+ *     (tunes 14-20)
+ * All groups are applied in the enable() position (before the PLL starts)
+ * and again after the lanes run (the phy_tune() position); a
+ * role change (phy_set_mode) re-applies the matching column if SS is up.
+ */
+#define EXYNOS9820_SST_RX_SQ		BIT(0)
+#define EXYNOS9820_SST_RX_EQ		BIT(1)
+#define EXYNOS9820_SST_RX_TERM		BIT(2)
+#define EXYNOS9820_SST_TX		BIT(3)
+
+/*
+ * RX CDR lock wait after run_lane. Downstream polls TRSV 0xb84/0x1b84 for up
+ * to 100 x 1000 x 1 us and tears the PHY down on timeout; here it is only
+ * reported.
+ */
+#define EXYNOS9820_SS_CDR_MS		100
+
+struct exynos9820_ss_tune_ent {
+	u16 off[2];		/* lane 0/2 (RX) or lane 1/3 (TX) */
+	u8 mask;		/* all bits the entry touches */
+	u8 set;			/* bits always set (override enables etc.) */
+	u8 field;		/* value field */
+	u8 shift;
+	u8 val[2];		/* <device host> from the DT */
+	u8 group;
+	bool restart;		/* RX adaptation restart afterwards */
+};
+
+#define SST(o0, o1, m, st, f, sh, vd, vh, g, r) \
+	{ .off = { o0, o1 }, .mask = m, .set = st, .field = f, .shift = sh, \
+	  .val = { vd, vh }, .group = g, .restart = r }
+
+static const struct exynos9820_ss_tune_ent exynos9820_ss_tunes[] = {
+	/* ss_tune1  ssrx_sqhs_th <4 4>: TRSV 26E RX_SQHS_TH[7:4] */
+	SST(0x09b8, 0x19b8, 0xf0, 0x00, 0xf0, 4, 0x4, 0x4, EXYNOS9820_SST_RX_SQ, false),
+	/* ss_tune2  ssrx_lfps_th <2 2>: TRSV 0270 RX_LFPS_TH_CTRL[3:1] */
+	SST(0x09c0, 0x19c0, 0x0e, 0x00, 0x0e, 1, 0x2, 0x2, EXYNOS9820_SST_RX_SQ, false),
+	/* ss_tune3  ssrx_mf_eq_en: TRSV 0241 |= RL_HF_HBR3(3) | MF_BWD_EN, &= ~OC_DAC_PU */
+	SST(0x0904, 0x1904, 0x78, 0x70, 0x00, 0, 0x0, 0x0, EXYNOS9820_SST_RX_EQ, false),
+	/* ss_tune4  ssrx_mf_eq_ctrl_ss <6 6>: TRSV 0311 SSLMS_MF_INIT_RATE_SP[4:0] */
+	SST(0x0c44, 0x1c44, 0x1f, 0x00, 0x1f, 0, 0x6, 0x6, EXYNOS9820_SST_RX_EQ, true),
+	/*
+	 * ss_tune5  ssrx_hf_eq_ctrl_ss <0xc 0xe>: TRSV 030B SSLMS_HF_INIT_RATE_SP.
+	 * Host 0xc instead of the beyond2lte DT's 0xe (the other 9820 boards'
+	 * value, and our device column): with 0xe the link behind a Nintendo
+	 * Switch dock on lanes 0/1 dropped to SS.Inactive every few seconds
+	 * under traffic (16-30 drops / 120 s); with 0xc + dfe1 0: none in 5 min
+	 * at 10 MS/s. Directly attached devices work with both.
+	 */
+	SST(0x0c2c, 0x1c2c, 0x1f, 0x00, 0x1f, 0, 0xc, 0xc, EXYNOS9820_SST_RX_EQ, true),
+	/* ss_tune6  ssrx_mf_eq_ctrl_ssp <6 6>: TRSV 0312 */
+	SST(0x0c48, 0x1c48, 0x1f, 0x00, 0x1f, 0, 0x6, 0x6, EXYNOS9820_SST_RX_EQ, true),
+	/* ss_tune7  ssrx_hf_eq_ctrl_ssp <0xe 0xe>: TRSV 030C */
+	SST(0x0c30, 0x1c30, 0x1f, 0x00, 0x1f, 0, 0xe, 0xe, EXYNOS9820_SST_RX_EQ, true),
+	/* ss_tune8  ssrx_dfe1_tap_ctrl <0 2>: TRSV 0279 SSLMS_C1_INIT[7:0]; host 0 (see ss_tune5) */
+	SST(0x09e4, 0x19e4, 0xff, 0x00, 0xff, 0, 0x0, 0x0, EXYNOS9820_SST_RX_EQ, true),
+	/* ss_tune9..12 ssrx_dfe2..5_tap_ctrl <0 0>: TRSV 027A..027D */
+	SST(0x09e8, 0x19e8, 0xff, 0x00, 0xff, 0, 0x0, 0x0, EXYNOS9820_SST_RX_EQ, false),
+	SST(0x09ec, 0x19ec, 0xff, 0x00, 0xff, 0, 0x0, 0x0, EXYNOS9820_SST_RX_EQ, false),
+	SST(0x09f0, 0x19f0, 0xff, 0x00, 0xff, 0, 0x0, 0x0, EXYNOS9820_SST_RX_EQ, false),
+	SST(0x09f4, 0x19f4, 0xff, 0x00, 0xff, 0, 0x0, 0x0, EXYNOS9820_SST_RX_EQ, false),
+	/* ss_tune13 ssrx_term_cal <0xb 0xb>: TRSV 02BD RX_RTERM_CTRL[3:0], |= RCAL_OPT_CODE(1) */
+	SST(0x0af4, 0x1af4, 0x1f, 0x10, 0x0f, 0, 0xb, 0xb, EXYNOS9820_SST_RX_TERM, false),
+	/* ss_tune14 sstx_amp <0xb 0xb>: TRSV 0404 OVRD_TX_DRV_LVL_CTRL | LVL_CTRL[4:0] */
+	SST(0x1010, 0x2010, 0x3f, 0x20, 0x1f, 0, 0xb, 0xb, EXYNOS9820_SST_TX, false),
+	/* ss_tune15 sstx_deemp <5 5>: TRSV 0405 OVRD_POST_LVL | POST_LVL_CTRL[3:0] */
+	SST(0x1014, 0x2014, 0x1f, 0x10, 0x0f, 0, 0x5, 0x5, EXYNOS9820_SST_TX, false),
+	/* ss_tune16 sstx_pre_shoot <3 3>: TRSV 0406 OVRD_PRE_LVL | PRE_LVL_CTRL[5:2] */
+	SST(0x1018, 0x2018, 0x7c, 0x40, 0x3c, 2, 0x3, 0x3, EXYNOS9820_SST_TX, false),
+	/* ss_tune17 sstx_idrv_up <7 7>: TRSV 0407 IDRV_IUP_CTRL[7:5] (EVT1) */
+	SST(0x101c, 0x201c, 0xe0, 0x00, 0xe0, 5, 0x7, 0x7, EXYNOS9820_SST_TX, false),
+	/* ss_tune18 sstx_idrv_dn <0 0>: CMN 041C/0420 LN1/LN3 IDRV_IDN_CTRL[2:0] (EVT1) */
+	SST(0x041c, 0x0420, 0x07, 0x00, 0x07, 0, 0x0, 0x0, EXYNOS9820_SST_TX, false),
+	/* ss_tune19 sstx_up_term <3 3>: TRSV 0420 TX_RCAL_UP_CODE[7:4] */
+	SST(0x1080, 0x2080, 0xf0, 0x00, 0xf0, 4, 0x3, 0x3, EXYNOS9820_SST_TX, false),
+	/* ss_tune20 sstx_dn_term <3 3>: TRSV 0420 TX_RCAL_DN_CODE[3:0] */
+	SST(0x1080, 0x2080, 0x0f, 0x00, 0x0f, 0, 0x3, 0x3, EXYNOS9820_SST_TX, false),
+};
+
+#define EXYNOS9820_PMA_TRSV_A0A34		0x0a34
+#define EXYNOS9820_PMA_TRSV_A1A34		0x1a34
+
+/* phy_exynos_g2_usbdp_tune() with the <device host> column of the DT */
+static void exynos9820_usbdrd_ss_tune(struct exynos5_usbdrd_phy *phy_drd,
+				      const char *when)
+{
+	void __iomem *pma = phy_drd->reg_pma;
+	int col = phy_drd->ss_host ? 1 : 0;
+	static const u8 restart[] = { 0x08, 0x18, 0x1e };
+	int i, j, k;
+
+	for (i = 0; i < ARRAY_SIZE(exynos9820_ss_tunes); i++) {
+		const struct exynos9820_ss_tune_ent *t = &exynos9820_ss_tunes[i];
+
+		for (j = 0; j < 2; j++) {
+			u32 reg = readl(pma + t->off[j]);
+
+			reg &= ~(u32)t->mask;
+			reg |= t->set;
+			reg |= ((u32)t->val[col] << t->shift) & t->field;
+			writel(reg, pma + t->off[j]);
+		}
+
+		if (!t->restart)
+			continue;
+
+		for (k = 0; k < ARRAY_SIZE(restart); k++) {
+			writel(restart[k], pma + EXYNOS9820_PMA_TRSV_A0A34);
+			writel(restart[k], pma + EXYNOS9820_PMA_TRSV_A1A34);
+		}
+	}
+
+	dev_info(phy_drd->dev,
+		 "USB3 SS tune (%s column) %s: RX0 sq/lfps %#x/%#x eq %#x/%#x term %#x, TX1 amp/de/pre %#x/%#x/%#x, TX3 amp %#x\n",
+		 col ? "host" : "device", when,
+		 readl(pma + 0x09b8), readl(pma + 0x09c0),
+		 readl(pma + 0x0c2c), readl(pma + 0x0a34),
+		 readl(pma + 0x0af4), readl(pma + 0x1010),
+		 readl(pma + 0x1014), readl(pma + 0x1018),
+		 readl(pma + 0x2010));
+}
+
+static void exynos9820_usbdrd_utmi_init(struct exynos5_usbdrd_phy *phy_drd)
+{
+	u32 reg;
+
+	exynos850_usbdrd_utmi_init(phy_drd);
+
+	/*
+	 * Host port over-current from the (never set) SET_OCD bits instead
+	 * of a pad, like downstream with use_io_for_ovc = 0. Only the xHCI
+	 * root hub looks at this.
+	 */
+	reg = readl(phy_drd->reg_phy + EXYNOS9820_DRD_LINKPORT);
+	reg |= LINKPORT_HUB_PORT_SEL_OCD_U3 | LINKPORT_HUB_PORT_SEL_OCD_U2;
+	writel(reg, phy_drd->reg_phy + EXYNOS9820_DRD_LINKPORT);
+}
