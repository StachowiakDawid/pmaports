diff --git a/Documentation/devicetree/bindings/usb/maxim,max77705-usbc.yaml b/Documentation/devicetree/bindings/usb/maxim,max77705-usbc.yaml
new file mode 100644
index 0000000000..ecab2210d5
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/maxim,max77705-usbc.yaml
@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/maxim,max77705-usbc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Maxim MAX77705 USB Type-C/PD controller and MUIC
+
+maintainers:
+  - Dzmitry Sankouski <dsankouski@gmail.com>
+
+description: |
+  The MAX77705 PMIC contains a USB Type-C/PD controller with integrated
+  firmware (CC detection, BC1.2, PD policy engine, VDM discovery) and a
+  D+/D- switch (MUIC). It sits on its own I2C address next to the PMIC
+  (maxim,max77705), whose interrupt controller provides its interrupt.
+
+properties:
+  compatible:
+    const: maxim,max77705-usbc
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  vbus-supply:
+    description: VBUS source used when the port is power source (the
+      charger OTG boost, see maxim,max77705-charger usb-otg-vbus).
+
+  connector:
+    type: object
+    $ref: ../connector/usb-connector.yaml#
+    unevaluatedProperties: false
+    description:
+      USB-C connector. port@0 links to the USB controller (role switch),
+      port@1 to the SuperSpeed orientation switch, port@2 to the SBU/DP
+      mode switch. An optional "displayport" phandle names the DRM
+      DisplayPort connector for HPD.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - connector
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      usb-typec@25 {
+        compatible = "maxim,max77705-usbc";
+        reg = <0x25>;
+        interrupt-parent = <&pmic>;
+        interrupts = <3>;
+        vbus-supply = <&otg_vbus>;
+
+        connector {
+          compatible = "usb-c-connector";
+          label = "USB-C";
+          data-role = "dual";
+          power-role = "dual";
+          try-power-role = "sink";
+
+          ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+              reg = <0>;
+              endpoint {
+                remote-endpoint = <&usb_hs>;
+              };
+            };
+          };
+        };
+      };
+    };
diff --git a/drivers/usb/typec/Kconfig b/drivers/usb/typec/Kconfig
index 2f80c2792d..8f7a260cac 100644
--- a/drivers/usb/typec/Kconfig
+++ b/drivers/usb/typec/Kconfig
@@ -110,6 +110,24 @@ config TYPEC_WUSB3801
 	  If you choose to build this driver as a dynamically linked module, the
 	  module will be called wusb3801.ko.
 
+config TYPEC_MAX77705
+	tristate "Maxim MAX77705 USB Type-C/PD controller and MUIC driver"
+	depends on I2C
+	depends on MFD_MAX77705 || COMPILE_TEST
+	depends on USB_ROLE_SWITCH || !USB_ROLE_SWITCH
+	depends on DRM || DRM=n
+	depends on POWER_SUPPLY
+	select REGMAP_I2C
+	help
+	  Say Y or M here if your system has a Maxim MAX77705 PMIC with its
+	  USB Type-C/PD block (CCIC), e.g. the Samsung Galaxy S10 family.
+	  The firmware on the chip does CC detection and PD; this driver
+	  registers the Type-C port, drives the USB role switch, routes the
+	  D+/D- switch (MUIC) to the AP and controls VBUS for host mode.
+
+	  If you choose to build this driver as a dynamically linked module, the
+	  module will be called max77705-usbc.ko.
+
 source "drivers/usb/typec/mux/Kconfig"
 
 source "drivers/usb/typec/altmodes/Kconfig"
