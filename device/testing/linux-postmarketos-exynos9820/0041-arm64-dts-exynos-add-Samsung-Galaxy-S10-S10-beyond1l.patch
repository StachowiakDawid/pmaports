+&soc {
+	/*
+	 * I2C_CAM0 ("hsi2c_0" downstream). Not a multi-protocol USI (no
+	 * SW_CONF in SYSREG_PERIC1), but the block has the USI wrapper
+	 * registers and comes up with USI_RESET set: the USI node is there to
+	 * release it.
+	 */
+	usi_i2c_cam0: usi@108600c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x108600c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM0_PCLK>,
+			 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM0_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,mode = <USI_MODE_I2C>;
+
+		hsi2c0: i2c@10860000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x10860000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM0_IPCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM0_PCLK>;
+
+			interrupts = <GIC_SPI 410 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c0_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/* downstream runs it at 1 MHz */
+			clock-frequency = <400000>;
+
+			/*
+			 * Rear wide camera, 12 MP dual pixel. MCLK0 (CIS_CLK0,
+			 * gpc1-4) is shared with the rear tele camera: only one
+			 * of the two may stream at a time. The OIS/aperture MCU
+			 * is not driven here; the lens actuator is wide_af.
+			 */
+			camera-sensor@10 {
+				compatible = "samsung,s5k2l4";
+				reg = <0x10>;
+
+				clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
+				reset-gpios = <&gpg2 6 GPIO_ACTIVE_LOW>;
+
+				pinctrl-0 = <&sensor_mclk0_idle>;
+				pinctrl-1 = <&sensor_mclk0_fn>;
+				pinctrl-names = "mclk-off", "mclk";
+
+				/* Order follows the vendor power sequence */
+				vddret-supply = <&cam2_ldo4>;	/* VDDD_RET_1.0V_CAM */
+				vdda28-supply = <&cam2_ldo6>;	/* VDDA_2.8V_CAM */
+				vdda24-supply = <&cam2_ldo5>;	/* VDDA_2.4V_CAM */
+				vddd-supply = <&cam2_ldo1>;	/* VDDD_1.0V_CAM */
+				vddaf-supply = <&cam_ldo14>;	/* VDDAF_COMMON_CAM (S2MPB02) */
+				vddio-supply = <&cam2_ldo3>;	/* VDDIO_1.8V_CAM */
+				vddq-supply = <&cam2_ldo2>;	/* VDDQ_1.1V_CAM */
+
+				lens-focus = <&wide_af>;
+
+				orientation = <1>;	/* back */
+				rotation = <90>;	/* mounted the other way round */
+
+				port {
+					s5k2l4_out: endpoint {
+						remote-endpoint = <&csis0_in>;
+						data-lanes = <1 2 3 4>;
+						/* 2016x1512 at 1352, 4032x3024 at 2054 Mbit/s */
+						link-frequencies = /bits/ 64 <676000000 1027000000>;
+					};
+				};
+			};
+		};
+	};
+
+	/*
+	 * MIPI CSIS0 with its D/C-PHY (M4S4 "top") and write DMA0. The PHY
+	 * block at 0x19160b00 is the CSI slave half of the M4S4 module whose
+	 * master half is the display DSI PHY; the two have independent lane
+	 * registers and resets. The PHY isolation bit (PMU 0x70C) is shared
+	 * with the display and is left alone on stream-off. Bring
+	 * CSIS0 up only with the display on.
+	 */
+	csis0: csis@17030000 {
+		compatible = "samsung,exynos9820-csis";
+		reg = <0x17030000 0x1000>,
+		      <0x170a0000 0x100>,
+		      <0x170a0400 0x100>,
+		      <0x170e0000 0x100>,
+		      <0x19160b00 0x500>,
+		      <0x17020000 0x1000>,
+		      <0x17000000 0x8000>;
+		reg-names = "csis", "dma", "dma-common", "dma-top", "phy",
+			    "sysreg", "cmu";
+
+		interrupts = <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 315 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "csis", "dma";
+
+		clocks = <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>;
+		clock-names = "bus";
+
+		power-domains = <&pd_isppre>;
+
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		samsung,phy-isolation-offset = <0x70c>;
+		samsung,phy-isolation-shared;	/* M4S4 top shared with the DSI PHY */
+		samsung,phy-combo;		/* DCPHY used as D-PHY */
+		samsung,phy-reset-bit = <0>;
+		samsung,dma-index = <0>;
+
+		port {
+			csis0_in: endpoint {
+				remote-endpoint = <&s5k2l4_out>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+
+	/* I2C_CAM1, same kind of block as I2C_CAM0 */
+	usi_i2c_cam1: usi@108700c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x108700c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM1_PCLK>,
+			 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM1_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,mode = <USI_MODE_I2C>;
+
+		/* "hsi2c_1" in the downstream DT */
+		hsi2c1: i2c@10870000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x10870000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM1_IPCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM1_PCLK>;
+
+			interrupts = <GIC_SPI 411 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c1_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/* downstream runs it at 1 MHz */
+			clock-frequency = <400000>;
+
+			/*
+			 * Ultra-wide module EEPROM (factory calibration: AWB, LSC,
+			 * AF), read-only. Size and address from the vendor DT; the
+			 * supply is assumed to be the module I/O rail.
+			 */
+			eeprom@51 {
+				compatible = "atmel,24c128";
+				reg = <0x51>;
+				label = "camera-eeprom-uw";
+				read-only;
+				vcc-supply = <&cam_ldo8>;
+			};
+
+			/* rear ultra-wide camera, 16 MP, fixed focus */
+			camera-sensor@2d {
+				compatible = "samsung,s5k3p9";
+				reg = <0x2d>;
+
+				clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK3>;
+				reset-gpios = <&gpg0 3 GPIO_ACTIVE_LOW>;
+
+				pinctrl-0 = <&sensor_mclk3_idle>;
+				pinctrl-1 = <&sensor_mclk3_fn>;
+				pinctrl-names = "mclk-off", "mclk";
+
+				vddbuck1-supply = <&cam_buck1>;
+				vddbb-supply = <&cam_bb>;
+				vddext-supply = <&cam_buck2>;
+				vdda-supply = <&cam_ldo15>;
+				vddd-supply = <&cam_ldo4>;
+				vddio-supply = <&cam_ldo8>;
+
+				orientation = <1>;	/* back */
+				rotation = <270>;
+
+				port {
+					s5k3p9_out: endpoint {
+						remote-endpoint = <&csis1_in>;
+						data-lanes = <1 2 3 4>;
+						link-frequencies = /bits/ 64 <1027000000>;
+					};
+				};
+			};
+		};
+	};
+
+	/*
+	 * MIPI CSIS1 with its D-PHY (2nd S4 of the M0S4S4S4 module) and write
+	 * DMA1. All of it sits in the ISPPRE power domain except the PHY
+	 * registers (DPU address space).
+	 */
+	csis1: csis@17040000 {
+		compatible = "samsung,exynos9820-csis";
+		reg = <0x17040000 0x1000>,
+		      <0x170b0000 0x100>,
+		      <0x170b0400 0x100>,
+		      <0x170e0000 0x100>,
+		      <0x19162b00 0x500>,
+		      <0x17020000 0x1000>,
+		      <0x17000000 0x8000>;
+		reg-names = "csis", "dma", "dma-common", "dma-top", "phy",
+			    "sysreg", "cmu";
+
+		interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "csis", "dma";
+
+		clocks = <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>;
+		clock-names = "bus";
+
+		power-domains = <&pd_isppre>;
+
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		samsung,phy-isolation-offset = <0x730>;
+		samsung,phy-reset-bit = <2>;
+		samsung,dma-index = <1>;
+
+		port {
+			csis1_in: endpoint {
+				remote-endpoint = <&s5k3p9_out>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+
+	/* I2C_CAM2, same kind of block as I2C_CAM1 ("hsi2c_2" downstream) */
+	usi_i2c_cam2: usi@108800c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x108800c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM2_PCLK>,
+			 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM2_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,mode = <USI_MODE_I2C>;
+
+		hsi2c2: i2c@10880000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x10880000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM2_IPCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM2_PCLK>;
+
+			interrupts = <GIC_SPI 412 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c2_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			clock-frequency = <400000>;
+
+			/* front camera, 10 MP dual pixel */
+			camera-sensor@10 {
+				compatible = "samsung,s5k3j1";
+				reg = <0x10>;
+
+				clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
+				reset-gpios = <&gpg2 5 GPIO_ACTIVE_LOW>;
+				lens-focus = <&front_af>;
+
+				pinctrl-0 = <&sensor_mclk1_idle>;
+				pinctrl-1 = <&sensor_mclk1_fn>;
+				pinctrl-names = "mclk-off", "mclk";
+
+				vddbuck1-supply = <&cam_buck1>;
+				vddbb-supply = <&cam_bb>;
+				vddext-supply = <&cam_buck2>;
+				vddaf-supply = <&cam_ldo16>;
+				vdda-supply = <&cam_ldo13>;
+				vddio-supply = <&cam_ldo6>;
+				vddd-supply = <&cam_ldo5>;
+
+				orientation = <0>;	/* front */
+				rotation = <90>;
+
+				port {
+					s5k3j1_out: endpoint {
+						remote-endpoint = <&csis2_in>;
+						data-lanes = <1 2 3 4>;
+						link-frequencies = /bits/ 64 <903500000>;
+					};
+				};
+			};
+		};
+	};
+
+	/*
+	 * MIPI CSIS2 with its D/C-PHY combo (1st S4 of the M0S4S4S4 module)
+	 * and write DMA2. Shared by the front camera and the rear telephoto
+	 * camera through a MIPI switch (gpg4-3).
+	 */
+	csis2: csis@17050000 {
+		compatible = "samsung,exynos9820-csis";
+		reg = <0x17050000 0x1000>,
+		      <0x170c0000 0x100>,
+		      <0x170c0400 0x100>,
+		      <0x170e0000 0x100>,
+		      <0x19162300 0x500>,
+		      <0x17020000 0x1000>,
+		      <0x17000000 0x8000>;
+		reg-names = "csis", "dma", "dma-common", "dma-top", "phy",
+			    "sysreg", "cmu";
+
+		interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 317 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "csis", "dma";
+
+		clocks = <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>;
+		clock-names = "bus";
+
+		power-domains = <&pd_isppre>;
+
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		samsung,phy-isolation-offset = <0x730>;
+		samsung,phy-reset-bit = <1>;
+		samsung,phy-combo;
+		samsung,dma-index = <2>;
+
+		/* MIPI switch: low = front camera, high = rear tele */
+		mux-gpios = <&gpg4 3 GPIO_ACTIVE_HIGH>;
+
+		/* the endpoint number is the switch position */
+		port {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			csis2_in: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&s5k3j1_out>;
+				data-lanes = <1 2 3 4>;
+			};
+
+			csis2_in_tele: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&s5k3m3_out>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+
+	/*
+	 * MIPI CSIS3_1 with its D-PHY (two lanes of the 3rd S4 of the
+	 * M0S4S4S4 module, which it shares with CSIS3) and write DMA3: front
+	 * depth camera.
+	 */
+	csis3_1: csis@17090000 {
+		compatible = "samsung,exynos9820-csis";
+		reg = <0x17090000 0x1000>,
+		      <0x170d0000 0x100>,
+		      <0x170d0400 0x100>,
+		      <0x170e0000 0x100>,
+		      <0x19163600 0x600>,
+		      <0x17020000 0x1000>,
+		      <0x17000000 0x8000>;
+		reg-names = "csis", "dma", "dma-common", "dma-top", "phy",
+			    "sysreg", "cmu";
+
+		interrupts = <GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 318 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "csis", "dma";
+
+		clocks = <&cmu_top CLK_DOUT_CMU_ISPPRE_BUS>;
+		clock-names = "bus";
+
+		power-domains = <&pd_isppre>;
+
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		samsung,phy-isolation-offset = <0x730>;
+		samsung,phy-reset-bit = <4>;
+		/* data lanes at 0x000/0x100, clock lane at 0x500 of the range */
+		samsung,phy-split;
+		samsung,dma-index = <3>;
+
+		port {
+			csis3_1_in: endpoint {
+				remote-endpoint = <&s5k4ha_out>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+
+	/* USI07_I2C ("hsi2c_19" downstream): rear tele and front depth sensors */
+	usi07_i2c: usi@108d00c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x108d00c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI07_I2C_PCLK>,
+			 <&cmu_peric1 CLK_GOUT_PERIC1_USI07_I2C_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,sysreg = <&sysreg_peric1 0x1024>;
+		samsung,mode = <USI_MODE_I2C>;
+
+		hsi2c19: i2c@108d0000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x108d0000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI07_I2C_IPCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_USI07_I2C_PCLK>;
+
+			interrupts = <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c19_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			clock-frequency = <400000>;
+
+			/* front depth camera, 8 MP, fixed focus */
+			camera-sensor@10 {
+				compatible = "samsung,s5k4ha";
+				reg = <0x10>;
+
+				/* MCLK1 is shared with the front camera */
+				clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK1>;
+				reset-gpios = <&gpg2 3 GPIO_ACTIVE_LOW>;
+
+				pinctrl-0 = <&sensor_mclk1_idle>;
+				pinctrl-1 = <&sensor_mclk1_fn>;
+				pinctrl-names = "mclk-off", "mclk";
+
+				vdda-supply = <&ldo24m>;
+				vddd-supply = <&ldo23m>;
+				vddio-supply = <&ldo25m>;
+
+				orientation = <0>;	/* front */
+				rotation = <90>;
+
+				port {
+					s5k4ha_out: endpoint {
+						remote-endpoint = <&csis3_1_in>;
+						data-lanes = <1 2>;
+						link-frequencies = /bits/ 64 <488500000>;
+					};
+				};
+			};
+
+			/* rear tele camera, 12 MP, OIS not driven */
+			camera-sensor@2d {
+				compatible = "samsung,s5k3m3";
+				reg = <0x2d>;
+
+				/* MCLK0 is shared with the rear wide camera */
+				clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
+				reset-gpios = <&gpg3 0 GPIO_ACTIVE_LOW>;
+
+				pinctrl-0 = <&sensor_mclk0_idle>;
+				pinctrl-1 = <&sensor_mclk0_fn>;
+				pinctrl-names = "mclk-off", "mclk";
+
+				vddbuck1-supply = <&cam_buck1>;
+				vddbb-supply = <&cam_bb>;
+				vddext-supply = <&cam_buck2>;
+				vdda-supply = <&cam_ldo11>;
+				vddd-supply = <&cam_ldo3>;
+				vddaf-supply = <&cam_ldo12>;
+				vddiocam-supply = <&cam2_ldo3>;
+				vddiobus-supply = <&ldo25m>;
+				vddio-supply = <&cam_ldo7>;
+
+				lens-focus = <&tele_af>;
+
+				orientation = <1>;	/* back */
+				rotation = <270>;
+
+				port {
+					s5k3m3_out: endpoint {
+						remote-endpoint = <&csis2_in_tele>;
+						data-lanes = <1 2 3 4>;
+						link-frequencies = /bits/ 64 <598000000>;
+					};
+				};
+			};
+		};
+	};
+
+	/* USI08_I2C ("hsi2c_21" downstream): front lens actuator */
+	usi08_i2c: usi@108f00c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x108f00c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI08_I2C_PCLK>,
+			 <&cmu_peric1 CLK_GOUT_PERIC1_USI08_I2C_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,sysreg = <&sysreg_peric1 0x102c>;
+		samsung,mode = <USI_MODE_I2C>;
+
+		hsi2c21: i2c@108f0000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x108f0000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI08_I2C_IPCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_USI08_I2C_PCLK>;
+
+			interrupts = <GIC_SPI 419 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c21_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			clock-frequency = <400000>;
+
+			/* front module EEPROM, as on I2C_CAM1 */
+			eeprom@51 {
+				compatible = "atmel,24c128";
+				reg = <0x51>;
+				label = "camera-eeprom-front";
+				read-only;
+				vcc-supply = <&cam_ldo6>;
+			};
+
+			/* AK7374, 9 bit position; only reachable while the front camera is powered */
+			front_af: lens@c {
+				compatible = "asahi-kasei,ak7374";
+				reg = <0x0c>;
+				vdd-supply = <&cam_ldo16>;
+				vio-supply = <&cam_ldo6>;
+			};
+		};
+	};
+
+	/* I2C_CAM3 ("hsi2c_3" downstream): rear lens actuators (and the rear EEPROM, 0x50) */
+	usi_i2c_cam3: usi@108900c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x108900c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM3_PCLK>,
+			 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM3_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,mode = <USI_MODE_I2C>;
+
+		hsi2c3: i2c@10890000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x10890000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM3_IPCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_I2C_CAM3_PCLK>;
+
+			interrupts = <GIC_SPI 413 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c3_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			clock-frequency = <400000>;
+
+			/* rear module EEPROM (wide + tele calibration), as on I2C_CAM1 */
+			eeprom@50 {
+				compatible = "atmel,24c512";
+				reg = <0x50>;
+				label = "camera-eeprom-rear";
+				read-only;
+				vcc-supply = <&cam2_ldo3>;
+			};
+
+			/*
+			 * AK7374 of the rear wide lens, reachable while the wide
+			 * sensor is powered. Its supply is the actuator rail the
+			 * wide sensor also lists.
+			 */
+			wide_af: lens@c {
+				compatible = "asahi-kasei,ak7374";
+				reg = <0x0c>;
+				vdd-supply = <&cam_ldo14>;	/* VDDAF_COMMON_CAM */
+				vio-supply = <&cam2_ldo3>;
+			};
+
+			/* AK7374 of the rear tele lens */
+			tele_af: lens@f {
+				compatible = "asahi-kasei,ak7374";
+				reg = <0x0f>;
+				vdd-supply = <&cam_ldo12>;
+				vio-supply = <&cam2_ldo3>;
+			};
+		};
+	};
+
+	/* I2C_CMGP1 ("hsi2c_42" downstream): S2MPB03 camera PMIC */
+	usi_cmgp1_i2c: usi@15d300c0 {
+		compatible = "samsung,exynos850-usi";
+		reg = <0x15d300c0 0x20>;
+		ranges;
+
+		clock-names = "pclk",
+			      "ipclk";
+		clocks = <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_PCLK>,
+			 <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_IPCLK>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		samsung,sysreg = <&sysreg_cmgp 0x2014>;
+		samsung,mode = <USI_MODE_I2C>;
+
+		hsi2c42: i2c@15d30000 {
+			compatible = "samsung,exynosautov9-hsi2c";
+			reg = <0x15d30000 0xc0>;
+
+			clock-names = "hsi2c",
+				      "hsi2c_pclk";
+			clocks = <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_IPCLK>,
+				 <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP1_PCLK>;
+
+			interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-0 = <&hsi2c42_bus>;
+			pinctrl-names = "default";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/*
+			 * Rear wide camera supplies, OIS motor supply and the
+			 * rear camera I/O rail. Only the regulators listed
+			 * here are registered.
+			 */
+			camera-pmic@56 {
+				compatible = "samsung,s2mpb03";
+				reg = <0x56>;
+
+				regulators {
+					cam2_ldo3: ldo3 {
+						regulator-name = "VDDIO_1.8V_CAM";
+						regulator-min-microvolt = <1800000>;
+						regulator-max-microvolt = <1800000>;
+					};
+
+					cam2_ldo1: ldo1 {
+						regulator-name = "VDDD_1.0V_CAM";
+						regulator-min-microvolt = <1000000>;
+						regulator-max-microvolt = <1000000>;
+					};
+
+					cam2_ldo2: ldo2 {
+						regulator-name = "VDDQ_1.1V_CAM";
+						regulator-min-microvolt = <1100000>;
+						regulator-max-microvolt = <1100000>;
+					};
+
+					cam2_ldo4: ldo4 {
+						regulator-name = "VDDD_RET_1.0V_CAM";
+						regulator-min-microvolt = <1025000>;
+						regulator-max-microvolt = <1025000>;
+					};
+
+					cam2_ldo5: ldo5 {
+						regulator-name = "VDDA_2.4V_CAM";
+						regulator-min-microvolt = <2400000>;
+						regulator-max-microvolt = <2400000>;
+					};
+
+					cam2_ldo6: ldo6 {
+						regulator-name = "VDDA_2.8V_CAM";
+						regulator-min-microvolt = <2800000>;
+						regulator-max-microvolt = <2800000>;
+					};
+				};
+			};
+		};
+	};
+};
