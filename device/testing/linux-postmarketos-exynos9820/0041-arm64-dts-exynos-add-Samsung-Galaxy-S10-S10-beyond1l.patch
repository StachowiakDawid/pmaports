diff --git a/arch/arm64/boot/dts/exynos/exynos9820-beyond-audio.dtsi b/arch/arm64/boot/dts/exynos/exynos9820-beyond-audio.dtsi
new file mode 100644
index 0000000000..ea23fbc56e
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9820-beyond-audio.dtsi
@@ -0,0 +1,310 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Audio hardware of the Samsung Galaxy S10 family (beyond1lte/beyond2lte).
+ * The downstream DTs (exynos9820-beyond{1,2}lte_common.dtsi) are identical
+ * for the codec and the amplifiers.
+ *
+ *  - Cirrus Logic CS47L93 codec on USI01 SPI ("spi_2" downstream), CS0
+ *    MCLK1 = CLKOUT0 (26 MHz TCXO), IRQ gpa2-2, RESET gpg1-0
+ *    AVDD/DBVDD1/CPVDD1 = LDO17M (1.8 V), CPVDD2/DCVDD = LDO18M (1.2 V)
+ *  - 2x Cirrus Logic CS35L40 (= CS35L41 die, ID 0x35a40) on USI17_I2C
+ *    ("hsi2c_38" downstream). 0x40 = bottom speaker, RESET gph1-1.
+ *    0x41 = earpiece (receiver), RESET gph1-2. Shared IRQ gpm24-0.
+ *
+ * Data paths go through the Exynos ABOX (no mainline driver yet):
+ *   ABOX UAIF0 (gpb0-1..4)  <-> CS47L93 AIF1, I2S
+ *   ABOX UAIF1 (gpb1-0..3)  <-> both CS35L4x ASP, DSP_A, inverted BCLK
+ *   ABOX UAIF2 (gpb1-4..7)  <-> CS47L93 AIF3, I2S
+ */
+
+#include <dt-bindings/sound/madera.h>
+
+&acpm_ipc {
+	pmic-1 {
+		regulators {
+			ldo17m: ldo17m {
+				regulator-name = "vdd_pmic_codec_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			ldo18m: ldo18m {
+				regulator-name = "vdd_codec_1p2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-ramp-delay = <12000>;
+				regulator-enable-ramp-delay = <5000>;
+			};
+		};
+	};
+};
+
+&pinctrl_alive {
+	codec_irq: codec-irq-pins {
+		samsung,pins = "gpa2-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_cmgp {
+	amp_int: amp-int-pins {
+		samsung,pins = "gpm24-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric0 {
+	codec_reset: codec-reset-pins {
+		samsung,pins = "gpg1-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric0 {
+	/*
+	 * USI01 nCS driven as a GPIO, see &spi2 below. Same pull-up as the
+	 * native spi2_cs group / downstream spi2-cs-func.
+	 */
+	spi2_cs_gpio: spi2-cs-gpio-pins {
+		samsung,pins = "gpp0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+};
+
+&pinctrl_peric1 {
+	spk_amp_rst_n: spk-amp-rst-n-pins {
+		samsung,pins = "gph1-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	rcv_amp_rst_n: rcv-amp-rst-n-pins {
+		samsung,pins = "gph1-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&sysmmu_aud {
+	status = "okay";
+};
+
+&abox {
+	status = "okay";
+};
+
+&usi1 {
+	samsung,mode = <USI_MODE_SPI>;
+	status = "okay";
+};
+
+&spi2 {
+	/*
+	 * Chip select as a GPIO. The exynos850-spi controller runs in AUTO
+	 * chip-select mode, which releases nCS at the end of every transfer,
+	 * but a madera register read is one message of two transfers
+	 * (address + pad, then data) and needs nCS held for the whole
+	 * message, as downstream does with manual CS
+	 * (samsung,spi-chip-select-mode = <0>). The IP's own nCS output is
+	 * not routed to the pad.
+	 */
+	pinctrl-0 = <&spi2_bus &spi2_cs_gpio>;
+	cs-gpios = <&gpp0 7 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	cs47l93: audio-codec@0 {
+		compatible = "cirrus,cs47l93";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+
+		interrupts-extended = <&gpa2 2 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		#sound-dai-cells = <1>;
+
+		/*
+		 * Flag 0 as downstream (reset-gpios = <&gpg1 0 0>): madera-core
+		 * drives /RESET with raw values (0 = asserted) but requests the
+		 * line as GPIOD_OUT_LOW, so GPIO_ACTIVE_LOW would release the
+		 * codec from reset before its supplies are up.
+		 */
+		reset-gpios = <&gpg1 0 GPIO_ACTIVE_HIGH>;
+
+		AVDD-supply = <&ldo17m>;
+		DBVDD1-supply = <&ldo17m>;
+		CPVDD1-supply = <&ldo17m>;
+		CPVDD2-supply = <&ldo18m>;
+		DCVDD-supply = <&ldo18m>;
+
+		/*
+		 * MCLK1 = PMU CLKOUT0 (PMU_DEBUG 0xa00), mux input 1 = TCXO
+		 * 26 MHz. The mux resets to input 0 (no clock), so select the
+		 * TCXO here. MCLK2 (32 kHz) has no clock provider (the S2MPS19
+		 * 32 kHz output is not described) and is left out.
+		 */
+		clocks = <&pmu_system_controller 0>;
+		clock-names = "mclk1";
+		assigned-clocks = <&pmu_system_controller 0>;
+		assigned-clock-parents = <&oscclk>;
+
+		/* IN3/IN4 = digital mics referenced to MICBIAS1 */
+		cirrus,dmic-ref = <0 0 MADERA_DMIC_REF_MICBIAS1
+				   MADERA_DMIC_REF_MICBIAS1>;
+		cirrus,inmode = <
+			MADERA_INMODE_DIFF MADERA_INMODE_DIFF
+			MADERA_INMODE_DIFF MADERA_INMODE_DIFF	/* IN1 */
+			MADERA_INMODE_DIFF MADERA_INMODE_DIFF
+			MADERA_INMODE_SE   MADERA_INMODE_SE	/* IN2 */
+		>;
+		cirrus,out-mono = <0 0 0 1 0 0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&codec_reset &codec_irq &cs47l93_pins>;
+
+		/* downstream: samsung,spi-feedback-delay = <1> at 25 MHz */
+		controller-data {
+			samsung,spi-feedback-delay = <1>;
+		};
+
+		cs47l93_pins: pin-settings {
+			aif1-pins {
+				groups = "aif1";
+				function = "aif1";
+				bias-bus-hold;
+			};
+
+			gpio9-pins {
+				groups = "gpio9";
+				function = "io";
+				bias-disable;
+				drive-strength = <8>;
+			};
+
+			gpio10-pins {
+				groups = "gpio10";
+				function = "io";
+				bias-disable;
+				drive-strength = <8>;
+			};
+
+			aif3-pins {
+				groups = "aif3";
+				function = "aif3";
+				bias-bus-hold;
+			};
+		};
+
+		micvdd {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+		};
+	};
+};
+
+&usi17_i2c {
+	samsung,mode = <USI_MODE_I2C>;
+	status = "okay";
+};
+
+&hsi2c38 {
+	clock-frequency = <400000>;
+	pinctrl-0 = <&hsi2c38_bus &spk_amp_rst_n &rcv_amp_rst_n &amp_int>;
+	status = "okay";
+
+	/* Bottom speaker ("Right" in downstream mixer paths) */
+	cs35l40_r: audio-amplifier@40 {
+		compatible = "cirrus,cs35l40";
+		reg = <0x40>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "Right";
+
+		interrupts-extended = <&gpm24 0 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&gph1 1 GPIO_ACTIVE_HIGH>;
+
+		/*
+		 * The downstream driver never programs the boost
+		 * inductor/capacitor. The reset values (COEFF 0x2424,
+		 * SLOPE_LBST 0x7500) match LBST = 1.0 uH and CBST < 20 uF
+		 * in the mainline tables, so these values reproduce the
+		 * stock register state.
+		 */
+		cirrus,boost-type = <0>;		/* internal boost */
+		cirrus,boost-peak-milliamp = <4100>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+
+		/* downstream gpio-config2: src 0x4, output enabled */
+		cirrus,gpio2-src-select = <4>;	/* INT, push-pull, active low */
+		cirrus,gpio2-output-enable;
+
+		/*
+		 * DSP firmware (optional, only with "DSP1 Preload Switch"):
+		 * cirrus/cs35l41-dsp1-spk-prot-samsung-beyond2lte-right.{wmfw,bin}
+		 */
+		cirrus,subsystem-id = "samsung-beyond2lte";
+	};
+
+	/* Earpiece / receiver ("Left" in downstream mixer paths) */
+	cs35l40_l: audio-amplifier@41 {
+		compatible = "cirrus,cs35l40";
+		reg = <0x41>;
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "Left";
+
+		interrupts-extended = <&gpm24 0 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&gph1 2 GPIO_ACTIVE_HIGH>;
+
+		cirrus,boost-type = <0>;
+		cirrus,boost-peak-milliamp = <4100>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+
+		/* cirrus/cs35l41-dsp1-spk-prot-samsung-beyond2lte-left.* */
+		cirrus,subsystem-id = "samsung-beyond2lte";
+	};
+};
+
+/ {
+	sound: sound {
+		compatible = "samsung,beyond-madera";
+		model = "Samsung Galaxy S10";
+
+		clocks = <&pmu_system_controller 0>;	/* CLKOUT0 */
+		clock-names = "mclk";
+
+		samsung,audio-codec = <&cs47l93>;
+		samsung,audio-amplifiers = <&cs35l40_r &cs35l40_l>;
+		/* TDM RX slot per amplifier, same order as above */
+		samsung,amp-rx-slots = <1 0>;
+
+		/* ABOX UAIF0 -> codec AIF1, UAIF1 -> amplifiers (TDM) */
+		samsung,uaif-controllers = <&abox 0>, <&abox 1>;
+
+		samsung,audio-routing =
+			"DMIC1", "MICBIAS1A",
+			"IN3L", "DMIC1",
+			"DMIC2", "MICBIAS1B",
+			"IN4L", "DMIC2",
+			"HEADSETMIC", "MICBIAS2A",
+			"IN1BLN", "HEADSETMIC",
+			"IN1BLP", "HEADSETMIC",
+			"RECEIVER", "Left SPK",
+			"SPEAKER", "Right SPK",
+			"HEADPHONE", "HPOUT2L",
+			"HEADPHONE", "HPOUT2R";
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos9820-beyond-camera.dtsi b/arch/arm64/boot/dts/exynos/exynos9820-beyond-camera.dtsi
new file mode 100644
index 0000000000..5a2588570c
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9820-beyond-camera.dtsi
@@ -0,0 +1,995 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy S10 family: cameras.
+ *
+ * RAW capture through the CSIS write DMA (no ISP):
+ *   rear wide        S5K2L4  I2C_CAM0 0x10   CSIS0 (4 lanes)
+ *   rear ultra-wide  S5K3P9  I2C_CAM1 0x2d   CSIS1 (4 lanes)
+ *   front            S5K3J1  I2C_CAM2 0x10   CSIS2 (4 lanes), MIPI switch low
+ *   rear tele        S5K3M3  USI07_I2C 0x2d  CSIS2 (4 lanes), MIPI switch high
+ *   front depth      S5K4HA  USI07_I2C 0x10  CSIS3_1 (2 lanes)
+ * Lens actuators (AK7374): front on USI08_I2C 0x0c, rear wide and tele on
+ * I2C_CAM3 0x0c / 0x0f.
+ */
+
+/*
+ * "rotation": the raw frames of the rear cameras are upright after a
+ * clockwise turn by 90 degrees, those of the front cameras by 270 degrees.
+ * The property counts the other way round (it is the angle applications
+ * turn the picture by), hence rear = 270, front = 90.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/soc/samsung,exynos-usi.h>
+
+/ {
+	/*
+	 * Regulators of the S2MPB02 camera PMIC. The chip (hsi2c24, 0x59) is
+	 * bound by the flash LED driver; this node shares its regmap.
+	 * Voltages are the downstream ones (exynos9820-beyond2lte_common.dtsi).
+	 */
+	camera-regulators {
+		compatible = "samsung,s2mpb02-regulators";
+		samsung,pmic = <&{/soc@0/usi@109200c0/i2c@10920000/camera-pmic@59}>;
+
+		regulators {
+			/* always-on downstream; here only while a camera is on */
+			cam_buck1: buck1 {
+				regulator-name = "S2MPB02_BUCK1";
+				regulator-min-microvolt = <1300000>;
+				regulator-max-microvolt = <1300000>;
+			};
+
+			cam_buck2: buck2 {
+				regulator-name = "VDD_EXT_1P3_PB02";
+				regulator-min-microvolt = <1300000>;
+				regulator-max-microvolt = <1300000>;
+			};
+
+			/* always-on downstream, voltage left as programmed */
+			cam_bb: bb {
+				regulator-name = "S2MPB02_BB";
+				regulator-min-microvolt = <2600000>;
+				regulator-max-microvolt = <4000000>;
+			};
+
+			/* rear tele camera */
+			cam_ldo3: ldo3 {
+				regulator-name = "VDDD_1.05V_SUB";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1050000>;
+			};
+
+			cam_ldo7: ldo7 {
+				regulator-name = "VDDIO_1.8V_SUB";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			cam_ldo11: ldo11 {
+				regulator-name = "VDDA_2.8V_SUB";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			cam_ldo12: ldo12 {
+				regulator-name = "VDDAF_2.8V_SUB";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			cam_ldo4: ldo4 {
+				regulator-name = "VDDD_1.05V_WIDESUB";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1050000>;
+			};
+
+			cam_ldo8: ldo8 {
+				regulator-name = "VDDIO_1.8V_WIDESUB";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			cam_ldo15: ldo15 {
+				regulator-name = "VDDA_2.8V_WIDESUB";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			/* rear wide camera: lens-actuator common supply */
+			cam_ldo14: ldo14 {
+				regulator-name = "VDDAF_COMMON_CAM";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+
+			/* front camera */
+			cam_ldo5: ldo5 {
+				regulator-name = "VDDD_1.05V_VT";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1050000>;
+			};
+
+			cam_ldo6: ldo6 {
+				regulator-name = "VDDIO_1.8V_VT";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			cam_ldo13: ldo13 {
+				regulator-name = "VDDA_2.95V_VT";
+				regulator-min-microvolt = <2950000>;
+				regulator-max-microvolt = <2950000>;
+			};
+
+			cam_ldo16: ldo16 {
+				regulator-name = "VDDAF_2.8V_VT";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+	};
+};
+
+/*
+ * EL3 saves/restores D_TZPC_ISPPRE around a power cycle of the domain (the
+ * downstream need_smc address). Without it every ISPPRE register is
+ * secure-only after the boot-time power-off and the camera cannot work.
+ */
+&pd_isppre {
+	samsung,dtzpc-addr = <0x17010204>;
+};
+
+/* Supplies of the front depth camera (S2MPS19, off after boot) */
+&acpm_ipc {
+	pmic-1 {
+		regulators {
+			ldo23m: ldo23m {
+				regulator-name = "VDDD_1.2V_FRONTSUB";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			ldo24m: ldo24m {
+				regulator-name = "VDDA_2.8V_FRONTSUB";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			/* also the pull-ups of the USI07_I2C bus */
+			ldo25m: ldo25m {
+				regulator-name = "VDDIO_1.8V_FRONTSUB";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-ramp-delay = <12000>;
+			};
+		};
+	};
+};
