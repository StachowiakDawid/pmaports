diff --git a/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts b/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts
new file mode 100644
index 0000000000..6eab60b570
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts
@@ -0,0 +1,604 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy S10+ (beyond2lte/SM-G975F) device tree source
+ *
+ * Copyright (c) 2026 chiffathefox <chiffathefoxx@gmail.com>
+ */
+
+/dts-v1/;
+#include "exynos9820-common.dtsi"
+#include "exynos9820-beyond-audio.dtsi"
+#include "exynos9820-beyond-camera.dtsi"
+
+/ {
+	model = "Samsung Galaxy S10+ (SM-G975F)";
+	compatible = "samsung,beyond2lte", "samsung,exynos9820";
+	chassis-type = "handset";
+
+	chosen {
+		framebuffer0: framebuffer@ca000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
+			width = <1440>;
+			height = <3040>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+			panel = <&panel>;
+
+			/* Dummy panel for simple-framebuffer dimension info */
+			panel: dummy-panel {
+				width-mm = <70>;
+				height-mm = <147>;
+			};
+		};
+	};
+};
+
+&battery {
+	compatible = "simple-battery";
+	constant-charge-current-max-microamp = <2850000>;
+	/* EB-BG975ABU, 4100 mAh (downstream battery,battery_full_capacity) */
+	charge-full-design-microamp-hours = <4100000>;
+};
+
+&dsim0 {
+	status = "okay";
+
+	s6e3ha9: panel@0 {
+		compatible = "samsung,s6e3ha9";
+		reg = <0>;
+		/* downstream: disp-reset, gpa3-4, active low */
+		reset-gpios = <&gpa3 4 GPIO_ACTIVE_LOW>;
+		/*
+		 * vdd3/vci/vddr are S2DOS05 ldo1/ldo4/buck (downstream ddi-1p8 /
+		 * ddi-3p0 / ddr-1p6). They are not listed as panel supplies, so
+		 * the panel does not depend on the S2DOS05 driver; the
+		 * regulators are kept on instead (see &hsi2c44).
+		 */
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&decon0_out>;
+			};
+		};
+	};
+};
+
+/*
+ * DECON0 drives the panel set up by the bootloader. Without a DECON driver
+ * the bootloader framebuffer (simple-framebuffer) stays in use.
+ */
+&decon0 {
+	status = "okay";
+
+	port {
+		decon0_out: endpoint {
+			remote-endpoint = <&panel_in>;
+		};
+	};
+};
+
+/*
+ * The touch controller senses only while the panel drives its sync input:
+ * follow the panel (s6sy761 drm_panel_follower, ignored by older kernels).
+ */
+&touchscreen {
+	panel = <&s6e3ha9>;
+};
+
+&usi_cmgp2_i2c {
+	samsung,mode = <USI_MODE_I2C>;
+	status = "okay";
+};
+
+&hsi2c44 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/*
+	 * S2DOS05 display PMIC (downstream "s2dos05_pmic@60"). Only the
+	 * regulators that feed the panel are described, voltages from the
+	 * downstream DT. They are always-on: they have no consumers, and the
+	 * regulator core would otherwise switch them (and the panel) off
+	 * after boot.
+	 */
+	pmic@60 {
+		compatible = "samsung,s2dos05";
+		reg = <0x60>;
+
+		regulators {
+			disp_ldo1: ldo1 {
+				regulator-name = "disp_vdd3_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			disp_ldo4: ldo4 {
+				regulator-name = "disp_vci_3p0";
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			disp_buck: buck {
+				regulator-name = "disp_vddr_1p6";
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <1600000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+		};
+	};
+};
+
+/*
+ * Wi-Fi/BT: Broadcom BCM4375 (SEMCO/Murata module). Wi-Fi is on the GEN2
+ * PCIe root complex, Bluetooth on USI_PERIC1_UART_BT. GPIOs taken from
+ * Samsung's exynos9820-beyond2lte_common.dtsi / _eur_open_26.dts.
+ */
+/ {
+	aliases {
+		mmc0 = &mmc_2;
+		serial0 = &serial0;
+		serial1 = &serial_bt;
+	};
+
+	/* WLAN_REG_ON: powers the BCM4375 WLAN core */
+	reg_wlan_en: regulator-wlan-en {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan_en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpg0 5 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		/* Samsung waits 200 ms (WIFI_TURNON_DELAY) before link training */
+		startup-delay-us = <200000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en>;
+	};
+};
+
+&pcie_wifi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_clkreq &pcie0_perst &pcie_wake &wlan_host_wake>;
+	reset-gpios = <&gpf2 2 GPIO_ACTIVE_LOW>;
+	wlan-host-wake-gpios = <&gpa0 7 GPIO_ACTIVE_HIGH>;	/* WLAN_HOST_WAKE */
+	wake-gpios = <&gpa3 2 GPIO_ACTIVE_LOW>;			/* PCIe WAKE# */
+	vpcie3v3-supply = <&reg_wlan_en>;
+	status = "okay";
+};
+
+/* cluster 0 hardware watchdog */
+&watchdog_cl0 {
+	status = "okay";
+};
+
+&usi_uart_bt {
+	samsung,mode = <USI_MODE_UART>;
+	status = "okay";
+};
+
+&serial_bt {
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm4375-bt";
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_en &bt_wake &bt_hostwake>;
+		shutdown-gpios = <&gpm8 0 GPIO_ACTIVE_HIGH>;		/* BT_EN */
+		device-wakeup-gpios = <&gpg2 0 GPIO_ACTIVE_HIGH>;	/* BT_WAKE */
+		host-wakeup-gpios = <&gpa2 3 GPIO_ACTIVE_HIGH>;		/* BT_HOST_WAKE */
+		max-speed = <3000000>;
+	};
+};
+
+&pinctrl_alive {
+	/* WLAN_HOST_WAKE: the chip's wake line in D3 (s2idle wake, pcie_wifi) */
+	wlan_host_wake: wlan-host-wake-pins {
+		samsung,pins = "gpa0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	pcie_wake: pcie-wake-pins {
+		samsung,pins = "gpa3-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	bt_hostwake: bt-hostwake-pins {
+		samsung,pins = "gpa2-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	/* NFC_IRQ, driven by the chip (push-pull); pull-down while it is off */
+	nfc_int: nfc-int-pins {
+		samsung,pins = "gpa1-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	/* SD tray detect (downstream dwmmc2_cd_ext_irq), external pull-up */
+	sd2_cd: sd2-cd-pins {
+		samsung,pins = "gpa1-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_cmgp {
+	bt_en: bt-en-pins {
+		samsung,pins = "gpm8-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric0 {
+	/* DP AUX/SBU analog switch: downstream dp,aux_sw_oe (active low), dp,sbu_sw_sel */
+	dp_aux_oe: dp-aux-oe-pins {
+		samsung,pins = "gpg1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	dp_sbu_sel: dp-sbu-sel-pins {
+		samsung,pins = "gpg4-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	usbdp_port: usbdp-port-pins {
+		samsung,pins = "gpg0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+
+	wlan_en: wlan-en-pins {
+		samsung,pins = "gpg0-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV4>;
+		/*
+		 * Keep the level in power-down, as downstream (cfg_wlanen
+		 * pin-con-pdn = <3>). The reset CONPDN value (OUT0) would drive
+		 * the pad low in sleep and cut the BCM4375 off.
+		 */
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	bt_wake: bt-wake-pins {
+		samsung,pins = "gpg2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+/* which USB/DP combo PHY lane pair carries USB 3 (downstream phy,gpio_phy_port) */
+&usbdrd_phy {
+	pinctrl-names = "default";
+	pinctrl-0 = <&usbdp_port>;
+	samsung,usbdp-port-gpios = <&gpg0 4 GPIO_ACTIVE_HIGH>;
+};
+
+/*
+ * DisplayPort alt mode: combo PHY lane switch, DP controller (AUX/SBU switch,
+ * orientation) and DECON2 on the USB-C connector graph. The DP node is an
+ * orientation switch of the connector, so the Type-C port registers only
+ * once the DP driver has probed.
+ */
+&usbdrd_phy {
+	/* DP alt mode lane split (pin C/E: 4 DP lanes, D: 2) */
+	mode-switch;
+
+	port {
+		usbdrd_phy_ss_ep: endpoint {
+			remote-endpoint = <&usbc_ss_ep>;
+		};
+	};
+};
+
+&usbc_connector {
+	/* the DP DRM connector, for HPD (drm_connector_oob_hotplug_event) */
+	displayport = <&displayport>;
+};
+
+&usbc_ports {
+	port@1 {
+		reg = <1>;
+
+		usbc_ss_ep: endpoint {
+			remote-endpoint = <&usbdrd_phy_ss_ep>;
+		};
+	};
+
+	port@2 {
+		reg = <2>;
+
+		usbc_sbu_ep: endpoint {
+			remote-endpoint = <&dp_sbu_ep>;
+		};
+	};
+};
+
+&displayport {
+	pinctrl-names = "default";
+	pinctrl-0 = <&dp_aux_oe>, <&dp_sbu_sel>;
+	aux-enable-gpios = <&gpg1 6 GPIO_ACTIVE_LOW>;
+	sbu-select-gpios = <&gpg4 0 GPIO_ACTIVE_HIGH>;
+	/* downstream dp,usb_con_sel, shared with the combo PHY */
+	usb-dir-gpios = <&gpg0 4 GPIO_ACTIVE_HIGH>;
+	mode-switch;
+	orientation-switch;
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			dp_in: endpoint {
+				remote-endpoint = <&decon2_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			dp_sbu_ep: endpoint {
+				remote-endpoint = <&usbc_sbu_ep>;
+			};
+		};
+	};
+};
+
+&decon2 {
+	status = "okay";
+
+	port {
+		decon2_out: endpoint {
+			remote-endpoint = <&dp_in>;
+		};
+	};
+};
+
+&sound {
+	model = "Samsung Galaxy S10+";
+};
+
+/*
+ * microSD (hybrid SIM2/SD tray). Supplies from the downstream S2MPS19 DT:
+ * LDO15M "vmmc" (card VDD, 2.8 V fixed) and LDO2M "vqmmc" (I/O, 1.8-2.8 V,
+ * 1.8 V in the UHS-I modes).
+ */
+&acpm_ipc {
+	pmic-1 {
+		regulators {
+			ldo2m: ldo2m {
+				regulator-name = "sd_vqmmc";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+			};
+
+			/* VDD_NFC_1P8, NFC controller I/O supply (PVDD) */
+			ldo22m: ldo22m {
+				regulator-name = "vdd_nfc_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			ldo15m: ldo15m {
+				regulator-name = "sd_vmmc";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-ramp-delay = <12000>;
+			};
+		};
+	};
+};
+
+&mmc_2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &sd2_cd>;
+
+	bus-width = <4>;
+	card-detect-delay = <200>;
+	/* low = tray inserted (downstream: no card-detect-invert) */
+	cd-gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+	disable-wp;
+	/*
+	 * UHS-I SDR50/SDR104 (1.8 V signalling via vqmmc, tuned by the
+	 * exynos sample-phase search). max-frequency is slightly above
+	 * 200 MHz on purpose: the ciu divider rounds down, so 200 MHz would ask
+	 * for 800 MHz from PLL_MMC (806 MHz) and end up at /2 = 100 MHz; 202 MHz
+	 * asks for 808 MHz -> 806 MHz / 1 -> ~201.5 MHz card clock.
+	 */
+	cap-sd-highspeed;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	max-frequency = <202000000>;
+
+	vmmc-supply = <&ldo15m>;
+	vqmmc-supply = <&ldo2m>;
+
+	/* downstream <div fine-drv drv sample>: sdr <3 0 2 0>, ddr <3 0 2 1> */
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 2>;
+	samsung,dw-mshc-ddr-timing = <1 2>;
+
+	status = "okay";
+};
+
+/*
+ * Broadcom BCM4775x GNSS receiver + sensor hub (accelerometer, gyroscope,
+ * magnetometer, barometer, light/proximity behind it), "BCM4773@0" on spi_17
+ * in the downstream DT. Supply LDO21M "vdd_mcu_1p8" is off after boot here
+ * (downstream: always-on) and is switched by the driver.
+ *
+ * While the chip is unpowered no pin may drive it: the SPI bus pins and the
+ * chip select are therefore muxed by the hub device ("default" = inputs with
+ * pull-down, as the bootloader leaves them; "active" = SPI), not by the SPI
+ * controller, and the chip select is a GPIO of the hub driver.
+ */
+&acpm_ipc {
+	pmic-1 {
+		regulators {
+			ldo21m: ldo21m {
+				regulator-name = "vdd_mcu_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-ramp-delay = <12000>;
+			};
+		};
+	};
+};
+
+&pinctrl_alive {
+	shub_host_req: shub-host-req-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+};
+
+&pinctrl_peric0 {
+	shub_nstandby: shub-nstandby-pins {
+		samsung,pins = "gpg0-2";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	shub_handshake_idle: shub-handshake-idle-pins {
+		samsung,pins = "gpg4-1", "gpg4-2";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	shub_handshake_active: shub-handshake-active-pins {
+		samsung,pins = "gpg4-1", "gpg4-2";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric1 {
+	shub_bus_idle: shub-bus-idle-pins {
+		samsung,pins = "gph0-2", "gph0-1", "gph0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	shub_cs_idle: shub-cs-idle-pins {
+		samsung,pins = "gph0-3";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	shub_cs_active: shub-cs-active-pins {
+		samsung,pins = "gph0-3";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&usi16 {
+	samsung,mode = <USI_MODE_SPI>;
+	status = "okay";
+};
+
+&spi17 {
+	status = "okay";
+
+	sensorhub@0 {
+		compatible = "brcm,bcm47752";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		spi-cpol;
+		spi-cpha;
+
+		vdd-supply = <&ldo21m>;
+
+		/* downstream: ssp-gps-pwr-en (lhd.conf: GpioNStdbyPath) */
+		nstandby-gpios = <&gpg0 2 GPIO_ACTIVE_HIGH>;
+		mcu-req-gpios = <&gpg4 1 GPIO_ACTIVE_HIGH>;
+		mcu-resp-gpios = <&gpg4 2 GPIO_ACTIVE_HIGH>;
+		host-req-gpios = <&gpa1 7 GPIO_ACTIVE_HIGH>;
+		ssi-cs-gpios = <&gph0 3 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default", "active";
+		pinctrl-0 = <&shub_bus_idle &shub_cs_idle &shub_handshake_idle
+			     &shub_nstandby &shub_host_req>;
+		pinctrl-1 = <&spi17_bus &shub_cs_active &shub_handshake_active
+			     &shub_nstandby &shub_host_req>;
+	};
+};
+
+/*
+ * NFC: Samsung S3NRN82 on USI08 ("hsi2c_20" downstream), address 0x27.
+ * Downstream rev 19+ board (eur_open_26): VEN gpp6-2 (high = chip in
+ * reset), FIRM/WAKE gpp6-3, IRQ gpa1-2 (rising), CLK_REQ gpa2-6 (not used:
+ * the driver runs the clock whenever the chip is out of reset), clock
+ * PMU CLKOUT1 (TCXO 26 MHz, "OSC_NFC"), PVDD = LDO22M.
+ * The eSE (spi_7, gpp4-3, LDO28M) is not described and stays untouched.
+ */
+&usi8 {
+	samsung,mode = <USI_MODE_I2C>;
+	status = "okay";
+};
+
+&hsi2c20 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	nfc@27 {
+		compatible = "samsung,s3fwrn5-i2c";
+		reg = <0x27>;
+
+		interrupts-extended = <&gpa1 2 IRQ_TYPE_EDGE_RISING>;
+		en-gpios = <&gpp6 2 GPIO_ACTIVE_HIGH>;
+		wake-gpios = <&gpp6 3 GPIO_ACTIVE_HIGH>;
+		clocks = <&pmu_system_controller 1>;
+		vdd-supply = <&ldo22m>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&nfc_en &nfc_firm &nfc_int>;
+	};
+};
+
+&pinctrl_peric1 {
+	/* keep the levels in power-down (downstream con-pdn = PREV) */
+	nfc_en: nfc-en-pins {
+		samsung,pins = "gpp6-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	nfc_firm: nfc-firm-pins {
+		samsung,pins = "gpp6-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+/*
+ * Cellular processor boot. The CP image carries its own memory map (MEM0
+ * table in the BOOT section of the radio partition): IPC region at
+ * +0xb200000, 5 MiB.
+ * Revision straps as downstream mif_pdata: CP_REV0..3, then HW_REV0..3.
+ */
+&cp_boot {
+	memory-region = <&modem_if>;
+	samsung,ipc-offset = <0xb200000>;
+	samsung,ipc-size = <0x500000>;
+	samsung,rev-gpios = <&gpg3 4 GPIO_ACTIVE_HIGH>, <&gpg3 3 GPIO_ACTIVE_HIGH>,
+			    <&gpg3 2 GPIO_ACTIVE_HIGH>, <&gpg3 1 GPIO_ACTIVE_HIGH>,
+			    <&gpg1 5 GPIO_ACTIVE_HIGH>, <&gpg1 4 GPIO_ACTIVE_HIGH>,
+			    <&gpg1 3 GPIO_ACTIVE_HIGH>, <&gpg1 2 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos9820-common.dtsi b/arch/arm64/boot/dts/exynos/exynos9820-common.dtsi
new file mode 100644
index 0000000000..70a0e998b2
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9820-common.dtsi
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Device tree source common to beyond EXYNOS9820 devices
+ *
+ * Copyright (c) 2026 chiffathefox <chiffathefoxx@gmail.com>
+ */
+
+/dts-v1/;
+#include "exynos9820.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/soc/samsung,exynos-usi.h>
+
+/ {
+	battery: battery {
+		compatible = "simple-battery";
+		over-voltage-threshold-microvolt = <4500000>;
+		voltage-min-design-microvolt = <3480000>;
+		voltage-max-design-microvolt = <4350000>;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+		stdout-path = &serial0;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_volup &key_voldown &key_wink &key_power>;
+		pinctrl-names = "default";
+
+		key-volup {
+			label = "Volume Up Key";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+		};
+
+		key-voldown {
+			label = "Volume Down Key";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
+		};
+
+		key-wink {
+			label = "Wink Key";
+			linux,code = <KEY_COFFEE>;
+			gpios = <&gpa0 6 GPIO_ACTIVE_LOW>;
+		};
+
+		key-power {
+			label = "Power Key";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		sec_debug_magic@80000000 {
+			reg = <0x0 0x80000000 0x1000>;
+			no-map;
+		};
+
+		kaslr_seed@80001000 {
+			reg = <0x0 0x80001000 0x1000>;
+			no-map;
+		};
+
+		el2_code@87000000 {
+			reg = <0x0 0x87000000 0x200000>;
+			no-map;
+		};
+
+		mm_debug@91200000 {
+			reg = <0x0 0x91200000 0x1000>;
+			no-map;
+		};
+
+		secure_camera@96000000 {
+			reg = <0x0 0x96000000 0x2200000>;
+			no-map;
+		};
+
+		seclog_mem@c0000000 {
+			reg = <0x0 0xc0000000 0x80000>;
+			no-map;
+		};
+
+		framebuffer_region@ca000000 {
+			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
+			no-map;
+		};
+
+		modem_spare@d0000000 {
+			reg = <0x0 0xd0000000 0x1600000>;
+			no-map;
+		};
+
+		modem_if: modem_if@f0000000 {
+			reg = <0x0 0xf0000000 0xb900000>;
+			no-map;
+		};
+
+		cp_ram_logging@fb900000 {
+			reg = <0x0 0xfb900000 0x2000000>;
+			no-map;
+		};
+
+		/*
+		 * pstore/ramoops in the "log_kernel" buffer of Samsung's
+		 * debug-snapshot area (0xfd900000 + 64 KiB header), which the
+		 * stock bootloader preserves across a warm or manual
+		 * (Power + Volume Down) reset. The header is left alone.
+		 */
+		ramoops@fd910000 {
+			compatible = "ramoops";
+			reg = <0x0 0xfd910000 0x200000>;
+			record-size = <0x40000>;
+			console-size = <0x100000>;
+			pmsg-size = <0x40000>;
+			no-map;
+		};
+
+		el2_earlymem@9fd800000 {
+			reg = <0x9 0xfd800000 0x2800000>;
+			no-map;
+		};
+	};
+
+	/* TODO: Implement PMIC */
+	reg_dummy: regulator-0 {
+		compatible = "regulator-fixed";
+		regulator-name = "dummy_reg";
+	};
+
+	vib_regulator: gpio-regulator {
+		compatible = "regulator-fixed";
+
+		regulator-name = "haptic";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		gpio = <&gpg1 7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		regulator-boot-on;
+	};
+};
+
+&acpm_ipc {
+	pmic-1 {
+		compatible = "samsung,s2mps19-pmic";
+		interrupts-extended = <&gpa0 1 IRQ_TYPE_LEVEL_LOW>;
+		wakeup-source;
+
+		regulators {
+			ldo19m: ldo19m {
+				regulator-name = "tsp_io";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+			};
+
+			ldo27m: ldo27m {
+				regulator-name = "tsp_avdd";
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+				regulator-boot-on;
+			};
+		};
+	};
+};
+
+&hsi2c10 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen: touchscreen@48 {
+		compatible = "samsung,s6sy761";
+		reg = <0x48>;
+
+		avdd-supply = <&ldo27m>;
+		vdd-supply = <&ldo19m>;
+
+		interrupts-extended = <&gpa1 0 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&ts_int>;
+		pinctrl-names = "default";
+	};
+};
+
+/* Camera PMIC with the rear flash LED driver ("hsi2c_24" downstream) */
+&hsi2c24 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	camera-pmic@59 {
+		compatible = "samsung,s2mpb02";
+		reg = <0x59>;
+
+		/* TORCH and FLASH inputs of the flash LED block */
+		torch-gpios = <&gpg2 4 GPIO_ACTIVE_HIGH>;
+		flash-gpios = <&gpg3 6 GPIO_ACTIVE_HIGH>;
+
+		led {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			/* downstream: torch 240 mA, flash 1250 mA / 500 ms */
+			led-max-microamp = <240000>;
+			flash-max-microamp = <1250000>;
+			flash-max-timeout-us = <500000>;
+		};
+	};
+};
+
+&hsi2c45 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	fuel-gauge@36 {
+		reg = <0x36>;
+		compatible = "maxim,max77705-battery";
+		power-supplies = <&max77705_charger>;
+		maxim,rsns-microohm = <5000>;
+		interrupt-parent = <&max77705>;
+		interrupts = <2>;
+	};
+
+	max77705: pmic@66 {
+		compatible = "maxim,max77705";
+		reg = <0x66>;
+
+		interrupts-extended = <&gpa1 6 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		pinctrl-0 = <&pmic_int>;
+		pinctrl-names = "default";
+
+		haptic {
+			compatible = "maxim,max77705-haptic";
+			haptic-supply = <&vib_regulator>;
+			pwms = <&pwm 1 48828 0>;
+		};
+
+		/*
+		 * Notification LED. Downstream leds-max77705-rgb channel order:
+		 * LED0 unused (white), LED1 red, LED2 green, LED3 blue.
+		 */
+		leds {
+			compatible = "maxim,max77705-rgb";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			multi-led@0 {
+				reg = <0>;
+				color = <LED_COLOR_ID_RGB>;
+				function = LED_FUNCTION_STATUS;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				led@1 {
+					reg = <1>;
+					color = <LED_COLOR_ID_RED>;
+				};
+
+				led@2 {
+					reg = <2>;
+					color = <LED_COLOR_ID_GREEN>;
+				};
+
+				led@3 {
+					reg = <3>;
+					color = <LED_COLOR_ID_BLUE>;
+				};
+			};
+		};
