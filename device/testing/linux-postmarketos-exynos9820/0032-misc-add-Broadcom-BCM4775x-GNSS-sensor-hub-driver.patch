From 7be1e3bc53067c0213698c64e7b0e0b437ee82e0 Mon Sep 17 00:00:00 2001
From: StachowiakDawid <dawidos234@gmail.com>
Date: Mon, 23 Nov 2026 18:38:09 +0100
Subject: [PATCH] misc: add Broadcom BCM4775x GNSS/sensor hub driver

SPI link layer ("SSI") and power control for the Broadcom BCM4775x
combined GNSS receiver and sensor hub of the Galaxy S10 family. The
byte stream is exposed as /dev/bcm4775x; the boot ROM
dialogue, firmware download and the protocols above are left to user
space. The driver can also run the sensor hub itself and then provides
the sensors behind it as IIO devices, the magnetometer with a buffer
and a compass heading (magn_hard_iron / magn_soft_iron correction
parameters). The hub is powered off after 60 s without a reader.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 drivers/misc/Kconfig    |   19 +
 drivers/misc/Makefile   |    1 +
 drivers/misc/bcm4775x.c | 2726 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 2746 insertions(+)
 create mode 100644 drivers/misc/bcm4775x.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index c40e89cc57..8241fa450d 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -583,6 +583,25 @@ config TC9564_PCI
 	  quirk causes the ranges property in the endpoint's devicetree
 	  node to be updated dynamically.
 
+config BCM4775X
+	tristate "Broadcom BCM4775x GNSS/sensor hub SPI link"
+	depends on SPI && OF && IIO
+	select FW_LOADER
+	select IIO_BUFFER
+	select IIO_KFIFO_BUF
+	help
+	  SPI link layer ("SSI") and power control for the Broadcom BCM4775x
+	  combined GNSS receiver and sensor hub found in the Samsung Galaxy
+	  S10 family. The byte stream is exposed as /dev/bcm4775x; the boot
+	  ROM dialogue, firmware download and the protocols above are left
+	  to user space. The driver can also run the sensor hub itself
+	  (firmware brcm/bcm4775x-sensorhub.bin) and then provides the
+	  sensors behind it as IIO devices, the magnetometer with a buffer
+	  and a compass heading.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called bcm4775x.
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
