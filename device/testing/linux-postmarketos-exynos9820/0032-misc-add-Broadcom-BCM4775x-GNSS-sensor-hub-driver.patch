+static bool hub_decode_3x16(struct hub_sensor *s, const u8 *d)
+{
+	s->val[0] = (s16)get_unaligned_le16(d);
+	s->val[1] = (s16)get_unaligned_le16(d + 2);
+	s->val[2] = (s16)get_unaligned_le16(d + 4);
+	return true;
+}
+
+static bool hub_decode_3x32(struct hub_sensor *s, const u8 *d)
+{
+	s->val[0] = (s32)get_unaligned_le32(d);
+	s->val[1] = (s32)get_unaligned_le32(d + 4);
+	s->val[2] = (s32)get_unaligned_le32(d + 8);
+	return true;
+}
+
+/* s32 pressure, s16 temperature */
+static bool hub_decode_pressure(struct hub_sensor *s, const u8 *d)
+{
+	s->val[0] = (s32)get_unaligned_le32(d);
+	s->val[1] = (s16)get_unaligned_le16(d + 4);
+	return true;
+}
+
+/* u32 lux, s32 cct, u16 r, g, b, w, gain, integration time, u8 brightness */
+static bool hub_decode_light(struct hub_sensor *s, const u8 *d)
+{
+	s->val[0] = get_unaligned_le32(d);
+	s->val[1] = get_unaligned_le16(d + 8);
+	s->val[2] = get_unaligned_le16(d + 10);
+	s->val[3] = get_unaligned_le16(d + 12);
+	s->val[4] = get_unaligned_le16(d + 14);
+	return true;
+}
+
+/* raw proximity: u16 ADC count; 0xffff until the first conversion is done */
+static bool hub_decode_prox(struct hub_sensor *s, const u8 *d)
+{
+	if (get_unaligned_le16(d) == 0xffff)
+		return false;
+	s->val[0] = get_unaligned_le16(d);
+	return true;
+}
+
+static const struct hub_sensor_desc hub_sensors[HUB_NUM_SENSORS] = {
+	{ "bcm4775x-accel", 0, -1, 6, 50, hub_decode_3x16,
+	  hub_accel_channels, ARRAY_SIZE(hub_accel_channels) },
+	{ "bcm4775x-gyro", 1, -1, 12, 50, hub_decode_3x32,
+	  hub_gyro_channels, ARRAY_SIZE(hub_gyro_channels) },
+	/*
+	 * Raw magnetometer. The hub's calibrated type 4 is the raw value
+	 * times 2.5 until its own calibration has run, and reads zero once
+	 * the vendor's "PDC" matrix has been set, so it is not used.
+	 */
+	{ "bcm4775x-magn", 3, -1, 6, 100, hub_decode_3x16,
+	  hub_magn_channels, ARRAY_SIZE(hub_magn_channels) },
+	{ "bcm4775x-pressure", 5, -1, 6, 200, hub_decode_pressure,
+	  hub_pressure_channels, ARRAY_SIZE(hub_pressure_channels) },
+	/* the hub reports light only when the values change */
+	{ "bcm4775x-light", 9, -1, 21, 200, hub_decode_light,
+	  hub_light_channels, ARRAY_SIZE(hub_light_channels) },
+	/*
+	 * The proximity sensor proper (type 7) only sends near/far events;
+	 * while it runs, the raw type 10 delivers the ADC count continuously.
+	 */
+	{ "bcm4775x-proximity", 10, 7, 2, 100, hub_decode_prox,
+	  hub_prox_channels, ARRAY_SIZE(hub_prox_channels) },
+};
+
+/* Payload sizes of bypass data the hub may send that we do not expose */
+static unsigned int hub_bypass_size(u8 type)
+{
+	int i;
+
+	for (i = 0; i < HUB_NUM_SENSORS; i++)
+		if (hub_sensors[i].type == type)
+			return hub_sensors[i].size;
+	switch (type) {
+	case 2:		/* uncalibrated magnetometer */
+		return 13;
+	case 4:		/* calibrated magnetometer */
+		return 8;
+	case 7:		/* proximity event: state, ADC count, 4 more bytes */
+		return 7;
+	}
+	return 0;
+}
+
+/* Low pass for the heading: 1/4 of each new sample (0.35 s at 10 Hz) */
+static void hub_filter(struct hub_sensor *s)
+{
+	int i, v;
+
+	for (i = 0; i < 3; i++) {
+		v = s->val[i] * (1 << HUB_FILTER_SHIFT);
+		if (s->filt_valid)
+			s->filt[i] += (v - s->filt[i]) / 4;
+		else
+			s->filt[i] = v;
+	}
+	s->filt_valid = true;
+}
+
+static void hub_magn_push(struct bcm4775x_hub *hub, struct hub_sensor *s)
+{
+	hub->scan.magn[0] = s->val[0];
+	hub->scan.magn[1] = s->val[1];
+	hub->scan.magn[2] = s->val[2];
+	hub->scan.heading = hub_heading(hub);
+	iio_push_to_buffers_with_ts(s->indio, &hub->scan, sizeof(hub->scan),
+				    iio_get_time_ns(s->indio));
+}
+
+static void hub_bypass_data(struct bcm4775x_hub *hub, u8 type, const u8 *d)
+{
+	int i;
+
+	for (i = 0; i < HUB_NUM_SENSORS; i++) {
+		struct hub_sensor *s = &hub->sensor[i];
+
+		if (hub_sensors[i].type != type)
+			continue;
+		if (!hub_sensors[i].decode(s, d))
+			continue;
+		if (i == HUB_ACCEL || i == HUB_MAGN)
+			hub_filter(s);
+		if (i == HUB_MAGN && iio_buffer_enabled(s->indio))
+			hub_magn_push(hub, s);
+		complete(&s->fresh);
+	}
+}
+
+/* The magnetometer buffer holds the heading too: that needs the accelerometer */
+static const u8 hub_magn_buffer_sensors[] = { HUB_ACCEL, HUB_MAGN };
+
+static int hub_magn_postenable(struct iio_dev *indio)
+{
+	struct hub_iio *hi = iio_priv(indio);
+
+	return hub_hold(hi->priv, hub_magn_buffer_sensors,
+			ARRAY_SIZE(hub_magn_buffer_sensors));
+}
+
+static int hub_magn_predisable(struct iio_dev *indio)
+{
+	struct hub_iio *hi = iio_priv(indio);
+
+	hub_release(hi->priv, hub_magn_buffer_sensors,
+		    ARRAY_SIZE(hub_magn_buffer_sensors));
+	return 0;
+}
+
+static const struct iio_buffer_setup_ops hub_magn_buffer_ops = {
+	.postenable = hub_magn_postenable,
+	.predisable = hub_magn_predisable,
+};
+
+static const struct iio_info hub_iio_info = {
+	.read_raw = hub_read_raw,
+};
+
+static int bcm4775x_hub_probe(struct bcm4775x *priv)
+{
+	struct device *dev = &priv->spi->dev;
+	struct bcm4775x_hub *hub;
+	struct hub_iio *hi;
+	int ret, i;
+
+	hub = devm_kzalloc(dev, sizeof(*hub), GFP_KERNEL);
+	if (!hub)
+		return -ENOMEM;
+	hub->priv = priv;
+	mutex_init(&hub->lock);
+	mutex_init(&hub->tl_lock);
+	init_completion(&hub->rel_done);
+	init_completion(&hub->sync_done);
+	init_completion(&hub->version_done);
+	init_completion(&hub->ssp_done);
+	init_completion(&hub->init_done);
+	INIT_DELAYED_WORK(&hub->idle_work, hub_idle_work);
+	INIT_DELAYED_WORK(&hub->restart_work, hub_restart_work);
+
+	/*
+	 * The hub reports Android axes (upright portrait: +y, face up: +z).
+	 * IIO user space (iio-sensor-proxy) wants x and y the other way round,
+	 * so without a mount-matrix in the DT rotate by 180 degrees around z.
+	 */
+	if (device_property_present(dev, "mount-matrix")) {
+		ret = iio_read_mount_matrix(dev, &hub->orientation);
+		if (ret)
+			return ret;
+	} else {
+		static const char * const rot180[9] = {
+			"-1", "0", "0", "0", "-1", "0", "0", "0", "1"
+		};
+
+		memcpy(hub->orientation.rotation, rot180, sizeof(rot180));
+	}
+	priv->hub = hub;
+
+	for (i = 0; i < HUB_NUM_SENSORS; i++) {
+		struct hub_sensor *s = &hub->sensor[i];
+
+		s->desc = &hub_sensors[i];
+		init_completion(&s->fresh);
+		s->indio = devm_iio_device_alloc(dev, sizeof(*hi));
+		if (!s->indio) {
+			ret = -ENOMEM;
+			goto err;
+		}
+		hi = iio_priv(s->indio);
+		hi->priv = priv;
+		hi->index = i;
+		s->indio->name = s->desc->name;
+		s->indio->info = &hub_iio_info;
+		s->indio->modes = INDIO_DIRECT_MODE;
+		s->indio->channels = s->desc->channels;
+		s->indio->num_channels = s->desc->num_channels;
+		if (i == HUB_MAGN) {
+			s->indio->available_scan_masks = hub_magn_scan_masks;
+			ret = devm_iio_kfifo_buffer_setup(dev, s->indio,
+							  &hub_magn_buffer_ops);
+			if (ret)
+				goto err;
+		}
+		ret = iio_device_register(s->indio);
+		if (ret)
+			goto err;
+	}
+	return 0;
+
+err:
+	while (--i >= 0)
+		iio_device_unregister(hub->sensor[i].indio);
+	return ret;
+}
+
+static void bcm4775x_hub_remove(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int i;
+
+	for (i = 0; i < HUB_NUM_SENSORS; i++)
+		iio_device_unregister(hub->sensor[i].indio);
+	mutex_lock(&hub->lock);
+	hub->suspending = true;		/* no restart from here on */
+	mutex_unlock(&hub->lock);
+	cancel_delayed_work_sync(&hub->restart_work);
+	cancel_delayed_work_sync(&hub->idle_work);
+	mutex_lock(&hub->lock);
+	hub_stop(priv);
+	mutex_unlock(&hub->lock);
+}
+
+/*
+ * System sleep: the hub loses power and is started again by the next reader,
+ * or after resume if a buffer is enabled.
+ */
+static void bcm4775x_hub_suspend(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+
+	mutex_lock(&hub->lock);
+	hub->suspending = true;
+	mutex_unlock(&hub->lock);
+	cancel_delayed_work_sync(&hub->restart_work);
+	cancel_delayed_work_sync(&hub->idle_work);
+	mutex_lock(&hub->lock);
+	hub_stop(priv);
+	mutex_unlock(&hub->lock);
+}
+
+static void bcm4775x_hub_resume(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+
+	mutex_lock(&hub->lock);
+	hub->suspending = false;
+	if (hub_kept(hub))
+		schedule_delayed_work(&hub->restart_work, HZ / 2);
+	mutex_unlock(&hub->lock);
+}
+
+/* --- character device --------------------------------------------------- */
+
+static struct bcm4775x *to_bcm4775x(struct file *file)
+{
+	return container_of(file->private_data, struct bcm4775x, misc);
+}
+
+static int bcm4775x_open(struct inode *inode, struct file *file)
+{
+	struct bcm4775x *priv = to_bcm4775x(file);
+	int ret = 0;
+
+	mutex_lock(&priv->lock);
+	if (priv->opened) {
+		ret = -EBUSY;
+	} else {
+		priv->opened = true;
+		bcm4775x_irq_enable(priv, true);
+	}
+	mutex_unlock(&priv->lock);
+	return ret ? ret : nonseekable_open(inode, file);
+}
+
+static int bcm4775x_release(struct inode *inode, struct file *file)
+{
+	struct bcm4775x *priv = to_bcm4775x(file);
+
+	mutex_lock(&priv->lock);
+	bcm4775x_irq_enable(priv, false);
+	priv->opened = false;
+	mutex_unlock(&priv->lock);
+	return 0;
+}
+
+static ssize_t bcm4775x_read(struct file *file, char __user *buf, size_t count,
+			     loff_t *ppos)
+{
+	struct bcm4775x *priv = to_bcm4775x(file);
+	unsigned int copied = 0;
+	bool was_full;
+	int ret;
+
+	if (!count)
+		return 0;
+
+	while (kfifo_is_empty(&priv->rx_fifo)) {
+		if (!priv->powered)
+			return -ENODEV;
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		ret = wait_event_interruptible(priv->wait,
+					       !kfifo_is_empty(&priv->rx_fifo) ||
+					       !priv->powered);
+		if (ret)
+			return ret;
+	}
+
+	ret = mutex_lock_interruptible(&priv->rx_lock);
+	if (ret)
+		return ret;
+	was_full = kfifo_avail(&priv->rx_fifo) < SSI_MIN_FRAME;
+	ret = kfifo_to_user(&priv->rx_fifo, buf, count, &copied);
+	mutex_unlock(&priv->rx_lock);
+	if (ret)
+		return ret;
+
+	/* the work stopped receiving while the buffer was full */
+	if (was_full && priv->powered)
+		bcm4775x_kick(priv);
+	return copied;
+}
+
+static ssize_t bcm4775x_write(struct file *file, const char __user *buf,
+			      size_t count, loff_t *ppos)
+{
+	struct bcm4775x *priv = to_bcm4775x(file);
+	unsigned int copied = 0;
+	size_t done = 0;
+	int ret;
+
+	ret = mutex_lock_interruptible(&priv->tx_lock);
+	if (ret)
+		return ret;
+
+	while (done < count) {
+		if (!priv->powered) {
+			ret = -ENODEV;
+			break;
+		}
+		if (kfifo_is_full(&priv->tx_fifo)) {
+			if (file->f_flags & O_NONBLOCK) {
+				ret = -EAGAIN;
+				break;
+			}
+			ret = wait_event_interruptible(priv->wait,
+						       !kfifo_is_full(&priv->tx_fifo) ||
+						       !priv->powered);
+			if (ret)
+				break;
+			continue;
+		}
+		ret = kfifo_from_user(&priv->tx_fifo, buf + done, count - done,
+				      &copied);
+		if (ret)
+			break;
+		done += copied;
+		bcm4775x_kick(priv);
+	}
+	mutex_unlock(&priv->tx_lock);
+
+	return done ? done : ret;
+}
+
+static __poll_t bcm4775x_poll(struct file *file, poll_table *wait)
+{
+	struct bcm4775x *priv = to_bcm4775x(file);
+	__poll_t mask = 0;
+
+	poll_wait(file, &priv->wait, wait);
+	if (!kfifo_is_empty(&priv->rx_fifo))
+		mask |= EPOLLIN | EPOLLRDNORM;
+	if (!kfifo_is_full(&priv->tx_fifo))
+		mask |= EPOLLOUT | EPOLLWRNORM;
+	if (!priv->powered)
+		mask |= EPOLLHUP;
+	if (priv->link_error)
+		mask |= EPOLLERR;
+	return mask;
+}
+
+static const struct file_operations bcm4775x_fops = {
+	.owner		= THIS_MODULE,
+	.open		= bcm4775x_open,
+	.release	= bcm4775x_release,
+	.read		= bcm4775x_read,
+	.write		= bcm4775x_write,
+	.poll		= bcm4775x_poll,
+};
+
+/* --- sysfs --------------------------------------------------------------- */
+
+static ssize_t chip_power_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", priv->powered);
+}
+
+static ssize_t chip_power_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->lock);
+	if (on)
+		ret = bcm4775x_power_on(priv);
+	else
+		bcm4775x_power_off(priv);
+	mutex_unlock(&priv->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(chip_power);
+
+static ssize_t bcm4775x_gpio_show(struct bcm4775x *priv, struct gpio_desc *gpio,
+				  char *buf)
+{
+	return sysfs_emit(buf, "%d\n", gpiod_get_value_cansleep(gpio));
+}
+
+static ssize_t bcm4775x_gpio_store(struct bcm4775x *priv,
+				   struct gpio_desc *gpio, const char *buf,
+				   size_t count)
+{
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->lock);
+	if (priv->powered) {
+		mutex_lock(&priv->io_lock);
+		gpiod_set_value_cansleep(gpio, on);
+		mutex_unlock(&priv->io_lock);
+	} else {
+		ret = -ENODEV;
+	}
+	mutex_unlock(&priv->lock);
+	return ret ? ret : count;
+}
+
+static ssize_t nstandby_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return bcm4775x_gpio_show(priv, priv->nstandby, buf);
+}
+
+static ssize_t nstandby_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return bcm4775x_gpio_store(priv, priv->nstandby, buf, count);
+}
+static DEVICE_ATTR_RW(nstandby);
+
+static ssize_t mcu_req_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return bcm4775x_gpio_show(priv, priv->mcu_req, buf);
+}
+
+static ssize_t mcu_req_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return bcm4775x_gpio_store(priv, priv->mcu_req, buf, count);
+}
+static DEVICE_ATTR_RW(mcu_req);
+
+static ssize_t mcu_resp_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return bcm4775x_gpio_show(priv, priv->mcu_resp, buf);
+}
+static DEVICE_ATTR_RO(mcu_resp);
+
+static ssize_t host_req_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return bcm4775x_gpio_show(priv, priv->host_req, buf);
+}
+static DEVICE_ATTR_RO(host_req);
+
+/* MCU_REQ/MCU_RESP handshake only, no SPI traffic */
+static ssize_t hello_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&priv->lock);
+	if (!priv->powered) {
+		mutex_unlock(&priv->lock);
+		return -ENODEV;
+	}
+	mutex_lock(&priv->io_lock);
+	ret = bcm4775x_hello(priv);
+	bcm4775x_bye(priv);
+	mutex_unlock(&priv->io_lock);
+	mutex_unlock(&priv->lock);
+
+	if (ret < 0)
+		return sysfs_emit(buf, "timeout\n");
+	return sysfs_emit(buf, "ok %d ms\n", ret);
+}
+static DEVICE_ATTR_RO(hello);
+
+static const unsigned int ssi_blk_size[] = { 32, 256, 2048, 16384 };
+
+static ssize_t stats_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf,
+			  "tx_bytes %lu\nrx_bytes %lu\ntx_frames %lu\nrx_frames %lu\n"
+			  "fc_retries %lu\nfc_errors %lu\nhello_fail %lu\n"
+			  "spi_errors %lu\nrx_dropped %lu\nparity_errors %lu\n"
+			  "last_status 0x%02x\nrx_room %u\nlink_error %d\n",
+			  priv->tx_bytes, priv->rx_bytes, priv->tx_frames,
+			  priv->rx_frames, priv->fc_retries, priv->fc_errors,
+			  priv->hello_fail, priv->spi_errors, priv->rx_dropped,
+			  priv->parity_errors, priv->last_status,
+			  ssi_blk_size[(priv->last_status & SSI_STAT_SZE_MASK) >>
+				       SSI_STAT_SZE_SHIFT] *
+				(priv->last_status & SSI_STAT_CNT_MASK),
+			  priv->link_error);
+}
+static DEVICE_ATTR_RO(stats);
+
+static struct attribute *bcm4775x_attrs[] = {
+	&dev_attr_chip_power.attr,
+	&dev_attr_nstandby.attr,
+	&dev_attr_mcu_req.attr,
+	&dev_attr_mcu_resp.attr,
+	&dev_attr_host_req.attr,
+	&dev_attr_hello.attr,
+	&dev_attr_stats.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(bcm4775x);
+
+/* --- driver -------------------------------------------------------------- */
+
+static int bcm4775x_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct bcm4775x *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->spi = spi;
+	mutex_init(&priv->lock);
+	mutex_init(&priv->io_lock);
+	mutex_init(&priv->rx_lock);
+	mutex_init(&priv->tx_lock);
+	init_waitqueue_head(&priv->wait);
+	spin_lock_init(&priv->irq_lock);
+	INIT_WORK(&priv->work, bcm4775x_work);
+
+	priv->tx_buf = devm_kmalloc(dev, SSI_MAX_FRAME + 8, GFP_KERNEL);
+	priv->rx_buf = devm_kmalloc(dev, SSI_MAX_FRAME + 8, GFP_KERNEL);
+	if (!priv->tx_buf || !priv->rx_buf)
+		return -ENOMEM;
+
+	priv->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(priv->vdd))
+		return dev_err_probe(dev, PTR_ERR(priv->vdd), "vdd supply\n");
+
+	/* everything low or high-Z until the chip is powered */
+	priv->nstandby = devm_gpiod_get(dev, "nstandby", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->nstandby))
+		return dev_err_probe(dev, PTR_ERR(priv->nstandby), "nstandby gpio\n");
+	priv->mcu_req = devm_gpiod_get(dev, "mcu-req", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->mcu_req))
+		return dev_err_probe(dev, PTR_ERR(priv->mcu_req), "mcu-req gpio\n");
+	priv->mcu_resp = devm_gpiod_get(dev, "mcu-resp", GPIOD_IN);
+	if (IS_ERR(priv->mcu_resp))
+		return dev_err_probe(dev, PTR_ERR(priv->mcu_resp), "mcu-resp gpio\n");
+	priv->host_req = devm_gpiod_get(dev, "host-req", GPIOD_IN);
+	if (IS_ERR(priv->host_req))
+		return dev_err_probe(dev, PTR_ERR(priv->host_req), "host-req gpio\n");
+	priv->cs = devm_gpiod_get(dev, "ssi-cs", GPIOD_IN);
+	if (IS_ERR(priv->cs))
+		return dev_err_probe(dev, PTR_ERR(priv->cs), "ssi-cs gpio\n");
+
+	priv->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(priv->pinctrl))
+		return dev_err_probe(dev, PTR_ERR(priv->pinctrl), "pinctrl\n");
+	priv->pins_idle = pinctrl_lookup_state(priv->pinctrl, PINCTRL_STATE_DEFAULT);
+	if (IS_ERR(priv->pins_idle))
+		return dev_err_probe(dev, PTR_ERR(priv->pins_idle), "default pins\n");
+	priv->pins_active = pinctrl_lookup_state(priv->pinctrl, "active");
+	if (IS_ERR(priv->pins_active))
+		return dev_err_probe(dev, PTR_ERR(priv->pins_active), "active pins\n");
+
+	ret = kfifo_alloc(&priv->rx_fifo, BCM4775X_RX_FIFO, GFP_KERNEL);
+	if (ret)
+		return ret;
+	ret = kfifo_alloc(&priv->tx_fifo, BCM4775X_TX_FIFO, GFP_KERNEL);
+	if (ret)
+		goto err_rx_fifo;
+
+	priv->wq = alloc_ordered_workqueue("bcm4775x", WQ_HIGHPRI | WQ_MEM_RECLAIM);
+	if (!priv->wq) {
+		ret = -ENOMEM;
+		goto err_tx_fifo;
+	}
+
+	priv->irq = gpiod_to_irq(priv->host_req);
+	if (priv->irq < 0) {
+		ret = dev_err_probe(dev, priv->irq, "host-req irq\n");
+		goto err_wq;
+	}
+	ret = request_irq(priv->irq, bcm4775x_irq,
+			  IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN, "bcm4775x", priv);
+	if (ret) {
+		dev_err_probe(dev, ret, "request irq\n");
+		goto err_wq;
+	}
+
+	spi_set_drvdata(spi, priv);
+
+	priv->misc.minor = MISC_DYNAMIC_MINOR;
+	priv->misc.name = "bcm4775x";
+	priv->misc.fops = &bcm4775x_fops;
+	priv->misc.parent = dev;
+	ret = misc_register(&priv->misc);
+	if (ret)
+		goto err_irq;
+
+	ret = bcm4775x_hub_probe(priv);
+	if (ret) {
+		misc_deregister(&priv->misc);
+		goto err_irq;
+	}
+
+	dev_info(dev, "BCM4775x SSI link, chip unpowered until 'chip_power' is set\n");
+	return 0;
+
+err_irq:
+	free_irq(priv->irq, priv);
+err_wq:
+	destroy_workqueue(priv->wq);
+err_tx_fifo:
+	kfifo_free(&priv->tx_fifo);
+err_rx_fifo:
+	kfifo_free(&priv->rx_fifo);
+	return ret;
+}
+
+static void bcm4775x_remove(struct spi_device *spi)
+{
+	struct bcm4775x *priv = spi_get_drvdata(spi);
+
+	bcm4775x_hub_remove(priv);
+	misc_deregister(&priv->misc);
+	mutex_lock(&priv->lock);
+	bcm4775x_power_off(priv);
+	mutex_unlock(&priv->lock);
+	free_irq(priv->irq, priv);
+	destroy_workqueue(priv->wq);
+	kfifo_free(&priv->tx_fifo);
+	kfifo_free(&priv->rx_fifo);
+}
+
+static void bcm4775x_shutdown(struct spi_device *spi)
+{
+	struct bcm4775x *priv = spi_get_drvdata(spi);
+
+	mutex_lock(&priv->lock);
+	bcm4775x_power_off(priv);
+	mutex_unlock(&priv->lock);
+}
+
+static int bcm4775x_suspend(struct device *dev)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	bcm4775x_hub_suspend(priv);
+	mutex_lock(&priv->lock);
+	bcm4775x_irq_enable(priv, false);
+	mutex_lock(&priv->io_lock);
+	priv->suspended = true;
+	mutex_unlock(&priv->io_lock);
+	mutex_unlock(&priv->lock);
+	flush_work(&priv->work);
+	return 0;
+}
+
+static int bcm4775x_resume(struct device *dev)
+{
+	struct bcm4775x *priv = dev_get_drvdata(dev);
+
+	mutex_lock(&priv->lock);
+	mutex_lock(&priv->io_lock);
+	priv->suspended = false;
+	mutex_unlock(&priv->io_lock);
+	bcm4775x_irq_enable(priv, true);
+	mutex_unlock(&priv->lock);
+	bcm4775x_hub_resume(priv);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(bcm4775x_pm_ops, bcm4775x_suspend,
+				bcm4775x_resume);
+
+static const struct of_device_id bcm4775x_of_match[] = {
+	{ .compatible = "brcm,bcm47752" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bcm4775x_of_match);
+
+static const struct spi_device_id bcm4775x_spi_id[] = {
+	{ "bcm47752" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, bcm4775x_spi_id);
+
+static struct spi_driver bcm4775x_driver = {
+	.driver = {
+		.name = "bcm4775x",
+		.of_match_table = bcm4775x_of_match,
+		.pm = pm_sleep_ptr(&bcm4775x_pm_ops),
+		.dev_groups = bcm4775x_groups,
+	},
+	.probe = bcm4775x_probe,
+	.remove = bcm4775x_remove,
+	.shutdown = bcm4775x_shutdown,
+	.id_table = bcm4775x_spi_id,
+};
+module_spi_driver(bcm4775x_driver);
+
+MODULE_FIRMWARE(HUB_FIRMWARE);
+MODULE_DESCRIPTION("Broadcom BCM4775x GNSS/sensor hub driver");
+MODULE_LICENSE("GPL");
