+
+/* CRC over body[1..len-1], nibbles swapped */
+static u8 tl_crc(const u8 *body, unsigned int len)
+{
+	u8 crc = 0;
+	unsigned int i;
+
+	for (i = 1; i < len; i++)
+		crc = tl_crc_table[crc ^ body[i]];
+	return (crc << 4) | (crc >> 4);
+}
+
+/* Queue raw bytes for the chip. hub->tl_lock held. */
+static int hub_raw_write(struct bcm4775x *priv, const u8 *buf, unsigned int len,
+			 bool can_wait)
+{
+	int tries = 500;
+
+	while (priv->powered && kfifo_avail(&priv->tx_fifo) < len) {
+		if (!can_wait)
+			return -EAGAIN;
+		if (!--tries)
+			return -ETIMEDOUT;
+		usleep_range(2000, 2500);
+	}
+	if (!priv->powered)
+		return -ENODEV;
+	kfifo_in(&priv->tx_fifo, buf, len);
+	bcm4775x_kick(priv);
+	return 0;
+}
+
+/*
+ * Build and queue one packet. @seq < 0: use and advance the running sequence
+ * number. @detail is the detail byte of TL_F_RELIABLE or TL_F_REL_ACK.
+ */
+static int hub_tl_send(struct bcm4775x *priv, int seq, u16 flags, u8 detail,
+		       const u8 *payload, unsigned int len, bool can_wait)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	u8 *body = hub->tx_body, *out = hub->tx_esc;
+	unsigned int n = 0, i, o = 0;
+	int ret;
+
+	if (len > TL_MAX_PAYLOAD)
+		return -EMSGSIZE;
+
+	mutex_lock(&hub->tl_lock);
+	if (len > 0xff)
+		flags |= TL_F_SIZE_EXT;
+	if (flags > 0xff)
+		flags |= TL_F_EXT;
+
+	body[n++] = seq < 0 ? hub->tx_seq++ : seq;
+	body[n++] = len & 0xff;
+	body[n++] = flags & 0xff;
+	if (flags & TL_F_ACK)
+		body[n++] = hub->last_rx_seq;
+	if (flags & TL_F_RELIABLE)
+		body[n++] = detail;
+	if (flags & TL_F_REL_ACK)
+		body[n++] = detail;
+	if (flags & TL_F_SIZE_EXT)
+		body[n++] = len >> 8;
+	if (flags & TL_F_EXT)
+		body[n++] = flags >> 8;
+	if (flags & TL_F_INTERNAL)
+		body[n++] = 0;
+	if (flags & TL_F_IGNORE_SEQ)
+		body[n++] = 0;
+	memcpy(body + n, payload, len);
+	n += len;
+	body[n] = tl_crc(body, n);
+	n++;
+
+	out[o++] = TL_ESC;
+	out[o++] = TL_SOP;
+	for (i = 0; i < n; i++) {
+		switch (body[i]) {
+		case TL_ESC:
+			out[o++] = TL_ESC;
+			out[o++] = 0x03;
+			break;
+		case TL_XON:
+			out[o++] = TL_ESC;
+			out[o++] = 0x04;
+			break;
+		case TL_XOFF:
+			out[o++] = TL_ESC;
+			out[o++] = 0x05;
+			break;
+		default:
+			out[o++] = body[i];
+		}
+	}
+	out[o++] = TL_ESC;
+	out[o++] = TL_EOP;
+
+	ret = hub_raw_write(priv, out, o, can_wait);
+	mutex_unlock(&hub->tl_lock);
+	return ret;
+}
+
+/* Send RPC bytes in a reliable packet and wait for the chip's RELIABLE_ACK */
+static int hub_send_reliable(struct bcm4775x *priv, const u8 *payload,
+			     unsigned int len)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int tries, ret;
+
+	for (tries = 0; tries < 5; tries++) {
+		reinit_completion(&hub->rel_done);
+		hub->rel_nack = false;
+		hub->rel_wait = hub->rel_seq;
+		hub->rel_waiting = true;
+		ret = hub_tl_send(priv, -1, TL_F_RELIABLE, hub->rel_seq, payload,
+				  len, true);
+		if (ret)
+			break;
+		if (wait_for_completion_timeout(&hub->rel_done, HZ)) {
+			hub->rel_waiting = false;
+			if (hub->rel_nack)
+				return -EIO;
+			hub->rel_seq++;
+			return 0;
+		}
+		ret = -ETIMEDOUT;
+		if (!priv->powered || priv->link_error)
+			break;
+	}
+	hub->rel_waiting = false;
+	return ret;
+}
+
+/* One RPC: id, length (two bytes above 127), data */
+static int hub_rpc(struct bcm4775x *priv, u8 id, const u8 *a, unsigned int alen,
+		   const u8 *b, unsigned int blen, bool reliable)
+{
+	unsigned int len = alen + blen, n = 0;
+	u8 *buf;
+	int ret;
+
+	buf = kmalloc(len + 3, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	buf[n++] = id;
+	if (len > 0x7f)
+		buf[n++] = 0x80 | (len >> 8);
+	buf[n++] = len & 0xff;
+	memcpy(buf + n, a, alen);
+	memcpy(buf + n + alen, b, blen);
+	n += len;
+
+	if (reliable)
+		ret = hub_send_reliable(priv, buf, n);
+	else
+		ret = hub_tl_send(priv, -1, 0, 0, buf, n, true);
+	kfree(buf);
+	return ret;
+}
+
+/* --- receive ------------------------------------------------------------- */
+
+static unsigned int hub_bypass_size(u8 type);
+static void hub_bypass_data(struct bcm4775x_hub *hub, u8 type, const u8 *d);
+
+static void hub_ssp_event(struct bcm4775x *priv, const u8 *d, unsigned int len)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	unsigned int i = 0, n;
+
+	while (i < len) {
+		switch (d[i++]) {
+		case SSP_INST_BYPASS_DATA:
+			/* sensor type, payload, 64 bit timestamp */
+			if (i >= len)
+				return;
+			n = hub_bypass_size(d[i]);
+			if (!n || i + 1 + n + 8 > len)
+				return;
+			hub_bypass_data(hub, d[i], d + i + 1);
+			i += 1 + n + 8;
+			break;
+		case SSP_INST_DEBUG:
+			if (i + 2 > len)
+				return;
+			n = get_unaligned_le16(d + i);
+			i += 2;
+			if (i + n > len)
+				return;
+			dev_dbg(&priv->spi->dev, "hub: %.*s\n", n, d + i);
+			i += n;
+			break;
+		case SSP_INST_INIT_DONE:
+			complete(&hub->init_done);
+			break;
+		default:
+			return;
+		}
+	}
+}
+
+/* Frames from the hub: u16 options, u16 length, data for reads and events */
+static void hub_ssp_rx(struct bcm4775x *priv, const u8 *data, unsigned int len)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	unsigned int need, n, type;
+	u16 opts;
+
+	if (hub->ssp_len + len > sizeof(hub->ssp_buf)) {
+		dev_warn_ratelimited(&priv->spi->dev, "SSP stream overflow\n");
+		hub->ssp_len = 0;
+		return;
+	}
+	memcpy(hub->ssp_buf + hub->ssp_len, data, len);
+	hub->ssp_len += len;
+
+	while (hub->ssp_len >= 4) {
+		opts = get_unaligned_le16(hub->ssp_buf);
+		n = get_unaligned_le16(hub->ssp_buf + 2);
+		type = opts & SSP_TYPE_MASK;
+		need = 4;
+		if (type == SSP_AP2HUB_READ || type == SSP_HUB2AP_WRITE)
+			need += n;
+		if (need > sizeof(hub->ssp_buf)) {
+			hub->ssp_len = 0;
+			return;
+		}
+		if (hub->ssp_len < need)
+			return;
+
+		if (type == SSP_HUB2AP_WRITE) {
+			hub_ssp_event(priv, hub->ssp_buf + 4, n);
+		} else if (hub->ssp_waiting && opts == hub->ssp_want) {
+			hub->ssp_rsp_len = min_t(unsigned int, need - 4,
+						 sizeof(hub->ssp_rsp));
+			memcpy(hub->ssp_rsp, hub->ssp_buf + 4, hub->ssp_rsp_len);
+			hub->ssp_waiting = false;
+			complete(&hub->ssp_done);
+		}
+		hub->ssp_len -= need;
+		memmove(hub->ssp_buf, hub->ssp_buf + need, hub->ssp_len);
+	}
+}
+
+static void hub_rpc_rx(struct bcm4775x *priv, const u8 *p, unsigned int len)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	unsigned int i = 0, id, n;
+
+	while (i + 2 <= len) {
+		id = p[i++];
+		if (id & 0x80)
+			id = ((id & 0x7f) << 8) | p[i++];
+		if (i >= len)
+			return;
+		n = p[i++];
+		if (n & 0x80) {
+			if (i >= len)
+				return;
+			n = ((n & 0x7f) << 8) | p[i++];
+		}
+		if (i + n > len)
+			return;
+
+		if (id == RPC_VERSION_RESPONSE && n >= 12) {
+			hub->version[0] = get_unaligned_le32(p + i);
+			hub->version[1] = get_unaligned_le32(p + i + 4);
+			hub->version[2] = get_unaligned_le32(p + i + 8);
+			complete(&hub->version_done);
+		} else if (id == RPC_SENSOR_RESPONSE && n >= 2) {
+			hub_ssp_rx(priv, p + i + 2, n - 2);
+		}
+		i += n;
+	}
+}
+
+static void hub_tl_packet(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	const u8 *m = hub->rx_msg;
+	unsigned int len = hub->rx_len, pos = 3, size, bit;
+	u16 flags;
+	u8 detail, rel_seq = 0;
+	bool reliable = false;
+
+	if (len < 4 || tl_crc(m, len - 1) != m[len - 1])
+		return;
+	size = m[1];
+	flags = m[2];
+	len--;				/* drop the CRC */
+
+	for (bit = 0; bit < 16; bit++) {
+		if (!(flags & BIT(bit)))
+			continue;
+		if (pos >= len)
+			break;
+		detail = m[pos++];
+		switch (BIT(bit)) {
+		case TL_F_RELIABLE:
+			reliable = true;
+			rel_seq = detail;
+			break;
+		case TL_F_REL_ACK:
+			if (hub->rel_waiting && detail == hub->rel_wait)
+				complete(&hub->rel_done);
+			break;
+		case TL_F_REL_NACK:
+			if (hub->rel_waiting) {
+				hub->rel_nack = true;
+				complete(&hub->rel_done);
+			}
+			break;
+		case TL_F_SIZE_EXT:
+			size |= detail << 8;
+			break;
+		case TL_F_EXT:
+			flags |= detail << 8;
+			break;
+		}
+	}
+	if (pos > len || size != len - pos)
+		return;
+
+	hub->last_rx_seq = m[0];
+	if (flags & TL_F_INTERNAL) {
+		/* SeqIdResponse: 01, request id, six sequence numbers */
+		if (size == 8 && m[pos] == 1 && m[pos + 1] == hub->sync_req) {
+			memcpy(hub->sync_rsp, m + pos + 2, 6);
+			complete(&hub->sync_done);
+		}
+		return;
+	}
+
+	if (size)
+		hub_rpc_rx(priv, m + pos, size);
+
+	/* acknowledge like the vendor daemon: reliable packets and now and then */
+	if (reliable)
+		hub_tl_send(priv, -1, TL_F_ACK | TL_F_REL_ACK, rel_seq, NULL, 0,
+			    false);
+	else if (size && ++hub->unacked >= 100) {
+		hub->unacked = 0;
+		hub_tl_send(priv, -1, TL_F_ACK, 0, NULL, 0, false);
+	}
+}
+
+/* Bytes from the chip, called from the link work */
+static void bcm4775x_hub_rx(struct bcm4775x *priv, const u8 *data,
+			    unsigned int len)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	unsigned int i;
+	u8 c;
+
+	for (i = 0; i < len; i++) {
+		c = data[i];
+		if (c == TL_XON || c == TL_XOFF)
+			continue;
+		switch (hub->rx_state) {
+		case 0:			/* wait for ESC */
+			if (c == TL_ESC)
+				hub->rx_state = 1;
+			break;
+		case 1:			/* wait for SOP */
+			if (c == TL_SOP) {
+				hub->rx_state = 2;
+				hub->rx_len = 0;
+			} else if (c != TL_ESC) {
+				hub->rx_state = 0;
+			}
+			break;
+		case 2:			/* body */
+			if (c == TL_ESC)
+				hub->rx_state = 3;
+			else if (hub->rx_len < sizeof(hub->rx_msg))
+				hub->rx_msg[hub->rx_len++] = c;
+			else
+				hub->rx_state = 0;
+			break;
+		default:		/* after ESC inside the body */
+			if (c == TL_EOP) {
+				hub_tl_packet(priv);
+				hub->rx_state = 0;
+				break;
+			}
+			if (c == TL_SOP) {
+				hub->rx_state = 2;
+				hub->rx_len = 0;
+				break;
+			}
+			if (c == TL_ESC) {
+				hub->rx_state = 1;
+				break;
+			}
+			if (c == 0x03)
+				c = TL_ESC;
+			else if (c == 0x04)
+				c = TL_XON;
+			else if (c == 0x05)
+				c = TL_XOFF;
+			else {
+				hub->rx_state = 0;
+				break;
+			}
+			if (hub->rx_len < sizeof(hub->rx_msg)) {
+				hub->rx_msg[hub->rx_len++] = c;
+				hub->rx_state = 2;
+			} else {
+				hub->rx_state = 0;
+			}
+		}
+	}
+}
+
+/* --- hub commands (hub->lock held) ---------------------------------------- */
+
+static int hub_sync(struct bcm4775x *priv, int tries)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	static const u8 autobaud[36] = { [0 ... 35] = 0x80 };
+	u8 req[2] = { 0 };
+	int i, ret;
+
+	hub->rx_state = 0;
+	mutex_lock(&hub->tl_lock);
+	ret = hub_raw_write(priv, autobaud, sizeof(autobaud), true);
+	mutex_unlock(&hub->tl_lock);
+	if (ret)
+		return ret;
+	msleep(100);
+
+	for (i = 1; i <= tries; i++) {
+		reinit_completion(&hub->sync_done);
+		hub->sync_req = req[1] = i;
+		ret = hub_tl_send(priv, i - 1, TL_F_INTERNAL | TL_F_IGNORE_SEQ, 0,
+				  req, sizeof(req), true);
+		if (ret)
+			return ret;
+		if (wait_for_completion_timeout(&hub->sync_done, HZ / 2)) {
+			hub->tx_seq = hub->sync_rsp[0] + 1;
+			hub->rel_seq = hub->sync_rsp[2] + 1;
+			hub->unacked = 0;
+			return 0;
+		}
+	}
+	return -ETIMEDOUT;
+}
+
+static int hub_get_version(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int ret;
+
+	reinit_completion(&hub->version_done);
+	ret = hub_rpc(priv, RPC_GET_VERSION, NULL, 0, NULL, 0, true);
+	if (ret)
+		return ret;
+	if (!wait_for_completion_timeout(&hub->version_done, HZ))
+		return -ETIMEDOUT;
+	return 0;
+}
+
+/*
+ * The firmware file is the blob of the vendor's patch file: commands of
+ * <cmd:1> <len:2> <payload>. Only memory writes (F1: address, data) occur in
+ * it; they build one RAM image whose vector table comes first.
+ */
+static int hub_download(struct bcm4775x *priv, u32 *entry)
+{
+	struct device *dev = &priv->spi->dev;
+	const struct firmware *fw;
+	const u8 *p, *end;
+	unsigned int n;
+	bool first = true;
+	u8 hdr[6];
+	int ret;
+
+	ret = request_firmware(&fw, HUB_FIRMWARE, dev);
+	if (ret)
+		return ret;
+
+	p = fw->data;
+	end = p + fw->size;
+	while (p < end) {
+		if (end - p < 3) {
+			ret = -EINVAL;
+			break;
+		}
+		n = get_unaligned_le16(p + 1);
+		if (p[0] != PATCH_CMD_WRITE || n < 5 || n > TL_MAX_PAYLOAD - 16 ||
+		    end - p < 3 + n) {
+			dev_err(dev, "firmware: unsupported command %#x at %#zx\n",
+				p[0], p - fw->data);
+			ret = -EINVAL;
+			break;
+		}
+		p += 3;
+		if (first) {
+			if (n < 12) {
+				ret = -EINVAL;
+				break;
+			}
+			*entry = get_unaligned_le32(p + 8);	/* reset vector */
+			first = false;
+		}
+		memcpy(hdr, p, 4);			/* address */
+		put_unaligned_le16(n - 4, hdr + 4);
+		ret = hub_rpc(priv, RPC_MEMORY_WRITE, hdr, 6, p + 4, n - 4, true);
+		if (ret)
+			break;
+		p += n;
+	}
+	if (!ret && first)
+		ret = -EINVAL;
+	release_firmware(fw);
+	return ret;
+}
+
+static int hub_ssp_wait(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+
+	if (!wait_for_completion_timeout(&hub->ssp_done, HZ)) {
+		hub->ssp_waiting = false;
+		return -ETIMEDOUT;
+	}
+	return 0;
+}
+
+static int hub_ssp_header(struct bcm4775x *priv, u8 cmd, u16 len, u16 opts)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	u8 msg[2 + 9] = { 9, 0, cmd };
+
+	put_unaligned_le16(len, msg + 3);
+	put_unaligned_le16(opts, msg + 5);
+	reinit_completion(&hub->ssp_done);
+	hub->ssp_want = opts;
+	hub->ssp_waiting = true;
+	return hub_rpc(priv, RPC_SENSOR_REQUEST, msg, sizeof(msg), NULL, 0, true);
+}
+
+static int hub_ssp_read(struct bcm4775x *priv, u8 cmd, u8 *buf, unsigned int len)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int ret;
+
+	ret = hub_ssp_header(priv, cmd, len, SSP_AP2HUB_READ);
+	if (!ret)
+		ret = hub_ssp_wait(priv);
+	if (ret)
+		return ret;
+	if (hub->ssp_rsp_len < len)
+		return -EIO;
+	memcpy(buf, hub->ssp_rsp, len);
+	return 0;
+}
+
+static int hub_ssp_write(struct bcm4775x *priv, u8 cmd, const u8 *buf,
+			 unsigned int len)
+{
+	u8 size[2];
+	int ret;
+
+	ret = hub_ssp_header(priv, cmd, len, SSP_AP2HUB_WRITE);
+	if (!ret)
+		ret = hub_ssp_wait(priv);
+	if (ret)
+		return ret;
+	put_unaligned_le16(len, size);
+	return hub_rpc(priv, RPC_SENSOR_REQUEST, size, 2, buf, len, true);
+}
+
+static void hub_stop(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int i;
+
+	if (!priv->hub_active)
+		return;
+	mutex_lock(&priv->lock);
+	bcm4775x_power_off(priv);
+	priv->hub_active = false;
+	priv->opened = false;
+	mutex_unlock(&priv->lock);
+	hub->running = false;
+	for (i = 0; i < HUB_NUM_SENSORS; i++) {
+		hub->sensor[i].on = false;
+		hub->sensor[i].filt_valid = false;
+	}
+}
+
+static bool hub_kept(struct bcm4775x_hub *hub)
+{
+	int i;
+
+	for (i = 0; i < HUB_NUM_SENSORS; i++)
+		if (hub->sensor[i].keep)
+			return true;
+	return false;
+}
+
+/* The hub failed while running: stop it, start it again later if needed */
+static void hub_stop_failed(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+
+	hub_stop(priv);
+	if (hub_kept(hub) && !hub->suspending)
+		schedule_delayed_work(&hub->restart_work,
+				      msecs_to_jiffies(HUB_RESTART_MS));
+}
+
+static int hub_start(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	struct device *dev = &priv->spi->dev;
+	/* SM-G975F: ap type 2 (beyond2), board revision 26 */
+	u8 ap_info[2] = { 2, 26 };
+	/* accelerometer, gyroscope and magnetometer mounting (downstream DT) */
+	u8 position[3] = { 4, 4, 7 };
+	/*
+	 * Proximity thresholds, big endian: high 2400, low 1600, detect high
+	 * 16368, detect low 250 (vendor defaults). Without them the proximity
+	 * sensor does not sample.
+	 */
+	u8 prox[8] = { HUB_PROX_NEAR >> 8, HUB_PROX_NEAR & 0xff,
+		       HUB_PROX_FAR >> 8, HUB_PROX_FAR & 0xff,
+		       0x3f, 0xf0, 0x00, 0xfa };
+	u8 buf[8];
+	u32 entry = 0, rom;
+	int ret;
+
+	/* the character device and the hub exclude each other */
+	mutex_lock(&priv->lock);
+	if (priv->opened || priv->powered) {
+		mutex_unlock(&priv->lock);
+		return -EBUSY;
+	}
+	priv->opened = true;
+	priv->hub_active = true;
+	hub->ssp_len = 0;
+	hub->rx_state = 0;
+	ret = bcm4775x_power_on(priv);
+	mutex_unlock(&priv->lock);
+	if (ret) {
+		priv->hub_active = false;
+		priv->opened = false;
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(priv->nstandby, 1);
+	msleep(200);
+
+	ret = hub_sync(priv, 4);
+	if (!ret)
+		ret = hub_get_version(priv);
+	if (ret) {
+		dev_err(dev, "boot ROM does not answer: %d\n", ret);
+		goto err;
+	}
+	rom = hub->version[1];
+
+	reinit_completion(&hub->init_done);
+	ret = hub_download(priv, &entry);
+	if (ret) {
+		dev_err(dev, "firmware download failed: %d\n", ret);
+		goto err;
+	}
+	put_unaligned_le32(entry, buf);
+	ret = hub_rpc(priv, RPC_START_SCRATCH_APP, buf, 4, NULL, 0, false);
+	if (ret)
+		goto err;
+	msleep(300);
+
+	ret = hub_sync(priv, 8);
+	if (!ret)
+		ret = hub_get_version(priv);
+	if (ret) {
+		dev_err(dev, "firmware does not answer: %d\n", ret);
+		goto err;
+	}
+	if (!wait_for_completion_timeout(&hub->init_done, 3 * HZ))
+		dev_warn(dev, "no init-done message from the hub\n");
+
+	ret = hub_ssp_read(priv, SSP_CMD_WHOAMI, buf, 1);
+	if (!ret && buf[0] != SSP_WHOAMI_ID)
+		ret = -ENODEV;
+	if (!ret)
+		ret = hub_ssp_write(priv, SSP_CMD_AP_INFORMATION, ap_info,
+				    sizeof(ap_info));
+	if (!ret)
+		ret = hub_ssp_write(priv, SSP_CMD_SENSOR_FORMATION, position,
+				    sizeof(position));
+	if (!ret)
+		ret = hub_ssp_write(priv, SSP_CMD_PROX_THRESHOLD, prox,
+				    sizeof(prox));
+	if (!ret)
+		ret = hub_ssp_read(priv, SSP_CMD_SENSOR_SCANNING, buf, 8);
+	if (!ret) {
+		hub->sensors = get_unaligned_le64(buf);
+		ret = hub_ssp_read(priv, SSP_CMD_FIRMWARE_REV, buf, 4);
+	}
+	if (ret) {
+		dev_err(dev, "sensor hub setup failed: %d\n", ret);
+		goto err;
+	}
+	hub->fw_rev = get_unaligned_le32(buf);
+	hub->running = true;
+	dev_info(dev,
+		 "sensor hub up: chip %#x, ROM %u, firmware %u (rev %u), sensors %#llx\n",
+		 hub->version[0], rom, hub->version[1], hub->fw_rev, hub->sensors);
+	return 0;
+
+err:
+	hub_stop(priv);
+	return ret;
+}
+
+static int hub_sensor_enable(struct bcm4775x *priv, struct hub_sensor *s,
+			     bool on)
+{
+	/* sensor type, s32 period in ms, s32 batch latency, s8 batch options */
+	u8 arg[10] = { s->desc->type };
+	u8 also[10] = { s->desc->companion };
+	bool has_also = s->desc->companion >= 0;
+	int ret = 0;
+
+	if (s->on == on)
+		return 0;
+	put_unaligned_le32(s->desc->period_ms, arg + 1);
+	put_unaligned_le32(s->desc->period_ms, also + 1);
+	if (on) {
+		s->filt_valid = false;
+		reinit_completion(&s->fresh);
+		if (has_also)
+			ret = hub_ssp_write(priv, SSP_CMD_SENSOR_ADD, also, 10);
+		if (!ret)
+			ret = hub_ssp_write(priv, SSP_CMD_SENSOR_ADD, arg, 10);
+		if (!ret && !wait_for_completion_timeout(&s->fresh, 2 * HZ))
+			ret = -ETIMEDOUT;
+		if (ret) {
+			hub_ssp_write(priv, SSP_CMD_SENSOR_REMOVE, arg, 5);
+			if (has_also)
+				hub_ssp_write(priv, SSP_CMD_SENSOR_REMOVE, also, 5);
+		}
+	} else {
+		ret = hub_ssp_write(priv, SSP_CMD_SENSOR_REMOVE, arg, 5);
+		if (!ret && has_also)
+			ret = hub_ssp_write(priv, SSP_CMD_SENSOR_REMOVE, also, 5);
+	}
+	if (!ret)
+		s->on = on;
+	return ret;
+}
+
+/* No reader for a while: stop the sensors, later power the hub off */
+static void hub_idle_work(struct work_struct *work)
+{
+	struct bcm4775x_hub *hub = container_of(to_delayed_work(work),
+						struct bcm4775x_hub, idle_work);
+	struct bcm4775x *priv = hub->priv;
+	unsigned long idle, min_idle = ULONG_MAX, next;
+	bool busy = false, kept = false;
+	int i;
+
+	mutex_lock(&hub->lock);
+	if (!hub->running)
+		goto out;
+
+	for (i = 0; i < HUB_NUM_SENSORS; i++) {
+		struct hub_sensor *s = &hub->sensor[i];
+
+		if (!s->on)
+			continue;
+		if (s->keep) {
+			kept = true;
+			continue;
+		}
+		idle = jiffies - s->last_read;
+		if (idle >= msecs_to_jiffies(HUB_SENSOR_IDLE_MS)) {
+			if (hub_sensor_enable(priv, s, false)) {
+				hub_stop_failed(priv);
+				goto out;
+			}
+		} else {
+			busy = true;
+			min_idle = min(min_idle, idle);
+		}
+	}
+
+	idle = jiffies - hub->last_read;
+	if (busy)
+		next = msecs_to_jiffies(HUB_SENSOR_IDLE_MS) - min_idle + 1;
+	else if (kept)
+		goto out;	/* hub_release() starts the timer again */
+	else if (idle >= HUB_OFF_DELAY * HZ) {
+		hub_stop(priv);
+		goto out;
+	} else {
+		next = HUB_OFF_DELAY * HZ - idle + 1;
+	}
+	schedule_delayed_work(&hub->idle_work, next);
+out:
+	mutex_unlock(&hub->lock);
+}
+
+/* Start the hub unless it runs; not more often than every 30 s if it fails */
+static int hub_ensure_running(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int ret;
+
+	if (priv->suspended || hub->suspending)
+		return -EBUSY;
+	if (hub->running)
+		return 0;
+	if (hub->failed && time_before(jiffies, hub->retry_after))
+		return -EAGAIN;
+	ret = hub_start(priv);
+	hub->failed = ret;
+	hub->retry_after = jiffies + 30 * HZ;
+	return ret;
+}
+
+/* Start the hub if needed and every sensor somebody holds */
+static int hub_start_kept(struct bcm4775x *priv)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int ret, i;
+
+	ret = hub_ensure_running(priv);
+	for (i = 0; !ret && i < HUB_NUM_SENSORS; i++)
+		if (hub->sensor[i].keep)
+			ret = hub_sensor_enable(priv, &hub->sensor[i], true);
+	if (ret && hub->running)
+		hub_stop(priv);
+	return ret;
+}
+
+/* Keep a sensor running without reads until hub_release() */
+static int hub_hold(struct bcm4775x *priv, const u8 *index, unsigned int n)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	unsigned int i;
+	int ret;
+
+	mutex_lock(&hub->lock);
+	for (i = 0; i < n; i++)
+		hub->sensor[index[i]].keep++;
+	ret = hub_start_kept(priv);
+	if (ret) {
+		for (i = 0; i < n; i++)
+			hub->sensor[index[i]].keep--;
+		/* other holders lost the hub as well */
+		if (!hub->running && hub_kept(hub))
+			schedule_delayed_work(&hub->restart_work,
+					      msecs_to_jiffies(HUB_RESTART_MS));
+	}
+	mutex_unlock(&hub->lock);
+	return ret;
+}
+
+static void hub_release(struct bcm4775x *priv, const u8 *index, unsigned int n)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	unsigned int i;
+
+	mutex_lock(&hub->lock);
+	for (i = 0; i < n; i++) {
+		struct hub_sensor *s = &hub->sensor[index[i]];
+
+		s->keep--;
+		s->last_read = jiffies;
+	}
+	hub->last_read = jiffies;
+	/* the usual idle handling takes the sensors and the hub down */
+	mod_delayed_work(system_wq, &hub->idle_work,
+			 msecs_to_jiffies(HUB_SENSOR_IDLE_MS));
+	mutex_unlock(&hub->lock);
+}
+
+/* After a failure or system sleep: bring held sensors back */
+static void hub_restart_work(struct work_struct *work)
+{
+	struct bcm4775x_hub *hub = container_of(to_delayed_work(work),
+						struct bcm4775x_hub,
+						restart_work);
+
+	mutex_lock(&hub->lock);
+	if (!hub->suspending && hub_kept(hub) && hub_start_kept(hub->priv))
+		schedule_delayed_work(&hub->restart_work,
+				      msecs_to_jiffies(HUB_RESTART_MS));
+	mutex_unlock(&hub->lock);
+}
+
+/* Start the hub and the sensor if needed and return its latest value */
+static int hub_sensor_read(struct bcm4775x *priv, struct hub_sensor *s,
+			   unsigned int index, int *val)
+{
+	struct bcm4775x_hub *hub = priv->hub;
+	int ret;
+
+	mutex_lock(&hub->lock);
+	ret = hub_ensure_running(priv);
+	if (!ret) {
+		ret = hub_sensor_enable(priv, s, true);
+		if (ret == -ETIMEDOUT && hub->running && !priv->link_error) {
+			/* the hub works, this sensor just has nothing to say */
+			mutex_unlock(&hub->lock);
+			return -ENODATA;
+		}
+		if (ret && hub->running)
+			hub_stop_failed(priv);
+	}
+	if (!ret) {
+		*val = s->val[index];
+		s->last_read = hub->last_read = jiffies;
+		schedule_delayed_work(&hub->idle_work,
+				      msecs_to_jiffies(HUB_SENSOR_IDLE_MS));
+	}
+	mutex_unlock(&hub->lock);
+	return ret;
+}
+
+/* atan2(y, x) in millidegrees, -180000 < result <= 180000 (CORDIC) */
+static int hub_atan2_mdeg(s64 y, s64 x)
+{
+	/* atan(2^-i) in microdegrees */
+	static const s32 step[] = {
+		45000000, 26565051, 14036243, 7125016, 3576334, 1789911,
+		895174, 447614, 223811, 111906, 55953, 27976, 13988, 6994,
+		3497, 1749, 874, 437,
+	};
+	s64 angle = 0, t;
+	int i;
+
+	if (!x && !y)
+		return 0;
+	/* room for the CORDIC gain and for 18 bits of shift */
+	while (abs(x) >= (1LL << 40) || abs(y) >= (1LL << 40)) {
+		x /= 2;
+		y /= 2;
+	}
+	while (abs(x) < (1LL << 24) && abs(y) < (1LL << 24)) {
+		x *= 2;
+		y *= 2;
+	}
+	if (x < 0) {		/* turn by 180 degrees into the right half */
+		x = -x;
+		y = -y;
+		angle = y > 0 ? -180000000 : 180000000;
+	}
+	for (i = 0; i < ARRAY_SIZE(step); i++) {
+		t = x;
+		if (y > 0) {
+			x += y >> i;
+			y -= t >> i;
+			angle += step[i];
+		} else {
+			x -= y >> i;
+			y += t >> i;
+			angle -= step[i];
+		}
+	}
+	return div_s64(angle + (angle >= 0 ? 500 : -500), 1000);
+}
+
+/*
+ * Compass heading in millidegrees, 0 .. 359999: the angle from magnetic north
+ * to the top edge of the phone, clockwise seen from above, whatever the tilt.
+ *
+ * Both sensors report in the hub's (Android) axes; the accelerometer reads
+ * "up" at rest. With E the field and A up: H = E x A points east, M = A x H
+ * north, both horizontal, and the heading of the y axis is
+ * atan2(H.y / |H|, M.y / |M|) with |M| = |A| |H|.
+ */
+static int hub_heading(struct bcm4775x_hub *hub)
+{
+	const struct hub_sensor *acc = &hub->sensor[HUB_ACCEL];
+	const struct hub_sensor *mag = &hub->sensor[HUB_MAGN];
+	s64 a[3], e[3], d[3], hx, hy, hz, my;
+	int i, heading;
+
+	if (!acc->filt_valid || !mag->filt_valid)
+		return 0;
+	for (i = 0; i < 3; i++) {
+		a[i] = acc->filt[i];
+		d[i] = mag->filt[i] - magn_hard_iron[i] * (1 << HUB_FILTER_SHIFT);
+	}
+	for (i = 0; i < 3; i++)
+		e[i] = div_s64(magn_soft_iron[3 * i] * d[0] +
+			       magn_soft_iron[3 * i + 1] * d[1] +
+			       magn_soft_iron[3 * i + 2] * d[2], 1000);
+
+	/* 16 bit values with 4 fraction bits: |H| < 2^41, |M| < 2^62 */
+	hx = e[1] * a[2] - e[2] * a[1];
+	hy = e[2] * a[0] - e[0] * a[2];
+	hz = e[0] * a[1] - e[1] * a[0];
+	my = a[2] * hx - a[0] * hz;
+	hy *= int_sqrt64(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
+
+	heading = hub_atan2_mdeg(hy, my);
+	return heading < 0 ? heading + 360000 : heading;
+}
+
+static int hub_read_raw(struct iio_dev *indio, struct iio_chan_spec const *chan,
+			int *val, int *val2, long mask)
+{
+	struct hub_iio *hi = iio_priv(indio);
+	struct bcm4775x_hub *hub = hi->priv->hub;
+	struct hub_sensor *s = &hub->sensor[hi->index];
+	int ret;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+	case IIO_CHAN_INFO_PROCESSED:
+		if (chan->type == IIO_ROT) {
+			/* needs the accelerometer as well */
+			ret = hub_sensor_read(hi->priv, &hub->sensor[HUB_ACCEL],
+					      0, val);
+			if (!ret)
+				ret = hub_sensor_read(hi->priv, s, 0, val);
+			if (ret)
+				return ret;
+			*val = hub_heading(hub);
+			return IIO_VAL_INT;
+		}
+		ret = hub_sensor_read(hi->priv, s, chan->address, val);
+		return ret ? ret : IIO_VAL_INT;
+	case IIO_CHAN_INFO_SCALE:
+		switch (chan->type) {
+		case IIO_ROT:		/* millidegrees, in degrees */
+			*val = 0;
+			*val2 = 1000;
+			return IIO_VAL_INT_PLUS_MICRO;
+		case IIO_ACCEL:		/* 4096 LSB/g */
+			*val = 0;
+			*val2 = 2394202;
+			return IIO_VAL_INT_PLUS_NANO;
+		case IIO_ANGL_VEL:
+			/*
+			 * 1000 units per LSB of the LSM6DSO at 35 mdps/LSB:
+			 * 6.109e-7 rad/s. Measured with 90 degree turns
+			 * against gravity: 6.05e-7 .. 6.14e-7.
+			 */
+			*val = 0;
+			*val2 = 611;
+			return IIO_VAL_INT_PLUS_NANO;
+		case IIO_MAGN:
+			/*
+			 * AK09918 raw counts, 0.15 uT = 0.0015 G per LSB (a
+			 * sphere fit of the earth's field gave 316 LSB =
+			 * 47 uT).
+			 */
+			*val = 0;
+			*val2 = 1500;
+			return IIO_VAL_INT_PLUS_MICRO;
+		case IIO_PRESSURE:	/* 4096 LSB/hPa, in kPa */
+			*val = 0;
+			*val2 = 24414;
+			return IIO_VAL_INT_PLUS_NANO;
+		case IIO_TEMP:		/* 0.01 degrees C, in milli degrees */
+			*val = 10;
+			return IIO_VAL_INT;
+		default:
+			return -EINVAL;
+		}
+	case IIO_CHAN_INFO_OFFSET:
+		/* hard iron: (raw + offset) * scale is the ambient field */
+		if (chan->type != IIO_MAGN || chan->address >= 3)
+			return -EINVAL;
+		*val = -magn_hard_iron[chan->address];
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		*val = 1000 / s->desc->period_ms;
+		return IIO_VAL_INT;
+	}
+	return -EINVAL;
+}
