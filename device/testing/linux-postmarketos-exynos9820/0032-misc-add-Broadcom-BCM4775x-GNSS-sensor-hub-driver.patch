--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -72,3 +72,4 @@ obj-y				+= amd-sbi/
 obj-$(CONFIG_MISC_RP1)		+= rp1/
 obj-$(CONFIG_INTEL_SSEI)	+= issei/
 obj-$(CONFIG_TC9564_PCI)	+= tc9564-pci.o
+obj-$(CONFIG_BCM4775X)		+= bcm4775x.o
diff --git a/drivers/misc/bcm4775x.c b/drivers/misc/bcm4775x.c
new file mode 100644
index 0000000000..0ef5b14e83
--- /dev/null
+++ b/drivers/misc/bcm4775x.c
@@ -0,0 +1,2726 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Broadcom BCM4775x GNSS receiver + sensor hub: SPI link layer ("SSI")
+ *
+ * The chip (BCM47752 on the Samsung Galaxy S10 family) talks to the host
+ * over SPI with a small streaming protocol: every SPI transfer starts with a
+ * control byte and a 16 bit length, the chip answers with a status byte and
+ * the number of bytes it has for the host. Two GPIOs (MCU_REQ/MCU_RESP) wake
+ * the chip before a transfer, HOST_REQ is raised by the chip when it has
+ * data.
+ *
+ * This driver implements that link layer and the power control, and hands
+ * the byte stream to user space through /dev/bcm4775x (for GNSS and for
+ * experiments). It can also run the sensor hub itself: it downloads the
+ * firmware, speaks the transport layer, the RPCs and Samsung's SSP sensor
+ * protocol and offers the sensors behind the hub as IIO devices. The two users
+ * exclude each other. The magnetometer also has an IIO buffer and a tilt
+ * compensated compass heading computed here from it and the accelerometer.
+ *
+ * The SSI framing follows the vendor driver (drivers/sensorhub/brcm/bbdpl/
+ * bcm_gps_spi.c, Copyright 2015 Broadcom Corporation, GPL-2.0) of the
+ * SM-G975F kernel.
+ *
+ * The chip is unpowered until user space writes 1 to the "chip_power" attribute;
+ * until then all pins stay in their idle (input, pull-down) state.
+ */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/iio/buffer.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/kfifo_buf.h>
+#include <linux/interrupt.h>
+#include <linux/kfifo.h>
+#include <linux/math64.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/poll.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#define SSI_MODE_FULL_DUPLEX	0x40
+#define SSI_READ_TRANS		0x20
+#define SSI_PCKT_2B_LENGTH	0x10
+#define SSI_FLOW_CONTROL	0x08
+
+/* host -> chip: full duplex, 2 byte length, flow control */
+#define SSI_TX_CTRL	(SSI_MODE_FULL_DUPLEX | SSI_PCKT_2B_LENGTH | SSI_FLOW_CONTROL)
+/* chip -> host: full duplex, 2 byte length, read */
+#define SSI_RX_CTRL	(SSI_MODE_FULL_DUPLEX | SSI_PCKT_2B_LENGTH | SSI_READ_TRANS)
+
+#define SSI_LEN_BYTES		2
+#define SSI_TX_CTRL_LEN		(1 + SSI_LEN_BYTES + SSI_LEN_BYTES)	/* cmd, len, fc */
+#define SSI_RX_CTRL_LEN		(1 + SSI_LEN_BYTES)			/* status, len */
+#define SSI_MAX_FRAME		8192
+#define SSI_MIN_FRAME		254
+#define SSI_FC_RETRIES		3
+
+/* status byte: free space in the chip's receive ring ("PZC") and an error flag */
+#define SSI_STAT_CNT_MASK	0x07
+#define SSI_STAT_SZE_MASK	0x18
+#define SSI_STAT_SZE_SHIFT	3
+#define SSI_STAT_PE		0x40
+
+#define BCM4775X_RX_FIFO	(64 * 1024)
+#define BCM4775X_TX_FIFO	(32 * 1024)
+#define BCM4775X_HELLO_MS	100
+
+struct bcm4775x_hub;
+
+struct bcm4775x {
+	struct spi_device *spi;
+	struct bcm4775x_hub *hub;
+	bool hub_active;	/* the in-kernel sensor hub owns the stream */
+	struct miscdevice misc;
+
+	struct regulator *vdd;
+	struct gpio_desc *nstandby;
+	struct gpio_desc *mcu_req;
+	struct gpio_desc *mcu_resp;
+	struct gpio_desc *host_req;
+	struct gpio_desc *cs;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *pins_idle;
+	struct pinctrl_state *pins_active;
+	int irq;
+	spinlock_t irq_lock;
+	bool irq_masked;	/* level interrupt masked until the work served it */
+
+	/* power state, open count, irq_on */
+	struct mutex lock;
+	bool powered;
+	bool opened;
+	bool irq_on;
+	bool suspended;
+
+	/* serialises SPI traffic and the handshake lines */
+	struct mutex io_lock;
+	struct workqueue_struct *wq;
+	struct work_struct work;
+	u8 *tx_buf;
+	u8 *rx_buf;
+
+	DECLARE_KFIFO_PTR(rx_fifo, u8);
+	DECLARE_KFIFO_PTR(tx_fifo, u8);
+	struct mutex rx_lock;	/* readers */
+	struct mutex tx_lock;	/* writers */
+	wait_queue_head_t wait;
+
+	/* statistics */
+	unsigned long tx_bytes, rx_bytes, tx_frames, rx_frames;
+	unsigned long fc_retries, fc_errors, hello_fail, spi_errors, rx_dropped;
+	unsigned long parity_errors;
+	u8 last_status;
+	bool link_error;
+};
+
+static unsigned int ssi_get_len(const u8 *p)
+{
+	return p[0] | (p[1] << 8);
+}
+
+static void ssi_set_len(u8 *p, unsigned int len)
+{
+	p[0] = len & 0xff;
+	p[1] = len >> 8;
+}
+
+static unsigned int bcm4775x_frame_len(void)
+{
+	return SSI_MAX_FRAME;
+}
+
+/* One SPI transfer with the chip select (a GPIO of ours) held for its length */
+static int bcm4775x_xfer(struct bcm4775x *priv, unsigned int len)
+{
+	struct spi_transfer xfer = {
+		.tx_buf = priv->tx_buf,
+		.rx_buf = priv->rx_buf,
+		.len = len,
+	};
+	int ret;
+
+	gpiod_set_value_cansleep(priv->cs, 1);
+	ret = spi_sync_transfer(priv->spi, &xfer, 1);
+	gpiod_set_value_cansleep(priv->cs, 0);
+
+	if (ret) {
+		priv->spi_errors++;
+		dev_err(&priv->spi->dev, "SPI transfer failed: %d\n", ret);
+		return ret;
+	}
+
+	priv->last_status = priv->rx_buf[0];
+	if (priv->last_status & SSI_STAT_PE)
+		priv->parity_errors++;
+	return 0;
+}
+
+/* Raise MCU_REQ and wait until the chip answers on MCU_RESP */
+static int bcm4775x_hello(struct bcm4775x *priv)
+{
+	int count = 0;
+
+	gpiod_set_value_cansleep(priv->mcu_req, 1);
+	while (!gpiod_get_value_cansleep(priv->mcu_resp)) {
+		if (++count > BCM4775X_HELLO_MS) {
+			gpiod_set_value_cansleep(priv->mcu_req, 0);
+			priv->hello_fail++;
+			return -ETIMEDOUT;
+		}
+		usleep_range(1000, 1200);
+		if (count % 20 == 0) {
+			gpiod_set_value_cansleep(priv->mcu_req, 0);
+			usleep_range(1000, 1200);
+			gpiod_set_value_cansleep(priv->mcu_req, 1);
+			usleep_range(1000, 1200);
+		}
+	}
+	return count;
+}
+
+static void bcm4775x_bye(struct bcm4775x *priv)
+{
+	gpiod_set_value_cansleep(priv->mcu_req, 0);
+}
+
+static void bcm4775x_hub_rx(struct bcm4775x *priv, const u8 *data,
+			    unsigned int len);
+
+static void bcm4775x_push_rx(struct bcm4775x *priv, const u8 *data,
+			     unsigned int len)
+{
+	unsigned int done;
+
+	if (!len)
+		return;
+	if (priv->hub_active) {
+		priv->rx_bytes += len;
+		bcm4775x_hub_rx(priv, data, len);
+		return;
+	}
+	done = kfifo_in(&priv->rx_fifo, data, len);
+	priv->rx_bytes += done;
+	if (done != len) {
+		priv->rx_dropped += len - done;
+		dev_warn_ratelimited(&priv->spi->dev,
+				     "receive buffer overrun, %u bytes lost\n",
+				     len - done);
+	}
+	wake_up_interruptible(&priv->wait);
+}
+
+/* Read one frame from the chip. Returns the number of bytes or an error. */
+static int bcm4775x_ssi_rx(struct bcm4775x *priv)
+{
+	unsigned int len, room;
+	int ret;
+
+	room = kfifo_avail(&priv->rx_fifo);
+	if (!room)
+		return -ENOSPC;
+
+	/* how much does the chip have? */
+	memset(priv->tx_buf, 0, SSI_RX_CTRL_LEN);
+	priv->tx_buf[0] = SSI_RX_CTRL;
+	ret = bcm4775x_xfer(priv, SSI_RX_CTRL_LEN);
+	if (ret)
+		return ret;
+
+	len = ssi_get_len(priv->rx_buf + 1);
+	if (!len)
+		len = SSI_MIN_FRAME;	/* as the vendor driver: try anyway */
+	len = min3(len, room, bcm4775x_frame_len() - SSI_RX_CTRL_LEN);
+
+	memset(priv->tx_buf, 0, len + SSI_RX_CTRL_LEN);
+	priv->tx_buf[0] = SSI_RX_CTRL;
+	ret = bcm4775x_xfer(priv, len + SSI_RX_CTRL_LEN);
+	if (ret)
+		return ret;
+
+	len = min(len, ssi_get_len(priv->rx_buf + 1));
+	priv->rx_frames++;
+	bcm4775x_push_rx(priv, priv->rx_buf + SSI_RX_CTRL_LEN, len);
+	return len;
+}
+
+/*
+ * Write @len bytes that already sit at tx_buf + 3. The link is full duplex:
+ * the chip clocks out its own pending bytes during the same transfer, and
+ * reports after our data how many of our bytes it accepted (flow control).
+ */
+static int bcm4775x_ssi_tx(struct bcm4775x *priv, unsigned int len)
+{
+	u8 *tx = priv->tx_buf, *rx = priv->rx_buf;
+	unsigned int mwrite = len, nread = 0, xlen, got, written;
+	int retries = SSI_FC_RETRIES;
+	int ret;
+
+	do {
+		xlen = max(mwrite, nread);
+		tx[0] = SSI_TX_CTRL;
+		ssi_set_len(tx + 1, mwrite);
+		if (xlen > mwrite)
+			memset(tx + 1 + SSI_LEN_BYTES + mwrite, 0, xlen - mwrite);
+		ssi_set_len(tx + 1 + SSI_LEN_BYTES + xlen, 0);
+
+		ret = bcm4775x_xfer(priv, xlen + SSI_TX_CTRL_LEN);
+		if (ret)
+			return ret;
+		priv->tx_frames++;
+
+		/*
+		 * Bytes from the chip that came along: up to mwrite bytes
+		 * before the flow control field, the rest (if we clocked
+		 * more than we wrote) after it.
+		 */
+		nread = ssi_get_len(rx + 1);
+		if (nread > bcm4775x_frame_len() - SSI_TX_CTRL_LEN)
+			nread = bcm4775x_frame_len() - SSI_TX_CTRL_LEN;
+		got = min(nread, mwrite);
+		bcm4775x_push_rx(priv, rx + 1 + SSI_LEN_BYTES, got);
+		nread -= got;
+		got = min(nread, xlen - mwrite);
+		bcm4775x_push_rx(priv,
+				 rx + 1 + SSI_LEN_BYTES + mwrite + SSI_LEN_BYTES,
+				 got);
+		nread -= got;
+
+		/* flow control: how much of our data was taken */
+		written = ssi_get_len(rx + 1 + SSI_LEN_BYTES + mwrite);
+		if (written > mwrite) {
+			priv->fc_errors++;
+			dev_err_ratelimited(&priv->spi->dev,
+					    "flow control error: %u of %u written\n",
+					    written, mwrite);
+			return -EIO;
+		}
+		priv->tx_bytes += written;
+		if (written == mwrite)
+			return 0;
+
+		priv->fc_retries++;
+		mwrite -= written;
+		memmove(tx + 1 + SSI_LEN_BYTES, tx + 1 + SSI_LEN_BYTES + written,
+			mwrite);
+	} while (--retries > 0);
+
+	dev_err_ratelimited(&priv->spi->dev,
+			    "chip did not take %u bytes (status %#04x)\n",
+			    mwrite, priv->last_status);
+	return -EIO;
+}
+
+static void bcm4775x_irq_unmask(struct bcm4775x *priv)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->irq_lock, flags);
+	if (priv->irq_masked) {
+		priv->irq_masked = false;
+		enable_irq(priv->irq);
+	}
+	spin_unlock_irqrestore(&priv->irq_lock, flags);
+}
+
+static void bcm4775x_irq_enable(struct bcm4775x *priv, bool on)
+{
+	/* priv->lock held */
+	if (on && !priv->irq_on && priv->powered && priv->opened &&
+	    !priv->suspended) {
+		priv->irq_on = true;
+		enable_irq(priv->irq);
+	} else if (!on && priv->irq_on) {
+		priv->irq_on = false;
+		disable_irq(priv->irq);
+	}
+}
+
+static void bcm4775x_work(struct work_struct *work)
+{
+	struct bcm4775x *priv = container_of(work, struct bcm4775x, work);
+	unsigned int max_data = bcm4775x_frame_len() - SSI_TX_CTRL_LEN;
+	bool rx_full = false;
+	int ret = 0;
+
+	mutex_lock(&priv->io_lock);
+	if (!priv->powered || priv->suspended)
+		goto out;
+
+	ret = bcm4775x_hello(priv);
+	if (ret < 0) {
+		dev_err_ratelimited(&priv->spi->dev,
+				    "MCU_RESP does not answer MCU_REQ\n");
+		priv->link_error = true;
+		/* drop pending output, a dead chip will not take it */
+		kfifo_reset_out(&priv->tx_fifo);
+		wake_up_interruptible(&priv->wait);
+		goto out;
+	}
+	priv->link_error = false;
+
+	do {
+		unsigned int n;
+
+		ret = 0;
+		if (gpiod_get_value_cansleep(priv->host_req)) {
+			ret = bcm4775x_ssi_rx(priv);
+			if (ret == -ENOSPC) {
+				rx_full = true;
+				ret = 0;
+			} else if (ret < 0) {
+				break;
+			}
+		}
+
+		n = kfifo_out(&priv->tx_fifo, priv->tx_buf + 1 + SSI_LEN_BYTES,
+			      max_data);
+		if (n) {
+			ret = bcm4775x_ssi_tx(priv, n);
+			wake_up_interruptible(&priv->wait);
+			if (ret)
+				break;
+		}
+	} while (!kfifo_is_empty(&priv->tx_fifo) ||
+		 (gpiod_get_value_cansleep(priv->host_req) && !rx_full));
+
+	bcm4775x_bye(priv);
+	if (ret < 0) {
+		priv->link_error = true;
+		wake_up_interruptible(&priv->wait);
+	}
+out:
+	mutex_unlock(&priv->io_lock);
+
+	/*
+	 * HOST_REQ is a level interrupt and was masked by the handler. Leave it
+	 * masked after an error or while the reader is not draining the buffer;
+	 * read() and write() queue the work again.
+	 */
+	if (ret >= 0 && !rx_full)
+		bcm4775x_irq_unmask(priv);
+}
+
+/* The handler masks the level interrupt, the work unmasks it when served */
+static irqreturn_t bcm4775x_irq(int irq, void *data)
+{
+	struct bcm4775x *priv = data;
+
+	spin_lock(&priv->irq_lock);
+	if (!priv->irq_masked) {
+		priv->irq_masked = true;
+		disable_irq_nosync(irq);
+	}
+	spin_unlock(&priv->irq_lock);
+
+	queue_work(priv->wq, &priv->work);
+	return IRQ_HANDLED;
+}
+
+static void bcm4775x_kick(struct bcm4775x *priv)
+{
+	queue_work(priv->wq, &priv->work);
+}
+
+static int bcm4775x_power_on(struct bcm4775x *priv)
+{
+	int ret;
+
+	/* priv->lock held */
+	if (priv->powered)
+		return 0;
+
+	ret = regulator_enable(priv->vdd);
+	if (ret)
+		return ret;
+	usleep_range(10000, 12000);
+
+	ret = pinctrl_select_state(priv->pinctrl, priv->pins_active);
+	if (ret) {
+		regulator_disable(priv->vdd);
+		return ret;
+	}
+	gpiod_direction_output(priv->cs, 0);
+	gpiod_set_value_cansleep(priv->mcu_req, 0);
+
+	mutex_lock(&priv->rx_lock);
+	mutex_lock(&priv->tx_lock);
+	mutex_lock(&priv->io_lock);
+	kfifo_reset(&priv->rx_fifo);
+	kfifo_reset(&priv->tx_fifo);
+	priv->link_error = false;
+	priv->powered = true;
+	mutex_unlock(&priv->io_lock);
+	mutex_unlock(&priv->tx_lock);
+	mutex_unlock(&priv->rx_lock);
+
+	bcm4775x_irq_enable(priv, true);
+	dev_info(&priv->spi->dev, "powered on\n");
+	return 0;
+}
+
+static void bcm4775x_power_off(struct bcm4775x *priv)
+{
+	/* priv->lock held */
+	if (!priv->powered)
+		return;
+
+	bcm4775x_irq_enable(priv, false);
+	mutex_lock(&priv->io_lock);
+	priv->powered = false;
+	mutex_unlock(&priv->io_lock);
+	cancel_work_sync(&priv->work);
+	bcm4775x_irq_unmask(priv);
+
+	/* nothing may drive the chip once its supply is gone */
+	gpiod_set_value_cansleep(priv->nstandby, 0);
+	gpiod_set_value_cansleep(priv->mcu_req, 0);
+	gpiod_direction_input(priv->cs);
+	pinctrl_select_state(priv->pinctrl, priv->pins_idle);
+	regulator_disable(priv->vdd);
+	wake_up_interruptible(&priv->wait);
+	dev_info(&priv->spi->dev, "powered off\n");
+}
+
+/* --- sensor hub: transport layer, RPCs, SSP, IIO devices --------------------- */
+
+/*
+ * On top of the SSI byte stream the chip (boot ROM and firmware alike) speaks
+ * Broadcom's transport layer:
+ *
+ *   B0 00 <body> B0 01, body = seq, size, flags, [detail per flag], payload, crc
+ *
+ * (B0, XON and XOFF escaped as B0 03/04/05; CRC-8 over the body without the
+ * sequence number, nibbles swapped). The payload carries RPCs: id, length,
+ * data. The boot ROM takes memory writes, so the firmware ("patch") is
+ * written into RAM and started; the firmware then tunnels Samsung's SSP
+ * sensor protocol through the SensorRequest/SensorResponse RPCs.
+ *
+ * The receive side follows bbd_rpc_lh.c of the vendor kernel; the transmit
+ * side, the RPC numbers and the boot sequence were worked out against the
+ * chip.
+ */
+
+#define TL_ESC			0xb0
+#define TL_SOP			0x00
+#define TL_EOP			0x01
+#define TL_XON			0x11
+#define TL_XOFF			0x13
+
+#define TL_F_ACK		BIT(0)
+#define TL_F_RELIABLE		BIT(1)
+#define TL_F_REL_ACK		BIT(2)
+#define TL_F_REL_NACK		BIT(3)
+#define TL_F_SIZE_EXT		BIT(6)
+#define TL_F_EXT		BIT(7)
+#define TL_F_INTERNAL		BIT(8)
+#define TL_F_IGNORE_SEQ		BIT(9)
+
+#define TL_MAX_PAYLOAD		1024
+#define TL_MAX_BODY		(TL_MAX_PAYLOAD + 16)
+#define TL_RX_MAX		(2048 + 16)
+
+#define RPC_GET_VERSION		0x00
+#define RPC_VERSION_RESPONSE	0x03
+#define RPC_MEMORY_WRITE	0x05
+#define RPC_SENSOR_REQUEST	0x20
+#define RPC_SENSOR_RESPONSE	0x21
+#define RPC_START_SCRATCH_APP	0x2e
+
+#define PATCH_CMD_WRITE		0xf1
+
+#define SSP_AP2HUB_READ		0
+#define SSP_AP2HUB_WRITE	1
+#define SSP_HUB2AP_WRITE	2
