+	&dev_attr_manufacturer.attr,
+	&dev_attr_product.attr,
+	&dev_attr_cp_mif_khz.attr,
+	&dev_attr_cp_int_khz.attr,
+	&dev_attr_pda_active.attr,
+	&dev_attr_call_active.attr,
