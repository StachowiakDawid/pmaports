+static int s5000ap_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct resource res;
+	struct s5000ap *s;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	mutex_init(&s->lock);
+	platform_set_drvdata(pdev, s);
+
+	/* Mapping does not touch the blocks; nothing is read or written here. */
+	s->mbox = devm_platform_ioremap_resource_byname(pdev, "mailbox");
+	if (IS_ERR(s->mbox))
+		return PTR_ERR(s->mbox);
+	s->cfg = devm_platform_ioremap_resource_byname(pdev, "ap2cp-cfg");
+	if (IS_ERR(s->cfg))
+		return PTR_ERR(s->cfg);
+
+	s->irq = platform_get_irq(pdev, 0);
+	if (s->irq < 0)
+		return s->irq;
+
+	s->pclk = devm_clk_get(dev, "pclk");
+	if (IS_ERR(s->pclk))
+		return dev_err_probe(dev, PTR_ERR(s->pclk), "no mailbox clock\n");
+
+	s->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						 "samsung,syscon-phandle");
+	if (IS_ERR(s->pmu))
+		return dev_err_probe(dev, PTR_ERR(s->pmu), "no PMU regmap\n");
+
+	s->rev_gpios = devm_gpiod_get_array_optional(dev, "samsung,rev",
+						     GPIOD_ASIS);
+	if (IS_ERR(s->rev_gpios))
+		return dev_err_probe(dev, PTR_ERR(s->rev_gpios), "rev gpios\n");
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!np)
+		return -ENODEV;
+	ret = of_address_to_resource(np, 0, &res);
+	of_node_put(np);
+	if (ret)
+		return ret;
+	s->mem_phys = res.start;
+	s->mem_size = resource_size(&res);
+
+	ret = of_property_read_u32(dev->of_node, "samsung,ipc-offset",
+				   &s->ipc_off);
+	if (!ret)
+		ret = of_property_read_u32(dev->of_node, "samsung,ipc-size",
+					   &s->ipc_size);
+	if (ret || s->ipc_off + s->ipc_size > s->mem_size ||
+	    s->ipc_size < SHM_RAW_RX_BUFF + SHM_RAW_RX_SIZE)
+		return -EINVAL;
+
+	device_init_wakeup(dev, true);
+	atomic_set(&s->dw_other, 0);
+	spin_lock_init(&s->tx_lock);
+	INIT_WORK(&s->rx_work, s5000ap_rx_work);
+	INIT_WORK(&s->link_work, s5000ap_link_work);
+	INIT_DELAYED_WORK(&s->tx_wake, s5000ap_tx_wake);
+	INIT_WORK(&s->dvfs_work, s5000ap_dvfs_work);
+	ret = s5000ap_chan_register(s);
+	if (ret)
+		return ret;
+	ret = s5000ap_net_register(s);
+	if (ret) {
+		s5000ap_chan_unregister(s);
+		return ret;
+	}
+
+	s->dbg = debugfs_create_dir("s5000ap", NULL);
+	debugfs_create_file("ctl", 0200, s->dbg, s, &s5000ap_ctl_fops);
+	debugfs_create_file_size("cpmem", 0600, s->dbg, s, &s5000ap_mem_fops,
+				 s->mem_size);
+	debugfs_create_bool("link_up", 0400, s->dbg, &s->link_up);
+
+	/* last: nothing below can fail, s5000ap_remove() unregisters it */
+	s->dw.again = s5000ap_dark_again;
+	s->dw.data = s;
+	s->dw.irq = s->irq;
+	s->dw.ws = dev->power.wakeup;
+	s->dw.enabled = &dark_wake;
+	if (exynos9820_dark_wake_register(&s->dw))
+		dev_info(dev, "dark wake not available\n");
+
+	dev_info(dev, "ready, nothing touched (allow_boot %d)\n", allow_boot);
+	return 0;
+}
+
+static void s5000ap_remove(struct platform_device *pdev)
+{
+	struct s5000ap *s = platform_get_drvdata(pdev);
+
+	exynos9820_dark_wake_unregister(&s->dw);
+	debugfs_remove_recursive(s->dbg);
+	s5000ap_net_unregister(s);
+	s5000ap_chan_unregister(s);
+	if (s->mbox_up)
+		disable_irq(s->irq);
+	cancel_work_sync(&s->link_work);
+	cancel_work_sync(&s->rx_work);
+	cancel_work_sync(&s->dvfs_work);
+	mutex_lock(&s->lock);
+	s5000ap_pda_set(s, true, "remove");
+	if (s->cp_on)
+		s5000ap_step_off(s);
+	if (s->mbox_up) {
+		enable_irq(s->irq);
+		disable_irq_wake(s->irq);
+		free_irq(s->irq, s);
+		clk_disable_unprepare(s->pclk);
+	}
+	if (s->mem)
+		memunmap(s->mem);
+	if (s->pkt)
+		memunmap(s->pkt);
+	mutex_unlock(&s->lock);
+}
+
+/*
+ * The mailbox keeps its registers through suspend (the CP runs on), so
+ * PDA_ACTIVE stays as userspace set it.  Repair a lost high bit.  trylock:
+ * a step may still hold the lock; the next resume looks again.
+ */
+static int s5000ap_resume(struct device *dev)
+{
+	struct s5000ap *s = dev_get_drvdata(dev);
+	u32 v;
+
+	if (!mutex_trylock(&s->lock))
+		return 0;
+	if (s->mbox_up && s->link_up) {
+		if (!s->pda_low) {
+			v = mbox_rd(s, MBOX_ISSR(MBX_AP2CP_STATUS));
+			if (!(v & AP_STATUS_PDA_ACTIVE)) {
+				dev_warn(dev, "resume: PDA_ACTIVE lost (ap_status 0x%08x), raising\n",
+					 v);
+				mbox_wr(s, v | AP_STATUS_PDA_ACTIVE,
+					MBOX_ISSR(MBX_AP2CP_STATUS));
+				mbox_wr(s, BIT(INT_AP2CP_ACTIVE), MBOX_INTGR1);
+			}
+		}
+	}
+	mutex_unlock(&s->lock);
+	return 0;
+}
+
+/* packet-data counters: any change means DL traffic (or a dropped frame) */
+static u32 s5000ap_dw_pkts(struct s5000ap *s)
+{
+	return s->pkt_rx + s->pkt_bad + s->pkt_other_ch + s->zc_rx +
+	       s->zc_bad + s->rx_dropped;
+}
+
+static void s5000ap_dw_snap(struct s5000ap *s)
+{
+	s->dw_snap_benign = s->dw_benign;
+	s->dw_snap_other = atomic_read(&s->dw_other);
+	s->dw_snap_frames = s->rx_frames;
+	s->dw_snap_pkts = s5000ap_dw_pkts(s);
+	s->dw_irq_bits = 0;
+}
+
+/*
+ * exynos9820-suspend ->suspend_again, after the early resume of a SLEEP the
+ * CP mailbox ended (and nothing else): true = SLEEP again.  Every ring
+ * buffer since the snapshot must be a signal report; anything else, or no
+ * link, or a CP wake lock, resumes the system.
+ */
+static bool s5000ap_dark_again(void *data)
+{
+	struct s5000ap *s = data;
+	u32 benign, frames, other, pkts;
+	const char *why = NULL;
+
+	if (!READ_ONCE(s->dw_armed))
+		return false;
+	flush_work(&s->rx_work);
+	msleep(S5000AP_DARK_SETTLE_MS);
+	flush_work(&s->rx_work);
+	benign = s->dw_benign - s->dw_snap_benign;
+	frames = s->rx_frames - s->dw_snap_frames;
+	other = atomic_read(&s->dw_other) - s->dw_snap_other;
+	pkts = s5000ap_dw_pkts(s) - s->dw_snap_pkts;
+
+	if (!s->link_up)
+		why = "link down";
+	else if (READ_ONCE(s->cp_wakelock))
+		why = "CP wake lock";
+	else if (other)
+		why = "IPC or CP interrupt";
+	else if (pkts)
+		why = "packet data";
+	else if (frames != benign)
+		why = "other ring data";
+	else if (s->dw_loops >= S5000AP_DARK_MAX)
+		why = "dark wake limit reached";
+	if (why) {
+		dev_info(s->dev, "dark wake: no (%s), %u dark wakes before, irq bits %#x\n",
+			 why, s->dw_loops, s->dw_irq_bits >> 16);
+		return false;
+	}
+	s->dw_loops++;
+	s5000ap_dw_snap(s);
+	pm_relax(s->dev);	/* end the wakeup event; no CP wake lock held */
+	dev_dbg(s->dev, "dark wake %u: %u reports\n", s->dw_loops, benign);
+	return true;
+}
+
+static int s5000ap_suspend(struct device *dev)
+{
+	struct s5000ap *s = dev_get_drvdata(dev);
+
+	s->dw_loops = 0;
+	if (READ_ONCE(s->call_busy) && s->link_up) {
+		dev_warn(dev, "voice call in progress: refusing system sleep\n");
+		return -EBUSY;
+	}
+	if (!READ_ONCE(dark_wake) || !s->link_up)
+		return 0;
+	flush_work(&s->rx_work);
+	s5000ap_dw_snap(s);
+	WRITE_ONCE(s->dw_armed, true);
+	return 0;
+}
+
+static int s5000ap_pm_resume(struct device *dev)
+{
+	struct s5000ap *s = dev_get_drvdata(dev);
+
+	if (READ_ONCE(s->dw_armed)) {
+		WRITE_ONCE(s->dw_armed, false);
+		if (s->dw_loops)
+			dev_info(dev, "dark wake: slept again %u times before this resume\n",
+				 s->dw_loops);
+	}
+	return s5000ap_resume(dev);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(s5000ap_pm, s5000ap_suspend, s5000ap_pm_resume);
+
+static const struct of_device_id s5000ap_of_match[] = {
+	{ .compatible = "samsung,exynos9820-s5000ap-boot" },
+	{ }
+};
+/* No MODULE_DEVICE_TABLE: load by hand only. */
+
+static struct platform_driver s5000ap_driver = {
+	.probe = s5000ap_probe,
+	.remove = s5000ap_remove,
+	.driver = {
+		.name = "s5000ap-boot",
