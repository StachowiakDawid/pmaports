From 59ab5b1dd0187bb56ae42a5cbb567a90ee51814a Mon Sep 17 00:00:00 2001
From: StachowiakDawid <dawidos234@gmail.com>
Date: Mon, 23 Nov 2026 18:38:09 +0100
Subject: [PATCH] misc: add a Samsung S5000AP (Exynos 9820 CP) modem driver

Driver for the Shannon 5000AP cellular processor integrated in the
Exynos 9820: CP power and boot control for the
userspace loader (allow_boot; debugfs ctl, cpmem and link_up), the
shared memory link (legacy and SBD rings) with the link bring-up after
the CP's INIT_START/PHONE_START, and the interfaces on top of it:

 - character devices for the IPC/RFS channels with multi-frame
   messages,
 - rmnet packet data with zero-copy downlink buffers,
 - a WWAN device with an MBIM control port and an AT port bridged to
   userspace, and a second link for the IMS PDN,
 - CP restart without an AP reboot,
 - the CP's MIF/INT DVFS requests are served as floors,
 - system sleep: the CP mailbox interrupt wakes the system; pda_active
   tells the CP that the AP is idle, call_active refuses system sleep
   during a call, and with dark_wake=1 a wake that only brought signal
   reports goes back to sleep at once.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 drivers/misc/Kconfig        |   19 +
 drivers/misc/Makefile       |    1 +
 drivers/misc/s5000ap-boot.c | 3309 +++++++++++++++++++++++++++++++++++
 3 files changed, 3329 insertions(+)
 create mode 100644 drivers/misc/s5000ap-boot.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 8241fa450d..e91ae8be27 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -440,6 +440,25 @@ config MISC_RTSX
 	tristate
 	default MISC_RTSX_PCI || MISC_RTSX_USB
 
+config S5000AP_BOOT
+	tristate "Samsung S5000AP (Exynos 9820 CP) boot and IPC link driver"
+	depends on ARCH_EXYNOS && OF && DEBUG_FS && HAVE_ARM_SMCCC
+	depends on WWAN
+	select MFD_SYSCON
+	help
+	  Loader and shared memory link for the Shannon 5000 cellular
+	  processor integrated in the Exynos 9820. It places the signed CP
+	  image in the shared DRAM, asks the secure monitor to verify and
+	  start it and logs what the CP reports through the AP/CP mailbox.
+	  Once the CP is up, the SBD shared-memory link is set up and the
+	  IPC channels are exposed as /dev/umts_ipc0, /dev/umts_ipc1 and
+	  /dev/umts_rfs0 for a user space RIL and RFS server. Packet data
+	  goes through an rmnet and a WWAN network device, with MBIM and AT
+	  control ports for user space.
+
+	  The module is never loaded automatically and does nothing until
+	  told to through debugfs. If unsure, say N.
+
 config OPEN_DICE
 	tristate "Open Profile for DICE driver"
 	depends on OF_RESERVED_MEM
