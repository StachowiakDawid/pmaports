+/*
+ * A CMU inside a switchable power domain (CMU_AUD in PD_AUD) is probed at
+ * core_initcall, before genpd can be used, and its registers hang the bus
+ * while the domain is off. If the bootloader left the domain off, switch
+ * it on the way the PMU sequence does (CONFIGURATION = 1, wait for
+ * STATUS); the domain node is given as "samsung,power-domain" (not
+ * "power-domains", which would make this __init probe defer).
+ */
+static int __init exynos9820_cmu_power_on(struct device *dev)
+{
+	struct device_node *pd_np;
+	void __iomem *pd;
+	u32 val;
+	int ret = 0;
+
+	pd_np = of_parse_phandle(dev->of_node, "samsung,power-domain", 0);
+	if (!pd_np)
+		return 0;
+
+	pd = of_iomap(pd_np, 0);
+	of_node_put(pd_np);
+	if (!pd)
+		return -ENOMEM;
+
+	if (!(readl(pd + 0x4) & 0x1)) {
+		dev_info(dev, "power domain is off, switching it on\n");
+		writel(0x1, pd);
+		ret = readl_poll_timeout_atomic(pd + 0x4, val, val & 0x1, 1,
+						10000);
+		if (ret)
+			dev_err(dev, "power domain did not come up (%#x)\n", val);
+	}
+	iounmap(pd);
+
+	return ret;
+}
