diff --git a/drivers/clk/samsung/clk-exynos-clkout.c b/drivers/clk/samsung/clk-exynos-clkout.c
index 2d65f86e5d..e8514ba929 100644
--- a/drivers/clk/samsung/clk-exynos-clkout.c
+++ b/drivers/clk/samsung/clk-exynos-clkout.c
@@ -19,14 +19,16 @@
 
 #define DRV_NAME			"exynos-clkout"
 
-#define EXYNOS_CLKOUT_NR_CLKS		1
+#define EXYNOS_CLKOUT_NR_CLKS		2
 #define EXYNOS_CLKOUT_PARENTS		32
 
 #define EXYNOS_PMU_DEBUG_REG		0xa00
+#define EXYNOS9820_CLKOUT1_REG		0xa0c
 #define EXYNOS_CLKOUT_DISABLE_SHIFT	0
 #define EXYNOS_CLKOUT_MUX_SHIFT		8
 #define EXYNOS4_CLKOUT_MUX_MASK		0xf
 #define EXYNOS5_CLKOUT_MUX_MASK		0x1f
+#define EXYNOS9820_CLKOUT_MUX_MASK	0x3f
 
 struct exynos_clkout {
 	struct clk_gate gate;
@@ -35,11 +37,19 @@ struct exynos_clkout {
 	void __iomem *reg;
 	struct device_node *np;
 	u32 pmu_debug_save;
+	u32 clkout1_save;
+	bool has_clkout1;
 	struct clk_hw_onecell_data data;
 };
 
 struct exynos_clkout_variant {
 	u32 mux_mask;
+	/*
+	 * Exynos9820 has a second output, CLKOUT1 (PMU + 0xa0c, same layout:
+	 * mux [13:8], bit 0 = disable). On the Galaxy S10 family it feeds the
+	 * NFC controller ("OSC_NFC" downstream) with TCXO, mux input 0.
+	 */
+	bool has_clkout1;
 };
 
 static const struct exynos_clkout_variant exynos_clkout_exynos4 = {
@@ -50,6 +60,11 @@ static const struct exynos_clkout_variant exynos_clkout_exynos5 = {
 	.mux_mask	= EXYNOS5_CLKOUT_MUX_MASK,
 };
 
+static const struct exynos_clkout_variant exynos_clkout_exynos9820 = {
+	.mux_mask	= EXYNOS9820_CLKOUT_MUX_MASK,
+	.has_clkout1	= true,
+};
+
 static const struct of_device_id exynos_clkout_ids[] = {
 	{
 		.compatible = "samsung,exynos3250-pmu",
@@ -75,6 +90,9 @@ static const struct of_device_id exynos_clkout_ids[] = {
 	}, {
 		.compatible = "samsung,exynos5433-pmu",
 		.data = &exynos_clkout_exynos5,
+	}, {
+		.compatible = "samsung,exynos9820-pmu",
+		.data = &exynos_clkout_exynos9820,
 	}, { }
 };
 
@@ -82,7 +100,8 @@ static const struct of_device_id exynos_clkout_ids[] = {
  * Device will be instantiated as child of PMU device without its own
  * device node.  Therefore match compatibles against parent.
  */
-static int exynos_clkout_match_parent_dev(struct device *dev, u32 *mux_mask)
+static int exynos_clkout_match_parent_dev(struct device *dev, u32 *mux_mask,
+					  bool *has_clkout1)
 {
 	const struct exynos_clkout_variant *variant;
 	const struct of_device_id *match;
@@ -105,6 +124,47 @@ static int exynos_clkout_match_parent_dev(struct device *dev, u32 *mux_mask)
 	variant = match->data;
 
 	*mux_mask = variant->mux_mask;
+	*has_clkout1 = variant->has_clkout1;
+
+	return 0;
+}
+
+/*
+ * CLKOUT1 is modelled as a plain gate with the "tcxo" clock of the PMU node
+ * as its parent. The mux is not touched: it must already select TCXO
+ * (input 0), which is its reset value. Without a "tcxo" clock, or with a
+ * different mux setting, CLKOUT1 is not registered (index 1 stays empty).
+ */
+static int exynos_clkout_register_clkout1(struct device *dev,
+					  struct exynos_clkout *clkout)
+{
+	struct clk_hw *hw;
+	const char *parent;
+	struct clk *tcxo;
+	u32 val;
+
+	tcxo = of_clk_get_by_name(clkout->np, "tcxo");
+	if (IS_ERR(tcxo))
+		return 0;
+	parent = __clk_get_name(tcxo);
+	clk_put(tcxo);
+
+	val = readl(clkout->reg + EXYNOS9820_CLKOUT1_REG);
+	if ((val >> EXYNOS_CLKOUT_MUX_SHIFT) & EXYNOS9820_CLKOUT_MUX_MASK) {
+		dev_warn(dev, "CLKOUT1 mux is not TCXO (0x%08x), not registered\n",
+			 val);
+		return 0;
+	}
+
+	hw = clk_hw_register_gate(NULL, "pmu_clkout1", parent, 0,
+				  clkout->reg + EXYNOS9820_CLKOUT1_REG,
+				  EXYNOS_CLKOUT_DISABLE_SHIFT,
+				  CLK_GATE_SET_TO_DISABLE, &clkout->slock);
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+
+	clkout->data.hws[1] = hw;
+	clkout->data.num = 2;
 
 	return 0;
 }
@@ -122,7 +182,8 @@ static int exynos_clkout_probe(struct platform_device *pdev)
 	if (!clkout)
 		return -ENOMEM;
 
-	ret = exynos_clkout_match_parent_dev(&pdev->dev, &mux_mask);
+	ret = exynos_clkout_match_parent_dev(&pdev->dev, &mux_mask,
+					     &clkout->has_clkout1);
 	if (ret)
 		return ret;
 
@@ -173,7 +234,7 @@ static int exynos_clkout_probe(struct platform_device *pdev)
 	clkout->mux.shift = EXYNOS_CLKOUT_MUX_SHIFT;
 	clkout->mux.lock = &clkout->slock;
 
-	clkout->data.num = EXYNOS_CLKOUT_NR_CLKS;
+	clkout->data.num = 1;
 	clkout->data.hws[0] = clk_hw_register_composite(NULL, "clkout",
 				parent_names, parent_count, &clkout->mux.hw,
 				&clk_mux_ops, NULL, NULL, &clkout->gate.hw,
@@ -184,6 +245,12 @@ static int exynos_clkout_probe(struct platform_device *pdev)
 		goto err_unmap;
 	}
 
+	if (clkout->has_clkout1) {
+		ret = exynos_clkout_register_clkout1(&pdev->dev, clkout);
+		if (ret)
+			goto err_clk_unreg;
+	}
+
 	ret = of_clk_add_hw_provider(clkout->np, of_clk_hw_onecell_get, &clkout->data);
 	if (ret)
 		goto err_clk_unreg;
@@ -191,6 +258,8 @@ static int exynos_clkout_probe(struct platform_device *pdev)
 	return 0;
 
 err_clk_unreg:
+	if (clkout->data.num > 1)
+		clk_hw_unregister_gate(clkout->data.hws[1]);
 	clk_hw_unregister(clkout->data.hws[0]);
 err_unmap:
 	iounmap(clkout->reg);
@@ -209,6 +278,8 @@ static void exynos_clkout_remove(struct platform_device *pdev)
 	struct exynos_clkout *clkout = platform_get_drvdata(pdev);
 
 	of_clk_del_provider(clkout->np);
+	if (clkout->data.num > 1)
+		clk_hw_unregister_gate(clkout->data.hws[1]);
 	clk_hw_unregister(clkout->data.hws[0]);
 	iounmap(clkout->reg);
 }
@@ -218,6 +289,8 @@ static int exynos_clkout_suspend(struct device *dev)
 	struct exynos_clkout *clkout = dev_get_drvdata(dev);
 
 	clkout->pmu_debug_save = readl(clkout->reg + EXYNOS_PMU_DEBUG_REG);
+	if (clkout->data.num > 1)
+		clkout->clkout1_save = readl(clkout->reg + EXYNOS9820_CLKOUT1_REG);
 
 	return 0;
 }
@@ -227,6 +300,8 @@ static int exynos_clkout_resume(struct device *dev)
 	struct exynos_clkout *clkout = dev_get_drvdata(dev);
 
 	writel(clkout->pmu_debug_save, clkout->reg + EXYNOS_PMU_DEBUG_REG);
+	if (clkout->data.num > 1)
+		writel(clkout->clkout1_save, clkout->reg + EXYNOS9820_CLKOUT1_REG);
 
 	return 0;
 }
