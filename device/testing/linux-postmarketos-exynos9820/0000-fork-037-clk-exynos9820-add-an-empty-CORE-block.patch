From 8d32b89ab4ca5f68939494ef4d843318ac4d0e70 Mon Sep 17 00:00:00 2001
From: chiffathefox <chiffathefoxx@gmail.com>
Date: Sat, 25 Jul 2026 04:23:01 +0300
Subject: [PATCH 37/46] clk: exynos9820: add an empty CORE block

These clocks probably will never be used by any consumers and can be left out. The main point of this block is to match the DRCG_EN and MEMCLK downstream register values for this block

(cherry picked from commit 390407966c9bd22255952ff85b6e5ecadc61bc0f)
---
 drivers/clk/samsung/clk-exynos9820.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/clk/samsung/clk-exynos9820.c b/drivers/clk/samsung/clk-exynos9820.c
index a534b07c97..a8537dfaa9 100644
--- a/drivers/clk/samsung/clk-exynos9820.c
+++ b/drivers/clk/samsung/clk-exynos9820.c
@@ -1530,6 +1530,26 @@ static const struct samsung_cmu_info apm_cmu_info __initconst = {
 	.memclk_offset		= EXYNOS9820_MEMCLK_OFFSET,
 };
 
+/*
+ * Register offsets for CMU_CORE (0x1a030000)
+ */
+#define CORE_CMU_CORE_CONTROLLER_OPTION		0x0800
+
+static const unsigned long core_clk_regs[] __initconst = {
+	CORE_CMU_CORE_CONTROLLER_OPTION,
+};
+
+static const struct samsung_cmu_info core_cmu_info __initconst = {
+	.clk_regs		= core_clk_regs,
+	.nr_clk_regs		= ARRAY_SIZE(core_clk_regs),
+	.clk_name		= "bus",
+	.auto_clock_gate	= true,
+	.gate_dbg_offset	= EXYNOS9820_GATE_DBG_OFFSET,
+	.option_offset		= CORE_CMU_CORE_CONTROLLER_OPTION,
+	.drcg_offset		= EXYNOS9820_DRCG_EN_OFFSET,
+	.memclk_offset		= EXYNOS9820_MEMCLK_OFFSET,
+};
+
 /*
  * Register offsets for CMU_BUSC (0x1a200000)
  */
@@ -2926,6 +2946,9 @@ static const struct of_device_id exynos9820_cmu_of_match[] = {
 	}, {
 		.compatible = "samsung,exynos9820-cmu-apm",
 		.data = &apm_cmu_info,
+	}, {
+		.compatible = "samsung,exynos9820-cmu-core",
+		.data = &core_cmu_info,
 	}, {
 		.compatible = "samsung,exynos9820-cmu-busc",
 		.data = &busc_cmu_info,
