 drivers/clk/samsung/clk-exynos9820.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/samsung/clk-exynos9820.c b/drivers/clk/samsung/clk-exynos9820.c
index d25e946bf9..8e243bf3f5 100644
