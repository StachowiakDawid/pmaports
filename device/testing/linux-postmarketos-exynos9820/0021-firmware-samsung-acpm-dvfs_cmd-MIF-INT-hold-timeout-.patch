+#define ACPM_INIT_LOG_REAR		0x34
+#define ACPM_INIT_LOG_FRONT		0x38
+#define ACPM_INIT_LOG_DATA		0x3c
+#define ACPM_INIT_LOG_ESIZE		0x40
+#define ACPM_INIT_LOG_ELEN		0x44
+#define ACPM_INIT_DUMP_WORDS		48
