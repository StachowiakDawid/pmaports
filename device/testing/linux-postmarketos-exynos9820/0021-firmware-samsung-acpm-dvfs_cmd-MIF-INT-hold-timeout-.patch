+/*
+ * Print the @n newest entries of the firmware log ring (the ones right
+ * before the firmware's write pointer), without consuming anything. The
+ * firmware overwrites old entries when the AP does not drain the ring, so
+ * the oldest unread entries can be minutes old; the newest ones show what
+ * the APM did last.
+ */
+static void acpm_fw_log_tail(struct acpm_info *acpm, unsigned int n)
+{
+	void __iomem *init = (void __iomem *)acpm->shmem;
+	void __iomem *sram = acpm->sram_base;
+	u32 rear_off, front_off, data_off, esize, elen, rear, front, i, slot;
+
+	rear_off = readl(init + ACPM_INIT_LOG_REAR);
+	front_off = readl(init + ACPM_INIT_LOG_FRONT);
+	data_off = readl(init + ACPM_INIT_LOG_DATA);
+	esize = readl(init + ACPM_INIT_LOG_ESIZE);
+	elen = readl(init + ACPM_INIT_LOG_ELEN);
+
+	if (esize < 12 || esize > 64 + 8 || esize % 4 || !elen ||
+	    elen > 4096 || !acpm_sram_ok(acpm, rear_off, 4) ||
+	    !acpm_sram_ok(acpm, front_off, 4) ||
+	    !acpm_sram_ok(acpm, data_off, esize * elen))
+		return;
+
+	rear = readl(sram + rear_off);
+	front = readl(sram + front_off);
+	if (front >= elen)
+		return;
+	n = min(n, elen - 1);
+	dev_err(acpm->dev, "fw log tail: rear %u front %u, the %u newest entries:\n",
+		rear, front, n);
+	for (i = n; i; i--) {
+		slot = (front + elen - i) % elen;
+		acpm_fw_log_print(acpm, sram + data_off + esize * slot, esize,
+				  true, "[ACPM_FW tail]", slot);
+	}
