+/* One firmware log entry (esize bytes: header, string, value). */
+static void acpm_fw_log_print(struct acpm_info *acpm, void __iomem *e,
+			      u32 esize, bool err, const char *tag, u32 slot)
+{
+	u32 hdr = readl(e), val = readl(e + esize - 4);
+	unsigned int i, slen = esize - 8;
+	char str[64 + 1];
+
+	__ioread32_copy(str, e + 4, slen / 4);
+	str[slen] = '\0';
+	for (i = 0; i < slen && str[i]; i++)
+		if (str[i] < 0x20 || str[i] > 0x7e)
+			str[i] = '.';
