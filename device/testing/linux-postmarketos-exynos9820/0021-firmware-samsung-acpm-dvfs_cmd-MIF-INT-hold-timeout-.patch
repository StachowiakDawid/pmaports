From b38308b9deed8ecc0623d03471ec10d720f2acec Mon Sep 17 00:00:00 2001
From: StachowiakDawid <dawidos234@gmail.com>
Date: Mon, 23 Nov 2026 18:38:09 +0100
Subject: [PATCH] firmware: samsung: acpm: dvfs_cmd, MIF/INT hold, timeout
 dump, atomic xfer

Exynos 9820 additions to the ACPM protocol driver:

 - dvfs_cmd (/sys/module/acpm_protocol/parameters/dvfs_cmd,
   write-only): "<domain> <kHz>" sets the level of a DVFS domain,
   "<domain> get" queries it and "<domain> raw <cmd2> <cmd1> <cmd3>"
   sends any DVFS-type message. Nothing in the kernel scales the
   memory (MIF), internal bus (INT) and display domains on this SoC;
   userspace lowers them through this interface while the screen is
   off. Domains: 0 MIF, 1 INT, 2 CPUCL0, 3 CPUCL1, 4 CPUCL2, 10 G3D.
 - exynos_acpm_dvfs_hold(): an in-kernel user (the camera interface)
   holds MIF and INT at their boot levels while it runs. Lower
   dvfs_cmd requests are remembered and sent when the last hold is
   released; the held levels are always sent, as the firmware changes
   the levels on its own over system sleep and for the CP.
 - Every channel descriptor is validated at probe (non-zero offsets
   inside the SRAM mapping, sane qlen/mlen); channels without a usable
   queue are refused with -ENODEV. On the first transfer timeouts every
   channel's queue pointers, the init data words and the newest
   entries of the APM firmware's log ring are printed.
 - mbox_fixup (default off): mask the APM->AP mailbox interrupts of
   the polled channels and clear their pending bits after the RX queue
   was drained, as the vendor kernel does.
 - Atomic transfers: an "atomic" flag in struct acpm_xfer for use with
   IRQs off (try-locks instead of mutex waits, udelay-counted bounded
   waits), and exynos_acpm_pmic_dbg_bulk_read()/_write() on top of it.
   The suspend code uses them to leave progress codes in the PMIC,
   the only place that survives a forced reset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Signed-off-by: StachowiakDawid <dawidos234@gmail.com>
---
 drivers/firmware/samsung/exynos-acpm-dvfs.c   | 230 ++++++++-
 drivers/firmware/samsung/exynos-acpm-pmic.c   |  76 ++-
 drivers/firmware/samsung/exynos-acpm.c        | 455 +++++++++++++++---
 drivers/firmware/samsung/exynos-acpm.h        |   2 +
 .../firmware/samsung/exynos-acpm-protocol.h   |  38 ++
 5 files changed, 727 insertions(+), 74 deletions(-)

diff --git a/drivers/firmware/samsung/exynos-acpm-dvfs.c b/drivers/firmware/samsung/exynos-acpm-dvfs.c
index 7266312ef5..e5bf614b3a 100644
--- a/drivers/firmware/samsung/exynos-acpm-dvfs.c
+++ b/drivers/firmware/samsung/exynos-acpm-dvfs.c
@@ -8,7 +8,14 @@
 #include <linux/array_size.h>
 #include <linux/bitfield.h>
 #include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/kernel.h>
 #include <linux/ktime.h>
+#include <linux/export.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
 #include <linux/types.h>
 #include <linux/units.h>
 
@@ -21,48 +28,251 @@
 #define ACPM_DVFS_FREQ_REQ		0
 #define ACPM_DVFS_FREQ_GET		1
 
+/*
+ * Request interface (Exynos 9820). It lives in the acpm_protocol module, so
+ * with the driver built in it is /sys/module/acpm_protocol/parameters/dvfs_cmd.
+ *
+ * dvfs_cmd (write-only): send a request by hand, bypassing the clk
+ *	framework's rate cache: "<domain> <kHz>" sets a rate, "<domain> get"
+ *	queries it, "<domain> raw <cmd2> <cmd1> <cmd3>" sends any DVFS-type
+ *	message on the last used channel. Exynos 9820 domains: 0 MIF, 1 INT,
+ *	2 CPUCL0, 3 CPUCL1, 4 CPUCL2, 10 G3D.
+ */
+/* Last handle/channel used, for dvfs_cmd. */
+static struct acpm_handle *acpm_dvfs_handle;
+static unsigned int acpm_dvfs_chan;
+
+static u32 acpm_dvfs_cmd3(void)
+{
+	return ktime_to_ms(ktime_get());
+}
+
+static int acpm_dvfs_xfer(struct acpm_handle *handle, unsigned int acpm_chan_id,
+			  u32 cmd[4], bool response, const char *what)
+{
+	struct acpm_xfer xfer = {0};
+
+	acpm_set_xfer(&xfer, cmd, 4, acpm_chan_id, response);
+	return acpm_do_xfer(handle, &xfer);
+}
+
 static void acpm_dvfs_init_set_rate_cmd(u32 cmd[4], unsigned int clk_id,
 					unsigned long rate)
 {
 	cmd[0] = FIELD_PREP(ACPM_DVFS_ID, clk_id);
 	cmd[1] = rate / HZ_PER_KHZ;
 	cmd[2] = FIELD_PREP(ACPM_DVFS_REQ_TYPE, ACPM_DVFS_FREQ_REQ);
-	cmd[3] = ktime_to_ms(ktime_get());
+	cmd[3] = acpm_dvfs_cmd3();
 }
 
 int acpm_dvfs_set_rate(struct acpm_handle *handle,
 		       unsigned int acpm_chan_id, unsigned int clk_id,
 		       unsigned long rate)
 {
-	struct acpm_xfer xfer = {0};
 	u32 cmd[4];
 
+	acpm_dvfs_handle = handle;
+	acpm_dvfs_chan = acpm_chan_id;
+
 	acpm_dvfs_init_set_rate_cmd(cmd, clk_id, rate);
-	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, false);
 
-	return acpm_do_xfer(handle, &xfer);
+	return acpm_dvfs_xfer(handle, acpm_chan_id, cmd, false, "set");
 }
 
 static void acpm_dvfs_init_get_rate_cmd(u32 cmd[4], unsigned int clk_id)
 {
 	cmd[0] = FIELD_PREP(ACPM_DVFS_ID, clk_id);
 	cmd[2] = FIELD_PREP(ACPM_DVFS_REQ_TYPE, ACPM_DVFS_FREQ_GET);
-	cmd[3] = ktime_to_ms(ktime_get());
+	cmd[3] = acpm_dvfs_cmd3();
 }
 
 unsigned long acpm_dvfs_get_rate(struct acpm_handle *handle,
 				 unsigned int acpm_chan_id, unsigned int clk_id)
 {
-	struct acpm_xfer xfer;
 	unsigned int cmd[4] = {0};
 	int ret;
 
-	acpm_dvfs_init_get_rate_cmd(cmd, clk_id);
-	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	acpm_dvfs_handle = handle;
+	acpm_dvfs_chan = acpm_chan_id;
 
-	ret = acpm_do_xfer(handle, &xfer);
+	acpm_dvfs_init_get_rate_cmd(cmd, clk_id);
+	ret = acpm_dvfs_xfer(handle, acpm_chan_id, cmd, true, "get");
 	if (ret)
 		return 0;
 
-	return xfer.rxd[1] * HZ_PER_KHZ;
+	return cmd[1] * HZ_PER_KHZ;
 }
+
+/*
+ * Bus/memory level hold for in-kernel users (Exynos 9820).
+ *
+ * Nothing in the kernel scales MIF (memory) and INT (internal bus) on this
+ * SoC; user space lowers them through dvfs_cmd while the screen is off. A
+ * block that needs the full bus clock and voltage (the camera interface)
+ * holds both domains at the acpm_dvfs_hold_khz[] levels while it runs:
+ * requests from dvfs_cmd below the hold are remembered, answered with
+ * success and sent when the last hold is dropped. 0 = do not hold that
+ * domain.
+ */
+#define ACPM_DVFS_MIF		0
+#define ACPM_DVFS_INT		1
+
+/* MIF and INT level in kHz while an in-kernel user holds the bus levels */
+static const unsigned int acpm_dvfs_hold_khz[2] = { 2093000, 534000 };
+
+static DEFINE_MUTEX(acpm_dvfs_hold_lock);
+static unsigned int acpm_dvfs_holders;
+static unsigned int acpm_dvfs_held_khz[2];	/* sent for the current hold */
+static unsigned int acpm_dvfs_user_khz[2];	/* last dvfs_cmd request */
+
+/* Call with acpm_dvfs_hold_lock held. */
+static int acpm_dvfs_send_khz(unsigned int id, unsigned int khz,
+			      const char *what)
+{
+	u32 cmd[4];
+	int ret;
+
+	cmd[0] = FIELD_PREP(ACPM_DVFS_ID, id);
+	cmd[1] = khz;
+	cmd[2] = FIELD_PREP(ACPM_DVFS_REQ_TYPE, ACPM_DVFS_FREQ_REQ);
+	cmd[3] = acpm_dvfs_cmd3();
+	ret = acpm_dvfs_xfer(acpm_dvfs_handle, acpm_dvfs_chan, cmd, true, what);
+	/* same line as the other dvfs_cmd requests */
+	pr_info("acpm-dvfs: %s \"%u %u\" ret %d rx %08x %08x %08x %08x\n",
+		what, id, khz, ret, cmd[0], cmd[1], cmd[2], cmd[3]);
+	return ret;
+}
+
+/**
+ * exynos_acpm_dvfs_hold() - hold or release the MIF/INT levels
+ * @on: true to hold (counted), false to release
+ *
+ * Returns 0 or a negative error if the levels could not be raised; a failed
+ * hold is not counted.
+ */
+int exynos_acpm_dvfs_hold(bool on)
+{
+	/* up: bus first, then memory; down: the other way round */
+	static const u8 up[] = { ACPM_DVFS_INT, ACPM_DVFS_MIF };
+	static const u8 down[] = { ACPM_DVFS_MIF, ACPM_DVFS_INT };
+	unsigned int i, id;
+	int ret = 0;
+
+	mutex_lock(&acpm_dvfs_hold_lock);
+	if (!acpm_dvfs_handle) {
+		/* no DVFS client yet: nothing can have lowered the levels */
+		pr_info_once("acpm-dvfs: hold without a DVFS channel, levels left alone\n");
+		goto out;
+	}
+
+	if (on) {
+		if (acpm_dvfs_holders++)
+			goto out;
+		for (i = 0; i < ARRAY_SIZE(up); i++) {
+			id = up[i];
+			acpm_dvfs_held_khz[id] = acpm_dvfs_hold_khz[id];
+			if (!acpm_dvfs_held_khz[id])
+				continue;
+			/*
+			 * Always send, even when the last user request was as
+			 * high: that cache does not follow what the firmware
+			 * does on its own (system sleep and resume, CP DVFS);
+			 * a camera stream at its 400 MHz bus clock on a lower
+			 * INT level is the suspected cause of a stalled camera
+			 * DMA after many suspend cycles.
+			 */
+			ret = acpm_dvfs_send_khz(id, acpm_dvfs_held_khz[id],
+						 "hold");
+			if (ret)
+				break;
+		}
+		if (!ret) {
+			pr_info("acpm-dvfs: hold MIF %u INT %u kHz (user MIF %u INT %u)\n",
+				acpm_dvfs_held_khz[ACPM_DVFS_MIF],
+				acpm_dvfs_held_khz[ACPM_DVFS_INT],
+				acpm_dvfs_user_khz[ACPM_DVFS_MIF],
+				acpm_dvfs_user_khz[ACPM_DVFS_INT]);
+			goto out;
+		}
+		/* failed: undo below */
+	} else if (!acpm_dvfs_holders || --acpm_dvfs_holders) {
+		goto out;
+	}
+
+	if (on)
+		acpm_dvfs_holders--;
+	for (i = 0; i < ARRAY_SIZE(down); i++) {
+		id = down[i];
+		if (acpm_dvfs_held_khz[id] && acpm_dvfs_user_khz[id] &&
+		    acpm_dvfs_user_khz[id] < acpm_dvfs_held_khz[id])
+			acpm_dvfs_send_khz(id, acpm_dvfs_user_khz[id],
+					   "release");
+		acpm_dvfs_held_khz[id] = 0;
+	}
+	if (!on)
+		pr_info("acpm-dvfs: hold released (user MIF %u INT %u kHz)\n",
+			acpm_dvfs_user_khz[ACPM_DVFS_MIF],
+			acpm_dvfs_user_khz[ACPM_DVFS_INT]);
+out:
+	mutex_unlock(&acpm_dvfs_hold_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(exynos_acpm_dvfs_hold);
+
+static int acpm_dvfs_cmd_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int id, a = 0, b = 0, c = 0;
+	char word[8] = "";
+	u32 cmd[4] = {0};
+	int n, ret;
+
+	if (!acpm_dvfs_handle)
+		return -ENODEV;
+
+	n = sscanf(val, "%u %7s %u %u %u", &id, word, &a, &b, &c);
+	if (n < 2)
+		return -EINVAL;
+
+	cmd[0] = FIELD_PREP(ACPM_DVFS_ID, id);
+	if (!strcmp(word, "get")) {
+		cmd[2] = FIELD_PREP(ACPM_DVFS_REQ_TYPE, ACPM_DVFS_FREQ_GET);
+		cmd[3] = acpm_dvfs_cmd3();
+	} else if (!strcmp(word, "raw")) {
+		if (n < 3)
+			return -EINVAL;
+		cmd[2] = a;
+		cmd[1] = b;
+		cmd[3] = c;
+	} else {
+		if (kstrtouint(word, 0, &a))
+			return -EINVAL;
+		if (id <= ACPM_DVFS_INT) {
+			/* MIF/INT: remember, and keep a hold in force */
+			mutex_lock(&acpm_dvfs_hold_lock);
+			acpm_dvfs_user_khz[id] = a;
+			if (a < acpm_dvfs_held_khz[id]) {
+				mutex_unlock(&acpm_dvfs_hold_lock);
+				return 0;
+			}
+			ret = acpm_dvfs_send_khz(id, a, "cmd");
+			mutex_unlock(&acpm_dvfs_hold_lock);
+			return ret;
+		}
+		cmd[1] = a;
+		cmd[2] = FIELD_PREP(ACPM_DVFS_REQ_TYPE, ACPM_DVFS_FREQ_REQ);
+		cmd[3] = acpm_dvfs_cmd3();
+	}
+
+	ret = acpm_dvfs_xfer(acpm_dvfs_handle, acpm_dvfs_chan, cmd, true, "cmd");
+	pr_info("acpm-dvfs: cmd \"%s\" ret %d rx %08x %08x %08x %08x\n",
+		word, ret, cmd[0], cmd[1], cmd[2], cmd[3]);
+
+	return ret;
+}
+
+static const struct kernel_param_ops acpm_dvfs_cmd_ops = {
+	.set = acpm_dvfs_cmd_set,
+};
+module_param_cb(dvfs_cmd, &acpm_dvfs_cmd_ops, NULL, 0200);
+MODULE_PARM_DESC(dvfs_cmd,
+		 "\"<domain> <kHz>\", \"<domain> get\" or \"<domain> raw <type> <arg> <cmd3>\"");
diff --git a/drivers/firmware/samsung/exynos-acpm-pmic.c b/drivers/firmware/samsung/exynos-acpm-pmic.c
index f032f2c696..650dcf241f 100644
--- a/drivers/firmware/samsung/exynos-acpm-pmic.c
+++ b/drivers/firmware/samsung/exynos-acpm-pmic.c
@@ -7,6 +7,9 @@
 #include <linux/array_size.h>
 #include <linux/bitfield.h>
 #include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/irqflags.h>
+#include <linux/bug.h>
 #include <linux/firmware/samsung/exynos-acpm-protocol.h>
 #include <linux/ktime.h>
 #include <linux/types.h>
@@ -97,9 +100,9 @@ static void acpm_pmic_init_bulk_read_cmd(u32 cmd[4], u8 type, u8 reg, u8 chan,
 		 FIELD_PREP(ACPM_PMIC_VALUE, count);
 }
 
-int acpm_pmic_bulk_read(struct acpm_handle *handle,
-			unsigned int acpm_chan_id, u8 type, u8 reg, u8 chan,
-			u8 count, u8 *buf)
+static int __acpm_pmic_bulk_read(struct acpm_handle *handle,
+				 unsigned int acpm_chan_id, u8 type, u8 reg,
+				 u8 chan, u8 count, u8 *buf, bool atomic)
 {
 	struct acpm_xfer xfer;
 	u32 cmd[4] = {0};
@@ -110,6 +113,7 @@ int acpm_pmic_bulk_read(struct acpm_handle *handle,
 
 	acpm_pmic_init_bulk_read_cmd(cmd, type, reg, chan, count);
 	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	xfer.atomic = atomic;
 
 	ret = acpm_do_xfer(handle, &xfer);
 	if (ret)
@@ -129,6 +133,14 @@ int acpm_pmic_bulk_read(struct acpm_handle *handle,
 	return 0;
 }
 
+int acpm_pmic_bulk_read(struct acpm_handle *handle,
+			unsigned int acpm_chan_id, u8 type, u8 reg, u8 chan,
+			u8 count, u8 *buf)
+{
+	return __acpm_pmic_bulk_read(handle, acpm_chan_id, type, reg, chan,
+				     count, buf, false);
+}
+
 static void acpm_pmic_init_write_cmd(u32 cmd[4], u8 type, u8 reg, u8 chan,
 				     u8 value)
 {
@@ -177,9 +189,9 @@ static void acpm_pmic_init_bulk_write_cmd(u32 cmd[4], u8 type, u8 reg, u8 chan,
 	}
 }
 
-int acpm_pmic_bulk_write(struct acpm_handle *handle,
-			 unsigned int acpm_chan_id, u8 type, u8 reg, u8 chan,
-			 u8 count, const u8 *buf)
+static int __acpm_pmic_bulk_write(struct acpm_handle *handle,
+				  unsigned int acpm_chan_id, u8 type, u8 reg,
+				  u8 chan, u8 count, const u8 *buf, bool atomic)
 {
 	struct acpm_xfer xfer;
 	u32 cmd[4] = {0};
@@ -190,6 +202,7 @@ int acpm_pmic_bulk_write(struct acpm_handle *handle,
 
 	acpm_pmic_init_bulk_write_cmd(cmd, type, reg, chan, count, buf);
 	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	xfer.atomic = atomic;
 
 	ret = acpm_do_xfer(handle, &xfer);
 	if (ret)
@@ -198,6 +211,14 @@ int acpm_pmic_bulk_write(struct acpm_handle *handle,
 	return acpm_pmic_to_linux_err(FIELD_GET(ACPM_PMIC_RETURN, xfer.rxd[1]));
 }
 
+int acpm_pmic_bulk_write(struct acpm_handle *handle,
+			 unsigned int acpm_chan_id, u8 type, u8 reg, u8 chan,
+			 u8 count, const u8 *buf)
+{
+	return __acpm_pmic_bulk_write(handle, acpm_chan_id, type, reg, chan,
+				      count, buf, false);
+}
+
 static void acpm_pmic_init_update_cmd(u32 cmd[4], u8 type, u8 reg, u8 chan,
 				      u8 value, u8 mask)
 {
@@ -227,3 +248,46 @@ int acpm_pmic_update_reg(struct acpm_handle *handle,
 
 	return acpm_pmic_to_linux_err(FIELD_GET(ACPM_PMIC_RETURN, xfer.rxd[1]));
 }
+
+/*
+ * Debug PMIC access for the system sleep breadcrumbs, with the
+ * ACPM instance the driver probed (one per SoC).
+ *
+ * atomic = false: an ordinary transfer (sleeping locks, ktime timeouts);
+ * use it from process context.
+ * atomic = true: only for the IRQs-off, single-CPU part of system suspend
+ * (syscore, suspend_ops->enter, possibly with timekeeping suspended). The
+ * channel locks are only try-locked, so if a normal transfer holds the
+ * channel the call fails at once with -EBUSY instead of waiting for a
+ * thread that cannot run; all waits are udelay()-counted and bounded
+ * (about 10 ms for the TX queue, 20 ms for the response). Only bulk
+ * commands are used: their request words carry no ktime stamp.
+ */
+int exynos_acpm_pmic_dbg_bulk_read(unsigned int acpm_chan_id, u8 type, u8 reg,
+				   u8 chan, u8 count, u8 *buf, bool atomic)
+{
+	struct acpm_handle *handle = acpm_dbg_get_handle();
+
+	if (!handle)
+		return -ENODEV;
+	if (atomic && WARN_ON_ONCE(!irqs_disabled()))
+		return -EINVAL;
+	return __acpm_pmic_bulk_read(handle, acpm_chan_id, type, reg, chan,
+				     count, buf, atomic);
+}
+EXPORT_SYMBOL_GPL(exynos_acpm_pmic_dbg_bulk_read);
+
+int exynos_acpm_pmic_dbg_bulk_write(unsigned int acpm_chan_id, u8 type, u8 reg,
+				    u8 chan, u8 count, const u8 *buf,
+				    bool atomic)
+{
+	struct acpm_handle *handle = acpm_dbg_get_handle();
+
+	if (!handle)
+		return -ENODEV;
+	if (atomic && WARN_ON_ONCE(!irqs_disabled()))
+		return -EINVAL;
+	return __acpm_pmic_bulk_write(handle, acpm_chan_id, type, reg, chan,
+				      count, buf, atomic);
+}
+EXPORT_SYMBOL_GPL(exynos_acpm_pmic_dbg_bulk_write);
diff --git a/drivers/firmware/samsung/exynos-acpm.c b/drivers/firmware/samsung/exynos-acpm.c
index 09012b9946..321fc7d0c8 100644
--- a/drivers/firmware/samsung/exynos-acpm.c
+++ b/drivers/firmware/samsung/exynos-acpm.c
@@ -26,8 +26,10 @@
 #include <linux/of_address.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/types.h>
+#include <linux/workqueue.h>
 
 #include "exynos-acpm.h"
 #include "exynos-acpm-dvfs.h"
@@ -38,6 +40,9 @@
 
 #define ACPM_POLL_TIMEOUT_US		(100 * USEC_PER_MSEC)
 #define ACPM_TX_TIMEOUT_US		500000
+/* IRQs-off transfers (suspend breadcrumbs): keep the worst case short */
+#define ACPM_ATOMIC_TX_TIMEOUT_US	10000
+#define ACPM_ATOMIC_POLL_LOOPS		(20 * USEC_PER_MSEC / 20)
 
 #define ACPM_GS101_INITDATA_BASE	0xa000
 #define ACPM_EXYNOS9820_INITDATA_BASE	0x7000
@@ -140,6 +145,10 @@ struct acpm_rx_data {
  * @id:		channel ID.
  * @poll_completion:	indicates if the transfer needs to be polled for
  *			completion or interrupt mode is used.
+ * @shmem_ok:	the SRAM descriptor points at a usable queue pair (non-zero
+ *		offsets inside the SRAM, non-zero qlen/mlen). Unused channel
+ *		descriptors are zero-filled, and SRAM offset 0 is not readable
+ *		by the AP (synchronous external abort on Exynos 9820).
  * @bitmap_seqnum: bitmap that tracks the messages on the TX/RX queues.
  * @rx_data:	internal buffer used to drain the RX queue.
  */
@@ -157,6 +166,7 @@ struct acpm_chan {
 	u8 seqnum;
 	u8 id;
 	bool poll_completion;
+	bool shmem_ok;
 
 	DECLARE_BITMAP(bitmap_seqnum, ACPM_SEQNUM_MAX - 1);
 	struct acpm_rx_data rx_data[ACPM_SEQNUM_MAX];
@@ -170,6 +180,8 @@ struct acpm_chan {
  * @dev:	pointer to the exynos-acpm device.
  * @handle:	instance of acpm_handle to send to clients.
  * @num_chans:	number of channels available for this controller.
+ * @sram_size:	size of the SRAM mapping.
+ * @mbox:	second mapping of the AP2APM mailbox (debug knobs), or NULL.
  */
 struct acpm_info {
 	struct acpm_shmem __iomem *shmem;
@@ -178,21 +190,205 @@ struct acpm_info {
 	struct device *dev;
 	struct acpm_handle handle;
 	u32 num_chans;
