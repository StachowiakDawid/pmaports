+	dev_printk(err ? KERN_ERR : KERN_INFO, acpm->dev,
+		   "%s [%u] id:%lu lvl:%lu ts:%lu cnt:%lu %s %#x\n", tag, slot,
+		   FIELD_GET(GENMASK(31, 28), hdr), FIELD_GET(BIT(19), hdr),
+		   FIELD_GET(GENMASK(24, 20), hdr),
+		   FIELD_GET(GENMASK(15, 0), hdr), str, val);
