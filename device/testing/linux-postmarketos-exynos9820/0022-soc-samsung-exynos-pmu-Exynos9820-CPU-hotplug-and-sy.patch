index 67581a3972..e1afadf10f 100644
--- a/drivers/soc/samsung/exynos-pmu.h
+++ b/drivers/soc/samsung/exynos-pmu.h
@@ -42,6 +42,8 @@ struct exynos_pmu_context {
 	unsigned long *in_cpuhp;
 	bool sys_insuspend;
 	bool sys_inreboot;
+	/* platform system sleep in progress, see exynos_pmu_sys_sleep() */
+	bool sys_insleep;
 	int cpuhp_prepare_state;
 	int cpuhp_power_up;
 	int cpuhp_power_down;
@@ -76,6 +78,10 @@ struct exynos_pmu_context {
  *                   or idle state. Only valid when pmu_cpuhp set to true.
  * @cpu_pmu_online: Optional callback to be called after CPU onlined or after
  *                  exiting idle state. Only valid when pmu_cpuhp set to true.
+ * @cpu_pmu_powered: Optional: 1 if the PMU reports @cpu's power domain on,
+ *                   0 if off, negative on error (diagnostics, any context).
+ * @cpu_off_affl: Optional: affinity level of the PSCI CPU_OFF power state of
+ *                @cpu (0: core, 1: cluster). Called on the dying CPU.
  */
 struct exynos_pmu_data {
 	const struct exynos_pmu_conf *pmu_config;
@@ -92,6 +98,9 @@ struct exynos_pmu_data {
 
 	int (*cpu_pmu_offline)(struct exynos_pmu_context *pmu_context, unsigned int cpu);
 	int (*cpu_pmu_online)(struct exynos_pmu_context *pmu_context, unsigned int cpu);
+	int (*cpu_pmu_powered)(struct exynos_pmu_context *pmu_context, unsigned int cpu);
+	void (*cpu_pmu_pre_on)(struct exynos_pmu_context *pmu_context, unsigned int cpu);
+	unsigned int (*cpu_off_affl)(unsigned int cpu);
 };
 
 extern void __iomem *pmu_base_addr;
diff --git a/drivers/soc/samsung/exynos9820-pmu.c b/drivers/soc/samsung/exynos9820-pmu.c
index 6fc3a05221..4b164ccda8 100644
--- a/drivers/soc/samsung/exynos9820-pmu.c
+++ b/drivers/soc/samsung/exynos9820-pmu.c
@@ -7,6 +7,9 @@
 
 #include <linux/array_size.h>
 #include <linux/bits.h>
+#include <linux/cpumask.h>
+#include <linux/io.h>
+#include <linux/moduleparam.h>
 #include <linux/soc/samsung/exynos-pmu.h>
 #include <linux/soc/samsung/exynos-regs-pmu.h>
 #include <linux/regmap.h>
@@ -20,58 +23,163 @@ static unsigned exynos9820_cluster_offsets[] = {
 	GS101_CLUSTER2_OFFSET,
 };
 
-static int exynos9820_cpu_pmu_offline(struct exynos_pmu_context *pmu_context,
-				      unsigned int cpu)
-	__must_hold(&pmu_context->cpupm_lock)
+/*
+ * Default on: when CPU hotplug takes the last online CPU of cluster 2 down, give it the CPD (cluster power down) hint instead
+ * of C2, as Samsung's cpuhp_cpupm_offline() -> cluster_disable() does
+ * (pmucal_cpu_cluster_disable() only writes CPU_INFORM = CPD on 9820).
+ * Never used for cpuidle: the cluster still has online CPUs then.
+ * /sys/module/exynos_pmu/parameters/cpd_hint
+ *
+ * The first test of this knob (memory corruption) was broken: the
+ * "last CPU" check used topology_cluster_cpumask() of the dying CPU, which
+ * remove_cpu_topology() has already emptied by then, so EVERY offlined CPU
+ * gave the hint, with its siblings still running. Samsung also pairs the
+ * hint with affinity level 1 in the CPU_OFF power state (cl2_off_affl).
+ * Now only the last CPU of cluster 2 gives it. Together with cl2_off_affl
+ * cluster 2 really powers down (CLUSTER2_NONCPU_STATUS 0), no memory
+ * corruption in 11 hotplug cycles, and CPU7 came back after 20/20 deep
+ * sleeps (it failed ~1 in 3-4 before). cpd_hint=0 also turns cl2_off_affl
+ * off: affinity level 1 without the hint leaves the CPU stuck powered.
+ */
+static bool cpd_hint = true;
+module_param(cpd_hint, bool, 0644);
+MODULE_PARM_DESC(cpd_hint, "Exynos9820: CPD hint for the last CPU of cluster 2 going offline (default Y)");
+
+#define EXYNOS9820_CPU_INFORM_CPD	2
+
+/*
+ * Default on (only with cpd_hint): the PSCI CPU_OFF of the last online CPU of
+ * cluster 2 carries affinity level 1, as Samsung's cpu_psci_cpu_die() does
+ * for exynos_cpuhp_last_cpu(). Without it the firmware is never told that
+ * the cluster goes down: CLUSTER2_NONCPU_STATUS stays 1 with CPU6 and CPU7
+ * offline, and a SoC SLEEP is entered with the firmware believing cluster 2
+ * is up, which Samsung's kernel never does (lead for CPU7 not starting
+ * after a SLEEP).
+ * /sys/module/exynos_pmu/parameters/cl2_off_affl
+ */
+static bool cl2_off_affl = true;
+module_param(cl2_off_affl, bool, 0644);
+MODULE_PARM_DESC(cl2_off_affl, "Exynos9820: CPU_OFF affinity level 1 for the last CPU of cluster 2, only with cpd_hint (default Y)");
+
+/*
+ * SYSREG_CPUCL2 BUS_COMPONENT_DRCG_EN: downstream's cluster2_on sequence
+ * (flexpmu_cal_cpu_exynos9820.h) writes it every time cluster 2 powers on.
+ * A SoC SLEEP resets it to 0, and with it at 0 the second core of the
+ * cluster (CPU7) is powered by CPU_ON but never starts. The register is in
+ * the cluster's power domain, so it is rewritten from the online path of a
+ * cluster 2 CPU (the cluster is on then): CPU6 coming up fixes it for CPU7.
+ */
+#define EXYNOS9820_SYSREG_CPUCL2_DRCG_EN	0x1d100104
+#define EXYNOS9820_CLUSTER2			2
+
+#define EXYNOS9820_CLUSTER2_NONCPU_STATUS	0x1604
+
+static void __iomem *exynos9820_cl2_drcg;
+
+static void exynos9820_pmu_init(void)
 {
-	int smp_id, cluster_id, core_id;
-	u32 reg, mask;
+	exynos9820_cl2_drcg = ioremap(EXYNOS9820_SYSREG_CPUCL2_DRCG_EN, 4);
+	if (!exynos9820_cl2_drcg)
+		pr_warn("exynos9820-pmu: cannot map SYSREG_CPUCL2 DRCG_EN\n");
+}
 
-	smp_id = smp_processor_id();
-	if (cpu != smp_id) {
-		pr_err_ratelimited(
-			"offline: not on target CPU: cpu=%u smp_id=%d\n", cpu,
-			smp_id);
+/*
+ * @cpu is offline and no other CPU of cluster 2 is online. For the dying
+ * CPU itself, after __cpu_disable(): its topology sibling masks are empty
+ * by then, so go by the cluster IDs.
+ */
+static bool exynos9820_last_cl2_cpu(unsigned int cpu)
+{
+	unsigned int c;
 
-		return -EINVAL;
-	}
+	if (topology_cluster_id(cpu) != EXYNOS9820_CLUSTER2 || cpu_online(cpu))
+		return false;
+
+	for_each_online_cpu(c)
+		if (topology_cluster_id(c) == EXYNOS9820_CLUSTER2)
+			return false;
+
+	return true;
+}
+
+static unsigned int exynos9820_cpu_off_affl(unsigned int cpu)
+{
+	return READ_ONCE(cl2_off_affl) && READ_ONCE(cpd_hint) &&
+	       exynos9820_last_cl2_cpu(cpu);
+}
+
+/* PMU register offset of the CLUSTERx_CPUy block of @cpu, or -EINVAL */
+static int exynos9820_cpu_offset(unsigned int cpu)
+{
+	int cluster_id, core_id;
 
 	cluster_id = topology_cluster_id(cpu);
 	if (cluster_id < 0 ||
 	    cluster_id >= ARRAY_SIZE(exynos9820_cluster_offsets)) {
 		pr_err_ratelimited("invalid cluster ID for cpu: %u\n", cpu);
-
 		return -EINVAL;
 	}
 
 	core_id = topology_core_id(cpu);
 	if (core_id < 0) {
 		pr_err_ratelimited("invalid core ID for cpu: %u\n", cpu);
+		return -EINVAL;
+	}
+
+	return GS101_CLUSTER_CPU_OFFSET(exynos9820_cluster_offsets[cluster_id],
+					core_id);
+}
+
+static void exynos9820_clear_pend(struct exynos_pmu_context *pmu_context,
+				  unsigned int upend, unsigned int clear,
+				  u32 mask)
+{
+	u32 reg;
+
+	regmap_read(pmu_context->pmuintrgen, upend, &reg);
+	regmap_write(pmu_context->pmuintrgen, clear, reg & mask);
+}
+
+static int exynos9820_cpu_pmu_offline(struct exynos_pmu_context *pmu_context,
+				      unsigned int cpu)
+	__must_hold(&pmu_context->cpupm_lock)
+{
+	int smp_id, off;
+
+	smp_id = smp_processor_id();
+	if (cpu != smp_id) {
+		pr_err_ratelimited(
+			"offline: not on target CPU: cpu=%u smp_id=%d\n", cpu,
+			smp_id);
 
 		return -EINVAL;
 	}
 
+	off = exynos9820_cpu_offset(cpu);
+	if (off < 0)
+		return off;
+
 	regmap_write(pmu_context->pmureg, GS101_CPU_INFORM(smp_processor_id()),
 		     CPU_INFORM_C2);
 
-	mask = BIT(cpu);
 	regmap_update_bits(pmu_context->pmuintrgen, EXYNOS_GRP2_INTR_BID_ENABLE,
-			   mask, BIT(cpu));
+			   BIT(cpu), BIT(cpu));
 
-	regmap_read(pmu_context->pmuintrgen, EXYNOS_GRP1_INTR_BID_UPEND, &reg);
-	regmap_write(pmu_context->pmuintrgen, EXYNOS_GRP1_INTR_BID_CLEAR,
-		     reg & mask);
+	exynos9820_clear_pend(pmu_context, EXYNOS_GRP1_INTR_BID_UPEND,
+			      EXYNOS_GRP1_INTR_BID_CLEAR, BIT(cpu));
+	exynos9820_clear_pend(pmu_context, EXYNOS_GRP1_INTR_BID_UPEND,
+			      EXYNOS_GRP1_INTR_BID_CLEAR, BIT(cpu + 8));
 
-	mask = (BIT(cpu + 8));
-	regmap_read(pmu_context->pmuintrgen, EXYNOS_GRP1_INTR_BID_UPEND, &reg);
-	regmap_write(pmu_context->pmuintrgen, EXYNOS_GRP1_INTR_BID_CLEAR,
-		     reg & mask);
+	regmap_update_bits(pmu_context->pmureg, off + 0x44 /* INT_EN */,
+			   BIT(3), BIT(3));
 
-	regmap_update_bits(
-		pmu_context->pmureg,
-		GS101_CLUSTER_CPU_INT_EN(exynos9820_cluster_offsets[cluster_id],
-					 core_id),
-		BIT(3), BIT(3));
+	/*
+	 * Hotplug runs this on the dying CPU after it left cpu_online_mask;
+	 * cpuidle runs it on an online CPU.
+	 */
+	if (READ_ONCE(cpd_hint) && exynos9820_last_cl2_cpu(cpu))
+		regmap_write(pmu_context->pmureg, GS101_CPU_INFORM(cpu),
+			     EXYNOS9820_CPU_INFORM_CPD);
 
 	return 0;
 }
@@ -80,8 +188,7 @@ static int exynos9820_cpu_pmu_online(struct exynos_pmu_context *pmu_context,
 				     unsigned int cpu)
 	__must_hold(&pmu_context->cpupm_lock)
 {
-	int smp_id, cluster_id, core_id;
-	u32 reg, mask;
+	int smp_id, off;
 
 	smp_id = smp_processor_id();
 	if (cpu != smp_id) {
@@ -92,41 +199,48 @@ static int exynos9820_cpu_pmu_online(struct exynos_pmu_context *pmu_context,
 		return -EINVAL;
 	}
 
-	cluster_id = topology_cluster_id(cpu);
-	if (cluster_id < 0 ||
-	    cluster_id >= ARRAY_SIZE(exynos9820_cluster_offsets)) {
-		pr_err_ratelimited("invalid cluster ID for cpu: %u\n", cpu);
-		return -EINVAL;
-	}
-
-	core_id = topology_core_id(cpu);
-	if (core_id < 0) {
-		pr_err_ratelimited("invalid core ID for cpu: %u\n", cpu);
-		return -EINVAL;
-	}
+	off = exynos9820_cpu_offset(cpu);
+	if (off < 0)
+		return off;
 
 	regmap_write(pmu_context->pmureg, GS101_CPU_INFORM(smp_processor_id()),
 		     CPU_INFORM_CLEAR);
 
-	mask = BIT(cpu);
 	regmap_update_bits(pmu_context->pmuintrgen, EXYNOS_GRP2_INTR_BID_ENABLE,
-			   mask, (0 << cpu));
+			   BIT(cpu), 0);
 
-	regmap_read(pmu_context->pmuintrgen, EXYNOS_GRP2_INTR_BID_UPEND, &reg);
-	regmap_write(pmu_context->pmuintrgen, EXYNOS_GRP2_INTR_BID_CLEAR,
-		     reg & mask);
+	exynos9820_clear_pend(pmu_context, EXYNOS_GRP2_INTR_BID_UPEND,
+			      EXYNOS_GRP2_INTR_BID_CLEAR, BIT(cpu));
 
-	regmap_update_bits(
-		pmu_context->pmureg,
-		GS101_CLUSTER_CPU_INT_EN(exynos9820_cluster_offsets[cluster_id],
-					 core_id),
-		BIT(3), 0);
+	regmap_update_bits(pmu_context->pmureg, off + 0x44 /* INT_EN */,
+			   BIT(3), 0);
+
+	if (topology_cluster_id(cpu) == EXYNOS9820_CLUSTER2) {
+		if (exynos9820_cl2_drcg)
+			writel(0xffffffff, exynos9820_cl2_drcg);
+	}
 
 	return 0;
