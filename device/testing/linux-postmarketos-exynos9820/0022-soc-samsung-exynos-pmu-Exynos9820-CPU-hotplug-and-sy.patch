 drivers/soc/samsung/exynos-pmu.c       | 113 ++++++++++++-
 drivers/soc/samsung/exynos-pmu.h       |   9 ++
 drivers/soc/samsung/exynos9820-pmu.c   | 216 +++++++++++++++++++------
 include/linux/soc/samsung/exynos-pmu.h |  17 ++
 5 files changed, 309 insertions(+), 53 deletions(-)

diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index fabd732d0a..ea17cca022 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -14,6 +14,7 @@
 #include <linux/delay.h>
 #include <linux/psci.h>
 #include <linux/mm.h>
+#include <linux/soc/samsung/exynos-pmu.h>
 
 #include <uapi/linux/psci.h>
 
@@ -74,6 +75,12 @@ static void cpu_psci_cpu_die(unsigned int cpu)
 	u32 state = PSCI_POWER_STATE_TYPE_POWER_DOWN <<
 		    PSCI_0_2_POWER_STATE_TYPE_SHIFT;
 
+	/*
+	 * Exynos9820 firmware does use it: Samsung's kernel passes affinity
+	 * level 1 for the last CPU of a cluster (exynos_cpuhp_last_cpu()).
+	 */
+	state |= exynos_pmu_cpu_off_affl(cpu) << PSCI_0_2_POWER_STATE_AFFL_SHIFT;
+
 	psci_ops.cpu_off(state);
 }
 
diff --git a/drivers/soc/samsung/exynos-pmu.c b/drivers/soc/samsung/exynos-pmu.c
index 13919ae319..501412e318 100644
--- a/drivers/soc/samsung/exynos-pmu.c
+++ b/drivers/soc/samsung/exynos-pmu.c
@@ -7,8 +7,13 @@
 
 #include <linux/array_size.h>
 #include <linux/bitmap.h>
+#include <linux/cpu.h>
 #include <linux/cpuhotplug.h>
 #include <linux/cpu_pm.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+#include <linux/smp.h>
+#include <linux/timekeeping.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/mfd/core.h>
@@ -226,7 +231,7 @@ static int exynos_cpu_pmu_online(void)
 
 	raw_spin_lock(&pmu_context->cpupm_lock);
 
-	if (pmu_context->sys_inreboot) {
+	if (pmu_context->sys_inreboot || pmu_context->sys_insleep) {
 		raw_spin_unlock(&pmu_context->cpupm_lock);
 		return NOTIFY_OK;
 	}
@@ -243,6 +248,10 @@ static int exynos_cpuhp_pmu_online(unsigned int cpu)
 {
 	unsigned long flags;
 
+	/* on the control CPU, before CPU_ON of @cpu */
+	if (pmu_context->pmu_data->cpu_pmu_pre_on)
+		pmu_context->pmu_data->cpu_pmu_pre_on(pmu_context, cpu);
+
 	raw_spin_lock_irqsave(&pmu_context->cpupm_lock, flags);
 
 	/*
@@ -278,6 +287,17 @@ static int exynos_cpu_pmu_offline(void)
 		return NOTIFY_BAD;
 	}
 
+	/*
+	 * The platform system sleep code (exynos9820-suspend) programs the
+	 * PMU for the boot CPU itself. Let the CPU_PM_ENTER of the syscore
+	 * cpu_pm_suspend() through without touching the PMU: refusing it
+	 * would fail syscore_suspend() and abort every suspend-to-RAM.
+	 */
+	if (pmu_context->sys_insleep) {
+		raw_spin_unlock(&pmu_context->cpupm_lock);
+		return NOTIFY_OK;
+	}
+
 	/* Ignore CPU_PM_ENTER event in reboot or suspend sequence. */
 	if (pmu_context->sys_insuspend || pmu_context->sys_inreboot) {
 		raw_spin_unlock(&pmu_context->cpupm_lock);
@@ -290,6 +310,42 @@ static int exynos_cpu_pmu_offline(void)
 	return ret ? NOTIFY_BAD : NOTIFY_OK;
 }
 
+/*
+ * PSCI v0.1 firmware (Exynos 9820) has no AFFINITY_INFO, so cpu_psci_cpu_kill()
+ * returns at once and nothing waits for the dying core to be powered down.
+ * If the boot CPU then enters a SoC sleep while the last core is still on its
+ * way down, that core is left powered with a stuck power-on request and never
+ * boots again (CPU7 "failed to come online" after every deep sleep).
+ *
+ * Wait in the prepare-state teardown, which runs on the control CPU after the
+ * dying CPU called CPU_OFF, until the PMU reports the core power domain off.
+ */
+#define EXYNOS_CPU_DEAD_WAIT_MS		100
+
+static int exynos_cpuhp_pmu_dead(unsigned int cpu)
+{
+	const struct exynos_pmu_data *d = pmu_context->pmu_data;
+	unsigned int wait_ms = EXYNOS_CPU_DEAD_WAIT_MS;
+	ktime_t t0 = ktime_get();
+	unsigned int us;
+	int pwr, ret;
+
+	if (!d->cpu_pmu_powered)
+		return 0;
+
+	ret = read_poll_timeout(d->cpu_pmu_powered, pwr, pwr <= 0, 20,
+				wait_ms * USEC_PER_MSEC, false, pmu_context, cpu);
+	us = ktime_us_delta(ktime_get(), t0);
+
+	if (ret)
+		pr_warn("CPU%u: core still powered %u ms after CPU_OFF\n", cpu, wait_ms);
+	else if (us > 1000)
+		pr_info("CPU%u: core powered down after %u us\n", cpu, us);
+
+	/* never fail the teardown: the CPU is already gone for the kernel */
+	return 0;
+}
+
 /* Called from CPU hot plug callback with IRQs enabled */
 static int exynos_cpuhp_pmu_offline(unsigned int cpu)
 {
@@ -432,7 +488,7 @@ static int setup_cpuhp_and_cpuidle(struct device *dev)
 	pmu_context->cpuhp_online_state = CPUHP_INVALID;
 
 	ret = cpuhp_setup_state(CPUHP_BP_PREPARE_DYN, "soc/exynos-pmu:prepare",
-				exynos_cpuhp_pmu_online, NULL);
+				exynos_cpuhp_pmu_online, exynos_cpuhp_pmu_dead);
 	if (ret < 0)
 		return ret;
 
@@ -609,6 +665,59 @@ static int exynos_pmu_probe(struct platform_device *pdev)
 	return 0;
 }
 
+/**
+ * exynos_pmu_sys_sleep() - mark a platform system sleep (suspend-to-RAM)
+ * @on: true from the syscore suspend of the platform sleep code, with only
+ *      the boot CPU online and interrupts disabled; false from its resume.
+ *
+ * While set, the CPU_PM notifier neither programs nor undoes the C2 PMU
+ * setup: the boot CPU's CPU_PM_ENTER/EXIT come from cpu_pm_suspend() and
+ * cpu_pm_resume() (GIC save/restore), not from cpuidle, and the PMU is
+ * prepared by the platform sleep sequence instead.
+ */
+void exynos_pmu_sys_sleep(bool on)
+{
+	if (!pmu_context)
+		return;
+
+	raw_spin_lock(&pmu_context->cpupm_lock);
+	pmu_context->sys_insleep = on;
+	raw_spin_unlock(&pmu_context->cpupm_lock);
+}
+EXPORT_SYMBOL_GPL(exynos_pmu_sys_sleep);
+
+/**
+ * exynos_pmu_cpu_powered() - PMU power status of a CPU core
+ * @cpu: logical CPU
+ *
+ * Return: 1 if the PMU reports the core's power domain on, 0 if off, a
+ * negative errno if the SoC has no such status. Lockless (one regmap read).
+ */
+int exynos_pmu_cpu_powered(unsigned int cpu)
+{
+	if (!pmu_context || !pmu_context->pmu_data ||
+	    !pmu_context->pmu_data->cpu_pmu_powered)
+		return -ENODEV;
+
+	return pmu_context->pmu_data->cpu_pmu_powered(pmu_context, cpu);
+}
+EXPORT_SYMBOL_GPL(exynos_pmu_cpu_powered);
+
+/**
+ * exynos_pmu_cpu_off_affl() - affinity level for the PSCI CPU_OFF of a CPU
+ * @cpu: the dying CPU, called on it from cpu_die()
+ *
+ * Return: 0 (the core only) unless the SoC wants a higher level for this CPU.
+ */
+unsigned int exynos_pmu_cpu_off_affl(unsigned int cpu)
+{
+	if (!pmu_context || !pmu_context->pmu_data ||
+	    !pmu_context->pmu_data->cpu_off_affl)
+		return 0;
+
+	return pmu_context->pmu_data->cpu_off_affl(cpu);
+}
+
 static int exynos_cpupm_suspend_noirq(struct device *dev)
 {
 	raw_spin_lock(&pmu_context->cpupm_lock);
