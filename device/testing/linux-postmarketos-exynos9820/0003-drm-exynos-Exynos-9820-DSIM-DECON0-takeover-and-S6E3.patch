@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/samsung/samsung,exynos9820-decon.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos 9820 DECON0 display controller
+
+maintainers:
+  - StachowiakDawid <dawidos234@gmail.com>
+
+description: |
+  DECON0 is the primary display controller of the Exynos 9820. It composes up
+  to six windows fed by the DPU DMA (IDMA) channels and sends the result,
+  optionally DSC-compressed, to DSIM0. The current Linux driver adopts the
+  pipeline configured by the bootloader. Port 0 links to the panel attached to
+  DSIM0.
+
+properties:
+  compatible:
+    const: samsung,exynos9820-decon
+
+  reg:
+    items:
+      - description: DECON0 registers
+      - description: DPU DMA channels GF0..VGRFS (one 4K page each)
+
+  reg-names:
+    items:
+      - const: decon
+      - const: dma
+
+  interrupts:
+    minItems: 1
+    items:
+      - description: frame start
+      - description: frame done
+      - description: extra (errors)
+
+  interrupt-names:
+    minItems: 1
+    items:
+      - const: frame_start
+      - const: frame_done
+      - const: extra
+
+  clocks:
+    minItems: 1
+    maxItems: 16
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: Output to the panel attached to DSIM0.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    display-controller@19030000 {
+        compatible = "samsung,exynos9820-decon";
+        reg = <0x19030000 0x10000>, <0x19071000 0x6000>;
+        reg-names = "decon", "dma";
+        interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 189 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "frame_start", "frame_done", "extra";
+
+        port {
+            decon0_out: endpoint {
+                remote-endpoint = <&panel_in>;
+            };
+        };
+    };
+...
