diff --git a/drivers/gpu/drm/exynos/Kconfig b/drivers/gpu/drm/exynos/Kconfig
index a59131ae12..f33cc77114 100644
--- a/drivers/gpu/drm/exynos/Kconfig
+++ b/drivers/gpu/drm/exynos/Kconfig
@@ -14,6 +14,45 @@ config DRM_EXYNOS
 	  Choose this option if you have a Samsung SoC Exynos chipset.
 	  If M is selected the module will be called exynosdrm.
 
+config DRM_EXYNOS9820_DECON
+	tristate "Exynos 9820 DECON0 KMS driver (bootloader takeover)"
+	depends on OF && DRM && COMMON_CLK && MMU
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select DRM_KMS_HELPER
+	select DRM_BRIDGE_CONNECTOR
+	select DRM_DISPLAY_HELPER
+	select DRM_GEM_DMA_HELPER
+	select DRM_PANEL_BRIDGE
+	select DRM_CLIENT_SELECTION
+	select APERTURE_HELPERS
+	help
+	  KMS driver for DECON0 of the Exynos 9820 that adopts the display
+	  pipeline (DECON0 -> DSC -> DSIM0 -> command-mode panel) left
+	  running by the bootloader instead of initialising it. It replaces
+	  simpledrm, provides page flipping and vblank events from the TE
+	  triggered frame-start interrupt, and powers the panel down on
+	  DPMS off through the panel driver. Needs DRM_EXYNOS9820_DSIM_CMD
+	  for the panel's DSI commands.
+
+	  If M is selected the module will be called exynos9820_decon.
+
+	  If unsure, say N.
+
+config DRM_EXYNOS9820_DSIM_CMD
+	tristate "Exynos 9820 DSIM command-only host (bootloader handover)"
+	depends on OF && DRM && COMMON_CLK
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select DRM_MIPI_DSI
+	help
+	  Exposes the MIPI DSI master of the Exynos 9820 as a DSI host that
+	  can only send/receive DCS command packets over a link which was
+	  already brought up by the bootloader. The display itself keeps
+	  being scanned out through simple-framebuffer/simpledrm. This allows
+	  a DSI panel driver to control brightness and blanking until a real
+	  DECON/DSIM DRM driver exists.
+
+	  If unsure, say N.
+
 if DRM_EXYNOS
 
 comment "CRTCs"
diff --git a/drivers/gpu/drm/exynos/exynos9820_decon.c b/drivers/gpu/drm/exynos/exynos9820_decon.c
new file mode 100644
index 0000000000..fbd7bf0c36
--- /dev/null
+++ b/drivers/gpu/drm/exynos/exynos9820_decon.c
@@ -0,0 +1,1386 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 9820 DECON0 KMS driver - "takeover" of the bootloader pipeline.
+ *
+ * S-Boot brings up DECON0 -> DSC (2 slices) -> DSIM0 -> D-PHY -> S6E3HA9 in
+ * MIPI command mode, with DECON triggered by the panel TE line, and leaves
+ * window 5 / DPU DMA channel 0 (GF0) scanning a framebuffer at 0xca000000.
+ *
+ * This driver adopts that running pipeline instead of re-initialising it:
+ *  - it never resets or reprograms DECON timing, DSC, the DSIM link or the
+ *    D-PHY (no PLL bring-up);
+ *  - a page flip writes the new buffer address (and stride/format) into the
+ *    IDMA registers of the channel feeding the active window and requests a
+ *    DECON shadow update, which the hardware latches at the next TE-triggered
+ *    frame start;
+ *  - vblank comes from the DECON0 FRAME_START interrupt (one per TE-triggered
+ *    frame, 60 Hz), with a polling fallback on the FRAME_COUNT register; the
+ *    panel's TE GPIO interrupt (downstream "hw_te_on" EINT, gpd0-0) is only
+ *    used downstream for SW trigger mode / ESD and is not needed here;
+ *  - CRTC off ("soft_off", default): the pipeline keeps running, the panel
+ *    goes display off + sleep in over DCS and the window is parked on the
+ *    reserved boot framebuffer; CRTC on: sleep out + init + display on.
+ *    With soft_off=0 the encoder instead masks the TE trigger (DECON stops
+ *    fetching) after display off, and unmasks it after the panel init.
+ *
+ * Panel power and touch: the S6SY761 touch controller only senses while the
+ * DDIC drives its sync output (TSP HSYNC, command B9h, sent by the panel
+ * init sequence). A DPMS off/on through this driver re-runs that init, the
+ * same as the bl_power 1->0 cycle that is known to wake touch.
+ *
+ * DSI commands to the panel go through the separate exynos9820-dsim-cmd
+ * handover host, the panel itself is a regular drm_panel found through the
+ * OF graph (port 0 of the DECON node).
+ *
+ * The DRM driver is named "exynos" on purpose: Mesa's kmsro loader knows that
+ * name, so panfrost renders into dumb buffers allocated here.
+ *
+ * Register layout from Samsung's downstream SM-G97x kernel,
+ * drivers/video/fbdev/exynos/dpu20/cal_9820/{regs-decon.h,regs-dpp.h,
+ * decon_reg.c,dpp_reg.c}.
+ */
+
+#include <linux/aperture.h>
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/hrtimer.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/scatterlist.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/workqueue.h>
+
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_bridge_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_of.h>
+#include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+#include <drm/clients/drm_client_setup.h>
+
+/* DECON0 */
+#define DECON_GLOBAL_CONTROL		0x0000
+#define  GLOBAL_CONTROL_OPERATION_MODE_CMD	BIT(8)
+#define  GLOBAL_CONTROL_IDLE_STATUS	BIT(5)
+#define  GLOBAL_CONTROL_RUN_STATUS	BIT(4)
+#define  GLOBAL_CONTROL_DECON_EN	BIT(1)
+#define  GLOBAL_CONTROL_DECON_EN_F	BIT(0)
+#define DECON_INTERRUPT_ENABLE		0x0040
+#define  DPU_FRAME_DONE_INT_EN		BIT(13)
+#define  DPU_FRAME_START_INT_EN		BIT(12)
+#define  DPU_EXTRA_INT_EN		BIT(4)
+#define  DPU_INT_EN			BIT(0)
+#define DECON_EXTRA_INTERRUPT_ENABLE	0x0044
+#define  DPU_RESOURCE_CONFLICT_INT_EN	BIT(8)
+#define  DPU_TIME_OUT_INT_EN		BIT(4)
+#define DECON_INTERRUPT_PENDING		0x004c
+#define  DPU_FRAME_DONE_INT_PEND	BIT(13)
+#define  DPU_FRAME_START_INT_PEND	BIT(12)
+#define  DPU_EXTRA_INT_PEND		BIT(4)
+#define DECON_EXTRA_INTERRUPT_PENDING	0x0050
+#define  DPU_RESOURCE_CONFLICT_INT_PEND	BIT(8)
+#define  DPU_TIME_OUT_INT_PEND		BIT(4)
+#define DECON_SHADOW_REG_UPDATE_REQ	0x0060
+#define  SHADOW_REG_UPDATE_REQ_GLOBAL	BIT(31)
+#define  SHADOW_REG_UPDATE_REQ_WIN(w)	BIT(w)
+#define DECON_HW_SW_TRIG_CONTROL	0x0070
+#define  HW_TRIG_MASK_DECON		BIT(4)
+#define  HW_TRIG_EN			BIT(0)
+#define DECON_HW_TE_CNT			0x0078
+#define DECON_BLENDER_BG_IMAGE_SIZE_0	0x0200
+#define  BLENDER_BG_HEIGHT		GENMASK(29, 16)
+#define  BLENDER_BG_WIDTH		GENMASK(13, 0)
+#define DECON_DATA_PATH_CONTROL_0	0x0214
+#define  WIN_EN_F(w)			BIT(4 * (w))
+#define DECON_DATA_PATH_CONTROL_1	0x0218
+#define  WIN_CHMAP(w)			(0x7 << (4 * (w)))
+#define DECON_FRAME_COUNT		0x02a0
+#define DECON_WIN_CONTROL_0(w)		(0x1000 + (w) * 0x30)
+#define  WIN_ALPHA1			GENMASK(31, 24)
+#define  WIN_ALPHA0			GENMASK(23, 16)
+#define  WIN_FUNC			GENMASK(11, 8)
+#define  WIN_FUNC_COPY			1	/* PD_FUNC_COPY */
+#define  WIN_ALPHA_MULT_SRC_SEL		GENMASK(1, 0)
+#define  WIN_ALPHA_MULT_SRC_SEL_AF	2
+#define DECON_WIN_CONTROL_1(w)		(0x1004 + (w) * 0x30)
+#define DECON_MAX_WIN			6
+
+/* DPU DMA (IDMA) channel, one 4K page each, see decon_dma_offset[] */
+#define IDMA_ENABLE			0x0000
+#define IDMA_IRQ			0x0004
+#define IDMA_IN_CON			0x0008
+#define  IDMA_IMG_FORMAT		GENMASK(16, 11)
+#define  IDMA_ROTATION			GENMASK(10, 8)
+#define  IDMA_AFBC_EN			BIT(7)
+#define  IDMA_BLOCK_EN			BIT(3)
+/*
+ * Downstream idma_reg_set_coordinates(): SRC_SIZE is the whole buffer
+ * (f_w = stride in pixels, f_h), SRC_OFFSET + IMG_SIZE the crop that is read.
+ */
+#define IDMA_OUT_CON			0x000c
+#define  IDMA_OUT_FRAME_ALPHA		GENMASK(31, 24)
+#define IDMA_SRC_SIZE			0x0010
+#define  IDMA_SRC_HEIGHT		GENMASK(29, 16)
+#define  IDMA_SRC_WIDTH			GENMASK(15, 0)
+#define IDMA_SRC_OFFSET			0x0014
+#define  IDMA_SRC_OFFSET_Y		GENMASK(28, 16)
+#define  IDMA_SRC_OFFSET_X		GENMASK(12, 0)
+#define IDMA_IMG_SIZE			0x0018
+#define  IDMA_IMG_HEIGHT		GENMASK(28, 16)
+#define  IDMA_IMG_WIDTH			GENMASK(12, 0)
+#define IDMA_IN_BASE_ADDR_Y		0x0040
+#define IDMA_SHADOW_OFFSET		0x0800
+
+#define IDMA_IMG_FORMAT_ARGB8888	0
+#define IDMA_IMG_FORMAT_ABGR8888	1
+#define IDMA_IMG_FORMAT_XRGB8888	4
+#define IDMA_IMG_FORMAT_XBGR8888	5
+
+/*
+ * DPP: the block between a channel's IDMA and its DECON window (downstream
+ * cal_9820/regs-dpp.h). Only the input format/alpha selection is touched.
+ */
+#define DPP_ENABLE			0x0000
+#define  DPP_SFR_UPDATE_FORCE		BIT(4)
+#define DPP_IN_CON			0x0008
+#define  DPP_ALPHA_SEL			BIT(3)	/* 0 per-frame, 1 per-pixel */
+#define  DPP_IMG_FORMAT			GENMASK(2, 0)	/* 0 = ARGB8888 */
+#define DPP_GF0_BASE			0x19021000
+#define DPP_SIZE			0x1000
+
+/* Offset of each DECON channel's DPP block from the GF0 block (0x19021000) */
+static const u32 decon_dpp_offset[] = {
+	[0] = 0x0000,	/* GF0   0x19021000 */
+	[1] = 0x5000,	/* VGRFS 0x19026000 */
+	[2] = 0x1000,	/* GF1   0x19022000 */
+	[3] = 0x3000,	/* VGF   0x19024000 */
+	[4] = 0x2000,	/* VG    0x19023000 */
+	[5] = 0x4000,	/* VGS   0x19025000 */
+};
+
+/* Offset of each DECON channel's DMA block from the GF0 block (0x19071000) */
+static const u32 decon_dma_offset[] = {
+	[0] = 0x0000,	/* GF0   0x19071000 */
+	[1] = 0x5000,	/* VGRFS 0x19076000 */
+	[2] = 0x1000,	/* GF1   0x19072000 */
+	[3] = 0x4000,	/* VGF   0x19075000 */
+	[4] = 0x2000,	/* VG    0x19073000 */
+	[5] = 0x3000,	/* VGS   0x19074000 */
+};
+
+/*
+ * Off by default: loading the module (udev autoload with the DT node
+ * present) must not take the screen away from simpledrm until the takeover
+ * has been tested. Enable with exynos9820_decon.enable=1 on the cmdline or
+ * modprobe, or at runtime: echo 1 > /sys/module/exynos9820_decon/parameters/enable
+ * and bind 19030000.display-controller to the driver through sysfs.
+ */
+static bool enable;
+module_param(enable, bool, 0644);
+MODULE_PARM_DESC(enable, "Take over the bootloader display pipeline (default: false)");
+
+static bool fbdev;
+module_param(fbdev, bool, 0444);
+MODULE_PARM_DESC(fbdev, "Register fbdev emulation (costs one 17 MiB CMA buffer, default: false)");
+
+/*
+ * CRTC off ("DPMS off", blank, suspend):
+ *  1 (default) "soft off": the DECON -> DSIM -> panel pipeline keeps running
+ *    exactly as the bootloader left it. Only the panel goes display off +
+ *    sleep in over DCS, and the window is parked on the reserved boot
+ *    framebuffer so that no client buffer is read after the CRTC is off.
+ *    On enable the panel gets sleep out + init + 120 ms + display on. This
+ *    is the panel's bl_power 1 -> 0 path, which is known to work on the
+ *    phone.
+ *  0 the earlier behaviour: the TE trigger is masked while off (DECON stops
+ *    fetching), unmasked again after the panel init.
+ */
+static bool soft_off = true;
+module_param(soft_off, bool, 0644);
+MODULE_PARM_DESC(soft_off, "CRTC off keeps the TE trigger running on the parked boot framebuffer (default: true)");
+
+/*
+ * Fetch with the IDMA ARGB/ABGR codes (format 0/1) S-Boot uses, not
+ * XRGB/XBGR (4/5): on the phone a static
+ * high-contrast image fetched with code 4 shows torn/shifted strips, the
+ * same image with code 0 (own buffer or S-Boot's) is clean.
+ *
+ * Downstream programs the IDMA format together with the DPP: for the X
+ * formats it switches the DPP to per-frame alpha (dpp_reg.c
+ * dma_dpp_reg_set_format(): alpha_type 0 for XRGB/XBGR, 1 for ARGB/ABGR;
+ * DPP_IN_CON ALPHA_SEL bit 3). This driver does not map the DPP block, so
+ * S-Boot's per-pixel-alpha DPP setup stays, and only the A codes match it.
+ * The window blends with PD_FUNC_COPY (WIN_CONTROL_0 0x102), so the alpha
+ * value itself is not used.
+ *
+ * DECON registers take effect when a SHADOW_REG_UPDATE_REQ is consumed at a
+ * frame start: GLOBAL (bit 31) latches the global block (0x0000-0x011c,
+ * 0x0230-...), WIN(w) the window. simpledrm never requests an update, the
+ * takeover's first commit did (GLOBAL | WIN), and the thin black lines at
+ * the top/bottom appear only with the takeover although every readable
+ * register (incl. format, sizes) equals the S-Boot state. A GLOBAL latch of
+ * values S-Boot programmed but never latched is the remaining suspect; the
+ * +0x7000 readback cannot prove it, because it does not track latches for
+ * all offsets (0x0250, 0x1180, 0x1214 read the same before and after).
+ *
+ * So only WIN(w) is requested; if the IDMA does not pick up the new buffer
+ * that way (checked 250 ms after enable), fall back to GLOBAL | WIN for the
+ * rest of the boot.
+ *
+ * Downstream (decon_core.c __decon_update_regs) only writes the window/DMA
+ * registers while DECON is idle and masks the TE trigger around them. The
+ * takeover keeps the trigger running at every TE, and a plane update does
+ * not touch the TE
+ * trigger at all. The IDMA/window registers are double buffered and only
+ * the SHADOW_REG_UPDATE_REQ write, done last in atomic_flush, makes them
+ * eligible; the next TE-triggered frame start latches all of them at once.
+ * A frame in flight keeps reading the active (old) values, and the flip
+ * event is sent at the frame start that consumed the request, after the
+ * last frame that read the old buffer has finished. Masking around the
+ * register writes can hold back the frame of a TE that arrives
+ * while masked, so the DECON write to the panel GRAM no longer follows the
+ * panel scan. Where the content changes (clock at the top, home bar at the
+ * bottom under phoc), that shows as torn strips.
+ *
+ * The shadow update request is written only while a
+ * TE-triggered frame is in flight and has started less than 7 ms ago (a
+ * frame takes ~10 ms of the 16.7 ms period). The request is then consumed at
+ * the next TE-triggered frame start. A request written while DECON is idle
+ * between frames might be taken as a start (downstream decon_reg_start():
+ * "DECON goes to run-status as soon as request shadow update without
+ * HW_TE"), so the GRAM write would begin off the TE edge and tear against
+ * the panel scan.
+ *
+ * Alpha handling. Downstream programs three places together for
+ * every window (dma_dpp_reg_set_format(), dpp_reg_init(),
+ * decon_reg_set_win_bnd_function()):
+ *   IDMA format code      A (0/1) or X (4/5)
+ *   DPP_IN_CON ALPHA_SEL  per-pixel for A, per-frame for X
+ *   IDMA_OUT_CON          frame alpha 0xff
+ *   WIN_CONTROL_0         ALPHA0/1 0xff, COPY for no blending
+ * S-Boot leaves: A code, DPP_IN_CON 0 (per-frame), OUT_CON 0xff000000,
+ * WIN_CONTROL_0 0x00000102 (COPY, ALPHA0/1 = 0). With that state, pixels
+ * whose 4th byte is 0xff are clean and phoc's XRGB buffers (4th byte 0x00
+ * everywhere) show artefacts although the memory is right.
+ * Everything but the IDMA code is left as inherited. The channel's DPP block
+ * is mapped (DT reg 'dpp', else the fixed 9820 address) to log and restore
+ * its inherited state.
+ */
+
+struct decon_format {
+	u32 drm;
+	u32 hw;
+};
+
+/*
+ * The bootloader scans out hw format 0 (ARGB8888) described to simplefb as
+ * "a8r8g8b8" (= DRM_FORMAT_ARGB8888) with correct colours, so the IDMA names
+ * match the DRM ones. There is nothing below the primary plane, so the alpha
+ * formats are fetched as their X variants: a client buffer with alpha 0
+ * (common for XRGB-in-ARGB) must not blend to black. IMG_FORMAT_ARGB8888 is
+ * kept for reference.
+ */
+static const struct decon_format decon_formats[] = {
+	{ DRM_FORMAT_XRGB8888, IDMA_IMG_FORMAT_XRGB8888 },
+	{ DRM_FORMAT_ARGB8888, IDMA_IMG_FORMAT_XRGB8888 },
+	{ DRM_FORMAT_XBGR8888, IDMA_IMG_FORMAT_XBGR8888 },
+	{ DRM_FORMAT_ABGR8888, IDMA_IMG_FORMAT_XBGR8888 },
+};
+static_assert(IDMA_IMG_FORMAT_ARGB8888 == 0 && IDMA_IMG_FORMAT_ABGR8888 == 1);
+static_assert(IDMA_IMG_FORMAT_XRGB8888 - IDMA_IMG_FORMAT_ARGB8888 ==
+	      IDMA_IMG_FORMAT_XBGR8888 - IDMA_IMG_FORMAT_ABGR8888);
+
+static const u32 decon_plane_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_ABGR8888,
+};
+
+struct decon {
+	struct drm_device drm;
+	struct drm_plane plane;
+	struct drm_crtc crtc;
+	struct drm_encoder *encoder;
+	struct drm_bridge *bridge;
+	struct drm_connector *connector;
+
+	void __iomem *regs;
+	void __iomem *dma_base;
+	void __iomem *idma;		/* channel feeding the active window */
+	void __iomem *dpp;		/* that channel's DPP, NULL if not mapped */
+	int irq;
+	int irq_done;
+	int irq_extra;
+	atomic_t irq_count;		/* FRAME_START interrupts seen */
+
+	unsigned int win;
+	unsigned int ch;
+	unsigned int width, height;
+	phys_addr_t boot_fb;
+	size_t boot_fb_size;
+
+	bool poll;			/* vblank from hrtimer + FRAME_COUNT */
+	struct hrtimer timer;
+	u32 last_frame;
+	bool vblank_enabled;
+
+	struct drm_pending_vblank_event *event; /* under drm.event_lock */
+	bool trigger_on;		/* encoder enabled: TE trigger unmasked */
+
+	/* IDMA state inherited from the bootloader, used to park the window */
+	u32 boot_con, boot_src, boot_ofs, boot_img;
+	u32 boot_out, boot_dpp_con, boot_win0;	/* inherited alpha setup */
+
+	/* "are frames flowing after enable?" check */
+	struct delayed_work check_work;
+	bool need_global;		/* WIN-only did not latch the IDMA */
+	/* start of the last frame, from the FRAME_START interrupt */
+	ktime_t t_start;
+	u32 enable_frame;
+	int enable_irqs;
+};
+
+#define to_decon(d) container_of(d, struct decon, drm)
+
+static inline u32 decon_read(struct decon *d, u32 reg)
+{
+	return readl(d->regs + reg);
+}
+
+static inline void decon_write(struct decon *d, u32 reg, u32 val)
+{
+	writel(val, d->regs + reg);
+}
+
+static inline void decon_write_mask(struct decon *d, u32 reg, u32 val, u32 mask)
+{
+	u32 old = decon_read(d, reg);
+
+	decon_write(d, reg, (old & ~mask) | (val & mask));
+}
+
+static u32 decon_update_mask(struct decon *d)
+{
+	bool global = READ_ONCE(d->need_global);
+
+	return (global ? SHADOW_REG_UPDATE_REQ_GLOBAL : 0) |
+	       SHADOW_REG_UPDATE_REQ_WIN(d->win);
+}
+
+/* ------------------------------------------------------------------ */
+/* vblank / flip completion                                            */
+
+/*
+ * The flip is done once DECON has consumed (latched at a frame start) the
+ * shadow update request: from then on the new buffer is scanned and the old
+ * one is no longer read. Checked at FRAME_START and again at FRAME_DONE, in
+ * case the request bit clears only after the FRAME_START interrupt.
+ */
+static void decon_complete_flip(struct decon *d)
+{
+	struct drm_crtc *crtc = &d->crtc;
+	unsigned long flags;
+
+	spin_lock_irqsave(&d->drm.event_lock, flags);
+	if (d->event &&
+	    !(decon_read(d, DECON_SHADOW_REG_UPDATE_REQ) & decon_update_mask(d))) {
+		drm_crtc_send_vblank_event(crtc, d->event);
+		d->event = NULL;
+		drm_crtc_vblank_put(crtc);
+	}
+	spin_unlock_irqrestore(&d->drm.event_lock, flags);
+}
+
+static void decon_frame_start(struct decon *d)
+{
+	if (READ_ONCE(d->vblank_enabled))
+		drm_crtc_handle_vblank(&d->crtc);
+
+	decon_complete_flip(d);
+}
+
+static irqreturn_t decon_irq(int irq, void *arg)
+{
+	struct decon *d = arg;
+	u32 pend = decon_read(d, DECON_INTERRUPT_PENDING);
+
+	pend &= DPU_FRAME_START_INT_PEND | DPU_FRAME_DONE_INT_PEND |
+		DPU_EXTRA_INT_PEND;
+	if (!pend)
+		return IRQ_NONE;
+
+	/* write-1-to-clear, as downstream decon_reg_get_interrupt_and_clear() */
+	decon_write(d, DECON_INTERRUPT_PENDING, pend);
+	if (pend & DPU_FRAME_START_INT_PEND) {
+		ktime_t now = ktime_get();
+
+		d->t_start = now;
+		atomic_inc(&d->irq_count);
+	}
+
+	if (pend & DPU_EXTRA_INT_PEND) {
+		u32 ext = decon_read(d, DECON_EXTRA_INTERRUPT_PENDING);
+
+		decon_write(d, DECON_EXTRA_INTERRUPT_PENDING, ext);
+		if (ext & DPU_RESOURCE_CONFLICT_INT_PEND)
+			dev_warn_ratelimited(d->drm.dev, "DECON resource conflict\n");
+		if (ext & DPU_TIME_OUT_INT_PEND)
+			dev_warn_ratelimited(d->drm.dev, "DECON timeout\n");
+	}
+
+	if (!d->poll) {
+		if (pend & DPU_FRAME_START_INT_PEND)
+			decon_frame_start(d);
+		else if (pend & DPU_FRAME_DONE_INT_PEND)
+			decon_complete_flip(d);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static enum hrtimer_restart decon_poll_timer(struct hrtimer *t)
+{
+	struct decon *d = container_of(t, struct decon, timer);
+	u32 frame = decon_read(d, DECON_FRAME_COUNT);
+
+	if (frame != d->last_frame) {
+		d->last_frame = frame;
+		decon_frame_start(d);
+	}
+
+	/* ~4x the 60 Hz frame rate, so a frame is seen within ~4 ms */
+	hrtimer_forward_now(t, us_to_ktime(4000));
+	return HRTIMER_RESTART;
+}
+
+static int decon_enable_vblank(struct drm_crtc *crtc)
+{
+	struct decon *d = to_decon(crtc->dev);
+
+	WRITE_ONCE(d->vblank_enabled, true);
+	return 0;
+}
+
+static void decon_disable_vblank(struct drm_crtc *crtc)
+{
+	struct decon *d = to_decon(crtc->dev);
+
+	WRITE_ONCE(d->vblank_enabled, false);
+}
+
+/* ------------------------------------------------------------------ */
+/* trigger control                                                     */
+
+/*
+ * Downstream decon_reg_set_trigger() for DECON_HW_TRIG: enable = HW_TRIG_EN
+ * with the mask cleared, disable = HW_TRIG_MASK_DECON. While masked no new
+ * TE-triggered frame starts; a frame already being transferred completes.
+ */
+static void decon_mask_trigger(struct decon *d, bool mask)
+{
+	if (mask)
+		decon_write_mask(d, DECON_HW_SW_TRIG_CONTROL, HW_TRIG_MASK_DECON,
+				 HW_TRIG_MASK_DECON);
+	else if ((decon_read(d, DECON_HW_SW_TRIG_CONTROL) &
+		  (HW_TRIG_EN | HW_TRIG_MASK_DECON)) != HW_TRIG_EN)
+		/* only write when something changes: never "re-arm" a running trigger */
+		decon_write_mask(d, DECON_HW_SW_TRIG_CONTROL, HW_TRIG_EN,
+				 HW_TRIG_EN | HW_TRIG_MASK_DECON);
+}
+
+/* One line with everything that tells whether frames are flowing */
+static void decon_log_state(struct decon *d, const char *what)
+{
+	dev_info(d->drm.dev,
+		 "%s: GC %08x TRIG %08x TE_CNT %08x FRAME %08x SHADOW_REQ %08x PEND %08x irqs %d; IDMA EN %08x IRQ %08x IN_CON %08x base %08x (active %08x)\n",
+		 what, decon_read(d, DECON_GLOBAL_CONTROL),
+		 decon_read(d, DECON_HW_SW_TRIG_CONTROL),
+		 decon_read(d, DECON_HW_TE_CNT),
+		 decon_read(d, DECON_FRAME_COUNT),
+		 decon_read(d, DECON_SHADOW_REG_UPDATE_REQ),
+		 decon_read(d, DECON_INTERRUPT_PENDING),
+		 atomic_read(&d->irq_count),
+		 readl(d->idma + IDMA_ENABLE), readl(d->idma + IDMA_IRQ),
+		 readl(d->idma + IDMA_IN_CON),
+		 readl(d->idma + IDMA_IN_BASE_ADDR_Y),
+		 readl(d->idma + IDMA_SHADOW_OFFSET + IDMA_IN_BASE_ADDR_Y));
+}
+
+/*
+ * Point the window back at the bootloader framebuffer (reserved, nomap
+ * memory that stays valid forever), so that a running TE trigger never
+ * reads a client buffer that is freed after the CRTC is turned off.
+ */
+static void decon_restore_alpha(struct decon *d)
+{
+	writel(d->boot_out, d->idma + IDMA_OUT_CON);
+	if (d->dpp)
+		writel(d->boot_dpp_con, d->dpp + DPP_IN_CON);
+	decon_write(d, DECON_WIN_CONTROL_0(d->win), d->boot_win0);
+}
+
+static void decon_park(struct decon *d)
+{
+	decon_restore_alpha(d);
+	writel(d->boot_con, d->idma + IDMA_IN_CON);
+	writel(d->boot_src, d->idma + IDMA_SRC_SIZE);
+	writel(d->boot_ofs, d->idma + IDMA_SRC_OFFSET);
+	writel(d->boot_img, d->idma + IDMA_IMG_SIZE);
+	writel(lower_32_bits(d->boot_fb), d->idma + IDMA_IN_BASE_ADDR_Y);
+	decon_write_mask(d, DECON_SHADOW_REG_UPDATE_REQ, ~0u,
+			 decon_update_mask(d));
+}
+
+static void decon_check_frames(struct work_struct *work)
+{
+	struct decon *d = container_of(to_delayed_work(work), struct decon,
+				       check_work);
+	u32 frame = decon_read(d, DECON_FRAME_COUNT);
+
+	if (frame == d->enable_frame)
+		dev_warn(d->drm.dev,
+			 "no frame in 250 ms after enable (panel TE missing or DECON/DSIM stalled)\n");
+	else
+		dev_info(d->drm.dev, "%u frames, %d frame-start irqs in 250 ms after enable\n",
+			 frame - d->enable_frame,
+			 atomic_read(&d->irq_count) - d->enable_irqs);
+
+	if (!d->need_global && frame != d->enable_frame) {
+		u32 prog = readl(d->idma + IDMA_IN_BASE_ADDR_Y);
+		u32 act = readl(d->idma + IDMA_SHADOW_OFFSET + IDMA_IN_BASE_ADDR_Y);
+		u32 req = decon_read(d, DECON_SHADOW_REG_UPDATE_REQ);
+
+		if (prog != act && !(req & SHADOW_REG_UPDATE_REQ_WIN(d->win))) {
+			WRITE_ONCE(d->need_global, true);
+			dev_warn(d->drm.dev,
+				 "IDMA did not latch base %08x with a WIN-only update (active %08x): using GLOBAL updates from now on\n",
+				 prog, act);
+			decon_write_mask(d, DECON_SHADOW_REG_UPDATE_REQ, ~0u,
+					 decon_update_mask(d));
+		} else {
+			dev_info(d->drm.dev, "WIN-only shadow update: IDMA base %08x active %08x, GLOBAL never requested\n",
+				 prog, act);
+		}
+	}
+	decon_log_state(d, "enable+250ms");
+}
+
+/* ------------------------------------------------------------------ */
+/* plane                                                               */
+
+static const struct decon_format *decon_find_format(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(decon_formats); i++)
+		if (decon_formats[i].drm == fourcc)
+			return &decon_formats[i];
+	return NULL;
+}
+
+static int decon_plane_atomic_check(struct drm_plane *plane,
+				    struct drm_atomic_commit *state)
+{
+	struct drm_plane_state *ps = drm_atomic_get_new_plane_state(state, plane);
+	struct decon *d = to_decon(plane->dev);
+	struct drm_crtc_state *cs;
+	struct drm_gem_dma_object *obj;
+	struct drm_framebuffer *fb = ps->fb;
+	int ret;
+
+	if (!ps->crtc)
+		return 0;
+
+	cs = drm_atomic_get_new_crtc_state(state, ps->crtc);
+	if (WARN_ON(!cs))
+		return -EINVAL;
+
+	ret = drm_atomic_helper_check_plane_state(ps, cs, DRM_PLANE_NO_SCALING,
+						  DRM_PLANE_NO_SCALING,
+						  false, false);
+	if (ret || !ps->visible)
+		return ret;
+
+	/* The window is fixed full-screen: no positioning, no cropping */
+	if (ps->dst.x1 || ps->dst.y1 ||
+	    drm_rect_width(&ps->dst) != d->width ||
+	    drm_rect_height(&ps->dst) != d->height ||
+	    (ps->src.x1 >> 16) || (ps->src.y1 >> 16))
+		return -EINVAL;
+
+	if (fb->pitches[0] % fb->format->cpp[0] ||
+	    fb->pitches[0] / fb->format->cpp[0] > FIELD_MAX(IDMA_SRC_WIDTH) ||
+	    fb->height > FIELD_MAX(IDMA_SRC_HEIGHT))
+		return -EINVAL;
+
+	obj = drm_fb_dma_get_gem_obj(fb, 0);
+	/* IDMA base address registers are 32 bit, no IOMMU in front */
+	if (obj->dma_addr + fb->offsets[0] +
+	    (u64)fb->pitches[0] * fb->height > SZ_4G) {
+		drm_dbg_kms(plane->dev, "buffer above 4 GiB: %pad\n",
+			    &obj->dma_addr);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void decon_log_alpha(struct decon *d, const char *what)
+{
+	dev_info(d->drm.dev,
+		 "%s: IDMA IN_CON %08x (code %u) OUT_CON %08x, DPP EN %08x IN_CON %08x (%s), WIN%u CONTROL_0 %08x CONTROL_1 %08x\n",
+		 what, readl(d->idma + IDMA_IN_CON),
+		 (u32)FIELD_GET(IDMA_IMG_FORMAT, readl(d->idma + IDMA_IN_CON)),
+		 readl(d->idma + IDMA_OUT_CON),
+		 d->dpp ? readl(d->dpp + DPP_ENABLE) : 0,
+		 d->dpp ? readl(d->dpp + DPP_IN_CON) : 0,
+		 !d->dpp ? "not mapped" :
+		 readl(d->dpp + DPP_IN_CON) & DPP_ALPHA_SEL ? "per-pixel" : "per-frame",
+		 d->win, decon_read(d, DECON_WIN_CONTROL_0(d->win)),
+		 decon_read(d, DECON_WIN_CONTROL_1(d->win)));
+}
+
+/*
+ * IDMA format code (the A code of the format, see above). The caller
+ * requests the shadow update.
+ */
+static void decon_program_format(struct decon *d, const struct decon_format *fmt)
+{
+	u32 con;
+
+	con = readl(d->idma + IDMA_IN_CON);
+	con &= ~(IDMA_IMG_FORMAT | IDMA_ROTATION | IDMA_AFBC_EN | IDMA_BLOCK_EN);
+	con |= FIELD_PREP(IDMA_IMG_FORMAT,
+			  fmt->hw - IDMA_IMG_FORMAT_XRGB8888);
+	writel(con, d->idma + IDMA_IN_CON);
+}
+
+static void decon_plane_atomic_update(struct drm_plane *plane,
+				      struct drm_atomic_commit *state)
+{
+	struct drm_plane_state *ps = drm_atomic_get_new_plane_state(state, plane);
+	struct decon *d = to_decon(plane->dev);
+	struct drm_framebuffer *fb = ps->fb;
+	const struct decon_format *fmt;
+	dma_addr_t addr;
+
+	if (!fb || !ps->visible)
+		return;
+
+	fmt = decon_find_format(fb->format->format);
+	if (WARN_ON(!fmt))
+		return;
+
+	addr = drm_fb_dma_get_gem_addr(fb, ps, 0);
+
+	decon_program_format(d, fmt);
+
+	/* SRC_SIZE: whole buffer (stride in pixels), IMG_SIZE: what is read */
+	writel(FIELD_PREP(IDMA_SRC_HEIGHT, fb->height) |
+	       FIELD_PREP(IDMA_SRC_WIDTH, fb->pitches[0] / fb->format->cpp[0]),
+	       d->idma + IDMA_SRC_SIZE);
+	writel(0, d->idma + IDMA_SRC_OFFSET);
+	writel(FIELD_PREP(IDMA_IMG_HEIGHT, d->height) |
+	       FIELD_PREP(IDMA_IMG_WIDTH, d->width), d->idma + IDMA_IMG_SIZE);
+	/* drm_fb_dma_get_gem_addr() already includes the src x/y offset (0) */
+	writel(lower_32_bits(addr), d->idma + IDMA_IN_BASE_ADDR_Y);
+}
+
+static const struct drm_plane_helper_funcs decon_plane_helper_funcs = {
+	.atomic_check = decon_plane_atomic_check,
+	.atomic_update = decon_plane_atomic_update,
+	/* no atomic_disable: the CRTC requires the primary plane */
+};
+
+static const struct drm_plane_funcs decon_plane_funcs = {
+	.update_plane = drm_atomic_helper_update_plane,
+	.disable_plane = drm_atomic_helper_disable_plane,
+	.destroy = drm_plane_cleanup,
+	.atomic_create_state = drm_atomic_helper_plane_create_state,
+	.atomic_duplicate_state = drm_atomic_helper_plane_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_plane_destroy_state,
+};
+
+/* ------------------------------------------------------------------ */
+/* CRTC                                                                */
+
+static enum drm_mode_status decon_crtc_mode_valid(struct drm_crtc *crtc,
+						  const struct drm_display_mode *mode)
+{
+	struct decon *d = to_decon(crtc->dev);
+
+	/* Timing/DSC/DSIM are inherited, only the native size works */
+	if (mode->hdisplay != d->width || mode->vdisplay != d->height)
+		return MODE_BAD;
+	return MODE_OK;
+}
+
+static int decon_crtc_atomic_check(struct drm_crtc *crtc,
+				   struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *cs = drm_atomic_get_new_crtc_state(state, crtc);
+
+	if (cs->active && !(cs->plane_mask & drm_plane_mask(crtc->primary)))
+		return -EINVAL;
+	return 0;
+}
+
+/*
+ * Commit order (drm_atomic_helper_commit_tail_rpm):
+ *   disable: panel disable (backlight_disable: display off + sleep in) ->
+ *            encoder disable (soft_off: park the window on the boot fb,
+ *            trigger keeps running; else mask the trigger and wait for
+ *            idle) -> panel unprepare (soft: nothing more; panel
+ *            power_off=1: reset + supplies off) -> CRTC disable (vblank off)
+ *   enable:  CRTC enable (vblank on) -> panel prepare (sleep out + init
+ *            incl. TE on and the TSP sync setup + 120 ms; after a real
+ *            power off also supplies + reset first) -> encoder enable
+ *            (unmask) -> panel enable (display on)
+ *   planes:  the plane writes the (double buffered) IDMA registers, CRTC
+ *            flush waits for the first 7 ms of a frame in flight and
+ *            requests the shadow update; the trigger is not masked.
+ */
+static void decon_crtc_atomic_enable(struct drm_crtc *crtc,
+				     struct drm_atomic_commit *state)
+{
+	drm_crtc_vblank_on(crtc);
+}
+
+static void decon_crtc_atomic_disable(struct drm_crtc *crtc,
+				      struct drm_atomic_commit *state)
+{
+	struct decon *d = to_decon(crtc->dev);
+	unsigned long flags;
+
+	drm_crtc_vblank_off(crtc);
+
+	spin_lock_irqsave(&d->drm.event_lock, flags);
+	if (d->event) {
+		drm_crtc_send_vblank_event(crtc, d->event);
+		d->event = NULL;
+		drm_crtc_vblank_put(crtc);
+	}
+	if (crtc->state->event && !crtc->state->active) {
+		drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+	}
+	spin_unlock_irqrestore(&d->drm.event_lock, flags);
+}
+
+/* Wait for the first 7 ms of a TE-triggered frame in flight (see above). */
+static void decon_wait_in_frame(struct decon *d)
+{
+	ktime_t t0 = ktime_get(), now = t0;
+
+	for (;;) {
+		bool busy = !(decon_read(d, DECON_GLOBAL_CONTROL) &
+			      GLOBAL_CONTROL_IDLE_STATUS);
+		s64 since = ktime_us_delta(now, READ_ONCE(d->t_start));
+
+		if (busy && since >= 0 && since < 7000)
+			break;
+		if (ktime_us_delta(now, t0) > 40000) {
+			dev_warn_ratelimited(d->drm.dev, "no frame in flight to latch the update in\n");
+			break;
+		}
+		usleep_range(200, 300);
+		now = ktime_get();
+	}
+}
+
+static void decon_crtc_atomic_flush(struct drm_crtc *crtc,
+				    struct drm_atomic_commit *state)
+{
+	struct decon *d = to_decon(crtc->dev);
+	struct drm_pending_vblank_event *event = crtc->state->event;
+	unsigned long flags;
+
+	if (!crtc->state->active)
+		return;
+
+	if (d->trigger_on)
+		decon_wait_in_frame(d);
+
+	/* Latch the new IDMA/window state at the next frame start */
+	decon_write_mask(d, DECON_SHADOW_REG_UPDATE_REQ, ~0u,
+			 decon_update_mask(d));
+	if (d->trigger_on)
+		decon_mask_trigger(d, false);
+
+	if (!event)
+		return;
+	crtc->state->event = NULL;
+
+	spin_lock_irqsave(&d->drm.event_lock, flags);
+	if (drm_crtc_vblank_get(crtc) == 0) {
+		WARN_ON(d->event);
+		d->event = event;
+	} else {
+		drm_crtc_send_vblank_event(crtc, event);
+	}
+	spin_unlock_irqrestore(&d->drm.event_lock, flags);
+}
+
+/* Between panel prepare (sleep out, init, TE on) and panel enable (display on) */
+static void decon_encoder_atomic_enable(struct drm_encoder *encoder,
+					struct drm_atomic_commit *state)
+{
+	struct decon *d = to_decon(encoder->dev);
+
+	decon_write_mask(d, DECON_SHADOW_REG_UPDATE_REQ, ~0u,
+			 decon_update_mask(d));
+	decon_mask_trigger(d, false);
+	d->trigger_on = true;
+
+	decon_log_state(d, "enable");
+	d->enable_frame = decon_read(d, DECON_FRAME_COUNT);
+	d->enable_irqs = atomic_read(&d->irq_count);
+	schedule_delayed_work(&d->check_work, msecs_to_jiffies(250));
+}
+
+/* Between panel disable (display off, sleep in) and panel unprepare */
+static void decon_encoder_atomic_disable(struct drm_encoder *encoder,
+					 struct drm_atomic_commit *state)
+{
+	struct decon *d = to_decon(encoder->dev);
+	u32 val;
+
+	cancel_delayed_work_sync(&d->check_work);
+	d->trigger_on = false;
+
+	if (soft_off) {
+		/*
+		 * Keep DECON -> DSIM -> panel running as the bootloader set it
+		 * up (the trigger stays unmasked, as on the bl_power path);
+		 * only stop reading the client's buffer.
+		 */
+		decon_mask_trigger(d, false);
+		decon_park(d);
+		decon_log_state(d, "soft off");
+		return;
+	}
+
+	decon_mask_trigger(d, true);
+	/* the frame in flight (if any) takes < 17 ms */
+	if (readl_poll_timeout(d->regs + DECON_GLOBAL_CONTROL, val,
+			       val & GLOBAL_CONTROL_IDLE_STATUS, 1000, 50000))
+		dev_warn(d->drm.dev, "DECON not idle after trigger mask (%08x)\n",
+			 val);
+	decon_log_state(d, "trigger masked");
+}
+
+static const struct drm_encoder_helper_funcs decon_encoder_helper_funcs = {
+	.atomic_enable = decon_encoder_atomic_enable,
+	.atomic_disable = decon_encoder_atomic_disable,
+};
+
+static const struct drm_crtc_helper_funcs decon_crtc_helper_funcs = {
+	.mode_valid = decon_crtc_mode_valid,
+	.atomic_check = decon_crtc_atomic_check,
+	.atomic_enable = decon_crtc_atomic_enable,
+	.atomic_disable = decon_crtc_atomic_disable,
+	.atomic_flush = decon_crtc_atomic_flush,
+};
+
+static const struct drm_crtc_funcs decon_crtc_funcs = {
+	.destroy = drm_crtc_cleanup,
+	.set_config = drm_atomic_helper_set_config,
+	.page_flip = drm_atomic_helper_page_flip,
+	.atomic_create_state = drm_atomic_helper_crtc_create_state,
+	.atomic_duplicate_state = drm_atomic_helper_crtc_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_crtc_destroy_state,
+	.enable_vblank = decon_enable_vblank,
+	.disable_vblank = decon_disable_vblank,
+};
+
+/* ------------------------------------------------------------------ */
+/* driver                                                              */
+
+static const struct drm_mode_config_funcs decon_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+/* enables before planes: the flush runs with the CRTC (vblank) on */
+static const struct drm_mode_config_helper_funcs decon_mode_config_helpers = {
+	.atomic_commit_tail = drm_atomic_helper_commit_tail_rpm,
+};
+
+/*
+ * There is no IOMMU in front of the DPU and the IDMA address is 32 bit, so
+ * the device has a 32-bit DMA mask. Importing a dma-buf whose pages lie above
+ * 4 GiB (e.g. a panfrost/shmem client buffer that phoc tries to scan out
+ * directly) is then "mapped" through swiotlb bounce buffers: the mapping
+ * looks contiguous and below 4 GiB, but the IDMA would scan a stale copy.
+ * Refuse such imports (the compositor falls back to composition), and only
+ * accept buffers that the IDMA really reads in place.
+ */
+static struct drm_gem_object *
+decon_prime_import_sg_table(struct drm_device *dev,
+			    struct dma_buf_attachment *attach,
+			    struct sg_table *sgt)
+{
+	struct scatterlist *sg;
+	unsigned int i;
+
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		dma_addr_t addr = sg_dma_address(sg);
+
+		if (!sg_page(sg) || addr != sg_phys(sg) ||
+		    addr + sg_dma_len(sg) > SZ_4G) {
+			drm_dbg_prime(dev, "refusing import: segment %u at %pad not scannable in place\n",
+				      i, &addr);
+			return ERR_PTR(-EINVAL);
+		}
+	}
+
+	return drm_gem_dma_prime_import_sg_table(dev, attach, sgt);
+}
+
+DEFINE_DRM_GEM_DMA_FOPS(decon_fops);
+
+static const struct drm_driver decon_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops = &decon_fops,
+	.dumb_create = drm_gem_dma_dumb_create,
+	.gem_prime_import_sg_table = decon_prime_import_sg_table,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+	/* "exynos" so that Mesa's kmsro pairs it with panfrost */
+	.name = "exynos",
+	.desc = "Exynos 9820 DECON (bootloader takeover)",
+	.major = 0,
+	.minor = 1,
+};
+
+#define DECON_SHADOW_OFFSET		0x7000
+
+/*
+ * Ranges with an active copy at +0x7000, as dumped by downstream
+ * decon_reg.c (__decon_dump: 0x304 global, 0x220 windows, 0x80 per DSC).
+ */
+static const struct { u32 start, end; } decon_shadow_ranges[] = {
+	{ 0x0000, 0x0304 }, { 0x1000, 0x1220 }, { 0x4000, 0x4080 },
+	{ 0x5000, 0x5080 },
+};
+
+/* control, trigger, IRQ and status registers: differ by nature, never synced */
+static bool decon_shadow_volatile(u32 off)
+{
+	return off < 0x0080 || (off >= 0x02a0 && off < 0x0304);
+}
+
+static void decon_check_shadow(struct decon *d)
+{
+	struct device *dev = d->drm.dev;
+	unsigned int i, n = 0;
+	u32 off, prog, act;
+
+	for (i = 0; i < ARRAY_SIZE(decon_shadow_ranges); i++) {
+		for (off = decon_shadow_ranges[i].start;
+		     off < decon_shadow_ranges[i].end; off += 4) {
+			if (decon_shadow_volatile(off))
+				continue;
+			prog = decon_read(d, off);
+			act = decon_read(d, DECON_SHADOW_OFFSET + off);
+			if (prog == act)
+				continue;
+			if (n++ < 64)
+				dev_info(dev, "register 0x%04x: programmed %08x, +0x7000 readback %08x\n",
+					 off, prog, act);
+		}
+	}
+	dev_info(dev, "%u programmed/readback differences outside the control block\n",
+		 n);
+}
+
+static int decon_inspect_hw(struct decon *d)
+{
+	struct device *dev = d->drm.dev;
+	u32 gc, path0, path1, bg, con, img, src, addr;
+	phys_addr_t base = DPP_GF0_BASE;
+	struct resource *r;
+	unsigned int w;
+
+	gc = decon_read(d, DECON_GLOBAL_CONTROL);
+	if (!(gc & GLOBAL_CONTROL_DECON_EN_F) ||
+	    !(gc & GLOBAL_CONTROL_RUN_STATUS) ||
+	    !(gc & GLOBAL_CONTROL_OPERATION_MODE_CMD)) {
+		/* Cold init (decon_reg_init + DSIM/D-PHY) is not implemented */
+		dev_err(dev, "DECON0 not running in command mode (GLOBAL_CONTROL %08x)\n",
+			gc);
+		return -ENODEV;
+	}
+
+	path0 = decon_read(d, DECON_DATA_PATH_CONTROL_0);
+	path1 = decon_read(d, DECON_DATA_PATH_CONTROL_1);
+	for (w = 0; w < DECON_MAX_WIN; w++)
+		if (path0 & WIN_EN_F(w))
+			break;
+	if (w == DECON_MAX_WIN) {
+		dev_err(dev, "no DECON window enabled (DATA_PATH_CONTROL_0 %08x)\n",
+			path0);
+		return -ENODEV;
+	}
+	if (path0 & ~(WIN_EN_F(w) | (WIN_EN_F(w) << 1)) & 0x00ffffff)
+		dev_warn(dev, "more than one window enabled (%08x), only win%u is managed\n",
+			 path0, w);
+
+	d->win = w;
+	d->ch = (path1 & WIN_CHMAP(w)) >> (4 * w);
+	if (d->ch >= ARRAY_SIZE(decon_dma_offset)) {
+		dev_err(dev, "win%u mapped to invalid channel %u\n", w, d->ch);
+		return -ENODEV;
+	}
+	d->idma = d->dma_base + decon_dma_offset[d->ch];
+
+	r = platform_get_resource_byname(to_platform_device(dev),
+					 IORESOURCE_MEM, "dpp");
+	/* a DT "dpp" range starts at the GF0 block, like "dma" */
+	if (r && resource_size(r) >= decon_dpp_offset[d->ch] + DPP_SIZE)
+		base = r->start;
+	d->dpp = devm_ioremap(dev, base + decon_dpp_offset[d->ch], DPP_SIZE);
+	if (!d->dpp)
+		dev_warn(dev, "cannot map the DPP of channel %u\n", d->ch);
+
+	bg = decon_read(d, DECON_BLENDER_BG_IMAGE_SIZE_0);
+	d->width = FIELD_GET(BLENDER_BG_WIDTH, bg);
+	d->height = FIELD_GET(BLENDER_BG_HEIGHT, bg);
+
+	con = readl(d->idma + IDMA_IN_CON);
+	img = readl(d->idma + IDMA_IMG_SIZE);
+	src = readl(d->idma + IDMA_SRC_SIZE);
+	addr = readl(d->idma + IDMA_IN_BASE_ADDR_Y);
+
+	d->boot_fb = addr;
+	d->boot_con = con;
+	d->boot_out = readl(d->idma + IDMA_OUT_CON);
+	d->boot_dpp_con = d->dpp ? readl(d->dpp + DPP_IN_CON) : 0;
+	d->boot_win0 = decon_read(d, DECON_WIN_CONTROL_0(d->win));
+	d->boot_src = src;
+	d->boot_ofs = readl(d->idma + IDMA_SRC_OFFSET);
+	d->boot_img = img;
+	/* SRC_SIZE describes the whole buffer (stride in pixels x lines) */
+	d->boot_fb_size = (size_t)FIELD_GET(IDMA_SRC_WIDTH, src) *
+			  FIELD_GET(IDMA_SRC_HEIGHT, src) * 4;
+
+	dev_info(dev,
+		 "inherited: %ux%u, win%u <- ch%u, IN_CON %08x SRC %ux%u IMG %ux%u base %08x (shadow %08x), TRIG %08x TE_CNT %08x\n",
+		 d->width, d->height, d->win, d->ch, con,
+		 (u32)FIELD_GET(IDMA_SRC_WIDTH, src),
+		 (u32)FIELD_GET(IDMA_SRC_HEIGHT, src),
+		 (u32)FIELD_GET(IDMA_IMG_WIDTH, img),
+		 (u32)FIELD_GET(IDMA_IMG_HEIGHT, img), addr,
+		 readl(d->idma + IDMA_SHADOW_OFFSET + IDMA_IN_BASE_ADDR_Y),
+		 decon_read(d, DECON_HW_SW_TRIG_CONTROL),
+		 decon_read(d, DECON_HW_TE_CNT));
+
+	if (!d->width || !d->height || (con & (IDMA_AFBC_EN | IDMA_BLOCK_EN))) {
+		dev_err(dev, "unexpected inherited configuration\n");
+		return -ENODEV;
+	}
+
+	if (!(decon_read(d, DECON_HW_SW_TRIG_CONTROL) & HW_TRIG_EN) ||
+	    (decon_read(d, DECON_HW_SW_TRIG_CONTROL) & HW_TRIG_MASK_DECON))
+		dev_warn(dev, "TE trigger not running (TRIG %08x)\n",
+			 decon_read(d, DECON_HW_SW_TRIG_CONTROL));
+	/* DRM state starts "off"; the first enable unmasks (no-op today) */
+	d->trigger_on = false;
+	decon_check_shadow(d);
+	decon_log_alpha(d, "inherited alpha");
+	return 0;
+}
+
+static int decon_setup_irq(struct decon *d, struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	u32 en, frame;
+	int ret;
+
+	d->irq = platform_get_irq_byname(pdev, "frame_start");
+	if (d->irq < 0)
+		return d->irq;
+	d->irq_done = platform_get_irq_byname_optional(pdev, "frame_done");
+	d->irq_extra = platform_get_irq_byname_optional(pdev, "extra");
+
+	/* As downstream decon_reg_set_int(): clear, then enable */
+	decon_write(d, DECON_INTERRUPT_PENDING, DPU_FRAME_START_INT_PEND |
+		    DPU_FRAME_DONE_INT_PEND | DPU_EXTRA_INT_PEND);
+	decon_write(d, DECON_EXTRA_INTERRUPT_PENDING,
+		    DPU_RESOURCE_CONFLICT_INT_PEND | DPU_TIME_OUT_INT_PEND);
+	en = DPU_FRAME_START_INT_EN | DPU_INT_EN;
+	if (d->irq_done > 0)
+		en |= DPU_FRAME_DONE_INT_EN;
+	if (d->irq_extra > 0) {
+		en |= DPU_EXTRA_INT_EN;
+		decon_write_mask(d, DECON_EXTRA_INTERRUPT_ENABLE,
+				 DPU_RESOURCE_CONFLICT_INT_EN | DPU_TIME_OUT_INT_EN,
+				 DPU_RESOURCE_CONFLICT_INT_EN | DPU_TIME_OUT_INT_EN);
+	}
+	decon_write_mask(d, DECON_INTERRUPT_ENABLE, en,
+			 DPU_FRAME_START_INT_EN | DPU_FRAME_DONE_INT_EN |
+			 DPU_EXTRA_INT_EN | DPU_INT_EN);
+
+	ret = devm_request_irq(dev, d->irq, decon_irq, 0, "decon0-frame-start", d);
+	if (ret)
+		return ret;
+	if (d->irq_done > 0) {
+		ret = devm_request_irq(dev, d->irq_done, decon_irq, 0,
+				       "decon0-frame-done", d);
+		if (ret) {
+			dev_warn(dev, "frame_done irq: %d\n", ret);
+			decon_write_mask(d, DECON_INTERRUPT_ENABLE, 0,
+					 DPU_FRAME_DONE_INT_EN);
+		}
+	}
+	if (d->irq_extra > 0) {
+		ret = devm_request_irq(dev, d->irq_extra, decon_irq, 0,
+				       "decon0-extra", d);
+		if (ret) {
+			dev_warn(dev, "extra irq: %d\n", ret);
+			decon_write_mask(d, DECON_INTERRUPT_ENABLE, 0,
+					 DPU_EXTRA_INT_EN);
+		}
+	}
+
+	hrtimer_setup(&d->timer, decon_poll_timer, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL);
+
+	/*
+	 * Frames run at 60 Hz (TE): within 50 ms FRAME_COUNT must move
+	 * and, if the GIC line works, the handler must have run.
+	 */
+	frame = decon_read(d, DECON_FRAME_COUNT);
+	msleep(50);
+	if (decon_read(d, DECON_FRAME_COUNT) == frame)
+		dev_warn(dev, "FRAME_COUNT not moving: no TE-triggered frames?\n");
+	else if (!atomic_read(&d->irq_count)) {
+		dev_warn(dev, "FRAME_START irq not delivered, polling FRAME_COUNT\n");
+		d->poll = true;
+	}
+
+	if (d->poll) {
+		d->last_frame = decon_read(d, DECON_FRAME_COUNT);
+		hrtimer_start(&d->timer, us_to_ktime(4000), HRTIMER_MODE_REL);
+	}
+	dev_info(dev, "vblank from %s (%d irqs in the first 50 ms)\n",
+		 d->poll ? "FRAME_COUNT polling" : "FRAME_START irq",
+		 atomic_read(&d->irq_count));
+	return 0;
+}
+
+static int decon_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_bulk_data *clks;
+	struct drm_device *drm;
+	struct decon *d;
+	int nclks, ret;
+
+	if (!enable) {
+		dev_info(dev, "takeover disabled (exynos9820_decon.enable=0), simpledrm stays\n");
+		return -ENODEV;
+	}
+
+	d = devm_drm_dev_alloc(dev, &decon_driver, struct decon, drm);
+	if (IS_ERR(d))
+		return PTR_ERR(d);
+	drm = &d->drm;
+	platform_set_drvdata(pdev, d);
+
+	d->regs = devm_platform_ioremap_resource_byname(pdev, "decon");
+	if (IS_ERR(d->regs))
+		return PTR_ERR(d->regs);
+	d->dma_base = devm_platform_ioremap_resource_byname(pdev, "dma");
+	if (IS_ERR(d->dma_base))
+		return PTR_ERR(d->dma_base);
+
+	/* Panel first: it defers until the DSIM host + panel driver are up. */
+	d->bridge = devm_drm_of_get_bridge(dev, dev->of_node, 0, 0);
+	if (IS_ERR(d->bridge))
+		return dev_err_probe(dev, PTR_ERR(d->bridge),
+				     "failed to find panel\n");
+
+	/* The bootloader left the DPU clocks running, registers are readable */
+	ret = decon_inspect_hw(d);
+	if (ret)
+		return ret;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	/*
+	 * Take a reference on the DPU clocks so nothing gates them under the
+	 * running pipeline. Deliberately never dropped (also not on probe
+	 * failure or unbind): if the refcount fell to zero the clock core
+	 * would gate DECON/DMA and kill scanout for good.
+	 */
+	nclks = devm_clk_bulk_get_all(dev, &clks);
+	if (nclks < 0)
+		return dev_err_probe(dev, nclks, "failed to get clocks\n");
+	ret = clk_bulk_prepare_enable(nclks, clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable clocks\n");
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.min_width = d->width;
+	drm->mode_config.min_height = d->height;
+	drm->mode_config.max_width = 4096;
+	drm->mode_config.max_height = 4096;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &decon_mode_config_funcs;
+	drm->mode_config.helper_private = &decon_mode_config_helpers;
+
+	ret = drm_universal_plane_init(drm, &d->plane, 1, &decon_plane_funcs,
+				       decon_plane_formats,
+				       ARRAY_SIZE(decon_plane_formats), NULL,
+				       DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&d->plane, &decon_plane_helper_funcs);
+
+	ret = drm_crtc_init_with_planes(drm, &d->crtc, &d->plane, NULL,
+					&decon_crtc_funcs, "decon0");
+	if (ret)
+		return ret;
+	drm_crtc_helper_add(&d->crtc, &decon_crtc_helper_funcs);
+
+	d->encoder = drmm_plain_encoder_alloc(drm, NULL, DRM_MODE_ENCODER_DSI,
+					      NULL);
+	if (IS_ERR(d->encoder))
+		return PTR_ERR(d->encoder);
+	d->encoder->possible_crtcs = drm_crtc_mask(&d->crtc);
+	drm_encoder_helper_add(d->encoder, &decon_encoder_helper_funcs);
+
+	ret = drm_bridge_attach(d->encoder, d->bridge, NULL,
+				DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+	if (ret)
+		return ret;
+
+	d->connector = drm_bridge_connector_init(drm, d->encoder);
+	if (IS_ERR(d->connector))
+		return PTR_ERR(d->connector);
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	ret = decon_setup_irq(d, pdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "irq setup failed\n");
+
+	/* From here on, we own the scanout: kick simpledrm/simplefb out. */
+	ret = aperture_remove_conflicting_devices(d->boot_fb, d->boot_fb_size,
+						  decon_driver.name);
+	if (ret)
+		dev_warn(dev, "failed to remove boot framebuffer: %d\n", ret);
+
+	INIT_DELAYED_WORK(&d->check_work, decon_check_frames);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		goto err_timer;
+
+	drm_kms_helper_poll_init(drm);
+
+	if (fbdev)
+		drm_client_setup(drm, NULL);
+
+	/*
+	 * No fbdev (the default): nothing tells the PM core that a VT switch is
+	 * not needed, and with an empty pm_vt_switch list it always switches to
+	 * the suspend console. logind then pauses the compositor's session on
+	 * every resume (DRM fd paused/resumed, outputs and input devices torn
+	 * down and re-created), which makes phosh/phrog exit after each wake.
+	 * The atomic state is restored by drm_mode_config_helper_resume().
+	 */
+	pm_vt_switch_required(dev, false);
+
+	return 0;
+
+err_timer:
+	hrtimer_cancel(&d->timer);
+	return ret;
+}
+
+static void decon_remove(struct platform_device *pdev)
+{
+	struct decon *d = platform_get_drvdata(pdev);
+
+	pm_vt_switch_unregister(&pdev->dev);
+	drm_dev_unregister(&d->drm);
+	drm_kms_helper_poll_fini(&d->drm);
+	drm_atomic_helper_shutdown(&d->drm);
+	cancel_delayed_work_sync(&d->check_work);
+	hrtimer_cancel(&d->timer);
+	decon_write_mask(d, DECON_INTERRUPT_ENABLE, 0,
+			 DPU_FRAME_START_INT_EN | DPU_FRAME_DONE_INT_EN |
+			 DPU_EXTRA_INT_EN);
+}
+
+static void decon_shutdown(struct platform_device *pdev)
+{
+	struct decon *d = platform_get_drvdata(pdev);
+
+	drm_atomic_helper_shutdown(&d->drm);
+}
+
+static int decon_suspend(struct device *dev)
+{
+	struct decon *d = dev_get_drvdata(dev);
+
+	return drm_mode_config_helper_suspend(&d->drm);
+}
+
+static int decon_resume(struct device *dev)
+{
+	struct decon *d = dev_get_drvdata(dev);
+
+	return drm_mode_config_helper_resume(&d->drm);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(decon_pm_ops, decon_suspend, decon_resume);
+
+static const struct of_device_id decon_of_match[] = {
+	{ .compatible = "samsung,exynos9820-decon" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, decon_of_match);
+
+static struct platform_driver decon_platform_driver = {
+	.probe = decon_probe,
+	.remove = decon_remove,
+	.shutdown = decon_shutdown,
+	.driver = {
+		.name = "exynos9820-decon",
+		.of_match_table = decon_of_match,
+		.pm = pm_sleep_ptr(&decon_pm_ops),
+	},
+};
+module_platform_driver(decon_platform_driver);
+
+MODULE_DESCRIPTION("Exynos 9820 DECON0 KMS driver (bootloader pipeline takeover)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/exynos/exynos9820_dsim_cmd.c b/drivers/gpu/drm/exynos/exynos9820_dsim_cmd.c
new file mode 100644
index 0000000000..0d655e093f
--- /dev/null
+++ b/drivers/gpu/drm/exynos/exynos9820_dsim_cmd.c
@@ -0,0 +1,491 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 9820 MIPI DSI master (DSIM) - command-only "handover" host.
+ *
+ * On Exynos 9820 phones the bootloader (S-Boot) fully initialises the display
+ * pipeline (DECON0 -> DSC -> DSIM0 -> D-PHY -> panel, MIPI command mode, DECON
+ * triggered by the panel TE signal) and leaves a framebuffer behind which
+ * Linux scans out via simple-framebuffer / simpledrm.
+ *
+ * There is no mainline DECON/DPP driver for this SoC yet. This driver does
+ * NOT touch the link configuration, the D-PHY, DECON or the video path at
+ * all: it only exposes the DSIM packet header/payload FIFOs as a
+ * struct mipi_dsi_host, so that a regular DRM panel driver can send DCS
+ * commands (brightness, display on/off, sleep in/out) and read back panel
+ * registers over the already-running link.
+ *
+ * Register layout taken from Samsung's downstream driver
+ * (drivers/video/fbdev/exynos/dpu20/cal_9820/regs-dsim.h, dsim_reg.c and
+ * dsim_drv.c from the SM-G97x kernel sources).
+ *
+ * The driver deliberately never gates the DSIM clocks or resets the block:
+ * doing so would kill the boot framebuffer which it does not own.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+
+#define DSIM_VERSION			0x00
+#define DSIM_SWRST			0x04
+#define DSIM_SWRST_FUNCRST		BIT(8)
+#define DSIM_SWRST_RESET		BIT(0)
+#define DSIM_LINK_STATUS0		0x08
+#define DSIM_LINK_STATUS1		0x0c
+#define DSIM_LINK_STATUS3		0x14
+#define DSIM_LINK_STATUS3_PLL_STABLE	BIT(0)
+#define DSIM_MIPI_STATUS		0x18
+#define DSIM_DPHY_STATUS		0x1c
+#define DSIM_CLK_CTRL			0x20
+#define DSIM_ESCMODE			0x2c
+#define DSIM_ESCMODE_CMD_LPDT		BIT(7)
+#define DSIM_RESOL			0x3c
+#define DSIM_CONFIG			0x4c
+#define DSIM_CONFIG_VIDEO_MODE		BIT(18)
+#define DSIM_CONFIG_NUM_OF_DATA_LANE	GENMASK(6, 5)
+#define DSIM_CONFIG_LANES_EN		GENMASK(4, 0)
+#define DSIM_INTSRC			0x50
+#define DSIM_INTSRC_SFR_PH_FIFO_EMPTY	BIT(28)
+#define DSIM_INTSRC_SFR_PH_FIFO_OVERFLOW BIT(27)
+#define DSIM_INTSRC_RX_DATA_DONE	BIT(18)
+#define DSIM_INTSRC_ERR_RX_ECC		BIT(15)
+#define DSIM_INTSRC_RX_CRC		BIT(14)
+#define DSIM_INTMSK			0x54
+#define DSIM_PKTHDR			0x58
+#define DSIM_PKTHDR_BTA_TYPE		BIT(24)
+#define DSIM_PKTHDR_DATA1		GENMASK(23, 16)
+#define DSIM_PKTHDR_DATA0		GENMASK(15, 8)
+#define DSIM_PKTHDR_ID			GENMASK(7, 0)
+#define DSIM_PAYLOAD			0x5c
+#define DSIM_RXFIFO			0x60
+#define DSIM_FIFOCTRL			0x68
+#define DSIM_FIFOCTRL_NUMBER_OF_PH_SFR	GENMASK(21, 16)
+#define DSIM_FIFOCTRL_EMPTY_RX		BIT(12)
+#define DSIM_FIFOCTRL_FULL_PH_SFR	BIT(11)
+#define DSIM_FIFOCTRL_EMPTY_PH_SFR	BIT(10)
+#define DSIM_FIFOCTRL_FULL_PL_SFR	BIT(9)
+#define DSIM_FIFOCTRL_EMPTY_PL_SFR	BIT(8)
+#define DSIM_CMD_CONFIG			0x80
+#define DSIM_CMD_CONFIG_PKT_GO_RDY	BIT(17)
+#define DSIM_CMD_CONFIG_PKT_GO_EN	BIT(16)
+#define DSIM_CMD_CONFIG_MULTI_CMD_PKT_EN BIT(8)
+#define DSIM_CMD_STATUS			0x8c
+
+/* Downstream uses 50 ms write / 100 ms read timeouts; be a bit more lenient. */
+#define DSIM_WR_TIMEOUT_US		100000
+#define DSIM_RD_TIMEOUT_US		200000
+#define DSIM_RX_FIFO_MAX_DEPTH		64
+/* Downstream splits long writes at 512 bytes (SFR payload FIFO size). */
+#define DSIM_MAX_PAYLOAD		512
+
+struct exynos9820_dsim {
+	struct device *dev;
+	void __iomem *regs;
+	struct mipi_dsi_host host;
+	struct mutex lock;	/* serialises FIFO access */
+	unsigned int lanes;
+	bool cmd_mode;
+};
+
+static inline struct exynos9820_dsim *host_to_dsim(struct mipi_dsi_host *h)
+{
+	return container_of(h, struct exynos9820_dsim, host);
+}
+
+static inline u32 dsim_read(struct exynos9820_dsim *dsim, u32 reg)
+{
+	return readl(dsim->regs + reg);
+}
+
+static inline void dsim_write(struct exynos9820_dsim *dsim, u32 reg, u32 val)
+{
+	writel(val, dsim->regs + reg);
+}
+
+static void dsim_dump(struct exynos9820_dsim *dsim, const char *why)
+{
+	dev_err(dsim->dev,
+		"%s: SWRST=%08x LS0=%08x LS1=%08x LS3=%08x MIPI=%08x DPHY=%08x CONFIG=%08x INTSRC=%08x FIFOCTRL=%08x CMDCFG=%08x CMDST=%08x\n",
+		why,
+		dsim_read(dsim, DSIM_SWRST), dsim_read(dsim, DSIM_LINK_STATUS0),
+		dsim_read(dsim, DSIM_LINK_STATUS1),
+		dsim_read(dsim, DSIM_LINK_STATUS3),
+		dsim_read(dsim, DSIM_MIPI_STATUS),
+		dsim_read(dsim, DSIM_DPHY_STATUS),
+		dsim_read(dsim, DSIM_CONFIG), dsim_read(dsim, DSIM_INTSRC),
+		dsim_read(dsim, DSIM_FIFOCTRL),
+		dsim_read(dsim, DSIM_CMD_CONFIG),
+		dsim_read(dsim, DSIM_CMD_STATUS));
+}
+
+static int dsim_wait_fifoctrl(struct exynos9820_dsim *dsim, u32 mask,
+			      bool set, u32 timeout_us)
+{
+	u32 val;
+
+	if (set)
+		return readl_poll_timeout(dsim->regs + DSIM_FIFOCTRL, val,
+					  val & mask, 10, timeout_us);
+	return readl_poll_timeout(dsim->regs + DSIM_FIFOCTRL, val,
+				  !(val & mask), 10, timeout_us);
+}
+
+static int dsim_write_payload(struct exynos9820_dsim *dsim, const u8 *buf,
+			      size_t len)
+{
+	size_t i;
+	int ret;
+
+	for (i = 0; i < len; i += 4) {
+		u32 word = 0;
+		size_t j;
+
+		for (j = 0; j < 4 && i + j < len; j++)
+			word |= (u32)buf[i + j] << (8 * j);
+
+		ret = dsim_wait_fifoctrl(dsim, DSIM_FIFOCTRL_FULL_PL_SFR,
+					 false, DSIM_WR_TIMEOUT_US);
+		if (ret)
+			return ret;
+
+		dsim_write(dsim, DSIM_PAYLOAD, word);
+	}
+
+	return 0;
+}
+
+static int dsim_send_packet(struct exynos9820_dsim *dsim,
+			    const struct mipi_dsi_packet *pkt, bool bta)
+{
+	u32 hdr;
+	int ret;
+
+	if (pkt->payload_length > DSIM_MAX_PAYLOAD)
+		return -EMSGSIZE;
+
+	if (pkt->payload_length) {
+		ret = dsim_write_payload(dsim, pkt->payload,
+					 pkt->payload_length);
+		if (ret) {
+			dsim_dump(dsim, "payload FIFO stuck");
+			return ret;
+		}
+	}
+
+	ret = dsim_wait_fifoctrl(dsim, DSIM_FIFOCTRL_FULL_PH_SFR, false,
+				 DSIM_WR_TIMEOUT_US);
+	if (ret) {
+		dsim_dump(dsim, "header FIFO full");
+		return ret;
+	}
+
+	dsim_write(dsim, DSIM_INTSRC, DSIM_INTSRC_SFR_PH_FIFO_EMPTY);
+
+	hdr = FIELD_PREP(DSIM_PKTHDR_ID, pkt->header[0]) |
+	      FIELD_PREP(DSIM_PKTHDR_DATA0, pkt->header[1]) |
+	      FIELD_PREP(DSIM_PKTHDR_DATA1, pkt->header[2]);
+	if (bta)
+		hdr |= DSIM_PKTHDR_BTA_TYPE;
+	dsim_write(dsim, DSIM_PKTHDR, hdr);
+
+	/*
+	 * In command mode the DSIM only inserts SFR packets into the gaps
+	 * between frames, so this can take up to one frame (~16.7 ms @60Hz).
+	 */
+	ret = dsim_wait_fifoctrl(dsim, DSIM_FIFOCTRL_EMPTY_PH_SFR, true,
+				 DSIM_WR_TIMEOUT_US);
+	if (ret)
+		dsim_dump(dsim, "packet not sent");
+
+	return ret;
+}
+
+static void dsim_drain_rx(struct exynos9820_dsim *dsim)
+{
+	int n = DSIM_RX_FIFO_MAX_DEPTH;
+
+	while (!(dsim_read(dsim, DSIM_FIFOCTRL) & DSIM_FIFOCTRL_EMPTY_RX) &&
+	       --n)
+		dsim_read(dsim, DSIM_RXFIFO);
+}
+
+static ssize_t dsim_parse_rx(struct exynos9820_dsim *dsim,
+			     const struct mipi_dsi_msg *msg)
+{
+	u8 *rx = msg->rx_buf;
+	ssize_t got = -EIO;
+	int depth = DSIM_RX_FIFO_MAX_DEPTH;
+	u32 val, len, i, j;
+
+	do {
+		val = dsim_read(dsim, DSIM_RXFIFO);
+
+		switch (val & 0xff) {
+		case MIPI_DSI_RX_ACKNOWLEDGE_AND_ERROR_REPORT:
+			if ((val >> 8) & 0xffff) {
+				dev_err(dsim->dev,
+					"peripheral error report 0x%04x\n",
+					(val >> 8) & 0xffff);
+				return -EIO;
+			}
+			break;
+		case MIPI_DSI_RX_END_OF_TRANSMISSION:
+			break;
+		case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_1BYTE:
+		case MIPI_DSI_RX_GENERIC_SHORT_READ_RESPONSE_1BYTE:
+			if (msg->rx_len >= 1)
+				rx[0] = (val >> 8) & 0xff;
+			got = 1;
+			break;
+		case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_2BYTE:
+		case MIPI_DSI_RX_GENERIC_SHORT_READ_RESPONSE_2BYTE:
+			for (i = 0; i < 2 && i < msg->rx_len; i++)
+				rx[i] = (val >> (8 + 8 * i)) & 0xff;
+			got = min_t(size_t, 2, msg->rx_len);
+			break;
+		case MIPI_DSI_RX_DCS_LONG_READ_RESPONSE:
+		case MIPI_DSI_RX_GENERIC_LONG_READ_RESPONSE:
+			len = (val >> 8) & 0xffff;
+			for (i = 0; i < len; i += 4) {
+				val = dsim_read(dsim, DSIM_RXFIFO);
+				for (j = 0; j < 4 && i + j < len; j++)
+					if (i + j < msg->rx_len)
+						rx[i + j] = (val >> (8 * j)) & 0xff;
+			}
+			got = min_t(size_t, len, msg->rx_len);
+			break;
+		default:
+			dev_err(dsim->dev, "unexpected RX packet 0x%08x\n", val);
+			dsim_drain_rx(dsim);
+			return -EIO;
+		}
+	} while (!(dsim_read(dsim, DSIM_FIFOCTRL) & DSIM_FIFOCTRL_EMPTY_RX) &&
+		 --depth);
+
+	return got;
+}
+
+static ssize_t dsim_transfer_locked(struct exynos9820_dsim *dsim,
+				    const struct mipi_dsi_msg *msg)
+{
+	struct mipi_dsi_packet pkt;
+	bool is_read = msg->rx_len && msg->rx_buf;
+	u32 val;
+	int ret;
+
+	ret = mipi_dsi_create_packet(&pkt, msg);
+	if (ret)
+		return ret;
+
+	if (!is_read) {
+		ret = dsim_send_packet(dsim, &pkt, false);
+		return ret ? ret : pkt.payload_length;
+	}
+
+	dsim_drain_rx(dsim);
+	dsim_write(dsim, DSIM_INTSRC, DSIM_INTSRC_RX_DATA_DONE |
+		   DSIM_INTSRC_ERR_RX_ECC | DSIM_INTSRC_RX_CRC);
+
+	/* Tell the peripheral how much it may return (as downstream does). */
+	{
+		struct mipi_dsi_packet mrps = {
+			.size = 4,
+			.header = {
+				MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE |
+					(msg->channel << 6),
+				msg->rx_len & 0xff,
+				(msg->rx_len >> 8) & 0xff,
+			},
+		};
+
+		ret = dsim_send_packet(dsim, &mrps, false);
+		if (ret)
+			return ret;
+	}
+
+	ret = dsim_send_packet(dsim, &pkt, true);
+	if (ret)
+		return ret;
+
+	ret = readl_poll_timeout(dsim->regs + DSIM_INTSRC, val,
+				 val & DSIM_INTSRC_RX_DATA_DONE, 10,
+				 DSIM_RD_TIMEOUT_US);
+	if (ret) {
+		/* INTSRC may not latch with the IRQ masked; fall back to FIFO */
+		if (dsim_read(dsim, DSIM_FIFOCTRL) & DSIM_FIFOCTRL_EMPTY_RX) {
+			dsim_dump(dsim, "read timeout");
+			return -ETIMEDOUT;
+		}
+		dev_dbg(dsim->dev, "RX_DATA_DONE not latched, RX FIFO not empty\n");
+	}
+	dsim_write(dsim, DSIM_INTSRC, DSIM_INTSRC_RX_DATA_DONE);
+
+	if (val & (DSIM_INTSRC_ERR_RX_ECC | DSIM_INTSRC_RX_CRC))
+		dev_warn(dsim->dev, "RX ECC/CRC error (INTSRC=%08x)\n", val);
+
+	return dsim_parse_rx(dsim, msg);
+}
+
+static ssize_t exynos9820_dsim_transfer(struct mipi_dsi_host *host,
+					const struct mipi_dsi_msg *msg)
+{
+	struct exynos9820_dsim *dsim = host_to_dsim(host);
+	ssize_t ret;
+
+	mutex_lock(&dsim->lock);
+	ret = dsim_transfer_locked(dsim, msg);
+	mutex_unlock(&dsim->lock);
+
+	return ret;
+}
+
+static int exynos9820_dsim_attach(struct mipi_dsi_host *host,
+				  struct mipi_dsi_device *dev)
+{
+	struct exynos9820_dsim *dsim = host_to_dsim(host);
+
+	if (dev->lanes && dev->lanes != dsim->lanes)
+		dev_warn(dsim->dev,
+			 "panel wants %u lanes, bootloader configured %u (link left untouched)\n",
+			 dev->lanes, dsim->lanes);
+
+	if (!(dev->mode_flags & MIPI_DSI_MODE_VIDEO) != dsim->cmd_mode)
+		dev_warn(dsim->dev,
+			 "panel wants %s mode, link is in %s mode (left untouched)\n",
+			 (dev->mode_flags & MIPI_DSI_MODE_VIDEO) ? "video" : "command",
+			 dsim->cmd_mode ? "command" : "video");
+
+	dev_info(dsim->dev, "attached %s\n", dev_name(&dev->dev));
+
+	return 0;
+}
+
+static int exynos9820_dsim_detach(struct mipi_dsi_host *host,
+				  struct mipi_dsi_device *dev)
+{
+	return 0;
+}
+
+static const struct mipi_dsi_host_ops exynos9820_dsim_host_ops = {
+	.attach = exynos9820_dsim_attach,
+	.detach = exynos9820_dsim_detach,
+	.transfer = exynos9820_dsim_transfer,
+};
+
+static int exynos9820_dsim_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos9820_dsim *dsim;
+	struct clk_bulk_data *clks;
+	u32 cfg, swrst, ls3, resol, cmdcfg;
+	int nclks, ret;
+
+	dsim = devm_kzalloc(dev, sizeof(*dsim), GFP_KERNEL);
+	if (!dsim)
+		return -ENOMEM;
+
+	dsim->dev = dev;
+	mutex_init(&dsim->lock);
+
+	dsim->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dsim->regs))
+		return PTR_ERR(dsim->regs);
+
+	/*
+	 * Take a reference on the APB clock(s) so that nothing gates them
+	 * underneath us. Intentionally never released: the boot framebuffer
+	 * depends on this block staying clocked.
+	 */
+	nclks = devm_clk_bulk_get_all(dev, &clks);
+	if (nclks < 0)
+		return dev_err_probe(dev, nclks, "failed to get clocks\n");
+	ret = clk_bulk_prepare_enable(nclks, clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable clocks\n");
+
+	swrst = dsim_read(dsim, DSIM_SWRST);
+	ls3 = dsim_read(dsim, DSIM_LINK_STATUS3);
+	cfg = dsim_read(dsim, DSIM_CONFIG);
+	resol = dsim_read(dsim, DSIM_RESOL);
+	cmdcfg = dsim_read(dsim, DSIM_CMD_CONFIG);
+
+	dev_info(dev,
+		 "version %08x, SWRST %08x, PLL %s, CONFIG %08x, RESOL %ux%u, CLK_CTRL %08x, ESCMODE %08x, CMD_CONFIG %08x\n",
+		 dsim_read(dsim, DSIM_VERSION), swrst,
+		 (ls3 & DSIM_LINK_STATUS3_PLL_STABLE) ? "stable" : "NOT stable",
+		 cfg, resol & 0x1fff, (resol >> 16) & 0x1fff,
+		 dsim_read(dsim, DSIM_CLK_CTRL), dsim_read(dsim, DSIM_ESCMODE),
+		 cmdcfg);
+
+	/*
+	 * On beyond2lte (S-Boot G975FXXSGHWC1) LINK_STATUS3 reads 0 while the
+	 * link is demonstrably live (DECON TE counter advancing at 60 Hz), so
+	 * the PLL bit is informational only.
+	 */
+	if (!(ls3 & DSIM_LINK_STATUS3_PLL_STABLE))
+		dev_warn(dev, "LINK_STATUS3 PLL bit clear; assuming link is up\n");
+
+	if ((swrst & (DSIM_SWRST_RESET | DSIM_SWRST_FUNCRST)) ||
+	    !(cfg & DSIM_CONFIG_LANES_EN)) {
+		/* Link bring-up (PLL, D-PHY, timings) is not implemented. */
+		dev_err(dev, "DSI link not initialised by the bootloader\n");
+		return -ENODEV;
+	}
+
+	dsim->lanes = FIELD_GET(DSIM_CONFIG_NUM_OF_DATA_LANE, cfg) + 1;
+	dsim->cmd_mode = !(cfg & DSIM_CONFIG_VIDEO_MODE);
+
+	if (cmdcfg & DSIM_CMD_CONFIG_PKT_GO_EN)
+		dev_warn(dev, "packet-go is enabled; SFR packets may be held back\n");
+
+	dsim->host.dev = dev;
+	dsim->host.ops = &exynos9820_dsim_host_ops;
+	platform_set_drvdata(pdev, dsim);
+
+	ret = mipi_dsi_host_register(&dsim->host);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register DSI host\n");
+
+	dev_info(dev, "%u-lane %s-mode link inherited from bootloader\n",
+		 dsim->lanes, dsim->cmd_mode ? "command" : "video");
+
+	return 0;
+}
+
+static void exynos9820_dsim_remove(struct platform_device *pdev)
+{
+	struct exynos9820_dsim *dsim = platform_get_drvdata(pdev);
+
+	mipi_dsi_host_unregister(&dsim->host);
+}
+
+static const struct of_device_id exynos9820_dsim_of_match[] = {
+	{ .compatible = "samsung,exynos9820-dsim" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, exynos9820_dsim_of_match);
+
+static struct platform_driver exynos9820_dsim_driver = {
+	.probe = exynos9820_dsim_probe,
+	.remove = exynos9820_dsim_remove,
+	.driver = {
+		.name = "exynos9820-dsim-cmd",
+		.of_match_table = exynos9820_dsim_of_match,
+		/* Unbinding would leave the panel without a host; disallow. */
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(exynos9820_dsim_driver);
+
+MODULE_DESCRIPTION("Exynos 9820 DSIM command-only host for bootloader-initialised links");
+MODULE_LICENSE("GPL");
