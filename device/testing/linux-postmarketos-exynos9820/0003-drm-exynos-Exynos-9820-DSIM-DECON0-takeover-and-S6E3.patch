+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,s6e3ha9.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S6E3HA9 AMOLED DSI panel
+
+description: The S6E3HA9 is a DSC command mode DDIC used with the 1440x3040
+  AMOLED panel of the Samsung Galaxy S10+ (and 1440x3040/2960 S10 panels).
+
+maintainers:
+  - StachowiakDawid <dawidos234@gmail.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,s6e3ha9
+
+  reg:
+    maxItems: 1
+
+  vdd3-supply:
+    description: VDD3 1.8V logic supply
+
+  vci-supply:
+    description: VCI 3.0V analog supply
+
+  vddr-supply:
+    description: VDDR 1.6V supply
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,s6e3ha9";
+            reg = <0>;
+            reset-gpios = <&gpa3 4 GPIO_ACTIVE_LOW>;
+        };
+    };
+
+...
