diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha9.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha9.c
new file mode 100644
index 0000000000..d409ac1875
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha9.c
@@ -0,0 +1,929 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E3HA9 DDIC with the 1440x3040 AMOLED panel of the Galaxy S10+
+ * (beyond2lte, "s6e3ha9_beyond2_a3_s0" in Samsung's sources).
+ *
+ * Command sequences come from Samsung's downstream panel driver
+ * (drivers/video/fbdev/exynos/panel/s6e3ha9/s6e3ha9_beyond2_a3_s0_panel.h
+ * in the SM-G975F kernel sources).
+ *
+ * Brightness: the stock driver computes a per-level gamma (0xCA) from the
+ * panel's MTP and LUTs, then sets AOR (0xB1), ELVSS (0xB5) etc. This driver
+ * only drives AOR ("AMOLED off ratio", i.e. the emission duty cycle in lines
+ * of the 3064-line frame) on top of whatever gamma the bootloader
+ * programmed. That gives a linear ~55:1 luminance range without porting the
+ * dimming engine. Below ~100 nits the stock tables do the same thing (fixed
+ * gamma, AOR-only dimming).
+ *
+ * Handover: when the panel is found already running (bootloader splash),
+ * nothing is reset or re-initialised at probe. Only sysfs-driven changes
+ * (brightness, bl_power) send commands.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/string_choices.h>
+#include <linux/workqueue.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#define S6E3HA9_VTOTAL		3064
+#define S6E3HA9_AOR_MIN		0x0014	/* brightest (stock 420 nit level) */
+#define S6E3HA9_AOR_MAX		0x0bc1	/* darkest (stock 2 nit level) */
+#define S6E3HA9_ON_MIN		(S6E3HA9_VTOTAL - S6E3HA9_AOR_MAX)
+#define S6E3HA9_ON_MAX		(S6E3HA9_VTOTAL - S6E3HA9_AOR_MIN)
+#define S6E3HA9_MAX_BRIGHTNESS	(S6E3HA9_ON_MAX - S6E3HA9_ON_MIN)
+
+#define S6E3HA9_REG_AOR		0xb1
+
+/*
+ * Touch: the S6SY761 touch controller on this panel only senses while the
+ * DDIC drives its TSP sync output, configured by B9h ("TSP HSYNC") in the
+ * init sequence. On the phone, touch stays dead after boot until the panel
+ * has gone through display off/sleep in -> init -> display on once
+ * (bl_power 1 -> 0, Phosh unblank);
+ * presumably the bootloader's init leaves B9h out. It can be replayed by
+ * writing to the panel device's touch_sync sysfs file:
+ *   1: resend only the TSP sync setup (B9h), no visible effect
+ *   2: full cycle as bl_power 1 -> 0 (the screen blanks for ~0.3 s)
+ * Powering the panel up from off (DRM enable) always
+ * runs the full init, B9h included.
+ */
+
+/*
+ * DRM unprepare (CRTC off): by default the panel is only put to sleep (display
+ * off + sleep in, as bl_power 1) and stays powered with its registers
+ * retained: gamma, ELVSS, VINT, ACL, IRC etc. are programmed by S-Boot and
+ * this driver cannot recompute them. power_off=1 additionally asserts reset
+ * and drops the supplies; the next prepare then has to run the init on a
+ * panel that lost the bootloader's brightness tables (untested, expect wrong
+ * colours or a dark picture).
+ */
+static bool power_off;
+module_param(power_off, bool, 0644);
+MODULE_PARM_DESC(power_off, "DRM unprepare asserts reset and cuts the supplies (default: false, sleep in only)");
+
+/* bits of MIPI_DCS_GET_POWER_MODE */
+#define DCS_PM_BOOSTER		BIT(7)
+#define DCS_PM_SLEEP_OUT	BIT(4)
+#define DCS_PM_DISPLAY_ON	BIT(2)
+
+/*
+ * Blank/unblank A/B. On the phone, static test content that is clean
+ * after boot shows artefacts after a few sleep in -> sleep out + init cycles
+ * (bl_power 4/0) done while DECON keeps sending frames; no SoC register
+ * differs afterwards, so the changed state is inside the DDIC, and only a
+ * reboot (S-Boot's init, done before any frame) clears it.
+ *
+ * blank_mode: what "asleep" means for bl_power off, suspend and DRM unprepare
+ *   0: display off + sleep in (default, previous behaviour)
+ *   1: display off only: the DDIC stays in sleep-out with all its registers,
+ *      nothing has to be re-initialised on unblank (costs standby current)
+ * When the panel does come out of sleep-in it gets the full init sequence,
+ * DSC/PPS before sleep out, as downstream.
+ */
+static int blank_mode;
+module_param(blank_mode, int, 0644);
+MODULE_PARM_DESC(blank_mode, "0 = blank with display off + sleep in (default), 1 = display off only");
+
+/*
+ * The stock init ends with the brightness sequence (gamma CAh,
+ * AOR, ELVSS B5h, VGH/VINT F4h, computed from the panel's MTP), which this
+ * driver cannot compute and so leaves out, apart from AOR. The values the
+ * bootloader programmed are read and logged once at probe (panel inherited
+ * running).
+ */
+
+#define S6E3HA9_GAMMA_LEN	34
+#define S6E3HA9_ELVSS_LEN	3
+#define S6E3HA9_VINT_LEN	2
+
+enum s6e3ha9_state {
+	S6E3HA9_OFF,		/* unpowered / in reset */
+	S6E3HA9_SLEEP,		/* sleep in, registers retained */
+	S6E3HA9_DISPOFF,	/* sleep out, display off */
+	S6E3HA9_ON,
+};
+
+struct s6e3ha9 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct backlight_device *bl;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	enum s6e3ha9_state state;
+	/* bootloader values, register byte first; valid if captured */
+	u8 boot_gamma[1 + S6E3HA9_GAMMA_LEN];
+	u8 boot_elvss[1 + S6E3HA9_ELVSS_LEN];
+	u8 boot_vint[1 + S6E3HA9_VINT_LEN];
+	bool captured;
+	/* hold_dark: DRM enabled, but kept in display off (see below) */
+	bool enabled;
+	bool hold;
+	struct delayed_work hold_work;
+};
+
+/* the one panel of this phone, for the hold_dark parameter */
+static struct s6e3ha9 *s6e3ha9_the;
+
+static const struct regulator_bulk_data s6e3ha9_supplies[] = {
+	{ .supply = "vdd3" },	/* 1.8 V, S2DOS05 LDO1 downstream */
+	{ .supply = "vci" },	/* 3.0 V, S2DOS05 LDO4 */
+	{ .supply = "vddr" },	/* 1.6 V, S2DOS05 BUCK */
+};
+
+/* PPS for 1440x3040, 2 slices of 720x40, 8 bpc, 8 bpp, DSC 1.1 */
+static const u8 s6e3ha9_pps_1440x3040[128] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x0b, 0xe0,
+	0x05, 0xa0, 0x00, 0x28, 0x02, 0xd0, 0x02, 0xd0,
+	0x02, 0x00, 0x02, 0x68, 0x00, 0x20, 0x04, 0x6c,
+	0x00, 0x0a, 0x00, 0x0c, 0x02, 0x77, 0x01, 0xe9,
+	0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+	0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+	0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+	0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+	0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x6b, 0xf4,
+	/* remaining 40 bytes are zero */
+};
+
+static inline struct s6e3ha9 *to_s6e3ha9(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3ha9, panel);
+}
+
+#define s6e3ha9_key1_on(ctx)	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0xa5, 0xa5)
+#define s6e3ha9_key1_off(ctx)	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0x5a, 0x5a)
+#define s6e3ha9_key2_on(ctx)	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0x5a, 0x5a)
+#define s6e3ha9_key2_off(ctx)	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0xa5, 0xa5)
+#define s6e3ha9_key3_on(ctx)	mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0x5a, 0x5a)
+#define s6e3ha9_key3_off(ctx)	mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0xa5, 0xa5)
+/* "point" global parameter: B0 <offset> <register> */
+#define s6e3ha9_gpara(ctx, ofs, reg) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, ofs, reg)
+#define s6e3ha9_gamma_update(ctx) mipi_dsi_dcs_write_seq_multi(ctx, 0xf7, 0x03)
+/* TSP HSYNC: sync output to the touch controller (level 2 key needed) */
+#define s6e3ha9_tsp_hsync(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb9, 0x01, 0xb0, 0xe1, 0x09, 0x00, \
+				     0x00, 0x00, 0x11, 0x03)
+
+/*
+ * Downstream beyond2_a3_s0_init_cmdtbl, minus the brightness sequence and
+ * the factory-only bits. Leaves the panel in sleep-out, display-off state.
+ */
+static void s6e3ha9_dsc_seq(struct mipi_dsi_multi_context *ctx)
+{
+	struct drm_dsc_picture_parameter_set pps;
+
+	static_assert(sizeof(pps) == sizeof(s6e3ha9_pps_1440x3040));
+	memcpy(&pps, s6e3ha9_pps_1440x3040, sizeof(pps));
+
+	s6e3ha9_key1_on(ctx);
+	mipi_dsi_compression_mode_multi(ctx, true);
+	mipi_dsi_picture_parameter_set_multi(ctx, &pps);
+	s6e3ha9_key1_off(ctx);
+}
+
+static void s6e3ha9_init_seq(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_msleep(ctx, 5);
+
+	s6e3ha9_dsc_seq(ctx);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(ctx);
+	mipi_dsi_msleep(ctx, 10);
+
+	s6e3ha9_key2_on(ctx);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xba, 0x01, 0x26, 0x08, 0x08, 0xf3); /* scaler off */
+	s6e3ha9_key2_off(ctx);
+
+	mipi_dsi_dcs_set_column_address_multi(ctx, 0, 1440 - 1);
+	mipi_dsi_dcs_set_page_address_multi(ctx, 0, 3040 - 1);
+
+	s6e3ha9_key1_on(ctx);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x1a, 0x1f, 0x00, 0x00, 0x00, 0x00); /* set area */
+	mipi_dsi_dcs_set_tear_on_multi(ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	s6e3ha9_key1_off(ctx);
+
+	s6e3ha9_key2_on(ctx);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xed, 0x04, 0x4c); /* ERR_FG */
+	s6e3ha9_key3_on(ctx);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xc5, 0x0d, 0x10, 0xb4, 0x3e, 0x01); /* FFC */
+	s6e3ha9_key3_off(ctx);
+	s6e3ha9_tsp_hsync(ctx);
+	s6e3ha9_gpara(ctx, 0x04, 0xf6);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf6, 0x43); /* ISC */
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x86, 0x01, 0x08, 0x10, 0x21, 0x11,
+				     0x42, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00); /* STM enable */
+	s6e3ha9_gpara(ctx, 0x95, 0xb1);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb1, 0x00, 0x01, 0x00, 0x01, 0x00,
+				     0x00); /* gamma mode 1 */
+	s6e3ha9_key2_off(ctx);
+}
+
+static void s6e3ha9_display_on_seq(struct mipi_dsi_multi_context *ctx)
+{
+	s6e3ha9_key1_on(ctx);
+	mipi_dsi_dcs_set_display_on_multi(ctx);
+	s6e3ha9_key1_off(ctx);
+}
+
+static void s6e3ha9_display_off_seq(struct mipi_dsi_multi_context *ctx)
+{
+	s6e3ha9_key1_on(ctx);
+	mipi_dsi_dcs_set_display_off_multi(ctx);
+	s6e3ha9_key1_off(ctx);
+	mipi_dsi_msleep(ctx, 20);
+}
+
+static void s6e3ha9_sleep_in_seq(struct mipi_dsi_multi_context *ctx)
+{
+	s6e3ha9_key1_on(ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(ctx);
+	s6e3ha9_key1_off(ctx);
+	mipi_dsi_msleep(ctx, 120);
+}
+
+static void s6e3ha9_set_aor(struct mipi_dsi_multi_context *ctx, u16 aor)
+{
+	u8 buf[] = { S6E3HA9_REG_AOR, aor >> 8, aor & 0xff };
+
+	s6e3ha9_key2_on(ctx);
+	mipi_dsi_dcs_write_buffer_multi(ctx, buf, sizeof(buf));
+	s6e3ha9_gamma_update(ctx);
+	s6e3ha9_key2_off(ctx);
+}
+
+/* Read the 2 AOR bytes (B1h, offset 0); level-2 key is required. */
+static int s6e3ha9_read_aor(struct s6e3ha9 *ctx, u8 buf[2])
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	s6e3ha9_key2_on(&dsi_ctx);
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+	ret = mipi_dsi_dcs_read(ctx->dsi, S6E3HA9_REG_AOR, buf, 2);
+	s6e3ha9_key2_off(&dsi_ctx);
+
+	return ret;
+}
+
+static u16 s6e3ha9_brightness_to_aor(unsigned int brightness)
+{
+	brightness = min_t(unsigned int, brightness, S6E3HA9_MAX_BRIGHTNESS);
+	return S6E3HA9_VTOTAL - (S6E3HA9_ON_MIN + brightness);
+}
+
+static unsigned int s6e3ha9_aor_to_brightness(u16 aor)
+{
+	aor = clamp_t(u16, aor, S6E3HA9_AOR_MIN, S6E3HA9_AOR_MAX);
+	return S6E3HA9_VTOTAL - aor - S6E3HA9_ON_MIN;
+}
+
+static void s6e3ha9_capture_bl(struct s6e3ha9 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct device *dev = &ctx->dsi->dev;
+	int g, e, v;
+
+	ctx->boot_gamma[0] = 0xca;
+	ctx->boot_elvss[0] = 0xb5;
+	ctx->boot_vint[0] = 0xf4;
+
+	s6e3ha9_key2_on(&dsi_ctx);
+	if (dsi_ctx.accum_err)
+		return;
+	g = mipi_dsi_dcs_read(ctx->dsi, 0xca, ctx->boot_gamma + 1, S6E3HA9_GAMMA_LEN);
+	e = mipi_dsi_dcs_read(ctx->dsi, 0xb5, ctx->boot_elvss + 1, S6E3HA9_ELVSS_LEN);
+	v = mipi_dsi_dcs_read(ctx->dsi, 0xf4, ctx->boot_vint + 1, S6E3HA9_VINT_LEN);
+	s6e3ha9_key2_off(&dsi_ctx);
+
+	ctx->captured = g == S6E3HA9_GAMMA_LEN && e == S6E3HA9_ELVSS_LEN &&
+			v == S6E3HA9_VINT_LEN;
+	dev_info(dev, "bootloader brightness registers (%d/%d/%d bytes, %s): CA %*ph, B5 %*ph, F4 %*ph\n",
+		 g, e, v, ctx->captured ? "captured" : "incomplete",
+		 S6E3HA9_GAMMA_LEN, ctx->boot_gamma + 1,
+		 S6E3HA9_ELVSS_LEN, ctx->boot_elvss + 1,
+		 S6E3HA9_VINT_LEN, ctx->boot_vint + 1);
+}
+
+/* Move the panel between SLEEP / DISPOFF / ON. Never called while OFF. */
+static int s6e3ha9_set_state(struct s6e3ha9 *ctx, enum s6e3ha9_state target)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (ctx->state == S6E3HA9_OFF || target == S6E3HA9_OFF)
+		return -EINVAL;
+
+	/* blank_mode 1: never enter sleep-in; a panel already asleep still wakes */
+	if (target == S6E3HA9_SLEEP && READ_ONCE(blank_mode) == 1 &&
+	    ctx->state != S6E3HA9_SLEEP)
+		target = S6E3HA9_DISPOFF;
+
+	if (target == ctx->state)
+		return 0;
+
+	if (target < ctx->state) {
+		if (ctx->state == S6E3HA9_ON)
+			s6e3ha9_display_off_seq(&dsi_ctx);
+		if (target == S6E3HA9_SLEEP)
+			s6e3ha9_sleep_in_seq(&dsi_ctx);
+	} else {
+		if (ctx->state == S6E3HA9_SLEEP) {
+			/*
+			 * Resend the static configuration (DSC/PPS, TE,
+			 * window) around the sleep out, as downstream.
+			 */
+			s6e3ha9_init_seq(&dsi_ctx);
+			mipi_dsi_msleep(&dsi_ctx, 120);
+			dev_info(&ctx->dsi->dev, "wake from sleep-in: %d\n",
+				 dsi_ctx.accum_err);
+		}
+		if (target == S6E3HA9_ON)
+			s6e3ha9_display_on_seq(&dsi_ctx);
+	}
+
+	if (!dsi_ctx.accum_err)
+		ctx->state = target;
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha9_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e3ha9 *ctx = bl_get_data(bl);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	enum s6e3ha9_state target;
+	int ret;
+
+	if (ctx->state == S6E3HA9_OFF)
+		return 0;	/* applied on the next enable */
+
+	if (bl->props.power == BACKLIGHT_POWER_OFF ||
+	    (bl->props.state & BL_CORE_SUSPENDED))
+		target = S6E3HA9_SLEEP;
+	else if (backlight_is_blank(bl))
+		target = S6E3HA9_DISPOFF;
+	else
+		target = S6E3HA9_ON;
+
+	if (target == S6E3HA9_ON && READ_ONCE(ctx->hold))
+		target = S6E3HA9_DISPOFF;
+
+	if (target == S6E3HA9_SLEEP)
+		return s6e3ha9_set_state(ctx, S6E3HA9_SLEEP);
+
+	if (ctx->state == S6E3HA9_SLEEP) {
+		ret = s6e3ha9_set_state(ctx, S6E3HA9_DISPOFF);
+		if (ret)
+			return ret;
+	}
+
+	/* Program AOR before turning the display on to avoid a flash. */
+	s6e3ha9_set_aor(&dsi_ctx, s6e3ha9_brightness_to_aor(bl->props.brightness));
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	return s6e3ha9_set_state(ctx, target);
+}
+
+static const struct backlight_ops s6e3ha9_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	/*
+	 * No .get_brightness: reading back over DSI on every sysfs read
+	 * (userspace polls actual_brightness) is not worth the bus traffic.
+	 */
+	.update_status = s6e3ha9_bl_update_status,
+};
+
+/* Called with bl->update_lock held */
+static int s6e3ha9_do_touch_sync(struct s6e3ha9 *ctx, int mode)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	if (ctx->state == S6E3HA9_OFF)
+		return -ENODEV;	/* the next power-up runs the full init */
+
+	switch (mode) {
+	case 1:
+		s6e3ha9_key2_on(&dsi_ctx);
+		s6e3ha9_tsp_hsync(&dsi_ctx);
+		s6e3ha9_key2_off(&dsi_ctx);
+		ret = dsi_ctx.accum_err;
+		break;
+	case 2:
+		ret = s6e3ha9_set_state(ctx, S6E3HA9_SLEEP);
+		if (!ret)
+			ret = s6e3ha9_bl_update_status(ctx->bl);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	dev_info(&ctx->dsi->dev, "touch sync %d: %d\n", mode, ret);
+	return ret;
+}
+
+static int s6e3ha9_touch_sync(struct s6e3ha9 *ctx, int mode)
+{
+	int ret;
+
+	mutex_lock(&ctx->bl->update_lock);
+	ret = s6e3ha9_do_touch_sync(ctx, mode);
+	mutex_unlock(&ctx->bl->update_lock);
+
+	return ret;
+}
+
+static ssize_t touch_sync_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct s6e3ha9 *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+	int mode, ret;
+
+	ret = kstrtoint(buf, 0, &mode);
+	if (ret)
+		return ret;
+
+	ret = s6e3ha9_touch_sync(ctx, mode);
+	return ret ?: count;
+}
+static DEVICE_ATTR_WO(touch_sync);
+
+/*
+ * Read-only snapshot of the DDIC state, to diff "fresh boot" against "after
+ * the compositor ran": standard DCS status registers plus the vendor
+ * registers this driver or the bootloader programs. Reads only; the level-2
+ * key is opened for the vendor registers and closed again.
+ */
+static ssize_t dcs_dump_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	static const struct { u8 reg; u8 len; const char *name; } regs[] = {
+		{ 0x04, 3, "display id" },
+		{ 0x05, 1, "dsi errors" },
+		{ 0x0a, 1, "power mode" },
+		{ 0x0b, 1, "address mode" },
+		{ 0x0c, 1, "pixel format" },
+		{ 0x0d, 1, "display mode" },
+		{ 0x0e, 1, "signal mode (TE)" },
+		{ 0x0f, 1, "self-diagnostic" },
+		{ 0x45, 2, "scanline" },
+		{ 0x52, 2, "brightness value" },
+		{ 0x54, 1, "ctrl display" },
+		{ 0xb1, 16, "AOR" },
+		{ 0xb5, 16, "ELVSS/ACL" },
+		{ 0xb9, 16, "TSP sync" },
+		{ 0xba, 5, "scaler" },
+		{ 0xc5, 5, "FFC" },
+		{ 0xca, 16, "gamma (first 16)" },
+		{ 0xed, 2, "ERR_FG" },
+		{ 0xf4, 2, "VGH/VINT" },
+		{ 0xf6, 1, "ISC" },
+	};
+	struct s6e3ha9 *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	ssize_t n = 0;
+	unsigned int i;
+	u8 val[16];
+	int ret;
+
+	mutex_lock(&ctx->bl->update_lock);
+	n += sysfs_emit_at(buf, n, "state %d brightness %d power %d\n", ctx->state,
+			   ctx->bl->props.brightness, ctx->bl->props.power);
+	if (ctx->state == S6E3HA9_OFF || ctx->state == S6E3HA9_SLEEP) {
+		n += sysfs_emit_at(buf, n, "panel asleep or off: no reads\n");
+		goto out;
+	}
+
+	s6e3ha9_key2_on(&dsi_ctx);
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		memset(val, 0, sizeof(val));
+		ret = mipi_dsi_dcs_read(ctx->dsi, regs[i].reg, val, regs[i].len);
+		if (ret < 0)
+			n += sysfs_emit_at(buf, n, "%02x %-18s error %d\n",
+					   regs[i].reg, regs[i].name, ret);
+		else
+			n += sysfs_emit_at(buf, n, "%02x %-18s %*ph\n",
+					   regs[i].reg, regs[i].name,
+					   min_t(int, ret, regs[i].len), val);
+	}
+	s6e3ha9_key2_off(&dsi_ctx);
+out:
+	mutex_unlock(&ctx->bl->update_lock);
+	return n;
+}
+static DEVICE_ATTR_ADMIN_RO(dcs_dump);
+
+static struct attribute *s6e3ha9_attrs[] = {
+	&dev_attr_touch_sync.attr,
+	&dev_attr_dcs_dump.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(s6e3ha9);
+
+/*
+ * The reset GPIO is requested GPIOD_ASIS so that probe does not disturb the
+ * running panel. The Samsung pinctrl has no .get_direction, so gpiolib does
+ * not know the line is an output and gpiod_set_value() returns -EPERM: drive
+ * it with gpiod_direction_output() instead (glitch-free on Samsung pinctrl,
+ * which writes DAT before switching CON). Logical 1 = in reset (active low).
+ */
+static int s6e3ha9_set_reset(struct s6e3ha9 *ctx, int asserted)
+{
+	int ret = gpiod_direction_output(ctx->reset_gpio, asserted);
+
+	if (ret)
+		dev_err(&ctx->dsi->dev, "reset gpio %d: %d\n", asserted, ret);
+	return ret;
+}
+
+/* Downstream __set_panel_power(): supplies, 10 ms, reset high, 5 ms */
+static int s6e3ha9_reset(struct s6e3ha9 *ctx)
+{
+	int ret;
+
+	ret = s6e3ha9_set_reset(ctx, 1);
+	usleep_range(5000, 6000);
+	ret = ret ?: s6e3ha9_set_reset(ctx, 0);
+	usleep_range(10000, 11000);
+	return ret;
+}
+
+static int s6e3ha9_prepare(struct drm_panel *panel)
+{
+	struct s6e3ha9 *ctx = to_s6e3ha9(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (ctx->state == S6E3HA9_SLEEP) {
+		/* soft off: same as bl_power 1 -> 0 (sleep out, init, 120 ms) */
+		ret = s6e3ha9_set_state(ctx, S6E3HA9_DISPOFF);
+		if (!ret) {
+			s6e3ha9_set_aor(&dsi_ctx,
+					s6e3ha9_brightness_to_aor(ctx->bl->props.brightness));
+			ret = dsi_ctx.accum_err;
+		}
+		dev_info(dev, "prepare: sleep out + init: %d\n", ret);
+		return ret;
+	}
+
+	if (ctx->state != S6E3HA9_OFF)
+		return 0;	/* inherited from the bootloader, or awake */
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s6e3ha9_supplies), ctx->supplies);
+	if (ret)
+		return ret;
+	usleep_range(10000, 11000);
+
+	ret = s6e3ha9_reset(ctx);
+	if (!ret) {
+		s6e3ha9_init_seq(&dsi_ctx);
+		s6e3ha9_set_aor(&dsi_ctx,
+				s6e3ha9_brightness_to_aor(ctx->bl->props.brightness));
+		mipi_dsi_msleep(&dsi_ctx, 120);
+		ret = dsi_ctx.accum_err;
+	}
+	dev_info(dev, "prepare: power on + reset + init: %d\n", ret);
+	if (ret) {
+		s6e3ha9_set_reset(ctx, 1);
+		regulator_bulk_disable(ARRAY_SIZE(s6e3ha9_supplies), ctx->supplies);
+		return ret;
+	}
+
+	ctx->state = S6E3HA9_DISPOFF;
+	return 0;
+}
+
+static int s6e3ha9_enable(struct drm_panel *panel)
+{
+	struct s6e3ha9 *ctx = to_s6e3ha9(panel);
+	enum s6e3ha9_state old = ctx->state;
+	int ret;
+
+	WRITE_ONCE(ctx->enabled, true);
+	if (READ_ONCE(ctx->hold)) {
+		dev_info(&ctx->dsi->dev, "enable: held dark (from state %d)\n", old);
+		return 0;
+	}
+
+	/* drm_panel_enable() calls backlight_enable() afterwards */
+	ret = s6e3ha9_set_state(ctx, S6E3HA9_ON);
+	if (old != S6E3HA9_ON)
+		dev_info(&ctx->dsi->dev, "enable: display on (from state %d): %d\n",
+			 old, ret);
+	return ret;
+}
+
+static int s6e3ha9_disable(struct drm_panel *panel)
+{
+	struct s6e3ha9 *ctx = to_s6e3ha9(panel);
+
+	/* the dark wake is over: the next enable lights the panel again */
+	WRITE_ONCE(ctx->enabled, false);
+	if (READ_ONCE(ctx->hold)) {
+		cancel_delayed_work(&ctx->hold_work);
+		WRITE_ONCE(ctx->hold, false);
+		dev_info(&ctx->dsi->dev, "hold dark: ended by disable\n");
+	}
+
+	/* backlight_disable() may already have put the panel to sleep */
+	if (ctx->state != S6E3HA9_ON)
+		return 0;
+	return s6e3ha9_set_state(ctx, S6E3HA9_DISPOFF);
+}
+
+static int s6e3ha9_unprepare(struct drm_panel *panel)
+{
+	struct s6e3ha9 *ctx = to_s6e3ha9(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (ctx->state == S6E3HA9_OFF)
+		return 0;
+
+	/* usually already done by backlight_disable() in drm_panel_disable() */
+	ret = s6e3ha9_set_state(ctx, S6E3HA9_SLEEP);
+
+	if (!power_off) {
+		dev_info(dev, "unprepare: sleep in, power and registers kept: %d\n",
+			 ret);
+		return 0;
+	}
+
+	s6e3ha9_set_reset(ctx, 1);
+	regulator_bulk_disable(ARRAY_SIZE(s6e3ha9_supplies), ctx->supplies);
+	ctx->state = S6E3HA9_OFF;
+	dev_info(dev, "unprepare: sleep in (%d), reset asserted, supplies off\n",
+		 ret);
+
+	return 0;
+}
+
+/*
+ * Command mode panel, so porches are nominal (from downstream lcd_info:
+ * h-porch 2/2/2, v-porch 15/3/1, 60 Hz).
+ */
+static const struct drm_display_mode s6e3ha9_mode = {
+	.clock = (1440 + 2 + 2 + 2) * (3040 + 15 + 3 + 1) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 2,
+	.hsync_end = 1440 + 2 + 2,
+	.htotal = 1440 + 2 + 2 + 2,
+	.vdisplay = 3040,
+	.vsync_start = 3040 + 15,
+	.vsync_end = 3040 + 15 + 3,
+	.vtotal = 3040 + 15 + 3 + 1,
+	.width_mm = 70,
+	.height_mm = 148,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int s6e3ha9_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e3ha9_mode);
+}
+
+static const struct drm_panel_funcs s6e3ha9_panel_funcs = {
+	.prepare = s6e3ha9_prepare,
+	.enable = s6e3ha9_enable,
+	.disable = s6e3ha9_disable,
+	.unprepare = s6e3ha9_unprepare,
+	.get_modes = s6e3ha9_get_modes,
+};
+
+/* Probe-time, read-only look at the panel; returns true if it is lit. */
+static bool s6e3ha9_detect_running(struct s6e3ha9 *ctx, u16 *aor)
+{
+	struct device *dev = &ctx->dsi->dev;
+	u8 id[3], pm = 0, buf[2];
+	int ret;
+
+	ret = mipi_dsi_dcs_read(ctx->dsi, MIPI_DCS_GET_DISPLAY_ID, id, sizeof(id));
+	if (ret == sizeof(id))
+		dev_info(dev, "panel ID %02x %02x %02x\n", id[0], id[1], id[2]);
+	else
+		dev_warn(dev, "failed to read panel ID: %d\n", ret);
+
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &pm);
+	if (ret) {
+		dev_warn(dev, "failed to read power mode: %d\n", ret);
+		return false;
+	}
+	dev_info(dev, "power mode 0x%02x (booster %s, %s, display %s)\n", pm,
+		 str_on_off(pm & DCS_PM_BOOSTER),
+		 (pm & DCS_PM_SLEEP_OUT) ? "awake" : "asleep",
+		 str_on_off(pm & DCS_PM_DISPLAY_ON));
+
+	ret = s6e3ha9_read_aor(ctx, buf);
+	if (ret == sizeof(buf)) {
+		*aor = buf[0] << 8 | buf[1];
+		dev_info(dev, "bootloader AOR 0x%04x\n", *aor);
+	}
+
+	return (pm & (DCS_PM_SLEEP_OUT | DCS_PM_DISPLAY_ON)) ==
+	       (DCS_PM_SLEEP_OUT | DCS_PM_DISPLAY_ON);
+}
+
+static void s6e3ha9_hold_release(struct s6e3ha9 *ctx, const char *why)
+{
+	if (!xchg(&ctx->hold, false))
+		return;
+	dev_info(&ctx->dsi->dev, "hold dark %s, DRM %s\n", why,
+		 READ_ONCE(ctx->enabled) ? "enabled: display on" : "disabled");
+	if (READ_ONCE(ctx->enabled) && ctx->bl)
+		backlight_update_status(ctx->bl);
+}
+
+static void s6e3ha9_hold_work(struct work_struct *work)
+{
+	struct s6e3ha9 *ctx = container_of(to_delayed_work(work),
+					   struct s6e3ha9, hold_work);
+
+	s6e3ha9_hold_release(ctx, "expired");
+}
+
+/*
+ * hold_dark: keep the panel dark through the next DRM enable. gsd-power turns
+ * the screen on after every resume; after a wake by the RTC alone user space
+ * (beyond2lte-resuspend sleep hook, before the session is thawed) writes N ms
+ * here and switches the screen off again a moment later. While held, DRM
+ * enable and backlight updates stop at display off (panel powered, nothing
+ * lit). The hold ends at the next DRM disable, when 0 is written, or after N
+ * ms (max 30 s); if DRM is still enabled then, the display is turned on, so a
+ * forgotten hold never leaves a dark screen. Reads 1 while held.
+ */
+static int s6e3ha9_hold_set(const char *val, const struct kernel_param *kp)
+{
+	struct s6e3ha9 *ctx = READ_ONCE(s6e3ha9_the);
+	unsigned int ms;
+	int ret;
+
+	ret = kstrtouint(val, 0, &ms);
+	if (ret)
+		return ret;
+	if (!ctx)
+		return -ENODEV;
+	if (!ms) {
+		cancel_delayed_work(&ctx->hold_work);
+		s6e3ha9_hold_release(ctx, "released");
+		return 0;
+	}
+	WRITE_ONCE(ctx->hold, true);
+	mod_delayed_work(system_wq, &ctx->hold_work,
+			 msecs_to_jiffies(min(ms, 30000U)));
+	dev_info(&ctx->dsi->dev, "hold dark for up to %u ms\n", min(ms, 30000U));
+	return 0;
+}
+
+static int s6e3ha9_hold_get(char *buf, const struct kernel_param *kp)
+{
+	struct s6e3ha9 *ctx = READ_ONCE(s6e3ha9_the);
+
+	return sysfs_emit(buf, "%d\n", ctx ? READ_ONCE(ctx->hold) : 0);
+}
+
+static const struct kernel_param_ops s6e3ha9_hold_ops = {
+	.set = s6e3ha9_hold_set,
+	.get = s6e3ha9_hold_get,
+};
+module_param_cb(hold_dark, &s6e3ha9_hold_ops, NULL, 0644);
+MODULE_PARM_DESC(hold_dark, "Write N ms: keep the panel dark through the next DRM enable (until DRM disable, 0, or N ms)");
+
+static int s6e3ha9_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.scale = BACKLIGHT_SCALE_LINEAR,
+		.max_brightness = S6E3HA9_MAX_BRIGHTNESS,
+		.brightness = S6E3HA9_MAX_BRIGHTNESS / 2,
+	};
+	struct s6e3ha9 *ctx;
+	u16 aor = 0;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e3ha9, panel,
+				   &s6e3ha9_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	INIT_DELAYED_WORK(&ctx->hold_work, s6e3ha9_hold_work);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3ha9_supplies),
+					    s6e3ha9_supplies, &ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* ASIS: asserting reset here would blank the bootloader splash. */
+	ctx->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 720;
+	ctx->dsc.slice_count = 1440 / 720;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	dsi->dsc = &ctx->dsc;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+
+	if (s6e3ha9_detect_running(ctx, &aor)) {
+		ctx->state = S6E3HA9_ON;
+		s6e3ha9_capture_bl(ctx);
+		/* Acquire regulators so their use count matches reality. */
+		ret = regulator_bulk_enable(ARRAY_SIZE(s6e3ha9_supplies),
+					    ctx->supplies);
+		if (ret)
+			dev_warn(dev, "failed to enable supplies: %d\n", ret);
+		if (aor)
+			props.brightness = s6e3ha9_aor_to_brightness(aor);
+	} else {
+		/*
+		 * Could not confirm the panel is lit. Don't touch it: assume
+		 * OFF so that only a DRM enable path would (re)initialise it.
+		 */
+		dev_warn(dev, "panel state unknown, brightness control inactive\n");
+		ctx->state = S6E3HA9_OFF;
+	}
+
+	ctx->bl = devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+						 &s6e3ha9_bl_ops, &props);
+	if (IS_ERR(ctx->bl)) {
+		ret = PTR_ERR(ctx->bl);
+		goto err_detach;
+	}
+	ctx->panel.backlight = ctx->bl;
+
+	drm_panel_add(&ctx->panel);
+	WRITE_ONCE(s6e3ha9_the, ctx);
+
+	return 0;
+
+err_detach:
+	mipi_dsi_detach(dsi);
