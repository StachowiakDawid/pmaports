From fefdad8665d9276eb3343e2b5b63d8ce00975eaa Mon Sep 17 00:00:00 2001
From: chiffathefox <chiffathefoxx@gmail.com>
Date: Sat, 20 Jun 2026 23:57:24 +0300
Subject: [PATCH 12/46] clk: samsung: add exynos9820 ACPM clock driver

(cherry picked from commit b0305692b0470fa3a4019591cd3c0bc40a0c29ba)
---
 drivers/clk/samsung/clk-acpm.c                | 25 ++++++++++++++++++
 .../clock/samsung,exynos9820-acpm.h           | 26 +++++++++++++++++++
 2 files changed, 51 insertions(+)
 create mode 100644 include/dt-bindings/clock/samsung,exynos9820-acpm.h

diff --git a/drivers/clk/samsung/clk-acpm.c b/drivers/clk/samsung/clk-acpm.c
index d5f1e73e05..abba1dfb10 100644
--- a/drivers/clk/samsung/clk-acpm.c
+++ b/drivers/clk/samsung/clk-acpm.c
@@ -91,6 +91,30 @@ static const struct acpm_clk_driver_data acpm_clk_gs101 = {
 	.mbox_chan_id = 0,
 };
 
+static const struct acpm_clk_variant exynos9820_acpm_clks[] = {
+	ACPM_CLK("mif"),
+	ACPM_CLK("int"),
+	ACPM_CLK("cpucl0"),
+	ACPM_CLK("cpucl1"),
+	ACPM_CLK("cpucl2"),
+	ACPM_CLK("npu"),
+	ACPM_CLK("disp"),
+	ACPM_CLK("score"),
+	ACPM_CLK("aud"),
+	ACPM_CLK("cp"),		/* Not a clock? */
+	ACPM_CLK("g3d"),
+	ACPM_CLK("intcam"),
+	ACPM_CLK("cam"),
+	ACPM_CLK("iva"),
+	ACPM_CLK("mfc"),
+};
+
+static const struct acpm_clk_driver_data acpm_clk_exynos9820 = {
+	.clks = exynos9820_acpm_clks,
+	.nr_clks = ARRAY_SIZE(exynos9820_acpm_clks),
+	.mbox_chan_id = 0,
+};
+
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate)
 {
@@ -203,6 +227,7 @@ static int acpm_clk_probe(struct platform_device *pdev)
 static const struct platform_device_id acpm_clk_id[] = {
 	{ .name = "exynos850-acpm-clk", (kernel_ulong_t)&acpm_clk_exynos850 },
 	{ .name = "gs101-acpm-clk", (kernel_ulong_t)&acpm_clk_gs101 },
+	{ .name = "exynos9820-acpm-clk", (kernel_ulong_t)&acpm_clk_exynos9820 },
 	{ }
 };
 MODULE_DEVICE_TABLE(platform, acpm_clk_id);
diff --git a/include/dt-bindings/clock/samsung,exynos9820-acpm.h b/include/dt-bindings/clock/samsung,exynos9820-acpm.h
new file mode 100644
index 0000000000..612248c602
--- /dev/null
+++ b/include/dt-bindings/clock/samsung,exynos9820-acpm.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Copyright (c) 2026 chiffathefox <chiffathefoxx@gmail.com>
+ *
+ * Device Tree binding constants for Samsung exynos9820 ACPM clock controller.
+ */
+
+#ifndef _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS9820_ACPM_H
+#define _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS9820_ACPM_H
+
+#define EXYNOS9820_CLK_ACPM_DVFS_MIF			0
+#define EXYNOS9820_CLK_ACPM_DVFS_INT			1
+#define EXYNOS9820_CLK_ACPM_DVFS_CPUCL0			2
+#define EXYNOS9820_CLK_ACPM_DVFS_CPUCL1			3
+#define EXYNOS9820_CLK_ACPM_DVFS_CPUCL2			4
+#define EXYNOS9820_CLK_ACPM_DVFS_NPU			5
+#define EXYNOS9820_CLK_ACPM_DVFS_DISP			6
+#define EXYNOS9820_CLK_ACPM_DVFS_SCORE			7
+#define EXYNOS9820_CLK_ACPM_DVFS_AUD 			8
+#define EXYNOS9820_CLK_ACPM_DVFS_GPU			10
+#define EXYNOS9820_CLK_ACPM_DVFS_INTCAM			11
+#define EXYNOS9820_CLK_ACPM_DVFS_CAM			12
+#define EXYNOS9820_CLK_ACPM_DVFS_IVA 			13
+#define EXYNOS9820_CLK_ACPM_DVFS_MFC			14
+
+#endif /* _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS9820_ACPM_H */
