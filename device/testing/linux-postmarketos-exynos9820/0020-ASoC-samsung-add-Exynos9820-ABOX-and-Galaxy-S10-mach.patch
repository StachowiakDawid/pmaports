+static struct abox_dma *abox_substream_dma(struct abox *abox,
+					   struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu = snd_soc_rtd_to_cpu(rtd, 0);
+	struct abox_uaif *u;
+
+	if (cpu->id >= ABOX_NUM_UAIF)
+		return NULL;
+	u = &abox->uaif[cpu->id];
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		return u->rdma >= 0 ? &abox->rdma[cpu->id] : NULL;
+
+	return u->wdma >= 0 ? &abox->wdma[cpu->id] : NULL;
+}
+
+static void __iomem *abox_dma_status_reg(struct abox *abox,
+					 struct abox_dma *dma)
+{
+	return abox->sfr + (dma->capture ? ABOX_WDMA_STATUS(dma->id) :
+					   ABOX_RDMA_STATUS(dma->id));
+}
+
+static u32 abox_dma_status(struct abox *abox, struct abox_dma *dma)
+{
+	return readl(abox_dma_status_reg(abox, dma));
+}
+
+static u32 abox_dma_ctrl(struct abox *abox, struct abox_dma *dma)
+{
+	return readl(abox->sfr + (dma->capture ? ABOX_WDMA_CTRL(dma->id) :
+						 ABOX_RDMA_CTRL0(dma->id)));
+}
+
+/*
+ * Wait until the DMA engine has finished (STATUS.PROGRESS clear). The AP
+ * never writes the enable bit: the firmware sets it on TRIGGER(1) and
+ * clears it on TRIGGER(0) (Calliope MUL0: "PCM output/input %d paused" ->
+ * VOL_FACTOR 0, then RDMA_CTRL0/WDMA_CTRL bit 0 cleared, 0x800f9160).
+ */
+static bool abox_dma_wait_idle(struct abox *abox, struct abox_dma *dma,
+			       const char *when)
+{
+	u32 status = abox_dma_status(abox, dma);
+	ktime_t start = ktime_get();
+
+	if (!(status & ABOX_DMA_PROGRESS))
+		return true;
+
+	if (readl_poll_timeout(abox_dma_status_reg(abox, dma), status,
+			       !(status & ABOX_DMA_PROGRESS), 100,
+			       ABOX_DMA_IDLE_TIMEOUT_US)) {
+		dev_warn(abox->dev,
+			 "%cDMA%d still running %s: status %#x ctrl %#x (at HW_FREE %#x)\n",
+			 dma->capture ? 'W' : 'R', dma->id, when, status,
+			 abox_dma_ctrl(abox, dma), dma->status_at_free);
+		return false;
+	}
+
+	dev_dbg(abox->dev, "%cDMA%d idle %s after %lld us\n",
+		dma->capture ? 'W' : 'R', dma->id, when,
+		ktime_us_delta(ktime_get(), start));
+	return true;
+}
+
+static int abox_pcm_open(struct snd_soc_component *component,
+			 struct snd_pcm_substream *substream)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct abox_ipc_msg msg = {};
+	int ret;
+
+	if (!dma || !dma->mapped)
+		return -ENODEV;
+
+	ret = abox_wait_ready(abox);
+	if (ret)
+		return ret;
+
+	snd_soc_set_runtime_hwparams(substream, &abox_pcm_hw);
+	ret = snd_pcm_hw_constraint_step(substream->runtime, 0,
+					 SNDRV_PCM_HW_PARAM_PERIOD_BYTES, 16);
+	if (ret)
+		return ret;
+
+	ret = abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_OPEN, &msg, true);
+	if (ret)
+		return ret;
+
+	dma->fw_open = true;
+	WRITE_ONCE(dma->substream, substream);
+	return 0;
+}
+
+static int abox_pcm_close(struct snd_soc_component *component,
+			  struct snd_pcm_substream *substream)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct abox_ipc_msg msg = {};
+
+	if (!dma)
+		return 0;
+
+	WRITE_ONCE(dma->substream, NULL);
+	dma->fw_open = false;
+	dma->fw_hw = false;
+	reinit_completion(&dma->closed);
+	if (!abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_CLOSE, &msg, true) &&
+	    !wait_for_completion_timeout(&dma->closed,
+					 msecs_to_jiffies(ABOX_DMA_TIMEOUT_MS)))
+		dev_warn(abox->dev, "%cDMA%d: no PLTDAI_CLOSED from firmware\n",
+			 dma->capture ? 'W' : 'R', dma->id);
+	WRITE_ONCE(dma->ack_enabled, false);
+
+	/* after CLOSE the channel has no owner, the DMA must be idle now */
+	abox_dma_wait_idle(abox, dma, "after CLOSE");
+	dma->status_at_free = 0;
+	return 0;
+}
+
+/* SET_BUFFER + HW_PARAMS from the cached parameters */
+static int abox_pcm_send_hw(struct abox *abox, struct abox_dma *dma)
+{
+	struct abox_ipc_msg msg = {};
+	int ret;
+
+	msg.msg.pcmtask.param.setbuff.phyaddr = dma->iova;
+	msg.msg.pcmtask.param.setbuff.size = dma->period_bytes;
+	msg.msg.pcmtask.param.setbuff.count = dma->periods;
+	ret = abox_pcm_ipc(abox, dma, ABOX_PCM_SET_BUFFER, &msg, true);
+	if (ret)
+		return ret;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.msg.pcmtask.param.hw_params.sample_rate = dma->rate;
+	msg.msg.pcmtask.param.hw_params.bit_depth = dma->width;
+	msg.msg.pcmtask.param.hw_params.channels = dma->channels;
+	return abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_HW_PARAMS, &msg, true);
+}
+
+static int abox_pcm_hw_params(struct snd_soc_component *component,
+			      struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	unsigned int ptime;
+	u32 reg;
+	int ret;
+
+	/* do not reprogram the buffer under a running DMA */
+	abox_dma_wait_idle(abox, dma, "before HW_PARAMS");
+
+	snd_pcm_set_runtime_buffer(substream, &dma->dmab);
+	substream->runtime->dma_bytes = params_buffer_bytes(params);
+
+	/* SRAM bank in front of the DMA: 128 bytes for <= 10 ms periods */
+	ptime = params_period_size(params) * 1000 / params_rate(params);
+	reg = dma->capture ? ABOX_SPUM_SBANK_NSRC(dma->id - 1) :
+			     ABOX_SPUS_SBANK_RDMA(dma->id);
+	abox_update(abox, reg, ABOX_SBANK_SIZE_MASK,
+		    FIELD_PREP(ABOX_SBANK_SIZE_MASK,
+			       (ptime <= 10 ? SZ_128 : SZ_512) / 16));
+	/* downstream: burst 8 unless the SRAM bank is below 128 bytes */
+	if (!dma->capture)
+		abox_update(abox, ABOX_RDMA_CTRL0(dma->id), ABOX_RDMA_BURST_LEN,
+			    FIELD_PREP(ABOX_RDMA_BURST_LEN, 8));
+
+	dma->period_bytes = params_period_bytes(params);
+	dma->periods = params_periods(params);
+	dma->rate = params_rate(params);
+	dma->width = params_width(params);
+	dma->channels = params_channels(params);
+	ret = abox_pcm_send_hw(abox, dma);
+	dma->fw_hw = !ret;
+	return ret;
+}
+
+static int abox_pcm_hw_free(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct abox_ipc_msg msg = {};
+	u32 status;
+
+	if (!dma)
+		return 0;
+
+	abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_HW_FREE, &msg, true);
+	dma->fw_hw = false;
+
+	/*
+	 * Downstream polls STATUS.PROGRESS here (40 ms) because its buffers
+	 * can go away at hw_free. Ours is the fixed per-DMA buffer from probe,
+	 * mapped at a fixed IOVA, so nothing is freed here. The firmware only
+	 * tears the channel down on CLOSE ("clear_out_channel_buffer", "PCM
+	 * close"), HW_FREE itself is a no-op in its log. The barrier therefore
+	 * runs in close() and before the next HW_PARAMS; here we only record
+	 * the state for the diagnostics (dynamic debug).
+	 */
+	status = abox_dma_status(abox, dma);
+	dma->status_at_free = status;
+	if (status & ABOX_DMA_PROGRESS)
+		dev_dbg(abox->dev,
+			"%cDMA%d busy at HW_FREE: status %#x ctrl %#x, %s\n",
+			dma->capture ? 'W' : 'R', dma->id, status,
+			abox_dma_ctrl(abox, dma),
+			READ_ONCE(dma->triggered) ? "after a trigger" :
+						    "never triggered");
+	WRITE_ONCE(dma->triggered, false);
+
+	snd_pcm_set_runtime_buffer(substream, NULL);
+	return 0;
+}
+
+static int abox_pcm_prepare(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct abox_ipc_msg msg = {};
+
+	WRITE_ONCE(dma->pointer, dma->iova);
+	if (substream->runtime->dma_area)
+		memset(substream->runtime->dma_area, 0,
+		       substream->runtime->dma_bytes);
+
+	return abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_PREPARE, &msg, true);
+}
+
+static int abox_pcm_trigger(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream, int cmd)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct abox_ipc_msg msg = {};
+
+	/*
+	 * The card may suspend its streams after the ABOX already stopped
+	 * the firmware for a system sleep (no ordering between the two).
+	 */
+	if (READ_ONCE(abox->state) != ABOX_STATE_ON)
+		return (cmd == SNDRV_PCM_TRIGGER_STOP ||
+			cmd == SNDRV_PCM_TRIGGER_SUSPEND ||
+			cmd == SNDRV_PCM_TRIGGER_PAUSE_PUSH) ? 0 : -EIO;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		msg.msg.pcmtask.param.trigger = 1;
+		WRITE_ONCE(dma->triggered, true);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		msg.msg.pcmtask.param.trigger = 0;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* atomic context: queue the message, do not wait for the firmware */
+	return abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_TRIGGER, &msg, false);
+}
+
+static snd_pcm_uframes_t abox_pcm_pointer(struct snd_soc_component *component,
+					  struct snd_pcm_substream *substream)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	size_t bytes = snd_pcm_lib_buffer_bytes(substream);
+	size_t period = snd_pcm_lib_period_bytes(substream);
+	u32 ptr = READ_ONCE(dma->pointer);
+	ssize_t pos = 0;
+	u32 status;
+
+	if (ptr >= dma->iova && ptr < dma->iova + bytes) {
+		pos = ptr - dma->iova;
+	} else {
+		/* position from the DMA status register, as downstream */
+		status = readl(abox->sfr + (dma->capture ?
+					   ABOX_WDMA_STATUS(dma->id) :
+					   ABOX_RDMA_STATUS(dma->id)));
+		if (status & ABOX_DMA_PROGRESS) {
+			ssize_t offset, count, b = bytes;
+
+			offset = FIELD_GET(ABOX_DMA_RBUF_OFFSET, status) << 4;
+			count = (period > ABOX_DMA_RBUF_CNT + 1) ? 0 :
+				FIELD_GET(ABOX_DMA_RBUF_CNT, status);
+			while ((offset % period) && b >= 0) {
+				b -= period;
+				if ((b & offset) == offset)
+					offset = b;
+			}
+			pos = offset + count;
+		}
+	}
+
+	if (pos < 0 || pos >= bytes)
+		pos = 0;
+
+	return bytes_to_frames(runtime, pos);
+}
+
+/* application pointer for the firmware, once it asked for it */
+static int abox_pcm_ack(struct snd_soc_component *component,
+			struct snd_pcm_substream *substream)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+	struct abox_dma *dma = abox_substream_dma(abox, substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct abox_ipc_msg msg = {};
+	snd_pcm_uframes_t appl_ofs;
+
+	if (!dma || !READ_ONCE(dma->ack_enabled) ||
+	    READ_ONCE(abox->state) != ABOX_STATE_ON)
+		return 0;
+
+	appl_ofs = runtime->control->appl_ptr % runtime->buffer_size;
+	msg.msg.pcmtask.param.pointer = frames_to_bytes(runtime, appl_ofs);
+
+	/* may run under the stream lock: queue only */
+	return abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_ACK, &msg, false);
+}
+
+static int abox_component_probe(struct snd_soc_component *component)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(component);
+
+	/* routing can only be written once the block is clocked */
+	if (abox->state == ABOX_STATE_ON)
+		abox_route_init(abox);
+
+	return 0;
+}
