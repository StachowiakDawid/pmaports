+/*
+ * debugfs "vss": "start" / "stop" / "reset" / "watchdog" = the modem events
+ * downstream forwards to the firmware (abox_modem_notifier): start after the
+ * CP link is up (INIT_END), stop/reset around a CP stop or crash.
+ */
+static ssize_t abox_dbg_vss_write(struct file *file, const char __user *ubuf,
+				  size_t len, loff_t *ppos)
+{
+	static const char * const cmds[] = { "start", "stop", "reset", "watchdog" };
+	struct abox *abox = file->private_data;
+	char buf[16];
+	int i, ret = -ENODEV;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+	strim(buf);
+
+	for (i = 0; i < ARRAY_SIZE(cmds); i++)
+		if (!strcmp(buf, cmds[i]))
+			break;
+	if (i == ARRAY_SIZE(cmds))
+		return -EINVAL;
+
+	mutex_lock(&abox->lock);
+	if (abox->state == ABOX_STATE_ON)
+		ret = abox_system_ipc(abox, ABOX_START_VSS + i, 0);
+	mutex_unlock(&abox->lock);
+	dev_info(abox->dev, "VSS %s: %d\n", cmds[i], ret);
+	return ret ?: len;
+}
+
+static const struct file_operations abox_dbg_vss_fops = {
+	.owner	= THIS_MODULE,
+	.open	= simple_open,
+	.write	= abox_dbg_vss_write,
+	.llseek	= noop_llseek,
+};
+
+/* debugfs "gear": tell the firmware the CA32 clock (kHz) after an ACPM change */
+static ssize_t abox_dbg_gear_write(struct file *file, const char __user *ubuf,
+				   size_t len, loff_t *ppos)
+{
+	struct abox *abox = file->private_data;
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+	u64 time = sched_clock();
+	u32 rem = do_div(time, NSEC_PER_SEC);
+	unsigned int khz;
+	int ret;
+
+	ret = kstrtouint_from_user(ubuf, len, 0, &khz);
+	if (ret)
+		return ret;
+
+	msg.msg.system.msgtype = ABOX_CHANGED_GEAR;
+	msg.msg.system.param1 = khz;
+	msg.msg.system.param2 = (s32)time;
+	msg.msg.system.param3 = rem;
+	mutex_lock(&abox->lock);
+	ret = abox->state == ABOX_STATE_ON ? abox_ipc_send(abox, &msg, true) :
+					     -ENODEV;
+	mutex_unlock(&abox->lock);
+	dev_info(abox->dev, "CHANGED_GEAR %u kHz: %d\n", khz, ret);
+	return ret ?: len;
+}
+
+static const struct file_operations abox_dbg_gear_fops = {
+	.owner	= THIS_MODULE,
+	.open	= simple_open,
+	.write	= abox_dbg_gear_write,
+	.llseek	= noop_llseek,
+};
