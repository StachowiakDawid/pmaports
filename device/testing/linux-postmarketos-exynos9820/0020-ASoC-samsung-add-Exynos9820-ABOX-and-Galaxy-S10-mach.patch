+static int abox_dma_init(struct abox *abox, struct abox_dma *dma, int id,
+			 bool capture)
+{
+	int ret;
+
+	dma->id = id;
+	dma->capture = capture;
+	dma->iova = capture ? ABOX_IOVA_WDMA(id) : ABOX_IOVA_RDMA(id);
+	init_completion(&dma->closed);
+
+	ret = snd_dma_alloc_pages(SNDRV_DMA_TYPE_DEV, abox->dev,
+				  ABOX_BUF_BYTES_MAX, &dma->dmab);
+	if (ret)
+		return ret;
+
+	ret = abox_iommu_alias(abox, dma->iova, dma->dmab.addr,
+			       ABOX_BUF_BYTES_MAX);
+	if (ret) {
+		snd_dma_free_pages(&dma->dmab);
+		return ret;
+	}
+
+	dma->mapped = true;
+	return 0;
+}
+
+static void abox_dma_free(struct abox *abox, struct abox_dma *dma)
+{
+	if (!dma->mapped)
+		return;
+
+	abox_iommu_unalias(abox, dma->iova, ABOX_BUF_BYTES_MAX);
+	snd_dma_free_pages(&dma->dmab);
+	dma->mapped = false;
+}
