From 6d6ae87ac5450d04619252c78a57a9a28e95ed08 Mon Sep 17 00:00:00 2001
From: StachowiakDawid <dawidos234@gmail.com>
Date: Mon, 23 Nov 2026 18:38:09 +0100
Subject: [PATCH] ASoC: samsung: add Exynos9820 ABOX and Galaxy S10 machine
 drivers

- exynos9820-abox: driver for the ABOX audio DSP of the Exynos 9820.
  Firmware load and boot (Calliope), IPC, RDMA/WDMA PCM front ends
  with buffers inside the firmware heap, UAIF back ends with their
  clocking, and firmware component controls. The firmware is booted
  at probe and after every system sleep; across the sleep it is
  stopped and DMA engines still enabled are quiesced. Voice calls:
  the CP's VSS and voice parameter regions are mapped for the
  firmware (vss_cp=1; zeroed stand-ins otherwise), the call streams
  use the stock formats (32 kHz, 16 bit, stereo) with ASRC, the
  downlink goes through the SIFS0 mixer to the amplifiers. debugfs:
  firmware memory, call buffers, component, VSS and gear controls.
- beyond_madera: machine driver for the Galaxy S10 family. ABOX UAIF
  links to the CS47L93 (madera) codec and to the two CS35L41 speaker
  amplifiers, the ABOX clocking, the amplifier TDM link (32-bit slots
  carrying 24-bit samples) and headset jack detection.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Signed-off-by: StachowiakDawid <dawidos234@gmail.com>
---
 sound/soc/samsung/Kconfig               |   25 +
 sound/soc/samsung/Makefile              |    4 +
 sound/soc/samsung/beyond_madera.c       |  878 +++++++
 sound/soc/samsung/exynos9820-abox-ipc.h |  197 ++
 sound/soc/samsung/exynos9820-abox.c     | 2999 +++++++++++++++++++++++
 5 files changed, 4103 insertions(+)
 create mode 100644 sound/soc/samsung/beyond_madera.c
 create mode 100644 sound/soc/samsung/exynos9820-abox-ipc.h
 create mode 100644 sound/soc/samsung/exynos9820-abox.c

diff --git a/sound/soc/samsung/Kconfig b/sound/soc/samsung/Kconfig
index ec7204f57f..65a2f42b8a 100644
--- a/sound/soc/samsung/Kconfig
+++ b/sound/soc/samsung/Kconfig
@@ -125,6 +125,31 @@ config SND_SOC_SAMSUNG_TM2_WM5110
 	help
 	  Say Y if you want to add support for SoC audio on the TM2 board.
 
+config SND_SOC_SAMSUNG_EXYNOS9820_ABOX
+	tristate "Exynos9820 ABOX audio subsystem"
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	depends on IOMMU_API && HAS_DMA
+	select MFD_SYSCON
+	help
+	  Say Y or M to support the ABOX audio block of the Exynos9820. It
+	  loads and boots the ABOX "Calliope" firmware (calliope_*.bin from
+	  the stock ROM, installed as abox/*.bin), which drives the audio
+	  DMA, and exposes the UAIF0/UAIF1 ports as ASoC CPU DAIs with PCM.
+
+config SND_SOC_SAMSUNG_BEYOND_MADERA
+	tristate "SoC audio support for Galaxy S10 (Exynos9820) with CS47L93"
+	depends on SND_SOC_SAMSUNG && MFD_MADERA && MFD_CS47L92
+	depends on I2C && SPI_MASTER
+	select SND_SOC_CS47L92
+	select SND_SOC_CS35L41_I2C
+	imply SND_SOC_SAMSUNG_EXYNOS9820_ABOX
+	help
+	  Say Y or M to add the sound card of the Samsung Galaxy S10 family
+	  (beyond0lte/beyond1lte/beyond2lte): Cirrus Logic CS47L93 codec
+	  and two CS35L40/CS35L41 amplifiers for the speaker and earpiece.
+	  Without an Exynos ABOX driver, the card binds to dummy CPU DAIs,
+	  so only codec-internal paths work.
+
 config SND_SOC_SAMSUNG_ARIES_WM8994
 	tristate "SoC I2S Audio support for WM8994 on Aries"
 	depends on SND_SOC_SAMSUNG && I2C && IIO && EXTCON
