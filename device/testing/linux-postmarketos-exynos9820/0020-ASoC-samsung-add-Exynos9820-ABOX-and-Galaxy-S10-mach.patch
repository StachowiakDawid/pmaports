+static int abox_sound_type_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+	unsigned int v = uc->value.enumerated.item[0];
+	int ret = 0;
+
+	if (v >= ARRAY_SIZE(abox_sound_type_texts))
+		return -EINVAL;
+
+	mutex_lock(&abox->lock);
+	if (abox->state == ABOX_STATE_ON)
+		ret = abox_system_ipc(abox, ABOX_SET_TYPE, v);
+	if (!ret) {
+		ret = abox->sound_type != v;
+		abox->sound_type = v;
+		dev_info(abox->dev, "sound type %s\n", abox_sound_type_texts[v]);
+	}
+	mutex_unlock(&abox->lock);
+	return ret;
+}
+
+static int abox_voice_call_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+
+	uc->value.integer.value[0] = abox->call_on;
+	return 0;
+}
+
+static int abox_voice_call_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+	bool on = !!uc->value.integer.value[0];
+	int ret = 0;
+
+	mutex_lock(&abox->lock);
+	if (on == abox->call_on)
+		goto out;
+
+	if (on) {
+		abox->call_on = true;
+		if (abox->state == ABOX_STATE_ON) {
+			ret = abox_call_start(abox);
+			if (ret)
+				abox->call_on = false;
+		}
+	} else {
+		abox->call_on = false;
+		if (abox->call_fw)
+			abox_call_stop(abox);
+	}
+	if (!ret)
+		ret = 1;
+out:
+	mutex_unlock(&abox->lock);
+	return ret;
+}
