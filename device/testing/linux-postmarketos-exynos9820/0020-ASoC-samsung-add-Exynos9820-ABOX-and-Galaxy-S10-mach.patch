+/*
+ * debugfs "component": write "<control id> <value>" to set one control of
+ * the calliope2.dt component (ids and enum texts are in that file; enum
+ * values index "None,RDMA0,...,MCD_TXSE3"). Stock mixer_paths.xml sets
+ * VPCMOUT_DAI0_EN (218) = 1, RDMA0_EN (100) = 1, RDMA0_A (101) = 41
+ * (VPCMOUT_DAI0). The firmware logs "vid: 0x0000AB0C, ctrl: ..." for each.
+ */
+static ssize_t abox_dbg_component_write(struct file *file,
+					const char __user *ubuf, size_t len,
+					loff_t *ppos)
+{
+	struct abox *abox = file->private_data;
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+	unsigned int id;
+	char buf[32];
+	int val, ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+	if (sscanf(buf, "%u %d", &id, &val) != 2)
+		return -EINVAL;
+	if (abox->state != ABOX_STATE_ON)
+		return -ENODEV;
+
+	msg.msg.system.msgtype = ABOX_UPDATE_COMPONENT_CONTROL;
+	msg.msg.system.param1 = ABOX_VOID_COMPONENT_ID;
+	msg.msg.system.param2 = id;
+	msg.msg.system.bundle.param_s32[0] = val;
+	ret = abox_ipc_send(abox, &msg, true);
+	if (ret)
+		return ret;
+
+	dev_info(abox->dev, "component control %u = %d\n", id, val);
+	return len;
+}
