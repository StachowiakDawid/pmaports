+
+static inline void abox_update(struct abox *abox, u32 reg, u32 mask, u32 val)
+{
+	u32 v = readl(abox->sfr + reg);
+
+	writel((v & ~mask) | (val & mask), abox->sfr + reg);
+}
+
+static u32 abox_get_format(unsigned int width, unsigned int channels)
+{
+	u32 ret = channels - 1;
+
+	switch (width) {
+	case 16:
+		ret |= 1 << 3;
+		break;
+	case 24:
+		ret |= 2 << 3;
+		break;
+	case 32:
+		ret |= 3 << 3;
+		break;
+	}
+
+	return ret;
+}
+
+/* ---------------------------------------------------------------------- */
+/* IPC: abox_msg queues (AP -> firmware: txq, firmware -> AP: rxq)        */
+
+static void abox_gic_sgi(struct abox *abox, unsigned int sgi)
+{
+	/* target list filter 0, CPU target 0 (CA32 core 0) */
+	writel((1 << 16) | (sgi & 0xf), abox->gicd + GICD_SGIR);
+}
+
+static bool abox_msg_data_avail(struct abox_msg_data_queue *q, s32 size)
+{
+	s32 idx_s = READ_ONCE(q->idx_s);
+	s32 blank;
+
+	if (idx_s > q->idx_e) {
+		blank = idx_s - q->idx_e;
+	} else {
+		blank = q->len - q->idx_e;
+		if (blank < size) {
+			q->idx_e = 0;
+			blank = idx_s - q->idx_e;
+		}
+	}
+
+	return blank >= size;
+}
+
+static int abox_msg_send(struct abox *abox, const struct abox_msg_cmd *cmd_in,
+			 const void *data, size_t size)
+{
+	struct abox_msg_cmd_queue *q_cmd = &abox->txq->q_cmd;
+	struct abox_msg_data_queue *q_data = &abox->txq->q_data;
+	u32 data_size = offsetof(struct abox_msg_data, data) + size;
+	struct abox_msg_cmd cmd = *cmd_in;
+	struct abox_msg_data *p_data;
+	unsigned long flags;
+	u64 start = local_clock();
+	int ret = 0;
+
+	cmd.time_put = start;
+	cmd.time_get = 0;
+
+	spin_lock_irqsave(&abox->tx_lock, flags);
+
+	while (!abox_msg_data_avail(q_data, data_size)) {
+		if (local_clock() - start > ABOX_MSG_TIMEOUT_NS) {
+			ret = -ETIMEDOUT;
+			goto unlock;
+		}
+		cpu_relax();
+	}
+
+	p_data = (struct abox_msg_data *)&q_data->elem[q_data->idx_e];
+	q_data->idx_e = (q_data->idx_e + data_size) % q_data->len;
+	memcpy(p_data->data, data, size);
+	p_data->size = size;
+
+	cmd.data_idx = (s8 *)p_data - q_data->elem;
+	cmd.send = (u64)(uintptr_t)p_data;
+
+	while (READ_ONCE(q_cmd->idx_s) ==
+	       (q_cmd->idx_e + 1) % ABOX_MSG_LEN_CMD) {
+		if (local_clock() - start > ABOX_MSG_TIMEOUT_NS) {
+			ret = -ETIMEDOUT;
+			goto unlock;
+		}
+		cpu_relax();
+	}
+
+	q_cmd->elem[q_cmd->idx_e] = cmd;
+	/* the element must be visible before the index moves */
+	mb();
+	WRITE_ONCE(q_cmd->idx_e, (q_cmd->idx_e + 1) % ABOX_MSG_LEN_CMD);
+
+unlock:
+	spin_unlock_irqrestore(&abox->tx_lock, flags);
+	return ret;
+}
+
+static int abox_msg_recv(struct abox *abox, struct abox_ipc_msg *msg)
+{
+	struct abox_msg_cmd_queue *q_cmd = &abox->rxq->q_cmd;
+	struct abox_msg_data_queue *q_data = &abox->rxq->q_data;
+	struct abox_msg_cmd *p_cmd;
+	struct abox_msg_data *p_data;
+	u32 data_size;
+	int ret;
+
+	spin_lock(&abox->rx_lock);
+
+	if (q_cmd->idx_s == READ_ONCE(q_cmd->idx_e)) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+	/* read the element only after seeing the index */
+	rmb();
+
+	p_cmd = &q_cmd->elem[q_cmd->idx_s];
+	if (p_cmd->data_idx >= q_data->len) {
+		ret = -EIO;
+		goto unlock;
+	}
+	p_data = (struct abox_msg_data *)&q_data->elem[p_cmd->data_idx];
+	p_cmd->time_get = local_clock();
+
+	memset(msg, 0, sizeof(*msg));
+	memcpy(msg, p_data->data, min_t(u32, sizeof(*msg), p_data->size));
+	ret = p_data->size;
+
+	data_size = p_data->size + offsetof(struct abox_msg_data, data);
+	q_cmd->idx_s = (q_cmd->idx_s + 1) % ABOX_MSG_LEN_CMD;
+	q_data->idx_s = (p_cmd->data_idx + data_size) % q_data->len;
+
+unlock:
+	spin_unlock(&abox->rx_lock);
+	return ret;
+}
+
+static void abox_msg_init(struct abox *abox)
+{
+	u32 hdr = offsetof(struct abox_msg_queue, q_data) +
+		  offsetof(struct abox_msg_data_queue, elem);
+
+	abox->txq = abox->dram + ABOX_IPC_TX_OFFSET;
+	abox->rxq = abox->dram + ABOX_IPC_RX_Q_OFFSET;
+	memset(abox->txq, 0, ABOX_IPC_Q_SIZE);
+	memset(abox->rxq, 0, ABOX_IPC_Q_SIZE);
+	abox->txq->q_data.len = ABOX_IPC_Q_SIZE - hdr;
+	abox->rxq->q_data.len = ABOX_IPC_Q_SIZE - hdr;
+}
+
+/*
+ * Send one message. @wait: wait (sleeping) until the firmware has taken it
+ * from the queue. With @wait false this is safe in atomic context.
+ */
+static int abox_ipc_send(struct abox *abox, struct abox_ipc_msg *msg, bool wait)
+{
+	struct abox_msg_cmd cmd = { .id = msg->ipcid };
+	struct abox_msg_cmd_queue *q_cmd = &abox->txq->q_cmd;
+	int ret;
+	s32 v;
+
+	switch (msg->ipcid) {
+	case ABOX_IPC_SYSTEM:
+		cmd.cmd = msg->msg.system.msgtype;
+		cmd.arg[0] = msg->msg.system.param1;
+		cmd.arg[1] = msg->msg.system.param2;
+		cmd.arg[2] = msg->msg.system.param3;
+		break;
+	case ABOX_IPC_PCMPLAYBACK:
+	case ABOX_IPC_PCMCAPTURE:
+		cmd.cmd = msg->msg.pcmtask.msgtype;
+		cmd.arg[0] = msg->msg.pcmtask.channel_id;
+		break;
+	case ABOX_IPC_ABOX_CONFIG:
+		cmd.cmd = msg->msg.config.msgtype;
+		cmd.arg[0] = msg->msg.config.param1;
+		cmd.arg[1] = msg->msg.config.param2;
+		break;
+	default:
+		break;
+	}
+
+	ret = abox_msg_send(abox, &cmd, msg, sizeof(*msg));
+	abox_gic_sgi(abox, ABOX_SGI_IPC);
+	if (ret) {
+		dev_err_ratelimited(abox->dev, "IPC %d/%d: queue full\n",
+				    cmd.id, cmd.cmd);
+		return ret;
+	}
+
+	if (!wait)
+		return 0;
+
+	ret = read_poll_timeout(READ_ONCE, v, v == READ_ONCE(q_cmd->idx_e),
+				100, ABOX_MSG_FLUSH_TIMEOUT_US, false,
+				q_cmd->idx_s);
+	if (ret) {
+		/* ring the doorbell once more, like downstream */
+		abox_gic_sgi(abox, ABOX_SGI_IPC);
+		ret = read_poll_timeout(READ_ONCE, v,
+					v == READ_ONCE(q_cmd->idx_e), 100,
+					ABOX_MSG_FLUSH_TIMEOUT_US, false,
+					q_cmd->idx_s);
+		if (ret)
+			dev_err_ratelimited(abox->dev,
+					    "IPC %d/%d not taken by firmware\n",
+					    cmd.id, cmd.cmd);
+	}
+
+	return ret;
+}
+
+static int abox_wait_ready(struct abox *abox)
+{
+	/*
+	 * The state is BOOTING from probe on (see abox_probe()), so a PCM
+	 * opened while the boot work still loads the firmware files waits
+	 * here instead of failing with -ENODEV.
+	 */
+	wait_event_timeout(abox->wait, abox->state != ABOX_STATE_BOOTING,
+			   msecs_to_jiffies(ABOX_READY_TIMEOUT_MS));
+
+	return abox->state == ABOX_STATE_ON ? 0 : -ENODEV;
+}
+
+static int abox_config_ipc(struct abox *abox, int type, int p1, int p2)
+{
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_ABOX_CONFIG };
+
+	msg.msg.config.msgtype = type;
+	msg.msg.config.param1 = p1;
+	msg.msg.config.param2 = p2;
+
+	return abox_ipc_send(abox, &msg, true);
+}
+
+static int abox_pcm_ipc(struct abox *abox, struct abox_dma *dma, int type,
+			struct abox_ipc_msg *msg, bool wait)
+{
+	msg->ipcid = dma->capture ? ABOX_IPC_PCMCAPTURE : ABOX_IPC_PCMPLAYBACK;
+	msg->task_id = dma->id;
+	msg->msg.pcmtask.msgtype = type;
+	msg->msg.pcmtask.channel_id = dma->id;
+
+	return abox_ipc_send(abox, msg, wait);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Incoming messages                                                      */
+
+static struct abox_dma *abox_find_dma(struct abox *abox, bool capture, int id)
+{
+	struct abox_dma *tbl = capture ? abox->wdma : abox->rdma;
+	struct abox_dma *call = capture ? &abox->call_tx : &abox->call_rx;
+	int i;
+
+	for (i = 0; i < 2; i++)
+		if (tbl[i].id == id)
+			return &tbl[i];
+	if (call->mapped && call->id == id)
+		return call;
+
+	return NULL;
+}
+
+static void abox_dma_elapsed(struct abox_dma *dma)
+{
+	struct snd_pcm_substream *ss = READ_ONCE(dma->substream);
+
+	if (ss)
+		snd_pcm_period_elapsed(ss);
+}
+
+static void abox_handle_msg(struct abox *abox, struct abox_ipc_msg *msg)
+{
+	struct abox_pcmtask_msg *pcm = &msg->msg.pcmtask;
+	struct abox_system_msg_body *sys = &msg->msg.system;
+	struct abox_dma *dma;
+
+	switch (msg->ipcid) {
+	case ABOX_IPC_SYSTEM:
+		switch (sys->msgtype) {
+		case ABOX_BOOT_DONE:
+			abox->fw_version = sys->param3;
+			abox->state = ABOX_STATE_ON;
+			wake_up_all(&abox->wait);
+			break;
+		case ABOX_REPORT_FAULT:
+			dev_err(abox->dev, "firmware fault: %d %d %d%s\n",
+				sys->param1, sys->param2, sys->param3,
+				sys->param1 == 4 ? " (vss error)" : "");
+			break;
+		case ABOX_CHANGE_GEAR:
+			/* VSS asks for the CA32 clock it needs (level, id) */
+			dev_info_ratelimited(abox->dev, "firmware asks for CPU gear %d (id %#x)\n",
+					     sys->param1, sys->param2);
+			break;
+		case ABOX_REQUEST_SYSCLK:
+			dev_info_ratelimited(abox->dev, "firmware asks for %s %d kHz (id %#x)\n",
+					     sys->param2 ? "INT" : "MIF", sys->param1,
+					     sys->param3);
+			break;
+		default:
+			dev_dbg(abox->dev, "system msg %#x (%d %d %d)\n",
+				sys->msgtype, sys->param1, sys->param2,
+				sys->param3);
+			break;
+		}
+		break;
+	case ABOX_IPC_PCMPLAYBACK:
+	case ABOX_IPC_PCMCAPTURE:
+		dma = abox_find_dma(abox, msg->ipcid == ABOX_IPC_PCMCAPTURE,
+				    pcm->channel_id);
+		if (!dma)
+			break;
+		switch (pcm->msgtype) {
+		case ABOX_PCM_PLTDAI_POINTER:
+			WRITE_ONCE(dma->pointer, pcm->param.pointer);
+			abox_dma_elapsed(dma);
+			break;
+		case ABOX_PCM_PLTDAI_ACK:
+			/* the firmware wants the application pointer */
+			WRITE_ONCE(dma->ack_enabled, !!pcm->param.trigger);
+			break;
+		case ABOX_PCM_PLTDAI_CLOSED:
+			complete(&dma->closed);
+			break;
+		default:
+			dev_dbg(abox->dev, "pcm msg %d for %cDMA%d\n",
+				pcm->msgtype, dma->capture ? 'W' : 'R',
+				dma->id);
+			break;
+		}
+		break;
+	default:
+		dev_dbg(abox->dev, "unhandled ipc %d\n", msg->ipcid);
+		break;
+	}
+}
+
+static void abox_handle_sgi(struct abox *abox, unsigned int sgi)
+{
+	struct abox_ipc_msg msg;
+	struct abox_dma *dma;
+
+	switch (sgi) {
+	case ABOX_SGI_IPC:
+		while (abox_msg_recv(abox, &msg) >= 0)
+			abox_handle_msg(abox, &msg);
+		return;
+	case ABOX_RDMA0_BUF_EMPTY ... ABOX_RDMA3_BUF_EMPTY:
+		dma = abox_find_dma(abox, false, sgi - ABOX_RDMA0_BUF_EMPTY);
+		goto dma_irq;
+	case ABOX_WDMA0_BUF_FULL ... ABOX_WDMA1_BUF_FULL:
+		dma = abox_find_dma(abox, true, sgi - ABOX_WDMA0_BUF_FULL);
+dma_irq:
+		if (dma) {
+			WRITE_ONCE(dma->pointer, 0);
+			abox_dma_elapsed(dma);
+		}
+		return;
+	default:
+		/* legacy mailbox in SRAM */
+		memcpy_fromio(&msg, abox->sram + ABOX_IPC_RX_OFFSET, sizeof(msg));
+		writel(0, abox->sram + ABOX_IPC_RX_ACK_OFFSET);
+		abox_handle_msg(abox, &msg);
+		return;
+	}
+}
+
+static irqreturn_t abox_irq(int irq, void *data)
+{
+	struct abox *abox = data;
+	irqreturn_t ret = IRQ_NONE;
+	u32 iar, id;
+	int loops;
+
+	/*
+	 * Bounded: an SPI of the ABOX GIC that stays asserted for the AP
+	 * interface must not lock up the CPU in hard IRQ context.
+	 */
+	for (loops = 0; loops < ABOX_IRQ_LOOP_MAX; loops++) {
+		iar = readl(abox->gicc + GICC_IAR);
+		id = FIELD_GET(GICC_IAR_ID, iar);
+		if (id >= 1020)
+			break;
+
+		writel(iar, abox->gicc + GICC_EOIR);
+		if (id < 16)
+			writel(iar, abox->gicc + GICC_DIR);
+
+		if (id < 16)
+			abox_handle_sgi(abox, id);
+		else
+			dev_dbg_ratelimited(abox->dev, "ABOX GIC irq %u\n", id);
+		ret = IRQ_HANDLED;
+	}
+	if (loops == ABOX_IRQ_LOOP_MAX)
+		dev_warn_ratelimited(abox->dev, "ABOX GIC interrupt storm\n");
+
+	return ret;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Memory: firmware DRAM and PCM buffers aliased at fixed IOVAs          */
+
+/*
+ * Map @size bytes of DMA-API memory (@dma, already mapped by the DMA API
+ * somewhere in the same IOMMU domain) a second time at @iova, which is
+ * what the firmware expects. The IOVA range is kept away from the DMA
+ * allocator by an iommu-addresses reserved-memory node.
+ */
+static int abox_iommu_alias(struct abox *abox, unsigned long iova,
+			    dma_addr_t dma, size_t size)
+{
+	size_t off;
+	int ret;
+
+	if (!abox->domain)
+		return 0;
+
+	for (off = 0; off < size; off += PAGE_SIZE) {
+		phys_addr_t phys = iommu_iova_to_phys(abox->domain, dma + off);
+
+		if (!phys) {
+			ret = -EFAULT;
+			goto err;
+		}
+		ret = iommu_map(abox->domain, iova + off, phys, PAGE_SIZE,
+				IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
+		if (ret)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	if (off)
+		iommu_unmap(abox->domain, iova, off);
+	dev_err(abox->dev, "IOMMU alias at %#lx failed: %d\n", iova, ret);
+	return ret;
+}
+
+static void abox_iommu_unalias(struct abox *abox, unsigned long iova,
+			       size_t size)
+{
+	if (abox->domain)
+		iommu_unmap(abox->domain, iova, size);
+}
+
+/*
+ * Downstream abox-vss probe: clear the CP magic before the CP boots, so the
+ * firmware does not take a value left in DRAM by the CP of the previous AP
+ * boot for a running VSS. Only while the CP is powered off: once EL3 has
+ * secured a running CP image the AP must not touch the carve-out (the modem
+ * loader clears the word again right before it secures the CP).
+ */
+static void abox_vss_clear_magic(struct abox *abox)
+{
+	u32 cp = 0;
+	void *m;
+
+	regmap_read(abox->pmu, PMU_CP_STATUS, &cp);
+	if (cp & BIT(0)) {
+		dev_info(abox->dev, "CP running (status %#x): VSS magic left alone\n", cp);
+		return;
+	}
+	m = memremap(ABOX_VSS_PHYS + ABOX_VSS_MAGIC_OFFSET, PAGE_SIZE,
+		     MEMREMAP_WC);
+	if (!m)
+		return;
+	dev_info(abox->dev, "VSS magic was %#x, cleared\n", readl(m));
+	writel(0, m);
+	memunmap(m);
+}
+
+static int abox_alloc_memory(struct abox *abox)
+{
+	struct device *dev = abox->dev;
+	int ret;
+
+	abox->domain = iommu_get_domain_for_dev(dev);
+	if (!abox->domain)
+		dev_warn(dev, "no IOMMU: firmware IOVAs will not work\n");
+
+	abox->dram = dmam_alloc_coherent(dev, ABOX_DRAM_SIZE, &abox->dram_dma,
+					 GFP_KERNEL);
+	if (!abox->dram)
+		return -ENOMEM;
+
+	abox->priv = dmam_alloc_coherent(dev, ABOX_PRIVATE_SIZE,
+					 &abox->priv_dma, GFP_KERNEL);
+	if (!abox->priv)
+		return -ENOMEM;
+
+	ret = abox_iommu_alias(abox, ABOX_IOVA_DRAM, abox->dram_dma,
+			       ABOX_DRAM_SIZE);
+	if (ret)
+		return ret;
+
+	ret = abox_iommu_alias(abox, ABOX_IOVA_PRIVATE, abox->priv_dma,
+			       ABOX_PRIVATE_SIZE);
+	if (ret)
+		goto err_dram;
+
+	if (vss_cp && abox->domain) {
+		/* the CP's regions themselves (reserved, no-map carve-out) */
+		ret = iommu_map(abox->domain, ABOX_IOVA_VSS, ABOX_VSS_PHYS,
+				ABOX_VSS_SIZE, IOMMU_READ | IOMMU_WRITE,
+				GFP_KERNEL);
+		if (ret)
+			goto err_priv;
+		ret = iommu_map(abox->domain, ABOX_IOVA_VSS_PARAM,
+				ABOX_VSS_PARAM_PHYS, ABOX_VSS_PARAM_SIZE,
+				IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
+		if (ret)
+			goto err_vss;
+		abox->vss_cp = true;
+		abox_vss_clear_magic(abox);
+		dev_info(dev, "VSS %#x + %#x and VSS parameters %#x + %#x of the CP mapped\n",
+			 ABOX_VSS_PHYS, ABOX_VSS_SIZE, ABOX_VSS_PARAM_PHYS,
+			 ABOX_VSS_PARAM_SIZE);
+	} else {
+		abox->vss = dmam_alloc_coherent(dev, ABOX_VSS_SIZE,
+						&abox->vss_dma, GFP_KERNEL);
+		abox->vss_param = dmam_alloc_coherent(dev, ABOX_VSS_PARAM_SIZE,
+						      &abox->vss_param_dma,
+						      GFP_KERNEL);
+		if (!abox->vss || !abox->vss_param) {
+			ret = -ENOMEM;
+			goto err_priv;
+		}
+		ret = abox_iommu_alias(abox, ABOX_IOVA_VSS, abox->vss_dma,
+				       ABOX_VSS_SIZE);
+		if (ret)
+			goto err_priv;
+		ret = abox_iommu_alias(abox, ABOX_IOVA_VSS_PARAM,
+				       abox->vss_param_dma, ABOX_VSS_PARAM_SIZE);
+		if (ret)
+			goto err_vss;
+	}
+
+	/* the firmware reads the chip ID through the SysMMU */
+	if (abox->domain) {
+		ret = iommu_map(abox->domain, ABOX_IOVA_CHIPID, ABOX_IOVA_CHIPID,
+				PAGE_SIZE, IOMMU_READ | IOMMU_MMIO,
+				GFP_KERNEL);
+		if (ret)
+			goto err_vss_param;
+	}
+
+	return 0;
+
+err_vss_param:
+	abox_iommu_unalias(abox, ABOX_IOVA_VSS_PARAM, ABOX_VSS_PARAM_SIZE);
+err_vss:
+	abox_iommu_unalias(abox, ABOX_IOVA_VSS, ABOX_VSS_SIZE);
+err_priv:
+	abox_iommu_unalias(abox, ABOX_IOVA_PRIVATE, ABOX_PRIVATE_SIZE);
+err_dram:
+	abox_iommu_unalias(abox, ABOX_IOVA_DRAM, ABOX_DRAM_SIZE);
+	return ret;
+}
+
+static void abox_free_memory(struct abox *abox)
+{
+	if (!abox->domain)
+		return;
+
+	iommu_unmap(abox->domain, ABOX_IOVA_CHIPID, PAGE_SIZE);
+	abox_iommu_unalias(abox, ABOX_IOVA_VSS_PARAM, ABOX_VSS_PARAM_SIZE);
+	abox_iommu_unalias(abox, ABOX_IOVA_VSS, ABOX_VSS_SIZE);
+	abox_iommu_unalias(abox, ABOX_IOVA_PRIVATE, ABOX_PRIVATE_SIZE);
+	abox_iommu_unalias(abox, ABOX_IOVA_DRAM, ABOX_DRAM_SIZE);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Firmware boot                                                          */
+
+static int abox_load_firmware(struct abox *abox)
+{
+	struct device *dev = abox->dev;
+	const struct firmware *fw;
+	int i, ret;
+
+	memset_io(abox->sram, 0, abox->sram_size);
+	memset(abox->dram, 0, ABOX_DRAM_SIZE);
+	if (!abox->vss_cp) {
+		/* VSS magic = 0: no voice call */
+		memset(abox->vss, 0, ABOX_VSS_SIZE);
+		memset(abox->vss_param, 0, ABOX_VSS_PARAM_SIZE);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(abox_fw_names); i++) {
+		bool sram = !(i & 1);
+		size_t off = (i < 2) ? 0 : (sram ? ABOX_SRAM_CORE1_OFFSET :
+						   ABOX_DRAM_CORE1_OFFSET);
+		size_t max = (sram ? abox->sram_size : ABOX_DRAM_SIZE) - off;
+
+		ret = request_firmware(&fw, abox_fw_names[i], dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "missing %s\n",
+					     abox_fw_names[i]);
+
+		if (fw->size > max) {
+			dev_err(dev, "%s too large (%zu)\n", abox_fw_names[i],
+				fw->size);
+			release_firmware(fw);
+			return -EFBIG;
+		}
+
+		if (sram)
+			memcpy_toio(abox->sram + off, fw->data, fw->size);
+		else
+			memcpy(abox->dram + off, fw->data, fw->size);
+
+		dev_info(dev, "loaded %s (%zu bytes) to %s+%#zx\n",
+			 abox_fw_names[i], fw->size, sram ? "SRAM" : "DRAM",
+			 off);
+		release_firmware(fw);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(abox_extra_fw); i++) {
+		if (firmware_request_nowarn(&fw, abox_extra_fw[i].name, dev))
+			continue;
+		if (abox_extra_fw[i].offset + fw->size <= ABOX_DRAM_SIZE)
+			memcpy(abox->dram + abox_extra_fw[i].offset, fw->data,
+			       fw->size);
+		dev_dbg(dev, "loaded %s\n", abox_extra_fw[i].name);
+		release_firmware(fw);
+	}
+
+	/* make sure the firmware sees all of it */
+	wmb();
+
+	return 0;
+}
+
+static void abox_gic_init(struct abox *abox)
+{
+	int i;
+
+	writel(0xff, abox->gicc + GICC_PMR);
+	writel(0x3, abox->gicd + GICD_CTRL);
+	for (i = 0; i < 4; i++)
+		writel(0, abox->gicd + GICD_IGROUP(i));
+	for (i = 0; i < 40; i++)
+		writel(0x10101010, abox->gicd + GICD_PRI(i));
+	writel(0x3, abox->gicc + GICC_CTRL);
+}
+
+static void abox_cores_power(struct abox *abox, bool on)
+{
+	if (!on) {
+		/* downstream: reset (enable = 0) only on the way down */
+		regmap_update_bits(abox->pmu, PMU_ABOX_CORE0_ENABLE, BIT(0), 0);
+		regmap_update_bits(abox->pmu, PMU_ABOX_CORE1_ENABLE, BIT(0), 0);
+	}
+	regmap_update_bits(abox->pmu, PMU_ABOX_CORE0_POWER, BIT(0),
+			   on ? BIT(0) : 0);
+	regmap_update_bits(abox->pmu, PMU_ABOX_CORE1_POWER, BIT(0),
+			   on ? BIT(0) : 0);
+}
+
+static void abox_set_clocks(struct abox *abox)
+{
+	struct device *dev = abox->dev;
+	int ret;
+
+	/* PLL_AUD0 may not be in manual mode: failure is not fatal */
+	if (abs((long)clk_get_rate(abox->clk_pll) - (long)ABOX_PLL_RATE_48K) > 100000) {
+		ret = clk_set_rate(abox->clk_pll, ABOX_PLL_RATE_48K);
+		if (ret)
+			dev_warn(dev, "PLL_AUD0 set_rate: %d\n", ret);
+	}
+
+	/*
+	 * The AUD bus divider hangs off the same mux: switching it from
+	 * OSCCLK to the 1.18 GHz PLL is only safe with a sane BUS divider,
+	 * so it is not switched here, only reported.
+	 */
+	if (abox->clk_pll_mux && !clk_is_match(clk_get_parent(abox->clk_pll_mux),
+					       abox->clk_pll))
+		dev_warn(dev, "AUD PLL mux is on OSCCLK: audio clocks will be wrong\n");
+
+	/*
+	 * PLL_AUD0 / 16 is 73728002.5 Hz, a hair above the nominal rate, and
+	 * the divider rounds down: ask with 1 ppm of headroom or we get /17
+	 * (69.4 MHz) and every BCLK is 1.8 % slow.
+	 */
+	ret = clk_set_rate(abox->clk_audif,
+			   ABOX_AUDIF_RATE_48K + ABOX_AUDIF_RATE_48K / 1000000);
+	if (ret)
+		dev_warn(dev, "AUDIF set_rate: %d\n", ret);
+
+	dev_info(dev, "PLL_AUD0 %lu Hz, AUDIF %lu Hz, ACLK %lu Hz, CA32 %lu Hz\n",
+		 clk_get_rate(abox->clk_pll), clk_get_rate(abox->clk_audif),
+		 clk_get_rate(abox->clks[0].clk),
+		 clk_get_rate(abox->clks[1].clk));
+}
+
+static void abox_send_resume(struct abox *abox)
+{
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+	u64 atime;
+
+	atime = readq_relaxed(abox->timer + ABOX_TIMER1_CURVAL);
+	/* 26 MHz ticks to ns */
+	atime = div_u64(atime * 500, ABOX_TIMER_RATE / 2000000);
+
+	msg.msg.system.msgtype = ABOX_RESUME;
+	msg.msg.system.bundle.param_u64[0] = sched_clock();
+	msg.msg.system.bundle.param_u64[1] = atime;
+	abox_ipc_send(abox, &msg, true);
+}
+
+/* downstream tells the firmware the CA32 clock after every DVFS change */
+static void abox_send_gear(struct abox *abox)
+{
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+	u64 time = sched_clock();
+	u32 rem = do_div(time, NSEC_PER_SEC);
+
+	msg.msg.system.msgtype = ABOX_CHANGED_GEAR;
+	msg.msg.system.param1 = clk_get_rate(abox->clks[1].clk) / 1000;
+	msg.msg.system.param2 = (s32)time;
+	msg.msg.system.param3 = rem;
+	abox_ipc_send(abox, &msg, true);
+}
+
+static int abox_start(struct abox *abox)
+{
+	struct device *dev = abox->dev;
+	u32 val;
+	int ret;
+
+	abox_set_clocks(abox);
+
+	regmap_update_bits(abox->pmu, PMU_ABOX_PAD_NORMAL,
+			   PMU_ABOX_PAD_NORMAL_MASK, PMU_ABOX_PAD_NORMAL_MASK);
+	writel(0x1, abox->sysreg + ABOX_SYSREG_MISC_CON);
+
+	abox_gic_init(abox);
+
+	ret = abox_load_firmware(abox);
+	if (ret)
+		return ret;
+
+	abox_msg_init(abox);
+
+	/* DRAM access request */
+	writel(0x1, abox->sfr + ABOX_SYSPOWER_CTRL);
+	ret = readl_poll_timeout(abox->sfr + ABOX_SYSPOWER_STATUS, val,
+				 val & 0x1, 10, 10000);
+	if (ret)
+		dev_warn(dev, "SYSPOWER_STATUS stuck at %#x\n", val);
+
+	abox->state = ABOX_STATE_BOOTING;
+	abox_cores_power(abox, true);
+
+	wait_event_timeout(abox->wait, abox->state != ABOX_STATE_BOOTING,
+			   msecs_to_jiffies(ABOX_BOOT_TIMEOUT_MS));
+	if (abox->state != ABOX_STATE_ON) {
+		dev_err(dev, "firmware did not boot (PC0 %#x PC1 %#x)\n",
+			readl(abox->sfr + 0x5000 + 31 * 4),
+			readl(abox->sfr + 0x5080 + 31 * 4));
+		abox_cores_power(abox, false);
+		writel(0, abox->sfr + ABOX_SYSPOWER_CTRL);
+		abox->state = ABOX_STATE_FAILED;
+		wake_up_all(&abox->wait);
+		return -ETIMEDOUT;
+	}
+
+	dev_info(dev, "Calliope firmware running, version %c%c%c%c\n",
+		 (abox->fw_version >> 24) & 0xff,
+		 (abox->fw_version >> 16) & 0xff,
+		 (abox->fw_version >> 8) & 0xff, abox->fw_version & 0xff);
+
+	abox_send_resume(abox);
+	abox_send_gear(abox);
+
+	return 0;
+}
+
+static void abox_stop(struct abox *abox)
+{
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+
+	if (abox->state == ABOX_STATE_ON) {
+		msg.msg.system.msgtype = ABOX_SUSPEND;
+		abox_ipc_send(abox, &msg, true);
+		msleep(20);
+	}
+	if (abox->state != ABOX_STATE_OFF) {
+		abox_cores_power(abox, false);
+		writel(0, abox->sfr + ABOX_SYSPOWER_CTRL);
+	}
+	abox->state = ABOX_STATE_OFF;
+	wake_up_all(&abox->wait);
+}
+
+static void abox_restore_state(struct abox *abox);
+static void abox_call_restore(struct abox *abox);
+
+static void abox_boot_work(struct work_struct *work)
+{
+	struct abox *abox = container_of(work, struct abox, boot_work);
+
+	mutex_lock(&abox->lock);
+	if (abox_start(abox)) {
+		abox->state = ABOX_STATE_FAILED;
+		wake_up_all(&abox->wait);
+	} else if (abox->restore) {
+		abox_restore_state(abox);
+		abox_call_restore(abox);
+	}
+	abox->restore = false;
+	mutex_unlock(&abox->lock);
+}
+
+/* ---------------------------------------------------------------------- */
+/* UAIF DAIs                                                              */
+
+static void abox_call_route(struct abox *abox, bool on);
+
+static void abox_route_init(struct abox *abox)
+{
+	u32 spus_out[2] = { ABOX_SPUS_OUT_SIFS0, ABOX_SPUS_OUT_SIFS1 };
+	int i;
+
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		struct abox_uaif *u = &abox->uaif[i];
+
+		if (u->rdma >= 0) {
+			/* RDMA -> SPUS (no ASRC) -> SIFSx */
+			abox_update(abox, ABOX_SPUS_CTRL0,
+				    ABOX_SPUS_RDMA_MASK(u->rdma),
+				    (spus_out[u->sifs] << 1) << (5 * u->rdma));
+			if (u->sifs > 0)
+				abox_update(abox, ABOX_SPUS_CTRL1,
+					    ABOX_SIFS_OUT_SEL_MASK(u->sifs),
+					    u->rdma << (8 + 4 * u->sifs));
+			abox_update(abox, ABOX_ROUTE_CTRL0,
+				    ABOX_ROUTE_UAIF_SPK(i),
+				    ABOX_ROUTE_SRC_SIFS(u->sifs) << (4 * i));
+			writel(0, abox->sfr + ABOX_SPUS_CTRL_SIFS_CNT(u->sifs));
+		}
+		if (u->wdma >= 0) {
+			/* UAIF -> NSRCn (no ASRC) -> SIFMn -> WDMA(n + 1) */
+			abox_update(abox, ABOX_ROUTE_CTRL1,
+				    ABOX_ROUTE_NSRC(u->nsrc),
+				    ABOX_ROUTE_SRC_UAIF(i) << (4 * u->nsrc));
+			abox_update(abox, ABOX_SPUM_CTRL0,
+				    ABOX_SPUM_NSRC_MASK(u->nsrc), 0);
+		}
+	}
+
+	if (abox->call_on)
+		abox_call_route(abox, true);
+}
+
+static int abox_uaif_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct abox *abox = snd_soc_dai_get_drvdata(dai);
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+	case SND_SOC_DAIFMT_DSP_A:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	abox->uaif[dai->id].fmt = fmt;
+	return 0;
+}
+
+static int abox_uaif_set_tdm_slot(struct snd_soc_dai *dai,
+				  unsigned int tx_mask, unsigned int rx_mask,
+				  int slots, int slot_width)
+{
+	struct abox *abox = snd_soc_dai_get_drvdata(dai);
+
+	if (slots > 8 || (slot_width && slot_width != 16 &&
+			  slot_width != 24 && slot_width != 32))
+		return -EINVAL;
+
+	abox->uaif[dai->id].slots = slots;
+	abox->uaif[dai->id].slot_width = slot_width;
+	return 0;
+}
+
+static int abox_uaif_startup(struct snd_pcm_substream *substream,
+			     struct snd_soc_dai *dai)
+{
+	struct abox *abox = snd_soc_dai_get_drvdata(dai);
+	int ret;
+
+	ret = abox_wait_ready(abox);
+	if (ret) {
+		dev_err(abox->dev, "ABOX firmware not running\n");
+		return ret;
+	}
+
+	if (snd_soc_dai_active(dai))
+		return 0;
+
+	ret = clk_prepare_enable(abox->uaif[dai->id].bclk);
+	if (ret)
+		return ret;
+
+	/* keep BCLK running while the port is used (no Q-channel gating) */
+	abox_update(abox, ABOX_QCHANNEL_DISABLE, ABOX_QCH_BCLK_UAIF(dai->id),
+		    ABOX_QCH_BCLK_UAIF(dai->id));
+
+	return 0;
+}
+
+static void abox_uaif_shutdown(struct snd_pcm_substream *substream,
+			       struct snd_soc_dai *dai)
+{
+	struct abox *abox = snd_soc_dai_get_drvdata(dai);
+	int id = dai->id;
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		/* let the UAIF FIFO drain */
+		usleep_range(600, 1200);
+		abox_update(abox, ABOX_UAIF_CTRL0(id), ABOX_UAIF_SPK_ENABLE, 0);
+	} else {
+		abox_update(abox, ABOX_UAIF_CTRL0(id), ABOX_UAIF_MIC_ENABLE, 0);
+	}
+
+	/* the closing stream is already deactivated here */
+	if (snd_soc_dai_active(dai))
+		return;
+
+	abox_update(abox, ABOX_QCHANNEL_DISABLE, ABOX_QCH_BCLK_UAIF(id), 0);
+	clk_disable_unprepare(abox->uaif[id].bclk);
+}
+
+/* tell the firmware the format at the mixer/mux in front of the port */
+static void abox_uaif_send_cfg(struct abox *abox, struct abox_uaif *u,
+			       int stream)
+{
+	const struct abox_uaif_cfg *c = &u->cfg[stream];
+
+	if (!c->valid)
+		return;
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		abox_config_ipc(abox, ABOX_SET_SIFS0_RATE + u->sifs, c->rate, 0);
+		abox_config_ipc(abox, ABOX_SET_SIFS0_FORMAT + u->sifs,
+				c->fmt_p1, c->fmt_p2);
+	} else {
+		abox_config_ipc(abox, ABOX_SET_SIFM0_RATE + u->nsrc, c->rate, 0);
+		abox_config_ipc(abox, ABOX_SET_SIFM0_FORMAT + u->nsrc,
+				c->fmt_p1, c->fmt_p2);
+	}
+}
+
+static int abox_uaif_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params,
+			       struct snd_soc_dai *dai)
+{
+	struct abox *abox = snd_soc_dai_get_drvdata(dai);
+	struct abox_uaif *u = &abox->uaif[dai->id];
+	unsigned int rate = params_rate(params);
+	unsigned int width = params_width(params);
+	unsigned int channels = params_channels(params);
+	unsigned int slots, slot_width;
+	unsigned long bclk;
+	u32 ctrl0, ctrl1;
+	int ret;
+
+	/* TDM: the port runs with the fixed slot layout of the link */
+	slots = u->slots ?: channels;
+	slot_width = u->slot_width ?: width;
+	if (slots < channels)
+		return -EINVAL;
+
+	bclk = rate * slots * slot_width;
+	/* same rounding as AUDIF: allow 10 ppm above the nominal BCLK */
+	ret = clk_set_rate(u->bclk, bclk + bclk / 100000);
+	if (ret) {
+		dev_err(abox->dev, "UAIF%d: BCLK %lu Hz: %d\n", dai->id, bclk,
+			ret);
+		return ret;
+	}
+	if (abs((long)clk_get_rate(u->bclk) - (long)bclk) > bclk / 10000)
+		dev_warn(abox->dev, "UAIF%d: BCLK %lu Hz instead of %lu\n",
+			 dai->id, clk_get_rate(u->bclk), bclk);
+
+	ctrl0 = readl(abox->sfr + ABOX_UAIF_CTRL0(dai->id));
+	ctrl1 = readl(abox->sfr + ABOX_UAIF_CTRL1(dai->id));
+
+	ctrl1 &= ~(ABOX_UAIF_WS_MODE | ABOX_UAIF_BCLK_POLARITY |
+		   ABOX_UAIF_WS_POLAR);
+	if ((u->fmt & SND_SOC_DAIFMT_FORMAT_MASK) == SND_SOC_DAIFMT_DSP_A)
+		ctrl1 |= ABOX_UAIF_WS_MODE;
+
+	switch (u->fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		ctrl1 |= ABOX_UAIF_BCLK_POLARITY;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		ctrl1 |= ABOX_UAIF_BCLK_POLARITY | ABOX_UAIF_WS_POLAR;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		ctrl1 |= ABOX_UAIF_WS_POLAR;
+		break;
+	}
+
+	/*
+	 * u->fmt is the CPU-side format: snd_soc_runtime_set_dai_fmt() flips
+	 * the provider bits of the link format for the CPU DAI, so a link
+	 * with a consumer codec (CBC_CFC) arrives here as BP_FP. The ABOX is
+	 * the BCLK/WS provider unless it was explicitly made a consumer.
+	 */
+	if ((u->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) ==
+	    SND_SOC_DAIFMT_BC_FC)
+		ctrl0 &= ~ABOX_UAIF_MODE;
+	else
+		ctrl0 |= ABOX_UAIF_MODE;
+
+	ctrl1 &= ~(ABOX_UAIF_SBIT_MAX | ABOX_UAIF_VALID_STR |
+		   ABOX_UAIF_VALID_END | ABOX_UAIF_SLOT_MAX | ABOX_UAIF_FORMAT);
+	ctrl1 |= FIELD_PREP(ABOX_UAIF_SBIT_MAX, slot_width - 1);
+	if ((u->fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S)
+		ctrl1 |= FIELD_PREP(ABOX_UAIF_VALID_STR, slot_width - 1) |
+			 FIELD_PREP(ABOX_UAIF_VALID_END, slot_width - 1);
+	ctrl1 |= FIELD_PREP(ABOX_UAIF_SLOT_MAX, slots - 1);
+	ctrl1 |= FIELD_PREP(ABOX_UAIF_FORMAT,
+			    abox_get_format(slot_width, slots));
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		ctrl0 |= ABOX_UAIF_DATA_MODE;
+		ctrl0 &= ~ABOX_UAIF_IRQ_MODE;
+	}
+
+	writel(ctrl0, abox->sfr + ABOX_UAIF_CTRL0(dai->id));
+	writel(ctrl1, abox->sfr + ABOX_UAIF_CTRL1(dai->id));
+
+	abox_route_init(abox);
+
+	/* tell the firmware the format at the mixer/mux in front of the port */
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		int sifs = u->sifs;
+
+		if (sifs == 0)
+			abox_update(abox, ABOX_SPUS_CTRL1, ABOX_MIXP_FORMAT_MASK,
+				    abox_get_format(slot_width, slots));
+		writel(0, abox->sfr + ABOX_SPUS_CTRL_SIFS_CNT(sifs));
+		u->cfg[0] = (struct abox_uaif_cfg) {
+			.valid = true, .rate = rate,
+			.fmt_p1 = slot_width, .fmt_p2 = slots,
+		};
+	} else {
+		u->cfg[1] = (struct abox_uaif_cfg) {
+			.valid = true, .rate = rate,
+			.fmt_p1 = width, .fmt_p2 = channels,
+		};
+	}
+	abox_uaif_send_cfg(abox, u, substream->stream);
+
+	dev_dbg(abox->dev, "UAIF%d %s: %u Hz %u x %u bit, BCLK %lu, ctrl %#x %#x\n",
+		dai->id, substream->stream ? "capture" : "playback", rate,
+		slots, slot_width, clk_get_rate(u->bclk), ctrl0, ctrl1);
+
+	return 0;
+}
+
+static int abox_uaif_trigger(struct snd_pcm_substream *substream, int cmd,
+			     struct snd_soc_dai *dai)
+{
+	struct abox *abox = snd_soc_dai_get_drvdata(dai);
+	bool capture = substream->stream == SNDRV_PCM_STREAM_CAPTURE;
+	u32 mask = capture ? ABOX_UAIF_MIC_ENABLE : ABOX_UAIF_SPK_ENABLE;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		abox_update(abox, ABOX_UAIF_CTRL0(dai->id), mask, mask);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		/* playback: stopped in shutdown, after the FIFO drained */
+		if (capture)
+			abox_update(abox, ABOX_UAIF_CTRL0(dai->id), mask, 0);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
