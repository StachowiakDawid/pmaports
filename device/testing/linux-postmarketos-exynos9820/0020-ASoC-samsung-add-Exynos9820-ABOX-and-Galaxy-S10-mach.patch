+/* firmware rebooted (resume): mode, type and call channels again */
+static void abox_call_restore(struct abox *abox)
+{
+	if (abox->audio_mode)
+		abox_system_ipc(abox, ABOX_SET_MODE, abox->audio_mode);
+	if (abox->sound_type)
+		abox_system_ipc(abox, ABOX_SET_TYPE, abox->sound_type);
+	if (abox->call_on && abox_call_start(abox))
+		abox->call_on = false;
+}
