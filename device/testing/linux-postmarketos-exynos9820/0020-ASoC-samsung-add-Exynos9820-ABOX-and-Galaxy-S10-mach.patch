+
+/* ---------------------------------------------------------------------- */
+/* CP voice call (VSS on the ABOX)                                        */
+
+/*
+ * The VSS code of the CP image runs on the ABOX and exchanges speech frames
+ * with the CP through the VSS shared memory. It plays the downlink into the
+ * "call" RDMA4 and takes the uplink from the "call" WDMA2; the AP never
+ * touches the samples. Stock opens both as hostless PCMs (HAL
+ * proxy_start_voice_call: no data written or read). Here the "ABOX Voice
+ * Call" switch does the same firmware sequence without an ALSA PCM, and
+ * routes:
+ *   RDMA4 -> SPUS (no ASRC) -> SIFS1 (replacing RDMA1) -> UAIF1 -> amps
+ *   UAIF0 -> NSRC1 (bridged with the mic NSRC0) -> SIFM1 -> WDMA2
+ * UAIF0 capture and UAIF1 playback must be running (user space keeps a
+ * silent stream on the earpiece/speaker and a mic stream open).
+ */
+static void abox_call_route(struct abox *abox, bool on)
+{
+	int rdma = ABOX_CALL_RDMA, nsrc = ABOX_CALL_NSRC;
+	u32 bridge = ABOX_ROUTE_NSRC_BRIDGE(0) | ABOX_ROUTE_NSRC_BRIDGE(nsrc);
+	u32 out = ABOX_SPUS_OUT_SIFS0;
+	const struct abox_uaif_cfg *amp = &abox->uaif[1].cfg[SNDRV_PCM_STREAM_PLAYBACK];
+	bool rx_asrc = ABOX_CALL_RX_RATE != 48000;
+	bool tx_asrc = ABOX_CALL_TX_RATE != 48000;
+
+	if (on) {
+		abox_update(abox, ABOX_SPUS_CTRL0, ABOX_SPUS_RDMA_MASK(rdma),
+			    ((out << 1) | rx_asrc) << (5 * rdma));
+		/* the mixer runs in the amplifier TDM format, UAIF1 plays it */
+		abox_update(abox, ABOX_SPUS_CTRL1, ABOX_MIXP_FORMAT_MASK,
+			    abox_get_format(amp->valid ? amp->fmt_p1 : 32,
+					    amp->valid ? amp->fmt_p2 : 4));
+		abox_update(abox, ABOX_ROUTE_CTRL0, ABOX_ROUTE_UAIF_SPK(1),
+			    ABOX_ROUTE_SRC_SIFS(0) << 4);
+		abox_update(abox, ABOX_ROUTE_CTRL1, ABOX_ROUTE_NSRC(nsrc),
+			    ABOX_ROUTE_SRC_UAIF(0) << (4 * nsrc));
+		abox_update(abox, ABOX_SPUM_CTRL0, ABOX_SPUM_NSRC_MASK(nsrc),
+			    (u32)tx_asrc << (4 + 4 * nsrc));
+		abox_update(abox, ABOX_ROUTE_CTRL2, bridge, bridge);
+	} else {
+		abox_update(abox, ABOX_SPUS_CTRL0, ABOX_SPUS_RDMA_MASK(rdma), 0);
+		abox_update(abox, ABOX_SPUS_CTRL1, ABOX_SIFS_OUT_SEL_MASK(1),
+			    abox->uaif[1].rdma << (8 + 4));
+		abox_update(abox, ABOX_ROUTE_CTRL0, ABOX_ROUTE_UAIF_SPK(1),
+			    ABOX_ROUTE_SRC_SIFS(abox->uaif[1].sifs) << 4);
+		abox_update(abox, ABOX_ROUTE_CTRL1, ABOX_ROUTE_NSRC(nsrc), 0);
+		abox_update(abox, ABOX_SPUM_CTRL0, ABOX_SPUM_NSRC_MASK(nsrc), 0);
+		abox_update(abox, ABOX_ROUTE_CTRL2, bridge, 0);
+	}
+}
+
+static int abox_system_ipc(struct abox *abox, int type, int p1)
+{
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+
+	msg.msg.system.msgtype = type;
+	msg.msg.system.param1 = p1;
+	return abox_ipc_send(abox, &msg, true);
+}
+
+static int abox_call_dma_start(struct abox *abox, struct abox_dma *dma,
+			       int rate, int width, int channels)
+{
+	struct abox_ipc_msg msg = {};
+	u32 bytes = ABOX_CALL_PERIOD_FRAMES * channels * (width / 8);
+	int ret;
+
+	if (!dma->mapped)
+		return -ENODEV;
+	if (!bytes || bytes * ABOX_CALL_PERIODS > ABOX_BUF_BYTES_MAX)
+		return -EINVAL;
+
+	abox_dma_wait_idle(abox, dma, "before call start");
+	memset(dma->dmab.area, 0, ABOX_BUF_BYTES_MAX);
+
+	ret = abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_OPEN, &msg, true);
+	if (ret)
+		return ret;
+	dma->fw_open = true;
+
+	dma->period_bytes = bytes;
+	dma->periods = ABOX_CALL_PERIODS;
+	dma->rate = rate;
+	dma->width = width;
+	dma->channels = channels;
+	ret = abox_pcm_send_hw(abox, dma);
+	if (ret)
+		return ret;
+	dma->fw_hw = true;
+
+	WRITE_ONCE(dma->pointer, dma->iova);
+	memset(&msg, 0, sizeof(msg));
+	ret = abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_PREPARE, &msg, true);
+	if (ret)
+		return ret;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.msg.pcmtask.param.trigger = 1;
+	WRITE_ONCE(dma->triggered, true);
+	ret = abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_TRIGGER, &msg, true);
+	if (ret)
+		return ret;
+
+	dev_info(abox->dev, "call %cDMA%d started: %d Hz, %d bit, %d ch, %u x %u bytes\n",
+		 dma->capture ? 'W' : 'R', dma->id, rate, width, channels,
+		 dma->periods, dma->period_bytes);
+	return 0;
+}
+
+static void abox_call_dma_stop(struct abox *abox, struct abox_dma *dma)
+{
+	struct abox_ipc_msg msg = {};
+
+	if (!dma->fw_open)
+		return;
+
+	if (READ_ONCE(dma->triggered)) {
+		abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_TRIGGER, &msg, true);
+		WRITE_ONCE(dma->triggered, false);
+	}
+	if (dma->fw_hw) {
+		memset(&msg, 0, sizeof(msg));
+		abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_HW_FREE, &msg, true);
+		dma->fw_hw = false;
+	}
+	memset(&msg, 0, sizeof(msg));
+	reinit_completion(&dma->closed);
+	if (!abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_CLOSE, &msg, true) &&
+	    !wait_for_completion_timeout(&dma->closed,
+					 msecs_to_jiffies(ABOX_DMA_TIMEOUT_MS)))
+		dev_warn(abox->dev, "call %cDMA%d: no PLTDAI_CLOSED from firmware\n",
+			 dma->capture ? 'W' : 'R', dma->id);
+	dma->fw_open = false;
+	abox_dma_wait_idle(abox, dma, "after call CLOSE");
+	dev_info(abox->dev, "call %cDMA%d stopped\n", dma->capture ? 'W' : 'R',
+		 dma->id);
+}
+
+static void abox_call_stop(struct abox *abox)
+{
+	const struct abox_uaif_cfg *c = &abox->uaif[0].cfg[SNDRV_PCM_STREAM_PLAYBACK];
+
+	abox_call_dma_stop(abox, &abox->call_tx);
+	abox_call_dma_stop(abox, &abox->call_rx);
+	abox_call_route(abox, false);
+
+	/* SIFS0 back to the UAIF0 (codec) format */
+	if (c->valid)
+		abox_update(abox, ABOX_SPUS_CTRL1, ABOX_MIXP_FORMAT_MASK,
+			    abox_get_format(c->fmt_p1, c->fmt_p2));
+	abox_uaif_send_cfg(abox, &abox->uaif[0], SNDRV_PCM_STREAM_PLAYBACK);
+	abox->call_fw = false;
+}
+
+/* with abox->lock held and the firmware running */
+static int abox_call_start(struct abox *abox)
+{
+	const struct abox_uaif_cfg *mic = &abox->uaif[0].cfg[SNDRV_PCM_STREAM_CAPTURE];
+	const struct abox_uaif_cfg *amp = &abox->uaif[1].cfg[SNDRV_PCM_STREAM_PLAYBACK];
+	int nsrc = ABOX_CALL_NSRC;
+	int ret;
+
+	if (abox->state != ABOX_STATE_ON)
+		return -ENODEV;
+
+	abox_call_route(abox, true);
+	/* SRAM banks in front of the DMAs (10 ms periods), RDMA burst 8 */
+	abox_update(abox, ABOX_SPUS_SBANK_RDMA(ABOX_CALL_RDMA),
+		    ABOX_SBANK_SIZE_MASK,
+		    FIELD_PREP(ABOX_SBANK_SIZE_MASK, SZ_128 / 16));
+	abox_update(abox, ABOX_SPUM_SBANK_NSRC(nsrc), ABOX_SBANK_SIZE_MASK,
+		    FIELD_PREP(ABOX_SBANK_SIZE_MASK, SZ_128 / 16));
+	abox_update(abox, ABOX_RDMA_CTRL0(ABOX_CALL_RDMA), ABOX_RDMA_BURST_LEN,
+		    FIELD_PREP(ABOX_RDMA_BURST_LEN, 8));
+
+	/* the SIFM in front of WDMA2 carries the UAIF0 mic data (48 kHz) */
+	abox_config_ipc(abox, ABOX_SET_SIFM0_RATE + nsrc,
+			mic->valid ? mic->rate : 48000, 0);
+	abox_config_ipc(abox, ABOX_SET_SIFM0_FORMAT + nsrc,
+			mic->valid ? mic->fmt_p1 : 32, mic->valid ? mic->fmt_p2 : 2);
+	abox_config_ipc(abox, ABOX_SET_SIFS0_RATE,
+			amp->valid ? amp->rate : 48000, 0);
+	abox_config_ipc(abox, ABOX_SET_SIFS0_FORMAT,
+			amp->valid ? amp->fmt_p1 : 32,
+			amp->valid ? amp->fmt_p2 : 4);
+
+	abox->call_fw = true;
+	ret = abox_call_dma_start(abox, &abox->call_rx, ABOX_CALL_RX_RATE,
+				  ABOX_CALL_RX_WIDTH, ABOX_CALL_RX_CHANNELS);
+	if (!ret)
+		ret = abox_call_dma_start(abox, &abox->call_tx, ABOX_CALL_TX_RATE,
+					  ABOX_CALL_TX_WIDTH, ABOX_CALL_TX_CHANNELS);
+	if (ret) {
+		dev_err(abox->dev, "voice call start failed: %d\n", ret);
+		abox_call_stop(abox);
+		return ret;
+	}
+
+	dev_info(abox->dev, "voice call path on (SPUS %#x/%#x ROUTE %#x/%#x/%#x SPUM %#x)\n",
+		 readl(abox->sfr + ABOX_SPUS_CTRL0),
+		 readl(abox->sfr + ABOX_SPUS_CTRL1),
+		 readl(abox->sfr + ABOX_ROUTE_CTRL0),
+		 readl(abox->sfr + ABOX_ROUTE_CTRL1),
+		 readl(abox->sfr + ABOX_ROUTE_CTRL2),
+		 readl(abox->sfr + ABOX_SPUM_CTRL0));
+	return 0;
+}
