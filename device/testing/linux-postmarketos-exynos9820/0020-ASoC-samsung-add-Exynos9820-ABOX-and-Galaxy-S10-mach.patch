diff --git a/sound/soc/samsung/beyond_madera.c b/sound/soc/samsung/beyond_madera.c
new file mode 100644
index 0000000000..2b7022fad2
--- /dev/null
+++ b/sound/soc/samsung/beyond_madera.c
@@ -0,0 +1,878 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Machine driver for the Samsung Galaxy S10 family (Exynos9820 "beyond"):
+ * Cirrus Logic CS47L93 codec on SPI plus two CS35L40/CS35L41 amplifiers on
+ * I2C (bottom speaker and earpiece).
+ *
+ * On these phones every PCM path from the AP goes through the Exynos ABOX
+ * audio subsystem (UAIF0 -> codec AIF1, UAIF1 -> amplifiers, UAIF2 -> codec
+ * AIF3). There is no mainline ABOX driver yet. The CPU side of the links is
+ * therefore optional. If "samsung,uaif-controllers" is missing, the links
+ * are bound to the ASoC dummy CPU/platform. The card still registers, and
+ * the codec and amplifier controls work. Codec-internal paths such as tone
+ * generator -> HPOUT2 (headphones) or analogue mic -> HPOUT2 can be tested
+ * that way, without any PCM data from the AP.
+ *
+ * Clocking mirrors the downstream beyond_madera.c: MCLK1 = 26 MHz CLKOUT0
+ * from the PMU, FLL1 locks to it and gives SYSCLK = 98.304 MHz. With the
+ * ABOX as CPU DAI (it is the BCLK/LRCLK provider, clocked from its own
+ * audio PLL), AIF1 and the outputs run on ASYNCCLK = 98.304 MHz from FLL2,
+ * which locks to AIF1BCLK, exactly like downstream.
+ *
+ * Jack detection uses the codec accessory detect block the way the
+ * downstream extcon-madera driver is configured on these phones
+ * (JD1+JD2 through the MICD clamp, MICDET ADC on MICBIAS2A), reduced to
+ * insert/remove plus headset microphone detection. No HP impedance
+ * measurement, no moisture detection, no buttons.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/irqchip/irq-madera.h>
+#include <linux/mfd/madera/core.h>
+#include <linux/mfd/madera/registers.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/cs35l41.h>
+#include <sound/jack.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/soc-dapm.h>
+
+#include "../codecs/madera.h"
+
+#define BEYOND_MCLK1_RATE		26000000
+#define BEYOND_SYSCLK_RATE		98304000
+#define BEYOND_DSPCLK_RATE		147456000
+#define BEYOND_AMP_BCLK_RATIO_DEFAULT	128	/* 4 slots x 32 bit */
+#define BEYOND_MAX_AMPS			2
+#define BEYOND_AMP_SLOTS		4
+#define BEYOND_AMP_SLOT_WIDTH		32
+
+/* accessory detect, values from the downstream DT (acc@1, HPOUT2) */
+#define BEYOND_MICD_CLAMP_MODE		0x8	/* JD1 and JD2 low = removed */
+#define BEYOND_MICD_BIAS_STARTTIME	0x1
+#define BEYOND_MICD_RATE		0x7
+#define BEYOND_MICD_BIAS_SRC		0x4	/* MICBIAS2A */
+#define BEYOND_MICD_SENSE		0x0
+#define BEYOND_MICD_GND			0x1
+#define BEYOND_HP_GND			0x1
+#define BEYOND_MICD_DEBOUNCE_MS		300
+#define BEYOND_MICD_TIMEOUT_MS		1000
+#define BEYOND_MIC_MIN_OHM		1258
+
+/* MICDET ADC code -> ohms (downstream madera_micd_levels) */
+static const int beyond_micd_levels[] = {
+	3, 6, 8, 11, 13, 16, 18, 21, 23, 26, 28, 31, 34, 36, 39, 41, 44, 46,
+	49, 52, 54, 57, 60, 62, 65, 67, 70, 73, 75, 78, 81, 83, 89, 94, 100,
+	105, 111, 116, 122, 127, 139, 150, 161, 173, 186, 196, 209, 220, 245,
+	270, 295, 321, 348, 375, 402, 430, 489, 550, 614, 681, 752, 903, 1071,
+	1257, 30000,
+};
+
+enum {
+	BEYOND_LINK_CODEC = 0,	/* UAIF0 <-> CS47L93 AIF1 */
+	BEYOND_LINK_AMPS,	/* UAIF1 <-> CS35L4x ASP */
+	BEYOND_NUM_LINKS,
+};
+
+struct beyond_priv {
+	struct device *dev;
+	struct clk *mclk;
+	struct snd_soc_component *codec;
+	unsigned int mclk_rate;
+	unsigned int amp_bclk_ratio;
+	unsigned int amp_rx_slot[BEYOND_MAX_AMPS];
+	int num_amps;
+
+	/* real ABOX CPU DAIs instead of the dummy */
+	bool abox;
+	unsigned int aif1_bclk;
+
+	/* jack detection */
+	struct madera *madera;
+	struct snd_soc_jack jack;
+	struct mutex jack_lock;
+	struct delayed_work micd_work;
+	struct delayed_work micd_timeout;
+	bool jack_present;
+	bool micd_running;
+	bool jack_irqs;
+};
+
+static struct snd_soc_jack_pin beyond_jack_pins[] = {
+	{ .pin = "HEADPHONE",	.mask = SND_JACK_HEADPHONE },
+	{ .pin = "HEADSETMIC",	.mask = SND_JACK_MICROPHONE },
+};
+
+static int beyond_start_sysclk(struct snd_soc_card *card)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+	struct snd_soc_component *codec = priv->codec;
+	int ret;
+
+	ret = clk_prepare_enable(priv->mclk);
+	if (ret) {
+		dev_err(card->dev, "Failed to enable MCLK1: %d\n", ret);
+		return ret;
+	}
+
+	ret = snd_soc_component_set_sysclk(codec, MADERA_CLK_SYSCLK_1,
+					   MADERA_CLK_SRC_FLL1,
+					   BEYOND_SYSCLK_RATE,
+					   SND_SOC_CLOCK_IN);
+	if (ret) {
+		dev_err(card->dev, "Failed to set SYSCLK: %d\n", ret);
+		goto err_clk;
+	}
+
+	ret = snd_soc_component_set_pll(codec, MADERA_FLL1_REFCLK,
+					MADERA_FLL_SRC_MCLK1, priv->mclk_rate,
+					BEYOND_SYSCLK_RATE);
+	if (ret) {
+		dev_err(card->dev, "Failed to start FLL1: %d\n", ret);
+		goto err_clk;
+	}
+
+	return 0;
+
+err_clk:
+	clk_disable_unprepare(priv->mclk);
+	return ret;
+}
+
+static void beyond_stop_sysclk(struct snd_soc_card *card)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+	struct snd_soc_component *codec = priv->codec;
+	int ret;
+
+	ret = snd_soc_component_set_pll(codec, MADERA_FLL1_REFCLK, 0, 0, 0);
+	if (ret)
+		dev_err(card->dev, "Failed to stop FLL1: %d\n", ret);
+
+	ret = snd_soc_component_set_sysclk(codec, MADERA_CLK_SYSCLK_1, 0, 0, 0);
+	if (ret)
+		dev_err(card->dev, "Failed to stop SYSCLK: %d\n", ret);
+
+	clk_disable_unprepare(priv->mclk);
+}
+
+static int beyond_set_bias_level(struct snd_soc_card *card,
+				 struct snd_soc_dapm_context *dapm,
+				 enum snd_soc_bias_level level)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+
+	if (!priv->codec || snd_soc_dapm_to_dev(dapm) != priv->codec->dev)
+		return 0;
+
+	switch (level) {
+	case SND_SOC_BIAS_STANDBY:
+		if (snd_soc_dapm_get_bias_level(dapm) == SND_SOC_BIAS_OFF)
+			return beyond_start_sysclk(card);
+		break;
+	case SND_SOC_BIAS_OFF:
+		beyond_stop_sysclk(card);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+/* ---- jack detection ---------------------------------------------------- */
+
+static void beyond_micd_stop(struct beyond_priv *priv)
+{
+	struct madera *madera = priv->madera;
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_component_to_dapm(priv->codec);
+
+	if (!priv->micd_running)
+		return;
+
+	regmap_update_bits(madera->regmap, MADERA_MIC_DETECT_1_CONTROL_1,
+			   MADERA_MICD_ENA, 0);
+	snd_soc_dapm_disable_pin(dapm, "MICBIAS2A");
+	snd_soc_dapm_disable_pin(dapm, "MICVDD");
+	snd_soc_dapm_sync(dapm);
+	regmap_update_bits(madera->regmap, MADERA_MICD_CLAMP_CONTROL,
+			   MADERA_MICD_CLAMP_OVD, MADERA_MICD_CLAMP_OVD);
+	priv->micd_running = false;
+}
+
+static void beyond_micd_start(struct beyond_priv *priv)
+{
+	struct madera *madera = priv->madera;
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_component_to_dapm(priv->codec);
+
+	regmap_update_bits(madera->regmap, MADERA_MICD_CLAMP_CONTROL,
+			   MADERA_MICD_CLAMP_OVD, 0);
+	/* MICDET in ADC mode ("micd-software-compare" downstream) */
+	regmap_update_bits(madera->regmap, MADERA_MIC_DETECT_1_CONTROL_0,
+			   MADERA_MICD1_ADC_MODE_MASK, MADERA_MICD1_ADC_MODE_MASK);
+	snd_soc_dapm_force_enable_pin(dapm, "MICVDD");
+	snd_soc_dapm_force_enable_pin(dapm, "MICBIAS2A");
+	snd_soc_dapm_sync(dapm);
+	regmap_update_bits(madera->regmap, MADERA_MIC_DETECT_1_CONTROL_1,
+			   MADERA_MICD_ENA, MADERA_MICD_ENA);
+	priv->micd_running = true;
+}
+
+static void beyond_jack_report(struct beyond_priv *priv, int status)
+{
+	dev_info(priv->dev, "jack: %s\n",
+		 status == SND_JACK_HEADSET ? "headset" :
+		 status ? "headphones" : "removed");
+	snd_soc_jack_report(&priv->jack, status, SND_JACK_HEADSET);
+}
+
+/* start mic detection after the plug settled */
+static void beyond_micd_work(struct work_struct *work)
+{
+	struct beyond_priv *priv = container_of(to_delayed_work(work),
+						struct beyond_priv, micd_work);
+
+	mutex_lock(&priv->jack_lock);
+	if (priv->jack_present && !priv->micd_running) {
+		beyond_micd_start(priv);
+		schedule_delayed_work(&priv->micd_timeout,
+				msecs_to_jiffies(BEYOND_MICD_TIMEOUT_MS));
+	}
+	mutex_unlock(&priv->jack_lock);
+}
+
+static void beyond_micd_timeout_work(struct work_struct *work)
+{
+	struct beyond_priv *priv = container_of(to_delayed_work(work),
+						struct beyond_priv,
+						micd_timeout);
+
+	mutex_lock(&priv->jack_lock);
+	if (priv->micd_running) {
+		dev_dbg(priv->dev, "MICDET timed out: no microphone\n");
+		beyond_micd_stop(priv);
+	}
+	mutex_unlock(&priv->jack_lock);
+}
+
+static irqreturn_t beyond_micdet_irq(int irq, void *data)
+{
+	struct beyond_priv *priv = data;
+	struct madera *madera = priv->madera;
+	unsigned int val = 0;
+	int ohms;
+
+	cancel_delayed_work_sync(&priv->micd_timeout);
+
+	mutex_lock(&priv->jack_lock);
+	if (!priv->micd_running || !priv->jack_present)
+		goto out;
+
+	/* MICD must be off to read ADCVAL */
+	regmap_update_bits(madera->regmap, MADERA_MIC_DETECT_1_CONTROL_1,
+			   MADERA_MICD_ENA, 0);
+	regmap_read(madera->regmap, MADERA_MIC_DETECT_1_CONTROL_4, &val);
+	val &= MADERA_MICDET_ADCVAL_MASK;
+	ohms = val < ARRAY_SIZE(beyond_micd_levels) ?
+	       beyond_micd_levels[val] : INT_MAX;
+
+	dev_dbg(priv->dev, "MICDET ADCVAL %#x = %d ohm\n", val, ohms);
+
+	/* open circuit counts as a microphone (micd-open-circuit-declare) */
+	beyond_jack_report(priv, ohms >= BEYOND_MIC_MIN_OHM ?
+			   SND_JACK_HEADSET : SND_JACK_HEADPHONE);
+	beyond_micd_stop(priv);
+out:
+	mutex_unlock(&priv->jack_lock);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t beyond_jackdet_irq(int irq, void *data)
+{
+	struct beyond_priv *priv = data;
+	struct madera *madera = priv->madera;
+	unsigned int val = 0;
+	bool present;
+	int ret;
+
+	ret = regmap_read(madera->regmap, MADERA_IRQ1_RAW_STATUS_7, &val);
+	if (ret)
+		return IRQ_NONE;
+
+	/* the MICD clamp is active while the jack is out */
+	present = !(val & MADERA_MICD_CLAMP_RISE_STS1);
+
+	mutex_lock(&priv->jack_lock);
+	if (present == priv->jack_present) {
+		mutex_unlock(&priv->jack_lock);
+		return IRQ_HANDLED;
+	}
+	priv->jack_present = present;
+
+	if (present) {
+		/* plain headphones until MICDET says otherwise */
+		beyond_jack_report(priv, SND_JACK_HEADPHONE);
+		regmap_update_bits(madera->regmap, MADERA_INTERRUPT_DEBOUNCE_7,
+				   MADERA_MICD_CLAMP_DB | MADERA_JD1_DB |
+				   MADERA_JD2_DB, 0);
+		schedule_delayed_work(&priv->micd_work,
+				msecs_to_jiffies(BEYOND_MICD_DEBOUNCE_MS));
+	} else {
+		beyond_micd_stop(priv);
+		regmap_update_bits(madera->regmap, MADERA_INTERRUPT_DEBOUNCE_7,
+				   MADERA_MICD_CLAMP_DB | MADERA_JD1_DB |
+				   MADERA_JD2_DB,
+				   MADERA_MICD_CLAMP_DB | MADERA_JD1_DB |
+				   MADERA_JD2_DB);
+		beyond_jack_report(priv, 0);
+	}
+	mutex_unlock(&priv->jack_lock);
+
+	if (!present) {
+		cancel_delayed_work(&priv->micd_work);
+		cancel_delayed_work(&priv->micd_timeout);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static int beyond_jack_init(struct snd_soc_card *card)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+	struct madera *madera = dev_get_drvdata(priv->codec->dev->parent);
+	struct regmap *map;
+	int ret;
+
+	if (!madera)
+		return -ENODEV;
+	priv->madera = madera;
+	map = madera->regmap;
+
+	mutex_init(&priv->jack_lock);
+	INIT_DELAYED_WORK(&priv->micd_work, beyond_micd_work);
+	INIT_DELAYED_WORK(&priv->micd_timeout, beyond_micd_timeout_work);
+
+	ret = snd_soc_card_jack_new_pins(card, "Headset Jack",
+					 SND_JACK_HEADSET, &priv->jack,
+					 beyond_jack_pins,
+					 ARRAY_SIZE(beyond_jack_pins));
+	if (ret)
+		return ret;
+
+	/* accessory detect on HPOUT2, JD1+JD2 combined in the MICD clamp */
+	regmap_update_bits(map, MADERA_MICD_CLAMP_CONTROL,
+			   MADERA_MICD_CLAMP_MODE_MASK, BEYOND_MICD_CLAMP_MODE);
+	regmap_update_bits(map, MADERA_INTERRUPT_DEBOUNCE_7,
+			   MADERA_MICD_CLAMP_DB, MADERA_MICD_CLAMP_DB);
+	regmap_update_bits(map, MADERA_MIC_DETECT_1_CONTROL_1,
+			   MADERA_MICD_BIAS_STARTTIME_MASK |
+			   MADERA_MICD_RATE_MASK | MADERA_MICD_BIAS_SRC_MASK |
+			   MADERA_MICD_DBTIME | MADERA_MICD_ENA,
+			   BEYOND_MICD_BIAS_STARTTIME <<
+					MADERA_MICD_BIAS_STARTTIME_SHIFT |
+			   BEYOND_MICD_RATE << MADERA_MICD_RATE_SHIFT |
+			   BEYOND_MICD_BIAS_SRC << MADERA_MICD_BIAS_SRC_SHIFT |
+			   MADERA_MICD_DBTIME);
+	regmap_update_bits(map, MADERA_MIC_DETECT_1_CONTROL_0,
+			   MADERA_MICD1_SENSE_MASK | MADERA_MICD1_GND_MASK,
+			   BEYOND_MICD_SENSE << MADERA_MICD1_SENSE_SHIFT |
+			   BEYOND_MICD_GND << MADERA_MICD1_GND_SHIFT);
+	regmap_update_bits(map, MADERA_HEADPHONE_DETECT_0,
+			   MADERA_HPD_GND_SEL_MASK,
+			   BEYOND_MICD_GND << MADERA_HPD_GND_SEL_SHIFT);
+	regmap_update_bits(map, MADERA_OUTPUT_PATH_CONFIG_2,
+			   MADERA_HP1_GND_SEL_MASK,
+			   BEYOND_HP_GND << MADERA_HP1_GND_SEL_SHIFT);
+	regmap_update_bits(map, MADERA_MICD_CLAMP_CONTROL,
+			   MADERA_MICD_CLAMP_OVD, MADERA_MICD_CLAMP_OVD);
+	regmap_update_bits(map, MADERA_JACK_DETECT_ANALOGUE,
+			   MADERA_JD1_ENA | MADERA_JD2_ENA,
+			   MADERA_JD1_ENA | MADERA_JD2_ENA);
+
+	ret = madera_request_irq(madera, MADERA_IRQ_MICD_CLAMP_RISE,
+				 "MICDET clamp rise", beyond_jackdet_irq, priv);
+	if (ret)
+		return ret;
+	ret = madera_request_irq(madera, MADERA_IRQ_MICD_CLAMP_FALL,
+				 "MICDET clamp fall", beyond_jackdet_irq, priv);
+	if (ret)
+		goto err_rise;
+	ret = madera_request_irq(madera, MADERA_IRQ_MICDET1, "MICDET1",
+				 beyond_micdet_irq, priv);
+	if (ret)
+		goto err_fall;
+
+	priv->jack_irqs = true;
+
+	/* initial state */
+	beyond_jackdet_irq(0, priv);
+	return 0;
+
+err_fall:
+	madera_free_irq(madera, MADERA_IRQ_MICD_CLAMP_FALL, priv);
+err_rise:
+	madera_free_irq(madera, MADERA_IRQ_MICD_CLAMP_RISE, priv);
+	return ret;
+}
+
+static int beyond_card_remove(struct snd_soc_card *card)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+
+	if (!priv->jack_irqs)
+		return 0;
+
+	madera_free_irq(priv->madera, MADERA_IRQ_MICDET1, priv);
+	madera_free_irq(priv->madera, MADERA_IRQ_MICD_CLAMP_FALL, priv);
+	madera_free_irq(priv->madera, MADERA_IRQ_MICD_CLAMP_RISE, priv);
+	cancel_delayed_work_sync(&priv->micd_work);
+	cancel_delayed_work_sync(&priv->micd_timeout);
+	mutex_lock(&priv->jack_lock);
+	beyond_micd_stop(priv);
+	mutex_unlock(&priv->jack_lock);
+	priv->jack_irqs = false;
+	return 0;
+}
+
+static int beyond_codec_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_card *card = rtd->card;
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	int ret;
+
+	priv->codec = codec_dai->component;
+
+	if (priv->abox) {
+		/* AIF1 + outputs on ASYNCCLK (FLL2 locked to AIF1BCLK) */
+		ret = snd_soc_component_set_sysclk(priv->codec,
+						   MADERA_CLK_ASYNCCLK_1,
+						   MADERA_CLK_SRC_FLL2,
+						   BEYOND_SYSCLK_RATE,
+						   SND_SOC_CLOCK_IN);
+		if (ret) {
+			dev_err(card->dev, "Failed to set ASYNCCLK: %d\n", ret);
+			return ret;
+		}
+	}
+
+	ret = snd_soc_dai_set_sysclk(codec_dai, priv->abox ?
+				     MADERA_CLK_ASYNCCLK_1 :
+				     MADERA_CLK_SYSCLK_1, 0, 0);
+	if (ret) {
+		dev_err(card->dev, "Failed to set AIF1 clock domain: %d\n", ret);
+		return ret;
+	}
+
+	ret = snd_soc_component_set_sysclk(priv->codec, MADERA_CLK_OUTCLK,
+					   priv->abox ? MADERA_OUTCLK_ASYNCCLK :
+					   MADERA_OUTCLK_SYSCLK, 0,
+					   SND_SOC_CLOCK_IN);
+	if (ret) {
+		dev_err(card->dev, "Failed to set OUTCLK: %d\n", ret);
+		return ret;
+	}
+
+	/* DSPCLK is only needed for the codec DSP firmware: not fatal */
+	ret = snd_soc_component_set_sysclk(priv->codec, MADERA_CLK_DSPCLK,
+					   MADERA_CLK_SRC_FLL1,
+					   BEYOND_DSPCLK_RATE,
+					   SND_SOC_CLOCK_IN);
+	if (ret)
+		dev_warn(card->dev, "Failed to set DSPCLK: %d\n", ret);
+
+	ret = beyond_jack_init(card);
+	if (ret)
+		dev_warn(card->dev, "jack detection disabled: %d\n", ret);
+
+	return 0;
+}
+
+static int beyond_codec_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	/* I2S, 2 slots of the sample width, from ABOX UAIF0 */
+	priv->aif1_bclk = params_rate(params) * params_width(params) * 2;
+	return 0;
+}
+
+static int beyond_codec_prepare(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+	int ret;
+
+	if (!priv->abox || !priv->aif1_bclk)
+		return 0;
+
+	/* BCLK runs from UAIF startup on: lock FLL2 to it */
+	ret = snd_soc_component_set_pll(priv->codec, MADERA_FLL2_REFCLK,
+					MADERA_FLL_SRC_AIF1BCLK,
+					priv->aif1_bclk, BEYOND_SYSCLK_RATE);
+	if (ret)
+		dev_err(rtd->card->dev, "Failed to start FLL2 (BCLK %u): %d\n",
+			priv->aif1_bclk, ret);
+
+	return ret;
+}
+
+static int beyond_codec_hw_free(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	/* keep FLL2 while the other direction still runs */
+	if (!priv->abox || snd_soc_dai_active(snd_soc_rtd_to_cpu(rtd, 0)) > 1)
+		return 0;
+
+	snd_soc_component_set_pll(priv->codec, MADERA_FLL2_REFCLK, 0, 0, 0);
+	priv->aif1_bclk = 0;
+	return 0;
+}
+
+static const struct snd_soc_ops beyond_codec_ops = {
+	.hw_params	= beyond_codec_hw_params,
+	.prepare	= beyond_codec_prepare,
+	.hw_free	= beyond_codec_hw_free,
+};
+
+static int beyond_amps_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_card *card = rtd->card;
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+	struct snd_soc_dai *dai;
+	int i, ret;
+
+	if (priv->abox) {
+		ret = snd_soc_dai_set_tdm_slot(snd_soc_rtd_to_cpu(rtd, 0),
+					       GENMASK(BEYOND_AMP_SLOTS - 1, 0),
+					       0, BEYOND_AMP_SLOTS,
+					       BEYOND_AMP_SLOT_WIDTH);
+		if (ret) {
+			dev_err(card->dev, "UAIF1 TDM setup failed: %d\n", ret);
+			return ret;
+		}
+	}
+
+	for_each_rtd_codec_dais(rtd, i, dai) {
+		unsigned int slot = priv->amp_rx_slot[i];
+
+		/* 24-bit samples in the 32-bit bus slots */
+		if (priv->abox) {
+			ret = snd_soc_dai_set_tdm_slot(dai, 0, 0,
+						       BEYOND_AMP_SLOTS,
+						       BEYOND_AMP_SLOT_WIDTH);
+			if (ret) {
+				dev_err(card->dev, "%s: slot width: %d\n",
+					dai->name, ret);
+				return ret;
+			}
+		}
+
+		ret = snd_soc_dai_set_channel_map(dai, 0, NULL, 1, &slot);
+		if (ret) {
+			dev_err(card->dev, "%s: failed to set RX slot %u: %d\n",
+				dai->name, slot, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int beyond_amps_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+	unsigned int bclk = params_rate(params) * priv->amp_bclk_ratio;
+	struct snd_soc_dai *dai;
+	int i, ret;
+
+	for_each_rtd_codec_dais(rtd, i, dai) {
+		ret = snd_soc_component_set_sysclk(dai->component,
+						   CS35L41_CLKID_SCLK, 0, bclk,
+						   SND_SOC_CLOCK_IN);
+		if (ret) {
+			dev_err(rtd->card->dev,
+				"%s: failed to set SCLK %u: %d\n",
+				dai->name, bclk, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * With the ABOX the bus always carries 4 x 32 bit slots (as on stock) and
+ * the amplifiers take their slot width from the PCM width, so the PCM must
+ * match: S32_LE, 4 channels (ch0 = slot 0 = earpiece, ch1 = slot 1 =
+ * speaker with the default samsung,amp-rx-slots).
+ */
+static int beyond_amps_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int ret;
+
+	if (!priv->abox)
+		return 0;
+
+	/*
+	 * S32_LE only, like the stock kernel (RDMA7 32-bit into SIFS1): the
+	 * link runs 32-bit slots, and with 24-bit RDMA data the ABOX firmware
+	 * converts 24 -> 32 bit in front of UAIF1, which audibly distorts
+	 * speech (tones survive). The amps use the upper 24 bits (RX_WL from
+	 * params_width), so nothing is lost.
+	 */
+	ret = snd_pcm_hw_constraint_mask64(runtime, SNDRV_PCM_HW_PARAM_FORMAT,
+					   SNDRV_PCM_FMTBIT_S32_LE);
+	if (ret < 0)
+		return ret;
+
+	return snd_pcm_hw_constraint_single(runtime, SNDRV_PCM_HW_PARAM_CHANNELS,
+					    BEYOND_AMP_SLOTS);
+}
+
+static const struct snd_soc_ops beyond_amps_ops = {
+	.startup = beyond_amps_startup,
+	.hw_params = beyond_amps_hw_params,
+};
+
+static const struct snd_soc_dapm_widget beyond_dapm_widgets[] = {
+	SND_SOC_DAPM_HP("HEADPHONE", NULL),
+	SND_SOC_DAPM_SPK("SPEAKER", NULL),
+	SND_SOC_DAPM_SPK("RECEIVER", NULL),
+	SND_SOC_DAPM_MIC("HEADSETMIC", NULL),
+	SND_SOC_DAPM_MIC("DMIC1", NULL),
+	SND_SOC_DAPM_MIC("DMIC2", NULL),
+};
+
+static const struct snd_kcontrol_new beyond_controls[] = {
+	SOC_DAPM_PIN_SWITCH("HEADPHONE"),
+	SOC_DAPM_PIN_SWITCH("SPEAKER"),
+	SOC_DAPM_PIN_SWITCH("RECEIVER"),
+	SOC_DAPM_PIN_SWITCH("HEADSETMIC"),
+	SOC_DAPM_PIN_SWITCH("DMIC1"),
+	SOC_DAPM_PIN_SWITCH("DMIC2"),
+};
+
+SND_SOC_DAILINK_DEFS(codec,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "cs47l92-aif1")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link beyond_dai_links[] = {
+	[BEYOND_LINK_CODEC] = {
+		.name		= "CS47L93 AIF1",
+		.stream_name	= "HiFi",
+		.init		= beyond_codec_init,
+		.ops		= &beyond_codec_ops,
+		/* ABOX UAIF0 provides BCLK/LRCLK */
+		.dai_fmt	= SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+				  SND_SOC_DAIFMT_CBC_CFC,
+		SND_SOC_DAILINK_REG(codec),
+	},
+	[BEYOND_LINK_AMPS] = {
+		.name		= "CS35L4x ASP",
+		.stream_name	= "Speaker",
+		.init		= beyond_amps_init,
+		.ops		= &beyond_amps_ops,
+		/* downstream: format = "dsp_a"; bitclock-inversion */
+		.dai_fmt	= SND_SOC_DAIFMT_DSP_A | SND_SOC_DAIFMT_IB_NF |
+				  SND_SOC_DAIFMT_CBC_CFC,
+		.playback_only	= 1,
+		/* cpus/codecs/platforms are allocated in probe */
+	},
+};
+
+static struct snd_soc_card beyond_card = {
+	.owner			= THIS_MODULE,
+	.driver_name		= "beyond-madera",	/* stable UCM match */
+	.dai_link		= beyond_dai_links,
+	.num_links		= BEYOND_NUM_LINKS,
+	.dapm_widgets		= beyond_dapm_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(beyond_dapm_widgets),
+	.controls		= beyond_controls,
+	.num_controls		= ARRAY_SIZE(beyond_controls),
+	.set_bias_level		= beyond_set_bias_level,
+	.remove			= beyond_card_remove,
+};
+
+/*
+ * Bind the CPU side of a link: an ABOX UAIF DAI if one is given in DT,
+ * else the ASoC dummy DAI with the dummy platform.
+ */
+static int beyond_set_cpu(struct device *dev, struct snd_soc_dai_link *link,
+			  int index, bool *real)
+{
+	struct device_node *np = dev->of_node;
+	struct snd_soc_dai_link_component *cpu, *platform;
+	struct of_phandle_args args;
+	int ret;
+
+	cpu = devm_kzalloc(dev, sizeof(*cpu), GFP_KERNEL);
+	platform = devm_kzalloc(dev, sizeof(*platform), GFP_KERNEL);
+	if (!cpu || !platform)
+		return -ENOMEM;
+
+	ret = of_parse_phandle_with_args(np, "samsung,uaif-controllers",
+					 "#sound-dai-cells", index, &args);
+	if (!ret && !of_device_is_available(args.np)) {
+		/* ABOX disabled in DT: fall back to the dummy CPU DAI */
+		of_node_put(args.np);
+		ret = -ENODEV;
+	}
+	if (ret) {
+		dev_info(dev, "%s: no CPU DAI, using dummy (no PCM data)\n",
+			 link->name);
+		*cpu = snd_soc_dummy_dlc;
+		*platform = snd_soc_dummy_dlc;
+	} else {
+		ret = snd_soc_get_dlc(&args, cpu);
+		of_node_put(args.np);
+		if (ret)
+			return dev_err_probe(dev, ret, "%s: bad CPU DAI\n",
+					     link->name);
+		platform->of_node = cpu->of_node;
+		*real = true;
+	}
+
+	link->cpus = cpu;
+	link->num_cpus = 1;
+	link->platforms = platform;
+	link->num_platforms = 1;
+
+	return 0;
+}
+
+static int beyond_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct snd_soc_card *card = &beyond_card;
+	struct snd_soc_dai_link *link;
+	struct snd_soc_dai_link_component *amps;
+	struct beyond_priv *priv;
+	bool amp_cpu = false;
+	int i, ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	card->dev = dev;
+	snd_soc_card_set_drvdata(card, priv);
+
+	/* The link table is static: reset what a deferred probe left behind */
+	card->num_links = BEYOND_NUM_LINKS;
+	beyond_dai_links[BEYOND_LINK_AMPS].codecs = NULL;
+	beyond_dai_links[BEYOND_LINK_AMPS].num_codecs = 0;
+
+	priv->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(priv->mclk))
+		return dev_err_probe(dev, PTR_ERR(priv->mclk),
+				     "Failed to get MCLK1 (CLKOUT0)\n");
+
+	priv->mclk_rate = BEYOND_MCLK1_RATE;
+	of_property_read_u32(np, "samsung,mclk-rate", &priv->mclk_rate);
+	priv->amp_bclk_ratio = BEYOND_AMP_BCLK_RATIO_DEFAULT;
+	of_property_read_u32(np, "samsung,amp-bclk-ratio",
+			     &priv->amp_bclk_ratio);
+
+	ret = snd_soc_of_parse_card_name(card, "model");
+	if (ret)
+		return dev_err_probe(dev, ret, "Card name (model) missing\n");
+
+	ret = snd_soc_of_parse_audio_routing(card, "samsung,audio-routing");
+	if (ret)
+		return dev_err_probe(dev, ret, "Invalid audio routing\n");
+
+	/* Codec link */
+	link = &beyond_dai_links[BEYOND_LINK_CODEC];
+	link->codecs->of_node = of_parse_phandle(np, "samsung,audio-codec", 0);
+	if (!link->codecs->of_node)
+		return dev_err_probe(dev, -EINVAL,
+				     "samsung,audio-codec missing\n");
+
+	ret = beyond_set_cpu(dev, link, BEYOND_LINK_CODEC, &priv->abox);
+	if (ret)
+		goto err_put;
+
+	/* Amplifier link (multi-codec) */
+	link = &beyond_dai_links[BEYOND_LINK_AMPS];
+	priv->num_amps = of_count_phandle_with_args(np, "samsung,audio-amplifiers",
+						    NULL);
+	if (priv->num_amps <= 0 || priv->num_amps > BEYOND_MAX_AMPS) {
+		dev_info(dev, "no amplifiers, speaker/earpiece link disabled\n");
+		card->num_links = BEYOND_LINK_AMPS;
+	} else {
+		amps = devm_kcalloc(dev, priv->num_amps, sizeof(*amps),
+				    GFP_KERNEL);
+		if (!amps) {
+			ret = -ENOMEM;
+			goto err_put;
+		}
+
+		for (i = 0; i < priv->num_amps; i++) {
+			amps[i].of_node = of_parse_phandle(np, "samsung,audio-amplifiers",
+							   i);
+			amps[i].dai_name = "cs35l41-pcm";
+			priv->amp_rx_slot[i] = i;
+			of_property_read_u32_index(np, "samsung,amp-rx-slots",
+						   i, &priv->amp_rx_slot[i]);
+		}
+		link->codecs = amps;
+		link->num_codecs = priv->num_amps;
+
+		ret = beyond_set_cpu(dev, link, BEYOND_LINK_AMPS, &amp_cpu);
+		if (ret)
+			goto err_put;
+	}
+
+	ret = devm_snd_soc_register_card(dev, card);
+	if (ret) {
+		dev_err_probe(dev, ret, "Failed to register card\n");
+		goto err_put;
+	}
+
+	return 0;
+
+err_put:
+	of_node_put(beyond_dai_links[BEYOND_LINK_CODEC].codecs->of_node);
+	if (beyond_dai_links[BEYOND_LINK_AMPS].codecs)
+		for (i = 0; i < beyond_dai_links[BEYOND_LINK_AMPS].num_codecs; i++)
+			of_node_put(beyond_dai_links[BEYOND_LINK_AMPS].codecs[i].of_node);
+	return ret;
+}
+
+static const struct of_device_id beyond_of_match[] = {
+	{ .compatible = "samsung,beyond-madera" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, beyond_of_match);
+
+static struct platform_driver beyond_driver = {
+	.driver = {
+		.name		= "beyond-madera",
+		.pm		= &snd_soc_pm_ops,
+		.of_match_table	= beyond_of_match,
+	},
+	.probe	= beyond_probe,
+};
+module_platform_driver(beyond_driver);
+
+MODULE_DESCRIPTION("ASoC machine driver for Samsung Galaxy S10 (Exynos9820 + CS47L93 + CS35L41)");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/samsung/exynos9820-abox-ipc.h b/sound/soc/samsung/exynos9820-abox-ipc.h
new file mode 100644
index 0000000000..80dfe071f4
--- /dev/null
+++ b/sound/soc/samsung/exynos9820-abox-ipc.h
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Exynos9820 ABOX: message layout shared with the "Calliope" firmware.
+ *
+ * This is ABI with the closed firmware (calliope_*.bin). The layout is
+ * copied from the Samsung downstream kernel (include/sound/samsung/
+ * abox_ipc.h and sound/soc/samsung/abox/abox_msg.h, GPL-2.0) and must not
+ * be changed. Only the parts this driver uses are kept.
+ */
+#ifndef __EXYNOS9820_ABOX_IPC_H
+#define __EXYNOS9820_ABOX_IPC_H
+
+#include <linux/build_bug.h>
+#include <linux/types.h>
+
+/* IPC_ID: category of a message, also the SGI number of legacy IPC */
+enum abox_ipc_id {
+	ABOX_IPC_RECEIVED	= 0x0,
+	ABOX_IPC_SYSTEM		= 0x1,
+	ABOX_IPC_PCMPLAYBACK	= 0x2,
+	ABOX_IPC_PCMCAPTURE	= 0x3,
+	ABOX_IPC_OFFLOAD	= 0x4,
+	ABOX_IPC_ERAP		= 0x5,
+	ABOX_WDMA0_BUF_FULL	= 0x8,
+	ABOX_WDMA1_BUF_FULL	= 0x9,
+	ABOX_IPC_ABOX_CONFIG	= 0xa,
+	ABOX_RDMA0_BUF_EMPTY	= 0xb,
+	ABOX_RDMA1_BUF_EMPTY	= 0xc,
+	ABOX_RDMA2_BUF_EMPTY	= 0xd,
+	ABOX_RDMA3_BUF_EMPTY	= 0xe,
+	ABOX_IPC_ASB_TEST	= 0xf,
+};
+
+/* enum PCMMSG */
+enum abox_pcm_msg {
+	ABOX_PCM_PLTDAI_OPEN		= 11,
+	ABOX_PCM_PLTDAI_CLOSE		= 12,
+	ABOX_PCM_PLTDAI_HW_PARAMS	= 14,
+	ABOX_PCM_PLTDAI_HW_FREE		= 15,
+	ABOX_PCM_PLTDAI_PREPARE		= 16,
+	ABOX_PCM_PLTDAI_TRIGGER		= 17,
+	ABOX_PCM_PLTDAI_POINTER		= 18,
+	ABOX_PCM_SET_BUFFER		= 20,
+	ABOX_PCM_PLTDAI_ACK		= 22,
+	ABOX_PCM_PLTDAI_CLOSED		= 23,
+	ABOX_PCM_PLTDAI_REGISTER	= 50,
+};
+
+/* enum ABOX_SYSTEM_MSG */
+enum abox_system_msg {
+	ABOX_SUSPEND			= 1,
+	ABOX_RESUME			= 2,
+	ABOX_BOOT_DONE			= 3,
+	ABOX_CHANGE_GEAR		= 4,
+	ABOX_REQUEST_SYSCLK		= 7,
+	ABOX_CHANGED_GEAR		= 9,	/* AP -> fw: CPU clock (kHz) */
+	ABOX_REPORT_LOG			= 0x10,
+	ABOX_REPORT_DUMP		= 0x20,
+	ABOX_SET_MODE			= 0x50,	/* param1 enum abox_audio_mode */
+	ABOX_SET_TYPE			= 0x60,	/* param1 enum abox_sound_type */
+	ABOX_START_VSS			= 0xa0,	/* CP online (INIT_END sent) */
+	ABOX_STOP_VSS			= 0xa1,	/* CP stopped */
+	ABOX_RESET_VSS			= 0xa2,	/* CP crashed / reset */
+	ABOX_WATCHDOG_VSS		= 0xa3,
+	ABOX_REPORT_COMPONENT		= 0xc0,
+	ABOX_UPDATE_COMPONENT_CONTROL	= 0xc1,	/* param1 component, param2 control */
+	ABOX_REPORT_FAULT		= 0xfa,
+};
+
+/* abox.h enum audio_mode / enum sound_type */
+enum abox_audio_mode {
+	ABOX_MODE_NORMAL,
+	ABOX_MODE_RINGTONE,
+	ABOX_MODE_IN_CALL,
+	ABOX_MODE_IN_COMMUNICATION,
+	ABOX_MODE_IN_VIDEOCALL,
+};
+
+enum abox_sound_type {
+	ABOX_SOUND_VOICE,
+	ABOX_SOUND_SPEAKER,
+	ABOX_SOUND_HEADSET,
+	ABOX_SOUND_BTVOICE,
+	ABOX_SOUND_USB,
+	ABOX_SOUND_CALLFWD,
+};
+
+/*
+ * The controls of calliope2.dt (RDMA0_EN, RDMA0_A, VPCMOUT_DAI0_EN, ...)
+ * belong to this component ("void component" in the downstream driver).
+ */
+#define ABOX_VOID_COMPONENT_ID		0xab0c
+
+/* enum ABOX_CONFIGMSG */
+enum abox_config_msg {
+	ABOX_SET_SIFS0_RATE		= 1,
+	ABOX_SET_SIFS1_RATE		= 2,
+	ABOX_SET_SIFS2_RATE		= 3,
+	ABOX_SET_SIFM0_RATE		= 5,
+	ABOX_SET_SIFS0_FORMAT		= 0x10,
+	ABOX_SET_SIFS1_FORMAT		= 0x11,
+	ABOX_SET_SIFS2_FORMAT		= 0x12,
+	ABOX_SET_SIFM0_FORMAT		= 0x14,
+};
+
+struct abox_pcmtask_msg {
+	s32 msgtype;			/* enum abox_pcm_msg */
+	s32 channel_id;
+	union {
+		struct {
+			s32 sample_rate;
+			s32 bit_depth;
+			s32 channels;
+		} hw_params;
+		struct {
+			s32 phyaddr;		/* IOVA seen by ABOX */
+			s32 size;		/* period bytes */
+			s32 count;		/* periods */
+		} setbuff;
+		u32 pointer;
+		s32 trigger;
+		u8 hardware[80];	/* struct PCMTASK_HARDWARE */
+	} param;
+};
+
+struct abox_system_msg_body {
+	s32 msgtype;			/* enum abox_system_msg */
+	s32 param1;
+	s32 param2;
+	s32 param3;
+	union {
+		s32 param_s32[185];
+		u64 param_u64[92];
+		u8 param_bundle[740];
+	} bundle;
+};
+
+struct abox_config_msg_body {
+	s32 msgtype;			/* enum abox_config_msg */
+	s32 param1;
+	s32 param2;
+};
+
+/* ABOX_IPC_MSG */
+struct abox_ipc_msg {
+	s32 ipcid;			/* enum abox_ipc_id */
+	s32 task_id;
+	union {
+		struct abox_system_msg_body system;
+		struct abox_pcmtask_msg pcmtask;
+		struct abox_config_msg_body config;
+		u8 erap[756];		/* struct IPC_ERAP_MSG */
+	} msg;
+};
+
+/* abox_msg.h: lock-free queues in DRAM ("ipc version 2") */
+#define ABOX_MSG_LEN_CMD	16
+
+struct abox_msg_data {
+	s32 size;
+	u8 data[];
+} __packed;
+
+struct abox_msg_cmd {
+	s32 id;
+	s32 cmd;
+	s32 arg[3];
+	u32 data_idx;
+	u64 send;			/* sender's pointer, informational */
+	u64 recv;
+	u64 time_put;
+	u64 time_get;
+} __packed;
+
+struct abox_msg_cmd_queue {
+	s32 idx_s;
+	s32 idx_e;
+	struct abox_msg_cmd elem[ABOX_MSG_LEN_CMD];
+} __packed;
+
+struct abox_msg_data_queue {
+	s32 idx_s;
+	s32 idx_e;
+	u32 len;
+	s8 elem[];
+} __packed;
+
+struct abox_msg_queue {
+	struct abox_msg_cmd_queue q_cmd;
+	struct abox_msg_data_queue q_data;
+} __packed;
+
+/* the firmware (32-bit ARM EABI) sees the same layout */
+static_assert(sizeof(struct abox_ipc_msg) == 768);
+static_assert(sizeof(struct abox_msg_cmd) == 56);
+
+#endif /* __EXYNOS9820_ABOX_IPC_H */
