--- /dev/null
+++ b/sound/soc/samsung/exynos9820-abox.c
@@ -0,0 +1,2999 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal driver for the Exynos9820 ABOX audio subsystem.
+ *
+ * The ABOX is the only I2S/TDM path of the SoC: its UAIF ports connect to
+ * the external codec and amplifiers. On the 9820 (ABOX v2.0.1) the DMA
+ * engines (RDMA = memory -> SPUS mixer, WDMA = SPUM -> memory) are owned by
+ * the "Calliope" firmware running on two Cortex-A32 cores inside the ABOX:
+ * the downstream AP driver never writes RDMA/WDMA control registers (they
+ * are not even in its writeable regmap range), it only sends PCM IPC
+ * messages (SET_BUFFER, HW_PARAMS, PREPARE, TRIGGER) and the firmware
+ * programs the DMA and reports the position. So this driver:
+ *
+ *  - loads calliope_{sram,dram}{,_2}.bin into the ABOX SRAM and a DRAM
+ *    carve-out mapped at IOVA 0x80000000 through SYSMMU_AUD, boots the
+ *    A32 cores through the PMU, and waits for ABOX_BOOT_DONE;
+ *  - implements the "ipc version 2" message queues (abox_msg) and the
+ *    legacy SRAM mailbox for incoming messages;
+ *  - programs the AP-owned routing registers (SPUS/SPUM/ROUTE, UAIF) with a
+ *    fixed configuration:
+ *        UAIF0 playback: RDMA2 -> SIFS0 (mixer) -> UAIF0 (codec AIF1)
+ *        UAIF0 capture : UAIF0 -> NSRC0 -> SIFM0 -> WDMA1
+ *        UAIF1 playback: RDMA1 -> SIFS1 (mux)   -> UAIF1 (amplifiers)
+ *    RDMA0 and RDMA7 are not usable for a plain AP stream: the firmware
+ *    treats them as the outputs of its own processing graph ("primcom")
+ *    and only starts them when an upstream firmware component (virtual
+ *    PCM DAI, SoundBooster, ...) produces data. Any other RDMA is started
+ *    by the firmware directly on PLTDAI_TRIGGER and reads the AP buffer.
+ *  - exposes two CPU DAIs ("UAIF0", "UAIF1") with their own PCM, so a
+ *    plain (non-DPCM) machine driver can use them.
+ *
+ * Register layout and the firmware protocol are from the Samsung downstream
+ * kernel (sound/soc/samsung/abox/, GPL-2.0).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/sched/clock.h>
+#include <linux/uaccess.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "exynos9820-abox-ipc.h"
+
+/* ABOX SFR (0x18c50000) */
+#define ABOX_SYSPOWER_CTRL		0x0010
+#define ABOX_SYSPOWER_STATUS		0x0014
+#define ABOX_QCHANNEL_DISABLE		0x0038
+#define ABOX_ROUTE_CTRL0		0x0040
+#define ABOX_ROUTE_CTRL1		0x0044
+#define ABOX_ROUTE_CTRL2		0x0048
+#define ABOX_SPUS_CTRL0			0x0200
+#define ABOX_SPUS_CTRL1			0x0204
+#define ABOX_SPUS_SBANK_RDMA(x)		(0x0220 + 4 * (x))
+#define ABOX_SPUS_CTRL_SIFS_CNT(x)	(0x0290 + 4 * (x))
+#define ABOX_SPUM_CTRL0			0x0300
+#define ABOX_SPUM_SBANK_NSRC(x)		(0x0328 + 4 * (x))
+#define ABOX_UAIF_CTRL0(x)		(0x0500 + 0x10 * (x))
+#define ABOX_UAIF_CTRL1(x)		(0x0504 + 0x10 * (x))
+#define ABOX_RDMA_CTRL0(x)		(0x1000 + 0x100 * (x))
+#define ABOX_RDMA_STATUS(x)		(0x1030 + 0x100 * (x))
+#define ABOX_WDMA_CTRL(x)		(0x3000 + 0x100 * (x))
+#define ABOX_WDMA_STATUS(x)		(0x3030 + 0x100 * (x))
+
+/* QCHANNEL_DISABLE bits (enum qchannel) */
+#define ABOX_QCH_BCLK_UAIF(x)		BIT(2 + (x))
+
+/* ROUTE_CTRL0: UAIFn speaker source, 4 bit each: 1 = SIFS0, 2 = SIFS1 */
+#define ABOX_ROUTE_UAIF_SPK(x)		(0xf << (4 * (x)))
+#define ABOX_ROUTE_SRC_SIFS(n)		((n) + 1)
+/* ROUTE_CTRL1: NSRCn source, 4 bit each: 8 = UAIF0 */
+#define ABOX_ROUTE_NSRC(x)		(0xf << (4 * (x)))
+#define ABOX_ROUTE_SRC_UAIF(n)		((n) + 8)
+/* ROUTE_CTRL2: NSRCn "bridge" (connection type), lets NSRCs share a UAIF */
+#define ABOX_ROUTE_NSRC_BRIDGE(n)	BIT(20 + (n))
+
+/*
+ * SPUS_CTRL0 (v2.0.1): 5 bits per RDMA n < 6:
+ *   [5n+4] IN (0 = RDMA), [5n+3:5n+1] OUT, [5n] ASRC enable.
+ * OUT encoding: 0 = SIFS1, 1 = SIFS0 (mixer), 2 = SIFS2, 4 = SIFS3, 6 = SIFS4
+ */
+#define ABOX_SPUS_RDMA_MASK(n)		(0x1f << (5 * (n)))
+#define ABOX_SPUS_OUT_SIFS0		1
+#define ABOX_SPUS_OUT_SIFS1		0
+/* SPUS_CTRL1: [12+4(x-1)+3 : 12+4(x-1)] SIFSx (x >= 1) source = SPUS OUTn */
+#define ABOX_SIFS_OUT_SEL_MASK(x)	(0xf << (8 + 4 * (x)))
+#define ABOX_MIXP_FORMAT_MASK		GENMASK(4, 0)
+/* SPUM_CTRL0: NSRCn chain, 4 bit each starting at bit 4: [4n+7] OUT, [4n+4] ASRC */
+#define ABOX_SPUM_NSRC_MASK(n)		(0xf << (4 + 4 * (n)))
+/* SBANK: [29:20] size in 16 byte units, [13:4] start */
+#define ABOX_SBANK_SIZE_MASK		GENMASK(29, 20)
+
+/* UAIF_CTRL0 */
+#define ABOX_UAIF_DATA_MODE		BIT(4)
+#define ABOX_UAIF_IRQ_MODE		BIT(3)
+#define ABOX_UAIF_MODE			BIT(2)	/* 1: ABOX provides clocks */
+#define ABOX_UAIF_MIC_ENABLE		BIT(1)
+#define ABOX_UAIF_SPK_ENABLE		BIT(0)
+/* UAIF_CTRL1 */
+#define ABOX_UAIF_FORMAT		GENMASK(28, 24)
+#define ABOX_UAIF_BCLK_POLARITY		BIT(23)
+#define ABOX_UAIF_WS_MODE		BIT(22)
+#define ABOX_UAIF_WS_POLAR		BIT(21)
+#define ABOX_UAIF_SLOT_MAX		GENMASK(20, 18)
+#define ABOX_UAIF_SBIT_MAX		GENMASK(17, 12)
+#define ABOX_UAIF_VALID_STR		GENMASK(11, 6)
+#define ABOX_UAIF_VALID_END		GENMASK(5, 0)
+
+/* RDMA_CTRL0: the only DMA field the AP writes (downstream hw_params) */
+#define ABOX_RDMA_BURST_LEN		GENMASK(22, 19)
+/* RDMA_CTRL0 / WDMA_CTRL bit 0: the firmware's, except at system sleep */
+#define ABOX_DMA_ENABLE			BIT(0)
+/* engines of the 9820 ABOX (downstream DT abox-rdma@18c51000..b00, abox-wdma@18c53000..700) */
+#define ABOX_NUM_RDMA_HW		12
+#define ABOX_NUM_WDMA_HW		8
+
+/* DMA STATUS (v2.0.1) */
+#define ABOX_DMA_PROGRESS		BIT(31)
+#define ABOX_DMA_RBUF_OFFSET		GENMASK(27, 12)
+#define ABOX_DMA_RBUF_CNT		GENMASK(11, 0)
+
+/* TIMER block (0x18ce0000): TIMER_PRESET_LSB(1), TIMER_CURVALUD_LSB(1) */
+#define ABOX_TIMER1_PRESET		0x0628
+#define ABOX_TIMER1_CURVAL		0x0630
+#define ABOX_TIMER_RATE			26000000ULL
+
+/* SYSREG_AUD */
+#define ABOX_SYSREG_MISC_CON		0x0504
+
+/* PMU (offsets in the PMU syscon) */
+#define PMU_ABOX_PAD_NORMAL		0x1920
+#define PMU_ABOX_PAD_NORMAL_MASK	BIT(11)
+#define PMU_ABOX_CORE0_POWER		0x2d80
+#define PMU_ABOX_CORE0_ENABLE		0x2da0
+#define PMU_ABOX_CORE0_STANDBY		0x2da4
+#define PMU_ABOX_CORE0_STANDBY_MASK	0x11
+#define PMU_ABOX_CORE1_POWER		0x2e00
+#define PMU_ABOX_CORE1_ENABLE		0x2e20
+#define PMU_ABOX_CORE1_STANDBY		0x2e24
+#define PMU_ABOX_CORE1_STANDBY_MASK	0x1
+
+/* GIC-400 inside the ABOX (the AP is one of its CPU interfaces) */
+#define GICD_CTRL			0x000
+#define GICD_IGROUP(n)			(0x080 + 4 * (n))
+#define GICD_PRI(n)			(0x400 + 4 * (n))
+#define GICD_SGIR			0xf00
+#define GICC_CTRL			0x000
+#define GICC_PMR			0x004
+#define GICC_IAR			0x00c
+#define GICC_EOIR			0x010
+#define GICC_DIR			0x1000
+#define GICC_IAR_ID			GENMASK(9, 0)
+#define ABOX_SGI_IPC			15	/* ipc version 2 doorbell */
+
+/* SRAM layout (from the downstream DT) */
+#define ABOX_SRAM_CORE1_OFFSET		0x32000
+#define ABOX_IPC_RX_OFFSET		0x2f300	/* legacy mailbox fw -> AP */
+#define ABOX_IPC_RX_ACK_OFFSET		0x2f5fc
+
+/* DRAM carve-out seen by the firmware */
+#define ABOX_IOVA_DRAM			0x80000000
+#define ABOX_DRAM_SIZE			0x1c00000
+#define ABOX_DRAM_CORE1_OFFSET		0x280000
+#define ABOX_IPC_TX_OFFSET		0x850000
+#define ABOX_IPC_RX_Q_OFFSET		0x854000
+#define ABOX_IPC_Q_SIZE			0x4000
+#define ABOX_IOVA_RDMA(x)		(0x91000000 + SZ_1M * (x))
+#define ABOX_IOVA_WDMA(x)		(0x92000000 + SZ_1M * (x))
+#define ABOX_IOVA_PRIVATE		0xe0000000
+#define ABOX_PRIVATE_SIZE		SZ_8M
+#define ABOX_IOVA_CHIPID		0x10000000
+/*
+ * VSS (the voice call software of the CP image, which runs on the ABOX)
+ * shared memory. Downstream maps the CP's VSS region (modem_if + 0x7800000,
+ * 8 MiB) and the voice parameter area (modem_if + 0xb700000, 2 MiB) here;
+ * its abox-vss driver clears the "CP magic" at VSS + 0x700000 before the CP
+ * boots, and the CP sets it once VSS may start. The firmware polls that
+ * word from boot on; without a mapping it faults forever and never reports
+ * ready. Without a modem (vss_cp=0) zeroed buffers stand in for both
+ * regions (magic 0 = no VSS). With vss_cp=1 the real CP regions are mapped
+ * (inside the no-map modem_if carve-out); the modem loader clears the magic.
+ */
+#define ABOX_IOVA_VSS			0xa0000000
+#define ABOX_VSS_SIZE			SZ_8M
+#define ABOX_IOVA_VSS_PARAM		0xa1000000
+#define ABOX_VSS_PARAM_SIZE		SZ_2M
+#define ABOX_VSS_PHYS			0xf7800000	/* modem_if + 0x7800000 */
+#define ABOX_VSS_PARAM_PHYS		0xfb700000	/* modem_if + 0xb700000 */
+#define ABOX_VSS_MAGIC_OFFSET		0x700000	/* DS DT abox-vss magic-offset */
+#define PMU_CP_STATUS			0x3004		/* bit 0: CP powered */
+
+/* CP voice call: VSS plays into RDMA4 and records from WDMA2 (DS DT "call") */
+#define ABOX_CALL_RDMA			4
+#define ABOX_CALL_WDMA			2
+#define ABOX_CALL_NSRC			(ABOX_CALL_WDMA - 1)
+
+#define ABOX_BUF_BYTES_MAX		SZ_512K
+/*
+ * The firmware copies every open stream into an "entity buffer" of
+ * period_bytes * periods taken from one 512 KiB heap; when it runs out
+ * ("Not enough memory") the stream stalls. 128 KiB per stream leaves room
+ * for UAIF0 playback, UAIF0 capture and UAIF1 at the same time.
+ */
+#define ABOX_PCM_BYTES_MAX		SZ_128K
+#define ABOX_PLL_RATE_48K		1179648040UL	/* table rate, 840 ppb off nominal */
+#define ABOX_AUDIF_RATE_48K		73728000UL	/* 384 kHz * 96 * 2 */
+
+#define ABOX_MSG_TIMEOUT_NS		(1 * NSEC_PER_MSEC)
+#define ABOX_MSG_FLUSH_TIMEOUT_US	20000
+#define ABOX_BOOT_TIMEOUT_MS		3000
+/* PCM open/startup: firmware files from the rootfs + boot */
+#define ABOX_READY_TIMEOUT_MS		10000
+#define ABOX_DMA_TIMEOUT_MS		100
+/* DMA disable barrier, as downstream (ABOX_DMA_TIMEOUT_NS) */
+#define ABOX_DMA_IDLE_TIMEOUT_US	40000
+#define ABOX_IRQ_LOOP_MAX		64
+/* downstream abox_cpu_suspend_complete() / abox_core_standby() */
+#define ABOX_SUSPEND_TIMEOUT_US		100000
+
+#define ABOX_NUM_UAIF			2
+
+enum abox_state {
+	ABOX_STATE_OFF,
+	ABOX_STATE_BOOTING,
+	ABOX_STATE_ON,
+	ABOX_STATE_FAILED,
+};
+
+struct abox_dma {
+	int id;
+	bool capture;
+	dma_addr_t iova;		/* fixed IOVA given to the firmware */
+	struct snd_dma_buffer dmab;	/* DMA-API buffer (mmap, CPU access) */
+	struct snd_pcm_substream *substream;
+	u32 pointer;			/* last IOVA reported by the firmware */
+	bool ack_enabled;		/* firmware asked for PLTDAI_ACK */
+	bool triggered;			/* TRIGGER(1) sent since the last HW_FREE */
+	u32 status_at_free;		/* DMA STATUS right after HW_FREE */
+	struct completion closed;	/* PLTDAI_CLOSED received */
+	bool mapped;
+	/* firmware state to replay after a system sleep */
+	bool fw_open;			/* PLTDAI_OPEN sent, no CLOSE yet */
+	bool fw_hw;			/* SET_BUFFER + HW_PARAMS sent */
+	u32 period_bytes, periods;
+	u32 rate, width, channels;
+};
+
+/* SIFS/SIFM rate and format told to the firmware by UAIF hw_params */
+struct abox_uaif_cfg {
+	bool valid;
+	int rate;
+	int fmt_p1, fmt_p2;
+};
+
+struct abox_uaif {
+	unsigned int fmt;
+	unsigned int slots;
+	unsigned int slot_width;
+	struct clk *bclk;
+	int rdma;		/* -1: no playback */
+	int wdma;		/* -1: no capture */
+	int sifs;		/* SIFS used for playback */
+	int nsrc;		/* NSRC used for capture */
+	struct abox_uaif_cfg cfg[2];	/* per SNDRV_PCM_STREAM_* */
+};
+
+struct abox {
+	struct device *dev;
+	void __iomem *sfr;
+	void __iomem *sysreg;
+	void __iomem *sram;
+	size_t sram_size;
+	void __iomem *timer;
+	void __iomem *gicd;
+	void __iomem *gicc;
+	struct regmap *pmu;
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct clk *clk_pll;
+	struct clk *clk_pll_mux;	/* optional: OSCCLK / PLL_AUD0 */
+	struct clk *clk_audif;
+	struct iommu_domain *domain;
+
+	void *dram;
+	dma_addr_t dram_dma;
+	void *priv;
+	dma_addr_t priv_dma;
+	void *vss;
+	dma_addr_t vss_dma;
+	void *vss_param;
+	dma_addr_t vss_param_dma;
+	bool vss_cp;			/* real CP regions mapped */
+
+	/* debugfs: raw firmware memory (log/dump buffers live in DRAM) */
+	struct dentry *dbg;
+	struct debugfs_blob_wrapper dbg_dram;
+
+	struct abox_msg_queue *txq;
+	struct abox_msg_queue *rxq;
+	spinlock_t tx_lock;
+	spinlock_t rx_lock;
+
+	enum abox_state state;
+	u32 fw_version;
+	wait_queue_head_t wait;
+	struct work_struct boot_work;
+	struct mutex lock;
+
+	struct abox_dma rdma[2];
+	struct abox_dma wdma[2];
+	struct abox_uaif uaif[ABOX_NUM_UAIF];
+
+	/* CP voice call (VSS): hostless firmware channels, no ALSA PCM */
+	struct abox_dma call_rx;	/* RDMA4: VSS downlink -> amps */
+	struct abox_dma call_tx;	/* WDMA2: mics -> VSS uplink */
+	bool call_on;			/* "ABOX Voice Call" switch */
+	bool call_fw;			/* call channels open in the firmware */
+	int audio_mode;			/* enum abox_audio_mode */
+	int sound_type;			/* enum abox_sound_type */
+	struct debugfs_blob_wrapper dbg_call_rx;
+	struct debugfs_blob_wrapper dbg_call_tx;
+
+	int irq;
+
+	/* system sleep: firmware stopped, AP-owned SFR fields to restore */
+	bool sleeping;
+	bool restore;
+	unsigned int num_sfr;
+	struct abox_sfr_save {
+		u16 reg;
+		u32 mask;
+		u32 val;
+	} sfr_save[16];
+};
+
+/*
+ * UAIF0 playback uses RDMA2, not RDMA0.
+ * Calliope MUL0 (calliope2 PCM handler, trigger case of PLTDAI msgtype 17):
+ * for channel 0 and 7 the trigger only records the source ("source assigned
+ * for the entity") and RDMA_CTRL0.enable is set later by
+ * __rdma_primcom_source_update(), i.e. by a firmware component linked with
+ * the RDMA0_A kcontrol of calliope2.dt. Every other channel is enabled in
+ * the trigger itself ("PCM output %d started").
+ */
+
+static bool vss_cp;
+module_param(vss_cp, bool, 0444);
+MODULE_PARM_DESC(vss_cp, "Map the CP's VSS and voice parameter regions for voice calls (default: false = zeroed stand-ins)");
+
+/*
+ * Call channel formats, used when the "ABOX Voice Call" switch goes on.
+ * As the stock HAL's hostless call PCMs: 32 kHz, 16 bit, stereo.
+ * VSS programs the DMA format (16 bit stereo) and buffers itself; the rate
+ * is what the firmware compares with the SIFS/SIFM rate (48 kHz) to set up
+ * the SPUS/SPUM ASRC. With 48 kHz / 32 bit / 4 ch and no ASRC the first
+ * call was heard pitched far down in both directions. The SPUS/SPUM ASRC
+ * is on when the call rate differs from 48 kHz.
+ *
+ * Downlink: RDMA4 -> SIFS0 (mixer, converts formats as on stock) and UAIF1
+ * takes SIFS0 instead of SIFS1 for the call (mixer in the amplifier TDM
+ * format). The NSRC0/NSRC1 bridge bits are set while the call uplink shares
+ * UAIF0 with the mic capture.
+ */
+#define ABOX_CALL_RX_RATE		32000
+#define ABOX_CALL_RX_WIDTH		16
+#define ABOX_CALL_RX_CHANNELS		2
+#define ABOX_CALL_TX_RATE		32000
+#define ABOX_CALL_TX_WIDTH		16
+#define ABOX_CALL_TX_CHANNELS		2
+#define ABOX_CALL_PERIOD_FRAMES		480
+#define ABOX_CALL_PERIODS		4
+
