+obj-$(CONFIG_SND_SOC_SAMSUNG_EXYNOS9820_ABOX) += snd-soc-exynos9820-abox.o
 obj-$(CONFIG_SND_SOC_SAMSUNG_ARIES_WM8994) += snd-soc-aries-wm8994.o
