+static int abox_audio_mode_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+
+	uc->value.enumerated.item[0] = abox->audio_mode;
+	return 0;
+}
+
+static int abox_audio_mode_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+	unsigned int v = uc->value.enumerated.item[0];
+	int ret = 0;
+
+	if (v >= ARRAY_SIZE(abox_audio_mode_texts))
+		return -EINVAL;
+
+	mutex_lock(&abox->lock);
+	if (abox->state == ABOX_STATE_ON)
+		ret = abox_system_ipc(abox, ABOX_SET_MODE, v);
+	if (!ret) {
+		ret = abox->audio_mode != v;
+		abox->audio_mode = v;
+		dev_info(abox->dev, "audio mode %s\n", abox_audio_mode_texts[v]);
+	}
+	mutex_unlock(&abox->lock);
+	return ret;
+}
