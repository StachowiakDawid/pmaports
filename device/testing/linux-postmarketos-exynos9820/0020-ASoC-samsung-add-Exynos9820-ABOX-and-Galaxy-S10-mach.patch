+static int abox_sound_type_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *uc)
+{
+	struct abox *abox = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+
+	uc->value.enumerated.item[0] = abox->sound_type;
+	return 0;
+}
