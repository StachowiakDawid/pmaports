+
+/* ---------------------------------------------------------------------- */
+/* System sleep                                                           */
+
+/*
+ * genpd powers AUD off in the noirq phase of a system suspend as soon as
+ * every device of the domain (ABOX, SYSMMU_AUD, GPIO_AUD) has gone through
+ * its noirq callbacks, whatever their runtime PM state: genpd_sync_power_off()
+ * only compares suspended_count with device_count. So the runtime PM
+ * reference taken at probe does not keep the domain on, and it does not need
+ * to be dropped either. What matters is that the DSP is stopped before the
+ * power goes, and that everything the domain loses is rebuilt afterwards:
+ *
+ *  .suspend (normal phase)   ABOX: stop the firmware (below)
+ *  .suspend                  SYSMMU_AUD (supplier of ABOX, device link):
+ *                            pm_runtime_force_suspend() -> SysMMU disabled
+ *  .suspend_late             GPIO_AUD: pin state saved (AUD still on)
+ *  .suspend_noirq            genpd: AUD off (CMU_AUD/SYSREG_AUD saved,
+ *                            D_TZPC_AUD saved by EL3)
+ *  .resume_noirq             genpd: AUD on, D_TZPC_AUD and CMU_AUD restored
+ *  .resume_early             GPIO_AUD: pin state restored
+ *  .resume                   SYSMMU_AUD: page table base restored
+ *  .resume                   ABOX: queue the firmware boot (below)
+ *
+ * The firmware is booted again from a freezable work item, i.e. after all
+ * devices have resumed and tasks are thawed: the boot reads the firmware
+ * files (from the firmware cache, or from the rootfs for the optional ones)
+ * and must not wait for a block device that has not resumed yet. PCM opens
+ * in the meantime wait in abox_wait_ready().
+ *
+ * Downstream (abox_disable/abox_cpu_pm_ipc) sends ABOX_SUSPEND with the AP
+ * and ABOX timestamps, waits for the firmware to clear TIMER_PRESET_LSB(1)
+ * ("suspend complete") and for both cores to report STANDBYWFI in the PMU,
+ * then drops the DRAM access request. With the timer gone after the power
+ * cycle it boots the firmware from scratch on the next enable, as we do.
+ */
+static void abox_sfr_save(struct abox *abox, u32 reg, u32 mask)
+{
+	struct abox_sfr_save *e;
+
+	if (WARN_ON(abox->num_sfr >= ARRAY_SIZE(abox->sfr_save)))
+		return;
+	e = &abox->sfr_save[abox->num_sfr++];
+	e->reg = reg;
+	e->mask = mask;
+	e->val = readl(abox->sfr + reg) & mask;
+}
+
+/* the AP-owned fields of the SFRs (the firmware programs the rest) */
+static void abox_save_state(struct abox *abox)
+{
+	int i;
+
+	abox->num_sfr = 0;
+	abox_sfr_save(abox, ABOX_QCHANNEL_DISABLE,
+		      ABOX_QCH_BCLK_UAIF(0) | ABOX_QCH_BCLK_UAIF(1));
+	abox_sfr_save(abox, ABOX_SPUS_CTRL1, ABOX_MIXP_FORMAT_MASK);
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		/* the port enables come back with the next trigger */
+		abox_sfr_save(abox, ABOX_UAIF_CTRL0(i),
+			      ~(u32)(ABOX_UAIF_SPK_ENABLE | ABOX_UAIF_MIC_ENABLE));
+		abox_sfr_save(abox, ABOX_UAIF_CTRL1(i), ~0U);
+	}
+	for (i = 0; i < 2; i++) {
+		struct abox_dma *r = &abox->rdma[i], *w = &abox->wdma[i];
+
+		if (r->mapped) {
+			abox_sfr_save(abox, ABOX_SPUS_SBANK_RDMA(r->id),
+				      ABOX_SBANK_SIZE_MASK);
+			abox_sfr_save(abox, ABOX_RDMA_CTRL0(r->id),
+				      ABOX_RDMA_BURST_LEN);
+		}
+		if (w->mapped && w->id >= 1)
+			abox_sfr_save(abox, ABOX_SPUM_SBANK_NSRC(w->id - 1),
+				      ABOX_SBANK_SIZE_MASK);
+	}
+}
+
+/*
+ * Called with the firmware running again: restore the AP-owned SFRs and
+ * replay the firmware state of the PCMs that stayed open across the sleep
+ * (ALSA put them in SUSPENDED; without SNDRV_PCM_INFO_RESUME user space
+ * re-prepares them, so OPEN, the SIFS/SIFM config, SET_BUFFER and
+ * HW_PARAMS must be known to the new firmware instance by then).
+ */
+static void abox_restore_state(struct abox *abox)
+{
+	struct abox_ipc_msg msg;
+	unsigned int i;
+	int n;
+
+	for (i = 0; i < abox->num_sfr; i++)
+		abox_update(abox, abox->sfr_save[i].reg, abox->sfr_save[i].mask,
+			    abox->sfr_save[i].val);
+	abox_route_init(abox);
+
+	for (n = 0; n < ABOX_NUM_UAIF; n++) {
+		struct abox_uaif *u = &abox->uaif[n];
+		struct abox_dma *dmas[2] = { &abox->rdma[n], &abox->wdma[n] };
+		int stream;
+
+		for (stream = 0; stream < 2; stream++) {
+			struct abox_dma *dma = dmas[stream];
+
+			if (!dma->mapped || !dma->fw_open)
+				continue;
+
+			memset(&msg, 0, sizeof(msg));
+			if (abox_pcm_ipc(abox, dma, ABOX_PCM_PLTDAI_OPEN, &msg,
+					 true)) {
+				dma->fw_open = false;
+				dma->fw_hw = false;
+				continue;
+			}
+			if (!dma->fw_hw)
+				continue;
+			abox_uaif_send_cfg(abox, u, stream);
+			if (abox_pcm_send_hw(abox, dma))
+				dma->fw_hw = false;
+			dev_info(abox->dev, "%cDMA%d: firmware state restored\n",
+				 dma->capture ? 'W' : 'R', dma->id);
+		}
+	}
+}
+
+static void abox_suspend_fw(struct abox *abox)
+{
+	struct abox_ipc_msg msg = { .ipcid = ABOX_IPC_SYSTEM };
+	u64 atime;
+	u32 val;
+
+	atime = readq_relaxed(abox->timer + ABOX_TIMER1_CURVAL);
+	atime = div_u64(atime * 500, ABOX_TIMER_RATE / 2000000);
+	msg.msg.system.msgtype = ABOX_SUSPEND;
+	msg.msg.system.bundle.param_u64[0] = sched_clock();
+	msg.msg.system.bundle.param_u64[1] = atime;
+	if (abox_ipc_send(abox, &msg, true))
+		dev_warn(abox->dev, "ABOX_SUSPEND not taken by the firmware\n");
+
+	/* the firmware clears TIMER_PRESET_LSB(1) once it has suspended */
+	if (readl_poll_timeout(abox->timer + ABOX_TIMER1_PRESET, val, !val,
+			       100, ABOX_SUSPEND_TIMEOUT_US))
+		dev_warn(abox->dev, "firmware suspend not complete (timer %#x)\n",
+			 val);
+
+	/* both CA32 cores in WFI */
+	if (regmap_read_poll_timeout(abox->pmu, PMU_ABOX_CORE0_STANDBY, val,
+				     (val & PMU_ABOX_CORE0_STANDBY_MASK) ==
+				     PMU_ABOX_CORE0_STANDBY_MASK,
+				     100, ABOX_SUSPEND_TIMEOUT_US))
+		dev_warn(abox->dev, "core 0 not in standby (%#x)\n", val);
+	if (regmap_read_poll_timeout(abox->pmu, PMU_ABOX_CORE1_STANDBY, val,
+				     (val & PMU_ABOX_CORE1_STANDBY_MASK) ==
+				     PMU_ABOX_CORE1_STANDBY_MASK,
+				     100, ABOX_SUSPEND_TIMEOUT_US))
+		dev_warn(abox->dev, "core 1 not in standby (%#x)\n", val);
+}
+
+/*
+ * Make sure no ABOX DMA engine is still moving data before the
+ * SYSMMU_AUD suspends (next callback) and genpd may cut the domain.
+ *
+ * abox_suspend() waits only for the two RDMA/WDMA pairs this driver hands to
+ * ALSA, and only if they are open. The ABOX has 12 RDMA and 8 WDMA engines
+ * and the firmware may run others itself (Calliope routes RDMA0/7 through
+ * its own components). Powering the CA32 cores off does not
+ * stop an engine: it keeps fetching/writing through the SYSMMU on its own.
+ * The firmware has acknowledged ABOX_SUSPEND (or timed out) and its cores
+ * are off by now, so the enable bits are the AP's to clear.
+ *
+ * Why it matters: once the mainline SYSMMU driver has suspended, the SYSMMU
+ * stopped translating (pass-through, unless the driver leaves a suspended
+ * SYSMMU blocked), and the ABOX IOVAs (0x80000000..) are live DRAM. A WDMA
+ * still running then writes audio data straight into kernel memory.
+ */
+static void abox_quiesce_dma(struct abox *abox)
+{
+	struct device *dev = abox->dev;
+	unsigned int i, stopped = 0, busy = 0;
+	u32 ctrl, st;
+
+	for (i = 0; i < ABOX_NUM_RDMA_HW + ABOX_NUM_WDMA_HW; i++) {
+		bool w = i >= ABOX_NUM_RDMA_HW;
+		unsigned int id = w ? i - ABOX_NUM_RDMA_HW : i;
+		u32 creg = w ? ABOX_WDMA_CTRL(id) : ABOX_RDMA_CTRL0(id);
+
+		ctrl = readl(abox->sfr + creg);
+		if (ctrl & ABOX_DMA_ENABLE) {
+			writel(ctrl & ~ABOX_DMA_ENABLE, abox->sfr + creg);
+			stopped |= BIT(i);
+			dev_info(dev, "%cDMA%u still enabled at suspend (ctrl %#x), stopped\n",
+				 w ? 'W' : 'R', id, ctrl);
+		}
+	}
+
+	for (i = 0; i < ABOX_NUM_RDMA_HW + ABOX_NUM_WDMA_HW; i++) {
+		bool w = i >= ABOX_NUM_RDMA_HW;
+		unsigned int id = w ? i - ABOX_NUM_RDMA_HW : i;
+		u32 sreg = w ? ABOX_WDMA_STATUS(id) : ABOX_RDMA_STATUS(id);
+
+		if (!readl_poll_timeout(abox->sfr + sreg, st,
+					!(st & ABOX_DMA_PROGRESS), 100,
+					stopped & BIT(i) ?
+					ABOX_DMA_IDLE_TIMEOUT_US : 1000))
+			continue;
+		busy |= BIT(i);
+		dev_err(dev, "%cDMA%u still in progress at suspend (status %#x ctrl %#x)\n",
+			w ? 'W' : 'R', id, st,
+			readl(abox->sfr + (w ? ABOX_WDMA_CTRL(id) :
+					       ABOX_RDMA_CTRL0(id))));
+	}
+
+	if (stopped || busy)
+		dev_warn(dev, "DMA quiesce: stopped %#x, still busy %#x (bit = RDMA0..11, WDMA0..7 from bit 12)\n",
+			 stopped, busy);
+}
+
+static int abox_suspend(struct device *dev)
+{
+	struct abox *abox = dev_get_drvdata(dev);
+	unsigned int i;
+	u32 val;
+
+	/*
+	 * A boot still pending (probe, or the previous resume) is cancelled;
+	 * one that is running is waited for. Both leave the state consistent
+	 * for the stop below.
+	 */
+	cancel_work_sync(&abox->boot_work);
+
+	mutex_lock(&abox->lock);
+
+	for (i = 0; i < 2; i++) {
+		if (abox->rdma[i].mapped && abox->rdma[i].fw_open)
+			abox_dma_wait_idle(abox, &abox->rdma[i], "at suspend");
+		if (abox->wdma[i].mapped && abox->wdma[i].fw_open)
+			abox_dma_wait_idle(abox, &abox->wdma[i], "at suspend");
+	}
+
+	abox->restore = abox->state == ABOX_STATE_ON;
+	if (abox->restore) {
+		abox_save_state(abox);
+		abox_suspend_fw(abox);
+	}
+	if (abox->call_fw)
+		dev_warn(dev, "system sleep during a voice call: call path restarts on resume\n");
+	abox->call_fw = false;
+	abox->call_rx.fw_open = abox->call_rx.fw_hw = false;
+	abox->call_tx.fw_open = abox->call_tx.fw_hw = false;
+	abox->call_rx.triggered = abox->call_tx.triggered = false;
+
+	/* no more IPC: the firmware is not listening any more */
+	abox->state = ABOX_STATE_OFF;
+	disable_irq(abox->irq);
+
+	abox_cores_power(abox, false);
+	abox_quiesce_dma(abox);
+	/* drop the DRAM access request */
+	writel(0, abox->sfr + ABOX_SYSPOWER_CTRL);
+	if (readl_poll_timeout(abox->sfr + ABOX_SYSPOWER_STATUS, val,
+			       !(val & 0x1), 10, 10000))
+		dev_warn(dev, "SYSPOWER_STATUS still %#x after the DRAM request was dropped\n",
+			 val);
+	abox->sleeping = true;
+	wake_up_all(&abox->wait);
+
+	mutex_unlock(&abox->lock);
+
+	dev_dbg(dev, "firmware stopped for system sleep\n");
+	return 0;
+}
+
+static int abox_resume(struct device *dev)
+{
+	struct abox *abox = dev_get_drvdata(dev);
+
+	if (!abox->sleeping)
+		return 0;
+
+	mutex_lock(&abox->lock);
+	abox->sleeping = false;
+	enable_irq(abox->irq);
+	/* PCM opens wait for the outcome, see abox_wait_ready() */
+	abox->state = ABOX_STATE_BOOTING;
+	queue_work(system_freezable_wq, &abox->boot_work);
+	mutex_unlock(&abox->lock);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(abox_pm_ops, abox_suspend, abox_resume);
+
+static int abox_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct abox *abox;
+	int i, irq, ret;
+
+	abox = devm_kzalloc(dev, sizeof(*abox), GFP_KERNEL);
+	if (!abox)
+		return -ENOMEM;
+
+	abox->dev = dev;
+	platform_set_drvdata(pdev, abox);
+	spin_lock_init(&abox->tx_lock);
+	spin_lock_init(&abox->rx_lock);
+	init_waitqueue_head(&abox->wait);
+	mutex_init(&abox->lock);
+	INIT_WORK(&abox->boot_work, abox_boot_work);
+
+	abox->sfr = devm_platform_ioremap_resource_byname(pdev, "sfr");
+	if (IS_ERR(abox->sfr))
+		return PTR_ERR(abox->sfr);
+	abox->sysreg = devm_platform_ioremap_resource_byname(pdev, "sysreg");
+	if (IS_ERR(abox->sysreg))
+		return PTR_ERR(abox->sysreg);
+	abox->sram = devm_platform_get_and_ioremap_resource(pdev, 2, &res);
+	if (IS_ERR(abox->sram))
+		return PTR_ERR(abox->sram);
+	abox->sram_size = resource_size(res);
+	abox->timer = devm_platform_ioremap_resource_byname(pdev, "timer");
+	if (IS_ERR(abox->timer))
+		return PTR_ERR(abox->timer);
+	abox->gicd = devm_platform_ioremap_resource_byname(pdev, "gicd");
+	if (IS_ERR(abox->gicd))
+		return PTR_ERR(abox->gicd);
+	abox->gicc = devm_platform_ioremap_resource_byname(pdev, "gicc");
+	if (IS_ERR(abox->gicc))
+		return PTR_ERR(abox->gicc);
+
+	abox->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						    "samsung,pmu-syscon");
+	if (IS_ERR(abox->pmu))
+		return dev_err_probe(dev, PTR_ERR(abox->pmu), "no PMU syscon\n");
+
+	abox->num_clks = ARRAY_SIZE(abox_clk_names);
+	abox->clks = devm_kcalloc(dev, abox->num_clks, sizeof(*abox->clks),
+				  GFP_KERNEL);
+	if (!abox->clks)
+		return -ENOMEM;
+	for (i = 0; i < abox->num_clks; i++)
+		abox->clks[i].id = abox_clk_names[i];
+	ret = devm_clk_bulk_get(dev, abox->num_clks, abox->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	abox->clk_pll = devm_clk_get(dev, "pll");
+	if (IS_ERR(abox->clk_pll))
+		return dev_err_probe(dev, PTR_ERR(abox->clk_pll), "no pll clock\n");
+	abox->clk_pll_mux = devm_clk_get_optional(dev, "pll-mux");
+	if (IS_ERR(abox->clk_pll_mux))
+		return dev_err_probe(dev, PTR_ERR(abox->clk_pll_mux),
+				     "bad pll-mux clock\n");
+	abox->clk_audif = devm_clk_get(dev, "audif");
+	if (IS_ERR(abox->clk_audif))
+		return dev_err_probe(dev, PTR_ERR(abox->clk_audif),
+				     "no audif clock\n");
+
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		char name[8];
+
+		snprintf(name, sizeof(name), "uaif%d", i);
+		abox->uaif[i].bclk = devm_clk_get(dev, name);
+		if (IS_ERR(abox->uaif[i].bclk))
+			return dev_err_probe(dev, PTR_ERR(abox->uaif[i].bclk),
+					     "no %s clock\n", name);
+	}
+
+	/* fixed routing, see the comment at the top */
+	abox->uaif[0] = (struct abox_uaif) {
+		.bclk = abox->uaif[0].bclk,
+		.fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF,
+		.rdma = 2, .sifs = 0, .wdma = 1, .nsrc = 0,
+	};
+	abox->uaif[1] = (struct abox_uaif) {
+		.bclk = abox->uaif[1].bclk,
+		.fmt = SND_SOC_DAIFMT_DSP_A | SND_SOC_DAIFMT_IB_NF,
+		.rdma = 1, .sifs = 1, .wdma = -1, .nsrc = -1,
+	};
+	/* dma tables indexed by UAIF number */
+	abox->rdma[0].id = -1;
+	abox->rdma[1].id = -1;
+	abox->wdma[0].id = -1;
+	abox->wdma[1].id = -1;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	abox->irq = irq;
+
+	pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		goto err_pm;
+
+	ret = clk_bulk_prepare_enable(abox->num_clks, abox->clks);
+	if (ret)
+		goto err_rpm;
+
+	ret = abox_alloc_memory(abox);
+	if (ret)
+		goto err_clk;
+
+	abox->dbg = debugfs_create_dir(dev_name(dev), NULL);
+	ret = devm_add_action_or_reset(dev, abox_debugfs_remove, abox->dbg);
+	if (ret)
+		goto err_clk;
+	abox->dbg_dram.data = abox->dram;
+	abox->dbg_dram.size = ABOX_DRAM_SIZE;
+	debugfs_create_blob("dram", 0400, abox->dbg, &abox->dbg_dram);
+	debugfs_create_file("component", 0200, abox->dbg, abox,
+			    &abox_dbg_component_fops);
+	debugfs_create_file("vss", 0200, abox->dbg, abox, &abox_dbg_vss_fops);
+	debugfs_create_file("gear", 0200, abox->dbg, abox, &abox_dbg_gear_fops);
+
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		struct abox_uaif *u = &abox->uaif[i];
+
+		if (u->rdma >= 0) {
+			ret = abox_dma_init(abox, &abox->rdma[i], u->rdma, false);
+			if (ret)
+				goto err_dma;
+		}
+		if (u->wdma >= 0) {
+			ret = abox_dma_init(abox, &abox->wdma[i], u->wdma, true);
+			if (ret)
+				goto err_dma;
+		}
+	}
+
+	/* CP voice call channels (hostless, buffers only for the firmware) */
+	abox->call_rx.id = -1;
+	abox->call_tx.id = -1;
+	ret = abox_dma_init(abox, &abox->call_rx, ABOX_CALL_RDMA, false);
+	if (!ret)
+		ret = abox_dma_init(abox, &abox->call_tx, ABOX_CALL_WDMA, true);
+	if (ret)
+		goto err_dma;
+	abox->dbg_call_rx.data = abox->call_rx.dmab.area;
+	abox->dbg_call_rx.size = ABOX_BUF_BYTES_MAX;
+	debugfs_create_blob("call_rx", 0400, abox->dbg, &abox->dbg_call_rx);
+	abox->dbg_call_tx.data = abox->call_tx.dmab.area;
+	abox->dbg_call_tx.size = ABOX_BUF_BYTES_MAX;
+	debugfs_create_blob("call_tx", 0400, abox->dbg, &abox->dbg_call_tx);
+
+	ret = devm_request_irq(dev, irq, abox_irq, 0, dev_name(dev), abox);
+	if (ret)
+		goto err_dma;
+
+	/*
+	 * The sound card can bind (and PipeWire/WirePlumber open its PCMs)
+	 * as soon as the component is registered, before the boot work has
+	 * even loaded the firmware files. Mark the firmware as booting first
+	 * so that abox_wait_ready() waits for the outcome instead of seeing
+	 * ABOX_STATE_OFF and failing; abox_boot_work() sets ON or FAILED and
+	 * wakes the waiters.
+	 */
+	abox->state = ABOX_STATE_BOOTING;
+
+	ret = snd_soc_register_component(dev, &abox_component, abox_dais,
+					 ARRAY_SIZE(abox_dais));
+	if (ret)
+		goto err_dma;
+
+	schedule_work(&abox->boot_work);
+
+	return 0;
+
+err_dma:
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		abox_dma_free(abox, &abox->rdma[i]);
+		abox_dma_free(abox, &abox->wdma[i]);
+	}
+	abox_dma_free(abox, &abox->call_rx);
+	abox_dma_free(abox, &abox->call_tx);
+	abox_free_memory(abox);
+err_clk:
+	clk_bulk_disable_unprepare(abox->num_clks, abox->clks);
+err_rpm:
+	pm_runtime_put_sync(dev);
+err_pm:
+	pm_runtime_disable(dev);
+	return ret;
+}
+
+static void abox_remove(struct platform_device *pdev)
+{
+	struct abox *abox = platform_get_drvdata(pdev);
+	int i;
+
+	/* unbinds the sound card first, so no PCM op can run after this */
+	snd_soc_unregister_component(&pdev->dev);
+	cancel_work_sync(&abox->boot_work);
+	mutex_lock(&abox->lock);
+	abox_stop(abox);
+	mutex_unlock(&abox->lock);
+
+	/* the IRQ is devm: make sure it cannot fire into freed buffers */
+	devm_free_irq(&pdev->dev, abox->irq, abox);
+
+	for (i = 0; i < ABOX_NUM_UAIF; i++) {
+		abox_dma_free(abox, &abox->rdma[i]);
+		abox_dma_free(abox, &abox->wdma[i]);
+	}
+	abox_dma_free(abox, &abox->call_rx);
+	abox_dma_free(abox, &abox->call_tx);
+	abox_free_memory(abox);
+	clk_bulk_disable_unprepare(abox->num_clks, abox->clks);
+	pm_runtime_put_sync(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static const struct of_device_id abox_of_match[] = {
+	{ .compatible = "samsung,exynos9820-abox" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, abox_of_match);
+
+static struct platform_driver abox_driver = {
+	.driver = {
+		.name = "exynos9820-abox",
+		.of_match_table = abox_of_match,
+		.pm = pm_sleep_ptr(&abox_pm_ops),
+	},
+	.probe = abox_probe,
+	.remove = abox_remove,
+};
+module_platform_driver(abox_driver);
+
+MODULE_DESCRIPTION("Exynos9820 ABOX audio subsystem (firmware-driven DMA, UAIF)");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE("abox/calliope_sram.bin");
+MODULE_FIRMWARE("abox/calliope_dram.bin");
+MODULE_FIRMWARE("abox/calliope_sram_2.bin");
+MODULE_FIRMWARE("abox/calliope_dram_2.bin");
