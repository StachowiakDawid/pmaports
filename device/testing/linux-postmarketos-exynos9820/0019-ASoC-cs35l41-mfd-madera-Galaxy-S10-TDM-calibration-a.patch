--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -827,6 +827,7 @@ config SND_SOC_CS35L41_LIB
 config SND_SOC_CS35L41
 	tristate
 	select SND_SOC_WM_ADSP
