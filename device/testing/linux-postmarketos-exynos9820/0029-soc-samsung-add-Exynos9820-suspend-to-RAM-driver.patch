+	[0] = "CL1_DBGRST0", [1] = "CL1_DBGRST1", [2] = "CL1_DBGRST2",
+	[3] = "CL1_DBGRST3", [4] = "CL0_DBGRST0", [5] = "CL0_DBGRST1",
+	[6] = "CL0_DBGRST2", [7] = "CL0_DBGRST3", [8] = "CL1_WARMRST0",
+	[9] = "CL1_WARMRST1", [10] = "CL1_WARMRST2", [11] = "CL1_WARMRST3",
+	[12] = "CL0_WARMRST0", [13] = "CL0_WARMRST1", [14] = "CL0_WARMRST2",
+	[15] = "CL0_WARMRST3",
+	[16] = "PINRESET", [19] = "CHUB_WDT", [20] = "APM_WDT", [21] = "APM_SYSRESET",
+	[22] = "VTS_WDT", [23] = "CL2_WDT", [24] = "CL0_WDT", [25] = "AUD_WDT",
+	[26] = "SSS_WDT", [28] = "WRESET", [29] = "SWRESET",
+};
+static const char * const pwronsrc_bits[8] = {
+	"PWRON", "JIGONB", "ACOKB", "MRST", "ALARM1", "ALARM2", "SMPL", "WTSR",
+};
+static const char * const offsrc_bits[8] = {
+	"?0", "TSD", "TIMEOUT", "LDO3OK", "PWRHOLD", "?5", "?6", "UVLOB",
+};
+
+/* set when an IRQs-off transfer timed out: skip the rest of this suspend */
+static bool bc_dead;
+
+/*
+ * Process context: an ordinary ACPM transfer. IRQs off (syscore, ->enter,
+ * only CPU0 left): the bounded atomic variant, which fails with -EBUSY at
+ * once if a normal transfer holds the channel, and no retry: the holder
+ * cannot run before we return.
+ */
+static int bc_xfer(bool write, u8 type, u8 reg, u8 count, u8 *buf)
+{
+	bool atomic = irqs_disabled();
+	int ret;
+
+	if (atomic && bc_dead)
+		return -ETIME;
+	if (write)
+		ret = exynos_acpm_pmic_dbg_bulk_write(BC_ACPM_CHAN, type, reg,
+						      BC_SPEEDY, count, buf,
+						      atomic);
+	else
+		ret = exynos_acpm_pmic_dbg_bulk_read(BC_ACPM_CHAN, type, reg,
+						     BC_SPEEDY, count, buf,
+						     atomic);
+	if (atomic && (ret == -ETIME || ret == -ETIMEDOUT))
+		bc_dead = true;
+	return ret;
+}
+
+static int bc_rtc_update(u8 bit)
+{
+	u8 v;
+	int ret;
+
+	ret = bc_xfer(false, BC_TYPE_RTC, S2MPS19_RTC_UPDATE, 1, &v);
+	if (ret)
+		return ret;
+	v &= ~(S2MPS19_RTC_RUDR | S2MPS19_RTC_WUDR | S2MPS19_RTC_FREEZE |
+	       S2MPS19_RTC_AUDR);
+	v |= bit;
+	ret = bc_xfer(true, BC_TYPE_RTC, S2MPS19_RTC_UPDATE, 1, &v);
+	if (ret)
+		return ret;
+	/* downstream: 1 ms after every RTC update */
+	if (irqs_disabled())
+		udelay(1000);
+	else
+		usleep_range(1000, 1500);
+	return 0;
+}
+
+static int bc_raw_write(const u8 b[BC_LEN])
+{
+	u8 buf[BC_LEN];
+	int i, ret;
+
+	for (i = 0; i < BC_LEN; i++)
+		buf[i] = b[i] & 0x7f;	/* never set an alarm-enable bit */
+	ret = bc_xfer(true, BC_TYPE_RTC, S2MPS19_RTC_A1SEC, BC_LEN, buf);
+	if (!ret)
+		ret = bc_rtc_update(S2MPS19_RTC_AUDR);
+	return ret;
+}
+
+static int bc_raw_read(u8 b[BC_LEN])
+{
+	int ret = bc_rtc_update(S2MPS19_RTC_RUDR);
+
+	if (!ret)
+		ret = bc_xfer(false, BC_TYPE_RTC, S2MPS19_RTC_A1SEC, BC_LEN, b);
+	return ret;
+}
+
+static void __bc_write(u8 stage, u32 a0, u32 a1, u32 a2)
+{
+	u8 b[BC_LEN] = { BC_MAGIC, stage, bc_seq, (u8)a0, (u8)a1 & 0x3f, (u8)a2 & 0x1f, 0 };
+	int i;
+
+	for (i = 0; i < BC_LEN - 1; i++) {
+		b[i] &= 0x7f;
+		b[BC_LEN - 1] ^= b[i];
+	}
+	bc_ret = bc_raw_write(b);
+	bc_last_stage = stage;
+}
+
+static void bc_write(u8 stage, u32 a0, u32 a1, u32 a2)
+{
+	if (bc)
+		__bc_write(stage, a0, a1, a2);
+}
+
+static void bc_decode(const char *tag, const u8 b[BC_LEN])
+{
+	u8 x = 0;
+	int i;
+
+	for (i = 0; i < BC_LEN - 1; i++)
+		x ^= b[i] & 0x7f;
+	pr_info("%s: raw %02x %02x %02x %02x %02x %02x %02x\n", tag,
+		b[0], b[1], b[2], b[3], b[4], b[5], b[6]);
+	if ((b[0] & 0x7f) != BC_MAGIC || (b[6] & 0x7f) != x) {
+		pr_info("%s: no valid breadcrumb (magic %#x, xor %#x/%#x)\n",
+			tag, b[0], b[6], x);
+		return;
+	}
+	pr_info("%s: attempt %u, last stage %u = %s, aux %#x %#x %#x\n", tag,
+		b[2] & 0x7f, b[1] & 0x7f,
+		(b[1] & 0x7f) < ARRAY_SIZE(bc_stage_name) &&
+		bc_stage_name[b[1] & 0x7f] ? bc_stage_name[b[1] & 0x7f] :
+		(b[1] & 0x7f) >= BC_UFS0 && (b[1] & 0x7f) < BC_SYSRES0 ?
+		"ufs-exynos resume step (stage - 48): 0 resume (aux0 lost bits, aux1 link), 1 re-init requested (aux1 iocc ok), 2/3 HCE pre/post, 4/5 link startup pre/post, 6 power mode done (aux0 gear) -> NOP OUT/device init" :
+		(b[1] & 0x7f) >= BC_CPUUP0 && (b[1] & 0x7f) < BC_PDRES0 ?
+		"resume: about to bring up CPU (stage - 72); IRQs were re-enabled" :
+		(b[1] & 0x7f) >= BC_PDRES0 && (b[1] & 0x7f) < BC_CLKRES0 ?
+		"about to restore D_TZPC of power domain #(stage - 80), aux0 = STATUS on, see the list" :
+		(b[1] & 0x7f) >= BC_CLKRES0 && (b[1] & 0x7f) < BC_TEST ?
+		"samsung_clk_resume: about to restore clock cache #(stage - 96), see the list" :
+		(b[1] & 0x7f) >= BC_SYSRES0 && (b[1] & 0x7f) < BC_TEST ?
+		"about to call syscore resume #(stage - 64), see the list below" :
+		(b[1] & 0x7f) == BC_TEST ? "bc_test pattern" :
+		(b[1] & 0x7f) == BC_BOOT ? "already reported at a boot" : "?",
+		b[3] & 0x7f, b[4] & 0x7f, b[5] & 0x7f);
+	if ((b[1] & 0x7f) == BC_RETURNED || (b[1] & 0x7f) == BC_EXITED)
+		pr_info("%s: aux = ret/-errno %#x, WAKEUP_STAT[6:0] %#x [13:7] %#x\n",
+			tag, b[3] & 0x7f, b[4] & 0x7f, b[5] & 0x7f);
+}
+
+extern void exynos9820_pd_sleep_dtzpc(bool resume);
+extern void (*exynos9820_pd_sleep_hook)(unsigned int idx, bool on);
+extern void exynos9820_pd_for_each(void (*cb)(unsigned int idx, const char *name, u32 dtzpc));
+
+static void bc_list_pd(unsigned int idx, const char *name, u32 dtzpc)
+{
+	pr_info("exynos9820-suspend: power domain #%u = stage %u: %s D_TZPC %#x\n",
+		idx, 0x50 + idx, name, dtzpc);
+}
+
+static void bc_pd_hook(unsigned int idx, bool on)
+{
+	if (bc && 0x50 + idx < 0x60)
+		__bc_write(0x50 + idx, on, idx, 0);
+}
+
+static void bc_list_syscore(unsigned int idx, void *fn)
+{
+	pr_info("exynos9820-suspend: syscore resume #%u = stage %u: %ps\n",
+		idx, BC_SYSRES0 + idx, fn);
+}
+
+extern void (*samsung_clk_resume_hook)(unsigned int idx, void __iomem *base);
+extern void samsung_clk_for_each_cache(void (*cb)(unsigned int idx, phys_addr_t base,
+						   bool pd_guard));
+
+static void bc_list_clk(unsigned int idx, phys_addr_t base, bool pd_guard)
+{
+	pr_info("exynos9820-suspend: clk cache #%u = stage %u: CMU %pa%s\n",
+		idx, BC_CLKRES0 + idx, &base, pd_guard ? " (pd guard)" : "");
+}
+
+static void bc_clk_hook(unsigned int idx, void __iomem *base)
+{
+	/* stage stays 0x60 from cache #28 on; aux0 always carries the index */
+	if (bc && bc_last_stage >= BC_RETURNED && bc_last_stage != BC_SYSCORE_RESUME)
+		__bc_write(min_t(unsigned int, BC_CLKRES0 + idx, BC_TEST - 1), idx, 0, 0);
+}
+
+#if IS_BUILTIN(CONFIG_SCSI_UFS_EXYNOS)
+extern bool exynos_ufs_soc_power_lost;
+extern void (*exynos_ufs_resume_hook)(unsigned int step, u32 a0, u32 a1);
+
+/* process context (device resume, IRQs on): ordinary ACPM transfers */
+static void bc_ufs_hook(unsigned int step, u32 a0, u32 a1)
+{
+	if (bc && step < BC_SYSRES0 - BC_UFS0 &&
+	    (bc_last_stage == BC_WAKE ||
+	     (bc_last_stage >= BC_UFS0 && bc_last_stage < BC_SYSRES0)))
+		__bc_write(BC_UFS0 + step, a0, a1, 0);
+}
+
+static void e9820_ufs_power_lost(void)
+{
+	WRITE_ONCE(exynos_ufs_soc_power_lost, true);
+}
+
+static void e9820_ufs_hook_init(void)
+{
+	exynos_ufs_resume_hook = bc_ufs_hook;
+}
+#else
+static void e9820_ufs_power_lost(void) { }
+static void e9820_ufs_hook_init(void) { }
+#endif
+
+/* CPUHP_BP_PREPARE_DYN: runs on the control CPU before CPU n is started */
+static int bc_cpu_prepare(unsigned int cpu)
+{
+	if (bc && cpu < 8 &&
+	    (bc_last_stage == BC_SYSCORE_RESUME ||
+	     (bc_last_stage >= BC_CPUUP0 && bc_last_stage < BC_PDRES0)))
+		__bc_write(BC_CPUUP0 + cpu, cpu, 0, 0);
+	return 0;
+}
+
+static void bc_syscore_hook(unsigned int idx, void *fn)
+{
+	/* only during our SLEEP path, after the PSCI call returned */
+	if (bc && bc_last_stage >= BC_RETURNED && bc_last_stage != BC_SYSCORE_RESUME &&
+	    BC_SYSRES0 + idx < BC_TEST)
+		__bc_write(BC_SYSRES0 + idx, idx, 0, 0);
+}
+
+static void bc_print_bits(const char *what, u32 v, const char * const *n,
+			  int nbits)
+{
+	char buf[160];
+	int i, len = 0;
+
+	buf[0] = 0;
+	for (i = 0; i < nbits; i++)
+		if ((v & BIT(i)) && len < (int)sizeof(buf) - 24)
+			len += scnprintf(buf + len, sizeof(buf) - len, " %s",
+					 n[i] ? n[i] : "?");
+	pr_info("boot: %s %#x:%s\n", what, v, len ? buf : " -");
+}
+
+static unsigned int bc_boot_tries;
+static void bc_boot_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(bc_boot_work, bc_boot_fn);
+
+/*
+ * Boot report. Runs from a delayed work (process context, ordinary ACPM
+ * transfers) well after the ACPM and sec-acpm (PMIC) drivers have probed:
+ * first try 30 s after late_initcall_sync, then every 10 s while ACPM
+ * reports -ENODEV, at most 6 times, then give up with a warning.
+ */
+static void bc_boot_fn(struct work_struct *work)
+{
+	u8 b[BC_LEN], src[2], ctrl1, zero = 0;
+	int ret, i;
+
+	ret = bc_raw_read(b);
+	if (ret == -ENODEV && ++bc_boot_tries < 6) {
+		schedule_delayed_work(&bc_boot_work, 10 * HZ);
+		return;
+	}
+
+	/*
+	 * PMU first (plain MMIO). Only INFORM0-5 (0x800-0x814): an earlier
+	 * report stopped right after INFORM5, so the read of 0x818 (INFORM6)
+	 * most likely never completes from the non-secure side.
+	 */
+	if (bc_pmu) {
+		bc_print_bits("PMU RST_STAT", readl(bc_pmu + PMU_RST_STAT),
+			      rst_stat_bits, 32);
+		for (i = 0; i < PMU_INFORM_NUM; i++)
+			pr_info("boot: PMU INFORM%d (%#x) = %#010x\n", i,
+				PMU_INFORM0 + i * 4,
+				readl(bc_pmu + PMU_INFORM0 + i * 4));
+	}
+
+	if (ret) {
+		pr_warn("boot: no PMIC access through ACPM (%d), breadcrumb report skipped\n",
+			ret);
+		return;
+	}
+
+	if (!bc_xfer(false, BC_TYPE_PMIC, S2MPS19_PMIC_PWRONSRC, 2, src)) {
+		bc_print_bits("S2MPS19 PWRONSRC", src[0], pwronsrc_bits, 8);
+		bc_print_bits("S2MPS19 OFFSRC", src[1], offsrc_bits, 8);
+		/* like downstream s2mps19_regulator.c: clear OFFSRC per boot */
+		bc_xfer(true, BC_TYPE_PMIC, S2MPS19_PMIC_OFFSRC, 1, &zero);
+	}
+	if (!bc_xfer(false, BC_TYPE_PMIC, S2MPS19_PMIC_CTRL1, 1, &ctrl1))
+		pr_info("boot: S2MPS19 CTRL1 %#x (manual reset %s)\n", ctrl1,
+			ctrl1 & BIT(4) ? "enabled" : "disabled");
+
+	bc_decode("boot", b);
+	syscore_for_each_resume(bc_list_syscore);
+	samsung_clk_for_each_cache(bc_list_clk);
+	exynos9820_pd_for_each(bc_list_pd);
+	if ((b[0] & 0x7f) == BC_MAGIC)
+		bc_seq = (b[2] + 1) & 0x7f;
+	/* mark it as reported, keep the old stage/attempt in aux0/aux1 */
+	if ((b[1] & 0x7f) != BC_BOOT)
+		bc_write(BC_BOOT, b[1], b[2], 0);
+}
+
+static int __init exynos9820_bc_boot_init(void)
+{
+	if (!bc || !of_machine_is_compatible("samsung,exynos9820"))
+		return 0;
+	bc_pmu = ioremap(PMU_BASE, SZ_64K);
+	schedule_delayed_work(&bc_boot_work, 30 * HZ);
+	return 0;
+}
+late_initcall_sync(exynos9820_bc_boot_init);
+
+static int bc_show_get(char *buf, const struct kernel_param *kp)
+{
