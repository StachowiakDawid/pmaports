+/* ---- Samsung save_sleep[]: CMU (and PLL) state lost in SLEEP ---- */
+
+enum e9820_sr_type { SR_SAVE, SR_COND_SAVE, SR_COND_CHECK_SKIP, SR_WAIT,
+		     SR_CLEAR_PEND };
+
+#define SR_NO_COND	0xff
+
+struct e9820_sr {
+	u8 type;
+	u8 base;		/* index into e9820_save_bases[] */
+	u8 cbase;		/* condition base index, SR_NO_COND if none */
+	u16 offset;
+	u16 cond_offset;
+	u32 mask;
+	u32 value;		/* CHECK_SKIP / WAIT: expected value */
+	u32 cond_mask;
+	u32 cond_value;
+};
+
+#include "exynos9820-suspend-save.h"
+
+static void __iomem *e9820_save_va[ARRAY_SIZE(e9820_save_bases)];
+static u32 *e9820_saved;		/* one value per e9820_save_sleep[] */
+static unsigned long *e9820_need_restore;
+
+static bool e9820_sr_cond(const struct e9820_sr *e)
+{
+	if (e->cbase == SR_NO_COND)
+		return true;
+	return (readl(e9820_save_va[e->cbase] + e->cond_offset) &
+		e->cond_mask) == e->cond_value;
+}
+
+static bool e9820_sr_check(const struct e9820_sr *e)
+{
+	return (readl(e9820_save_va[e->base] + e->offset) & e->mask) ==
+	       e->value;
+}
+
+/* pmucal_rae_save_seq() */
+static void e9820_save(void)
+{
+	const struct e9820_sr *e = e9820_save_sleep;
+	int i;
+
+	bitmap_zero(e9820_need_restore, ARRAY_SIZE(e9820_save_sleep));
+	for (i = 0; i < ARRAY_SIZE(e9820_save_sleep); i++, e++) {
+		void __iomem *va = e9820_save_va[e->base] + e->offset;
+
+		switch (e->type) {
+		case SR_COND_SAVE:
+			if (!e9820_sr_cond(e))
+				break;
+			fallthrough;
+		case SR_SAVE:
+			e9820_saved[i] = readl(va) & e->mask;
+			__set_bit(i, e9820_need_restore);
+			break;
+		case SR_CLEAR_PEND:
+			writel(readl(e9820_save_va[e->cbase] + e->cond_offset) &
+			       e->cond_mask & e->mask, va);
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+/* pmucal_rae_restore_seq() */
+static int e9820_restore(void)
+{
+	const struct e9820_sr *e = e9820_save_sleep;
+	bool skip = false;
+	int i, n = 0, err = 0;
+	u32 reg;
+
+	for (i = 0; i < ARRAY_SIZE(e9820_save_sleep); i++, e++) {
+		void __iomem *va = e9820_save_va[e->base] + e->offset;
+
+		if (skip) {
+			skip = false;
+			continue;
+		}
+
+		switch (e->type) {
+		case SR_COND_SAVE:
+			if (!e9820_sr_cond(e))
+				break;
+			fallthrough;
+		case SR_SAVE:
+			if (!__test_and_clear_bit(i, e9820_need_restore))
+				break;
+			if (e->mask == U32_MAX) {
+				writel(e9820_saved[i], va);
+			} else {
+				reg = readl(va);
+				writel((reg & ~e->mask) | e9820_saved[i], va);
+			}
+			n++;
+			break;
+		case SR_COND_CHECK_SKIP:
+			skip = !e9820_sr_cond(e) || e9820_sr_check(e);
+			break;
+		case SR_WAIT:
+			if (readl_poll_timeout_atomic(va, reg,
+						      (reg & e->mask) == e->value,
+						      1, 2000)) {
+				pr_err("restore: wait timeout at %#x+%#x (%#x)\n",
+				       e9820_save_bases[e->base], e->offset, reg);
+				err = -ETIMEDOUT;
+			}
+			break;
+		case SR_CLEAR_PEND:
+			writel(readl(e9820_save_va[e->cbase] + e->cond_offset) &
+			       e->cond_mask & e->mask, va);
+			break;
+		}
+	}
+
+	return err ? err : n;
+}
