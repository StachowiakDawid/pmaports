From eed07b75fb5e1e73571b2f2a9676e34cf567a3a3 Mon Sep 17 00:00:00 2001
From: StachowiakDawid <dawidos234@gmail.com>
Date: Mon, 23 Nov 2026 18:38:09 +0100
Subject: [PATCH] soc: samsung: add Exynos9820 suspend-to-RAM driver

Platform suspend support for the Exynos 9820: "deep" enters the SoC
SLEEP state through the vendor's PSCI system sleep state with the PMU
programming the vendor kernel uses (EINT wakeup masks from the irq
wake state, WAKEUP_INT_EN, the lpm_init PMU durations), and reports
the wakeup source (WAKEUP_STAT) on resume. begin()/end() also run for
suspend-to-idle. deep=0 leaves only suspend-to-idle.

 - The D-cache is cleaned for all RAM before the SLEEP call
   (flush_all, needed for a clean resume); the kernel data/bss is
   cleaned through the image mapping, as its linear alias is unmapped.
 - Breadcrumbs (bc=1): progress codes written to the S2MPS19 RTC alarm
   registers, which survive a forced reset, including one before each
   syscore resume callback, clock cache restore and secondary CPU
   bring-up; the previous attempt is reported at boot and can be read
   back (bc_show).
 - Deep sleep is used while the CP runs; with the CP in reset the
   sleep falls back to suspend-to-idle, as the vendor kernel refuses
   SLEEP then.
 - Guard: no deep sleep while a CPU is offline but still powered (it
   would hang); the sleep falls back to suspend-to-idle or is refused.
 - save_restore=1 saves and restores the vendor's save_sleep[] CMU
   registers around SLEEP (default off).
 - UFS is told about the SoC power loss.
 - Dark wake: registered users (the modem driver) can ask for an
   immediate re-suspend after a wake that needs no userspace.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Signed-off-by: StachowiakDawid <dawidos234@gmail.com>
---
 drivers/soc/samsung/Kconfig                   |   10 +
 drivers/soc/samsung/Makefile                  |    2 +
 drivers/soc/samsung/exynos9820-suspend-save.h |  882 ++++++++++
 drivers/soc/samsung/exynos9820-suspend.c      | 1493 +++++++++++++++++
 .../linux/soc/samsung/exynos9820-dark-wake.h  |   45 +
 5 files changed, 2432 insertions(+)
 create mode 100644 drivers/soc/samsung/exynos9820-suspend-save.h
 create mode 100644 drivers/soc/samsung/exynos9820-suspend.c
 create mode 100644 include/linux/soc/samsung/exynos9820-dark-wake.h

diff --git a/drivers/soc/samsung/Kconfig b/drivers/soc/samsung/Kconfig
index 1a5dfdc978..81e6b46d53 100644
--- a/drivers/soc/samsung/Kconfig
+++ b/drivers/soc/samsung/Kconfig
@@ -44,6 +44,16 @@ config EXYNOS_PMU
 	select MFD_CORE
 	select REGMAP_MMIO
 
+config EXYNOS9820_SUSPEND
+	bool "Exynos9820 suspend-to-RAM support (EXPERIMENTAL)"
+	depends on ARCH_EXYNOS && ARM64 && SUSPEND && ARM_PSCI_FW
+	help
+	  Suspend-to-RAM ("deep" mem_sleep) for the Exynos9820, whose PSCI
+	  v0.1 firmware has no SYSTEM_SUSPEND. Uses the Samsung affinity
+	  level 3 CPU_SUSPEND call and the downstream PMU sleep sequences.
+	  It is only registered when the kernel command line has
+	  exynos9820_suspend.deep=1; otherwise suspend-to-idle is used.
+
 # There is no need to enable these drivers for ARMv8
 config EXYNOS_PMU_ARM_DRIVERS
 	bool "Exynos PMU ARMv7-specific driver extensions" if COMPILE_TEST
diff --git a/drivers/soc/samsung/Makefile b/drivers/soc/samsung/Makefile
index 371b6947eb..96928c3098 100644
--- a/drivers/soc/samsung/Makefile
+++ b/drivers/soc/samsung/Makefile
@@ -10,6 +10,8 @@ obj-$(CONFIG_EXYNOS_PMU)	+= exynos_pmu.o
 exynos_pmu-y			+= exynos-pmu.o gs101-pmu.o exynos850-pmu.o \
 				   exynos9820-pmu.o
 
+obj-$(CONFIG_EXYNOS9820_SUSPEND)	+= exynos9820-suspend.o
+
 obj-$(CONFIG_EXYNOS_PMU_ARM_DRIVERS)	+= exynos3250-pmu.o exynos4-pmu.o \
 					exynos5250-pmu.o exynos5420-pmu.o
 obj-$(CONFIG_EXYNOS_REGULATOR_COUPLER) += exynos-regulator-coupler.o
