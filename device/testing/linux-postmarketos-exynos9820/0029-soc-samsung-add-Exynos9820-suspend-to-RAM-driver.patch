+/* PMU sequencer durations (boot values: 0x3ffff/0/0/fff00000) */
+static const struct e9820_lpm e9820_lpm_dur[] = {
+	{ PMU_BASE + 0x0e00, 0xffffffff, 0x7d0 },  /* EXT_REGULATOR_MAIN_DURATION */
+	{ PMU_BASE + 0x0e04, 0xffffffff, 0x528 },  /* EXT_REGULATOR_SUB_DURATION */
+	{ PMU_BASE + 0x0e08, 0xffffffff, 0x8c },   /* EXT_REGULATOR_CPUCL2_DURATION */
+	{ PMU_BASE + 0x0e0c, 0xffffffff, 0x0 },    /* EXT_REGULATOR_G3D_DURATION */
+	{ PMU_BASE + 0x0284, 0xffffffff, 0x66c },  /* TCXO_DURATION3 */
+};
+
+static void e9820_lpm_apply(const struct e9820_lpm *t, int n)
+{
+	void __iomem *va;
+	u32 old, new;
+	int i;
+
+	for (i = 0; i < n; i++, t++) {
+		va = ioremap(t->pa, 4);
+		if (!va)
+			continue;
+		old = readl(va);
+		new = (old & ~t->mask) | (t->val & t->mask);
+		if (new != old) {
+			writel(new, va);
+			pr_info("lpm: %#x %08x -> %08x\n", t->pa, old, new);
+		}
+		iounmap(va);
+	}
+}
