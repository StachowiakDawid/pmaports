+static bool save_restore;
+module_param(save_restore, bool, 0644);
+MODULE_PARM_DESC(save_restore, "Save/restore Samsung's save_sleep[] CMU registers around SLEEP (default off: every deep test ran without it)");
+
+#define PMU_CP_STAT		0x0038
+#define PMU_CP_STATUS		0x3004
+
+/*
+ * The CP (S5000AP) uses AP DRAM; Samsung enters the same SoC SLEEP with it
+ * running (the APM keeps MIF up for the CP as needed) and only refuses when
+ * CP_STAT reads 0 (CP in reset).  Validated here (15 SLEEP cycles with the CP
+ * registered, woken by its mailbox, data up after resume) once CMU_TOP/CORE/
+ * BUSC were no longer written back and MIF stayed up.
+ */
+
+static bool e9820_cp_on(void)
+{
+	return readl(pmu + PMU_CP_STATUS) & BIT(0);
+}
+#define PMU_EINT_WAKEUP_MASK	0x060c
+#define PMU_EINT_WAKEUP_MASK2	0x061c
+#define GICD_ISPENDR_PA		0x10101200
+#define GICD_ISPENDR_NUM	16
+
+static int exynos9820_sleep_finisher(unsigned long state)
+{
+	return psci_ops.cpu_suspend(state,
+				    __pa_symbol_nodebug((unsigned long)cpu_resume));
+}
+
+/*
+ * flush_all (default on): clean the whole data cache to DRAM for every
+ * memblock RAM region right before the SLEEP call, in case the firmware does
+ * not write back the cluster/DSU L3 before cutting power (post-resume crashes
+ * hit exactly the data modified just before the sleep).
+ */
+static bool flush_all = true;
+module_param(flush_all, bool, 0644);
+MODULE_PARM_DESC(flush_all, "Clean the D-cache to PoC for all RAM before the deep sleep call (default Y: needed for a clean resume)");
+
+static void e9820_flush_range(phys_addr_t start, phys_addr_t end)
+{
+	/* partial pages next to no-map regions are not in the linear map */
+	start = PAGE_ALIGN(start);
+	end &= PAGE_MASK;
+	if (start < end)
+		dcache_clean_poc((unsigned long)phys_to_virt(start),
+				 (unsigned long)phys_to_virt(end));
+}
+
+static void e9820_flush_all_ram(void)
+{
+	/*
+	 * The kernel's data/bss is not in the linear map (arm64 unmaps its
+	 * alias), so clean it through the kernel image mapping instead.
+	 */
+	phys_addr_t ks = __pa_symbol(__init_end), ke = __pa_symbol(__bss_stop);
+	phys_addr_t start, end;
+	u64 i;
+
+	for_each_mem_range(i, &start, &end) {
+		if (end <= ks || start >= ke) {
+			e9820_flush_range(start, end);
+			continue;
+		}
+		if (start < ks)
+			e9820_flush_range(start, ks);
+		if (end > ke)
+			e9820_flush_range(ke, end);
+	}
+	dcache_clean_poc((unsigned long)__init_end, (unsigned long)__bss_stop);
+}
+
+/*
+ * Dark wake. At weak signal the CP sends a signal
+ * report (DISP_RSSI_INFO/ICON_INFO NOTI) every 10-12 s, and every one wakes
+ * the SoC through the CP mailbox. A full resume thaws userspace, and the
+ * re-suspend takes seconds, so the phone ends up awake most of the night.
+ * The CP has no "do not wake" path for these reports: every IPC frame goes
+ * through the same mailbox interrupt (CP 0x4126ee08: ISSR1 = mask, INTGR0
+ * bit 16).
+ *
+ * ->suspend_again lets one registered driver (s5000ap-boot) look at what
+ * the CP sent, after the noirq/early resume, and send the SoC back to SLEEP
+ * when it was only such a report. Conditions, all of them:
+ *  - the PMU woke for the CP mailbox alone (WAKEUP_STAT bit 8 or 10 only,
+ *    WAKEUP2_STAT 0), not an early wakeup;
+ *  - the first wakeup interrupt is the driver's;
+ *  - no other wakeup source was active or got an event since prepare_late;
+ *  - the driver says yes.
+ * The pending wakeup is cleared before the driver is asked, so a frame that
+ * comes later aborts the next SLEEP (the driver reports hard wakeups while
+ * the system suspends) and the system resumes as before.
+ */
+static DEFINE_MUTEX(dw_lock);
+static const struct exynos9820_dark_wake *dw_ops;
+static unsigned long dw_events;	/* other wakeup sources, at prepare_late */
+static u32 dw_stat, dw_stat2;
+static bool dw_valid;		/* ->enter() ran and the PMU woke normally */
+
+int exynos9820_dark_wake_register(const struct exynos9820_dark_wake *dw)
+{
+	int ret = 0;
+
+	mutex_lock(&dw_lock);
+	if (dw_ops)
+		ret = -EBUSY;
+	else
+		dw_ops = dw;
+	mutex_unlock(&dw_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(exynos9820_dark_wake_register);
+
+void exynos9820_dark_wake_unregister(const struct exynos9820_dark_wake *dw)
+{
+	mutex_lock(&dw_lock);
+	if (dw_ops == dw)
+		dw_ops = NULL;
+	mutex_unlock(&dw_lock);
+}
+EXPORT_SYMBOL_GPL(exynos9820_dark_wake_unregister);
+
+/* sum of the event counts of all wakeup sources but @own; *who = an active one */
+static unsigned long dw_other_events(struct wakeup_source *own,
+				     const char **who)
+{
+	struct wakeup_source *ws;
+	unsigned long n = 0;
+	int idx;
+
+	*who = NULL;
+	idx = wakeup_sources_read_lock();
+	for_each_wakeup_source(ws) {
+		if (ws == own)
+			continue;
+		n += READ_ONCE(ws->event_count);
+		if (!*who && ws->active)	/* bit-field, no READ_ONCE */
+			*who = ws->name;
+	}
+	wakeup_sources_read_unlock(idx);
+	return n;
+}
+
+static bool exynos9820_suspend_again(void)
+{
+	const struct exynos9820_dark_wake *dw;
+	const char *who;
+	unsigned int irq;
+	bool again = false;
+	int n;
+
+	mutex_lock(&dw_lock);
+	dw = dw_ops;
+	if (!dw || !READ_ONCE(*dw->enabled) || !dw_valid || !dw_stat ||
+	    (dw_stat & ~(BIT(8) | BIT(10))) || dw_stat2)
+		goto out;
+	irq = pm_wakeup_irq();
+	if (irq != dw->irq)
+		goto out;
+
+	if (dw_other_events(dw->ws, &who) != dw_events || who) {
+		pr_info("dark wake: no, wakeup source %s %s\n",
+			who ?: "(other)", who ? "active" : "had an event");
+		goto out;
+	}
+	/*
+	 * Clear the pending wakeup, then let the driver look. An interrupt
+	 * that comes while it looks raises the wakeup again (the driver
+	 * reports hard wakeups during suspend): look once more, so that every
+	 * frame is either seen by the driver or aborts the next SLEEP.
+	 */
+	for (n = 0; n < 4; n++) {
+		pm_wakeup_clear(0);
+		again = dw->again(dw->data);
+		if (!again || !pm_wakeup_pending())
+			break;
+		again = false;
+	}
+	if (again)
+		goto out;
+	/* resume as if this hook did not exist (pm_wakeup_irq stays valid) */
+	pm_system_irq_wakeup(irq);
+out:
+	dw_valid = false;
+	mutex_unlock(&dw_lock);
+	return again;
+}
+
+static int exynos9820_suspend_begin(suspend_state_t state)
+{
+	/* tells exynos-pmu to stop C2 programming from suspend_noirq on */
+	pm_set_suspend_via_firmware();
+
+	e9820_lpm_apply(e9820_lpm_dur, ARRAY_SIZE(e9820_lpm_dur));
+
+	pr_info("begin: CP_STAT %#x CP_STATUS %#x (Samsung refuses to sleep with CP_STAT 0)\n",
+		readl(pmu + PMU_CP_STAT), readl(pmu + PMU_CP_STATUS));
+
+	if (bc) {
+		bc_dead = false;
+		bc_seq = (bc_seq + 1) & 0x7f;
+		/* aux: 1 = PMU durations applied, bit 0 save_restore, bit 1 EINT mask */
+		bc_write(BC_BEGIN, 0x1, save_restore | 1 << 1, 0);
+		pr_info("bc: attempt %u, breadcrumb write ret %d\n", bc_seq,
+			bc_ret);
+	}
+	return 0;
+}
+
+static int exynos9820_suspend_prepare_late(void)
+{
+	const char *who;
+
+	bc_write(BC_PREPARE_LATE, 0, 0, 0);
+	/* runs again for every SLEEP of a dark-wake loop */
+	mutex_lock(&dw_lock);
+	dw_valid = false;
+	if (dw_ops)
+		dw_events = dw_other_events(dw_ops->ws, &who);
+	mutex_unlock(&dw_lock);
+	return 0;
+}
+
+static void exynos9820_suspend_wake(void)
+{
+	bc_write(BC_WAKE, 0, 0, 0);
+}
+
+static void exynos9820_suspend_end(void)
+{
+	bc_write(BC_END, 0, 0, 0);
+	if (bc)
+		pr_info("bc: attempt %u completed, last write ret %d\n",
+			bc_seq, bc_ret);
+}
+
+static void e9820_dump_pending(void)
+{
+	void __iomem *gicd = ioremap(GICD_ISPENDR_PA, GICD_ISPENDR_NUM * 4);
+	int i;
+
+	if (!gicd)
+		return;
+	for (i = 0; i < GICD_ISPENDR_NUM; i++) {
+		u32 v = readl(gicd + i * 4);
+
+		if (v)
+			pr_info("early wakeup: GICD_ISPENDR%d = %#010x\n", i, v);
+	}
+	iounmap(gicd);
+}
+
+static int e9820_stuck_cpu(unsigned int layer);
+
+static int exynos9820_suspend_enter(suspend_state_t state)
+{
+	unsigned int cpu = smp_processor_id();
+	struct e9820_lpm_count pre, post;
+	u32 stat, stat2, m0, m1;
+	bool saved = false;
+	int ret, rst = 0;
+
+	/* Samsung's exynos_check_cp_status(): no SLEEP with the CP in reset */
+	if (e9820_cp_on() && !readl(pmu + PMU_CP_STAT)) {
+		pr_err("CP_STAT is 0 (CP in reset): SLEEP not entered\n");
+		return -EBUSY;
+	}
+
+	/* last line of the deep sleep guard: nothing was written yet */
+	ret = e9820_stuck_cpu(E9820_GUARD_ENTER);
+	if (ret >= 0) {
+		pr_err("guard: CPU%d is powered but not running, SLEEP not entered\n",
+		       ret);
+		return -EBUSY;
+	}
+
+	/* exynos_set_wakeupmask(SYS_SLEEP) */
+	writel(exynos_eint_wake_mask(0), pmu + PMU_EINT_WAKEUP_MASK);
+	writel(exynos_eint_wake_mask(1), pmu + PMU_EINT_WAKEUP_MASK2);
+	m0 = readl(pmu + PMU_EINT_WAKEUP_MASK);
+	m1 = readl(pmu + PMU_EINT_WAKEUP_MASK2);
+	writel(0, pmu + PMU_WAKEUP_STAT);
+	writel(SLEEP_WAKEUP_INT_EN, pmu + PMU_WAKEUP_INT_EN);
+	writel(0, pmu + PMU_WAKEUP2_STAT);
+	writel(SLEEP_WAKEUP2_INT_EN, pmu + PMU_WAKEUP2_INT_EN);
+
+	/* cal_pm_enter(SYS_SLEEP): hint, save, enter sequence */
+	writel(CPU_INFORM_SLEEP, pmu + PMU_CPU_INFORM(cpu));
+	if (save_restore && e9820_saved) {
+		e9820_save();
+		saved = true;
+	}
+	e9820_run(e9820_enter_sleep, ARRAY_SIZE(e9820_enter_sleep));
+
+	e9820_lpm_count(&pre);
+	pr_info("enter: EINT_WAKEUP_MASK %08x %08x, WAKEUP_INT_EN %#x/%#x, apsoc %u mif %u early %u mif_req %#x\n",
+		m0, m1, SLEEP_WAKEUP_INT_EN, SLEEP_WAKEUP2_INT_EN, pre.apsoc, pre.mif,
+		pre.early, pre.mif_req);
+
+	/* aux: online CPUs, CP_STAT, CPU_INFORM of CPU0 */
+	exynos9820_pd_sleep_dtzpc(false);
+	if (flush_all)
+		e9820_flush_all_ram();
+	bc_write(BC_CALL, num_online_cpus(), readl(pmu + PMU_CP_STAT),
+		 readl(pmu + PMU_CPU_INFORM(cpu)));
+	if (bc && bc_ret)
+		pr_info("bc: pre-call breadcrumb write failed (%d)\n", bc_ret);
+
+	ret = cpu_suspend(EXYNOS9820_PSCI_SYSTEM_SLEEP,
+			  exynos9820_sleep_finisher);
+
+	stat = readl(pmu + PMU_WAKEUP_STAT);
+	stat2 = readl(pmu + PMU_WAKEUP2_STAT);
+	/* for ->suspend_again (no lock: the hook runs later in this thread) */
+	dw_stat = stat;
+	dw_stat2 = stat2;
+	dw_valid = !ret;
+
+	bc_write(BC_RETURNED, ret < 0 ? -ret : ret, stat, stat >> 7);
+
+	if (ret)
+		e9820_run(e9820_earlywkup_sleep,
+			  ARRAY_SIZE(e9820_earlywkup_sleep));
+	else
+		e9820_run(e9820_exit_sleep, ARRAY_SIZE(e9820_exit_sleep));
+	if (saved)
+		rst = e9820_restore();
+
+	writel(CPU_INFORM_CLEAR, pmu + PMU_CPU_INFORM(cpu));
+
+	bc_write(BC_EXITED, ret < 0 ? -ret : ret, stat, stat >> 7);
+	/* after the exit sequence: the domains SFRs are reachable again */
+	exynos9820_pd_sleep_dtzpc(true);
+
+	e9820_lpm_count(&post);
+	/* the AP SoC went down: FSYS1 (UFS host, PHY, sysreg) lost its state */
+	if (!ret && (!flexpmu || post.apsoc != pre.apsoc))
+		e9820_ufs_power_lost();
+	pr_info("%s (ret %d): WAKEUP_STAT %#010x WAKEUP2_STAT %#010x, restored %d\n",
+		ret ? "early wakeup" : "resumed", ret, stat, stat2, rst);
+	if (stat & (BIT(8) | BIT(10)))
+		pr_info("woken by the CP mailbox (WAKEUP_STAT bit %d)\n",
+			stat & BIT(8) ? 8 : 10);
+	pr_info("APM: apsoc down +%u, MIF %s (+%u), sequence early wakeups +%u\n",
+		post.apsoc - pre.apsoc,
+		post.mif != pre.mif ? "down" : "blocked",
+		post.mif - pre.mif, post.early - pre.early);
+	if (post.mif == pre.mif)
+		pr_info("APM: MIF request masters were %#x\n", pre.mif_req);
+	if (ret)
+		e9820_dump_pending();
+	if (bc)
+		pr_info("bc: post-call breadcrumb write ret %d\n", bc_ret);
+
+	/* An early wakeup is not an error for the PM core. */
+	return 0;
+}
+
+/*
+ * Deep sleep guard. A CPU whose CPU_ON failed (CPU7 after a SLEEP, about one
+ * resume in 3-4) stays powered according to the PMU but never runs. Entering
+ * the SoC SLEEP in that state hangs the SoC: no wakeup, no pstore record,
+ * only a forced reset helps. So, as long as a
+ * CPU is offline but stuck:
+ *  - pm_suspend() is given suspend-to-idle instead of "deep" (the fallback),
+ *  - if the CPU got stuck after that decision (the delayed online ran in
+ *    between), PM_SUSPEND_PREPARE refuses the suspend,
+ *  - ->enter() returns -EBUSY before it touches the PMU.
+ * A stuck CPU does not recover without a reboot.
+ */
+
+/* the state the running suspend really enters */
+static suspend_state_t e9820_suspend_state = PM_SUSPEND_ON;
+
+/*
+ * A CPU that is offline but stuck, or -1. With the hotplug lock held (or in
+ * ->enter(), where hotplug is over) no CPU is half way up or down: exynos-pmu
+ * waits for an offlined core to lose power before the lock is dropped.
+ */
+static int e9820_stuck_cpu(unsigned int layer)
+{
+	int cpu;
+
+	for_each_present_cpu(cpu) {
+		if (cpu_online(cpu))
+			continue;
+		if (exynos_pmu_cpu_powered(cpu) > 0)
+			return cpu;
+	}
+
+	return -1;
+}
+
+static suspend_state_t e9820_suspend_state_hook(suspend_state_t state)
+{
+	int cpu;
+
+	if (state == PM_SUSPEND_MEM && e9820_cp_on()) {
+		if (!readl(pmu + PMU_CP_STAT)) {
+			pr_warn("CP is powered but CP_STAT is 0 (CP in reset): using s2idle, as Samsung refuses SLEEP then\n");
+			state = PM_SUSPEND_TO_IDLE;
+		}
+	}
+	if (state == PM_SUSPEND_MEM) {
+		cpus_read_lock();
+		cpu = e9820_stuck_cpu(E9820_GUARD_FALLBACK);
+		cpus_read_unlock();
+		if (cpu >= 0) {
+			pr_warn("guard: CPU%d is powered but not running, deep sleep would hang: using s2idle instead (reboot to get deep sleep back)\n",
+				cpu);
+			state = PM_SUSPEND_TO_IDLE;
+		}
+	}
+	WRITE_ONCE(e9820_suspend_state, state);
+
+	return state;
+}
+
+static const struct platform_suspend_ops exynos9820_suspend_ops = {
+	.valid	= suspend_valid_only_mem,
+	.begin	= exynos9820_suspend_begin,
+	.prepare_late = exynos9820_suspend_prepare_late,
+	.enter	= exynos9820_suspend_enter,
+	.wake	= exynos9820_suspend_wake,
+	.end	= exynos9820_suspend_end,
+	.suspend_again = exynos9820_suspend_again,
+};
+
+/*
+ * Since 7.4 (4785d5faa9 "PM: suspend: Do not call suspend_ops->begin()/end()
+ * for s2idle") the PM core no longer falls back to suspend_ops->begin()/end()
+ * for suspend-to-idle. The s2idle entries of this driver (the CP
+ * in reset, the stuck-CPU guard, mem_sleep "s2idle") relied on that: begin()
+ * sets pm_set_suspend_via_firmware() (exynos-pmu stops the C2 programming,
+ * ufs-exynos sees a firmware suspend), applies the PMU durations and writes the
+ * breadcrumbs. Keep that behaviour with the s2idle ops.
+ */
+static int exynos9820_s2idle_begin(void)
+{
+	return exynos9820_suspend_begin(PM_SUSPEND_TO_IDLE);
+}
+
+static void exynos9820_s2idle_end(void)
+{
+	exynos9820_suspend_end();
+}
+
+static const struct platform_s2idle_ops exynos9820_s2idle_ops = {
+	.begin	= exynos9820_s2idle_begin,
+	.end	= exynos9820_s2idle_end,
+};
+
+/*
+ * Registered after cpu_pm (core_initcall), so its suspend runs before
+ * cpu_pm_suspend() and its resume after cpu_pm_resume().
+ */
+static int exynos9820_suspend_syscore_suspend(void *data)
+{
+	bc_write(BC_SYSCORE_SUSPEND, num_online_cpus(), 0, 0);
+	exynos_pmu_sys_sleep(true);
+	return 0;
+}
+
+static void exynos9820_suspend_syscore_resume(void *data)
+{
+	exynos_pmu_sys_sleep(false);
+	bc_write(BC_SYSCORE_RESUME, 0, 0, 0);
+}
+
+static const struct syscore_ops exynos9820_suspend_syscore_ops = {
+	.suspend = exynos9820_suspend_syscore_suspend,
+	.resume = exynos9820_suspend_syscore_resume,
+};
+
+static struct syscore exynos9820_suspend_syscore = {
+	.ops = &exynos9820_suspend_syscore_ops,
+};
+
+static int __init e9820_save_init(void)
+{
+	int i = 0;
+
+	e9820_saved = kcalloc(ARRAY_SIZE(e9820_save_sleep), sizeof(u32),
+			      GFP_KERNEL);
+	e9820_need_restore = bitmap_zalloc(ARRAY_SIZE(e9820_save_sleep),
+					   GFP_KERNEL);
+	if (!e9820_saved || !e9820_need_restore)
+		goto err;
+
+	for (i = 0; i < ARRAY_SIZE(e9820_save_bases); i++) {
+		e9820_save_va[i] = ioremap(e9820_save_bases[i],
+					   e9820_save_sizes[i]);
+		if (!e9820_save_va[i])
+			goto err;
+	}
+	return 0;
+
+err:
+	while (--i >= 0)
+		iounmap(e9820_save_va[i]);
+	bitmap_free(e9820_need_restore);
+	kfree(e9820_saved);
+	e9820_need_restore = NULL;
+	e9820_saved = NULL;
+	return -ENOMEM;
+}
+
+/*
+ * Deep sleep guard, PREPARE layer: refuse deep sleep while a CPU is offline but
+ * still powered (runs before cpu_hotplug_pm_callback() disables hotplug).
+ */
+static int e9820_pm_prepare(struct notifier_block *nb, unsigned long ev, void *p)
+{
+	int ret;
+
+	if (ev != PM_SUSPEND_PREPARE ||
+	    READ_ONCE(e9820_suspend_state) != PM_SUSPEND_MEM)
+		return NOTIFY_DONE;
+
+	cpus_read_lock();
+	ret = e9820_stuck_cpu(E9820_GUARD_PREPARE);
+	cpus_read_unlock();
+	if (ret < 0)
+		return NOTIFY_DONE;
+
+	pr_err("guard: CPU%d is powered but not running, deep sleep refused\n", ret);
+	return notifier_from_errno(-EBUSY);
+}
+
+static struct notifier_block e9820_pm_prepare_nb = {
+	.notifier_call = e9820_pm_prepare,
+	.priority = INT_MAX,
+};
+
+static int __init exynos9820_suspend_init(void)
+{
+	int i;
+
+	if (!of_machine_is_compatible("samsung,exynos9820"))
+		return 0;
+
+	if (!deep) {
+		pr_info("suspend-to-RAM disabled (exynos9820_suspend.deep=0)\n");
+		return 0;
+	}
+
+	if (!psci_ops.cpu_suspend) {
+		pr_err("no PSCI CPU_SUSPEND\n");
+		return -ENODEV;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(e9820_bases); i++) {
+		e9820_va[i] = ioremap(e9820_bases[i],
+				      e9820_bases[i] == PMU_BASE ? SZ_64K : SZ_16K);
+		if (!e9820_va[i])
+			goto err;
+	}
+	pmu = e9820_lookup(PMU_BASE);
+
+	if (e9820_save_init())
+		pr_warn("save_sleep tables not mapped, CMU save/restore disabled\n");
+
+	flexpmu = ioremap(FLEXPMU_DBG_BASE, FLEXPMU_DBG_SIZE);
+	if (!flexpmu)
+		pr_warn("APM debug counters not mapped\n");
+
+	register_syscore(&exynos9820_suspend_syscore);
+	syscore_resume_hook = bc_syscore_hook;
+	samsung_clk_resume_hook = bc_clk_hook;
+	exynos9820_pd_sleep_hook = bc_pd_hook;
+	e9820_ufs_hook_init();
+	cpuhp_setup_state_nocalls(CPUHP_BP_PREPARE_DYN, "soc/exynos9820-suspend:bc",
+				  bc_cpu_prepare, NULL);
+	WRITE_ONCE(pm_suspend_state_hook, e9820_suspend_state_hook);
+	register_pm_notifier(&e9820_pm_prepare_nb);
+	suspend_set_ops(&exynos9820_suspend_ops);
+	s2idle_set_ops(&exynos9820_s2idle_ops);
+	pr_info("suspend-to-RAM enabled (experimental), CP_STAT %#x\n",
+		readl(pmu + PMU_CP_STAT));
+
+	return 0;
+
+err:
+	while (--i >= 0)
+		iounmap(e9820_va[i]);
+	return -ENOMEM;
+}
+late_initcall(exynos9820_suspend_init);
diff --git a/include/linux/soc/samsung/exynos9820-dark-wake.h b/include/linux/soc/samsung/exynos9820-dark-wake.h
new file mode 100644
index 0000000000..78097ceef6
--- /dev/null
+++ b/include/linux/soc/samsung/exynos9820-dark-wake.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Exynos 9820 "dark wake": go back to SLEEP after a wake that a driver
+ * declares harmless, without resuming userspace (platform ->suspend_again).
+ */
+#ifndef __EXYNOS9820_DARK_WAKE_H
+#define __EXYNOS9820_DARK_WAKE_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+struct wakeup_source;
+
+/**
+ * struct exynos9820_dark_wake - a driver that may veto a full resume
+ * @again: called after the early resume of a SLEEP that the PMU ended for
+ *	the mailbox alone and that only @irq woke; the pending wakeup is
+ *	already cleared, so a new interrupt after this point aborts the next
+ *	SLEEP.  Return true to sleep again, false to resume.  May sleep.
+ * @data: argument for @again
+ * @irq: the Linux interrupt that must be the (only) wakeup interrupt
+ * @ws: the driver's own wakeup source, ignored by the "other wakeup
+ *	events" check
+ * @enabled: the hook does nothing at all while *@enabled is false
+ */
+struct exynos9820_dark_wake {
+	bool (*again)(void *data);
+	void *data;
+	unsigned int irq;
+	struct wakeup_source *ws;
+	const bool *enabled;
+};
+
+#if IS_ENABLED(CONFIG_EXYNOS9820_SUSPEND)
+int exynos9820_dark_wake_register(const struct exynos9820_dark_wake *dw);
+void exynos9820_dark_wake_unregister(const struct exynos9820_dark_wake *dw);
+#else
+static inline int exynos9820_dark_wake_register(const struct exynos9820_dark_wake *dw)
+{
+	return -ENODEV;
+}
+static inline void exynos9820_dark_wake_unregister(const struct exynos9820_dark_wake *dw) { }
+#endif
+
+#endif
