+static const u32 e9820_bases[] = {
+	0x10030000, 0x10420000, 0x10820000, 0x13020000, 0x13c10000,
+	0x13d20000, 0x13d60000, 0x15820000, PMU_BASE, 0x15870000,
+	0x15c20000, 0x1a020000, 0x1a030000, 0x1a220000, 0x1a240000,
+	0x1bc20000, 0x1bd20000, 0x1be20000, 0x1bf20000, 0x1d000000,
+	0x1d020000,
+};
+
+static void __iomem *e9820_va[ARRAY_SIZE(e9820_bases)];
+static void __iomem *pmu;
+
+static void __iomem *e9820_lookup(u32 base)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(e9820_bases); i++)
+		if (e9820_bases[i] == base)
+			return e9820_va[i];
+	return NULL;
+}
+
+static void e9820_run(const struct e9820_seq *seq, int n)
+{
+	void __iomem *va;
+	u32 reg;
+	int i;
+
+	for (i = 0; i < n; i++, seq++) {
+		va = e9820_lookup(seq->base);
+		if (WARN_ON_ONCE(!va))
+			continue;
+
+		switch (seq->type) {
+		case SEQ_T_WRITE:
+			if (seq->mask == U32_MAX) {
+				writel(seq->value, va + seq->offset);
+			} else {
+				reg = readl(va + seq->offset);
+				reg = (reg & ~seq->mask) | (seq->value & seq->mask);
+				writel(reg, va + seq->offset);
+			}
+			break;
+		case SEQ_T_SET_ATOMIC:
+			writel(seq->value, va + (seq->offset | PMU_ALIAS_SET));
+			break;
+		case SEQ_T_CLR_ATOMIC:
+			writel(seq->value, va + (seq->offset | PMU_ALIAS_CLR));
+			break;
+		case SEQ_T_CLEAR_PEND:
+			reg = readl(va + seq->cond_offset) & seq->value;
+			writel(reg & seq->mask, va + seq->offset);
+			break;
+		}
+	}
+}
