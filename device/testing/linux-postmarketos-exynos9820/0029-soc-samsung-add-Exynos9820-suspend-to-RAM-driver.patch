+/*
+ * ---- breadcrumbs that survive a PMIC manual reset ----
+ *
+ * A SLEEP that never wakes up ends with power + volume down, which makes
+ * the S2MPS19 power-cycle every rail (PWRONSRC then reads MRST): DRAM,
+ * ramoops, the PMU INFORM registers and the APM SRAM are lost. The PMIC
+ * RTC block keeps its registers (it runs from the backup supply). Linux
+ * has no driver for the S2MPS19 RTC (RTC_DRV_S5M is off, the system RTC
+ * is the SoC's s3c RTC), so its ALARM1 registers are free: 7 registers,
+ * bit 7 of each is the alarm-enable bit and is always written as 0, so
+ * the alarm can never fire. Layout (low 7 bits):
+ *   A1SEC  magic 0x5a      A1MIN  stage       A1HOUR attempt number
+ *   A1WEEK aux0            A1DAY  aux1        A1MON  aux2
+ *   A1YEAR xor of the six bytes before
+ * The registers are buffered: a write needs UPDATE.AUDR, a read
+ * UPDATE.RUDR (downstream rtc-s2mps19.c, 1 ms settle each).
+ * Access is through the APM (ACPM PMIC channel 2, speedy 0, page 2 = RTC)
+ * with the IRQs-off transfer variant, so it works from syscore and from
+ * ->enter with timekeeping suspended, as long as the APM answers.
+ */
+#define BC_ACPM_CHAN		2	/* sec-acpm s2mps19_data.acpm_chan_id */
+#define BC_SPEEDY		0	/* main PMIC (S2MPS19) */
+#define BC_TYPE_PMIC		1
+#define BC_TYPE_RTC		2
+#define S2MPS19_RTC_UPDATE	0x02
+#define  S2MPS19_RTC_RUDR	BIT(0)
+#define  S2MPS19_RTC_WUDR	BIT(1)
+#define  S2MPS19_RTC_FREEZE	BIT(2)
+#define  S2MPS19_RTC_AUDR	BIT(4)
+#define S2MPS19_RTC_A1SEC	0x13	/* A1SEC..A1YEAR = 0x13..0x19 */
+#define S2MPS19_PMIC_PWRONSRC	0x10
+#define S2MPS19_PMIC_OFFSRC	0x11
+#define S2MPS19_PMIC_CTRL1	0x14	/* bit 4: manual reset enable */
+#define PMU_RST_STAT		0x0404
+#define PMU_INFORM0		0x0800
+#define PMU_INFORM_NUM		6	/* reading 0x818 hung the CPU: do not read */
+#define BC_LEN			7
+#define BC_MAGIC		0x5a
+
+enum bc_stage {
+	BC_NONE,
+	BC_BEGIN,		/* ->begin (process context) */
+	BC_PREPARE_LATE,	/* ->prepare_late: devices are in noirq */
+	BC_SYSCORE_SUSPEND,	/* our syscore op: CPUs 1-7 off, IRQs off */
+	BC_CALL,		/* ->enter: PMU programmed, next is PSCI */
+	BC_RETURNED,		/* ->enter: the PSCI call returned */
+	BC_EXITED,		/* ->enter: exit sequence + CMU restore done */
+	BC_SYSCORE_RESUME,	/* our syscore op: GIC/CMU/timekeeping back */
+	BC_WAKE,		/* ->wake: IRQs on, CPUs 1-7 back */
+	BC_END,			/* ->end: devices resumed */
+	BC_UFS0 = 0x30,		/* 0x30 + n: ufs-exynos resume re-init step n (after ->wake) */
+	BC_SYSRES0 = 0x40,	/* 0x40 + n: about to call syscore resume #n */
+	BC_CPUUP0 = 0x48,	/* 0x48 + n: resume, about to bring up CPU n (after syscore resume) */
+	BC_PDRES0 = 0x50,	/* 0x50 + n: about to restore D_TZPC of power domain #n (aux0 = STATUS on) */
+	BC_CLKRES0 = 0x60,	/* 0x60 + n: samsung_clk_resume about to restore cache #n */
+	BC_TEST = 0x7d,		/* reserved: test pattern of older kernels */
+	BC_BOOT = 0x7e,		/* boot report seen it; aux0 = old stage */
+};
