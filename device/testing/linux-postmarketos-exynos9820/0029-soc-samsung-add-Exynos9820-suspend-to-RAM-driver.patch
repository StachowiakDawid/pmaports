+	c->mif = readl(flexpmu + FLEXPMU_LINE(DID_MIF_COUNT_SLEEP) + 4);
+	c->mif_req = (readl(flexpmu + FLEXPMU_LINE(DID_SW_FLAG) + 4) >> 16) &
+		     0xff;
+}
