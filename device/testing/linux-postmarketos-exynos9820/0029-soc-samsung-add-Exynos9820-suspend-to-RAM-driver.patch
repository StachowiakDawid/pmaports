+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos9820 suspend-to-RAM ("deep" sleep), EXPERIMENTAL.
+ *
+ * The Exynos9820 EL3 firmware implements PSCI v0.1 only: there is no
+ * SYSTEM_SUSPEND, so the PSCI driver cannot offer "deep" in
+ * /sys/power/mem_sleep. Samsung's kernel enters system sleep with a
+ * CPU_SUSPEND call at affinity level 3 (power_state 0x03000000, see
+ * psci_suspend_customized_finisher() in their drivers/firmware/psci.c)
+ * from the boot CPU, after the PMU has been prepared for SYS_SLEEP:
+ *
+ *  - PMU WAKEUP_INT_EN / WAKEUP2_INT_EN select the wakeup sources
+ *    (exynos-powermode wakeup-mask for SLEEP: 0x1f6f / 0xf, i.e. RTC
+ *    alarm/tick, CMGP EINTs, mailboxes and the ALIVE EINTs),
+ *  - CPU_INFORM of the boot CPU carries the SLEEP hint for the APM
+ *    firmware (CPU_INFORM_SLEEP = 4),
+ *  - the pmucal enter_sleep / exit_sleep / earlywkup_sleep sequences
+ *    from flexpmu_cal_system_exynos9820.h.
+ *
+ * On top of that (all inactive unless deep=1):
+ *  - the EINT wakeup mask (PMU 0x60c/0x61c) from the irq wake state that
+ *    pinctrl-exynos collects (9820 pinctrl has no retention_data, so
+ *    nobody else writes it; reset value = every EINT masked),
+ *  - exynos_pmu_sys_sleep() from syscore, so that exynos-pmu does not
+ *    refuse the cpu_pm syscore CPU_PM_ENTER (that aborted every attempt),
+ *  - Samsung's save_sleep[] CMU save/restore (save_restore),
+ *  - the pmucal_lpm_init PMU durations the bootloader leaves at
+ *    0x3ffff / 0 / 0xfff00000,
+ *  - the APM flexpmu debug counters (AP SoC down / MIF down / early
+ *    wakeup), as Samsung's exynos_pm_enter() prints them.
+ *
+ * Debugging aids (inactive unless bc=1):
+ *  - progress "breadcrumbs" in the S2MPS19 RTC (ALARM1 registers, alarm
+ *    enable bits kept clear) at every step of suspend and resume. The RTC
+ *    block is the only state that survives the PMIC manual reset (power +
+ *    volume down) a hung SLEEP needs; DRAM, PMU and APM SRAM do not.
+ *  - a boot-time report of the last breadcrumb and of the reset cause
+ *    (PMU RST_STAT, PMIC PWRONSRC/OFFSRC).
+ * Mainline CMU state is also restored by the Samsung clock driver's
+ * syscore ops.
+ *
+ * This is off unless "exynos9820_suspend.deep=1" is on the kernel
+ * command line, because suspend_set_ops() makes "deep" the default
+ * mem_sleep state.
+ */
+
+#include <linux/bitmap.h>
+#include <linux/cpumask.h>
+#include <linux/delay.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/init.h>
+#include <linux/irqflags.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/slab.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+#include <linux/soc/samsung/exynos9820-dark-wake.h>
+#include <linux/device.h>	/* pm_wakeup.h: struct wakeup_source */
+#include <linux/mutex.h>
+#include <linux/syscore_ops.h>
+#include <linux/cpuhotplug.h>
+#include <linux/cpu.h>
+#include <linux/memblock.h>
+#include <asm/cacheflush.h>
+#include <asm/sections.h>
+#include <linux/moduleparam.h>
+#include <linux/workqueue.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/psci.h>
+#include <linux/smp.h>
+#include <linux/suspend.h>
+#include <linux/sysfs.h>
+#include <uapi/linux/psci.h>
+
+#include <asm/suspend.h>
+
+#undef pr_fmt
+#define pr_fmt(fmt) "exynos9820-suspend: " fmt
+
+/*
+ * Default on: deep SLEEP passed soak tests (CPU7, UFS, Wi-Fi, no oops).
+ * With it the kernel offers "deep" and selects it as
+ * the default mem_sleep state; exynos9820_suspend.deep=0 keeps s2idle only.
+ */
+static bool deep = true;
+module_param(deep, bool, 0444);
+MODULE_PARM_DESC(deep, "Offer suspend-to-RAM (mem_sleep \"deep\", default Y; 0 = s2idle only)");
+
+#define PMU_BASE		0x15860000
+#define PMU_CPU_INFORM(cpu)	(0x0860 + (cpu) * 4)
+#define CPU_INFORM_CLEAR	0
+#define CPU_INFORM_SLEEP	4
+#define PMU_WAKEUP_INT_EN	0x3944
+#define PMU_WAKEUP_STAT		0x3950
+#define PMU_WAKEUP2_STAT	0x3954
+#define PMU_WAKEUP2_INT_EN	0x3964
+/* PMU_ALIVE registers below 0x4000 have atomic set/clear aliases */
+#define PMU_ALIAS_CLR		0x8000
+#define PMU_ALIAS_SET		0xc000
+
+#define SLEEP_WAKEUP_INT_EN	0x00001f6f
+#define SLEEP_WAKEUP2_INT_EN	0x0000000f
+
+/* layers of the deep sleep guard */
+#define E9820_GUARD_FALLBACK	0
+#define E9820_GUARD_PREPARE	1
+#define E9820_GUARD_ENTER	2
+
+/* Samsung PSCI_SYSTEM_SLEEP: CPU_SUSPEND, affinity level 3, StateID 0 */
+#define EXYNOS9820_PSCI_SYSTEM_SLEEP \
+	(3 << PSCI_0_2_POWER_STATE_AFFL_SHIFT)
+
+enum e9820_seq_type { SEQ_T_WRITE, SEQ_T_SET_ATOMIC, SEQ_T_CLR_ATOMIC,
+		      SEQ_T_CLEAR_PEND };
+
+struct e9820_seq {
+	u8 type;
+	u32 base;
+	u16 offset;
+	u16 cond_offset;	/* CLEAR_PEND: pending register */
+	u32 mask;
+	u32 value;		/* WRITE: value; ATOMIC: bit; PEND: cond mask */
+};
+
+#define SEQ_WRITE(b, o, m, v) \
+	{ .type = SEQ_T_WRITE, .base = b, .offset = o, .mask = m, .value = v }
+#define SEQ_SET_BIT_ATOMIC(b, o, bit) \
+	{ .type = SEQ_T_SET_ATOMIC, .base = b, .offset = o, .value = bit }
+#define SEQ_CLR_BIT_ATOMIC(b, o, bit) \
+	{ .type = SEQ_T_CLR_ATOMIC, .base = b, .offset = o, .value = bit }
+#define SEQ_CLEAR_PEND(b, o, co, m, cm) \
+	{ .type = SEQ_T_CLEAR_PEND, .base = b, .offset = o, .cond_offset = co, \
+	  .mask = m, .value = cm }
+
+/* Generated by a script from the downstream CAL. */
+/* downstream flexpmu_cal_system_exynos9820.h: enter_sleep[] */
+static const struct e9820_seq e9820_enter_sleep[] = {
+	SEQ_SET_BIT_ATOMIC(0x15860000, 0x3044, 6), /* CP_INT_EN */
+	SEQ_WRITE(0x15870000, 0x0200, 0x00000001, 0x00000001), /* GRP2_INTR_BID_ENABLE */
+	SEQ_CLEAR_PEND(0x15870000, 0x010c, 0x0108, 0x00000001, 0x00000001), /* GRP1_INTR_BID_CLEAR */
+	SEQ_WRITE(0x15860000, 0x1044, 0x00000008, 0x00000008), /* CLUSTER0_CPU0_INT_EN */
+	SEQ_WRITE(0x1d020000, 0x30b4, 0x00000007, 0x00000002), /* QCH_CON_CPUCL0_QCH_SCLK */
+	SEQ_WRITE(0x1a030000, 0x30b4, 0x00000007, 0x00000004), /* QCH_CON_PPC_CPUCL0_0_QCH */
+	SEQ_WRITE(0x1a030000, 0x30b8, 0x00000007, 0x00000004), /* QCH_CON_PPC_CPUCL0_1_QCH */
+	SEQ_WRITE(0x1a030000, 0x30bc, 0x00000007, 0x00000004), /* QCH_CON_PPC_CPUCL2_0_QCH */
+	SEQ_WRITE(0x1a030000, 0x30c0, 0x00000007, 0x00000004), /* QCH_CON_PPC_CPUCL2_1_QCH */
+	SEQ_WRITE(0x1a030000, 0x30e0, 0x00000007, 0x00000004), /* QCH_CON_PPMU_CPUCL0_0_QCH */
+	SEQ_WRITE(0x1a030000, 0x30e4, 0x00000007, 0x00000004), /* QCH_CON_PPMU_CPUCL0_1_QCH */
+	SEQ_WRITE(0x1a030000, 0x30e8, 0x00000007, 0x00000004), /* QCH_CON_PPMU_CPUCL2_0_QCH */
+	SEQ_WRITE(0x1a030000, 0x30ec, 0x00000007, 0x00000004), /* QCH_CON_PPMU_CPUCL2_1_QCH */
+};
+
+/* downstream flexpmu_cal_system_exynos9820.h: exit_sleep[] */
+static const struct e9820_seq e9820_exit_sleep[] = {
+	SEQ_CLR_BIT_ATOMIC(0x15860000, 0x3044, 6), /* CP_INT_EN */
+	SEQ_WRITE(0x15860000, 0x3944, 0xffffffff, 0x00000000), /* WAKEUP_INT_EN */
+	SEQ_WRITE(0x15860000, 0x3964, 0xffffffff, 0x00000000), /* WAKEUP2_INT_EN */
+	SEQ_CLEAR_PEND(0x15870000, 0x1a0c, 0x1a08, 0xffffffff, 0x00000040), /* GRP26_INTR_BID_CLEAR */
+	SEQ_CLEAR_PEND(0x15870000, 0x1b0c, 0x1b08, 0xffffffff, 0xffffffff), /* GRP27_INTR_BID_CLEAR */
+	SEQ_CLEAR_PEND(0x15870000, 0x1f0c, 0x1f08, 0xffffffff, 0xffffffff), /* GRP31_INTR_BID_CLEAR */
+	SEQ_WRITE(0x15870000, 0x0200, 0x00000001, 0x00000000), /* GRP2_INTR_BID_ENABLE */
+	SEQ_CLEAR_PEND(0x15870000, 0x020c, 0x0208, 0x00000001, 0x00000001), /* GRP2_INTR_BID_CLEAR */
+	SEQ_WRITE(0x15860000, 0x1044, 0x00000008, 0x00000000), /* CLUSTER0_CPU0_INT_EN */
+	SEQ_WRITE(0x1d020000, 0x30b4, 0x00000007, 0x00000006), /* QCH_CON_CPUCL0_QCH_SCLK */
