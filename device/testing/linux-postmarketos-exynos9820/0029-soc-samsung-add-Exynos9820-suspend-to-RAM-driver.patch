+	if (ret)
+		return sysfs_emit(buf, "read failed %d\n", ret);
+	bc_decode("bc_show", b);
+	return sysfs_emit(buf, "%02x %02x %02x %02x %02x %02x %02x (last write stage %u ret %d)\n",
+			  b[0], b[1], b[2], b[3], b[4], b[5], b[6],
+			  bc_last_stage, bc_ret);
+}
