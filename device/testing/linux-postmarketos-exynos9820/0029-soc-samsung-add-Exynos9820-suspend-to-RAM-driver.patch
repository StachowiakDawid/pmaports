+	u32 apsoc;	/* AP_COUNT_SLEEP data[1]: AP SoC down */
+	u32 mif;	/* MIF_COUNT_SLEEP data[1]: MIF down */
+	u32 mif_req;	/* SW_FLAG data[1] bits 23:16: MIF request masters */
+};
