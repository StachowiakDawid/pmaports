+/* -------------------------------------------------------------------------
+ * V4L2 ioctls
+ */
+
+static void e9820_csis_fill_fmt(struct v4l2_pix_format *pix)
+{
+	if (!e9820_csis_find_fourcc(pix->pixelformat))
+		pix->pixelformat = e9820_csis_formats[0].fourcc;
+	pix->width = clamp(pix->width & ~1U, CSIS_MIN_WIDTH, CSIS_MAX_WIDTH);
+	pix->height = clamp(pix->height & ~1U, CSIS_MIN_WIDTH, CSIS_MAX_WIDTH);
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = V4L2_COLORSPACE_RAW;
+	pix->bytesperline = pix->width * 2;
+	/* The DMA has no height limit: one spare line */
+	pix->sizeimage = PAGE_ALIGN(pix->bytesperline * (pix->height + 1));
+}
+
+static int e9820_csis_querycap(struct file *file, void *fh,
+			       struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "exynos9820-csis", sizeof(cap->driver));
+	strscpy(cap->card, "Exynos 9820 CSIS", sizeof(cap->card));
+	return 0;
+}
+
+static int e9820_csis_enum_fmt(struct file *file, void *fh,
+			       struct v4l2_fmtdesc *f)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(e9820_csis_formats); i++) {
+		if (f->mbus_code && f->mbus_code != e9820_csis_formats[i].mbus)
+			continue;
+		if (n++ == f->index) {
+			f->pixelformat = e9820_csis_formats[i].fourcc;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+static int e9820_csis_enum_framesizes(struct file *file, void *fh,
+				      struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index || !e9820_csis_find_fourcc(fsize->pixel_format))
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = CSIS_MIN_WIDTH;
+	fsize->stepwise.max_width = CSIS_MAX_WIDTH;
+	fsize->stepwise.min_height = CSIS_MIN_WIDTH;
+	fsize->stepwise.max_height = CSIS_MAX_WIDTH;
+	fsize->stepwise.step_width = 2;
+	fsize->stepwise.step_height = 2;
+	return 0;
+}
+
+static int e9820_csis_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct e9820_csis *csis = video_drvdata(file);
+
+	f->fmt.pix = csis->fmt;
+	return 0;
+}
+
+static int e9820_csis_try_fmt(struct file *file, void *fh,
+			      struct v4l2_format *f)
+{
+	e9820_csis_fill_fmt(&f->fmt.pix);
+	return 0;
+}
+
+static int e9820_csis_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct e9820_csis *csis = video_drvdata(file);
+
+	if (vb2_is_busy(&csis->queue))
+		return -EBUSY;
+	e9820_csis_fill_fmt(&f->fmt.pix);
+	csis->fmt = f->fmt.pix;
+	return 0;
+}
