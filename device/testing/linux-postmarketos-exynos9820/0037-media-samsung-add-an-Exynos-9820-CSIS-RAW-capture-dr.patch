+		return;
+	dev_info(csis->dev, "%s: CMU_TOP ISPPRE_BUS mux 0x%08x div 0x%08x gate 0x%08x, bus clock %lu Hz (clk framework)\n",
+		 when, readl(e9820_cmu_top + CMU_TOP_MUX_ISPPRE_BUS),
+		 readl(e9820_cmu_top + CMU_TOP_DIV_ISPPRE_BUS),
+		 readl(e9820_cmu_top + CMU_TOP_GATE_ISPPRE_BUS),
+		 clk_get_rate(csis->bus_clk));
+}
