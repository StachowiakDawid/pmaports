+		 when, readl(csis->csis + CSIS_CMN_CTRL), readl(csis->csis + 0x0008),
+		 readl(csis->csis + CSIS_INT_SRC0), readl(csis->csis + CSIS_INT_SRC1),
+		 readl(csis->csis + CSIS_INT_MSK0), readl(csis->csis + CSIS_INT_MSK1),
+		 readl(csis->csis + CSIS_PHY_STATUS),
+		 readl(csis->csis + CSIS_PHY_CMN_CTRL));
+	dev_info(csis->dev, "%s: CSIS CH0 CONFIG 0x%08x RESOL 0x%08x shadow 0x%08x 0x%08x FRM_CNT %u\n",
+		 when, readl(csis->csis + CSIS_ISP_CONFIG(0)),
+		 readl(csis->csis + CSIS_ISP_RESOL(0)),
+		 readl(csis->csis + 0x0080), readl(csis->csis + 0x0084),
+		 readl(csis->csis + CSIS_FRM_CNT(0)));
+	dev_info(csis->dev, "%s: DMA CTRL 0x%08x FMT 0x%08x ADDR1 0x%08x RESOL 0x%08x FCNTSEQ 0x%08x ACT_CTRL 0x%08x ACT_FCNTSEQ 0x%08x ACT_FMT 0x%08x FCNT_STAT 0x%08x\n",
+		 when, readl(csis->dma + DMA_CTRL), readl(csis->dma + DMA_FMT),
+		 readl(csis->dma + DMA_ADDR1), readl(csis->dma + DMA_RESOL),
+		 readl(csis->dma + DMA_FCNTSEQ), readl(csis->dma + DMA_ACT_CTRL),
+		 readl(csis->dma + 0x0094), readl(csis->dma + 0x0098),
+		 readl(csis->dma + 0x00b4));
+	dev_info(csis->dev, "%s: DMA common DATA_CTRL 0x%08x INT_MASK 0x%08x INT_SRC 0x%08x CMN_CTRL 0x%08x ERR 0x%08x OTF_FORMAT 0x%08x\n",
+		 when, readl(csis->dma_cmn + DMA_DATA_CTRL),
+		 readl(csis->dma_cmn + DMA_INT_MASK),
+		 readl(csis->dma_cmn + DMA_INT_SRC), readl(csis->dma_cmn + 0x0014),
+		 readl(csis->dma_cmn + DMA_ERR_CODE),
+		 readl(csis->dma_cmn + DMA_OTF_FORMAT));
+	dev_info(csis->dev, "%s: DMA top ARB 0x%08x CTRL 0x%08x SRAM 0x%08x MATRIX 0x%08x CLK_CTRL 0x%08x FIFO_CTRL 0x%08x TP 0x%08x 0x%08x 0x%08x MON 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		 when, readl(csis->dma_top + DMATOP_ARB_PRI),
+		 readl(csis->dma_top + DMATOP_CTRL),
+		 readl(csis->dma_top + DMATOP_SRAM_SPLIT),
+		 readl(csis->dma_top + DMATOP_MATRIX),
+		 readl(csis->dma_top + DMATOP_CLK_CTRL),
+		 readl(csis->dma_top + DMATOP_FIFO_CTRL),
+		 readl(csis->dma_top + DMATOP_TP_ENABLE),
+		 readl(csis->dma_top + DMATOP_TP_CTRL),
+		 readl(csis->dma_top + DMATOP_TP_RESOL),
+		 readl(csis->dma_top + DMATOP_DBG_MON_HW(0)),
+		 readl(csis->dma_top + DMATOP_DBG_MON_HW(1)),
+		 readl(csis->dma_top + DMATOP_DBG_MON_HW(2)),
+		 readl(csis->dma_top + DMATOP_DBG_MON_HW(3)));
+	dev_info(csis->dev, "%s: SYSREG DMA mux 0x%08x PHY reset 0x%08x, CMU user mux 0x%08x option 0x%08x\n",
+		 when, readl(csis->sysreg + SYSREG_SC_CON_DMA(csis->dma_index)),
+		 readl(csis->sysreg + SYSREG_PHY_RESET),
+		 readl(csis->cmu + CMU_BUS_USER_MUX),
+		 readl(csis->cmu + CMU_OPTION));
+	/* Q-channel control / status: CMU, CSIS1, CSISX4_PDP_DMA, SYSREG, AXI_D, AXI_P */
+	dev_info(csis->dev, "%s: QCH_CON cmu 0x%08x csis1 0x%08x dma 0x%08x sysreg 0x%08x axi_d 0x%08x axi_p 0x%08x\n",
+		 when, readl(csis->cmu + CMU_QCH_CON(0x30)),
