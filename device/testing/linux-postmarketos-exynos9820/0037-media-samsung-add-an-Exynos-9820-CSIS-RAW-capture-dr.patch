+
+static int e9820_csis_hw_start(struct e9820_csis *csis)
+{
+	u32 div_before;
+	u32 width = csis->fmt.width, height = csis->fmt.height;
+	u32 lanes = csis->bus.num_data_lanes;
+	u32 mbps = div_u64(csis->link_freq * 2, 1000000);
+	unsigned long flags;
+	unsigned int ch;
+	u32 val;
+	int ret;
+
+	if (csis->pd_stuck) {
+		dev_err(csis->dev, "ISPPRE did not power off after the last stream; reboot before streaming again\n");
+		return -EIO;
+	}
+
+	/* shared DMA top, bus clock mux, PHY isolation: one at a time */
+	if (cmpxchg(&e9820_csis_active, NULL, csis)) {
+		dev_err(csis->dev, "another receiver is streaming\n");
+		return -EBUSY;
+	}
+
+	/* full bus level before the block gets its 400 MHz clock */
+	ret = exynos_acpm_dvfs_hold(true);
+	if (ret) {
+		dev_err(csis->dev, "cannot hold the MIF/INT levels: %d\n", ret);
+		goto err_active;
+	}
+	csis->held = true;
+
+	if (csis->mux_gpio && csis->source) {
+		gpiod_direction_output(csis->mux_gpio, csis->source->mux);
+		usleep_range(2000, 3000);
+	}
+
+	ret = pm_runtime_resume_and_get(csis->dev);
+	if (ret)
+		goto err_hold;
+
+	ret = e9820_csis_check_power(csis, "start");
+	if (ret)
+		goto err_rpm;
+
+	/*
+	 * Make the clock framework write the ISPPRE bus divider at every
+	 * start (it skips the write when its cached rate already matches).
+	 * After some system sleeps CMU_TOP's DIV_CLKCMU_ISPPRE_BUS came back
+	 * as 0xf (bus at 1/16, 25 MHz) while the framework still had 400 MHz:
+	 * the DMA could not drain and the stream wedged (wedged with div
+	 * 0xf, recovered with div 0 after this rewrite).
+	 */
+	if (e9820_csis_wedged)
+		e9820_csis_bus_log(csis, "wedge, before");
+	div_before = e9820_cmu_top ?
+		readl(e9820_cmu_top + CMU_TOP_DIV_ISPPRE_BUS) : 0;
+	clk_set_rate(csis->bus_clk, CSIS_BUS_RATE / 2);
+	ret = clk_set_rate(csis->bus_clk, CSIS_BUS_RATE);
+	if (!ret && e9820_cmu_top) {
+		u32 div_after = readl(e9820_cmu_top + CMU_TOP_DIV_ISPPRE_BUS);
+
+		if ((div_before ^ div_after) & 0xf)
+			dev_warn(csis->dev, "ISPPRE bus divider was 0x%x, rewritten to 0x%x (lost over a system sleep?)\n",
+				 div_before & 0xf, div_after & 0xf);
+	}
+	if (!ret)
+		ret = clk_prepare_enable(csis->bus_clk);
+	if (ret)
+		goto err_rpm;
+
+	if (cmu_option)
+		e9820_rmw(csis->cmu + CMU_OPTION, cmu_option, cmu_option);
+
+	/* The block comes out of power-down on the 26 MHz oscillator. */
+	e9820_rmw(csis->cmu + CMU_BUS_USER_MUX, CMU_BUS_USER_MUX_SEL,
+		  CMU_BUS_USER_MUX_SEL);
+	ret = readl_poll_timeout(csis->cmu + CMU_BUS_USER_MUX, val,
+				 !(val & CMU_BUS_USER_MUX_BUSY), 10, 1000);
+	if (ret) {
+		dev_err(csis->dev, "bus clock mux stuck busy\n");
+		goto err_clk;
+	}
+
+	dev_info(csis->dev, "CSIS version 0x%08x, bus clock %lu Hz, %ux%u, %u lanes, %u Mbit/s, settle %u%s, source %s (switch %u)\n",
+		 readl(csis->csis + CSIS_VERSION), clk_get_rate(csis->bus_clk),
+		 width, height, lanes, mbps, e9820_csis_find_settle(mbps),
+		 csis->phy_combo ? ", combo PHY" :
+		 csis->phy_split ? ", split PHY" : "",
+		 csis->sensor ? csis->sensor->name : "none",
+		 csis->source ? csis->source->mux : 0);
+
+	/* reset state of the block after power-on; the vendor PMU code restores these */
+	dev_info(csis->dev, "CMU user mux 0x%08x option 0x%08x, SYSREG DRCG 0x%08x MEMCLK 0x%08x DMA mux 0x%08x PHY reset 0x%08x\n",
+		 readl(csis->cmu + CMU_BUS_USER_MUX), readl(csis->cmu + 0x0800),
+		 readl(csis->sysreg + 0x0104), readl(csis->sysreg + 0x0108),
+		 readl(csis->sysreg + SYSREG_SC_CON_DMA(csis->dma_index)),
+		 readl(csis->sysreg + SYSREG_PHY_RESET));
+
+	ret = e9820_csis_phy_power(csis, true);
+	if (ret)
+		goto err_clk;
+
+	ret = e9820_csis_sw_reset(csis);
+	if (ret) {
+		dev_err(csis->dev, "CSIS reset timed out\n");
+		goto err_phy;
+	}
+
+	/* DMA input: the receiver wired to it (not a PDP output) */
+	writel(0, csis->sysreg + SYSREG_SC_CON_DMA(csis->dma_index));
+
+	/* DMA off before anything else; it has no reset of its own */
+	writel(0, csis->dma + DMA_CTRL);
+	writel(readl(csis->dma_cmn + DMA_INT_SRC), csis->dma_cmn + DMA_INT_SRC);
+
+	{
+		writel(CSIS_INT0_ENABLE, csis->csis + CSIS_INT_MSK0);
+		writel(CSIS_INT1_ERRORS, csis->csis + CSIS_INT_MSK1);
+
+		e9820_csis_phy_config(csis, mbps);
+
+		e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_LANE_NUMBER,
+			  FIELD_PREP(CSIS_CMN_CTRL_LANE_NUMBER, lanes - 1));
+		e9820_rmw(csis->csis + CSIS_PHY_CMN_CTRL,
+			  CSIS_PHY_CMN_CTRL_ENABLE_DAT,
+			  FIELD_PREP(CSIS_PHY_CMN_CTRL_ENABLE_DAT,
+				     BIT(lanes) - 1));
+		/* interleave mode 2: virtual channels only */
+		e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_INTERLEAVE,
+			  FIELD_PREP(CSIS_CMN_CTRL_INTERLEAVE, 2));
+		writel(1, csis->csis + CSIS_DEBUG_OPTION_SUITE); /* pixel align */
+
+		for (ch = 0; ch < 4; ch++) {
+			u32 dt = ch ? MIPI_DT_UNUSED : MIPI_DT_RAW10;
+
+			if (ch && csis->vc_dt[ch])
+				dt = csis->vc_dt[ch];
+			val = FIELD_PREP(CSIS_ISP_CONFIG_PIXEL_MODE,
+					 CSIS_PIXEL_MODE_DUAL) |
+			      FIELD_PREP(CSIS_ISP_CONFIG_DATAFORMAT, dt) |
+			      FIELD_PREP(CSIS_ISP_CONFIG_VC, ch);
+			writel(val, csis->csis + CSIS_ISP_CONFIG(ch));
+			writel(!ch ? height << 16 | width :
+			       dt != MIPI_DT_UNUSED ? csis->vc_resol[ch] : 0,
+			       csis->csis + CSIS_ISP_RESOL(ch));
+			if (ch && dt != MIPI_DT_UNUSED)
+				dev_info(csis->dev, "VC%u: data type 0x%02x, %ux%u, received and dropped\n",
+					 ch, dt, csis->vc_resol[ch] & 0xffff,
+					 csis->vc_resol[ch] >> 16);
+		}
+	}
+
+	writel(0, csis->dma + DMA_FMT);	/* unpacked 16 bit */
+	writel(width, csis->dma + DMA_RESOL);
+	writel(0, csis->dma + DMA_FCNTSEQ);
+	writel(0, csis->dma_cmn + DMA_OTF_FORMAT);	/* RAW10 */
+	e9820_rmw(csis->dma_cmn + DMA_DATA_CTRL, BIT(0), 0);	/* OTF input */
+	e9820_rmw(csis->dma_cmn + DMA_CMN_CTRL, DMA_CMN_CTRL_ABORT_REQ, 0);
+	writel(DMA_INT_ABORT_DONE, csis->dma_cmn + DMA_INT_SRC);
+	writel(DMA_INT_ENABLE, csis->dma_cmn + DMA_INT_MASK);
+
+	writel(0x6, csis->dma_top + DMATOP_ARB_PRI);
+	e9820_rmw(csis->dma_top + DMATOP_CTRL, DMATOP_CTRL_IP_PROCESSING,
+		  DMATOP_CTRL_IP_PROCESSING);
+	writel(0x04800480, csis->dma_top + DMATOP_SRAM_SPLIT);
+	e9820_rmw(csis->dma_top + DMATOP_MATRIX, 0x1f, 0);
+
+	enable_irq(csis->irq_csis);
+	enable_irq(csis->irq_dma);
+
+	spin_lock_irqsave(&csis->slock, flags);
+	csis->sequence = 0;
+	csis->n_fs = csis->n_fe = csis->n_err = 0;
+	csis->n_dma_start = csis->n_dma_end = csis->n_dma_err = 0;
+	csis->err0 = csis->err1 = 0;
+	csis->abort_frame = false;
+	csis->n_abort = 0;
+	csis->streaming = true;
+	csis->cur = NULL;
+	csis->next = e9820_csis_next_queued(csis);
+	e9820_csis_dma_arm(csis, csis->next);
+	spin_unlock_irqrestore(&csis->slock, flags);
+
+	/* csi_hw_enable() */
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_UPDATE_SHADOW,
+		  CSIS_CMN_CTRL_UPDATE_SHADOW);
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_PHY_SEL, 0);
+	e9820_rmw(csis->csis + CSIS_PHY_CMN_CTRL, CSIS_PHY_CMN_CTRL_ENABLE_CLK,
+		  CSIS_PHY_CMN_CTRL_ENABLE_CLK);
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_QCHANNEL_EN, 0);
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_CSI_EN,
+		  CSIS_CMN_CTRL_CSI_EN);
+
+	e9820_csis_dump(csis, "start");
+	if (e9820_csis_wedged)
+		e9820_csis_wedge_dump(csis, "start after wedge");
+	return 0;
+
+err_phy:
+	e9820_csis_phy_power(csis, false);
+err_clk:
+	clk_disable_unprepare(csis->bus_clk);
+err_rpm:
+	pm_runtime_put_sync(csis->dev);
+err_hold:
+	if (csis->held) {
+		exynos_acpm_dvfs_hold(false);
+		csis->held = false;
+	}
+err_active:
+	WRITE_ONCE(e9820_csis_active, NULL);
+	return ret;
+}
+
+static void e9820_csis_hw_stop(struct e9820_csis *csis)
+{
+	unsigned long flags;
+	bool wedged;
+	u32 val;
+
+	spin_lock_irqsave(&csis->slock, flags);
+	csis->streaming = false;
+	wedged = csis->n_dma_start > 2 && !csis->n_dma_end;
+	spin_unlock_irqrestore(&csis->slock, flags);
+
+	if (!wedged)
+		e9820_csis_dump(csis, "stop");
+	if (wedged) {
+		e9820_csis_wedge_dump(csis, "stop, wedged");
+		e9820_csis_wedges++;
+		dev_err(csis->dev, "DMA wedged: %u frames started, none ended (wedge %u since boot)\n",
+			csis->n_dma_start, e9820_csis_wedges);
+	} else if (csis->n_dma_end) {
+		if (e9820_csis_wedged)
+			dev_info(csis->dev, "DMA recovered after a wedge\n");
+		e9820_csis_wedged = false;
+	}
+	if (wedged)
+		e9820_csis_wedged = true;
+
+	/* csi_hw_disable() */
+	e9820_rmw(csis->csis + CSIS_PHY_CMN_CTRL,
+		  CSIS_PHY_CMN_CTRL_ENABLE_CLK | CSIS_PHY_CMN_CTRL_ENABLE_DAT, 0);
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_CSI_EN, 0);
+	e9820_csis_sw_reset(csis);
+
+	spin_lock_irqsave(&csis->slock, flags);
+	writel(0, csis->dma + DMA_CTRL);
+	spin_unlock_irqrestore(&csis->slock, flags);
+	/* let a frame in flight end before the block loses power */
+	msleep(40);
+	/* and terminate one that cannot end (a stream that only had errors) */
+	e9820_csis_dma_abort_sync(csis);
+
+	writel(0, csis->csis + CSIS_INT_MSK0);
+	writel(0, csis->csis + CSIS_INT_MSK1);
+	writel(0, csis->dma_cmn + DMA_INT_MASK);
+	disable_irq(csis->irq_csis);
+	disable_irq(csis->irq_dma);
+
+	dev_info(csis->dev, "stopped: FS %u FE %u errors %u, DMA start %u end %u errors %u, aborts %u\n",
+		 csis->n_fs, csis->n_fe, csis->n_err, csis->n_dma_start,
+		 csis->n_dma_end, csis->n_dma_err, csis->n_abort);
+	if (csis->n_err)
+		/* INT_SRC0: [19:16] SOT_HS [15:12] LOST_FS [11:8] LOST_FE [4] OVER [3] WRONG_CFG [2] ECC [1] CRC [0] ID */
+		dev_info(csis->dev, "error bits seen: INT_SRC0 0x%05x%s%s%s%s%s%s%s%s, INT_SRC1 0x%04x\n",
+			 csis->err0,
+			 csis->err0 & 0xf0000 ? " SOT_HS" : "",
+			 csis->err0 & 0x0f000 ? " LOST_FS" : "",
+			 csis->err0 & 0x00f00 ? " LOST_FE" : "",
+			 csis->err0 & BIT(4) ? " OVER" : "",
+			 csis->err0 & BIT(3) ? " WRONG_CFG" : "",
+			 csis->err0 & BIT(2) ? " ECC" : "",
+			 csis->err0 & BIT(1) ? " CRC" : "",
+			 csis->err0 & BIT(0) ? " ID" : "", csis->err1);
+
+	e9820_csis_phy_power(csis, false);
+
+	/*
+	 * Back to the state the block has after reset, which is known to
+	 * power off: with IP_PROCESSING left set the domain refused to
+	 * (STATUS stuck at 1). The vendor code never clears it, but it also
+	 * restores CMU Q-channel settings that we leave at reset values.
+	 */
+	e9820_rmw(csis->dma_top + DMATOP_CTRL, DMATOP_CTRL_IP_PROCESSING, 0);
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_QCHANNEL_EN, 0);
+	e9820_rmw(csis->cmu + CMU_BUS_USER_MUX, CMU_BUS_USER_MUX_SEL, 0);
+	readl_poll_timeout(csis->cmu + CMU_BUS_USER_MUX, val,
+			   !(val & CMU_BUS_USER_MUX_BUSY), 10, 1000);
+	dev_info(csis->dev, "idle: DMA top CTRL 0x%08x CSIS CMN_CTRL 0x%08x CMU user mux 0x%08x\n",
+		 readl(csis->dma_top + DMATOP_CTRL),
+		 readl(csis->csis + CSIS_CMN_CTRL),
+		 readl(csis->cmu + CMU_BUS_USER_MUX));
+
+	clk_disable_unprepare(csis->bus_clk);
+	pm_runtime_put_sync(csis->dev);
+
+	/* The domain has no other user: it must be off now. */
+	regmap_read(csis->pmu, PMU_ISPPRE_STATUS, &val);
+	if (val & 1) {
+		u32 states = 0;
+
+		regmap_read(csis->pmu, PMU_ISPPRE_STATES, &states);
+		csis->pd_stuck = true;
+		dev_err(csis->dev, "ISPPRE did not power off (STATUS 0x%x STATES 0x%x): no further streaming until reboot\n",
+			val, states);
+	}
+
+	if (csis->held) {
+		exynos_acpm_dvfs_hold(false);
+		csis->held = false;
+	}
+	WRITE_ONCE(e9820_csis_active, NULL);
+}
+
+/* -------------------------------------------------------------------------
+ * videobuf2
+ */
+
+static int e9820_csis_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+				  unsigned int *nplanes, unsigned int sizes[],
+				  struct device *alloc_devs[])
+{
+	struct e9820_csis *csis = vb2_get_drv_priv(q);
+
+	if (*nplanes)
+		return sizes[0] < csis->fmt.sizeimage ? -EINVAL : 0;
+
+	*nplanes = 1;
+	sizes[0] = csis->fmt.sizeimage;
+	return 0;
+}
+
+static int e9820_csis_buf_prepare(struct vb2_buffer *vb)
+{
+	struct e9820_csis *csis = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb2_plane_size(vb, 0) < csis->fmt.sizeimage)
+		return -EINVAL;
+	if (upper_32_bits(vb2_dma_contig_plane_dma_addr(vb, 0)))
+		return -EFAULT;
+	return 0;
+}
+
+static void e9820_csis_buf_queue(struct vb2_buffer *vb)
+{
+	struct e9820_csis *csis = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct e9820_csis_buffer *buf =
+		container_of(vbuf, struct e9820_csis_buffer, vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&csis->slock, flags);
+	if (csis->streaming && !csis->next) {
+		/* DMA idle or nothing set for the next frame: set it now */
+		csis->next = buf;
+		e9820_csis_dma_arm(csis, buf);
+	} else {
+		list_add_tail(&buf->list, &csis->queued);
+	}
+	spin_unlock_irqrestore(&csis->slock, flags);
+}
+
+static void e9820_csis_return_buffers(struct e9820_csis *csis,
+				      enum vb2_buffer_state state)
+{
+	struct e9820_csis_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&csis->slock, flags);
+	if (csis->cur)
+		vb2_buffer_done(&csis->cur->vb.vb2_buf, state);
+	if (csis->next)
+		vb2_buffer_done(&csis->next->vb.vb2_buf, state);
+	csis->cur = NULL;
+	csis->next = NULL;
+	list_for_each_entry_safe(buf, tmp, &csis->queued, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&csis->slock, flags);
+}
+
+static int e9820_csis_check_sensor(struct e9820_csis *csis)
+{
+	struct v4l2_subdev_format sfmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+	};
+	const struct e9820_csis_format *f;
+	struct e9820_csis_source *src = NULL;
+	struct v4l2_mbus_frame_desc fd = { };
+	struct media_pad *pad;
+	unsigned int i;
+	s64 freq;
+	int ret;
+
+	/* the sensor whose link is enabled */
+	pad = media_pad_remote_pad_unique(&csis->pad);
+	if (IS_ERR(pad)) {
+		dev_err(csis->dev, "no sensor selected (exactly one link must be enabled): %ld\n",
+			PTR_ERR(pad));
+		return PTR_ERR(pad);
+	}
+	for (i = 0; i < csis->num_sources; i++)
+		if (csis->sources[i]->sd &&
+		    &csis->sources[i]->sd->entity == pad->entity)
+			src = csis->sources[i];
+	if (!src)
+		return -ENODEV;
+	csis->source = src;
+	csis->sensor = src->sd;
+	csis->bus = src->bus;
+	sfmt.pad = pad->index;
+
+	ret = v4l2_subdev_call_state_active(csis->sensor, pad, get_fmt, &sfmt);
+	if (ret)
+		return ret;
+
+	f = e9820_csis_find_fourcc(csis->fmt.pixelformat);
+	if (!f || f->mbus != sfmt.format.code ||
+	    sfmt.format.width != csis->fmt.width ||
+	    sfmt.format.height != csis->fmt.height) {
+		dev_err(csis->dev, "sensor outputs 0x%04x %ux%u, video node is set to %p4cc %ux%u\n",
+			sfmt.format.code, sfmt.format.width, sfmt.format.height,
+			&csis->fmt.pixelformat, csis->fmt.width, csis->fmt.height);
+		return -EPIPE;
+	}
+
+	freq = v4l2_get_link_freq(pad, 10, 2 * csis->bus.num_data_lanes);
+	if (freq < 0)
+		return freq;
+	csis->link_freq = freq;
+
+	/*
+	 * Other virtual channels of the sensor. Convention between the
+	 * drivers of this port: entry length = width | height << 16.
+	 */
+	memset(csis->vc_dt, 0, sizeof(csis->vc_dt));
+	if (!v4l2_subdev_call(csis->sensor, pad, get_frame_desc, pad->index,
+			      &fd) && fd.type == V4L2_MBUS_FRAME_DESC_TYPE_CSI2) {
+		for (i = 0; i < fd.num_entries; i++) {
+			u8 vc = fd.entry[i].bus.csi2.vc;
+
+			if (vc < 1 || vc > 3)
+				continue;
+			csis->vc_dt[vc] = fd.entry[i].bus.csi2.dt;
+			csis->vc_resol[vc] = (fd.entry[i].length >> 16) << 16 |
+					     (fd.entry[i].length & 0xffff);
+		}
+	}
+	return 0;
+}
+
+static int e9820_csis_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct e9820_csis *csis = vb2_get_drv_priv(q);
+	int ret;
+
+	ret = e9820_csis_check_sensor(csis);
+	if (ret)
+		goto err_buffers;
+
+	ret = video_device_pipeline_alloc_start(&csis->vdev);
+	if (ret)
+		goto err_buffers;
+
+	/* Receiver and PHY first, then the sensor, as the vendor driver. */
+	ret = e9820_csis_hw_start(csis);
+	if (ret)
+		goto err_pipeline;
+
+	ret = v4l2_subdev_call(csis->sensor, video, s_stream, 1);
+	if (ret) {
+		e9820_csis_hw_stop(csis);
+		goto err_pipeline;
+	}
+	return 0;
+
+err_pipeline:
+	video_device_pipeline_stop(&csis->vdev);
+err_buffers:
+	e9820_csis_return_buffers(csis, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void e9820_csis_stop_streaming(struct vb2_queue *q)
+{
+	struct e9820_csis *csis = vb2_get_drv_priv(q);
+
+	v4l2_subdev_call(csis->sensor, video, s_stream, 0);
+	e9820_csis_hw_stop(csis);
+	video_device_pipeline_stop(&csis->vdev);
+	e9820_csis_return_buffers(csis, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops e9820_csis_vb2_ops = {
+	.queue_setup = e9820_csis_queue_setup,
+	.buf_prepare = e9820_csis_buf_prepare,
+	.buf_queue = e9820_csis_buf_queue,
+	.start_streaming = e9820_csis_start_streaming,
+	.stop_streaming = e9820_csis_stop_streaming,
+};
