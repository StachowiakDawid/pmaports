+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos 9820 MIPI CSIS (v5.2) RAW capture.
+ *
+ * One instance covers a CSI-2 receiver, its D-PHY and the write DMA that is
+ * hard-wired to it ("CSISX4_PDP_DMA"). Frames of virtual channel 0 are
+ * written to memory as unpacked 16-bit Bayer; the ISP blocks are not used.
+ *
+ * The register sequences follow the Samsung SM-G975F kernel
+ * (fimc-is2/sensor/csi2/fimc-is-hw-csi-v5_2.c, fimc-is-device-csi_v4.c,
+ * drivers/phy/samsung/phy-exynos-mipi.c). This is a bring-up driver:
+ * no IOMMU (the DMA gets bus addresses below 4 GiB), one virtual channel,
+ * D-PHY only, one receiver streaming at a time (the receivers share the DMA
+ * top, the bus clock mux and the PHY isolation bit).
+ *
+ * A receiver can have several sensors behind a MIPI switch ("mux" GPIO, the
+ * endpoint number is the switch position); the enabled media link selects
+ * the sensor.
+ *
+ * While streaming, the MIF/INT levels are held up through ACPM (the 400 MHz
+ * bus clock needs the full INT level, which user space lowers when the
+ * display is off), and system suspend is refused.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+#include <media/media-device.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-v4l2.h>
+
+/* CSIS core */
+#define CSIS_VERSION			0x0000
+#define CSIS_CMN_CTRL			0x0004
+#define CSIS_CMN_CTRL_PHY_SEL		BIT(21)
+#define CSIS_CMN_CTRL_QCHANNEL_EN	BIT(20)
+#define CSIS_CMN_CTRL_UPDATE_SHADOW	GENMASK(19, 16)
+#define CSIS_CMN_CTRL_INTERLEAVE	GENMASK(11, 10)
+#define CSIS_CMN_CTRL_LANE_NUMBER	GENMASK(9, 8)
+#define CSIS_CMN_CTRL_SW_RESET		BIT(1)
+#define CSIS_CMN_CTRL_CSI_EN		BIT(0)
+#define CSIS_INT_MSK0			0x0010
+#define CSIS_INT_SRC0			0x0014
+#define CSIS_INT0_FRAMESTART		GENMASK(27, 24)
+#define CSIS_INT0_FRAMEEND		GENMASK(23, 20)
+#define CSIS_INT0_ERRORS		0x000fff1f
+#define CSIS_INT0_ENABLE		0x011fff1f	/* FS/FE of VC0, errors */
+#define CSIS_INT_MSK1			0x0018
+#define CSIS_INT_SRC1			0x001c
+#define CSIS_INT1_ERRORS		0x0000fff0
+#define CSIS_ISP_CONFIG(ch)		(0x0040 + (ch) * 0x10)
+#define CSIS_ISP_CONFIG_PIXEL_MODE	GENMASK(13, 12)
+#define CSIS_PIXEL_MODE_DUAL		1
+#define CSIS_ISP_CONFIG_DATAFORMAT	GENMASK(7, 2)
+#define CSIS_ISP_CONFIG_VC		GENMASK(1, 0)
+#define CSIS_ISP_RESOL(ch)		(0x0044 + (ch) * 0x10)
+#define CSIS_FRM_CNT(ch)		(0x0100 + (ch) * 4)
+#define CSIS_DEBUG_OPTION_SUITE		0x0500
+#define CSIS_PHY_STATUS			0x0700
+#define CSIS_PHY_CMN_CTRL		0x0704
+#define CSIS_PHY_CMN_CTRL_ENABLE_DAT	GENMASK(4, 1)
+#define CSIS_PHY_CMN_CTRL_ENABLE_CLK	BIT(0)
+
+#define MIPI_DT_RAW10			0x2b
+#define MIPI_DT_UNUSED			0x3f
+
+/* Write DMA, per virtual channel */
+#define DMA_CTRL			0x0000
+#define DMA_CTRL_UPDT_FRAMEPTR		GENMASK(6, 2)
+#define DMA_CTRL_UPDT_PTR_EN		BIT(1)
+#define DMA_CTRL_ENABLE			BIT(0)
+#define DMA_FMT				0x0004
+#define DMA_ADDR1			0x0010
+#define DMA_ACT_CTRL			0x0090
+#define DMA_RESOL			0x00a4
+#define DMA_FCNTSEQ			0x00b0
+
+/* Write DMA, common */
+#define DMA_DATA_CTRL			0x0000
+#define DMA_INT_MASK			0x0004
+#define DMA_INT_SRC			0x0008
+#define DMA_INT_OTF_OVERLAP_VC0		BIT(20)
+#define DMA_INT_ABORT_DONE		BIT(16)
+#define DMA_INT_ERROR			BIT(12)
+#define DMA_INT_FRM_END_VC0		BIT(8)
+#define DMA_INT_FRM_START_VC0		BIT(4)
+#define DMA_INT_ENABLE	(DMA_INT_OTF_OVERLAP_VC0 | DMA_INT_ABORT_DONE | \
+			 DMA_INT_ERROR | DMA_INT_FRM_END_VC0 | \
+			 DMA_INT_FRM_START_VC0)
+#define DMA_CMN_CTRL			0x0014
+#define DMA_CMN_CTRL_ABORT_REQ		BIT(0)
+#define DMA_ERR_CODE			0x0018
+#define DMA_OTF_FORMAT			0x001c
+
+/* Write DMA, top (shared by the four DMAs) */
+#define DMATOP_ARB_PRI			0x0000
+#define DMATOP_CTRL			0x0008
+#define DMATOP_CTRL_Q_CHANNEL_EN		BIT(2)
+#define DMATOP_CTRL_IP_PROCESSING	BIT(1)
+#define DMATOP_CLK_CTRL			0x0014
+#define DMATOP_FIFO_CTRL		0x0018
+#define DMATOP_DBG_MON_HW(n)		(0x0104 + (n) * 4)
+#define DMATOP_SRAM_SPLIT		0x000c
+#define DMATOP_MATRIX			0x0010
+#define DMATOP_TP_ENABLE		0x0020
+#define DMATOP_TP_ENABLE_ON		BIT(31)
+#define DMATOP_TP_ENABLE_PPC		BIT(30)
+#define DMATOP_TP_CTRL			0x0024
+#define DMATOP_TP_RESOL			0x0028
+
+/* SYSREG_ISPPRE */
+#define SYSREG_SC_CON_DMA(n)		(0x040c + (n) * 4)	/* DMA input mux */
+#define SYSREG_PHY_RESET		0x0500
+
+/* CMU_ISPPRE */
+#define CMU_BUS_USER_MUX		0x0100
+#define CMU_BUS_USER_MUX_SEL		BIT(4)
+#define CMU_BUS_USER_MUX_BUSY		BIT(7)
+#define CMU_OPTION			0x0800
+#define CMU_OPTION_PWR_MANAGEMENT	BIT(29)
+#define CMU_QCH_CON(off)		(0x3000 + (off))
+#define CMU_QCH_DBG(off)		(0x7000 + (off))
+#define CMU_MAP_SIZE			0x8000
+
+#define PMU_MIPI_PHY_ISO_BYPASS		BIT(0)
+/* ISPPRE local power: CONFIGURATION, STATUS, STATES */
+#define PMU_ISPPRE_STATUS		0x2504
+#define PMU_ISPPRE_STATES		0x2508
+#define PMU_ISPPRE_STATES_ON		0x10
+
+#define CSIS_BUS_RATE			400000000UL
+#define CSIS_MIN_WIDTH			64
+#define CSIS_MAX_WIDTH			8192
+#define CSIS_MAX_SOURCES		2
+
+/*
+ * CMU_ISPPRE comes out of the power-up with its controller option register
+ * at 0; the vendor PMU code restores a saved value. Without "power
+ * management" (bit 29) the block does not follow the power-down request of
+ * the PMU (STATUS stays 1).
+ */
+static uint cmu_option;
+module_param(cmu_option, uint, 0644);
+MODULE_PARM_DESC(cmu_option, "Bits set in the CMU_ISPPRE controller option register at start (default: none, the power domain driver restores the register)");
+
+/* One sensor of a receiver; the endpoint number is the MIPI switch position. */
+struct e9820_csis_source {
+	struct v4l2_async_connection asc;	/* must be first */
+	struct v4l2_subdev *sd;
+	struct v4l2_mbus_config_mipi_csi2 bus;
+	u32 mux;
+};
+
+struct e9820_csis_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+};
+
+struct e9820_csis {
+	struct device *dev;
+	void __iomem *csis;
+	void __iomem *dma;
+	void __iomem *dma_cmn;
+	void __iomem *dma_top;
+	void __iomem *phy;
+	void __iomem *sysreg;
+	void __iomem *cmu;
+	void __iomem *sysmmu;
+	struct regmap *pmu;
+	u32 phy_iso_offset;
+	u32 phy_reset_bit;
+	u32 dma_index;
+	bool phy_combo;
+	bool phy_split;			/* half of a shared S4 block */
+	bool phy_iso_shared;		/* isolation also used by the display */
+	struct gpio_desc *mux_gpio;
+	struct clk *bus_clk;
+	int irq_csis;
+	int irq_dma;
+
+	struct v4l2_device v4l2_dev;
+	struct media_device mdev;
+	struct video_device vdev;
+	struct media_pad pad;
+	struct vb2_queue queue;
+	struct mutex lock;		/* video device and queue */
+	struct v4l2_async_notifier notifier;
+	struct e9820_csis_source *sources[CSIS_MAX_SOURCES];
+	unsigned int num_sources;
+	struct e9820_csis_source *source;	/* selected at stream start */
+	struct v4l2_subdev *sensor;
+	struct v4l2_mbus_config_mipi_csi2 bus;
+	u64 link_freq;
+
+	struct v4l2_pix_format fmt;
+
+	spinlock_t slock;		/* buffer state below, DMA registers */
+	struct list_head queued;
+	struct e9820_csis_buffer *cur;	/* being written */
+	struct e9820_csis_buffer *next;	/* programmed for the next frame */
+	bool streaming;
+	bool pd_stuck;			/* a power-off did not complete */
+	bool held;			/* MIF/INT hold taken */
+	u32 sequence;
+	u32 n_fs, n_fe, n_err, n_dma_start, n_dma_end, n_dma_err;
+	u32 err0, err1;			/* error bits seen in this stream */
+	bool abort_frame;		/* DMA abort requested in this frame */
+	unsigned int n_abort;		/* DMA aborts requested in this stream */
+	/*
+	 * Further virtual channels the sensor sends (phase detection data):
+	 * data type and size from its frame descriptor. They are received
+	 * and dropped; left unconfigured every line raised ERR_ID.
+	 */
+	u8 vc_dt[4];
+	u32 vc_resol[4];
+};
+
+struct e9820_csis_format {
+	u32 mbus;
+	u32 fourcc;
+};
+
+static const struct e9820_csis_format e9820_csis_formats[] = {
+	{ MEDIA_BUS_FMT_SGRBG10_1X10, V4L2_PIX_FMT_SGRBG10 },
+	{ MEDIA_BUS_FMT_SRGGB10_1X10, V4L2_PIX_FMT_SRGGB10 },
+	{ MEDIA_BUS_FMT_SBGGR10_1X10, V4L2_PIX_FMT_SBGGR10 },
+	{ MEDIA_BUS_FMT_SGBRG10_1X10, V4L2_PIX_FMT_SGBRG10 },
+};
+
+static const struct e9820_csis_format *e9820_csis_find_fourcc(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(e9820_csis_formats); i++)
+		if (e9820_csis_formats[i].fourcc == fourcc)
+			return &e9820_csis_formats[i];
+	return NULL;
+}
+
+/* The receiver that is streaming (they share parts of the block). */
+static struct e9820_csis *e9820_csis_active;
+
+/*
+ * "Wedge": a stream whose DMA started frames but never ended one (CSIS OVER
+ * on every line). Seen after a stream full of errors and after many
+ * suspend/resume cycles; until reboot every receiver then behaves the same.
+ * The state is shared (one DMA top, one bus path), so it is global.
+ */
+static bool e9820_csis_wedged;
+static unsigned int e9820_csis_wedges;
+
+/* CMU_TOP (always on) ISPPRE bus clock registers, read-only for the log */
+static void __iomem *e9820_cmu_top;
+#define CMU_TOP_MUX_ISPPRE_BUS		0x1094
+#define CMU_TOP_DIV_ISPPRE_BUS		0x1884
+#define CMU_TOP_GATE_ISPPRE_BUS		0x20a0
+
+/* SysMMU ISPPRE (in the CSIS DMA path, never enabled by us) */
+#define SYSMMU_ISPPRE_BASE		0x17210000
+#define SYSMMU_ISPPRE_SIZE		0x1100
+
+static void e9820_rmw(void __iomem *reg, u32 mask, u32 val)
+{
+	writel((readl(reg) & ~mask) | val, reg);
+}
+
+/* -------------------------------------------------------------------------
+ * Hardware
+ */
+
+/*
+ * D-PHY HS settle values of the vendor driver (fimc-is-hw-settle-8nm-lpp.h),
+ * as { lowest lane rate in Mbit/s, value }, descending. The value drops back
+ * below 1500 Mbit/s because the PHY then uses the other settle clock.
+ */
+static const struct { u16 mbps; u8 settle; } e9820_csis_settle[] = {
+	{ 6410, 37 }, { 6240, 36 }, { 6080, 35 }, { 5910, 34 }, { 5740, 33 },
+	{ 5580, 32 }, { 5410, 31 }, { 5250, 30 }, { 5080, 29 }, { 4910, 28 },
+	{ 4750, 27 }, { 4580, 26 }, { 4410, 25 }, { 4250, 24 }, { 4080, 23 },
+	{ 3910, 22 }, { 3750, 21 }, { 3580, 20 }, { 3420, 19 }, { 3250, 18 },
+	{ 3080, 17 }, { 2920, 16 }, { 2750, 15 }, { 2580, 14 }, { 2420, 13 },
+	{ 2250, 12 }, { 2080, 11 }, { 1920, 10 }, { 1750, 9 }, { 1590, 8 },
+	{ 1500, 7 }, { 1480, 73 }, { 1460, 72 }, { 1440, 71 }, { 1420, 70 },
+	{ 1400, 69 }, { 1380, 68 }, { 1360, 67 }, { 1340, 66 }, { 1320, 65 },
+	{ 1290, 64 }, { 1270, 63 }, { 1250, 62 }, { 1230, 61 }, { 1210, 60 },
+	{ 1190, 59 }, { 1170, 58 }, { 1150, 57 }, { 1130, 56 }, { 1110, 55 },
+	{ 1090, 54 }, { 1070, 53 }, { 1040, 52 }, { 1020, 51 }, { 1000, 50 },
+	{ 980, 49 }, { 960, 48 }, { 940, 47 }, { 920, 46 }, { 900, 45 },
+	{ 880, 44 }, { 860, 43 }, { 840, 42 }, { 820, 41 }, { 800, 40 },
+	{ 770, 39 }, { 750, 38 }, { 730, 37 }, { 710, 36 }, { 690, 35 },
+	{ 670, 34 }, { 650, 33 }, { 630, 32 }, { 610, 31 }, { 590, 30 },
+	{ 570, 29 }, { 550, 28 }, { 520, 27 }, { 500, 26 }, { 480, 25 },
+	{ 460, 24 }, { 440, 23 }, { 420, 22 }, { 400, 21 }, { 380, 20 },
+	{ 360, 19 }, { 340, 18 }, { 320, 17 }, { 300, 16 }, { 280, 15 },
+	{ 250, 14 }, { 230, 13 }, { 210, 12 }, { 190, 11 }, { 170, 10 }, { 150, 9 },
+	{ 130, 8 }, { 110, 7 }, { 90, 6 }, { 80, 5 },
+};
+
+static u32 e9820_csis_find_settle(u32 mbps)
+{
+	unsigned int i;
+
+	/* the vendor code rounds the rate up to a multiple of 10 first */
+	mbps = roundup(mbps, 10);
+	for (i = 0; i < ARRAY_SIZE(e9820_csis_settle); i++)
+		if (mbps >= e9820_csis_settle[i].mbps)
+			return e9820_csis_settle[i].settle;
+	return e9820_csis_settle[i - 1].settle;
+}
+
+/*
+ * __set_phy_cfg_0502_0002_dphy() of the vendor PHY driver. Type 0xD is a
+ * plain D-PHY, 0xDC a D/C-PHY combo used as D-PHY (CSIS0 and CSIS2), which
+ * has one more register in its first three lanes.
+ *
+ * CSIS3_1 has the two upper data lanes of an S4 block that it shares with
+ * CSIS3 (__set_phy_cfg_0502_0003_dphy()): its data lanes start at offset 0
+ * of its register range, the clock lane block is at 0x500, and two more
+ * bits are set in SD_ANA_CON2 (RESETN_CFG_SEL, RXDDRCLKHS_SEL). With the
+ * plain layout the clock lane was never configured and no frame arrived.
+ */
+static void e9820_csis_phy_config(struct e9820_csis *csis, u32 mbps)
+{
+	void __iomem *regs = csis->phy + (csis->phy_split ? 0x500 : 0);
+	void __iomem *lanes = csis->phy + (csis->phy_split ? 0 : 0x100);
+	u32 ana_con2 = csis->phy_split ? BIT(15) | BIT(7) : 0;
+	u32 settle_clk_sel = 1, skew_cal_en = 0, skew_delay_sel = 0;
+	u32 clk_div, hs_settle = e9820_csis_find_settle(mbps);
+	unsigned int i;
+
+	if (mbps >= 1500) {
+		settle_clk_sel = 0;
+		skew_cal_en = 1;
+		if (mbps >= 4000)
+			skew_delay_sel = 0;
+		else if (mbps >= 3000)
+			skew_delay_sel = 1;
+		else if (mbps >= 2000)
+			skew_delay_sel = 2;
+		else
+			skew_delay_sel = 3;
+	}
+	clk_div = max(0, 5 - (int)DIV_ROUND_UP((2 * mbps) >> 2, 26));
+
+	writel(0x00000001, regs + 0x0000);	/* SC_GNR_CON0 */
+	writel(0x00001450, regs + 0x0004);	/* SC_GNR_CON1 */
+	writel(0x00000004, regs + 0x0008);	/* SC_ANA_CON0 */
+	writel(0x00009000, regs + 0x000c);	/* SC_ANA_CON1 */
+	writel(0x00000005 | (clk_div & 3) << 8, regs + 0x0010); /* SC_ANA_CON2 */
+	writel(0x00000600, regs + 0x0014);	/* SC_ANA_CON3 */
+	writel(0x00000301, regs + 0x0030);	/* SC_TIME_CON0 */
+
+	for (i = 0; i < csis->bus.num_data_lanes; i++) {
+		void __iomem *l = lanes + i * 0x100;
+
+		writel(0x00000001, l + 0x00);	/* SD_GNR_CON0 */
+		writel(0x00001450, l + 0x04);	/* SD_GNR_CON1 */
+		writel(0x00000004, l + 0x08);	/* SD_ANA_CON0 */
+		writel(0x00009000, l + 0x0c);	/* SD_ANA_CON1 */
+		writel(0x00000005 | skew_delay_sel << 8 | ana_con2,
+		       l + 0x10);		/* SD_ANA_CON2 */
+		writel(0x00000600, l + 0x14);	/* SD_ANA_CON3 */
+		if (csis->phy_combo && i < 3)
+			writel(0x00000040, l + 0x24);	/* SD_ANA_CON7 */
+		e9820_rmw(l + 0x30, 0x1ff, (hs_settle & 0xff) | settle_clk_sel << 8);
+		writel(0x00000003, l + 0x34);	/* SD_TIME_CON1 */
+		e9820_rmw(l + 0x40, 1, skew_cal_en);	/* SD_DESKEW_CON0 */
+		writel(0x0000081a, l + 0x50);	/* SD_DESKEW_CON4 */
+	}
+}
+
+static int e9820_csis_phy_power(struct e9820_csis *csis, bool on)
+{
+	int ret;
+
+	if (on) {
+		ret = regmap_update_bits(csis->pmu, csis->phy_iso_offset,
+					 PMU_MIPI_PHY_ISO_BYPASS,
+					 PMU_MIPI_PHY_ISO_BYPASS);
+		if (ret)
+			return ret;
+	}
+
+	/* assert, then release for "on" */
+	e9820_rmw(csis->sysreg + SYSREG_PHY_RESET, BIT(csis->phy_reset_bit), 0);
+	if (on) {
+		e9820_rmw(csis->sysreg + SYSREG_PHY_RESET,
+			  BIT(csis->phy_reset_bit), BIT(csis->phy_reset_bit));
+		return 0;
+	}
+
+	/*
+	 * The isolation bit is shared by the PHYs of CSIS1/2/3/3_1; only one
+	 * receiver streams at a time, so it can be dropped here. The one of
+	 * CSIS0 belongs to the display PHY as well and is left alone.
+	 */
+	if (csis->phy_iso_shared)
+		return 0;
+	return regmap_update_bits(csis->pmu, csis->phy_iso_offset,
+				  PMU_MIPI_PHY_ISO_BYPASS, 0);
+}
+
+static int e9820_csis_sw_reset(struct e9820_csis *csis)
+{
+	u32 val;
+
+	e9820_rmw(csis->csis + CSIS_CMN_CTRL, CSIS_CMN_CTRL_SW_RESET,
+		  CSIS_CMN_CTRL_SW_RESET);
+	return readl_poll_timeout(csis->csis + CSIS_CMN_CTRL, val,
+				  !(val & CSIS_CMN_CTRL_SW_RESET), 10, 1000);
+}
+
+/* Call with slock held. */
+static void e9820_csis_dma_arm(struct e9820_csis *csis,
+			       struct e9820_csis_buffer *buf)
+{
+	u32 val;
+
+	if (!buf) {
+		writel(0, csis->dma + DMA_CTRL);
+		return;
+	}
+
+	writel(lower_32_bits(vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0)),
+	       csis->dma + DMA_ADDR1);
+	val = readl(csis->dma + DMA_FCNTSEQ);
+	writel(val | BIT(0), csis->dma + DMA_FCNTSEQ);
+	/* frame pointer 0, pointer update, enable */
+	writel(DMA_CTRL_UPDT_PTR_EN | DMA_CTRL_ENABLE, csis->dma + DMA_CTRL);
+}
+
+static struct e9820_csis_buffer *e9820_csis_next_queued(struct e9820_csis *csis)
+{
+	struct e9820_csis_buffer *buf;
+
+	buf = list_first_entry_or_null(&csis->queued, struct e9820_csis_buffer,
+				       list);
+	if (buf)
+		list_del(&buf->list);
+	return buf;
+}
+
+static void e9820_csis_buf_done(struct e9820_csis *csis,
+				struct e9820_csis_buffer *buf,
+				enum vb2_buffer_state state)
+{
+	buf->vb.vb2_buf.timestamp = ktime_get_ns();
+	buf->vb.sequence = csis->sequence++;
+	buf->vb.field = V4L2_FIELD_NONE;
+	vb2_set_plane_payload(&buf->vb.vb2_buf, 0, csis->fmt.sizeimage);
+	vb2_buffer_done(&buf->vb.vb2_buf, state);
+}
+
+/*
+ * Vendor csi_err_check(): on the first receiver or DMA error of a frame the
+ * write DMA is told to abort that frame (DMA_CMN_CTRL ABORT_REQ) instead of
+ * being left in the middle of it. Without this, one stream full of errors
+ * (s5k4ha 2744x2056, CSIS OVER + DMA errors on every line) left the write
+ * path stuck for every receiver until reboot ("DMA start N end 0").
+ * Called with slock held.
+ */
+static void e9820_csis_dma_abort_frame(struct e9820_csis *csis)
+{
+	if (csis->abort_frame)
+		return;
+	csis->abort_frame = true;
+	csis->n_abort++;
+	e9820_rmw(csis->dma_cmn + DMA_CMN_CTRL, DMA_CMN_CTRL_ABORT_REQ,
+		  DMA_CMN_CTRL_ABORT_REQ);
+}
+
+/* Abort whatever the write DMA still has in flight and wait for it. */
+static void e9820_csis_dma_abort_sync(struct e9820_csis *csis)
+{
+	u32 val;
+	int ret;
+
+	e9820_rmw(csis->dma_cmn + DMA_CMN_CTRL, DMA_CMN_CTRL_ABORT_REQ,
+		  DMA_CMN_CTRL_ABORT_REQ);
+	ret = readl_poll_timeout_atomic(csis->dma_cmn + DMA_INT_SRC, val,
+					val & DMA_INT_ABORT_DONE, 10, 20000);
+	writel(DMA_INT_ABORT_DONE, csis->dma_cmn + DMA_INT_SRC);
+	e9820_rmw(csis->dma_cmn + DMA_CMN_CTRL, DMA_CMN_CTRL_ABORT_REQ, 0);
+	if (ret)
+		dev_dbg(csis->dev, "DMA abort at stop: no abort-done (idle DMA)\n");
+}
+
+static irqreturn_t e9820_csis_dma_irq(int irq, void *data)
+{
+	struct e9820_csis *csis = data;
+	u32 status;
+
+	status = readl(csis->dma_cmn + DMA_INT_SRC);
+	writel(status, csis->dma_cmn + DMA_INT_SRC);
+
+	spin_lock(&csis->slock);
+
+	if (status & DMA_INT_ABORT_DONE)
+		e9820_rmw(csis->dma_cmn + DMA_CMN_CTRL, DMA_CMN_CTRL_ABORT_REQ, 0);
+
+	if (status & (DMA_INT_ERROR | DMA_INT_OTF_OVERLAP_VC0)) {
+		csis->n_dma_err++;
+		e9820_csis_dma_abort_frame(csis);
+		dev_warn_ratelimited(csis->dev, "DMA error 0x%08x code 0x%x\n",
+				     status, readl(csis->dma_cmn + DMA_ERR_CODE));
+	}
+
+	/*
+	 * A frame end and the next frame start can be reported together:
+	 * finish the old frame first.
+	 */
+	if (status & DMA_INT_FRM_END_VC0) {
+		csis->n_dma_end++;
+		if (csis->cur) {
+			e9820_csis_buf_done(csis, csis->cur, VB2_BUF_STATE_DONE);
+			csis->cur = NULL;
+		}
+	}
+
+	if (status & DMA_INT_FRM_START_VC0) {
+		csis->n_dma_start++;
+		/* an abort applies to one frame; never let it stick */
+		if (csis->abort_frame)
+			e9820_rmw(csis->dma_cmn + DMA_CMN_CTRL,
+				  DMA_CMN_CTRL_ABORT_REQ, 0);
+		csis->abort_frame = false;
+		if (csis->cur)	/* missed frame end */
+			e9820_csis_buf_done(csis, csis->cur, VB2_BUF_STATE_ERROR);
+		/* The frame that just started goes to the buffer set before. */
+		csis->cur = csis->next;
+		csis->next = csis->streaming ? e9820_csis_next_queued(csis) : NULL;
+		e9820_csis_dma_arm(csis, csis->next);
+	}
+	spin_unlock(&csis->slock);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t e9820_csis_irq(int irq, void *data)
+{
+	struct e9820_csis *csis = data;
+	u32 src0, src1;
+
+	src0 = readl(csis->csis + CSIS_INT_SRC0);
+	src1 = readl(csis->csis + CSIS_INT_SRC1);
+	writel(src0, csis->csis + CSIS_INT_SRC0);
+	writel(src1, csis->csis + CSIS_INT_SRC1);
+
+	spin_lock(&csis->slock);
+	if (src0 & CSIS_INT0_FRAMESTART)
+		csis->n_fs++;
+	if (src0 & CSIS_INT0_FRAMEEND)
+		csis->n_fe++;
+	if ((src0 & CSIS_INT0_ERRORS) || (src1 & CSIS_INT1_ERRORS)) {
+		csis->n_err++;
+		e9820_csis_dma_abort_frame(csis);
+		csis->err0 |= src0 & CSIS_INT0_ERRORS;
+		csis->err1 |= src1 & CSIS_INT1_ERRORS;
+		dev_warn_ratelimited(csis->dev, "CSIS error 0x%08x 0x%08x\n",
+				     src0 & CSIS_INT0_ERRORS,
+				     src1 & CSIS_INT1_ERRORS);
+	}
+	spin_unlock(&csis->slock);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * The block may only be touched when the domain is fully up. After a
+ * power-down that did not complete (STATUS still 1, STATES in the middle of
+ * the sequence) the power domain driver withdraws the request, but the block
+ * is not usable: an access then reset the phone. Refuse instead.
+ */
+static int e9820_csis_check_power(struct e9820_csis *csis, const char *when)
+{
+	u32 status = 0, states = 0;
+
+	regmap_read(csis->pmu, PMU_ISPPRE_STATUS, &status);
+	regmap_read(csis->pmu, PMU_ISPPRE_STATES, &states);
+	if ((status & 1) && states == PMU_ISPPRE_STATES_ON)
+		return 0;
+
+	dev_err(csis->dev, "%s: ISPPRE not fully up (STATUS 0x%x STATES 0x%x), refusing to touch it\n",
+		when, status, states);
+	return -EIO;
+}
+
+/* State of the powered block, for the kernel log (named registers only). */
+static void e9820_csis_dump(struct e9820_csis *csis, const char *when)
+{
