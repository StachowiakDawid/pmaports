+/*
+ * A lens actuator is bound by the notifier of its sensor, after (possibly
+ * long after) the sensor itself; this driver gets no callback for it, and
+ * the "complete" callback never runs on a receiver whose second sensor is
+ * absent. Create the device nodes of late sub-devices when the video node
+ * is opened.
+ */
+static int e9820_csis_open(struct file *file)
+{
+	struct e9820_csis *csis = video_drvdata(file);
+
+	mutex_lock(&csis->lock);
+	v4l2_device_register_subdev_nodes(&csis->v4l2_dev);
+	mutex_unlock(&csis->lock);
+
+	return v4l2_fh_open(file);
+}
+
+static const struct v4l2_file_operations e9820_csis_fops = {
+	.owner = THIS_MODULE,
+	.open = e9820_csis_open,
+	.release = vb2_fop_release,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = vb2_fop_mmap,
+	.poll = vb2_fop_poll,
+	.read = vb2_fop_read,
+};
+
+/* -------------------------------------------------------------------------
+ * Sensor binding
+ */
+
+static int e9820_csis_notify_bound(struct v4l2_async_notifier *notifier,
+				   struct v4l2_subdev *sd,
+				   struct v4l2_async_connection *asc)
+{
+	struct e9820_csis *csis =
+		container_of(notifier, struct e9820_csis, notifier);
+	struct e9820_csis_source *src =
+		container_of(asc, struct e9820_csis_source, asc);
+	u32 flags = MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE;
+	unsigned int i;
+	int ret;
+
+	/*
+	 * Behind a MIPI switch: the first sensor that shows up is selected,
+	 * user space changes that with MEDIA_IOC_SETUP_LINK.
+	 */
+	if (csis->num_sources > 1) {
+		flags = MEDIA_LNK_FL_ENABLED;
+		for (i = 0; i < csis->num_sources; i++)
+			if (csis->sources[i]->sd)
+				flags = 0;
+	}
+	src->sd = sd;
+	if (!csis->sensor)
+		csis->sensor = sd;
+	ret = v4l2_create_fwnode_links_to_pad(sd, &csis->pad, flags);
+	if (ret)
+		return ret;
+	/*
+	 * Do not wait for the other sensor of a shared receiver: each one
+	 * is usable on its own (the complete callback only runs when all of
+	 * them are there).
+	 */
+	return v4l2_device_register_subdev_nodes(&csis->v4l2_dev);
+}
+
+static void e9820_csis_notify_unbind(struct v4l2_async_notifier *notifier,
+				     struct v4l2_subdev *sd,
+				     struct v4l2_async_connection *asc)
+{
+	struct e9820_csis *csis =
+		container_of(notifier, struct e9820_csis, notifier);
+	struct e9820_csis_source *src =
+		container_of(asc, struct e9820_csis_source, asc);
+
+	src->sd = NULL;
+	if (csis->sensor == sd)
+		csis->sensor = NULL;
+	if (csis->source == src)
+		csis->source = NULL;
+}
+
+static int e9820_csis_notify_complete(struct v4l2_async_notifier *notifier)
+{
+	struct e9820_csis *csis =
+		container_of(notifier, struct e9820_csis, notifier);
+
+	return v4l2_device_register_subdev_nodes(&csis->v4l2_dev);
+}
+
+static const struct v4l2_async_notifier_operations e9820_csis_notify_ops = {
+	.bound = e9820_csis_notify_bound,
+	.unbind = e9820_csis_notify_unbind,
+	.complete = e9820_csis_notify_complete,
+};
+
+static int e9820_csis_parse_endpoint(struct e9820_csis *csis)
+{
+	struct fwnode_handle *ep;
+	int ret;
+
+	v4l2_async_nf_init(&csis->notifier, &csis->v4l2_dev);
+	csis->notifier.ops = &e9820_csis_notify_ops;
+
+	fwnode_graph_for_each_endpoint(dev_fwnode(csis->dev), ep) {
+		struct v4l2_fwnode_endpoint vep = {
+			.bus_type = V4L2_MBUS_CSI2_DPHY,
+		};
+		struct e9820_csis_source *src;
+
+		if (csis->num_sources == CSIS_MAX_SOURCES) {
+			ret = dev_err_probe(csis->dev, -EINVAL,
+					    "too many endpoints\n");
+			goto err_put;
+		}
+
+		ret = v4l2_fwnode_endpoint_parse(ep, &vep);
+		if (ret) {
+			dev_err_probe(csis->dev, ret, "bad endpoint\n");
+			goto err_put;
+		}
+		if (vep.bus.mipi_csi2.num_data_lanes < 1 ||
+		    vep.bus.mipi_csi2.num_data_lanes > 4) {
+			ret = dev_err_probe(csis->dev, -EINVAL,
+					    "bad lane count\n");
+			goto err_put;
+		}
+
+		src = v4l2_async_nf_add_fwnode_remote(&csis->notifier, ep,
+						      struct e9820_csis_source);
+		if (IS_ERR(src)) {
+			ret = PTR_ERR(src);
+			goto err_put;
+		}
+		src->bus = vep.bus.mipi_csi2;
+		src->mux = vep.base.id;
+		csis->sources[csis->num_sources++] = src;
+	}
+
+	if (!csis->num_sources)
+		return dev_err_probe(csis->dev, -ENODEV, "no endpoint\n");
+	if (csis->num_sources > 1 && !csis->mux_gpio)
+		return dev_err_probe(csis->dev, -EINVAL,
+				     "several endpoints but no mux GPIO\n");
+	csis->bus = csis->sources[0]->bus;
+	return 0;
+
+err_put:
+	fwnode_handle_put(ep);
+	return ret;
+}
+
+/* -------------------------------------------------------------------------
+ * Probe
+ */
+
+static int e9820_csis_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = {
+		"csis", "dma", "dma-common", "dma-top", "phy", "sysreg", "cmu",
+	};
+	struct device *dev = &pdev->dev;
+	void __iomem **maps[ARRAY_SIZE(names)];
+	struct e9820_csis *csis;
+	struct video_device *vdev;
+	struct vb2_queue *q;
+	unsigned int i;
+	int ret;
+
+	csis = devm_kzalloc(dev, sizeof(*csis), GFP_KERNEL);
+	if (!csis)
+		return -ENOMEM;
+
+	if (!e9820_cmu_top) {
+		struct device_node *np =
+			of_find_compatible_node(NULL, NULL, "samsung,exynos9820-cmu-top");
+
+		if (np) {
+			e9820_cmu_top = of_iomap(np, 0);
+			of_node_put(np);
+		}
+	}
+	/* not requested and not accessed */
+	csis->sysmmu = devm_ioremap(dev, SYSMMU_ISPPRE_BASE, SYSMMU_ISPPRE_SIZE);
+	csis->dev = dev;
+	platform_set_drvdata(pdev, csis);
+	mutex_init(&csis->lock);
+	spin_lock_init(&csis->slock);
+	INIT_LIST_HEAD(&csis->queued);
+
+	maps[0] = &csis->csis;
+	maps[1] = &csis->dma;
+	maps[2] = &csis->dma_cmn;
+	maps[3] = &csis->dma_top;
+	maps[4] = &csis->phy;
+	maps[5] = &csis->sysreg;
+	maps[6] = &csis->cmu;
+	/*
+	 * Several of these ranges are shared with the other receivers
+	 * (DMA top, SYSREG, CMU), so they are mapped without being claimed.
+	 * Nothing is read here: the ISPPRE blocks are powered off.
+	 */
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		struct resource *res;
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+						   names[i]);
+		if (!res)
+			return dev_err_probe(dev, -EINVAL, "no %s reg\n",
+					     names[i]);
+		/* the CMU range in the first DT was too short for the Q-channel registers */
+		*maps[i] = devm_ioremap(dev, res->start,
+					maps[i] == &csis->cmu ?
+					max_t(resource_size_t, CMU_MAP_SIZE,
+					      resource_size(res)) :
+					resource_size(res));
+		if (!*maps[i])
+			return -ENOMEM;
+	}
+
+	csis->pmu = exynos_get_pmu_regmap_by_phandle(dev->of_node,
+						     "samsung,pmu-syscon");
+	if (IS_ERR(csis->pmu))
+		return dev_err_probe(dev, PTR_ERR(csis->pmu), "no PMU regmap\n");
+	if (of_property_read_u32(dev->of_node, "samsung,phy-isolation-offset",
+				 &csis->phy_iso_offset) ||
+	    of_property_read_u32(dev->of_node, "samsung,phy-reset-bit",
+				 &csis->phy_reset_bit) ||
+	    of_property_read_u32(dev->of_node, "samsung,dma-index",
+				 &csis->dma_index) || csis->dma_index > 3)
+		return dev_err_probe(dev, -EINVAL, "PHY/DMA properties missing\n");
+
+	csis->phy_combo = of_property_read_bool(dev->of_node,
+						"samsung,phy-combo");
+	csis->phy_iso_shared = of_property_read_bool(dev->of_node,
+					"samsung,phy-isolation-shared");
+	csis->phy_split = of_property_read_bool(dev->of_node,
+						"samsung,phy-split");
+	if (csis->phy_split) {
+		struct resource *res;
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "phy");
+		if (resource_size(res) < 0x600)
+			return dev_err_probe(dev, -EINVAL,
+					     "split PHY needs 0x600 bytes of registers (clock lane at 0x500)\n");
+	}
+
+	/* MIPI switch in front of the receiver; left as it is until a stream */
+	csis->mux_gpio = devm_gpiod_get_optional(dev, "mux", GPIOD_ASIS);
+	if (IS_ERR(csis->mux_gpio))
+		return dev_err_probe(dev, PTR_ERR(csis->mux_gpio),
+				     "cannot get the mux GPIO\n");
+
+	csis->bus_clk = devm_clk_get(dev, "bus");
+	if (IS_ERR(csis->bus_clk))
+		return dev_err_probe(dev, PTR_ERR(csis->bus_clk), "no bus clock\n");
+
+	csis->irq_csis = platform_get_irq_byname(pdev, "csis");
+	if (csis->irq_csis < 0)
+		return csis->irq_csis;
+	csis->irq_dma = platform_get_irq_byname(pdev, "dma");
+	if (csis->irq_dma < 0)
+		return csis->irq_dma;
+
+	/* The DMA address registers are 32 bit and no IOMMU is used. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	/*
+	 * The handlers read registers of a block that is powered off outside
+	 * streaming, so the lines are only enabled while it is on.
+	 */
+	ret = devm_request_irq(dev, csis->irq_csis, e9820_csis_irq,
+			       IRQF_NO_AUTOEN, "exynos9820-csis", csis);
+	if (!ret)
+		ret = devm_request_irq(dev, csis->irq_dma, e9820_csis_dma_irq,
+				       IRQF_NO_AUTOEN, "exynos9820-csis-dma",
+				       csis);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot request interrupts\n");
+
+	pm_runtime_enable(dev);
+
+	csis->mdev.dev = dev;
+	strscpy(csis->mdev.model, "exynos9820-csis", sizeof(csis->mdev.model));
+	media_device_init(&csis->mdev);
+	csis->v4l2_dev.mdev = &csis->mdev;
+	ret = v4l2_device_register(dev, &csis->v4l2_dev);
+	if (ret)
+		goto err_mdev;
+
+	csis->fmt.pixelformat = e9820_csis_formats[0].fourcc;
+	csis->fmt.width = 2304;
+	csis->fmt.height = 1728;
+	e9820_csis_fill_fmt(&csis->fmt);
+
+	q = &csis->queue;
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF | VB2_READ;
+	q->drv_priv = csis;
+	q->buf_struct_size = sizeof(struct e9820_csis_buffer);
+	q->ops = &e9820_csis_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->min_queued_buffers = 1;
+	q->lock = &csis->lock;
+	q->dev = dev;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_v4l2;
+
+	vdev = &csis->vdev;
+	snprintf(vdev->name, sizeof(vdev->name), "csis %s", dev_name(dev));
+	vdev->fops = &e9820_csis_fops;
+	vdev->ioctl_ops = &e9820_csis_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->v4l2_dev = &csis->v4l2_dev;
+	vdev->queue = q;
+	vdev->lock = &csis->lock;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			    V4L2_CAP_READWRITE | V4L2_CAP_IO_MC;
+	video_set_drvdata(vdev, csis);
+
+	csis->pad.flags = MEDIA_PAD_FL_SINK;
+	ret = media_entity_pads_init(&vdev->entity, 1, &csis->pad);
+	if (ret)
+		goto err_v4l2;
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_v4l2;
+
+	ret = e9820_csis_parse_endpoint(csis);
+	if (ret)
+		goto err_nf;
+	ret = v4l2_async_nf_register(&csis->notifier);
+	if (ret)
+		goto err_nf;
+
+	ret = media_device_register(&csis->mdev);
+	if (ret)
+		goto err_nf_unreg;
+
+	return 0;
+
+err_nf_unreg:
+	v4l2_async_nf_unregister(&csis->notifier);
+err_nf:
+	v4l2_async_nf_cleanup(&csis->notifier);
+err_video:
+	video_unregister_device(vdev);
+err_v4l2:
+	v4l2_device_unregister(&csis->v4l2_dev);
+err_mdev:
+	media_device_cleanup(&csis->mdev);
+	pm_runtime_disable(dev);
+	return ret;
+}
+
+static void e9820_csis_remove(struct platform_device *pdev)
+{
+	struct e9820_csis *csis = platform_get_drvdata(pdev);
+
+	media_device_unregister(&csis->mdev);
+	v4l2_async_nf_unregister(&csis->notifier);
+	v4l2_async_nf_cleanup(&csis->notifier);
+	video_unregister_device(&csis->vdev);
+	v4l2_device_unregister(&csis->v4l2_dev);
+	media_device_cleanup(&csis->mdev);
+	pm_runtime_disable(&pdev->dev);
+}
+
+/*
+ * A stream keeps the ISPPRE domain, the PHY and the bus levels up; none of
+ * that survives system sleep, and the sensor would lose power under the
+ * receiver. Stop the stream first.
+ */
+static int e9820_csis_suspend(struct device *dev)
+{
+	struct e9820_csis *csis = dev_get_drvdata(dev);
+
+	if (READ_ONCE(e9820_csis_active) == csis) {
+		dev_warn(dev, "streaming: refusing system suspend\n");
+		return -EBUSY;
+	}
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(e9820_csis_pm_ops, e9820_csis_suspend, NULL);
+
+static const struct of_device_id e9820_csis_of_match[] = {
+	{ .compatible = "samsung,exynos9820-csis" },
+	{ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct platform_driver e9820_csis_driver = {
+	.driver = {
+		.name = "exynos9820-csis",
+		.pm = pm_sleep_ptr(&e9820_csis_pm_ops),
+		.of_match_table = e9820_csis_of_match,
+	},
+	.probe = e9820_csis_probe,
+	.remove = e9820_csis_remove,
+};
+module_platform_driver(e9820_csis_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos 9820 MIPI CSIS RAW capture driver");
+MODULE_LICENSE("GPL");
