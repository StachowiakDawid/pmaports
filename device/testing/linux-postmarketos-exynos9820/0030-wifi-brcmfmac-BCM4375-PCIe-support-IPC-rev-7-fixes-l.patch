diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/flowring.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/flowring.c
index 35cbcea0ab..9b93cb0dca 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/flowring.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/flowring.c
@@ -149,15 +149,17 @@ u32 brcmf_flowring_create(struct brcmf_flowring *flow, u8 da[ETH_ALEN],
 		if (!ring)
 			return -ENOMEM;
 
-		memcpy(hash[hash_idx].mac, mac, ETH_ALEN);
-		hash[hash_idx].fifo = fifo;
-		hash[hash_idx].ifidx = ifidx;
-		hash[hash_idx].flowid = i;
-
 		ring->hash_id = hash_idx;
 		ring->status = RING_CLOSED;
 		skb_queue_head_init(&ring->skblist);
 		flow->rings[i] = ring;
+		/* the ring must exist before a lookup on another CPU can find it */
+		smp_wmb();
+
+		memcpy(hash[hash_idx].mac, mac, ETH_ALEN);
+		hash[hash_idx].fifo = fifo;
+		hash[hash_idx].flowid = i;
+		WRITE_ONCE(hash[hash_idx].ifidx, ifidx);
 
 		return i;
 	}
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
index ff47d48277..d29c52e537 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
@@ -23,6 +23,7 @@
 #include "flowring.h"
 #include "bus.h"
 #include "tracepoint.h"
+#include "pcie.h"
 
 
 #define MSGBUF_IOCTL_RESP_TIMEOUT		msecs_to_jiffies(2000)
@@ -47,6 +48,8 @@
 #define MSGBUF_TYPE_RX_CMPLT			0x12
 #define MSGBUF_TYPE_LPBK_DMAXFER		0x13
 #define MSGBUF_TYPE_LPBK_DMAXFER_CMPLT		0x14
+#define MSGBUF_TYPE_H2D_MAILBOX_DATA		0x23
+#define MSGBUF_TYPE_D2H_MAILBOX_DATA		0x24
 
 #define NR_TX_PKTIDS				2048
 #define NR_RX_PKTIDS				1024
@@ -126,6 +129,20 @@ struct msgbuf_completion_hdr {
 	__le16				flow_ring_id;
 };
 
+/* bcmdhd h2d_mailbox_data_t / d2h_mailbox_data_t (IPC rev >= 6) */
+struct msgbuf_h2d_mbdata {
+	struct msgbuf_common_hdr	msg;
+	__le32				mbdata;
+	__le32				rsvd0[7];
+};
+
+struct msgbuf_d2h_mbdata {
+	struct msgbuf_common_hdr	msg;
+	struct msgbuf_completion_hdr	compl_hdr;
+	__le32				mbdata;
+	__le32				rsvd0;
+};
+
 /* Data struct for the MSGBUF_TYPE_GEN_STATUS */
 struct msgbuf_gen_status {
 	struct msgbuf_common_hdr	msg;
@@ -840,6 +857,9 @@ static int brcmf_msgbuf_tx_queue_data(struct brcmf_pub *drvr, int ifidx,
 			return 0;
 		}
 	}
+	/* a ring that is being created or deleted concurrently: drop */
+	if (!READ_ONCE(flow->rings[flowid]))
+		return -ENODEV;
 	queue_count = brcmf_flowring_enqueue(flow, flowid, skb);
 	force = ((queue_count % BRCMF_MSGBUF_TRICKLE_TXWORKER_THRS) == 0);
 	brcmf_msgbuf_schedule_txdata(msgbuf, flowid, force);
@@ -1362,6 +1382,12 @@ static void brcmf_msgbuf_process_msgtype(struct brcmf_msgbuf *msgbuf, void *buf)
 		brcmf_dbg(MSGBUF, "MSGBUF_TYPE_RX_CMPLT\n");
 		brcmf_msgbuf_process_rx_complete(msgbuf, buf);
 		break;
+	case MSGBUF_TYPE_D2H_MAILBOX_DATA:
+		brcmf_dbg(MSGBUF, "MSGBUF_TYPE_D2H_MAILBOX_DATA 0x%08x\n",
+			  le32_to_cpu(((struct msgbuf_d2h_mbdata *)buf)->mbdata));
+		brcmf_pcie_handle_mb_data_msg(drvr->bus_if->dev,
+					      le32_to_cpu(((struct msgbuf_d2h_mbdata *)buf)->mbdata));
+		break;
 	default:
 		bphy_err(drvr, "Unsupported msgtype %d\n", msg->msgtype);
 		break;
@@ -1401,6 +1427,44 @@ static void brcmf_msgbuf_process_rx(struct brcmf_msgbuf *msgbuf,
 }
 
 
+/*
+ * Send mailbox data (D3 inform, deep sleep ack, ...) as an H2D_MAILBOX_DATA
+ * message on the control submit ring, like bcmdhd does for IPC rev >= 6
+ * firmware (dhd_prot_h2d_mbdata_send_ctrlmsg()). Doesn't sleep.
+ */
+int brcmf_msgbuf_h2d_mbdata(struct brcmf_pub *drvr, u32 mbdata)
+{
+	struct brcmf_msgbuf *msgbuf;
+	struct brcmf_commonring *commonring;
+	struct msgbuf_h2d_mbdata *req;
+	void *ret_ptr;
+	int err;
+
+	if (!drvr || !drvr->proto || !drvr->proto->pd)
+		return -ENODEV;
+	msgbuf = (struct brcmf_msgbuf *)drvr->proto->pd;
+	commonring = msgbuf->commonrings[BRCMF_H2D_MSGRING_CONTROL_SUBMIT];
+	if (!commonring)
+		return -ENODEV;
+
+	brcmf_commonring_lock(commonring);
+	ret_ptr = brcmf_commonring_reserve_for_write(commonring);
+	if (!ret_ptr) {
+		brcmf_commonring_unlock(commonring);
+		bphy_err(drvr, "no space in ctrl ring for mailbox data\n");
+		return -ENOMEM;
+	}
+	req = (struct msgbuf_h2d_mbdata *)ret_ptr;
+	memset(req, 0, sizeof(*req));
+	req->msg.msgtype = MSGBUF_TYPE_H2D_MAILBOX_DATA;
+	req->mbdata = cpu_to_le32(mbdata);
+	err = brcmf_commonring_write_complete(commonring);
+	brcmf_commonring_unlock(commonring);
+
+	return err;
+}
+
+
 int brcmf_proto_msgbuf_rx_trigger(struct device *dev)
 {
 	struct brcmf_bus *bus_if = dev_get_drvdata(dev);
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.h
index 6a849f4a94..707d309f09 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.h
@@ -32,12 +32,17 @@ int brcmf_proto_msgbuf_rx_trigger(struct device *dev);
 void brcmf_msgbuf_delete_flowring(struct brcmf_pub *drvr, u16 flowid);
 int brcmf_proto_msgbuf_attach(struct brcmf_pub *drvr);
 void brcmf_proto_msgbuf_detach(struct brcmf_pub *drvr);
+int brcmf_msgbuf_h2d_mbdata(struct brcmf_pub *drvr, u32 mbdata);
 #else
 static inline int brcmf_proto_msgbuf_attach(struct brcmf_pub *drvr)
 {
 	return 0;
 }
 static inline void brcmf_proto_msgbuf_detach(struct brcmf_pub *drvr) {}
+static inline int brcmf_msgbuf_h2d_mbdata(struct brcmf_pub *drvr, u32 mbdata)
+{
+	return -EOPNOTSUPP;
+}
 #endif
 
 #endif /* BRCMFMAC_MSGBUF_H */
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index e0ff122e17..d7e32960fe 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -7,6 +7,7 @@
 #include <linux/module.h>
 #include <linux/firmware.h>
 #include <linux/pci.h>
+#include <linux/pm_wakeup.h>
 #include <linux/vmalloc.h>
 #include <linux/delay.h>
 #include <linux/interrupt.h>
@@ -67,6 +68,7 @@ BRCMF_FW_DEF(4366B, "brcmfmac4366b-pcie");
 BRCMF_FW_DEF(4366C, "brcmfmac4366c-pcie");
 BRCMF_FW_DEF(4371, "brcmfmac4371-pcie");
 BRCMF_FW_CLM_DEF(43752, "brcmfmac43752-pcie");
+BRCMF_FW_CLM_DEF(4375, "brcmfmac4375-pcie");
 BRCMF_FW_CLM_DEF(4377B3, "brcmfmac4377b3-pcie");
 BRCMF_FW_CLM_DEF(4378B1, "brcmfmac4378b1-pcie");
 BRCMF_FW_CLM_DEF(4378B3, "brcmfmac4378b3-pcie");
@@ -108,6 +110,7 @@ static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 	BRCMF_FW_ENTRY(BRCM_CC_43666_CHIP_ID, 0xFFFFFFF0, 4366C),
 	BRCMF_FW_ENTRY(BRCM_CC_4371_CHIP_ID, 0xFFFFFFFF, 4371),
 	BRCMF_FW_ENTRY(BRCM_CC_43752_CHIP_ID, 0xFFFFFFFF, 43752),
+	BRCMF_FW_ENTRY(BRCM_CC_4375_CHIP_ID, 0xFFFFFFFF, 4375), /* Samsung B0/B1 */
 	BRCMF_FW_ENTRY(BRCM_CC_4377_CHIP_ID, 0xFFFFFFFF, 4377B3), /* revision ID 4 */
 	BRCMF_FW_ENTRY(BRCM_CC_4378_CHIP_ID, 0x0000000F, 4378B1), /* revision ID 3 */
 	BRCMF_FW_ENTRY(BRCM_CC_4378_CHIP_ID, 0xFFFFFFE0, 4378B3), /* revision ID 5 */
@@ -115,6 +118,13 @@ static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 };
 
 #define BRCMF_PCIE_FW_UP_TIMEOUT		5000 /* msec */
+/*
+ * Extra cold-start firmware-boot attempts. After a long suspend-to-RAM the
+ * Wi-Fi chip comes up powered-off-cold (WLAN_REG_ON was cut) and the ARM
+ * firmware sometimes misses its first boot window; reset and retry a few
+ * times instead of leaving Wi-Fi dead until a reboot.
+ */
+#define BRCMF_PCIE_FW_UP_RETRIES		3
 
 #define BRCMF_PCIE_REG_MAP_SIZE			(32 * 1024)
 
@@ -220,6 +230,7 @@ static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 #define BRCMF_PCIE_SHARED_DMA_INDEX		0x10000
 #define BRCMF_PCIE_SHARED_DMA_2B_IDX		0x100000
 #define BRCMF_PCIE_SHARED_HOSTRDY_DB1		0x10000000
+#define BRCMF_PCIE_SHARED_USE_MAILBOX		0x2000000
 
 #define BRCMF_PCIE_FLAGS_HTOD_SPLIT		0x4000
 #define BRCMF_PCIE_FLAGS_DTOH_SPLIT		0x8000
@@ -235,6 +246,84 @@ static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 #define BRCMF_SHARED_DMA_SCRATCH_ADDR_OFFSET	56
 #define BRCMF_SHARED_DMA_RINGUPD_LEN_OFFSET	64
 #define BRCMF_SHARED_DMA_RINGUPD_ADDR_OFFSET	68
+/*
+ * pciedev_shared_t rev >= 6 layout (bcmdhd include/bcmpcie.h): offsets 64..75
+ * are host_scb_addr (64 bit) + host_scb_size, no longer the rev <= 5
+ * "ring update" (device_rings_stsblk) buffer, so don't write ringupd there.
+ */
+#define BRCMF_SHARED_FLAGS2_OFFSET		80
+#define BRCMF_SHARED_HOST_CAP_OFFSET		84
+#define BRCMF_SHARED_HOST_TRAP_ADDR_OFFSET	88
+
+/* pciedev_shared_t.host_cap bits (bcmdhd HOSTCAP_*) */
+#define BRCMF_HOSTCAP_PCIEAPI_VERSION_MASK	0x000000ff
+#define BRCMF_HOSTCAP_H2D_ENABLE_HOSTRDY	0x00000400
+#define BRCMF_HOSTCAP_DS_NO_OOB_DW		0x00001000
+#define BRCMF_HOSTCAP_EXTENDED_TRAP_DATA	0x00020000
+#define BRCMF_HOSTCAP_UR_FW_NO_TRAP		0x00800000
+
+#define BRCMF_EXT_TRAP_DATA_LEN			4096
+
+/*
+ * pciedev_shared_t.host_cap (rev >= 6), written the way bcmdhd's
+ * dhd_set_host_cap() does before the rings are set up.
+ *  0  (default) don't write it, like mainline always did
+ * -1  "auto": what bcmdhd writes on this platform minus the features
+ *     brcmfmac doesn't implement: IPC version min(fw, 7) | H2D_ENABLE_HOSTRDY
+ *     (if fw has HOSTRDY) | DS_NO_OOB_DW | EXTENDED_TRAP_DATA (+ a host trap
+ *     buffer) | UR_FW_NO_TRAP
+ * other: raw value; a 0 low byte is replaced by the fw's IPC version.
+ */
+static int brcmf_pcie_hostcap;
+module_param_named(pcie_hostcap, brcmf_pcie_hostcap, int, 0400);
+MODULE_PARM_DESC(pcie_hostcap, "PCIe shared host_cap: 0 = don't write, -1 = auto (like bcmdhd), else raw value");
+
+/*
+ * Common ring depths. bcmdhd (no DHD_HTPUT_TUNABLES, as built for BCM4375)
+ * uses rxpost 512 / txcpl 1024 / rxcpl 512, brcmfmac 1024/1024/1024. The
+ * BCM4375 firmware advertises max_host_rxbufs 511, i.e. a 512-entry rxpost
+ * ring, so the BCM4375 gets the bcmdhd depths.
+ *
+ * Mailbox data (D3 inform/ack, deep sleep ack, ...) transport. IPC rev >= 6
+ * firmware that doesn't set PCIE_SHARED_USE_MAILBOX takes it as an
+ * H2D_MAILBOX_DATA message on the control submit ring and answers with a
+ * D2H_MAILBOX_DATA message on the control complete ring (bcmdhd
+ * dhdpcie_send_mb_data()); the TCM h2d_mb_data word + SB mailbox interrupt
+ * is only for older firmware.
+ */
+
+/*
+ * System sleep with the dongle kept powered (pcie_exynos9820.sleep_off=3):
+ * the host asserts PERST# and turns the link off after the D3_INFORM ack,
+ * but WLAN_REG_ON stays on and the firmware keeps running in D3 (bcmdhd:
+ * dhdpcie_bus_suspend() + exynos_pcie_pm_suspend()). PERST# resets the
+ * PCIe core, so the mailbox mask reads 0 and the old "intmask != 0" test
+ * takes the dongle for dead. With pcie_warm_resume=1 the resume checks the
+ * firmware itself instead (the shared-RAM pointer it posted at boot is
+ * still in the last word of its RAM), re-programs the PCIe core side and
+ * goes on with D0 / host-ready like bcmdhd's dhdpcie_bus_suspend(FALSE).
+ * Anything else falls back to the full re-probe (firmware reload).
+ */
+static bool brcmf_pcie_warm_resume;
+module_param_named(pcie_warm_resume, brcmf_pcie_warm_resume, bool, 0644);
+MODULE_PARM_DESC(pcie_warm_resume, "After a sleep that kept the dongle powered, resume the running firmware instead of re-probing (default N)");
+
+/*
+ * Wakeup source time around a resume re-probe: held while the firmware
+ * loads (bounded), and for a grace period after brcmf_attach() so that
+ * NetworkManager can reconnect before the next suspend.
+ */
+#define BRCMF_PCIE_REPROBE_HOLD_MS	30000
+#define BRCMF_PCIE_SETUP_GRACE_MS	10000
+
+/*
+ * pcie_warm_resume: how long to wait, after the host-ready doorbell, for the
+ * firmware's shared structure to read back as it was at boot. The dongle
+ * may still be in D3 / save-restore when the link comes back and parts of
+ * its RAM then read as power-up noise (observed: the last RAM word gave
+ * 0x9e5773d9-like values instead of the shared-RAM pointer).
+ */
+#define BRCMF_PCIE_WARM_WAIT_MS		200
 
 #define BRCMF_RING_H2D_RING_COUNT_OFFSET	0
 #define BRCMF_RING_D2H_RING_COUNT_OFFSET	1
@@ -314,6 +403,11 @@ struct brcmf_pcie_shared_info {
 	dma_addr_t scratch_dmahandle;
 	void *ringupd;
 	dma_addr_t ringupd_dmahandle;
+	void *trapbuf;
+	dma_addr_t trapbuf_dmahandle;
+	u32 flags2;
+	u32 host_cap;
+	bool mbdata_msg;
 	u8 version;
 };
 
@@ -358,6 +452,8 @@ struct brcmf_pciedev_info {
 	struct brcmf_mp_device *settings;
 	struct brcmf_otp_params otp;
 	bool fwseed;
+	bool d3_noack;
+	const u32 *ring_max_item;
 #ifdef DEBUG
 	u32 console_interval;
 	bool console_active;
@@ -413,6 +509,15 @@ static const u32 brcmf_ring_max_item[BRCMF_NROF_COMMON_MSGRINGS] = {
 	BRCMF_D2H_MSGRING_RX_COMPLETE_MAX_ITEM
 };
 
+/* bcmdhd bcmmsgbuf.h depths without DHD_HTPUT_TUNABLES */
+static const u32 brcmf_ring_max_item_dhd[BRCMF_NROF_COMMON_MSGRINGS] = {
+	64,	/* H2DRING_CTRL_SUB_MAX_ITEM */
+	512,	/* H2DRING_RXPOST_MAX_ITEM */
+	64,	/* D2HRING_CTRL_CMPLT_MAX_ITEM */
+	1024,	/* D2HRING_TXCMPLT_MAX_ITEM */
+	512	/* D2HRING_RXCMPLT_MAX_ITEM */
+};
+
 static const u32 brcmf_ring_itemsize_pre_v7[BRCMF_NROF_COMMON_MSGRINGS] = {
 	BRCMF_H2D_MSGRING_CONTROL_SUBMIT_ITEMSIZE,
 	BRCMF_H2D_MSGRING_RXPOST_SUBMIT_ITEMSIZE,
@@ -466,6 +571,8 @@ brcmf_pcie_prepare_fw_request(struct brcmf_pciedev_info *devinfo);
 static void
 brcmf_pcie_fwcon_timer(struct brcmf_pciedev_info *devinfo, bool active);
 static void brcmf_pcie_debugfs_create(struct device *dev);
+static void brcmf_pcie_bus_console_read(struct brcmf_pciedev_info *devinfo,
+					bool error);
 
 static u16
 brcmf_pcie_read_reg16(struct brcmf_pciedev_info *devinfo, u32 reg_offset)
@@ -769,6 +876,14 @@ brcmf_pcie_send_mb_data(struct brcmf_pciedev_info *devinfo, u32 htod_mb_data)
 	u32 i;
 
 	shared = &devinfo->shared;
+	if (shared->mbdata_msg) {
+		struct brcmf_bus *bus = dev_get_drvdata(&devinfo->pdev->dev);
+
+		brcmf_dbg(PCIE, "H2D_MB_DATA 0x%08x via ctrl ring\n",
+			  htod_mb_data);
+		return brcmf_msgbuf_h2d_mbdata(bus->drvr, htod_mb_data);
+	}
+
 	addr = shared->htod_mb_data_addr;
 	cur_htod_mb_data = brcmf_pcie_read_tcm32(devinfo, addr);
 
@@ -797,21 +912,9 @@ brcmf_pcie_send_mb_data(struct brcmf_pciedev_info *devinfo, u32 htod_mb_data)
 }
 
 
-static void brcmf_pcie_handle_mb_data(struct brcmf_pciedev_info *devinfo)
+static void brcmf_pcie_process_mb_data(struct brcmf_pciedev_info *devinfo,
+				       u32 dtoh_mb_data)
 {
-	struct brcmf_pcie_shared_info *shared;
-	u32 addr;
-	u32 dtoh_mb_data;
-
-	shared = &devinfo->shared;
-	addr = shared->dtoh_mb_data_addr;
-	dtoh_mb_data = brcmf_pcie_read_tcm32(devinfo, addr);
-
-	if (!dtoh_mb_data)
-		return;
-
-	brcmf_pcie_write_tcm32(devinfo, addr, 0);
