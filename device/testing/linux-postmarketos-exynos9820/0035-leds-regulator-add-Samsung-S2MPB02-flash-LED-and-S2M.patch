diff --git a/drivers/regulator/s2mpb02-regulator.c b/drivers/regulator/s2mpb02-regulator.c
new file mode 100644
index 0000000000..b6649fa7ff
--- /dev/null
+++ b/drivers/regulator/s2mpb02-regulator.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Regulators of the Samsung S2MPB02 camera PMIC (2 bucks, 1 buck-boost,
+ * 18 LDOs).
+ *
+ * The I2C client of the chip is owned by the flash LED driver
+ * (leds-s2mpb02). This driver binds to a separate platform node that points
+ * at the chip with "samsung,pmic" and shares the regmap of the LED driver.
+ *
+ * Register layout from the Samsung SM-G975F kernel
+ * (drivers/regulator/s2mpb02-regulator.c, include/linux/mfd/samsung/
+ * s2mpb02-regulator.h):
+ *   BxCTRL1 [7:6] enable, BxCTRL2 [7:0] voltage
+ *   LxCTRL  [7] enable, [6:0] voltage
+ *
+ * The bucks come out of reset with the enable field at 01; the vendor
+ * kernel writes 11 to enable and 00 to disable. To stay as close as
+ * possible to the state the boot loader leaves (which the flash LED is
+ * known to work with), "disable" puts the reset value 01 back and only 11
+ * counts as enabled.
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define S2MPB02_REG_B1CTRL1	0x0b
+#define S2MPB02_REG_B1CTRL2	0x0c
+#define S2MPB02_REG_B2CTRL1	0x0d
+#define S2MPB02_REG_B2CTRL2	0x0e
+#define S2MPB02_REG_BB1CTRL1	0x0f
+#define S2MPB02_REG_BB1CTRL2	0x10
+#define S2MPB02_REG_L1CTRL	0x1e
+
+#define S2MPB02_BUCK_EN_MASK	GENMASK(7, 6)
+#define S2MPB02_BUCK_EN_ON	(3 << 6)
+#define S2MPB02_BUCK_EN_DEFAULT	(1 << 6)
+#define S2MPB02_LDO_EN		BIT(7)
+#define S2MPB02_LDO_VSEL_MASK	GENMASK(6, 0)
+
+static int s2mpb02_buck_enable(struct regulator_dev *rdev)
+{
+	return regmap_update_bits(rdev->regmap, rdev->desc->enable_reg,
+				  S2MPB02_BUCK_EN_MASK, S2MPB02_BUCK_EN_ON);
+}
+
+static int s2mpb02_buck_disable(struct regulator_dev *rdev)
+{
+	return regmap_update_bits(rdev->regmap, rdev->desc->enable_reg,
+				  S2MPB02_BUCK_EN_MASK,
+				  S2MPB02_BUCK_EN_DEFAULT);
+}
+
+static int s2mpb02_buck_is_enabled(struct regulator_dev *rdev)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, rdev->desc->enable_reg, &val);
+	if (ret)
+		return ret;
+
+	return (val & S2MPB02_BUCK_EN_MASK) == S2MPB02_BUCK_EN_ON;
+}
+
+static const struct regulator_ops s2mpb02_buck_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.is_enabled		= s2mpb02_buck_is_enabled,
+	.enable			= s2mpb02_buck_enable,
+	.disable		= s2mpb02_buck_disable,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+};
+
+static const struct regulator_ops s2mpb02_ldo_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+};
+
+#define S2MPB02_BUCK(_name, _id, _ctrl1, _min, _step, _time) {		\
+	.name		= _name,					\
+	.of_match	= _name,					\
+	.regulators_node = "regulators",				\
+	.id		= _id,						\
+	.ops		= &s2mpb02_buck_ops,				\
+	.type		= REGULATOR_VOLTAGE,				\
+	.owner		= THIS_MODULE,					\
+	.min_uV		= _min,						\
+	.uV_step	= _step,					\
+	.n_voltages	= 256,						\
+	.ramp_delay	= 12000,					\
+	.vsel_reg	= (_ctrl1) + 1,					\
+	.vsel_mask	= 0xff,						\
+	.enable_reg	= _ctrl1,					\
+	.enable_time	= _time,					\
+}
+
+#define S2MPB02_LDO(_n, _step) {					\
+	.name		= "ldo" #_n,					\
+	.of_match	= "ldo" #_n,					\
+	.regulators_node = "regulators",				\
+	.id		= _n,						\
+	.ops		= &s2mpb02_ldo_ops,				\
+	.type		= REGULATOR_VOLTAGE,				\
+	.owner		= THIS_MODULE,					\
+	.min_uV		= 600000,					\
+	.uV_step	= _step,					\
+	.n_voltages	= 128,						\
+	.ramp_delay	= 12000,					\
+	.vsel_reg	= S2MPB02_REG_L1CTRL + (_n) - 1,		\
+	.vsel_mask	= S2MPB02_LDO_VSEL_MASK,			\
+	.enable_reg	= S2MPB02_REG_L1CTRL + (_n) - 1,		\
+	.enable_mask	= S2MPB02_LDO_EN,				\
+	.enable_time	= 180,						\
+}
+
+static const struct regulator_desc s2mpb02_regulators[] = {
+	S2MPB02_LDO(1, 12500), S2MPB02_LDO(2, 12500), S2MPB02_LDO(3, 12500),
+	S2MPB02_LDO(4, 12500), S2MPB02_LDO(5, 12500), S2MPB02_LDO(6, 25000),
+	S2MPB02_LDO(7, 25000), S2MPB02_LDO(8, 25000), S2MPB02_LDO(9, 25000),
+	S2MPB02_LDO(10, 25000), S2MPB02_LDO(11, 25000), S2MPB02_LDO(12, 25000),
+	S2MPB02_LDO(13, 25000), S2MPB02_LDO(14, 25000), S2MPB02_LDO(15, 25000),
+	S2MPB02_LDO(16, 25000), S2MPB02_LDO(17, 25000), S2MPB02_LDO(18, 25000),
+	S2MPB02_BUCK("buck1", 19, S2MPB02_REG_B1CTRL1, 400000, 6250, 100),
+	S2MPB02_BUCK("buck2", 20, S2MPB02_REG_B2CTRL1, 400000, 6250, 100),
+	S2MPB02_BUCK("bb", 21, S2MPB02_REG_BB1CTRL1, 2600000, 12500, 210),
+};
+
+static int s2mpb02_regulator_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config config = { .dev = dev };
+	struct device_node *regs_np, *np, *pmic_np;
+	struct i2c_client *client;
+	struct regmap *regmap;
+	unsigned int i;
+
+	pmic_np = of_parse_phandle(dev->of_node, "samsung,pmic", 0);
+	if (!pmic_np)
+		return dev_err_probe(dev, -EINVAL, "no samsung,pmic\n");
+	client = of_find_i2c_device_by_node(pmic_np);
+	of_node_put(pmic_np);
+	if (!client)
+		return -EPROBE_DEFER;
+
+	/* The regmap exists once the LED driver has bound to the chip. */
+	regmap = dev_get_regmap(&client->dev, NULL);
+	if (!regmap) {
+		put_device(&client->dev);
+		return -EPROBE_DEFER;
+	}
+	/* Go away before the LED driver (and its regmap) does. */
+	if (!device_link_add(dev, &client->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		put_device(&client->dev);
+		return dev_err_probe(dev, -EINVAL, "no link to the PMIC\n");
+	}
+	put_device(&client->dev);
+	config.regmap = regmap;
+
+	regs_np = of_get_child_by_name(dev->of_node, "regulators");
+	if (!regs_np)
+		return dev_err_probe(dev, -EINVAL, "no regulators node\n");
+
+	/*
+	 * Only the regulators described in the DT are registered; everything
+	 * else (e.g. LDO17, the grip sensor supply) is not touched.
+	 */
+	for (i = 0; i < ARRAY_SIZE(s2mpb02_regulators); i++) {
+		const struct regulator_desc *desc = &s2mpb02_regulators[i];
+		struct regulator_dev *rdev;
+
+		np = of_get_child_by_name(regs_np, desc->of_match);
+		if (!np)
+			continue;
+		of_node_put(np);
+
+		rdev = devm_regulator_register(dev, desc, &config);
+		if (IS_ERR(rdev)) {
+			of_node_put(regs_np);
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     desc->name);
+		}
+	}
+	of_node_put(regs_np);
+
+	return 0;
+}
+
+static const struct of_device_id s2mpb02_regulator_of_match[] = {
+	{ .compatible = "samsung,s2mpb02-regulators" },
+	{ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct platform_driver s2mpb02_regulator_driver = {
+	.driver = {
+		.name = "s2mpb02-regulator",
+		.of_match_table = s2mpb02_regulator_of_match,
+	},
+	.probe = s2mpb02_regulator_probe,
+};
+module_platform_driver(s2mpb02_regulator_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPB02 camera PMIC regulator driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/regulator/s2mpb03-regulator.c b/drivers/regulator/s2mpb03-regulator.c
new file mode 100644
index 0000000000..a95122eb28
--- /dev/null
+++ b/drivers/regulator/s2mpb03-regulator.c
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S2MPB03 camera PMIC: seven LDOs behind I2C. On the Galaxy S10
+ * family it feeds the rear wide camera (S5K2L4), the camera I/O rail that
+ * the rear lens actuator bus hangs on, and the OIS motor driver.
+ *
+ * Register layout from the Samsung SM-G975F kernel
+ * (drivers/regulator/s2mpb03.c, include/linux/regulator/s2mpb03.h):
+ *   0x00 ID, 0x01 status, 0x02 control,
+ *   0x03 + n: LDO(n + 1) control, [7] enable, [5:0] voltage
+ *
+ * Only the LDOs described in the DT are registered; nothing is written at
+ * probe time.
+ *
+ * Inputs: LDOs 1, 2 and 4 (1.0 V core, 1.1 V DRAM I/O and 1.025 V retention
+ * rails of the rear wide sensor) are fed by the 1.3 V buck 1 of the S2MPB02
+ * camera PMIC, which the vendor kernel keeps always on. With that buck off
+ * they report enabled but deliver nothing: the sensor stays silent on I2C
+ * while its EEPROM and lens actuator answer. The analog LDOs 5 and 6 are
+ * given the S2MPB02 buck-boost (also always on downstream; not proven to be
+ * their input). LDO 3 (camera I/O) works with both off and has no input.
+ * The DT can name the inputs on the PMIC node ("vinl-supply", "vinh-supply");
+ * a DT without them gets the S2MPB02 regulators by their names.
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define S2MPB03_REG_ID		0x00
+#define S2MPB03_REG_LDO1_CTRL	0x03
+#define S2MPB03_REG_MAX		0x0b
+
+#define S2MPB03_LDO_EN		BIT(7)
+#define S2MPB03_LDO_VSEL_MASK	GENMASK(5, 0)
+
+static const struct regulator_ops s2mpb03_ldo_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+};
+
+#define S2MPB03_LDO(_n, _min, _step, _vin) {				\
+	.name		= "ldo" #_n,					\
+	.supply_name	= _vin,						\
+	.of_match	= "ldo" #_n,					\
+	.regulators_node = "regulators",				\
+	.id		= _n,						\
+	.ops		= &s2mpb03_ldo_ops,				\
+	.type		= REGULATOR_VOLTAGE,				\
+	.owner		= THIS_MODULE,					\
+	.min_uV		= _min,						\
+	.uV_step	= _step,					\
+	.n_voltages	= 64,						\
+	.ramp_delay	= 12000,					\
+	.vsel_reg	= S2MPB03_REG_LDO1_CTRL + (_n) - 1,		\
+	.vsel_mask	= S2MPB03_LDO_VSEL_MASK,			\
+	.enable_reg	= S2MPB03_REG_LDO1_CTRL + (_n) - 1,		\
+	.enable_mask	= S2MPB03_LDO_EN,				\
+	.enable_time	= 150,						\
+}
+
+static const struct regulator_desc s2mpb03_regulators[] = {
+	S2MPB03_LDO(1, 700000, 12500, "vinl"),
+	S2MPB03_LDO(2, 700000, 12500, "vinl"),
+	S2MPB03_LDO(3, 700000, 25000, NULL),
+	S2MPB03_LDO(4, 700000, 12500, "vinl"),
+	S2MPB03_LDO(5, 1800000, 25000, "vinh"),
+	S2MPB03_LDO(6, 1800000, 25000, "vinh"),
+	S2MPB03_LDO(7, 1800000, 25000, NULL),
+};
+
+/* fallback for a DT that does not name the inputs */
+static const struct {
+	const char *supply;
+	const char *regulator;
+} s2mpb03_inputs[] = {
+	{ "vinl", "S2MPB02_BUCK1" },
+	{ "vinh", "S2MPB02_BB" },
+};
+
+/*
+ * The supply name of an LDO: the DT one if the PMIC node has the property,
+ * else the regulator name of the S2MPB02 output (the regulator core finds a
+ * supply by regulator name when the DT has none). That regulator must exist
+ * before the LDO is registered, or the core settles for a dummy supply.
+ */
+static int s2mpb03_supply_name(struct device *dev, const char *vin,
+			       const char **name)
+{
+	struct regulator *reg;
+	char prop[16];
+	unsigned int i;
+
+	*name = vin;
+	if (!vin)
+		return 0;
+	snprintf(prop, sizeof(prop), "%s-supply", vin);
+	if (of_property_present(dev->of_node, prop))
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(s2mpb03_inputs); i++)
+		if (!strcmp(vin, s2mpb03_inputs[i].supply))
+			break;
+	if (i == ARRAY_SIZE(s2mpb03_inputs))
+		return 0;
+
+	reg = regulator_get_optional(dev, s2mpb03_inputs[i].regulator);
+	if (IS_ERR(reg))
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "input %s (%s) not registered yet\n", vin,
+				     s2mpb03_inputs[i].regulator);
+	regulator_put(reg);
+	*name = s2mpb03_inputs[i].regulator;
+
+	return 0;
+}
+
+static const struct regmap_config s2mpb03_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = S2MPB03_REG_MAX,
+};
+
+static int s2mpb03_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { .dev = dev };
+	struct device_node *regs_np, *np;
+	unsigned int i, id = 0, ctrl[7] = { 0 };
+	struct regmap *regmap;
+	int ret;
+
+	regmap = devm_regmap_init_i2c(client, &s2mpb03_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap), "no regmap\n");
+	config.regmap = regmap;
+
+	/* The chip is always powered: read-only presence check and state */
+	ret = regmap_read(regmap, S2MPB03_REG_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read the ID register\n");
+	for (i = 0; i < ARRAY_SIZE(ctrl); i++)
+		regmap_read(regmap, S2MPB03_REG_LDO1_CTRL + i, &ctrl[i]);
+	dev_info(dev, "S2MPB03 id 0x%02x, LDO1-7 control %02x %02x %02x %02x %02x %02x %02x\n",
+		 id, ctrl[0], ctrl[1], ctrl[2], ctrl[3], ctrl[4], ctrl[5],
+		 ctrl[6]);
+
+	regs_np = of_get_child_by_name(dev->of_node, "regulators");
+	if (!regs_np)
+		return dev_err_probe(dev, -EINVAL, "no regulators node\n");
+
+	for (i = 0; i < ARRAY_SIZE(s2mpb03_regulators); i++) {
+		const struct regulator_desc *tmpl = &s2mpb03_regulators[i];
+		struct regulator_desc *desc;
+		struct regulator_dev *rdev;
+
+		np = of_get_child_by_name(regs_np, tmpl->of_match);
+		if (!np)
+			continue;
+		of_node_put(np);
+
+		desc = devm_kmemdup(dev, tmpl, sizeof(*tmpl), GFP_KERNEL);
+		if (!desc) {
+			of_node_put(regs_np);
+			return -ENOMEM;
+		}
+		ret = s2mpb03_supply_name(dev, tmpl->supply_name,
+					  &desc->supply_name);
+		if (ret) {
+			of_node_put(regs_np);
+			return ret;
+		}
+
+		rdev = devm_regulator_register(dev, desc, &config);
+		if (IS_ERR(rdev)) {
+			of_node_put(regs_np);
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     desc->name);
+		}
+	}
+	of_node_put(regs_np);
+
+	return 0;
+}
+
+static const struct of_device_id s2mpb03_of_match[] = {
+	{ .compatible = "samsung,s2mpb03" },
+	{ }
+};
+/*
+ * No MODULE_DEVICE_TABLE during bring-up: the module is loaded by hand, so
+ * that a boot never depends on it.
+ */
+
+static struct i2c_driver s2mpb03_driver = {
+	.driver = {
+		.name = "s2mpb03-regulator",
+		.of_match_table = s2mpb03_of_match,
+	},
+	.probe = s2mpb03_probe,
+};
+module_i2c_driver(s2mpb03_driver);
+
+MODULE_SOFTDEP("pre: s2mpb02-regulator");
+MODULE_DESCRIPTION("Samsung S2MPB03 camera PMIC regulator driver");
+MODULE_LICENSE("GPL");
