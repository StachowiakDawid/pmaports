diff --git a/drivers/leds/flash/leds-s2mpb02.c b/drivers/leds/flash/leds-s2mpb02.c
new file mode 100644
index 0000000000..a229f61a37
--- /dev/null
+++ b/drivers/leds/flash/leds-s2mpb02.c
@@ -0,0 +1,421 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Flash/torch LED driver for the Samsung S2MPB02 camera PMIC.
+ *
+ * The S2MPB02 is a camera power IC (2 bucks, a buck-boost, 18 LDOs) with
+ * one flash LED channel. Only the flash LED block is handled here; the
+ * regulators are left in the state the bootloader programmed.
+ *
+ * The LED is controlled the way the vendor kernel does it: FLED_CTRL1 has
+ * the I2C enable bits cleared ("GPIO mode"), the current is programmed in
+ * FLED_CUR1, and the TORCH / FLASH input pins switch the output. When the
+ * GPIOs are not described the I2C enable/mode bits are used instead.
+ *
+ * Register layout from the Samsung SM-G975F kernel (drivers/leds/leds-s2mpb02.c):
+ *   FLED_CTRL1 0x12: [7] enable (I2C), [6] mode (0 flash, 1 torch), [3] LV_EN
+ *   FLED_CUR1  0x14: [7:4] flash current N*100+50 mA, [3:0] torch N*20 mA
+ *   FLED_TIME1 0x15: [7:4] flash timeout (N+1)*62.5 ms, [3:0] torch timeout
+ */
+
+#include <linux/bitfield.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/led-class-flash.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define S2MPB02_REG_ID			0x00
+#define S2MPB02_REG_INT1		0x01
+#define S2MPB02_REG_FLED_CTRL1		0x12
+#define S2MPB02_REG_FLED_CTRL2		0x13
+#define S2MPB02_REG_FLED_CUR1		0x14
+#define S2MPB02_REG_FLED_TIME1		0x15
+#define S2MPB02_REG_FLED_IRD2		0x1b
+#define S2MPB02_REG_BST_CTRL2		0x1d
+
+#define S2MPB02_FLED_CTRL1_EN		BIT(7)
+#define S2MPB02_FLED_CTRL1_TORCH	BIT(6)
+#define S2MPB02_FLED_CTRL1_LV_EN	BIT(3)
+#define S2MPB02_FLED_CTRL1_MODE_MASK	(S2MPB02_FLED_CTRL1_EN | S2MPB02_FLED_CTRL1_TORCH)
+#define S2MPB02_FLED_CTRL2_LOW_MASK	GENMASK(3, 0)
+#define S2MPB02_FLED_CTRL2_LOW_INIT	0x4	/* vendor init value */
+#define S2MPB02_FLED_FLASH_MASK		GENMASK(7, 4)
+#define S2MPB02_FLED_TORCH_MASK		GENMASK(3, 0)
+#define S2MPB02_FLED_IRD2_DISCHARGE	BIT(1)	/* active discharge, no faint glow */
+
+/* Torch: N * 20 mA, N = 1..15 */
+#define S2MPB02_TORCH_STEP_UA		20000
+#define S2MPB02_TORCH_MAX_LEVEL		15
+#define S2MPB02_TORCH_DEFAULT_UA	240000
+/* Flash: N * 100 mA + 50 mA, N = 1..15 */
+#define S2MPB02_FLASH_MIN_UA		150000
+#define S2MPB02_FLASH_STEP_UA		100000
+#define S2MPB02_FLASH_MAX_UA		1550000
+#define S2MPB02_FLASH_DEFAULT_UA	1250000
+/* Flash timeout: (N + 1) * 62.5 ms, N = 0..15 */
+#define S2MPB02_TIMEOUT_STEP_US		62500
+#define S2MPB02_TIMEOUT_MAX_US		1000000
+#define S2MPB02_TIMEOUT_DEFAULT_US	500000
+#define S2MPB02_TORCH_TIMEOUT_CODE	0xf	/* vendor value */
+
+enum s2mpb02_out { S2MPB02_OFF, S2MPB02_TORCH, S2MPB02_FLASH };
+
+struct s2mpb02_led {
+	struct led_classdev_flash fled;
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *torch_gpio;
+	struct gpio_desc *flash_gpio;
+	struct delayed_work flash_off_work;
+	struct mutex lock;		/* registers, GPIOs and the fields below */
+	bool i2c_mode;
+	bool strobing;
+	u8 torch_level;			/* 0 = off */
+	u8 flash_code;
+	u32 flash_timeout_us;
+};
+
+static struct s2mpb02_led *fled_to_s2mpb02(struct led_classdev_flash *fled)
+{
+	return container_of(fled, struct s2mpb02_led, fled);
+}
+
+static void s2mpb02_set_pins(struct s2mpb02_led *led, int torch, int flash)
+{
+	if (led->i2c_mode)
+		return;
+	gpiod_set_value_cansleep(led->torch_gpio, torch);
+	gpiod_set_value_cansleep(led->flash_gpio, flash);
+}
+
+/* Must be called with led->lock held. */
+static int s2mpb02_output(struct s2mpb02_led *led, enum s2mpb02_out out)
+{
+	unsigned int mode = 0;
+	int ret;
+
+	/* Always go through "off" so that both pins are never high. */
+	s2mpb02_set_pins(led, 0, 0);
+	ret = regmap_update_bits(led->regmap, S2MPB02_REG_FLED_CTRL1,
+				 S2MPB02_FLED_CTRL1_MODE_MASK, 0);
+	if (ret || out == S2MPB02_OFF)
+		return ret;
+
+	if (out == S2MPB02_TORCH) {
+		ret = regmap_update_bits(led->regmap, S2MPB02_REG_FLED_CUR1,
+					 S2MPB02_FLED_TORCH_MASK,
+					 FIELD_PREP(S2MPB02_FLED_TORCH_MASK, led->torch_level));
+		mode = S2MPB02_FLED_CTRL1_EN | S2MPB02_FLED_CTRL1_TORCH;
+	} else {
+		ret = regmap_update_bits(led->regmap, S2MPB02_REG_FLED_CUR1,
+					 S2MPB02_FLED_FLASH_MASK,
+					 FIELD_PREP(S2MPB02_FLED_FLASH_MASK, led->flash_code));
+		mode = S2MPB02_FLED_CTRL1_EN;
+	}
+	if (ret)
+		return ret;
+
+	if (led->i2c_mode)
+		return regmap_update_bits(led->regmap, S2MPB02_REG_FLED_CTRL1,
+					  S2MPB02_FLED_CTRL1_MODE_MASK, mode);
+
+	if (out == S2MPB02_TORCH)
+		s2mpb02_set_pins(led, 1, 0);
+	else
+		s2mpb02_set_pins(led, 0, 1);
+	return 0;
+}
+
+static int s2mpb02_torch_set(struct led_classdev *cdev,
+			     enum led_brightness brightness)
+{
+	struct s2mpb02_led *led = fled_to_s2mpb02(lcdev_to_flcdev(cdev));
+	int ret = 0;
+
+	mutex_lock(&led->lock);
+	led->torch_level = brightness;
+	/* While a flash strobe runs, the torch state is restored after it. */
+	if (!led->strobing)
+		ret = s2mpb02_output(led, brightness ? S2MPB02_TORCH : S2MPB02_OFF);
+	mutex_unlock(&led->lock);
+
+	return ret;
+}
+
+static void s2mpb02_flash_off_work(struct work_struct *work)
+{
+	struct s2mpb02_led *led = container_of(to_delayed_work(work),
+					       struct s2mpb02_led, flash_off_work);
+
+	mutex_lock(&led->lock);
+	if (led->strobing) {
+		led->strobing = false;
+		s2mpb02_output(led, led->torch_level ? S2MPB02_TORCH : S2MPB02_OFF);
+	}
+	mutex_unlock(&led->lock);
+}
+
+static int s2mpb02_flash_brightness_set(struct led_classdev_flash *fled,
+					u32 brightness)
+{
+	struct s2mpb02_led *led = fled_to_s2mpb02(fled);
+
+	mutex_lock(&led->lock);
+	led->flash_code = (brightness - 50000) / S2MPB02_FLASH_STEP_UA;
+	mutex_unlock(&led->lock);
+
+	return 0;
+}
+
+static int s2mpb02_timeout_set(struct led_classdev_flash *fled, u32 timeout)
+{
+	struct s2mpb02_led *led = fled_to_s2mpb02(fled);
+	int ret;
+
+	mutex_lock(&led->lock);
+	led->flash_timeout_us = timeout;
+	ret = regmap_update_bits(led->regmap, S2MPB02_REG_FLED_TIME1,
+				 S2MPB02_FLED_FLASH_MASK,
+				 FIELD_PREP(S2MPB02_FLED_FLASH_MASK,
+					    timeout / S2MPB02_TIMEOUT_STEP_US - 1));
+	mutex_unlock(&led->lock);
+
+	return ret;
+}
+
+static int s2mpb02_strobe_set(struct led_classdev_flash *fled, bool state)
+{
+	struct s2mpb02_led *led = fled_to_s2mpb02(fled);
+	int ret;
+
+	mutex_lock(&led->lock);
+	cancel_delayed_work(&led->flash_off_work);
+	if (state) {
+		ret = s2mpb02_output(led, S2MPB02_FLASH);
+		led->strobing = !ret;
+		/* The PMIC times out by itself; this only restores the torch. */
+		if (!ret)
+			schedule_delayed_work(&led->flash_off_work,
+					      usecs_to_jiffies(led->flash_timeout_us) + 1);
+	} else {
+		led->strobing = false;
+		ret = s2mpb02_output(led, led->torch_level ? S2MPB02_TORCH : S2MPB02_OFF);
+	}
+	mutex_unlock(&led->lock);
+
+	return ret;
+}
+
+static int s2mpb02_strobe_get(struct led_classdev_flash *fled, bool *state)
+{
+	struct s2mpb02_led *led = fled_to_s2mpb02(fled);
+
+	mutex_lock(&led->lock);
+	*state = led->strobing;
+	mutex_unlock(&led->lock);
+
+	return 0;
+}
+
+static const struct led_flash_ops s2mpb02_flash_ops = {
+	.flash_brightness_set	= s2mpb02_flash_brightness_set,
+	.strobe_set		= s2mpb02_strobe_set,
+	.strobe_get		= s2mpb02_strobe_get,
+	.timeout_set		= s2mpb02_timeout_set,
+};
+
+static void s2mpb02_led_off(void *data)
+{
+	struct s2mpb02_led *led = data;
+
+	cancel_delayed_work_sync(&led->flash_off_work);
+	mutex_lock(&led->lock);
+	led->strobing = false;
+	led->torch_level = 0;
+	s2mpb02_output(led, S2MPB02_OFF);
+	mutex_unlock(&led->lock);
+}
+
+static const struct regmap_config s2mpb02_regmap_config = {
+	.reg_bits	= 8,
+	.val_bits	= 8,
+	.max_register	= 0xff,
+};
+
+static int s2mpb02_hw_init(struct s2mpb02_led *led, u32 timeout_us)
+{
+	int ret;
+
+	/* Low-voltage mode off, I2C enable/mode bits off (pins control it). */
+	ret = regmap_update_bits(led->regmap, S2MPB02_REG_FLED_CTRL1,
+				 S2MPB02_FLED_CTRL1_MODE_MASK | S2MPB02_FLED_CTRL1_LV_EN, 0);
+	if (ret)
+		return ret;
+	ret = regmap_write(led->regmap, S2MPB02_REG_FLED_CUR1,
+			   FIELD_PREP(S2MPB02_FLED_FLASH_MASK, led->flash_code) |
+			   FIELD_PREP(S2MPB02_FLED_TORCH_MASK, 1));
+	if (ret)
+		return ret;
+	ret = regmap_write(led->regmap, S2MPB02_REG_FLED_TIME1,
+			   FIELD_PREP(S2MPB02_FLED_FLASH_MASK,
+				      timeout_us / S2MPB02_TIMEOUT_STEP_US - 1) |
+			   FIELD_PREP(S2MPB02_FLED_TORCH_MASK, S2MPB02_TORCH_TIMEOUT_CODE));
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(led->regmap, S2MPB02_REG_FLED_CTRL2,
+				 S2MPB02_FLED_CTRL2_LOW_MASK, S2MPB02_FLED_CTRL2_LOW_INIT);
+	if (ret)
+		return ret;
+	return regmap_update_bits(led->regmap, S2MPB02_REG_FLED_IRD2,
+				  S2MPB02_FLED_IRD2_DISCHARGE,
+				  S2MPB02_FLED_IRD2_DISCHARGE);
+}
+
+static int s2mpb02_led_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct led_init_data init_data = {};
+	struct fwnode_handle *child;
+	struct led_classdev *cdev;
+	struct s2mpb02_led *led;
+	unsigned int id, bst, v[4];
+	u32 torch_ua = S2MPB02_TORCH_DEFAULT_UA;
+	u32 flash_ua = S2MPB02_FLASH_DEFAULT_UA;
+	u32 timeout_us = S2MPB02_TIMEOUT_DEFAULT_US;
+	int ret;
+
+	led = devm_kzalloc(dev, sizeof(*led), GFP_KERNEL);
+	if (!led)
+		return -ENOMEM;
+	led->dev = dev;
+
+	led->regmap = devm_regmap_init_i2c(client, &s2mpb02_regmap_config);
+	if (IS_ERR(led->regmap))
+		return dev_err_probe(dev, PTR_ERR(led->regmap), "regmap init failed\n");
+
+	ret = regmap_read(led->regmap, S2MPB02_REG_ID, &id);
+	if (!ret)
+		ret = regmap_read(led->regmap, S2MPB02_REG_BST_CTRL2, &bst);
+	if (ret)
+		return dev_err_probe(dev, ret, "no S2MPB02 at 0x%02x\n", client->addr);
+
+	regmap_read(led->regmap, S2MPB02_REG_FLED_CTRL1, &v[0]);
+	regmap_read(led->regmap, S2MPB02_REG_FLED_CTRL2, &v[1]);
+	regmap_read(led->regmap, S2MPB02_REG_FLED_CUR1, &v[2]);
+	regmap_read(led->regmap, S2MPB02_REG_FLED_TIME1, &v[3]);
+	dev_info(dev, "ID 0x%02x rev %d, FLED CTRL1 0x%02x CTRL2 0x%02x CUR1 0x%02x TIME1 0x%02x\n",
+		 id, bst == 0x90, v[0], v[1], v[2], v[3]);
+
+	child = device_get_next_child_node(dev, NULL);
+	if (!child)
+		return dev_err_probe(dev, -ENODEV, "no LED child node\n");
+
+	fwnode_property_read_u32(child, "led-max-microamp", &torch_ua);
+	fwnode_property_read_u32(child, "flash-max-microamp", &flash_ua);
+	fwnode_property_read_u32(child, "flash-max-timeout-us", &timeout_us);
+	torch_ua = clamp(torch_ua, S2MPB02_TORCH_STEP_UA,
+			 S2MPB02_TORCH_MAX_LEVEL * S2MPB02_TORCH_STEP_UA);
+	flash_ua = clamp(flash_ua, S2MPB02_FLASH_MIN_UA, S2MPB02_FLASH_MAX_UA);
+	timeout_us = clamp(timeout_us, S2MPB02_TIMEOUT_STEP_US, S2MPB02_TIMEOUT_MAX_US);
+
+	led->torch_gpio = devm_gpiod_get_optional(dev, "torch", GPIOD_OUT_LOW);
+	if (IS_ERR(led->torch_gpio)) {
+		ret = dev_err_probe(dev, PTR_ERR(led->torch_gpio), "torch GPIO\n");
+		goto err_put;
+	}
+	led->flash_gpio = devm_gpiod_get_optional(dev, "flash", GPIOD_OUT_LOW);
+	if (IS_ERR(led->flash_gpio)) {
+		ret = dev_err_probe(dev, PTR_ERR(led->flash_gpio), "flash GPIO\n");
+		goto err_put;
+	}
+	led->i2c_mode = !led->torch_gpio || !led->flash_gpio;
+
+	mutex_init(&led->lock);
+	INIT_DELAYED_WORK(&led->flash_off_work, s2mpb02_flash_off_work);
+	led->flash_code = (flash_ua - 50000) / S2MPB02_FLASH_STEP_UA;
+	led->flash_timeout_us = timeout_us -
+				timeout_us % S2MPB02_TIMEOUT_STEP_US;
+
+	ret = s2mpb02_hw_init(led, led->flash_timeout_us);
+	if (ret) {
+		dev_err_probe(dev, ret, "FLED init failed\n");
+		goto err_put;
+	}
+
+	/* Runs after the LED class device is gone (devm order). */
+	ret = devm_add_action_or_reset(dev, s2mpb02_led_off, led);
+	if (ret)
+		goto err_put;
+
+	led->fled.ops = &s2mpb02_flash_ops;
+	led->fled.brightness.min = S2MPB02_FLASH_MIN_UA;
+	led->fled.brightness.max = flash_ua - (flash_ua - S2MPB02_FLASH_MIN_UA) %
+				   S2MPB02_FLASH_STEP_UA;
+	led->fled.brightness.step = S2MPB02_FLASH_STEP_UA;
+	led->fled.brightness.val = led->fled.brightness.max;
+	led->fled.timeout.min = S2MPB02_TIMEOUT_STEP_US;
+	led->fled.timeout.max = led->flash_timeout_us;
+	led->fled.timeout.step = S2MPB02_TIMEOUT_STEP_US;
+	led->fled.timeout.val = led->flash_timeout_us;
+
+	cdev = &led->fled.led_cdev;
+	cdev->max_brightness = torch_ua / S2MPB02_TORCH_STEP_UA;
+	cdev->brightness_set_blocking = s2mpb02_torch_set;
+	cdev->flags |= LED_CORE_SUSPENDRESUME;
+
+	init_data.fwnode = child;
+	init_data.default_label = "white:flash";
+	ret = devm_led_classdev_flash_register_ext(dev, &led->fled, &init_data);
+	if (ret) {
+		dev_err_probe(dev, ret, "LED register failed\n");
+		goto err_put;
+	}
+
+	i2c_set_clientdata(client, led);
+	dev_info(dev, "%s: torch %u mA (%u levels), flash %u mA, %u ms, %s control\n",
+		 cdev->name, torch_ua / 1000, cdev->max_brightness,
+		 led->fled.brightness.max / 1000, led->flash_timeout_us / 1000,
+		 led->i2c_mode ? "I2C" : "GPIO");
+	ret = 0;
+err_put:
+	fwnode_handle_put(child);
+	return ret;
+}
+
+static void s2mpb02_led_shutdown(struct i2c_client *client)
+{
+	struct s2mpb02_led *led = i2c_get_clientdata(client);
+
+	if (led)
+		s2mpb02_led_off(led);
+}
+
+static const struct of_device_id s2mpb02_led_of_match[] = {
+	{ .compatible = "samsung,s2mpb02" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mpb02_led_of_match);
+
+static const struct i2c_device_id s2mpb02_led_id[] = {
+	{ "s2mpb02" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, s2mpb02_led_id);
+
+static struct i2c_driver s2mpb02_led_driver = {
+	.driver = {
+		.name = "leds-s2mpb02",
+		.of_match_table = s2mpb02_led_of_match,
+	},
+	.probe = s2mpb02_led_probe,
+	.shutdown = s2mpb02_led_shutdown,
+	.id_table = s2mpb02_led_id,
+};
+module_i2c_driver(s2mpb02_led_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPB02 flash/torch LED driver");
+MODULE_LICENSE("GPL");
