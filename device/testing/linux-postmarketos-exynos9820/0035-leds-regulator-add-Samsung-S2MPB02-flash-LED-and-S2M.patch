 drivers/leds/flash/leds-s2mpb02.c     | 421 ++++++++++++++++++++++++++
 drivers/regulator/Kconfig             |  17 ++
 drivers/regulator/Makefile            |   2 +
 drivers/regulator/s2mpb02-regulator.c | 221 ++++++++++++++
 drivers/regulator/s2mpb03-regulator.c | 217 +++++++++++++
 7 files changed, 892 insertions(+)
 create mode 100644 drivers/leds/flash/leds-s2mpb02.c
 create mode 100644 drivers/regulator/s2mpb02-regulator.c
 create mode 100644 drivers/regulator/s2mpb03-regulator.c

diff --git a/drivers/leds/flash/Kconfig b/drivers/leds/flash/Kconfig
index 9b6dd3f1ff..1b0bcfdecb 100644
--- a/drivers/leds/flash/Kconfig
+++ b/drivers/leds/flash/Kconfig
@@ -125,6 +125,19 @@ config LEDS_S2M_FLASH
 	  dedicated for every physical LED. The LEDs can be controlled in flash
 	  and torch modes.
 
+config LEDS_S2MPB02
+	tristate "Samsung S2MPB02 flash/torch LED support"
+	depends on I2C && OF
+	depends on GPIOLIB || COMPILE_TEST
+	select REGMAP_I2C
+	help
+	  This option enables support for the flash LED channel of the
+	  Samsung S2MPB02 camera PMIC, used for the rear flash/torch of the
+	  Galaxy S10 family (Exynos 9820). Torch brightness is the LED class
+	  brightness, flash is driven through the LED flash class.
+
+	  This driver can be built as a module, it will be called leds-s2mpb02.
+
 config LEDS_SGM3140
 	tristate "LED support for the SGM3140"
 	depends on V4L2_FLASH_LED_CLASS || !V4L2_FLASH_LED_CLASS
