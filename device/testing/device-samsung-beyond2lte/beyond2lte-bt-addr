#!/bin/sh
# Galaxy S10+ (beyond2lte): give the BCM4375 Bluetooth controller its real
# public address. The chip comes up with the Broadcom default 43:75:B1:00:1F:AC;
# the phone's address is in the Android EFS partition (bluetooth/bt_addr, text
# "XX:XX:XX:XX:XX:XX"). U-Boot cannot read EFS, so this runs from udev/systemd
# when hci0 appears (beyond2lte-bt-addr.service).
#
# Address source, first match wins:
#   1. BT_ADDR= in /etc/default/beyond2lte-bt-addr (manual override)
#   2. EFS, read-only: debugfs (no mount at all), else mount -o ro,noload
#      ("noload" = no journal replay, so nothing is ever written to EFS)
#   3. the copy saved in /var/lib/beyond2lte/bt_addr by an earlier run
# Set BT_ADDR=off in the default file to disable.
#
# Two ways to program it (both end in hci_bcm's vendor Write_BD_ADDR 0xfc01):
#   a) kernel with the btaddr7 hci_bcm patch: the module parameter
#      hci_uart.bdaddr= is applied right after the firmware download. This
#      script keeps /etc/modprobe.d/beyond2lte-bt-addr.conf in sync with the
#      address, so from the next hci_uart load on the controller comes up with
#      the right address before bluetoothd sees it. (Older kernels ignore the
#      unknown parameter with a warning.)
#   b) runtime fallback (first boot, older kernels): "btmgmt public-addr". The
#      controller must be really down (HCI_UP clear) for that: a request sent
#      in the 2 s auto-off window after setup is accepted, but kernels without
#      the btaddr7 hci_core fix never program it and hide hci0 from mgmt until
#      hci_uart is reloaded (seen on r9). So the controller is explicitly
#      powered on and off first, which always leaves it closed.
MODPROBE_CONF=/etc/modprobe.d/beyond2lte-bt-addr.conf

CONF=/etc/default/beyond2lte-bt-addr
CACHE=/var/lib/beyond2lte/bt_addr
EFS_DEV=/dev/disk/by-partlabel/efs
EFS_FILE=bluetooth/bt_addr
INDEX=0
BT_ADDR=
[ -r "$CONF" ] && . "$CONF"

log() { echo "beyond2lte-bt-addr: $*"; }

# prints the address in upper case if $1 is a usable unicast public address
valid() {
	a=$(echo "$1" | tr -d ' \r\n\t' | tr a-f A-F)
	echo "$a" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || return 1
	case "$a" in
	00:00:00:00:00:00|FF:FF:FF:FF:FF:FF|43:75:B1:00:1F:AC) return 1 ;;
	esac
	# bit 0 of the first octet = group address
	[ $((0x${a%%:*} & 1)) -eq 0 ] || return 1
	echo "$a"
}

read_efs() {
	[ -b "$EFS_DEV" ] || return 1
	if command -v debugfs >/dev/null 2>&1; then
		# debugfs opens the device read-only unless -w is given
		v=$(debugfs -R "cat /$EFS_FILE" "$EFS_DEV" 2>/dev/null) && valid "$v" && return 0
	fi
	m=$(mktemp -d /run/beyond2lte-efs.XXXXXX) || return 1
	r=1
	if mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$EFS_DEV" "$m" 2>/dev/null; then
		[ -r "$m/$EFS_FILE" ] && valid "$(cat "$m/$EFS_FILE")" && r=0
		umount "$m"
	fi
	rmdir "$m"
	return $r
}

case "$BT_ADDR" in
off|OFF|no|0)
	[ -e "$MODPROBE_CONF" ] && rm -f "$MODPROBE_CONF" && log "removed $MODPROBE_CONF"
	log "disabled in $CONF"; exit 0 ;;
esac

addr=
src=
if [ -n "$BT_ADDR" ]; then
	addr=$(valid "$BT_ADDR") && src=$CONF || log "ignoring invalid BT_ADDR=$BT_ADDR in $CONF"
fi
if [ -z "$addr" ] && addr=$(read_efs); then
	src=EFS
	if [ "$(cat "$CACHE" 2>/dev/null)" != "$addr" ]; then
		mkdir -p "${CACHE%/*}" && echo "$addr" > "$CACHE"
	fi
fi
if [ -z "$addr" ] && [ -r "$CACHE" ]; then
	addr=$(valid "$(cat "$CACHE")") && src=$CACHE
fi
if [ -z "$addr" ]; then
	log "no Bluetooth address found (EFS $EFS_DEV, $CACHE, $CONF), keeping the controller default"
	exit 0
fi

# (a) boot-time path for the next hci_uart load
want="# generated by /usr/libexec/beyond2lte-bt-addr ($src) - do not edit, see /etc/default/beyond2lte-bt-addr
options hci_uart bdaddr=$addr"
if [ "$(cat "$MODPROBE_CONF" 2>/dev/null)" != "$want" ]; then
	mkdir -p "${MODPROBE_CONF%/*}" && echo "$want" > "$MODPROBE_CONF" &&
		log "wrote $MODPROBE_CONF (hci_uart bdaddr=$addr)"
fi

command -v btmgmt >/dev/null 2>&1 || { log "btmgmt not installed (bluez-btmgmt)"; exit 1; }
mgmt() { timeout 10 btmgmt --index "$INDEX" "$@" 2>&1; }

# The index is only visible to mgmt once hci_bcm's setup (firmware patch) is
# done: wait for it.
i=0
while :; do
	info=$(mgmt info)
	cur=$(echo "$info" | sed -n 's/^[[:space:]]*addr \([0-9A-Fa-f:]\{17\}\).*/\1/p' | head -1 | tr a-f A-F)
	[ -n "$cur" ] && break
	i=$((i + 1))
	[ $i -ge 30 ] && { log "hci$INDEX did not show up in mgmt: $info"; exit 1; }
	sleep 1
done

if [ "$cur" = "$addr" ]; then
	case "$(cat /sys/module/hci_uart/parameters/bdaddr 2>/dev/null)" in
	"$addr"|"$(echo "$addr" | tr A-F a-f)")
		log "hci$INDEX already uses $addr ($src, hci_uart bdaddr parameter)" ;;
	*)	log "hci$INDEX already uses $addr ($src)" ;;
	esac
	exit 0
fi

# (b) runtime fallback
powered=0
echo "$info" | grep 'current settings:' | grep -qw powered && powered=1

# Leave the controller closed: power on (ends the auto-off window if we are in
# it) and off again. mgmt answers both only once the change is done.
rc=1
try=0
while [ $try -lt 3 ]; do
	try=$((try + 1))
	mgmt power on >/dev/null
	mgmt power off >/dev/null
	out=$(mgmt public-addr "$addr")
	echo "$out" | grep -q "Set Public Address complete" && { rc=0; break; }
	# "Rejected": something (bluetoothd) powered it on again in between
	log "public-addr attempt $try: $(echo "$out" | tail -1)"
	sleep 1
done
log "hci$INDEX $cur -> $addr ($src): $(echo "$out" | tail -1)"

# Changing the address of a configured controller makes the kernel remove the
# index, power the controller on once to program the address and add the index
# again. Wait for it to come back with the new address.
i=0
while [ $rc = 0 ] && [ $i -lt 15 ]; do
	sleep 1
	i=$((i + 1))
	info=$(mgmt info)
	echo "$info" | grep -qi "addr $addr" && break
done
if ! echo "$info" | grep -qi "addr $addr"; then
	a=$(echo "$info" | grep -i 'addr ' | head -1)
	if [ -z "$a" ]; then
		log "hci$INDEX did not come back in mgmt (stuck in HCI_CONFIG, kernel without the btaddr7 fix?):" \
			"reload hci_uart (modprobe -r hci_uart; modprobe hci_uart) or reboot"
	else
		log "address still not applied: $a"
	fi
	rc=1
fi
[ $powered = 1 ] && mgmt power on >/dev/null
exit $rc
