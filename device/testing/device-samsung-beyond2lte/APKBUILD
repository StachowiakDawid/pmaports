# Reference: <https://postmarketos.org/devicepkg>
# Samsung Galaxy S10+ (SM-G975F). Uses the generic Exynos 9820 kernel
# (linux-postmarketos-exynos9820) and U-Boot (EFI -> systemd-boot, DT from
# U-Boot); this package adds the beyond2lte-specific userspace glue.
maintainer="StachowiakDawid <dawidos234@gmail.com>"
pkgname=device-samsung-beyond2lte
pkgdesc="Samsung Galaxy S10+"
pkgver=3
pkgrel=54
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
# firmware-samsung-beyond2lte-stock: local-only package, files from this
# phone's vendor partition (not redistributable), see its APKBUILD.
depends="
	alsa-ucm-conf
	beyond2lte-tools
	bluez-btmgmt
	e2fsprogs-extra
	firmware-samsung-beyond2lte-stock
	linux-postmarketos-exynos9820
	postmarketos-base
	python3
	reboot-mode
	systemd-boot
"
makedepends="devicepkg-dev"
# was provided (virtually) by the generic device-samsung-exynos9820
replaces="device-samsung-exynos9820"
subpackages="
	$pkgname-autosuspend:autosuspend:noarch
	$pkgname-nosuspend:nosuspend:noarch
	$pkgname-phosh:phosh:noarch
	$pkgname-pipewire:pipewire_audio:noarch
"
_pmb_recommends="$pkgname-autosuspend"
# systemd-boot app changes: re-apply the menu separator fix
triggers="$pkgname.trigger=/usr/lib/systemd/boot/efi"
source="
