build() {
	devicepkg_build $startdir $pkgname
}

package() {
	# deviceinfo, machine-info, kernel-cmdline.d, modprobe.d
	devicepkg_package $startdir $pkgname

	cd "$srcdir"
	local sys="$pkgdir"/usr/lib/systemd/system
	install -Dm644 beyond2lte-usbc.conf "$pkgdir"/etc/modprobe.d/beyond2lte-usbc.conf
	# LXC needs these delegated controllers to create Waydroid's cgroup v2 tree.
	install -Dm644 waydroid-container.conf \
		"$pkgdir"/usr/lib/systemd/system/waydroid-container.service.d/50-beyond2lte-cgroups.conf
	install -Dm755 beyond2lte-waydroid-route \
		"$pkgdir"/usr/libexec/beyond2lte-waydroid-route
	install -Dm644 beyond2lte-waydroid-route.path beyond2lte-waydroid-route.service -t "$sys"

	# USB gadget reconnect (+ MUIC CTRL1 fix via i2crw unless max77705-usbc is bound)
	install -Dm755 usb-gadget-reconnect.sh "$pkgdir"/usr/libexec/usb-gadget-reconnect.sh
	install -Dm644 usb-gadget-reconnect.service -t "$sys"
	install -Dm644 touch-rebind.service -t "$sys"
	install -Dm644 touch-wake.service -t "$sys"

	install -Dm644 70-beyond2lte-feedback.rules -t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 72-beyond2lte-ufs-rpm.rules -t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 62-beyond2lte-usbc-sleep.rules -t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm755 beyond2lte-usbc-sleep -t "$pkgdir"/usr/libexec
	install -Dm644 50-wifi-permanent-mac.conf -t "$pkgdir"/usr/lib/NetworkManager/conf.d
	install -Dm644 51-wifi-powersave.conf -t "$pkgdir"/usr/lib/NetworkManager/conf.d

	# charging policy (enabled, 60-80 % window for 24/7 plugged use)
	install -Dm755 beyond2lte-charge "$pkgdir"/usr/libexec/beyond2lte-charge
	install -Dm644 beyond2lte-charge.default "$pkgdir"/etc/default/beyond2lte-charge
	install -Dm644 beyond2lte-charge.service -t "$sys"

	# kernel fallback: loader.conf hook, boot counting, known-good slots
	install -Dm755 beyond2lte-boot "$pkgdir"/usr/libexec/beyond2lte-boot
	install -Dm644 beyond2lte-boot.default "$pkgdir"/etc/default/beyond2lte-boot
	install -Dm755 boot-deploy-hook.sh \
		"$pkgdir"/usr/share/boot-deploy/hooks/50-beyond2lte-loader-conf
	install -Dm755 beyond2lte-sdboot-wchar-fix -t "$pkgdir"/usr/libexec/
	# never fall back to s2idle (hangs with the modem running)
	install -Dm644 sleep-mem-only.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/40-beyond2lte-mem-only.conf
	# greeter OSK: no respawn loop into a dead compositor at login
	install -Dm644 osk-no-respawn.conf \
		"$pkgdir"/usr/lib/systemd/user/mobi.phosh.OSK.service.d/50-beyond2lte.conf
	install -Dm644 beyond2lte-boot-arm.path beyond2lte-boot-arm.service \
		beyond2lte-boot-good.service beyond2lte-fallback-modules.service -t "$sys"
	install -dm755 "$pkgdir"/var/lib/beyond2lte-boot

	# time: RTC load/save, timesyncd, HTTP fallback
	install -Dm755 beyond2lte-rtc "$pkgdir"/usr/libexec/beyond2lte-rtc
	install -Dm644 beyond2lte-rtc.service beyond2lte-rtc-save.path \
		beyond2lte-rtc-save.service -t "$sys"
	install -Dm755 beyond2lte-httptime "$pkgdir"/usr/bin/beyond2lte-httptime
	install -Dm644 timesyncd.conf \
		"$pkgdir"/usr/lib/systemd/timesyncd.conf.d/50-beyond2lte.conf

	# Bluetooth: real public address from the EFS partition (read-only) when hci0 appears
	install -Dm755 beyond2lte-bt-addr "$pkgdir"/usr/libexec/beyond2lte-bt-addr
	install -Dm644 beyond2lte-bt-addr.default "$pkgdir"/etc/default/beyond2lte-bt-addr
	install -Dm644 beyond2lte-bt-addr.service -t "$sys"
	install -Dm644 81-beyond2lte-bt-addr.rules -t "$pkgdir"/usr/lib/udev/rules.d
	install -dm755 "$pkgdir"/var/lib/beyond2lte

	# ALSA UCM2 for the beyond-madera card (speaker/earpiece/headphones/mics, amp gain caps)
	install -Dm644 beyond-madera.conf \
		-t "$pkgdir"/usr/share/alsa/ucm2/conf.d/beyond-madera
	install -Dm644 HiFi.conf -t "$pkgdir"/usr/share/alsa/ucm2/Samsung/beyond2lte

	# DECON KMS takeover wait before greetd (no-op unless exynos9820_decon enable=1, opt-in,
	# see modprobe.conf)
	install -Dm755 beyond2lte-display-takeover "$pkgdir"/usr/libexec/beyond2lte-display-takeover
	install -Dm644 beyond2lte-display-takeover.service -t "$sys"

	# memory/bus DVFS: MIF/INT low while the screen is off and in s2idle (no-op
	# without the acpm_protocol.dvfs_cmd knob, pmaports 0030)
	install -Dm755 beyond2lte-dvfs "$pkgdir"/usr/libexec/beyond2lte-dvfs
	install -Dm644 beyond2lte-dvfs.default "$pkgdir"/etc/default/beyond2lte-dvfs
	install -Dm644 beyond2lte-dvfs.service -t "$sys"
	install -Dm755 beyond2lte-dvfs.sleep \
		"$pkgdir"/usr/lib/systemd/system-sleep/beyond2lte-dvfs
	install -dm755 "$pkgdir"/usr/bin
	ln -s ../libexec/beyond2lte-dvfs "$pkgdir"/usr/bin/beyond2lte-dvfs

	install -Dm644 watchdog.conf "$pkgdir"/usr/lib/systemd/system.conf.d/50-beyond2lte-watchdog.conf
	install -Dm755 beyond2lte-boot-report "$pkgdir"/usr/bin/beyond2lte-boot-report
	install -Dm644 beyond2lte-feedbackd.conf \
		"$pkgdir"/usr/lib/sysusers.d/beyond2lte-feedbackd.conf
	# voice calls (shannon-modem's /run/shannon/call-active): a ringing call
	# lights the screen, also after a dark modem wake
	install -Dm755 beyond2lte-call-wake -t "$pkgdir"/usr/libexec
	install -Dm644 beyond2lte-call-wake.path beyond2lte-call-wake.service -t "$sys"

	install -Dm644 80-device-samsung-beyond2lte.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset
}

autosuspend() {
	pkgdesc="Samsung Galaxy S10+: deep sleep after 5 min idle; a plugged-in SDR radio keeps it awake"
	depends="$pkgname=$pkgver-r$pkgrel !$pkgname-nosuspend"
	replaces="$pkgname-nosuspend"
	cd "$srcdir"
	install -Dm644 50_beyond2lte-autosuspend.gschema.override \
		-t "$subpkgdir"/usr/share/glib-2.0/schemas
	install -Dm644 62-beyond2lte-sdr-inhibit.rules \
		-t "$subpkgdir"/usr/lib/udev/rules.d
	install -Dm644 beyond2lte-sdr-inhibit@.service beyond2lte-boot-nosleep.service \
		-t "$subpkgdir"/usr/lib/systemd/system
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../beyond2lte-boot-nosleep.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/beyond2lte-boot-nosleep.service
	# suspend again after wakes without user input (gsd-power does not re-arm)
	install -Dm755 beyond2lte-resuspend -t "$subpkgdir"/usr/libexec
	install -Dm644 beyond2lte-resuspend.service -t "$subpkgdir"/usr/lib/systemd/system
	install -Dm755 beyond2lte-resuspend.sleep \
		"$subpkgdir"/usr/lib/systemd/system-sleep/beyond2lte-resuspend
}

nosuspend() {
	pkgdesc="Samsung Galaxy S10+: never suspend (24/7 server use; replaces -autosuspend)"
	depends="$pkgname=$pkgver-r$pkgrel !$pkgname-autosuspend"
	cd "$srcdir"
	install -Dm644 logind-nosuspend.conf \
		"$subpkgdir"/usr/lib/systemd/logind.conf.d/50-beyond2lte-nosuspend.conf
	install -Dm644 sleep-nosuspend.conf \
		"$subpkgdir"/usr/lib/systemd/sleep.conf.d/50-beyond2lte-nosuspend.conf
	install -Dm644 50_beyond2lte-nosuspend.gschema.override \
		-t "$subpkgdir"/usr/share/glib-2.0/schemas
	local t
	mkdir -p "$subpkgdir"/etc/systemd/system
	for t in sleep suspend hibernate hybrid-sleep suspend-then-hibernate; do
		ln -s /dev/null "$subpkgdir"/etc/systemd/system/$t.target
	done
}

pipewire_audio() {
	# PipeWire is the audio backend for this device (like PinePhone): only its UCM
	# code supports SplitPCM, which the UCM uses to offer Speaker and Earpiece as two
	# sinks of one profile (verified 3-r12). Pulled in automatically on UIs with audio.
	# Under PulseAudio the UCM falls back to the route layout (see ucm/HiFi.conf).
	pkgdesc="Samsung Galaxy S10+: use PipeWire as the audio backend (Speaker + Earpiece as two outputs)"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio"
	depends="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio-backend-pipewire
		pipewire-echo-cancel pipewire-webrtc"
	# WebRTC voice-processing source (AGC + noise suppression) on the internal mics
	install -Dm644 "$srcdir"/60-beyond2lte-voice-mic.conf \
		-t "$subpkgdir"/usr/share/pipewire/pipewire.conf.d
	# second, echo-cancelled source for calls/VoIP (reference linked on demand)
	install -Dm644 "$srcdir"/61-beyond2lte-call-mic.conf \
		-t "$subpkgdir"/usr/share/pipewire/pipewire.conf.d
	install -Dm644 "$srcdir"/61-beyond2lte-call-mic.wireplumber.conf \
		"$subpkgdir"/usr/share/wireplumber/wireplumber.conf.d/61-beyond2lte-call-mic.conf
	install -Dm644 "$srcdir"/beyond2lte-call-mic-reference.lua \
		-t "$subpkgdir"/usr/share/wireplumber/scripts
}

phosh() {
	pkgdesc="Samsung Galaxy S10+: Phosh display scale and OLED blanking"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"
	depends=""
	# /usr/share/phosh/phoc.ini is owned by phosh
	replaces="phosh"
	cd "$srcdir"
	install -Dm644 phoc.ini "$subpkgdir"/usr/share/phosh/phoc.ini
	install -Dm755 beyond2lte-blank "$subpkgdir"/usr/libexec/beyond2lte-blank
	install -Dm644 beyond2lte-blank.service -t "$subpkgdir"/usr/lib/systemd/user
	install -Dm644 80-device-samsung-beyond2lte.user-preset \
		"$subpkgdir"/usr/lib/systemd/user-preset/80-device-samsung-beyond2lte.preset
	install -Dm644 71-beyond2lte-backlight.rules -t "$subpkgdir"/usr/lib/udev/rules.d
}
