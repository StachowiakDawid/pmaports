#!/bin/sh
# Blank the OLED panel when Phosh blanks the screen (anti burn-in).
# Today the display runs on simpledrm, which cannot switch the panel off, so
# Phosh/gsd "screen off" only stops updating a lit image. This user service
# follows org.gnome.Mutter.DisplayConfig PowerSaveMode (implemented by Phosh,
# set by gsd-power on idle / power key) and mirrors it to the s6e3ha9
# backlight: bl_power=$OFF_LEVEL when off, 0 when on.
# OFF_LEVEL 1 = display off, panel awake (tested, instant on);
#           4 = display off + sleep-in (saves more power; wake-up untested).
OFF_LEVEL=${BEYOND2LTE_BLANK_LEVEL:-1}
[ -r /etc/default/beyond2lte-blank ] && . /etc/default/beyond2lte-blank

# wake beyond2lte-dvfs (memory/bus DVFS) at once instead of at its next
# DPMS poll: "on" raises MIF/INT before the scanout starts. Only when the
# service runs (FIFO present, reader open); never blocks for more than 1 s.
DVFS_FIFO=/run/beyond2lte-dvfs/nudge
dvfs_nudge() {
	[ -p "$DVFS_FIFO" ] || return 0
	# shellcheck disable=SC2016
	timeout 1 sh -c 'echo "$1" > "$2"' _ "$1" "$DVFS_FIFO" 2>/dev/null
	return 0
}

set_bl() {
	for b in /sys/class/backlight/*/bl_power; do
		[ -w "$b" ] && [ "$(cat "$b")" != "$1" ] && echo "$1" > "$b"
	done
}

gdbus monitor --session --dest org.gnome.Mutter.DisplayConfig \
	--object-path /org/gnome/Mutter/DisplayConfig 2>/dev/null |
while read -r line; do
	case "$line" in
	*PowerSaveMode*)
		m=$(echo "$line" | sed -n "s/.*'PowerSaveMode': <\(int32 \)\{0,1\}\(-\{0,1\}[0-9]*\)>.*/\2/p")
		case "$m" in
		0) dvfs_nudge on; set_bl 0 ;;
		[1-9]*) set_bl "$OFF_LEVEL"; dvfs_nudge off ;;
		esac
		;;
	esac
done
