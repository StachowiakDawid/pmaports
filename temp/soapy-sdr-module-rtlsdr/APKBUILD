# Contributor: StachowiakDawid
pkgname=soapy-sdr-module-rtlsdr
pkgver=0.3.4
pkgrel=0
pkgdesc="SoapySDR module for RTL-SDR dongles (SoapyRTLSDR)"
url="https://github.com/pothosware/SoapyRTLSDR"
arch="all"
license="MIT"
depends="soapy-sdr-libs"
makedepends="cmake samurai soapy-sdr-dev librtlsdr-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/pothosware/SoapyRTLSDR/archive/refs/tags/soapy-rtlsdr-$pkgver.tar.gz"
builddir="$srcdir/SoapyRTLSDR-soapy-rtlsdr-$pkgver"
options="!check" # no test suite

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=MinSizeRel
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
