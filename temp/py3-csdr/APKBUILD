# Contributor: StachowiakDawid
pkgname=py3-csdr
pkgver=0.18.43
_commit=e0029bdfb135ff09557dc296ef9772b17ff4fe1a
pkgrel=0
pkgdesc="Python bindings for the csdr library (OpenWebRX+ fork)"
url="https://github.com/luarvique/pycsdr"
arch="all"
license="GPL-3.0-or-later"
depends="python3"
makedepends="csdr-dev fftw-dev py3-gpep517 py3-setuptools py3-wheel python3-dev"
source="pycsdr-$_commit.tar.gz::https://github.com/luarvique/pycsdr/archive/$_commit.tar.gz"
builddir="$srcdir/pycsdr-$_commit"
options="!check" # no test suite

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
	# C++ headers for other bindings (pydigiham etc.), not needed at run time
	rm -rf "$pkgdir"/usr/include
}
sha512sums="
