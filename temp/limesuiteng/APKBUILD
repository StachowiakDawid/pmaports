# Maintainer: beyond2lte port <beyond2lte@example.org>
# LimeSuiteNG: driver library + CLI for LimeSDR boards incl. LimeSDR Mini 2.0
# (FT601, USB 0403:601f, driven from userspace through libusb - no kernel driver).
# Not packaged in Alpine edge (checked 2026-11-14), neither is legacy LimeSuite.
pkgname=limesuiteng
pkgver=25.1.0
pkgrel=2
pkgdesc="Driver and tools for LimeSDR devices (next generation LimeSuite)"
url="https://github.com/myriadrf/LimeSuiteNG"
arch="all"
license="Apache-2.0"
depends_dev="libusb-dev"
# python3: plugins/gr-limesuiteng includes GrPython (FindPythonInterp) even when
# BUILD_PLUGINS_GNURADIO=OFF
makedepends="cmake samurai python3 libusb-dev soapy-sdr-dev $depends_dev"
subpackages="
	$pkgname-dev
	$pkgname-tools
	$pkgname-udev
	soapy-sdr-module-limesuiteng:soapy
	"
# r1: Soapy readStreamStatus fix (SoapySDRUtil/SoapyRemote "stall"),
# packetsInBatch stream/device arg + Rx override fix, CS12 host format rejected,
# limeTRX single-channel fix; r2: drop stale Rx data left by a killed session
source="$pkgname-$pkgver.tar.gz::https://github.com/myriadrf/LimeSuiteNG/archive/refs/tags/v$pkgver.tar.gz
	0001-TRXLooper-honour-extraConfig.rx.packetsInBatch.patch
	0002-soapysdr-report-stream-status-events-once-packetsInB.patch
	0003-limeTRX-add-each-channel-once.patch
	0004-TRXLooper-drop-stale-Rx-data-at-stream-start.patch
	"
builddir="$srcdir/LimeSuiteNG-$pkgver"
options="!check" # unit tests need googletest download

prepare() {
	default_prepare
	# Debian-style SOVERSION "0.3-1" is rejected by abuild's so: provider scan
	# ("library version 0.3-1 is invalid") -> soname liblimesuiteng.so.0.3
	sed -i 's/set(LIMESUITENG_SOVER "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}-1")/set(LIMESUITENG_SOVER "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}")/' \
		src/CMakeLists.txt
	grep -q 'LIMESUITENG_SOVER "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}")' src/CMakeLists.txt
}

build() {
	# GUI needs wxWidgets/OpenGL, drivers = PCIe kernel module sources (not
	# needed for USB boards), amarisoft/gnuradio plugins not wanted here.
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_GUI=OFF \
		-DBUILD_DRIVERS=OFF \
		-DBUILD_DOCS=OFF \
		-DENABLE_UNIT_TESTS=OFF \
		-DBUILD_PLUGINS_AMARISOFT=OFF \
		-DBUILD_PLUGINS_GNURADIO=OFF \
		-DBUILD_PLUGINS_SOAPYSDR=ON \
		-DINSTALL_UDEV_RULES=ON \
		-DUDEV_RULES_INSTALL_PATH=/usr/lib/udev/rules.d \
		-DUDEV_RULES_RELOAD_ON_INSTALL=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 # vendored rang/args need it with CMake 4
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

tools() {
	pkgdesc="$pkgdesc (command line tools: limeDevice, limeTRX, limeConfig, ...)"
	amove usr/bin
}

udev() {
	pkgdesc="$pkgdesc (upstream udev rules, world-writable - see beyond2lte-sdr-server for a group-based rule)"
	amove usr/lib/udev
}

soapy() {
	pkgdesc="SoapySDR module for LimeSuiteNG (driver=limesuiteng)"
	depends="$pkgname=$pkgver-r$pkgrel"
	amove usr/lib/SoapySDR
}
