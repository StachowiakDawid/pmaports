# Contributor: StachowiakDawid
# Operations tooling for the beyond2lte 24/7 SDR server: health page, headless
# switch, self-healing, recorder. The main package is a meta package; each
# tool is its own subpackage.
pkgname=beyond2lte-sdr-extras
pkgver=1
pkgrel=0
pkgdesc="Health page, headless switch, self-healing and recorder for the beyond2lte SDR server (meta)"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="
	$pkgname-status=$pkgver-r$pkgrel
	$pkgname-headless=$pkgver-r$pkgrel
	$pkgname-selfheal=$pkgver-r$pkgrel
	$pkgname-record=$pkgver-r$pkgrel
	"
install="$pkgname-status.pre-install $pkgname-record.pre-install"
subpackages="
	$pkgname-status
	$pkgname-headless
	$pkgname-selfheal
	$pkgname-record
	$pkgname-nftables:nftrules
	"
source="
	sdr-status-server sdr-status.service sdr-status.default
	sdr-headless sdr-headless.default sdr-headless-panel.service greetd-sdr-headless.conf
	sdr-wifi-watchdog sdr-wifi-watchdog.service
	sdr-usb-check sdr-usb-check.service sdr-usb-check.timer
	sdr-replug sdr-replug@.service 61-sdr-selfheal.rules
	sdr-selfheal.default
	sdr-record sdr-record.default sdr-record@.service sdr-record@.timer
	sdr-record-rotate.service sdr-record-rotate.timer
	profile-ism-iq.conf profile-fm-audio.conf profile-lime-iq.conf
	sdr-extras.tmpfiles
	50_sdr-status.nft
	"
options="!check" # no tests
_unitdir=/usr/lib/systemd/system

package() {
	mkdir -p "$pkgdir"
}

# what `systemctl preset` (apk trigger on pmOS) does when a subpackage is installed
_preset() {
	local name="$1"; shift
	mkdir -p "$subpkgdir"/usr/lib/systemd/system-preset
	printf '%s\n' "# $pkgname-$name" "$@" \
		> "$subpkgdir"/usr/lib/systemd/system-preset/80-sdr-$name.preset
}

status() {
	pkgdesc="Tiny LAN health/status page for the beyond2lte SDR server (python http.server, port 8080)"
	depends="python3 iw"
	_preset status "enable sdr-status.service"
	install -Dm755 "$srcdir"/sdr-status-server "$subpkgdir"/usr/libexec/sdr-status/sdr-status-server
	install -Dm644 "$srcdir"/sdr-status.service "$subpkgdir"$_unitdir/sdr-status.service
	install -Dm644 "$srcdir"/sdr-status.default "$subpkgdir"/etc/default/sdr-status
}

headless() {
	pkgdesc="sdr-headless on|off|status: run beyond2lte without Phosh, panel off"
	depends=""
	# the panel unit only acts while /etc/sdr-headless/enabled exists
	_preset headless "enable sdr-headless-panel.service"
	install -Dm755 "$srcdir"/sdr-headless "$subpkgdir"/usr/bin/sdr-headless
	install -Dm644 "$srcdir"/sdr-headless.default "$subpkgdir"/etc/default/sdr-headless
	install -Dm644 "$srcdir"/sdr-headless-panel.service \
		"$subpkgdir"$_unitdir/sdr-headless-panel.service
	install -Dm644 "$srcdir"/greetd-sdr-headless.conf \
		"$subpkgdir"$_unitdir/greetd.service.d/60-sdr-headless.conf
}

selfheal() {
	pkgdesc="Self-healing for the beyond2lte SDR server: Wi-Fi watchdog, USB re-enumeration restarts, USB3 speed check"
	depends=""
	local f
	# the Wi-Fi watchdog acts on the network: left for the admin to enable
	_preset selfheal "enable sdr-usb-check.timer" "disable sdr-wifi-watchdog.service"
	for f in sdr-wifi-watchdog sdr-usb-check sdr-replug; do
		install -Dm755 "$srcdir"/$f "$subpkgdir"/usr/libexec/sdr-selfheal/$f
	done
	for f in sdr-wifi-watchdog.service sdr-usb-check.service sdr-usb-check.timer \
		sdr-replug@.service; do
		install -Dm644 "$srcdir"/$f "$subpkgdir"$_unitdir/$f
	done
	install -Dm644 "$srcdir"/61-sdr-selfheal.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/61-sdr-selfheal.rules
	install -Dm644 "$srcdir"/sdr-selfheal.default "$subpkgdir"/etc/default/sdr-selfheal
}

record() {
	pkgdesc="sdr-record: scheduled IQ (SoapySDR/SigMF) and audio (rtl_fm/FLAC) recordings with rotation"
	depends="python3 py3-soapy-sdr rtl-sdr flac"
	local f
	_preset record "enable sdr-record-rotate.timer" "disable sdr-record@.timer"
	install -Dm755 "$srcdir"/sdr-record "$subpkgdir"/usr/bin/sdr-record
	install -Dm644 "$srcdir"/sdr-record.default "$subpkgdir"/etc/default/sdr-record
	for f in sdr-record@.service sdr-record@.timer sdr-record-rotate.service \
		sdr-record-rotate.timer; do
		install -Dm644 "$srcdir"/$f "$subpkgdir"$_unitdir/$f
	done
	for f in ism-iq fm-audio lime-iq; do
		install -Dm644 "$srcdir"/profile-$f.conf "$subpkgdir"/etc/sdr-record/$f.conf
	done
	install -Dm644 "$srcdir"/sdr-extras.tmpfiles "$subpkgdir"/usr/lib/tmpfiles.d/sdr-record.conf
}

nftrules() {
	pkgdesc="nftables rule opening the sdr-status health page (TCP 8080) for LAN sources"
	depends=""
	install_if="$pkgname-status=$pkgver-r$pkgrel nftables"
	install -Dm644 "$srcdir"/50_sdr-status.nft \
		"$subpkgdir"/etc/nftables.d/50_sdr-status.nft
}
