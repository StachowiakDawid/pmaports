# beyond2lte-sdr-server: RTL-SDR (RTL2832U) access for the "sdr" group, no USB autosuspend.
# Common IDs: 0bda:2838 (RTL2838 / most "RTL-SDR" dongles incl. RTL-SDR Blog v3/v4), 0bda:2832.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", \
  MODE="0660", GROUP="sdr", TAG+="uaccess", ATTR{power/control}="on"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", \
  MODE="0660", GROUP="sdr", TAG+="uaccess", ATTR{power/control}="on"
