# Contributor: StachowiakDawid
pkgname=beyond2lte-sdr-rtlsdr
pkgver=1
pkgrel=0
pkgdesc="RTL-SDR support for the beyond2lte SoapySDR network server"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="soapy-sdr-module-rtlsdr librtlsdr rtl-sdr"
install_if="beyond2lte-sdr-server soapy-sdr-module-rtlsdr"
source="60-beyond2lte-rtlsdr.rules rtlsdr-blacklist.conf"
options="!check"

package() {
	install -Dm644 "$srcdir"/60-beyond2lte-rtlsdr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/60-beyond2lte-rtlsdr.rules
	install -Dm644 "$srcdir"/rtlsdr-blacklist.conf \
		"$pkgdir"/usr/lib/modprobe.d/beyond2lte-rtlsdr.conf
}
