Flush every log line: with stdout connected to the journal (a pipe/socket)
stdio is block buffered and the server log shows up minutes late or never.

--- a/core/src/utils/flog.cpp
+++ b/core/src/utils/flog.cpp
@@ -175,6 +175,8 @@
             // Print format string
             fprintf(outStream, COLOR_WHITE "[%02d/%02d/%02d %02d:%02d:%02d.%03d] [%s%s" COLOR_WHITE "] %s\n",
                     nowc->tm_mday, nowc->tm_mon + 1, nowc->tm_year + 1900, nowc->tm_hour, nowc->tm_min, nowc->tm_sec, 0, TYPE_COLORS[type], TYPE_STR[type], out.c_str());
+            // stdout is block buffered when it is a pipe (systemd journal)
+            fflush(outStream);
 #endif
         }
     }
