# Contributor: StachowiakDawid
pkgname=sdrpp
pkgver=1.3.2_git20261107
_commit=ea6f755ac9f746cb05e34238ec5d69e5c5d17da8
pkgrel=1
pkgdesc="SDR++ receiver software (server-oriented build: SoapySDR, RTL-SDR and network sources)"
url="https://www.sdrpp.org/"
arch="all"
license="GPL-3.0-only"
makedepends="
	cmake
	fftw-dev
	glfw-dev
	librtlsdr-dev
	libvolk-dev
	mesa-dev
	samurai
	soapy-sdr-dev
	zstd-dev
	"
source="$pkgname-$_commit.tar.gz::https://github.com/AlexandreRouma/SDRPlusPlus/archive/$_commit.tar.gz
	flush-log.patch
	soapy-samplerate-range.patch
	"
builddir="$srcdir/SDRPlusPlus-$_commit"
options="!check" # no test suite

# `sdrpp --server` only loads *_source plugins, so sinks, decoders and misc
# modules are not built. The core library still links GLFW/OpenGL (there is no
# headless backend upstream); in server mode the GUI backend is never
# initialised, so no display is needed at run time.
build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DOPT_BUILD_SOAPY_SOURCE=ON \
		-DOPT_BUILD_RTL_SDR_SOURCE=ON \
		-DOPT_BUILD_RTL_TCP_SOURCE=ON \
		-DOPT_BUILD_FILE_SOURCE=ON \
		-DOPT_BUILD_NETWORK_SOURCE=ON \
		-DOPT_BUILD_SDRPP_SERVER_SOURCE=ON \
		-DOPT_BUILD_SPYSERVER_SOURCE=ON \
		-DOPT_BUILD_AIRSPY_SOURCE=OFF \
		-DOPT_BUILD_AIRSPYHF_SOURCE=OFF \
		-DOPT_BUILD_AUDIO_SOURCE=OFF \
		-DOPT_BUILD_HACKRF_SOURCE=OFF \
		-DOPT_BUILD_HERMES_SOURCE=OFF \
		-DOPT_BUILD_PLUTOSDR_SOURCE=OFF \
		-DOPT_BUILD_RFSPACE_SOURCE=OFF \
		-DOPT_BUILD_SPECTRAN_HTTP_SOURCE=OFF \
		-DOPT_BUILD_AUDIO_SINK=OFF \
		-DOPT_BUILD_NETWORK_SINK=OFF \
		-DOPT_BUILD_ATV_DECODER=OFF \
		-DOPT_BUILD_METEOR_DEMODULATOR=OFF \
		-DOPT_BUILD_PAGER_DECODER=OFF \
		-DOPT_BUILD_RADIO=OFF \
		-DOPT_BUILD_DISCORD_PRESENCE=OFF \
		-DOPT_BUILD_FREQUENCY_MANAGER=OFF \
		-DOPT_BUILD_IQ_EXPORTER=OFF \
		-DOPT_BUILD_RECORDER=OFF \
		-DOPT_BUILD_RIGCTL_CLIENT=OFF \
		-DOPT_BUILD_RIGCTL_SERVER=OFF \
		-DOPT_BUILD_SCANNER=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	# server-only build: no desktop entry
	rm -rf "$pkgdir"/usr/share/applications
}
