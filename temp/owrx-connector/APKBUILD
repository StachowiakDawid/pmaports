# Contributor: StachowiakDawid
pkgname=owrx-connector
pkgver=0.6.5_git20260823
_commit=5b014234cf0f1f49b01ec85f8b29d04c471d28ac
pkgrel=0
pkgdesc="SDR connectors for OpenWebRX+ (rtl_connector, soapy_connector, rtl_tcp_connector)"
url="https://github.com/luarvique/owrx_connector"
arch="all"
license="GPL-3.0-or-later"
makedepends="cmake csdr-dev fftw-dev librtlsdr-dev libsamplerate-dev samurai soapy-sdr-dev"
subpackages="$pkgname-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/luarvique/owrx_connector/archive/$_commit.tar.gz"
builddir="$srcdir/owrx_connector-$_commit"
options="!check" # no test suite

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
