#!/bin/sh
# beyond2lte-sdr-server: NetworkManager applies wifi.powersave on every activation; keep power
# save off after a (re)connect while an SDR radio is plugged in.
[ "$2" = up ] || exit 0
[ "$(cat /sys/class/net/"$1"/uevent 2>/dev/null | grep -c DEVTYPE=wlan)" = 1 ] || exit 0
ls /dev/sdr/ 2>/dev/null | grep -q . || exit 0
exec /usr/sbin/iw dev "$1" set power_save off
