# Maintainer: beyond2lte port <beyond2lte@example.org>
# 24/7 headless SoapySDR network server (SoapyRemote) for a LimeSDR Mini 2.0
# on the Galaxy S10+ (beyond2lte).
pkgname=beyond2lte-sdr-server
pkgver=1
pkgrel=2
pkgdesc="SoapySDRServer service, udev, firewall and sysctl setup for a LimeSDR on beyond2lte"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="
	soapy-sdr
	soapy-sdr-remote
	soapy-sdr-remote-server
	soapy-sdr-module-limesuiteng
	limesuiteng-tools
	iw
	"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-nftables:nftrules:noarch"
source="
	60-beyond2lte-limesdr.rules
	50_soapyremote.nft
	beyond2lte-sdr-server.service
	beyond2lte-sdr-server.conf
	beyond2lte-sdr-server.sysctl
	beyond2lte-sdr-server.tmpfiles
	beyond2lte-sdr-governor.service
	beyond2lte-sdr-governor
	63-beyond2lte-sdr-wifi-ps.rules
	beyond2lte-sdr-wifi-ps@.service
	beyond2lte-sdr-wifi-ps.dispatcher
	"
options="!check" # no tests

package() {
	install -Dm644 "$srcdir"/60-beyond2lte-limesdr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/60-beyond2lte-limesdr.rules
	install -Dm644 "$srcdir"/beyond2lte-sdr-server.service \
		"$pkgdir"/usr/lib/systemd/system/beyond2lte-sdr-server.service
	install -Dm644 "$srcdir"/beyond2lte-sdr-governor.service \
		"$pkgdir"/usr/lib/systemd/system/beyond2lte-sdr-governor.service
	install -Dm755 "$srcdir"/beyond2lte-sdr-governor \
		"$pkgdir"/usr/libexec/beyond2lte-sdr-governor
	install -Dm644 "$srcdir"/beyond2lte-sdr-server.conf \
		"$pkgdir"/etc/default/beyond2lte-sdr-server
	# 70- so it is applied after upstream SoapyRemote's 10-SoapySDRServer.conf
	install -Dm644 "$srcdir"/beyond2lte-sdr-server.sysctl \
		"$pkgdir"/usr/lib/sysctl.d/70-beyond2lte-sdr-server.conf
	install -Dm644 "$srcdir"/beyond2lte-sdr-server.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/beyond2lte-sdr-server.conf
	# r2: Wi-Fi power save off only while an SDR radio is plugged in
	install -Dm644 "$srcdir"/63-beyond2lte-sdr-wifi-ps.rules \
		"$pkgdir"/usr/lib/udev/rules.d/63-beyond2lte-sdr-wifi-ps.rules
	install -Dm644 "$srcdir"/beyond2lte-sdr-wifi-ps@.service \
		"$pkgdir"/usr/lib/systemd/system/beyond2lte-sdr-wifi-ps@.service
	install -Dm755 "$srcdir"/beyond2lte-sdr-wifi-ps.dispatcher \
		"$pkgdir"/usr/lib/NetworkManager/dispatcher.d/60-beyond2lte-sdr-wifi-ps
}

nftrules() {
	pkgdesc="nftables rules opening SoapyRemote ports (TCP 55132, SSDP, LAN stream ports)"
	depends=""
	install_if="$pkgname=$pkgver-r$pkgrel nftables"
	install -Dm644 "$srcdir"/50_soapyremote.nft \
		"$subpkgdir"/etc/nftables.d/50_soapyremote.nft
}
