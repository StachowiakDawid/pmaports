# Contributor: StachowiakDawid
# tar1090 has no release tags (rolling master); pinned to commits. pkgver = upstream "version" file.
pkgname=tar1090
pkgver=3.14.1825
pkgrel=0
_commit=5d59b1ba2c5e30eb23f1161940367b7767f10ad5
_dbcommit=6e14dcfd6b300475c239b1fe668ec71a79c949a3
_dbver=3.14.1725
pkgdesc="Improved web map for ADS-B decoders (dump1090-fa / readsb), with aircraft database"
url="https://github.com/wiedehopf/tar1090"
arch="noarch"
license="GPL-2.0-or-later"
depends="bash jq coreutils sed gzip lighttpd"
makedepends="bash"
install="$pkgname.pre-install"
source="$pkgname-$_commit.tar.gz::https://github.com/wiedehopf/tar1090/archive/$_commit.tar.gz
	$pkgname-db-$_dbcommit.tar.gz::https://github.com/wiedehopf/tar1090-db/archive/$_dbcommit.tar.gz
	tar1090.service
	tar1090-web.service
	tar1090.default
	tar1090-lighttpd.conf
	"
builddir="$srcdir/tar1090-$_commit"
options="!check" # static web app + shell script

package() {
	local html="$pkgdir"/usr/share/tar1090/html
	mkdir -p "$html" "$pkgdir"/etc/tar1090
	cp -r html/. "$html"/
	# what upstream install.sh does: aircraft db next to the html, cache busting
	cp -r "$srcdir"/tar1090-db-$_dbcommit/db "$html"/db-$_dbver
	sed -i -e "s/let databaseFolder = .*;/let databaseFolder = \"db-$_dbver\";/" "$html"/index.html
	echo "{ \"tar1090Version\": \"$pkgver\", \"databaseVersion\": \"$_dbver\" }" > "$html"/version.json
	( cd "$html" && bash "$builddir"/cachebust.sh "$builddir"/cachebust.list "$html" )
	# site configuration is a conffile
	mv "$html"/config.js "$pkgdir"/etc/tar1090/config.js
	ln -s /etc/tar1090/config.js "$html"/config.js

	install -Dm755 tar1090.sh "$pkgdir"/usr/libexec/tar1090/tar1090.sh
	install -Dm644 default "$pkgdir"/usr/share/tar1090/default
	install -Dm644 "$srcdir"/tar1090.default "$pkgdir"/etc/default/tar1090
	install -Dm644 "$srcdir"/tar1090-lighttpd.conf "$pkgdir"/etc/tar1090/lighttpd.conf
	install -Dm644 "$srcdir"/tar1090.service "$pkgdir"/usr/lib/systemd/system/tar1090.service
	install -Dm644 "$srcdir"/tar1090-web.service "$pkgdir"/usr/lib/systemd/system/tar1090-web.service
}
