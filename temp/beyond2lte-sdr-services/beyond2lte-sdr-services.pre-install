#!/bin/sh
# group "sdr" owns the SDR USB device nodes (udev rules of beyond2lte-sdr-server
# and beyond2lte-sdr-rtlsdr); user "sdr" runs rtl_tcp and the SDR++ servers.
addgroup -S sdr 2>/dev/null
adduser -S -D -H -h /var/lib/sdr-mode -s /sbin/nologin -G sdr -g "SDR streaming services" sdr 2>/dev/null
exit 0
