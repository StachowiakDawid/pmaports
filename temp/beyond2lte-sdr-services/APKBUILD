# Contributor: StachowiakDawid
# SDR streaming services for the Galaxy S10+ (beyond2lte) SDR server and the
# sdr-mode arbitration tool.
pkgname=beyond2lte-sdr-services
pkgver=1
pkgrel=0
pkgdesc="rtl_tcp service and sdr-mode (which service owns which SDR) for beyond2lte"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="
	beyond2lte-sdr-rtlsdr
	beyond2lte-sdr-server
	rtl-sdr
	"
install="
	$pkgname.pre-install
	$pkgname.post-install
	$pkgname.pre-deinstall
	$pkgname-openwebrx.pre-install
	$pkgname-openwebrx.post-install
	$pkgname-openwebrx.pre-deinstall
	$pkgname-sdrpp.pre-deinstall
	"
subpackages="
	$pkgname-sdrpp:_sdrpp:noarch
	$pkgname-openwebrx:_openwebrx:noarch
	$pkgname-nftables:_nftables:noarch
	"
source="
	sdr-mode.sh
	sdr-mode.README
	61-beyond2lte-sdr-mode.rules
	beyond2lte-sdr-services.tmpfiles
	rtl-tcp.service
	rtl-tcp.conf
	sdrpp-server-lime.service
	sdrpp-server-rtl.service
	sdrpp-server.conf
	sdrpp-server.sh
	openwebrx.service
	openwebrx.conf
	openwebrx-prepare.sh
	openwebrx-own.py
	openwebrx-settings.json
	51_sdr-services.nft
	"
options="!check" # no tests

package() {
	install -Dm755 "$srcdir"/sdr-mode.sh "$pkgdir"/usr/bin/sdr-mode
	install -Dm644 "$srcdir"/61-beyond2lte-sdr-mode.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-beyond2lte-sdr-mode.rules
	install -Dm644 "$srcdir"/beyond2lte-sdr-services.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/beyond2lte-sdr-services.conf
	install -Dm644 "$srcdir"/rtl-tcp.service \
		"$pkgdir"/usr/lib/systemd/system/rtl-tcp.service
	install -Dm644 "$srcdir"/rtl-tcp.conf "$pkgdir"/etc/default/rtl-tcp
	# other packages register their units in rtl.d/ and lime.d/ (hook contract)
	install -Dm644 "$srcdir"/sdr-mode.README "$pkgdir"/usr/lib/sdr-mode/README
	install -dm755 "$pkgdir"/usr/lib/sdr-mode/rtl.d "$pkgdir"/usr/lib/sdr-mode/lime.d
}

_sdrpp() {
	pkgdesc="SDR++ server services (LimeSDR on TCP 5259, RTL-SDR on TCP 5260) for sdr-mode"
	depends="$pkgname=$pkgver-r$pkgrel sdrpp soapy-sdr-module-limesuiteng soapy-sdr-module-rtlsdr"
	install -Dm644 "$srcdir"/sdrpp-server-lime.service "$srcdir"/sdrpp-server-rtl.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm755 "$srcdir"/sdrpp-server.sh "$subpkgdir"/usr/libexec/sdr-mode/sdrpp-server
	install -Dm644 "$srcdir"/sdrpp-server.conf "$subpkgdir"/etc/default/sdrpp-server
}

_openwebrx() {
	pkgdesc="OpenWebRX+ service (HTTP 8073, LimeSDR + RTL-SDR receiver setup) for sdr-mode"
	depends="$pkgname=$pkgver-r$pkgrel openwebrx python3 soapy-sdr-module-limesuiteng"
	install -Dm644 "$srcdir"/openwebrx.service \
		"$subpkgdir"/usr/lib/systemd/system/openwebrx.service
	install -Dm755 "$srcdir"/openwebrx-prepare.sh "$subpkgdir"/usr/libexec/sdr-mode/openwebrx-prepare
	install -Dm755 "$srcdir"/openwebrx-own.py "$subpkgdir"/usr/libexec/sdr-mode/openwebrx-own
	install -Dm644 "$srcdir"/openwebrx-settings.json \
		"$subpkgdir"/usr/share/sdr-mode/openwebrx-settings.json
	install -Dm644 "$srcdir"/openwebrx.conf "$subpkgdir"/etc/default/openwebrx
}

_nftables() {
	pkgdesc="nftables rules: rtl_tcp 1234, SDR++ server 5259/5260, OpenWebRX 8073 from the LAN only"
	depends=""
	install_if="$pkgname=$pkgver-r$pkgrel nftables"
	install -Dm644 "$srcdir"/51_sdr-services.nft \
		"$subpkgdir"/etc/nftables.d/51_sdr-services.nft
}
