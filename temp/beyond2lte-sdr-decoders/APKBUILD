# Contributor: StachowiakDawid
# On-device SDR decoders for the beyond2lte SDR server: systemd services,
# /etc/default configuration and LAN-only firewall rules. One subpackage per
# decoder so only what is used gets installed; -all pulls everything.
pkgname=beyond2lte-sdr-decoders
pkgver=1
pkgrel=0
pkgdesc="SDR decoder services for beyond2lte (common files: user, state dir, presets)"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
# beyond2lte-sdr-services: sdr-mode + the dev-sdr-rtl.device udev rule the units bind to
depends="rtl-sdr beyond2lte-sdr-rtlsdr beyond2lte-sdr-services"
install="$pkgname.pre-install"
subpackages="
	$pkgname-adsb
	$pkgname-rtl433
	$pkgname-aprs
	$pkgname-pocsag
	$pkgname-ais
	$pkgname-all:_all
	$pkgname-nftables:nftrules
	"
source="
	sdr-adsb sdr-adsb.service sdr-adsb.default sdr-mode-adsb.conf sdr-adsb-feed.service.example
	sdr-rtl433 sdr-rtl433.service sdr-rtl433.default sdr-mode-rtl433.conf
	sdr-aprs sdr-aprs.service sdr-aprs.default sdr-mode-aprs.conf
	sdr-pocsag sdr-pocsag.service sdr-pocsag.default sdr-mode-pocsag.conf
	sdr-ais sdr-ais.service sdr-ais.default sdr-mode-ais.conf
	sdr-decoders.tmpfiles
	80-sdr-decoders.preset
	50_sdr-decoders.nft
	"
options="!check" # no tests

package() {
	install -Dm644 "$srcdir"/sdr-decoders.tmpfiles \
		"$pkgdir"/usr/lib/tmpfiles.d/sdr-decoders.conf
	install -Dm644 "$srcdir"/80-sdr-decoders.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-sdr-decoders.preset
}

_decoder() {
	local name="$1"
	install -Dm755 "$srcdir"/sdr-$name "$subpkgdir"/usr/libexec/sdr-decoders/sdr-$name
	install -Dm644 "$srcdir"/sdr-$name.service \
		"$subpkgdir"/usr/lib/systemd/system/sdr-$name.service
	install -Dm644 "$srcdir"/sdr-$name.default "$subpkgdir"/etc/default/sdr-$name
	# sdr-mode registry (hook contract of beyond2lte-sdr-services): `sdr-mode rtl $name`
	install -Dm644 "$srcdir"/sdr-mode-$name.conf "$subpkgdir"/usr/lib/sdr-mode/rtl.d/$name.conf
}

adsb() {
	pkgdesc="ADS-B: dump1090-fa service + tar1090 web map (port 8504)"
	depends="$pkgname=$pkgver-r$pkgrel dump1090 tar1090"
	_decoder adsb
	install -Dm644 "$srcdir"/sdr-adsb-feed.service.example \
		"$subpkgdir"/usr/share/$pkgname/sdr-adsb-feed.service.example
}

rtl433() {
	pkgdesc="ISM sensors: rtl_433 service with HTTP/JSON output (port 8433), optional MQTT"
	depends="$pkgname=$pkgver-r$pkgrel rtl_433"
	_decoder rtl433
}

aprs() {
	pkgdesc="APRS: rtl_fm | direwolf service (KISS 8001, AGW 8000)"
	depends="$pkgname=$pkgver-r$pkgrel direwolf"
	_decoder aprs
}

pocsag() {
	pkgdesc="Pagers: rtl_fm | multimon-ng service (POCSAG/FLEX)"
	depends="$pkgname=$pkgver-r$pkgrel multimon-ng"
	_decoder pocsag
}

ais() {
	pkgdesc="AIS ships: AIS-catcher service with web UI (port 8100)"
	depends="$pkgname=$pkgver-r$pkgrel ais-catcher"
	_decoder ais
}

_all() {
	pkgdesc="All beyond2lte SDR decoder services (meta package)"
	depends="$pkgname-adsb=$pkgver-r$pkgrel $pkgname-rtl433=$pkgver-r$pkgrel
		$pkgname-aprs=$pkgver-r$pkgrel $pkgname-pocsag=$pkgver-r$pkgrel
		$pkgname-ais=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"
}

nftrules() {
	pkgdesc="nftables rules opening the SDR decoder ports for LAN sources"
	depends=""
	install_if="$pkgname=$pkgver-r$pkgrel nftables"
	install -Dm644 "$srcdir"/50_sdr-decoders.nft \
		"$subpkgdir"/etc/nftables.d/50_sdr-decoders.nft
}
