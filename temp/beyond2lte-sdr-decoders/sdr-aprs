#!/bin/sh
# sdr-aprs.service: rtl_fm (narrow FM, 24 kHz audio) piped into direwolf.
set -o pipefail
APRS_DEVICE=0 APRS_FREQ=144.800M APRS_GAIN= APRS_PPM=0 APRS_MYCALL=N0CALL
APRS_KISS_PORT=8001 APRS_AGW_PORT=8000 APRS_IGATE_SERVER= APRS_IGATE_PASSCODE=
APRS_IGATE_FILTER= APRS_LOG=yes APRS_DIREWOLF_CONF=
[ -r /etc/default/sdr-aprs ] && . /etc/default/sdr-aprs
RUN=${RUNTIME_DIRECTORY:-/run/sdr-aprs}
STATE=${STATE_DIRECTORY:-/var/lib/sdr-decoders/aprs}

conf=$APRS_DIREWOLF_CONF
if [ -z "$conf" ]; then
	conf=$RUN/direwolf.conf
	{
		echo "# generated by /usr/libexec/sdr-decoders/sdr-aprs from /etc/default/sdr-aprs"
		echo "ADEVICE stdin null"
		echo "ACHANNELS 1"
		echo "CHANNEL 0"
		echo "MYCALL ${APRS_MYCALL:-N0CALL}"
		echo "MODEM 1200"
		echo "AGWPORT ${APRS_AGW_PORT:-0}"
		echo "KISSPORT ${APRS_KISS_PORT:-0}"
		if [ -n "$APRS_IGATE_SERVER" ] && [ -n "$APRS_IGATE_PASSCODE" ] && \
		   [ "${APRS_MYCALL:-N0CALL}" != N0CALL ]; then
			echo "IGSERVER $APRS_IGATE_SERVER"
			echo "IGLOGIN $APRS_MYCALL $APRS_IGATE_PASSCODE"
			[ -n "$APRS_IGATE_FILTER" ] && echo "IGFILTER $APRS_IGATE_FILTER"
		fi
	} > "$conf"
	chmod 600 "$conf"
fi

set -- -c "$conf" -r 24000 -n 1 -b 16 -t 0 -q d
[ "$APRS_LOG" = yes ] && set -- "$@" -l "$STATE"

rtl_fm -d "$APRS_DEVICE" -f "${APRS_FREQ:-144.800M}" -M fm -s 24000 \
	${APRS_GAIN:+-g "$APRS_GAIN"} -p "${APRS_PPM:-0}" -l 0 -E dc - 2>"$RUN/rtl_fm.log" |
	direwolf "$@" -
rc=$?
tail -n 5 "$RUN/rtl_fm.log" >&2
# a pipeline that ends is always a failure for a 24/7 receiver (dongle gone, ...)
[ "$rc" = 0 ] && rc=1
exit $rc
