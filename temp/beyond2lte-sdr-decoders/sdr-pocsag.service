[Unit]
Description=Pager decoder (rtl_fm | multimon-ng, POCSAG)
Documentation=https://github.com/EliasOenal/multimon-ng
After=network.target

# sdr-mode contract (beyond2lte-sdr-services): a dedicated RTL-SDR service is
# bound to the dongle's device unit (stopped on unplug, started on plug when
# enabled) and excludes the other dedicated RTL-SDR services. Select it with
#   sdr-mode rtl pocsag
# - do not enable/start by hand, sdr-mode also hands the dongle over from the
# shared servers (SoapySDRServer, OpenWebRX).
BindsTo=dev-sdr-rtl.device
After=dev-sdr-rtl.device
Conflicts=rtl-tcp.service sdrpp-server-rtl.service
Conflicts=sdr-adsb.service sdr-rtl433.service sdr-aprs.service sdr-ais.service
# retry forever, with backoff (5 s -> 5 min)
StartLimitIntervalSec=0

[Service]
Type=simple
User=sdrdec
Group=sdr
ExecStart=/usr/libexec/sdr-decoders/sdr-pocsag
# Restart=always, not on-failure: rtl_* tools exit 0 when the dongle vanishes.
# An explicit stop (systemctl stop, Conflicts=, unplug, sdr-mode) is never restarted.
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=5min
TimeoutStopSec=10
SyslogIdentifier=sdr-pocsag
RuntimeDirectory=sdr-pocsag
RuntimeDirectoryMode=0750
StateDirectory=sdr-decoders/pocsag
MemoryMax=128M
# little cores are plenty; keeps the big cluster cool/free for the SDR server
CPUAffinity=0-5
Nice=5

# Hardening
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# USB device nodes only (/dev/bus/usb/*, major 189)
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# AF_NETLINK: libusb hotplug (udev monitor)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=dev-sdr-rtl.device
