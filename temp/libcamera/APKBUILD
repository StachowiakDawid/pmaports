# Forked from Alpine for temporary downstream patches
maintainer="Robert Mader <robert.mader@collabora.com>"
pkgname=libcamera
_pkgver=0.8.0
pkgver=9999$_pkgver
pkgrel=16
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	doxygen
	eudev-dev
	glib-dev
	gnutls-dev
	graphviz
	gst-plugins-base-dev
	gtest-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	libyuv-dev
	linux-headers
	meson
	py3-jinja2
	py3-ply
	py3-pybind11-dev
	py3-sphinx
	py3-sphinxcontrib-doxylink
	py3-yaml
	python3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-gstreamer
	$pkgname-ipa
	$pkgname-tools
	$pkgname-v4l2
	py3-$pkgname-pyc:pyc
	py3-$pkgname:py3
	qcam
	"
_tuning_files="
	hi846.yaml
	imx355.yaml
	imx363.yaml
	imx371.yaml
	imx376.yaml
	imx519.yaml
	imx800.yaml
	imx858.yaml
