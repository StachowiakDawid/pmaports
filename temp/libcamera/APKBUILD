	0010-ipa-softisp-af-noise-threshold-scene-change-rescan.patch
	0011-libcamera-camera_lens-keep-the-lens-closed-while-not-in-use.patch
	0012-libcamera-camera_lens-log-open-and-release.patch
	0013-softisp-awb-near-grey-option.patch
	0014-softisp-awb-neutral-start-estimate.patch
	0015-softisp-awb-near-grey-diagnostics-wider-window.patch
	0016-ipa-softisp-use-new-statistics-within-4-frames-diagnostics.patch
	0017-software_isp-debayer_egl-sync-the-output-buffer-for-the-CPU.patch
	0018-ipa-softisp-take-the-sensor-information-of-the-confi.patch
	0019-ipa-softisp-agc-start-with-an-indoor-or-the-last-exp.patch
	0020-ipa-softisp-agc-lengthen-the-frame-for-exposures-up-.patch
	0021-ipa-softisp-agc-avoid-mains-flicker-bands.patch
	0022-ipa-softisp-af-restart-a-scan-only-when-the-scene-ch.patch
	0023-ipa-softisp-agc-skip-statistics-from-before-an-expos.patch
	qcam.desktop
	$_tuning_files
	"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
arm*|aarch64)
	# must be ordered before the ipa subpackage
	subpackages="$pkgname-raspberrypi $subpackages"
	;;
esac

build() {
	abuild-meson \
		-Dv4l2=true \
		-Dwerror=false \
		-Ddocumentation=disabled \
		. output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 -t "$pkgdir"/usr/share/applications "$srcdir"/qcam.desktop

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends="$pkgname=$pkgver-r$pkgrel"
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/libcamera/ipa
	amove usr/share/libcamera/ipa

	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done

	for _tuning_file in $_tuning_files; do
		install -Dm644 -t "$subpkgdir"/usr/share/libcamera/ipa/softisp \
			"$srcdir"/"$_tuning_file"
	done
}

qcam() {
	depends=""
	amove usr/bin/qcam

	amove usr/share/applications/qcam.desktop
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
	amove usr/bin/lc-compliance
}

py3() {
	pkgdesc="$pkgname (python bindings)"
	depends="python3"

	amove usr/lib/python*
}


