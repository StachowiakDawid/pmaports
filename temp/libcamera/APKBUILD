	s5k3p9.yaml
	s5k3j1.yaml
	s5k3m3.yaml
	s5k4ha.yaml
	s5k2l4.yaml
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-libcamera-software_isp-Allow-limiting-output-sizes.patch
	0002-libcamera-Add-quad-Bayer-CFA-layout-support.patch
	0003-pipeline-simple-match-exynos9820-csis.patch
	0004-ipa-libipa-add-s5k3p9-sensor-helper.patch
	0005-ipa-libipa-add-s5k3j1-s5k3m3-s5k4ha-sensor-helpers.patch
	0006-ipa-libipa-add-s5k2l4-sensor-helper.patch
	0007-ipa-softisp-contrast-detection-autofocus-with-a-lens.patch
	0008-software_isp-pipeline-simple-statistics-race-buffer-fallback-binned-default.patch
