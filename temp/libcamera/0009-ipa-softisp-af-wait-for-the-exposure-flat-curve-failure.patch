 .../internal/software_isp/swstats_cpu.h       |   1 +
 src/ipa/softisp/algorithms/af.cpp             | 125 +++++++++++++++---
 src/ipa/softisp/algorithms/af.h               |  21 ++-
 src/libcamera/software_isp/swstats_cpu.cpp    |   4 +
