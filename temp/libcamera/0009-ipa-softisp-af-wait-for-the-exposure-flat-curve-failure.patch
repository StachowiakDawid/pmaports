 	 */
 	uint64_t afSamples;
+	/**
+	 * \brief Divisor that turns the \a afLuma samples into 8 bit values
+	 *        (4 for unpacked 10 bit input, 16 for 12 bit, 1 otherwise)
+	 */
+	uint32_t afDiv;
 };
 
 } /* namespace libcamera */
