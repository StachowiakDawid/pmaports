diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
new file mode 100644
index 0000000..f345dbc
--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -0,0 +1,331 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ *
+ * The software ISP statistics carry a focus measure for the middle half of
+ * the image in both directions: the sum of the squared differences between
+ * horizontally adjacent luminance samples (one sample per 4 pixels), with the
+ * sum and count of the samples. Divided by the squared mean it does not
+ * depend on the exposure, so the AGC may keep running while the lens moves.
+ *
+ * A scan steps the lens (V4L2_CID_FOCUS_ABSOLUTE of the lens sub-device that
+ * the pipeline handler drives) through its range in coarse steps, stops when
+ * the measure has clearly fallen behind its peak, scans around the peak in
+ * fine steps, puts a parabola through the best fine step and its neighbours
+ * and moves to its vertex, approaching it from below like
+ * the scan did (voice coil hysteresis). Statistics are produced every few
+ * frames (SwStatsCpu::kStatPerNumFrames); each lens position is measured on
+ * the next statistics after the move.
+ *
+ * Controls: AfMode (Manual, Auto, Continuous), AfTrigger (Start, Cancel) in
+ * Auto mode; metadata: AfState. LensPosition is not offered because the lens
+ * position has no dioptre calibration. In Continuous mode the measure is
+ * watched after a scan, and a lasting change of the measure or of the
+ * brightness starts a new scan.
+ *
+ * Tuning (all optional):
+ *   - Af:
+ *       mode: continuous     # AfMode at start: manual, auto or continuous
+ *       coarseSteps: 12      # steps over the whole lens range
+ *       fineSteps: 6         # steps over +-1 coarse step around the peak
+ *       coarseDrop: 0.6      # end the coarse scan below this fraction of the peak
+ *       minContrast: 0.05    # (peak - lowest) / peak below this: AfState Failed
+ *       rescanChange: 0.5    # Continuous: relative change that counts as a change
+ *       rescanCount: 3       # Continuous: changed statistics in a row to rescan
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftIspAf)
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	coarseSteps_ = std::max(2u, tuningData["coarseSteps"].get<uint32_t>(coarseSteps_));
+	fineSteps_ = std::max(2u, tuningData["fineSteps"].get<uint32_t>(fineSteps_));
+	coarseDrop_ = tuningData["coarseDrop"].get<double>(coarseDrop_);
+	minContrast_ = tuningData["minContrast"].get<double>(minContrast_);
+	rescanChange_ = std::clamp(tuningData["rescanChange"].get<double>(rescanChange_), 0.05, 0.95);
+	rescanCount_ = std::max(1u, tuningData["rescanCount"].get<uint32_t>(rescanCount_));
+
+	std::string mode = tuningData["mode"].get<std::string>("manual");
+	if (mode == "continuous")
+		defaultMode_ = controls::AfModeContinuous;
+	else if (mode == "auto")
+		defaultMode_ = controls::AfModeAuto;
+	else if (mode == "manual")
+		defaultMode_ = controls::AfModeManual;
+	else {
+		LOG(IPASoftIspAf, Error) << "Unknown Af mode '" << mode << "'";
+		return -EINVAL;
+	}
+
+	/* Removed again at configure() time when the camera has no lens */
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, ControlValue(static_cast<int32_t>(defaultMode_)));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto it = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	enabled_ = it != configInfo.lensControls.end();
+	if (!enabled_) {
+		LOG(IPASoftIspAf, Info) << "No focus lens, autofocus disabled";
+		context.ctrlMap.erase(&controls::AfMode);
+		context.ctrlMap.erase(&controls::AfTrigger);
+		return 0;
+	}
+
+	const ControlInfo &info = it->second;
+	lensMin_ = info.min().get<int32_t>();
+	lensMax_ = info.max().get<int32_t>();
+	if (lensMax_ <= lensMin_) {
+		LOG(IPASoftIspAf, Warning) << "Lens range " << lensMin_ << ".."
+					   << lensMax_ << ", autofocus disabled";
+		enabled_ = false;
+		return 0;
+	}
+	/* The lens driver keeps its position; the first move sets it. */
+	position_ = info.def().isNone() ? lensMin_ : info.def().get<int32_t>();
+
+	mode_ = defaultMode_;
+	state_ = controls::AfStateIdle;
+	phase_ = Phase::Idle;
+	measurePending_ = false;
+	if (mode_ == controls::AfModeContinuous)
+		startScan();
+
+	LOG(IPASoftIspAf, Debug) << "Lens range " << lensMin_ << ".." << lensMax_
+				 << ", mode " << static_cast<int>(mode_);
+	return 0;
+}
+
+void Af::startScan()
+{
+	int32_t range = lensMax_ - lensMin_;
+
+	scanStart_ = lensMin_;
+	scanEnd_ = lensMax_;
+	scanStep_ = std::max<int32_t>(1, (range + coarseSteps_ - 1) / coarseSteps_);
+	bestSharpness_ = 0.0;
+	worstSharpness_ = 0.0;
+	bestPosition_ = lensMin_;
+	changeCount_ = 0;
+	fineSamples_.clear();
+	phase_ = Phase::Coarse;
+	/* The first process() call moves the lens to the start */
+	measurePending_ = false;
+	state_ = controls::AfStateScanning;
+}
+
+void Af::stopScan()
+{
+	phase_ = Phase::Idle;
+	measurePending_ = false;
+	state_ = controls::AfStateIdle;
+}
+
+void Af::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!enabled_)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		if (mode_ == controls::AfModeContinuous)
+			startScan();
+		else
+			stopScan();
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			startScan();
+		else if (*trigger == controls::AfTriggerCancel)
+			stopScan();
+	}
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position_ = std::clamp(position, lensMin_, lensMax_);
+	context.activeState.af.lensPosition = position_;
+	measurePending_ = true;
+}
+
+void Af::finishScan(IPAContext &context)
+{
+	/*
+	 * Parabola through the fine scan peak and its two neighbours: the
+	 * peak lies between the fine steps (about 14 lens codes on a 9 bit
+	 * actuator), the vertex gets it to a few codes.
+	 */
+	auto measured = [&](int32_t pos) -> const double * {
+		for (const auto &[p, v] : fineSamples_)
+			if (p == pos)
+				return &v;
+		return nullptr;
+	};
+	const double *lo = measured(bestPosition_ - scanStep_);
+	const double *mid = measured(bestPosition_);
+	const double *hi = measured(bestPosition_ + scanStep_);
+	if (lo && mid && hi) {
+		double den = *lo - 2.0 * *mid + *hi;
+		if (den < 0.0) {
+			double offset = 0.5 * (*lo - *hi) / den;
+			bestPosition_ += static_cast<int32_t>(std::lround(scanStep_ * offset));
+			bestPosition_ = std::clamp(bestPosition_, lensMin_, lensMax_);
+		}
+	}
+
+	bool found = bestSharpness_ > 0.0 &&
+		     (bestSharpness_ - worstSharpness_) / bestSharpness_ >= minContrast_;
+
+	LOG(IPASoftIspAf, Info)
+		<< (found ? "Focused" : "No contrast peak") << " at " << bestPosition_
+		<< " (measure " << bestSharpness_ << ", lowest " << worstSharpness_ << ")";
+
+	/* Reported once the lens is at the result (Settle) */
+	result_ = found ? controls::AfStateFocused : controls::AfStateFailed;
+
+	/* Approach the peak from below, the direction of the scan */
+	int32_t below = std::max(lensMin_, bestPosition_ - 2 * scanStep_);
+	if (position_ > below) {
+		moveTo(context, below);
+		phase_ = Phase::Approach;
+	} else {
+		moveTo(context, bestPosition_);
+		phase_ = Phase::Settle;
+	}
+}
+
+void Af::step(IPAContext &context, double sharpness, double luma)
+{
+	switch (phase_) {
+	case Phase::Idle:
+		return;
+
+	case Phase::Coarse:
+	case Phase::Fine:
+		if (!measurePending_) {
+			/* Scan start: move to the first position */
+			moveTo(context, scanStart_);
+			return;
+		}
+
+		LOG(IPASoftIspAf, Debug) << "Lens " << position_ << ": " << sharpness;
+
+		if (phase_ == Phase::Fine)
+			fineSamples_.emplace_back(position_, sharpness);
+
+		if (sharpness > bestSharpness_) {
+			bestSharpness_ = sharpness;
+			bestPosition_ = position_;
+		}
+		if (worstSharpness_ == 0.0 || sharpness < worstSharpness_)
+			worstSharpness_ = sharpness;
+
+		/* Clearly past the peak, or at the end of the range */
+		if ((phase_ == Phase::Coarse &&
+		     sharpness < bestSharpness_ * coarseDrop_ &&
+		     position_ >= bestPosition_ + 2 * scanStep_) ||
+		    position_ >= scanEnd_) {
+			if (phase_ == Phase::Coarse && scanStep_ > 1) {
+				int32_t coarse = scanStep_;
+
+				scanStart_ = std::max(lensMin_, bestPosition_ - coarse);
+				scanEnd_ = std::min(lensMax_, bestPosition_ + coarse);
+				scanStep_ = std::max<int32_t>(1, 2 * coarse / fineSteps_);
+				phase_ = Phase::Fine;
+				moveTo(context, scanStart_);
+			} else {
+				finishScan(context);
+			}
+			return;
+		}
+
+		moveTo(context, std::min(position_ + scanStep_, scanEnd_));
+		return;
+
+	case Phase::Approach:
+		moveTo(context, bestPosition_);
+		phase_ = Phase::Settle;
+		return;
+
+	case Phase::Settle:
+		/* First statistics at the final position: the reference */
+		refSharpness_ = sharpness;
+		refLuma_ = luma;
+		changeCount_ = 0;
+		measurePending_ = false;
+		phase_ = Phase::Focused;
+		state_ = result_;
+		return;
+
+	case Phase::Focused: {
+		if (mode_ != controls::AfModeContinuous || refSharpness_ <= 0.0 ||
+		    refLuma_ <= 0.0)
+			return;
+
+		double lo = 1.0 - rescanChange_;
+		double s = sharpness / refSharpness_;
+		double l = luma / refLuma_;
+		bool changed = s < lo || s > 1.0 / lo || l < lo || l > 1.0 / lo;
+
+		changeCount_ = changed ? changeCount_ + 1 : 0;
+		if (changeCount_ >= rescanCount_) {
+			LOG(IPASoftIspAf, Debug) << "Scene changed, rescanning";
+			startScan();
+		}
+		return;
+	}
+	}
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+
+	if (stats->valid && stats->afSamples) {
+		double mean = static_cast<double>(stats->afLuma) / stats->afSamples;
+		double contrast = static_cast<double>(stats->afContrast) / stats->afSamples;
+		double sharpness = mean > 0.0 ? contrast / (mean * mean) : 0.0;
+
+		step(context, sharpness, mean);
+	}
+
+	metadata.set(controls::AfState, state_);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/softisp/algorithms/af.h b/src/ipa/softisp/algorithms/af.h
new file mode 100644
index 0000000..92f7583
--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <utility>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Idle,		/* not scanning, lens where it is */
+		Coarse,		/* stepping through the whole range */
+		Fine,		/* stepping around the coarse peak */
+		Approach,	/* below the peak, the next move goes to it */
+		Settle,		/* at the peak, the next statistics are the reference */
+		Focused,	/* scan done; Continuous mode watches for changes */
+	};
+
+	void startScan();
+	void stopScan();
+	void moveTo(IPAContext &context, int32_t position);
+	void finishScan(IPAContext &context);
+	void step(IPAContext &context, double sharpness, double luma);
+
+	/* Tuning */
+	unsigned int coarseSteps_ = 12;
+	unsigned int fineSteps_ = 6;
+	double coarseDrop_ = 0.6;
+	double minContrast_ = 0.05;
+	double rescanChange_ = 0.5;
+	unsigned int rescanCount_ = 3;
+	controls::AfModeEnum defaultMode_ = controls::AfModeManual;
+
+	/* Lens */
+	bool enabled_ = false;
+	int32_t lensMin_ = 0;
+	int32_t lensMax_ = 0;
+	int32_t position_ = 0;
+
+	/* Control state */
+	controls::AfModeEnum mode_ = controls::AfModeManual;
+	controls::AfStateEnum state_ = controls::AfStateIdle;
+	controls::AfStateEnum result_ = controls::AfStateIdle;
+
+	/* Scan state */
+	Phase phase_ = Phase::Idle;
+	bool measurePending_ = false;
+	int32_t scanStart_ = 0;
+	int32_t scanEnd_ = 0;
+	int32_t scanStep_ = 0;
+	int32_t bestPosition_ = 0;
+	double bestSharpness_ = 0.0;
+	double worstSharpness_ = 0.0;
+	double refSharpness_ = 0.0;
+	double refLuma_ = 0.0;
+	unsigned int changeCount_ = 0;
+	/* Fine scan measurements, for the interpolation of the peak */
+	std::vector<std::pair<int32_t, double>> fineSamples_;
+};
+
+} /* namespace ipa::softisp::algorithms */
