From 5079e1417d71475cbd6102a08a3944b02c7a0e3f Mon Sep 17 00:00:00 2001
From: StachowiakDawid <dawidos234@gmail.com>
Date: Mon, 23 Nov 2026 18:38:09 +0100
Subject: [PATCH 1/2] ipa: softisp: af: peak threshold from the measured noise,
 scene-change rescans in continuous mode

The fixed max/min threshold (1.15) does not fit every light level: a flat
curve with 5 % measure noise reaches max/min 1.40 over a scan, with 2 %
noise 1.14 (Monte-Carlo, 99.9 %). Estimate the noise from the statistics
taken while the scan waits for the exposure (lens and exposure still,
now three steady statistics) and require (1 + 3.5 sigma) / (1 - 3.5 sigma),
at least minPeakRatio.

Continuous mode: a scene change is a change of the measure, the level or
exposure x gain by more than rescanChange (now 0.3, at least 4 sigma) for
rescanCount statistics in a row; the exposure was not looked at before,
and 0.5 rarely triggered.
---
 src/ipa/softisp/algorithms/af.cpp | 55 ++++++++++++++++++++++++-------
 src/ipa/softisp/algorithms/af.h   | 11 +++++--
 2 files changed, 53 insertions(+), 13 deletions(-)

diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
index dbf5e8f..3f9b871 100644
--- a/src/ipa/softisp/algorithms/af.cpp
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -36,7 +36,10 @@
  *                            # statistics before a scan starts (at most maxWait: 25)
  *       scanChange: 0.2      # exposure or level change that restarts a scan
  *                            # (at most maxRestarts: 3 times)
- *       rescanChange: 0.5    # Continuous: relative change that counts as a change
+ *       rescanChange: 0.3    # Continuous: relative change of the measure, level or
+ *                            # exposure that counts as a scene change (at least
+ *                            # 4x the measured noise)
+ *       noiseFactor: 3.5     # peak must exceed (1 + f*noise) / (1 - f*noise)
  *       rescanCount: 3       # Continuous: changed statistics in a row to rescan
  */
 
@@ -44,6 +47,7 @@
 
 #include <algorithm>
 #include <cmath>
+#include <limits>
 #include <string>
 
 #include <linux/v4l2-controls.h>
@@ -70,6 +74,7 @@ int Af::init(IPAContext &context, const ValueNode &tuningData)
 	scanChange_ = tuningData["scanChange"].get<double>(scanChange_);
 	maxWait_ = tuningData["maxWait"].get<uint32_t>(maxWait_);
 	maxRestarts_ = tuningData["maxRestarts"].get<uint32_t>(maxRestarts_);
+	noiseFactor_ = tuningData["noiseFactor"].get<double>(noiseFactor_);
 	rescanChange_ = std::clamp(tuningData["rescanChange"].get<double>(rescanChange_), 0.05, 0.95);
 	rescanCount_ = std::max(1u, tuningData["rescanCount"].get<uint32_t>(rescanCount_));
 
@@ -138,6 +143,9 @@ void Af::startScan(bool restart)
 	}
 	stableCount_ = 0;
 	waitCount_ = 0;
+	noiseSum_ = 0.0;
+	noiseCount_ = 0;
+	lastSharpness_ = 0.0;
 
 	scanStart_ = lensMin_;
 	scanEnd_ = lensMax_;
@@ -218,16 +226,25 @@ void Af::finishScan(IPAContext &context)
 		}
 	}
 
+	/*
+	 * A flat curve with measure noise sigma shows max/min of about
+	 * (1 + 3.5 sigma) / (1 - 3.5 sigma) at most over ~20 measures
+	 * (tools/af-sim.py ratio check, 99.9 %): a real peak has to clear
+	 * that and minPeakRatio.
+	 */
+	double ks = noiseFactor_ * sigma_;
+	double threshold = ks < 0.9 ? std::max(minPeakRatio_, (1.0 + ks) / (1.0 - ks))
+				    : std::numeric_limits<double>::infinity();
 	double ratio = worstSharpness_ > 0.0 ? bestSharpness_ / worstSharpness_ : 0.0;
-	bool found = bestSharpness_ > 0.0 && ratio >= minPeakRatio_;
+	bool found = bestSharpness_ > 0.0 && ratio >= threshold;
 
 	if (!found) {
 		/* A flat curve says nothing about the lens position */
 		int32_t park = failPosition_ >= 0 ? failPosition_ : scanOrigin_;
 
 		LOG(IPASoftIspAf, Info)
-			<< "No contrast peak (max/min " << ratio << " < " << minPeakRatio_
-			<< "), lens back to " << park;
+			<< "No contrast peak (max/min " << ratio << " < " << threshold
+			<< ", noise " << sigma_ << "), lens back to " << park;
 		result_ = controls::AfStateFailed;
 		bestPosition_ = std::clamp(park, lensMin_, lensMax_);
 		moveTo(context, bestPosition_);
@@ -237,7 +254,8 @@ void Af::finishScan(IPAContext &context)
 
 	LOG(IPASoftIspAf, Info)
 		<< "Focused at " << bestPosition_ << " (measure " << bestSharpness_
-		<< ", max/min " << ratio << ")";
+		<< ", max/min " << ratio << ", needed " << threshold
+		<< ", noise " << sigma_ << ")";
 
 	/* Reported once the lens is at the result (Settle) */
 	result_ = controls::AfStateFocused;
@@ -258,20 +276,31 @@ void Af::finishScan(IPAContext &context)
  * stayed within settleChange_ for two statistics in a row, at most maxWait_
  * statistics, then move the lens to the scan start.
  */
-bool Af::beginScan(IPAContext &context, double luma, double exposure)
+bool Af::beginScan(IPAContext &context, double sharpness, double luma, double exposure)
 {
 	bool stable = lastExposure_ > 0.0 && lastLuma_ > 0.0 &&
 		      std::abs(exposure / lastExposure_ - 1.0) <= settleChange_ &&
 		      std::abs(luma / lastLuma_ - 1.0) <= settleChange_;
 
+	/* Lens and exposure still: the change of the measure is noise */
+	if (stable && lastSharpness_ > 0.0) {
+		noiseSum_ += std::abs(sharpness / lastSharpness_ - 1.0);
+		noiseCount_++;
+	}
+	lastSharpness_ = sharpness;
+
 	stableCount_ = stable ? stableCount_ + 1 : 0;
 	waitCount_++;
-	if (stableCount_ < 2 && waitCount_ < maxWait_)
+	if (stableCount_ < 3 && waitCount_ < maxWait_)
 		return false;
 
+	/* mean |x/y - 1| of two measures with noise sigma = 1.13 sigma */
+	sigma_ = noiseCount_ ? std::max(0.01, noiseSum_ / noiseCount_ / 1.128) : 0.05;
+
 	LOG(IPASoftIspAf, Debug)
 		<< "Scan start after " << waitCount_ << " statistics"
-		<< (stableCount_ < 2 ? " (exposure not settled)" : "");
+		<< (stableCount_ < 3 ? " (exposure not settled)" : "")
+		<< ", measure noise " << sigma_;
 	scanLuma_ = luma;
 	scanExposure_ = exposure;
 	phase_ = Phase::Coarse;
@@ -286,7 +315,7 @@ void Af::step(IPAContext &context, double sharpness, double luma, double exposur
 		return;
 
 	case Phase::Wait:
-		beginScan(context, luma, exposure);
+		beginScan(context, sharpness, luma, exposure);
 		return;
 
 	case Phase::Coarse:
@@ -347,6 +376,7 @@ void Af::step(IPAContext &context, double sharpness, double luma, double exposur
 		/* First statistics at the final position: the reference */
 		refSharpness_ = sharpness;
 		refLuma_ = luma;
+		refExposure_ = exposure;
 		changeCount_ = 0;
 		measurePending_ = false;
 		phase_ = Phase::Focused;
@@ -358,10 +388,13 @@ void Af::step(IPAContext &context, double sharpness, double luma, double exposur
 		    refLuma_ <= 0.0)
 			return;
 
-		double lo = 1.0 - rescanChange_;
+		/* A change well above the measure noise, or of the exposure */
+		double lo = 1.0 - std::clamp(std::max(rescanChange_, 4.0 * sigma_), 0.05, 0.9);
 		double s = sharpness / refSharpness_;
 		double l = luma / refLuma_;
-		bool changed = s < lo || s > 1.0 / lo || l < lo || l > 1.0 / lo;
+		double e = refExposure_ > 0.0 ? exposure / refExposure_ : 1.0;
+		bool changed = s < lo || s > 1.0 / lo || l < lo || l > 1.0 / lo ||
+			       e < lo || e > 1.0 / lo;
 
 		changeCount_ = changed ? changeCount_ + 1 : 0;
 		if (changeCount_ >= rescanCount_) {
diff --git a/src/ipa/softisp/algorithms/af.h b/src/ipa/softisp/algorithms/af.h
index ada329e..74656fb 100644
--- a/src/ipa/softisp/algorithms/af.h
+++ b/src/ipa/softisp/algorithms/af.h
@@ -50,7 +50,7 @@ private:
 	void moveTo(IPAContext &context, int32_t position);
 	void finishScan(IPAContext &context);
 	void step(IPAContext &context, double sharpness, double luma, double exposure);
-	bool beginScan(IPAContext &context, double luma, double exposure);
+	bool beginScan(IPAContext &context, double sharpness, double luma, double exposure);
 
 	/* Tuning */
 	unsigned int coarseSteps_ = 12;
@@ -62,7 +62,8 @@ private:
 	double scanChange_ = 0.2;
 	unsigned int maxWait_ = 25;
 	unsigned int maxRestarts_ = 3;
-	double rescanChange_ = 0.5;
+	double rescanChange_ = 0.3;
+	double noiseFactor_ = 3.5;
 	unsigned int rescanCount_ = 3;
 	controls::AfModeEnum defaultMode_ = controls::AfModeManual;
 
@@ -97,6 +98,12 @@ private:
 	unsigned int stableCount_ = 0;
 	unsigned int waitCount_ = 0;
 	unsigned int restarts_ = 0;
+	/* Measure noise, from the statistics at one lens position before a scan */
+	double sigma_ = 0.05;
+	double noiseSum_ = 0.0;
+	unsigned int noiseCount_ = 0;
+	double lastSharpness_ = 0.0;
+	double refExposure_ = 0.0;
 	/* Fine scan measurements, for the interpolation of the peak */
 	std::vector<std::pair<int32_t, double>> fineSamples_;
 };
